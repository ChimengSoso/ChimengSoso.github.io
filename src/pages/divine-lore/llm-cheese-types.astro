  rows.evalMap(parse).handleErrorWith(_ => Stream.empty)`;

const scFs2fix = `// ที่ควรเป็น: ให้ความล้มเหลวเป็น "ค่า" ที่ไหลอยู่ใน stream ด้วย
def ingest3(rows: Stream[IO, RawRow]): Stream[IO, Either[IngestError, Record]] =
  rows.evalMap(row => parse(row).attemptNarrow[IngestError])

// ปลายทางค่อยแยกสองทาง ของดีไปต่อ ของเสียถูกบันทึกไว้
val (bad, good) = ingest3(rows).broadcastThrough(
  _.collect { case Left(e)  => e }.evalTap(logError),
  _.collect { case Right(r) => r }.through(save),
)`;

const scPekko = `import org.apache.pekko.actor.typed.{ActorRef, Behavior}
import org.apache.pekko.actor.typed.scaladsl.Behaviors

// โปรโตคอลของ actor ก็คือ sum type ดี ๆ นี่เอง ท่าหลบเดิมใช้ได้หมด
enum Command:
  case AddGroup(group: GroupName, replyTo: ActorRef[Ack])
  case RemoveGroup(group: GroupName, replyTo: ActorRef[Ack])

enum Ack:
  case Ok
  case Failed(reason: String)   // ช่องโหว่: อะไรก็ยัดลงมาได้

def behavior: Behavior[Command] = Behaviors.receiveMessage:
  case Command.AddGroup(g, replyTo) =>
    // ท่าหลบ: ทุกความล้มเหลวกลายเป็นข้อความเดียวกันหมด
    replyTo ! Ack.Failed(s"could not add $g")
    Behaviors.same
  case _ => Behaviors.same   // และเคสที่ยังไม่อยากคิด ก็เงียบไปเฉย ๆ`;

const scPekkoFix = `// ที่ควรเป็น: เหตุผลของความล้มเหลวก็มี type ของมัน
