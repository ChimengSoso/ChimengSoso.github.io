const scFs2 = `import fs2.Stream
import cats.effect.IO

// ท่าหลบ: แถวที่พังหายไปเงียบ ๆ ไม่มีใครรู้ว่าหายกี่แถว
def ingest(rows: Stream[IO, RawRow]): Stream[IO, Record] =
  rows.evalMap(parse).attempt.collect { case Right(r) => r }

// ท่าหลบอีกแบบ: กลืน error แล้วปิด stream ดื้อ ๆ
