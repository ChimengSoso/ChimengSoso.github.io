const sc3d = `import cats.data.EitherT
import io.circe.ParsingFailure

// opaque type = ข้างในเป็น String/Int แต่ข้างนอกสร้างมั่วไม่ได้
opaque type UserName = String
object UserName:
  def fromRaw(s: String): Either[ErrorEvent, UserName] =
    Either.cond(s.nonEmpty, s, ErrorEvent.EmptyUserName)

opaque type ErrorCode = Int
object ErrorCode:
  def fromInt(i: Int): Option[ErrorCode] = Option.when(i > 0)(i)

enum ErrorEvent:
  case UnknownUser(name: UserName)
  case DatabaseErrorCode(code: ErrorCode)
  case InvalidJson(err: ParsingFailure)
  case NetworkError(cause: NetworkException)
  case Canceled(reason: CancelationReason)
  case EmptyUserName
  case InvalidGroup(group: GroupName)   // ช่องใหม่ที่ควรจะมีตั้งแต่แรก

// EitherT ทำให้ IO[Either[E, A]] ต่อกันได้เหมือน Either ธรรมดา
def handleAddGroup(req: AddGroupRequest): EitherT[IO, ErrorEvent, Response] =
  for
    group <- EitherT.fromEither[IO](GroupName.fromRaw(req.group))
    resp  <- EitherT.liftF(addGroup(group))
  yield resp`;

