        return (
          <g>
            <rect x={26 + i * 78} y={160 - h} width="46" height={h} rx="4" fill={era.index === currentEraIndex ? '#e0b400' : '#2f9e5c'}/>
            <text x={49 + i * 78} y="172" text-anchor="middle" font-size="10" fill="#9aa7bd">ยุค {era.index + 1}</text>
            <text x={49 + i * 78} y="186" text-anchor="middle" font-size="9" fill="#9aa7bd">{fmt(btc, btc < 1 ? 2 : 0)}</text>
