  nonceSpace: `<p>ช่องนอนซ์กว้าง ${NONCE_BYTES} ไบต์ ซึ่งเท่ากับ ${NONCE_BITS} บิต เพราะหนึ่งไบต์มี 8 บิต</p>
    <p>ความเป็นไปได้จึงเท่ากับ 2 ยกกำลัง ${NONCE_BITS} คือ ${fmt(nonceSpace)} ค่า</p>`,
  retargetBlocks: `<p>ระบบเล็งจังหวะไว้ที่ ${BLOCK_MINUTES} นาทีต่อบล็อก และเลือกรอบทบทวนไว้ที่ ${RETARGET_DAYS} วัน</p>
    <p>${RETARGET_DAYS} วันคือ ${fmt(RETARGET_DAYS * 24 * 60)} นาที หารด้วย ${BLOCK_MINUTES} ได้ ${fmt(RETARGET_INTERVAL)} บล็อกพอดี เลขนี้จึงไม่ได้มีความหมายในตัวเอง</p>`,
  headersOnly: `<p>หัวบล็อกก้อนละ ${headerBytes} ไบต์ คูณด้วยจำนวนบล็อกทั้งหมด ${fmt(TIP_HEIGHT)} ก้อน</p>
    <p>ได้ราว ${fmt(headersOnlyMb)} เมกะไบต์ เทียบกับสมุดทั้งเล่มที่หนัก ${fmt(chainGb)} กิกะไบต์</p>`,
  proofHashes: `<p>ต้นไม้ที่มีใบ N ใบ มีความสูงราว log ฐานสอง ของ N ชั้น และแต่ละชั้นขอแฮชพี่น้องแค่ตัวเดียว</p>
    <p>บล็อกจริงมีธุรกรรมเฉลี่ย ${fmt(txPerBlock)} ใบ log ฐานสองของเลขนี้อยู่ราว ${Math.log2(txPerBlock).toFixed(1)} จึงต้องใช้ราว ${proofHashes} ตัว</p>`,
  chainSize: `<p>กราฟ Blockchain Size รายงานเป็นเมกะไบต์ ค่าล่าสุดคือ ${fmt(CHAIN_MB)} MB</p>
    <p>หารด้วย ${MB_PER_GB} ได้ ${fmt(chainGb)} GB</p>`,
  chainGrowth: `<p>ค่าเมื่อ ${CHAIN_YEAR_AGO_LABEL} คือ ${fmt(CHAIN_MB_YEAR_AGO)} MB ค่าล่าสุดคือ ${fmt(CHAIN_MB)} MB</p>
    <p>ต่างกัน ${fmt(CHAIN_MB - CHAIN_MB_YEAR_AGO)} MB หรือราว ${fmt(chainGrowthGb)} GB ในหนึ่งปี</p>`,
  maxGrowth: `<p>กติกาจำกัดน้ำหนักบล็อกไว้ที่ 4,000,000 หน่วย ซึ่งแปลว่าบล็อกโตได้ไม่เกินราว ${MAX_BLOCK_MB} MB แม้ในกรณีที่ยัดเต็มที่สุด</p>
    <p>หนึ่งปีมีราว ${fmt(blocksPerYear)} บล็อก คูณกันแล้วหารเป็นกิกะไบต์ ได้เพดานราว ${fmt(maxGrowthGb)} GB ต่อปี</p>`,
  txPerSecond: `<p>บล็อกจริงในช่วงนี้บรรจุธุรกรรมเฉลี่ย ${fmt(txPerBlock)} ใบต่อบล็อก</p>
    <p>หนึ่งบล็อกกินเวลาราว ${BLOCK_MINUTES} นาที คือ ${BLOCK_MINUTES * 60} วินาที หารกันได้ราว ${txPerSecond.toFixed(1)} ใบต่อวินาที</p>`,
  tipHeight: HOWTO_CHECK('เป็นเลขบล็อกล่าสุด', 'Blockchain Tip', 'https://mempool.space/', 'mempool.space'),
  hashrate: HOWTO_CHECK('หน้ากราฟการขุด', 'Hashrate', 'https://mempool.space/graphs/mining/hashrate-difficulty', 'mempool.space'),
  difficulty: HOWTO_CHECK('หน้ากราฟการขุด', 'Difficulty', 'https://mempool.space/graphs/mining/hashrate-difficulty', 'mempool.space'),
  price: HOWTO_CHECK('ที่หน้าเหรียญบิตคอยน์', 'ราคา', 'https://www.coingecko.com/en/coins/bitcoin', 'CoinGecko'),
};

const TITLE = 'บิตคอยน์ตั้งแต่ศูนย์: เงินที่ไม่มีใครเป็นเจ้าของทำงานยังไง';
const DESC =
  'เห็นข่าวบิตคอยน์มาสิบกว่าปีแต่ไม่เคยเข้าใจว่ามันคืออะไรจริง ๆ บทนี้เริ่มจากศูนย์ ปูปัญหาใช้เงินซ้ำสองรอบ แกะแฮชด้วยมือ ต่อเป็นบล็อกเชน ขุดจริงให้ดูว่าเลขศูนย์ข้างหน้ามาจากไหน ไล่ถึงกุญแจ กระเป๋า ที่อยู่ ประวัติ 18 ปีตั้งแต่ whitepaper ถึงพิซซ่า 10,000 เหรียญและ Mt.Gox แล้วปิดด้วยมุมเงิน ราคามาจากไหน ความผันผวน ETF ต้นทุนไฟ และภาษีคริปโตไทยปี 2026';
---

<DivineLoreLayout title={`${TITLE} | บันทึกศาสตร์แห่งเทพ`} description={DESC}>
  <nav class="dl-nav">
    <a href="../">
      <svg class="dl-nav-arrow" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
      กลับไปที่บันทึกลับ
    </a>
  </nav>

  <p class="tag">บันทึกการเงิน</p>
  <h1>{TITLE}</h1>
  <p class="subtitle">
    เห็นคำว่าบิตคอยน์มาสิบกว่าปี แต่พอมีคนถามว่ามันทำงานยังไง ก็ยังตอบไม่ได้สักที
    บทนี้เริ่มจากศูนย์ ไม่ต้องรู้อะไรมาก่อนเลยสักอย่าง
  </p>

  <h2>เงินในแอปธนาคารคือรายการหนึ่งในสมุดบัญชี</h2>

  <p>
    ลองนึกถึงไฟล์ xlsx ที่คนใช้จดรายรับรายจ่ายกันในชีวิตจริง หนึ่งบรรทัดคือหนึ่งรายการ
    วันที่ ใครจ่ายให้ใคร เท่าไร ธนาคารก็ถือของแบบนั้นอยู่เล่มหนึ่ง แค่ใหญ่กว่ามากและมีทุกคนอยู่ในนั้น
    ของชิ้นนี้เรียกว่า <strong>สมุดบัญชี</strong> ต่อจากนี้ผมจะเรียกสั้น ๆ ว่าสมุด
  </p>

  <p>
    เงินในแอปธนาคารของคุณจึงไม่ได้อยู่ในมือถือ มันคือผลของรายการทุกบรรทัดที่เกี่ยวกับคุณในสมุดเล่มนั้น
    พอคุณกดโอน ธนาคารก็เขียนรายการใหม่เพิ่มลงไปอีกหนึ่งบรรทัด
  </p>

  <ZoomableDiagram
