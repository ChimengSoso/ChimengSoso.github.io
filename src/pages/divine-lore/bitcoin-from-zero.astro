<script>
  interface ChainBlock {
    data: string;
    nonce: number;
    prev: string;
    hash: string;
  }

  const enc = new TextEncoder();

  async function sha256(text: string): Promise<string> {
    const buf = await crypto.subtle.digest('SHA-256', enc.encode(text));
    return Array.from(new Uint8Array(buf))
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('');
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  /** ระบายตัวอักษรที่ต่างจากผลก่อนหน้า เพื่อให้เห็นว่าแฮชเปลี่ยนไปเยอะแค่ไหน */
  /** ระบายเฉพาะตำแหน่งที่ตรงกับผลก่อนหน้า เพราะตัวที่ต่างมีเกือบครบ 64 ตัว
      ถ้าระบายตัวที่ต่าง พื้นสีจะกลายเป็นพื้นหลังปกติและไม่สื่ออะไรเลย */
  function sameMarkup(now: string, before: string): string {
    let out = '';
    for (let i = 0; i < now.length; i += 1) {
      const ch = escapeHtml(now[i]);
      out += before[i] === now[i] ? `<span class="hl-same">${ch}</span>` : ch;
    }
    return out;
  }

  function initHashLab(root: HTMLElement): void {
    const input = root.querySelector<HTMLInputElement>('.hl-input');
    const out = root.querySelector<HTMLElement>('.hl-out');
    const nudge = root.querySelector<HTMLButtonElement>('.hl-nudge');
    const reset = root.querySelector<HTMLButtonElement>('.hl-reset');
    const prevBox = root.querySelector<HTMLElement>('.hl-prev');
    const prevText = root.querySelector<HTMLElement>('.hl-prev-text');
    const prevHash = root.querySelector<HTMLElement>('.hl-prev-hash');
    if (!input || !out || !nudge || !reset || !prevBox || !prevText || !prevHash) return;

    const initial = input.value;
    let previousHash = '';
    let previousText = '';

    const showPrev = (): void => {
      const has = previousHash !== '';
      prevBox.hidden = !has;
      prevText.textContent = previousText;
      prevHash.textContent = previousHash;
    };

    const render = async (): Promise<void> => {
      const text = input.value;
      const hash = await sha256(text);
      out.innerHTML = previousHash ? sameMarkup(hash, previousHash) : escapeHtml(hash);
      showPrev();
      previousHash = hash;
      previousText = text;
    };

    input.addEventListener('input', () => {
      void render();
    });
    nudge.addEventListener('click', () => {
      const pool = 'abcdefghijklmnopqrstuvwxyz0123456789';
      const pick = pool[Math.floor(Math.random() * pool.length)];
      input.value = input.value.slice(0, -1) + pick;
      void render();
    });
    reset.addEventListener('click', () => {
      input.value = initial;
      previousHash = '';
      previousText = '';
      void render();
    });

    void render();
  }

  function initChainLab(root: HTMLElement): void {
    const host = root.querySelector<HTMLElement>('.cl-blocks');
    const mineAll = root.querySelector<HTMLButtonElement>('.cl-mineall');
    const reset = root.querySelector<HTMLButtonElement>('.cl-reset');
    const status = root.querySelector<HTMLElement>('.cl-status');
    if (!host || !mineAll || !reset) return;
    let edited = false;
    let busy = false;
    /** ดัชนีบล็อกที่เพิ่งได้เลขใหม่ ใช้ไฮไลต์ค่าที่ขยับให้ตาไล่ทัน */
    let justMined = new Set<number>();

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COUNT = 5;
    const TARGET = '000';
    const GENESIS = '0'.repeat(64);
    const defaults = [
      'สมชายจ่ายร้าน A 1 BTC',
      'ร้าน A จ่ายซัพพลายเออร์ 0.4 BTC',
      'สมหญิงจ่ายค่าเช่า 0.2 BTC',
      'ร้าน B จ่ายค่าไฟ 0.05 BTC',
      'สมชายจ่ายร้าน C 0.3 BTC',
    ];

    let blocks: ChainBlock[] = [];

    const body = (b: ChainBlock, index: number): string =>
      `${index}|${b.data}|${b.prev}|${b.nonce}`;

    /** หาเลขที่ทำให้แฮชขึ้นต้นด้วยศูนย์ตามเป้า ปล่อยคิวเป็นระยะเพื่อไม่ให้หน้าค้าง */
    const mine = async (index: number): Promise<void> => {
      const b = blocks[index];
      b.prev = index === 0 ? GENESIS : blocks[index - 1].hash;
      let nonce = 0;
      for (;;) {
        b.nonce = nonce;
        const h = await sha256(body(b, index));
        if (h.startsWith(TARGET)) {
          b.hash = h;
          return;
        }
        nonce += 1;
        if (nonce % 4000 === 0) await new Promise((r) => setTimeout(r, 0));
      }
    };

    const refreshFrom = async (from: number): Promise<void> => {
      for (let i = from; i < blocks.length; i += 1) {
        blocks[i].hash = await sha256(body(blocks[i], i));
      }
    };

    /** บล็อกใช้ได้ก็ต่อเมื่อบรรพบุรุษของมันใช้ได้ด้วย ความพังจึงลามไปทางขวาเสมอ */
    const validity = (): boolean[] => {
      let ancestorsOk = true;
      return blocks.map((b, i) => {
        const prevReal = i === 0 ? GENESIS : blocks[i - 1].hash;
        const ok = ancestorsOk && b.hash.startsWith(TARGET) && b.prev === prevReal;
        ancestorsOk = ok;
        return ok;
      });
    };

    const render = (): void => {
      const okList = validity();
      host.innerHTML = '';
      blocks.forEach((b, i) => {
        const ok = okList[i];
        const hot = justMined.has(i) ? ' is-fresh' : '';
        const el = document.createElement('div');
        el.className = `cl-block ${ok ? 'is-good' : 'is-bad'}`;
        el.innerHTML = `
          <p class="cl-head"><span>บล็อก ${i + 1}</span><span class="cl-state">${ok ? 'ใช้ได้' : 'พัง'}</span></p>
          <input class="cl-data" type="text" value="${escapeHtml(b.data)}" data-index="${i}" />
          <p class="cl-row">เลขที่หาได้: <b class="cl-nonce${hot}">${b.nonce}</b></p>
          <p class="cl-row">แฮชบล็อกก่อนหน้า: <b>${b.prev.slice(0, 10)}…</b></p>
          <p class="cl-row cl-hash">แฮชของบล็อก: <b class="${hot.trim()}">${b.hash.slice(0, 10)}…</b></p>
          <button type="button" class="cl-mine" data-index="${i}"${ok || busy ? ' disabled' : ''}>หาเลขใหม่</button>
        `;
        host.appendChild(el);
      });
      syncButtons(okList);
    };

    const syncButtons = (okList: boolean[]): void => {
      const broken = okList.some((ok) => !ok);
      mineAll.disabled = broken ? busy : true;
      reset.disabled = !edited || busy;
      if (status && !busy) {
        status.textContent = broken
          ? 'โซ่พังอยู่ กดหาเลขใหม่ให้ทั้งโซ่ได้'
          : 'โซ่สมบูรณ์ ลองแก้ข้อความในบล็อกไหนก็ได้';
      }
    };

    /** เลื่อนบล็อกที่กำลังทำให้อยู่ในสายตา โดยไม่ลากหน้าเว็บทั้งหน้า */
    const keepInView = (index: number): void => {
      const el = host.children[index];
      if (!(el instanceof HTMLElement)) return;
      const left = el.offsetLeft - host.clientWidth / 2 + el.offsetWidth / 2;
      host.scrollLeft = Math.max(0, left);
    };

    host.addEventListener('input', (e) => {
      if (!(e.target instanceof HTMLInputElement)) return;
      const idx = Number(e.target.dataset.index);
      if (Number.isNaN(idx)) return;
      blocks[idx].data = e.target.value;
      edited = true;
      justMined = new Set();
      const caret = e.target.selectionStart;
      void refreshFrom(idx).then(() => {
        render();
        const next = host.querySelector<HTMLInputElement>(`.cl-data[data-index="${idx}"]`);
        if (next) {
          next.focus();
          if (caret !== null) next.setSelectionRange(caret, caret);
        }
      });
    });

    host.addEventListener('click', (e) => {
      if (!(e.target instanceof HTMLElement)) return;
      const btn = e.target.closest<HTMLButtonElement>('.cl-mine');
      if (!btn || btn.disabled) return;
      const idx = Number(btn.dataset.index);
      if (Number.isNaN(idx)) return;
      busy = true;
      btn.disabled = true;
      btn.textContent = 'กำลังหา';
      void (async () => {
        await mine(idx);
        await refreshFrom(idx + 1);
        justMined = new Set([idx]);
        busy = false;
        render();
        if (status) status.textContent = `บล็อก ${idx + 1} ได้เลขใหม่แล้ว บล็อกขวามือยังพังอยู่จนกว่าจะหาเลขใหม่ตาม`;
      })();
    });

    const build = async (): Promise<void> => {
      blocks = defaults.map((data) => ({ data, nonce: 0, prev: GENESIS, hash: '' }));
      edited = false;
      justMined = new Set();
      busy = true;
      mineAll.disabled = true;
      reset.disabled = true;
      if (status) status.textContent = 'กำลังหาเลขให้โซ่ตั้งต้น';
      for (let i = 0; i < COUNT; i += 1) await mine(i);
      busy = false;
      render();
    };

    /** ซ่อมทีละก้อนจากซ้ายไปขวา ให้เห็นว่าการแก้ก้อนเดียวลากงานทั้งแถวไปด้วย */
    mineAll.addEventListener('click', () => {
      if (busy) return;
      busy = true;
      mineAll.disabled = true;
      reset.disabled = true;
      justMined = new Set();
      void (async () => {
        let count = 0;
        for (let i = 0; i < blocks.length; i += 1) {
          if (validity()[i]) continue;
          if (status) status.textContent = `กำลังหาเลขใหม่ให้บล็อก ${i + 1}`;
          await mine(i);
          await refreshFrom(i + 1);
          count += 1;
          justMined.add(i);
          busy = false;
          render();
          busy = true;
          keepInView(i);
          if (!reduced) await new Promise((r) => setTimeout(r, 420));
        }
        edited = false;
        busy = false;
        render();
        if (status) status.textContent = `หาเลขใหม่ให้ ${count} บล็อก แฮชเปลี่ยนทั้งหมด โซ่กลับมาสมบูรณ์`;
      })();
    });
    reset.addEventListener('click', () => {
      if (busy) return;
      void build();
    });

    host.innerHTML = '<p class="lab-note">กำลังหาเลขให้โซ่ตั้งต้น</p>';
    void build();
  }

  function initMineLab(root: HTMLElement): void {
    const data = root.querySelector<HTMLInputElement>('.ml-data');
    const diff = root.querySelector<HTMLInputElement>('.ml-diff');
    const diffLabel = root.querySelector<HTMLElement>('.ml-diff-label');
    const rival = root.querySelector<HTMLInputElement>('.ml-rival');
    const tries = root.querySelector<HTMLElement>('.ml-tries');
    const time = root.querySelector<HTMLElement>('.ml-time');
    const expect = root.querySelector<HTMLElement>('.ml-expect');
    const rate = root.querySelector<HTMLElement>('.ml-rate');
    const hashOut = root.querySelector<HTMLElement>('.ml-hash');
    const go = root.querySelector<HTMLButtonElement>('.ml-go');
    const stop = root.querySelector<HTMLButtonElement>('.ml-stop');
    const reset = root.querySelector<HTMLButtonElement>('.ml-reset');
    const note = root.querySelector<HTMLElement>('.ml-note');
    if (!data || !diff || !diffLabel || !rival || !tries || !time || !expect || !rate) return;
    if (!hashOut || !go || !stop || !reset || !note) return;

    const RIVAL_FACTOR = 2;
    const DEFAULT_NOTE = 'กดหยุดแล้วกดเริ่มอีกครั้ง มันจะเดาต่อจากเลขเดิม ไม่ได้นับหนึ่งใหม่';

    /** สถานะอยู่ระดับนี้ ไม่ใช่ในฟังก์ชัน run เพื่อให้กดหยุดแล้วเดาต่อได้ */
    let running = false;
    let nonce = 0;
    let elapsed = 0;
    let done = false;
    const fmtInt = (n: number): string => n.toLocaleString('en-US');

    const showStats = (): void => {
      tries.textContent = fmtInt(nonce);
      time.textContent = `${(elapsed / 1000).toFixed(2)} วิ`;
      rate.textContent = elapsed > 0 ? `${fmtInt(Math.round(nonce / (elapsed / 1000)))} /วิ` : '-';
      reset.disabled = running || (nonce === 0 && !done);
    };

    const showExpect = (): void => {
      const zeros = Number(diff.value);
      diffLabel.textContent = diff.value;
      expect.textContent = fmtInt(Math.pow(16, zeros));
    };

    /** เปลี่ยนโจทย์เมื่อไร ตัวนับต้องเริ่มใหม่ เพราะงานเก่าใช้ไม่ได้แล้ว */
    const restart = (why: string): void => {
      running = false;
      nonce = 0;
      elapsed = 0;
      done = false;
      note.classList.remove('is-lost');
      note.textContent = why;
      hashOut.textContent = 'กดเริ่มขุดเพื่อดู';
      go.disabled = false;
      stop.disabled = true;
      showStats();
    };

    diff.addEventListener('input', () => {
      showExpect();
      restart('เปลี่ยนจำนวนศูนย์คือเปลี่ยนโจทย์ ตัวนับจึงเริ่มใหม่');
    });
    data.addEventListener('input', () => {
      restart('เปลี่ยนข้อความในบล็อกคือเปลี่ยนโจทย์ ตัวนับจึงเริ่มใหม่');
    });
    rival.addEventListener('change', () => {
      restart(rival.checked ? 'คู่แข่งลงสนามแล้ว ใครเจอก่อนได้ไปคนเดียว' : DEFAULT_NOTE);
    });

    const run = async (): Promise<void> => {
      if (done || running) return;
      const zeros = Number(diff.value);
      const target = '0'.repeat(zeros);
      const expected = Math.pow(16, zeros);
      /** โอกาสที่คู่แข่งเจอก่อนในแต่ละครั้งที่เราเดา คิดจากกำลังที่มากกว่าเราเป็นเท่าตัว */
      const rivalChance = rival.checked ? RIVAL_FACTOR / expected : 0;
      running = true;
      go.disabled = true;
      stop.disabled = false;
      reset.disabled = true;
      let tick = performance.now();
      for (;;) {
        if (!running) break;
        if (rivalChance > 0 && Math.random() < rivalChance) {
          done = true;
          note.classList.add('is-lost');
          note.textContent =
            `คู่แข่งเจอก่อนตอนคุณเดาไปแล้ว ${fmtInt(nonce)} ครั้ง งานทั้งหมดนั้นกลายเป็นศูนย์ทันที ` +
            'ไฟที่จ่ายไปไม่ได้คืน และรอบใหม่ต้องเริ่มบนยอดของเขา';
          hashOut.textContent = 'แพ้รอบนี้';
          break;
        }
        const h = await sha256(`${data.value}|${nonce}`);
        nonce += 1;
        if (h.startsWith(target)) {
          hashOut.textContent = h;
          done = true;
          note.textContent = 'เจอแล้ว บล็อกนี้ประกาศออกไปได้ และรอบใหม่จะเริ่มบนยอดที่ขยับไปแล้ว';
          break;
        }
        if (nonce % 2000 === 0) {
          const now = performance.now();
          elapsed += now - tick;
          tick = now;
          showStats();
          hashOut.textContent = h;
          await new Promise((r) => setTimeout(r, 0));
        }
      }
      elapsed += performance.now() - tick;
      running = false;
      go.disabled = done;
      stop.disabled = true;
      showStats();
    };

    go.addEventListener('click', () => {
      if (done) return;
      void run();
    });
    stop.addEventListener('click', () => {
      running = false;
    });
    reset.addEventListener('click', () => {
      restart(rival.checked ? 'คู่แข่งลงสนามแล้ว ใครเจอก่อนได้ไปคนเดียว' : DEFAULT_NOTE);
    });

    showExpect();
    showStats();
  }

  type MkMode = 'clean' | 'tampered' | 'swapped';
  interface MerkleNode {
    hash: string;
    label: string;
  }

  function initMerkleLab(root: HTMLElement): void {
    const host = root.querySelector<HTMLElement>('.mk-tree');
    const headRoot = root.querySelector<HTMLElement>('.mk-head-root');
    const headBlock = root.querySelector<HTMLElement>('.mk-head-block');
    const say = root.querySelector<HTMLElement>('.mk-say');
    const tamper = root.querySelector<HTMLButtonElement>('.mk-tamper');
    const swap = root.querySelector<HTMLButtonElement>('.mk-swap');
    const reset = root.querySelector<HTMLButtonElement>('.mk-reset');
    const raw: unknown = JSON.parse(root.dataset.leaves ?? '[]');
    if (!host || !say || !tamper || !swap || !reset || !Array.isArray(raw)) return;
    const base = raw.filter((x): x is string => typeof x === 'string');
    if (base.length === 0) return;

    const TAMPER_INDEX = 2;
    const SWAP_A = 2;
    const SWAP_B = 3;
    let mode: MkMode = 'clean';
    /** ผู้ใช้แตะอะไรไปแล้วหรือยัง ใช้คุมปุ่มเริ่มใหม่ ไม่ผูกกับว่าตอนนี้สถานะสะอาดหรือไม่ */
    let touched = false;
    let labels = base.map((text, i) => ({ id: i + 1, text }));
    let levels: MerkleNode[][] = [];
    let selected = -1;
    let changed = new Set<string>();

    /** ป้ายติดไปกับตัวธุรกรรม ไม่ได้ตั้งจากตำแหน่ง เพื่อให้เห็นด้วยตาว่าใบไหนย้ายที่ */
    const build = async (src: Array<{ id: number; text: string }>): Promise<MerkleNode[][]> => {
      const out: MerkleNode[][] = [];
      const leaves: MerkleNode[] = [];
      for (let i = 0; i < src.length; i += 1) {
        leaves.push({ hash: await sha256(src[i].text), label: 'ใบ ' + src[i].id });
      }
      out.push(leaves);
      while (out[out.length - 1].length > 1) {
        const prev = out[out.length - 1];
        const next: MerkleNode[] = [];
        for (let i = 0; i < prev.length; i += 2) {
          next.push({ hash: await sha256(prev[i].hash + prev[i + 1].hash), label: 'แฮชคู่' });
        }
        out.push(next);
      }
      return out;
    };

    /** ดัชนีของบรรพบุรุษของใบที่เลือก คือกล่องที่เครื่องเล็กคำนวณเองได้ */
    const ancestors = (leaf: number): Array<[number, number]> => {
      const path: Array<[number, number]> = [];
      let idx = leaf;
      for (let lv = 1; lv < levels.length; lv += 1) {
        idx = Math.floor(idx / 2);
        path.push([lv, idx]);
      }
      return path;
    };

    /** ดัชนีของโหนดพี่น้องที่ต้องใช้พิสูจน์ ในแต่ละชั้น */
    const proofPath = (leaf: number): Array<[number, number]> => {
      const path: Array<[number, number]> = [];
      let idx = leaf;
      for (let lv = 0; lv < levels.length - 1; lv += 1) {
        path.push([lv, idx % 2 === 0 ? idx + 1 : idx - 1]);
        idx = Math.floor(idx / 2);
      }
      return path;
    };

    const render = (): void => {
      const path = selected >= 0 ? proofPath(selected) : [];
      const needed = new Set(path.map(([lv, i]) => lv + ':' + i));
      const onPath = new Set(selected >= 0 ? ancestors(selected).map(([lv, i]) => lv + ':' + i) : []);
      host.innerHTML = '';
      for (let lv = levels.length - 1; lv >= 0; lv -= 1) {
        const row = document.createElement('div');
        row.className = 'mk-row';
        if (lv > 0) row.dataset.children = String(levels[lv - 1].length);
        levels[lv].forEach((node, i) => {
          const cell = document.createElement('button');
          cell.type = 'button';
          const isLeaf = lv === 0;
          const classes = ['mk-node'];
          if (isLeaf) classes.push('mk-leaf');
          if (lv === levels.length - 1) classes.push('mk-root');
          if (isLeaf && i === selected) classes.push('is-picked');
          if (onPath.has(lv + ':' + i)) classes.push('is-onpath');
          if (needed.has(lv + ':' + i)) classes.push('is-needed');
          if (changed.has(lv + ':' + i)) classes.push('is-changed');
          cell.className = classes.join(' ');
          cell.disabled = !isLeaf;
          cell.dataset.leaf = String(i);
          cell.innerHTML =
            '<span class="mk-name">' + (lv === levels.length - 1 ? 'ราก' : node.label) + '</span>' +
            '<span class="mk-hash">' + node.hash.slice(0, 8) + '</span>';
          row.appendChild(cell);
        });
        host.appendChild(row);
      }
      if (selected >= 0) {
        say.textContent =
          'ใบที่ ' + (selected + 1) + ' มีทางเดินขึ้นไปหาราก ' + path.length +
          ' ชั้น แต่ละชั้นขอแฮชพี่น้องแค่ตัวเดียว รวม ' + path.length +
          ' ตัว ที่เหลือคำนวณเองได้หมด ไม่ต้องโหลดอีก ' + (levels[0].length - 1) + ' ใบเลย';
      } else if (changed.size > 0) {
        say.textContent =
          'แก้ใบเดียว แฮชที่เปลี่ยนตามคือ ' + changed.size + ' ตัว รากเปลี่ยน ค่าในหัวบล็อกจึงเปลี่ยน และแฮชของบล็อกก็เปลี่ยนตามไปด้วย';
      } else {
        say.textContent = 'แตะใบธุรกรรมสักใบเพื่อดูว่าต้องใช้แฮชกี่ตัวในการพิสูจน์';
      }

      // หัวบล็อกอ่านค่าจากรากที่เพิ่งคำนวณ แฮชของบล็อกจึงขยับตามทุกครั้งที่รากขยับ
      const rootNode = levels[levels.length - 1][0];
      const rootChanged = changed.has(levels.length - 1 + ':0');
      if (headRoot) {
        headRoot.textContent = rootNode.hash.slice(0, 12);
        headRoot.classList.toggle('is-changed', rootChanged);
      }
      if (headBlock) {
        void crypto.subtle
          .digest('SHA-256', new TextEncoder().encode('header:' + rootNode.hash))
          .then((buf) => {
            headBlock.textContent = Array.from(new Uint8Array(buf))
              .map((b) => b.toString(16).padStart(2, '0'))
              .join('')
              .slice(0, 12);
            headBlock.classList.toggle('is-changed', rootChanged);
          });
      }
    };

    host.addEventListener('click', (e) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest<HTMLButtonElement>('.mk-leaf');
      if (!btn) return;
      selected = Number(btn.dataset.leaf);
      changed = new Set();
      touched = true;
      render();
      syncButtons();
    });

    /** ปุ่มทั้งสองเป็นสวิตช์ กดแล้วสลับไปมาได้ ไม่ใช่เซ็ตค่าเดิมทับจนกดซ้ำแล้วหน้าจอนิ่ง */
    const labelsFor = (m: MkMode): Array<{ id: number; text: string }> => {
      const out = base.map((text, i) => ({ id: i + 1, text }));
      if (m === 'tampered') out[TAMPER_INDEX] = { id: TAMPER_INDEX + 1, text: base[TAMPER_INDEX] + ' (ยอดถูกแก้)' };
      if (m === 'swapped') {
        const a = out[SWAP_A];
        out[SWAP_A] = out[SWAP_B];
        out[SWAP_B] = a;
      }
      return out;
    };

    const syncButtons = (): void => {
      tamper.textContent = mode === 'tampered' ? 'คืนยอดเดิมในใบที่ 3' : 'แก้ยอดในใบที่ 3';
      swap.textContent = mode === 'swapped' ? 'สลับลำดับกลับ' : 'สลับลำดับใบ 3 กับ 4';
      swap.disabled = mode === 'tampered';
      tamper.disabled = mode === 'swapped';
      reset.disabled = !touched;
    };

    const apply = (next: MkMode): void => {
      touched = true;
      void (async () => {
        const before = levels;
        mode = next;
        labels = labelsFor(mode);
        levels = await build(labels);
        selected = -1;
        changed = new Set();
        levels.forEach((row, lv) => {
          row.forEach((node, i) => {
            if (before[lv] && before[lv][i] && before[lv][i].hash !== node.hash) changed.add(lv + ':' + i);
          });
        });
        render();
        syncButtons();
        if (mode === 'clean') {
          say.textContent =
            'กลับมาเป็นชุดเดิมแล้ว แฮชที่ขยับกลับคือ ' + changed.size + ' ตัว และรากกลับไปเท่าเดิมเป๊ะ';
        } else if (mode === 'tampered') {
          say.textContent =
            'แก้ยอดในใบเดียว แฮชที่เปลี่ยนตามคือ ' + changed.size +
            ' ตัว รากเปลี่ยน ค่าในส่วนหัวจึงเปลี่ยน และแฮชของบล็อกก็เปลี่ยนตามไปด้วย';
        } else {
          say.textContent =
            'ใบ ' + (SWAP_B + 1) + ' ย้ายมาอยู่หน้าใบ ' + (SWAP_A + 1) +
            ' เนื้อในทุกใบเหมือนเดิมทุกตัวอักษร ไม่ได้แก้อะไรเลย แต่แฮชเปลี่ยนไป ' +
            changed.size + ' ตัว และรากก็เปลี่ยน เพราะรากผูกกับลำดับด้วย';
        }
      })();
    };

    tamper.addEventListener('click', () => {
      apply(mode === 'tampered' ? 'clean' : 'tampered');
    });
    swap.addEventListener('click', () => {
      apply(mode === 'swapped' ? 'clean' : 'swapped');
    });
    reset.addEventListener('click', () => {
      selected = -1;
      apply('clean');
      touched = false;
      syncButtons();
    });

    void (async () => {
      levels = await build(labels);
      render();
      syncButtons();
    })();
  }

  function initTargetLab(root: HTMLElement): void {
    const range = root.querySelector<HTMLInputElement>('.tg-range');
    const win = root.querySelector<HTMLElement>('.tg-win');
    const share = root.querySelector<HTMLElement>('.tg-share');
    const triesEl = root.querySelector<HTMLElement>('.tg-tries');
    const zerosEl = root.querySelector<HTMLElement>('.tg-zeros');
    if (!range || !win || !share || !triesEl || !zerosEl) return;

    /** ค่าบนสไลเดอร์คือ "เป้าแคบกว่าค่าสูงสุดกี่เท่า" ในหน่วยกำลังสอง
        ใช้กำลังสองเพราะช่วงที่ต้องครอบคลุมกว้างเกินกว่าจะไล่เป็นเส้นตรงได้ */
    const fmtBig = (n: number): string => {
      if (n < 1e4) return Math.round(n).toLocaleString('en-US');
      if (n < 1e6) return (n / 1e3).toFixed(1) + ' พัน';
      if (n < 1e9) return (n / 1e6).toFixed(1) + ' ล้าน';
      if (n < 1e12) return (n / 1e9).toFixed(1) + ' พันล้าน';
      if (n < 1e15) return (n / 1e12).toFixed(1) + ' ล้านล้าน';
      return n.toExponential(1).replace('e+', ' x 10^');
    };

    const render = (): void => {
      const bits = Number(range.value);
      const tries = Math.pow(2, bits);
      const sharePct = 100 / tries;
      /** ศูนย์ฐานสิบหกที่ได้ คือจำนวนบิตนำหน้าที่เป็นศูนย์ หารสี่ */
      const zeros = Math.floor(bits / 4);
      win.style.width = Math.max(0.35, sharePct) + '%';
      share.textContent = sharePct >= 0.01 ? sharePct.toFixed(2) + '%' : '1 ใน ' + fmtBig(tries);
      triesEl.textContent = fmtBig(tries) + ' ครั้ง';
      zerosEl.textContent = zeros + ' ตัว';
    };

    range.addEventListener('input', render);
    render();
  }

  interface RaceStep {
    title: string;
    say: string;
    main: number;
    evil: number;
    markTx: boolean;
  }

  function initRace(root: HTMLElement): void {
    const stage = root.querySelector<HTMLElement>('.rc-stage');
    const titleEl = root.querySelector<HTMLElement>('.rc-title');
    const sayEl = root.querySelector<HTMLElement>('.rc-say');
    const prev = root.querySelector<HTMLButtonElement>('.rc-prev');
    const next = root.querySelector<HTMLButtonElement>('.rc-next');
    const play = root.querySelector<HTMLButtonElement>('.rc-play');
    const range = root.querySelector<HTMLInputElement>('.rc-range');
    const count = root.querySelector<HTMLElement>('.rc-count');
    if (!stage || !titleEl || !sayEl || !prev || !next || !play || !range || !count) return;

    const raw: unknown = JSON.parse(root.dataset.steps ?? '[]');
    if (!Array.isArray(raw)) return;
    const steps = raw.filter(
      (x): x is RaceStep =>
        typeof x === 'object' && x !== null && 'main' in x && 'evil' in x && 'title' in x,
    );
    if (steps.length === 0) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const W = 560;
    const H = 190;
    const BW = 62;
    const GAP = 14;
    const X0 = 96;
    let at = 0;
    let timer = 0;

    const block = (x: number, y: number, label: string, tone: 'main' | 'evil' | 'tx'): string => {
      const stroke = tone === 'evil' ? '#d64545' : tone === 'tx' ? '#e0b400' : '#4ade80';
      const fill = tone === 'evil' ? '#1f1418' : tone === 'tx' ? '#241f0d' : '#132033';
      const ink = tone === 'evil' ? '#f08b8b' : tone === 'tx' ? '#e0b400' : '#4ade80';
      return (
        '<rect x="' + x + '" y="' + y + '" width="' + BW + '" height="34" rx="7" fill="' + fill + '" stroke="' + stroke + '"/>' +
        '<text x="' + (x + BW / 2) + '" y="' + (y + 22) + '" text-anchor="middle" font-size="10" fill="' + ink + '">' + label + '</text>'
      );
    };

    const render = (): void => {
      const step = steps[at];
      let out = '';
      out += '<text x="10" y="46" font-size="10" fill="#4ade80">สายหลัก</text>';
      out += '<text x="10" y="136" font-size="10" fill="#f08b8b">สายลับของคนโกง</text>';
      for (let i = 0; i < step.main; i += 1) {
        const isTx = i === 0 && step.markTx;
        out += block(X0 + i * (BW + GAP), 24, isTx ? 'ธุรกรรมคุณ' : 'บล็อก', isTx ? 'tx' : 'main');
      }
      for (let i = 0; i < step.evil; i += 1) {
        out += block(X0 + i * (BW + GAP), 114, 'บล็อก', 'evil');
      }
      if (step.evil === 0 && at >= 1) {
        out += '<text x="' + X0 + '" y="136" font-size="10" fill="#6b7690">เพิ่งเริ่ม ยังไม่มีบล็อก</text>';
      }
      const gapBlocks = step.main - step.evil;
      out +=
        '<text x="' + (W - 12) + '" y="176" text-anchor="end" font-size="11" fill="#e0b400">' +
        'ต้องขุดแซงอีก ' + gapBlocks + ' ก้อน ในเวลาที่สายหลักยังเดินหน้าต่อ</text>';
      stage.innerHTML =
        '<svg class="btc-dgm" viewBox="0 0 ' + W + ' ' + H + '" xmlns="http://www.w3.org/2000/svg" ' +
        'role="img" aria-label="แผนภาพการแข่งขุดแซงระหว่างสายหลักกับสายลับของคนโกง" ' +
        'font-family="Sarabun, sans-serif">' + out + '</svg>';

      titleEl.textContent = at + 1 + '. ' + step.title;
      sayEl.textContent = step.say;
      count.textContent = at + 1 + ' / ' + steps.length;
      range.value = String(at);
      prev.disabled = at === 0;
      next.disabled = at === steps.length - 1;
    };

    const stop = (): void => {
      if (timer) window.clearInterval(timer);
      timer = 0;
      play.textContent = 'เล่นอัตโนมัติ';
    };

    range.max = String(steps.length - 1);
    prev.addEventListener('click', () => {
      stop();
      at = Math.max(0, at - 1);
      render();
    });
    next.addEventListener('click', () => {
      stop();
      at = Math.min(steps.length - 1, at + 1);
      render();
    });
    range.addEventListener('input', () => {
      stop();
      at = Number(range.value);
      render();
    });
    play.addEventListener('click', () => {
      if (timer) {
        stop();
        return;
      }
      play.textContent = 'หยุด';
      timer = window.setInterval(() => {
        if (at >= steps.length - 1) {
          stop();
          return;
        }
        at += 1;
        render();
      }, reduced ? 2600 : 2100);
    });

    render();
  }

  interface DsLine {
    t: string;
    s?: 'new' | 'no';
  }
  interface DsStep {
    title: string;
    say: string;
    slips: string[];
    books: DsLine[][];
  }

  function initDspend(root: HTMLElement): void {
    const slipsEl = root.querySelector<HTMLElement>('.ds-slips');
    const booksEl = root.querySelector<HTMLElement>('.ds-books');
    const titleEl = root.querySelector<HTMLElement>('.ds-title');
    const sayEl = root.querySelector<HTMLElement>('.ds-say');
    const prev = root.querySelector<HTMLButtonElement>('.ds-prev');
    const next = root.querySelector<HTMLButtonElement>('.ds-next');
    const play = root.querySelector<HTMLButtonElement>('.ds-play');
    const range = root.querySelector<HTMLInputElement>('.ds-range');
    const count = root.querySelector<HTMLElement>('.ds-count');
    if (!slipsEl || !booksEl || !titleEl || !sayEl || !prev || !next || !play || !range || !count) return;

    const rawSteps: unknown = JSON.parse(root.dataset.steps ?? '[]');
    const rawBooks: unknown = JSON.parse(root.dataset.books ?? '[]');
    if (!Array.isArray(rawSteps) || !Array.isArray(rawBooks)) return;
    const steps = rawSteps.filter(
      (x): x is DsStep =>
        typeof x === 'object' && x !== null && 'title' in x && 'say' in x && 'books' in x,
    );
    const bookNames = rawBooks.filter((x): x is string => typeof x === 'string');
    if (steps.length === 0 || bookNames.length === 0) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let at = 0;
    let timer = 0;

    const render = (): void => {
      const step = steps[at];
      slipsEl.replaceChildren();
      step.slips.forEach((text) => {
        const chip = document.createElement('span');
        chip.className = 'ds-slip';
        chip.textContent = text;
        slipsEl.append(chip);
      });

      booksEl.replaceChildren();
      bookNames.forEach((name, i) => {
        const lines = step.books[i] ?? [];
        const box = document.createElement('div');
        box.className = 'ds-book';
        const head = document.createElement('p');
        head.className = 'ds-book-head';
        head.textContent = name;
        box.append(head);
        lines.forEach((line) => {
          const row = document.createElement('p');
          row.className = 'ds-line' + (line.s === 'new' ? ' is-new' : line.s === 'no' ? ' is-no' : '');
          row.textContent = line.s === 'no' ? line.t + ' · ปฏิเสธ' : line.t;
          box.append(row);
        });
        const rows = Math.max(...step.books.map((b) => b.length));
        for (let k = lines.length; k < rows; k += 1) {
          const pad = document.createElement('p');
          pad.className = 'ds-fill';
          pad.textContent = '.';
          box.append(pad);
        }
        booksEl.append(box);
      });

      titleEl.textContent = at + 1 + '. ' + step.title;
      sayEl.textContent = step.say;
      count.textContent = at + 1 + ' / ' + steps.length;
      range.value = String(at);
      prev.disabled = at === 0;
      next.disabled = at === steps.length - 1;
    };

    const stop = (): void => {
      if (timer) window.clearInterval(timer);
      timer = 0;
      play.textContent = 'เล่นอัตโนมัติ';
    };

    range.max = String(steps.length - 1);
    prev.addEventListener('click', () => {
      stop();
      at = Math.max(0, at - 1);
      render();
    });
    next.addEventListener('click', () => {
      stop();
      at = Math.min(steps.length - 1, at + 1);
      render();
    });
    range.addEventListener('input', () => {
      stop();
      at = Number(range.value);
      render();
    });
    play.addEventListener('click', () => {
      if (timer) {
        stop();
        return;
      }
      play.textContent = 'หยุด';
      timer = window.setInterval(() => {
        if (at >= steps.length - 1) {
          stop();
          return;
        }
        at += 1;
        render();
      }, reduced ? 2600 : 2200);
    });

    render();
  }

  interface JourneyStep {
    station: number;
    title: string;
    say: string;
  }

  function initJourney(root: HTMLElement): void {
    const stage = root.querySelector<HTMLElement>('.jn-stage');
    const titleEl = root.querySelector<HTMLElement>('.jn-title');
    const sayEl = root.querySelector<HTMLElement>('.jn-say');
    const prev = root.querySelector<HTMLButtonElement>('.jn-prev');
    const next = root.querySelector<HTMLButtonElement>('.jn-next');
    const play = root.querySelector<HTMLButtonElement>('.jn-play');
    const range = root.querySelector<HTMLInputElement>('.jn-range');
    const count = root.querySelector<HTMLElement>('.jn-count');
    if (!stage || !titleEl || !sayEl || !prev || !next || !play || !range || !count) return;

    const rawSteps: unknown = JSON.parse(root.dataset.steps ?? '[]');
    const rawStations: unknown = JSON.parse(root.dataset.stations ?? '[]');
    if (!Array.isArray(rawSteps) || !Array.isArray(rawStations)) return;
    const steps = rawSteps.filter(
      (x): x is JourneyStep =>
        typeof x === 'object' && x !== null && 'station' in x && 'title' in x && 'say' in x,
    );
    const stations = rawStations.filter((x): x is string => typeof x === 'string');
    if (steps.length === 0 || stations.length === 0) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const W = 600;
    const H = 150;
    const gap = W / stations.length;
    const cx = (i: number): number => gap / 2 + i * gap;

    stage.innerHTML =
      '<svg class="btc-dgm jn-svg" viewBox="0 0 ' + W + ' ' + H + '" xmlns="http://www.w3.org/2000/svg" ' +
      'role="img" aria-label="เส้นทางของธุรกรรมจากกระเป๋าไปจนถูกฝังในสมุด" font-family="Sarabun, sans-serif">' +
      '<line x1="' + cx(0) + '" y1="60" x2="' + cx(stations.length - 1) + '" y2="60" stroke="#2a3350" stroke-width="2"/>' +
      stations
        .map(
          (name, i) =>
            '<g class="jn-station" data-i="' + i + '">' +
            '<circle cx="' + cx(i) + '" cy="60" r="13" fill="#141a29" stroke="#2a3350" stroke-width="2"/>' +
            '<text x="' + cx(i) + '" y="65" text-anchor="middle" font-size="11" fill="#9aa7bd">' + (i + 1) + '</text>' +
            '<text x="' + cx(i) + '" y="98" text-anchor="middle" font-size="11" fill="#9aa7bd">' + name + '</text>' +
            '</g>',
        )
        .join('') +
      '<circle class="jn-token" cx="' + cx(0) + '" cy="26" r="8" fill="#e0b400"/>' +
      '</svg>';

    const token = stage.querySelector<SVGCircleElement>('.jn-token');
    const stationEls = Array.from(stage.querySelectorAll<SVGGElement>('.jn-station'));
    if (token && !reduced) token.style.transition = 'cx .45s cubic-bezier(.16,1,.3,1)';

    let at = 0;
    let timer = 0;

    const render = (): void => {
      const step = steps[at];
      titleEl.textContent = at + 1 + '. ' + step.title;
      sayEl.textContent = step.say;
      count.textContent = at + 1 + ' / ' + steps.length;
      range.value = String(at);
      prev.disabled = at === 0;
      next.disabled = at === steps.length - 1;
      if (token) token.setAttribute('cx', String(cx(step.station)));
      stationEls.forEach((g, i) => {
        const circle = g.querySelector('circle');
        if (!circle) return;
        const done = i < step.station;
        const here = i === step.station;
        circle.setAttribute('stroke', here ? '#e0b400' : done ? '#4ade80' : '#2a3350');
        circle.setAttribute('fill', here ? '#2a2410' : '#141a29');
      });
    };

    const stop = (): void => {
      if (timer) window.clearInterval(timer);
      timer = 0;
      play.textContent = 'เล่นอัตโนมัติ';
    };

    range.max = String(steps.length - 1);
    prev.addEventListener('click', () => {
      stop();
      at = Math.max(0, at - 1);
      render();
    });
    next.addEventListener('click', () => {
      stop();
      at = Math.min(steps.length - 1, at + 1);
      render();
    });
    range.addEventListener('input', () => {
      stop();
      at = Number(range.value);
      render();
    });
    play.addEventListener('click', () => {
      if (timer) {
        stop();
        return;
      }
      play.textContent = 'หยุด';
      timer = window.setInterval(() => {
        if (at >= steps.length - 1) {
          stop();
          return;
        }
        at += 1;
        render();
      }, reduced ? 1600 : 1300);
    });

    render();
  }

  document.addEventListener('astro:page-load', () => {
    const labs: Array<[string, (el: HTMLElement) => void]> = [
      ['[data-hash-lab]', initHashLab],
      ['[data-chain-lab]', initChainLab],
      ['[data-mine-lab]', initMineLab],
      ['[data-merkle-lab]', initMerkleLab],
      ['[data-journey]', initJourney],
      ['[data-dspend]', initDspend],
      ['[data-target-lab]', initTargetLab],
      ['[data-race]', initRace],
    ];
    for (const [selector, init] of labs) {
      document.querySelectorAll<HTMLElement>(selector).forEach((el) => {
        if (el.dataset.wired === 'true') return;
        el.dataset.wired = 'true';
        init(el);
      });
    }
  });
</script>
