---
import { createHash } from 'node:crypto';
import DivineLoreLayout from '../../layouts/DivineLoreLayout.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import ExplainNumber from '../../components/ExplainNumber.astro';
import PhotoSlides from '../../components/PhotoSlides.astro';

/** แฮชทุกตัวในหน้านี้คำนวณตอน build จากของจริง ไม่ได้พิมพ์มือ */
const sha = (s: string): string => createHash('sha256').update(s).digest('hex');

/**
 * ตัวเลขทุกตัวในหน้านี้คำนวณตอน build จากโมเดลด้านล่าง ไม่ได้พิมพ์มือ
 * ค่าที่อ่านจากเครือข่ายจริง (ความสูงบล็อก อัตราแฮช ราคา) ตรึงไว้พร้อมวันที่กำกับ
 */

/** ค่าที่อ่านจากเครือข่ายจริง ณ วันที่ระบุ */
const SNAPSHOT_DATE = '3 กันยายน 2026';
const TIP_HEIGHT = 965_238;
const HASHRATE_EHS = 909.6;
const DIFFICULTY = 125_807_076_547_197.5;
const PRICE_USD = 77_006;
const PRICE_THB = 2_554_294;
const MARKET_CAP_USD = 1_546_383_013_353;

/** กติกาการออกเหรียญ */
const HALVING_INTERVAL = 210_000;
const SAT_PER_BTC = 100_000_000;
const INITIAL_REWARD_SAT = 50 * SAT_PER_BTC;
const BLOCK_MINUTES = 10;

interface Era {
  /** ยุคที่เท่าไร นับจาก 0 */
  index: number;
  /** ความสูงบล็อกแรกของยุคนี้ */
  startHeight: number;
  /** รางวัลต่อบล็อกในยุคนี้ หน่วยซาโตชิ */
  rewardSat: number;
  /** เหรียญที่ออกใหม่ทั้งยุค หน่วยซาโตชิ */
  mintedSat: number;
  /** เหรียญสะสมเมื่อจบยุคนี้ หน่วยซาโตชิ */
  cumulativeSat: number;
}

function buildEras(): Era[] {
  const eras: Era[] = [];
  let rewardSat = INITIAL_REWARD_SAT;
  let cumulativeSat = 0;
  let index = 0;
  while (rewardSat > 0) {
    const mintedSat = rewardSat * HALVING_INTERVAL;
    cumulativeSat += mintedSat;
    eras.push({
      index,
      startHeight: index * HALVING_INTERVAL,
      rewardSat,
      mintedSat,
      cumulativeSat,
    });
    rewardSat = Math.floor(rewardSat / 2);
    index += 1;
  }
  return eras;
}

const eras = buildEras();
const totalBtc = eras[eras.length - 1].cumulativeSat / SAT_PER_BTC;
const lastEra = eras[eras.length - 1];

/** ยุคปัจจุบันจากความสูงบล็อกที่อ่านมา */
const currentEraIndex = Math.floor(TIP_HEIGHT / HALVING_INTERVAL);
const currentEra = eras[currentEraIndex];
const currentRewardBtc = currentEra.rewardSat / SAT_PER_BTC;
const nextHalvingHeight = (currentEraIndex + 1) * HALVING_INTERVAL;
const blocksToHalving = nextHalvingHeight - TIP_HEIGHT;
const daysToHalving = (blocksToHalving * BLOCK_MINUTES) / 60 / 24;

/** เหรียญที่ออกมาแล้ว ณ ความสูงปัจจุบัน */
function mintedByHeight(height: number): number {
  let sat = 0;
  for (const era of eras) {
    const blocksInEra = Math.min(Math.max(height - era.startHeight, 0), HALVING_INTERVAL);
    sat += blocksInEra * era.rewardSat;
    if (height <= era.startHeight + HALVING_INTERVAL) break;
  }
  return sat;
}

const mintedBtc = mintedByHeight(TIP_HEIGHT) / SAT_PER_BTC;
const mintedPct = (mintedBtc / totalBtc) * 100;

/** วันที่ halving ที่เกิดไปแล้วจริง ส่วนอนาคตเป็นการประมาณ */
const halvingDates: Record<number, string> = {
  0: '3 ม.ค. 2009',
  1: '28 พ.ย. 2012',
  2: '9 ก.ค. 2016',
  3: '11 พ.ค. 2020',
  4: '20 เม.ย. 2024',
};
function eraWhen(index: number): string {
  const known = halvingDates[index];
  if (known) return known;
  return `ราวปี ${2024 + (index - 4) * 4}`;
}

/** ตารางยุคที่จะเอาไปแสดง เอาเจ็ดยุคแรกพอ แล้วต่อท้ายด้วยยุคสุดท้าย */
const eraRows = eras.slice(0, 7);

/** ข้อมูลกราฟอุปทานสะสม */
const CHART_W = 580;
const CHART_H = 300;
const PLOT_X0 = 62;
const PLOT_X1 = 552;
const PLOT_Y0 = 34;
const PLOT_Y1 = 236;
const CHART_ERAS = 10;
const chartMaxHeight = CHART_ERAS * HALVING_INTERVAL;

function chartX(height: number): number {
  return PLOT_X0 + (height / chartMaxHeight) * (PLOT_X1 - PLOT_X0);
}
function chartY(btc: number): number {
  return PLOT_Y1 - (btc / totalBtc) * (PLOT_Y1 - PLOT_Y0);
}

/** เดินทีละครึ่งยุคให้เส้นดูโค้งพอสมควร โดยที่ยังเป็นเส้นตรงต่อกันตามความจริง */
const supplyPoints: string[] = [];
for (let i = 0; i <= CHART_ERAS * 2; i += 1) {
  const h = (i / 2) * HALVING_INTERVAL;
  supplyPoints.push(`${chartX(h).toFixed(1)},${chartY(mintedByHeight(h) / SAT_PER_BTC).toFixed(1)}`);
}
const supplyPath = `M${supplyPoints.join(' L')}`;

/** จุดมาร์ก halving สี่ครั้งแรกบนกราฟ */
/** ป้ายวันที่ของฮาล์ฟวิงสองครั้งหลังอยู่ใกล้กันบนแกนจนตัวหนังสือชนกัน
    จึงสลับให้อยู่คนละบรรทัด แทนที่จะย่อฟอนต์ลงไปอีก */
const halvingMarks = [1, 2, 3, 4].map((i) => ({
  index: i,
  x: chartX(i * HALVING_INTERVAL),
  y: chartY(mintedByHeight(i * HALVING_INTERVAL) / SAT_PER_BTC),
  label: eraWhen(i),
  labelRow: i % 2 === 0 ? 1 : 0,
}));

const tipMark = {
  x: chartX(TIP_HEIGHT),
  y: chartY(mintedBtc),
};

/** ตารางดรอว์ดาวน์รายรอบ ตัวเลขเป็นค่าประมาณจากราคาปิดรายวัน */
interface Drawdown {
  cycle: string;
  peak: string;
  trough: string;
  fall: number;
  months: number;
}
const drawdowns: Drawdown[] = [
  { cycle: '2011', peak: 'มิ.ย. 2011', trough: 'พ.ย. 2011', fall: 93, months: 5 },
  { cycle: '2013 ถึง 2015', peak: 'ธ.ค. 2013', trough: 'ม.ค. 2015', fall: 86, months: 13 },
  { cycle: '2017 ถึง 2018', peak: 'ธ.ค. 2017', trough: 'ธ.ค. 2018', fall: 84, months: 12 },
  { cycle: '2021 ถึง 2022', peak: 'พ.ย. 2021', trough: 'พ.ย. 2022', fall: 77, months: 12 },
];

/** ถ้าลงไป f เปอร์เซ็นต์ ต้องขึ้นกี่เปอร์เซ็นต์ถึงจะกลับที่เดิม */
function recoveryPct(fallPct: number): number {
  const left = 1 - fallPct / 100;
  return (1 / left - 1) * 100;
}

/** พลังงาน */
const ENERGY_TWH = 138;
const ENERGY_YEAR = 2025;
const WORLD_SHARE_PCT = 0.54;

const fmt = (n: number, digits = 0) =>
  n.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });

/* ---------- ตัวอย่างแฮชสำหรับหัวข้อแฮช ---------- */
const HASH_A = 'hello';
const HASH_B = 'hellO';
const HASH_LONG =
  'Bitcoin: A Peer-to-Peer Electronic Cash System. Satoshi Nakamoto. satoshin@gmx.com. www.bitcoin.org';
const hashA = sha(HASH_A);
const hashB = sha(HASH_B);
const hashLong = sha(HASH_LONG);
/** นับว่าสองแฮชนี้มีตัวอักษรกี่ตัวที่ตรงกันในตำแหน่งเดียวกัน */
const sameChars = Array.from(hashA).filter((c, i) => c === hashB[i]).length;

const HEX_BITS = 4;
/** ตัวอักษรรายตัวของแฮชคู่เปรียบเทียบ ใช้ระบายเฉพาะตำแหน่งที่ตรงกัน
    ระยะ 6 หน่วยต่อตัวคือความกว้างของ JetBrains Mono ที่ font-size 10 */
const HASH_CH_W = 6;
const HASH_CH_X0 = 14;
const hashChars = (text: string, other: string): Array<{ c: string; x: number; same: boolean }> =>
  Array.from(text).map((c, i) => ({ c, x: HASH_CH_X0 + i * HASH_CH_W, same: c === other[i] }));
const hashCharsA = hashChars(hashA, hashB);
const hashCharsB = hashChars(hashB, hashA);

const HASH_BITS = 256;
const HASH_HEX_LEN = HASH_BITS / HEX_BITS;

/* ---------- โอกาสสุ่มกุญแจชนกัน ---------- */
const KEY_SPACE = Math.pow(2, HASH_BITS);
const WORLD_POP = 8_000_000_000;
const KEYS_PER_SEC = 1_000_000;
const UNIVERSE_SECONDS = 13.8e9 * 365.25 * 24 * 3600;
const keysEverMade = WORLD_POP * KEYS_PER_SEC * UNIVERSE_SECONDS;
const keySpaceRatio = KEY_SPACE / keysEverMade;
/** เขียนเลขมหาศาลเป็น "N ตามด้วยศูนย์อีก M ตัว" ให้อ่านออก */
const digitsOf = (n: number): number => Math.floor(Math.log10(n)) + 1;

/* ---------- ตัวเลขฝั่งการขุด ---------- */
/** จำนวนครั้งที่ทั้งโลกต้องเดาโดยเฉลี่ยกว่าจะได้หนึ่งบล็อก */
const hashesPerBlock = DIFFICULTY * Math.pow(2, 32);
/** พื้นที่ของแฮชทั้งหมด และจำนวนค่าที่นับว่าชนะ ใช้ตอบว่าโอกาสคือกี่ใน 2 ยกกำลัง 256
    คิดเป็นเลขทศนิยมพอ เพราะเอาไปแสดงเป็นสัญกรณ์วิทยาศาสตร์อยู่แล้ว */
const HASH_SPACE = Math.pow(2, 256);
const winningHashes = HASH_SPACE / hashesPerBlock;
/** เป้าหมายจริงกินพื้นที่กี่หลักฐานสิบหก ที่เหลือคือศูนย์นำหน้า */
/** ความเร็วที่เบราว์เซอร์ทำได้จริงในของเล่นข้างบน วัดคร่าว ๆ */
const BROWSER_HPS = 95_871;
const SECONDS_PER_YEAR = 365.25 * 24 * 3600;
const soloYears = hashesPerBlock / BROWSER_HPS / SECONDS_PER_YEAR;

/* ---------- สัดส่วนรายได้นักขุด อ่านจากบล็อกจริง 144 บล็อกล่าสุด ----------
   หน้าต่างเดียวนี้เป็นฐานของสามตัวเลขในบทความ คือธุรกรรมเฉลี่ยต่อบล็อก
   ธุรกรรมต่อวินาที และสัดส่วนค่าธรรมเนียม อ่านครั้งเดียวพร้อมกันในวันเผยแพร่
   ถ้าอ่านใหม่รอบหน้าต้องเปลี่ยนทั้งสี่ค่าพร้อมกัน รวมทั้งวันที่ด้วย */
const REWARD_WINDOW_BLOCKS = 144;
/** วันที่อ่านหน้าต่าง 144 บล็อกนี้ คนละวันกับ SNAPSHOT_DATE ของค่าที่อ่านจากเว็บภายนอก */
const REWARD_WINDOW_DATE = '30 สิงหาคม 2026';
const REWARD_TOTAL_SAT = 45_183_631_738;
const REWARD_FEE_SAT = 183_631_738;
const REWARD_TX_COUNT = 766_786;
const feeSharePct = (REWARD_FEE_SAT / REWARD_TOTAL_SAT) * 100;
const txPerBlock = REWARD_TX_COUNT / REWARD_WINDOW_BLOCKS;

/* ---------- ตัวอย่างต้นไม้เมอร์เคิล ---------- */
const merkleLeafLabels = ['ธุรกรรม 1', 'ธุรกรรม 2', 'ธุรกรรม 3', 'ธุรกรรม 4', 'ธุรกรรม 5', 'ธุรกรรม 6', 'ธุรกรรม 7', 'ธุรกรรม 8'];
function buildMerkle(labels: string[]): string[][] {
  const levels: string[][] = [labels.map((l) => sha(l))];
  while (levels[levels.length - 1].length > 1) {
    const prev = levels[levels.length - 1];
    const next: string[] = [];
    for (let i = 0; i < prev.length; i += 2) next.push(sha(prev[i] + prev[i + 1]));
    levels.push(next);
  }
  return levels;
}
const merkleLevels = buildMerkle(merkleLeafLabels);
const merkleProofLen = merkleLevels.length - 1;

/** หัวบล็อกหกช่อง พร้อมที่มาของแต่ละช่อง ใช้วาดภาพและอธิบายนอนซ์ */
interface HeaderField {
  name: string;
  bytes: number;
  lockedBy: string;
  free: boolean;
}
const headerFields: HeaderField[] = [
  { name: 'เวอร์ชัน', bytes: 4, lockedBy: 'กติกา', free: false },
  { name: 'แฮชบล็อกก่อนหน้า', bytes: 32, lockedBy: 'อดีตที่แก้ไม่ได้', free: false },
  { name: 'รากเมอร์เคิล', bytes: 32, lockedBy: 'ธุรกรรมที่เลือกมา', free: false },
  { name: 'เวลา', bytes: 4, lockedBy: 'นาฬิกา', free: false },
  { name: 'ความยาก', bytes: 4, lockedBy: 'กติกา', free: false },
  { name: 'นอนซ์', bytes: 4, lockedBy: 'ว่าง หมุนได้ตามใจ', free: true },
];
const headerBytes = headerFields.reduce((s, f) => s + f.bytes, 0);

/** การปรับความยาก: เป้าหมายคือสองสัปดาห์ต่อ 2016 ช่วง แต่โค้ดวัดจริงแค่ 2015 ช่วง */
const RETARGET_INTERVAL = (14 * 24 * 60) / BLOCK_MINUTES;



/** ขนาดของช่องนอนซ์ บทความพูดเป็นไบต์ให้ตรงกับภาพหัวบล็อก */
const NONCE_BYTES = 4;
const NONCE_BITS = NONCE_BYTES * 8;
const nonceSpace = Math.pow(2, NONCE_BITS);
const nonceSweeps = hashesPerBlock / nonceSpace;
/** เทียบโอกาสของการเดาหนึ่งครั้ง กับการซื้อสลากกินแบ่งหนึ่งใบ
    รางวัลที่ 1 เป็นเลขหกหลัก ความเป็นไปได้จึงมี 1,000,000 แบบ เป็นเลขคณิตล้วน ไม่ใช่สถิติที่ต้องอ้างแหล่ง */
const LOTTERY_OUTCOMES = 1_000_000;
const DICE_FACES = 6;
/** ถ้าซื้อสลากติดกันหลายงวด โอกาสถูกรางวัลที่ 1 ทุกงวดคือ 1 ใน 10^6 ยกกำลังจำนวนงวด
    เทียบแล้วการเดาแฮชถูกหนึ่งครั้ง อยู่ที่ประมาณกี่งวดติด */
const lotteryDrawsEqual = Math.log10(hashesPerBlock) / Math.log10(LOTTERY_OUTCOMES);

/** ที่มาของรอบปรับเป้า 2016 บล็อก */
const RETARGET_DAYS = 14;
const RETARGET_CLAMP = 4;

/** การปรับความยากลงแรงที่สุดในประวัติศาสตร์ อ่านจาก mempool.space */
const CHINA_DROP_PCT = 27.94;
const CHINA_DROP_DATE = '3 กรกฎาคม 2021';
const CHINA_DROP_HEIGHT = 689_472;

/** ตัวเลขฝั่งหลักฐานเมอร์เคิล คำนวณจากค่าที่อ่านมาจริงทั้งหมด */
const headersOnlyMb = (TIP_HEIGHT * headerBytes) / 1e6;
const proofHashes = Math.ceil(Math.log2(txPerBlock));
const MERKLE_ROOT_BYTES = 32;

/** ขนาดสมุดจริง อ่านจากกราฟ Blockchain Size ของ blockchain.com ณ วันสแนปช็อต
    ตัวเลขเป็นเมกะไบต์ตามที่ต้นทางรายงาน แล้วแปลงเป็นกิกะไบต์เอง */
const CHAIN_MB = 765_470;
const CHAIN_MB_YEAR_AGO = 683_320;
const CHAIN_YEAR_AGO_LABEL = '1 กันยายน 2025';
const MB_PER_GB = 1024;
/** สมุดทั้งเล่มหนักกว่าการเก็บเฉพาะส่วนหัวกี่เท่า ใช้ในภาพผ่าบล็อก
    ภาพนั้นพูดเป็นอัตราส่วนแทนตัวเลข GB เพราะตัวเลข GB เป็นของหัวข้อสมุดบวมแค่ไหนซึ่งอยู่ข้างล่าง */
const fullVsHeadersRatio = (CHAIN_MB * 1e6) / (TIP_HEIGHT * headerBytes);
const chainGb = CHAIN_MB / MB_PER_GB;

/** ตัวเลขที่ตัวติดตั้ง Bitcoin Core ประเมินไว้ในหน้าเลือกโฟลเดอร์ ณ วันที่แคปภาพ
    เก็บไว้เป็นค่าคงที่เพราะมันขัดกับตัวเลขขนาดสมุดในบทความ และต้องอธิบายความต่าง */
/** วันที่แคปภาพหน้าจอชุด Bitcoin Core ถ่ายคนละวันกับชุด check-* จึงแยกค่าไว้ */
const NODE_SHOT_DATE = '4 กันยายน 2026';
/** ภาพชุดซิงก์ถ่ายคร่อมสองวัน ตั้งแต่เปิดโปรแกรมรอบแรกจนไล่สมุดจบ */
const NODE_SYNC_DATES = '4 ถึง 5 กันยายน 2026';
/** วันที่ถ่ายภาพหน้าจอตอนไล่สมุดจบ */
const NODE_SHOT_DATE_DONE = '5 กันยายน 2026';
const CORE_ESTIMATE_GB = 856;
/** ตัวเลขที่หน้าดาวน์โหลดของ bitcoincore.org เขียนกำกับไว้ ณ วันที่แคปภาพ */
const CORE_SITE_GB = 600;
const chainGrowthGb = (CHAIN_MB - CHAIN_MB_YEAR_AGO) / MB_PER_GB;

/** เพดานที่กติกากำหนด BIP-141 จำกัดน้ำหนักบล็อกไว้ที่ 4,000,000 หน่วย
    ซึ่งแปลว่าบล็อกใหญ่ได้ไม่เกินราว 4 เมกะไบต์แม้ในกรณีสุดขั้ว */
const MAX_BLOCK_MB = 4;
const blocksPerYear = (365 * 24 * 60) / BLOCK_MINUTES;
const maxGrowthGb = (MAX_BLOCK_MB * blocksPerYear) / MB_PER_GB;

/** ปริมาณงานที่รับได้ คำนวณจากธุรกรรมต่อบล็อกที่อ่านมาจริง */
const txPerSecond = txPerBlock / (BLOCK_MINUTES * 60);
const VISA_TPS = 83_000;
const visaRatio = VISA_TPS / txPerSecond;

/** ตัวเดินเรื่องการขุดแซง ใช้แทนภาพนิ่งความลึกเดิม สร้างตอน build สคริปต์แค่เรนเดอร์ */
interface RaceStep {
  title: string;
  say: string;
  /** จำนวนบล็อกที่ต่อแล้วในสายหลัก และในสายลับของคนโกง */
  main: number;
  evil: number;
  /** เน้นบล็อกที่ธุรกรรมของคุณอยู่ */
  markTx: boolean;
}
const raceSteps: RaceStep[] = [
