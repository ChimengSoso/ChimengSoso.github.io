        <text x="306" y="96" font-size="11" fill="#e7ecf6">ไปร้าน 0.0200</text>
        <rect x="294" y="112" width="216" height="26" rx="5" fill="#12161f" stroke="#5b6478" stroke-dasharray="5 4"/>
        <text x="306" y="130" font-size="11" fill="#5b6478">ไม่มีก้อนเงินทอน</text>
        <rect x="294" y="146" width="216" height="26" rx="5" fill="#241f0d" stroke="#d64545"/>
