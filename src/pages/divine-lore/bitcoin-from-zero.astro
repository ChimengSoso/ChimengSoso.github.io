      <rect x="14" y="30" width="150" height="120" rx="10" fill="#141a29" stroke="#4ade80"/>
      <text x="89" y="52" text-anchor="middle" font-size="11" fill="#4ade80">โหนด A</text>
      <rect x="28" y="62" width="122" height="20" rx="4" fill="#241f0d" stroke="#e0b400"/>
      <text x="89" y="77" text-anchor="middle" font-size="10" fill="#e0b400">ใบของคุณ</text>
