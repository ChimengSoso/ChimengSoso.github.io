const PLOT_X1 = 552;
const PLOT_Y0 = 34;
const PLOT_Y1 = 236;
const CHART_ERAS = 10;
const chartMaxHeight = CHART_ERAS * HALVING_INTERVAL;

function chartX(height: number): number {
  return PLOT_X0 + (height / chartMaxHeight) * (PLOT_X1 - PLOT_X0);
}
function chartY(btc: number): number {
  return PLOT_Y1 - (btc / totalBtc) * (PLOT_Y1 - PLOT_Y0);
}

/** เดินทีละครึ่งยุคให้เส้นดูโค้งพอสมควร โดยที่ยังเป็นเส้นตรงต่อกันตามความจริง */
