            '<text x="' + cx(i) + '" y="65" text-anchor="middle" font-size="11" fill="#9aa7bd">' + (i + 1) + '</text>' +
            '<text x="' + cx(i) + '" y="98" text-anchor="middle" font-size="11" fill="#9aa7bd">' + name + '</text>' +
            '</g>',
        )
        .join('') +
      '<circle class="jn-token" cx="' + cx(0) + '" cy="26" r="8" fill="#e0b400"/>' +
      '</svg>';

    const sceneEl = root.querySelector<HTMLElement>('.jn-scene');
    const token = stage.querySelector<SVGCircleElement>('.jn-token');
    const stationEls = Array.from(stage.querySelectorAll<SVGGElement>('.jn-station'));
    if (token && !reduced) token.style.transition = 'cx .45s cubic-bezier(.16,1,.3,1)';

    let at = 0;
    let timer = 0;

    const render = (): void => {
      const step = steps[at];
      if (sceneEl) sceneEl.innerHTML = journeyScene(step.scene);
      // ไม่ใส่เลขนำหน้าพาดหัวแล้ว เพราะมันเป็นเลขคนละชุดกับเลขสถานีบนราง
      titleEl.textContent = step.title;
      sayEl.textContent = step.say;
      count.textContent = 'จังหวะ ' + (at + 1) + ' / ' + steps.length;
      range.value = String(at);
      prev.disabled = at === 0;
      next.disabled = at === steps.length - 1;
      if (token) token.setAttribute('cx', String(cx(step.station)));
      stationEls.forEach((g, i) => {
        const circle = g.querySelector('circle');
        if (!circle) return;
        const done = i < step.station;
        const here = i === step.station;
        circle.setAttribute('stroke', here ? '#e0b400' : done ? '#4ade80' : '#2a3350');
        circle.setAttribute('fill', here ? '#2a2410' : '#141a29');
      });
    };

    const stop = (): void => {
      if (timer) window.clearInterval(timer);
      timer = 0;
      play.textContent = 'เล่นอัตโนมัติ';
    };

    range.max = String(steps.length - 1);
    prev.addEventListener('click', () => {
      stop();
      at = Math.max(0, at - 1);
      render();
    });
    next.addEventListener('click', () => {
      stop();
      at = Math.min(steps.length - 1, at + 1);
      render();
    });
    range.addEventListener('input', () => {
      stop();
      at = Number(range.value);
      render();
    });
    play.addEventListener('click', () => {
      if (timer) {
        stop();
        return;
      }
      play.textContent = 'หยุด';
      timer = window.setInterval(() => {
        if (at >= steps.length - 1) {
          stop();
          return;
        }
        at += 1;
        render();
      }, reduced ? 1600 : 1300);
    });

    render();
  }

  document.addEventListener('astro:page-load', () => {
    const labs: Array<[string, (el: HTMLElement) => void]> = [
      ['[data-hash-lab]', initHashLab],
      ['[data-chain-lab]', initChainLab],
      ['[data-mine-lab]', initMineLab],
      ['[data-merkle-build]', initMerkleBuild],
      ['[data-merkle-lab]', initMerkleLab],
      ['[data-overview]', initOverview],
      ['[data-journey]', initJourney],
      ['[data-dspend]', initDspend],
      ['[data-target-lab]', initTargetLab],
      ['[data-race]', initRace],
    ];
    for (const [selector, init] of labs) {
      document.querySelectorAll<HTMLElement>(selector).forEach((el) => {
        if (el.dataset.wired === 'true') return;
        el.dataset.wired = 'true';
        init(el);
      });
    }
  });
</script>

<script>
  /** ทยอยโชว์เนื้อหาตามการเลื่อนหน้า

      แนวคิด: ย้ายเนื้อบทความทั้งก้อนเข้ากล่องครอบหนึ่งใบ แล้วจำกัดความสูงของกล่องนั้น
      ให้ล้ำหน้าขอบล่างของจอไปเล็กน้อยเสมอ ความสูงของทั้งหน้าจึงโตตามที่ผู้อ่านเลื่อนลงไป
      แถบเลื่อนค่อย ๆ ยาวขึ้นแทนที่จะประกาศความยาวทั้งบทตั้งแต่วินาทีแรก

      รอยตัดอยู่ต่ำกว่าขอบล่างของจอเสมอ ผู้อ่านจึงไม่เห็นรอย ไม่ต้องมีขอบจางมากลบ
      เคยลองทา mask ไล่สีที่ขอบล่างแล้วถอดออก เพราะ mask ทาลงทั้งซับทรีรวมถึงกล่องขยายภาพ
      ที่เป็น position:fixed ซึ่งเป็นความเสี่ยงที่ไม่ได้อะไรกลับมาเลย

      ทำไมตัดด้วยความสูง ไม่ใช่ซ่อนทีละชิ้นด้วย display:none
      เพราะแล็บหลายตัวในหน้านี้วัดขนาดของตัวเองตอนเริ่ม ถ้าตอนนั้นกล่องถูกถอดออกจากผัง
      ค่าที่วัดได้จะเป็นศูนย์แล้ววาดเพี้ยนถาวร วิธีตัดทำให้ทุกอย่างยังถูกจัดผังตามจริง

      สคริปต์นี้อยู่ท้ายไฟล์ จึงทำงานหลังแล็บทุกตัววัดขนาดเสร็จแล้ว การย้ายเข้ากล่อง
      ไม่เปลี่ยนความกว้าง และการย้ายแท็กสคริปต์ที่รันไปแล้วไม่ทำให้มันรันซ้ำ */
  (() => {
    const panel = document.querySelector('.panel');
    if (!(panel instanceof HTMLElement) || panel.hasAttribute('data-reveal-wired')) return;
    panel.setAttribute('data-reveal-wired', '');

    const kids = Array.from(panel.children);
    const subtitle = panel.querySelector('p.subtitle');
    // หัวเรื่องกับความนำอยู่เหนือรอยพับ ปล่อยไว้นอกกล่อง เห็นเต็มตั้งแต่แรก
    const from = subtitle ? kids.indexOf(subtitle) + 1 : 0;
    const body = kids.slice(from);
    if (body.length === 0) return;

    const flow = document.createElement('div');
    flow.className = 'btc-flow';
    panel.insertBefore(flow, body[0]);
    for (const el of body) flow.appendChild(el);

    /** ระยะที่ยอมให้เนื้อหาล้ำพ้นขอบล่างของจอ เผื่อไว้สองอย่าง
        หนึ่งคือรอยตัดไม่โผล่มาให้เห็น สองคือผู้อ่านมีที่ให้เลื่อนต่อเสมอ ไม่ชนก้นหน้า */
    const LEAD = 0.85;
    /** ตำแหน่งบนของกล่องกับความสูงเนื้อหาเต็ม เก็บไว้เพื่อไม่ต้องอ่านผังทุกครั้งที่เลื่อน
        ค่าพวกนี้เปลี่ยนได้เมื่อจอเปลี่ยนขนาดหรือมีคนกางกล่องพับ จึงอ่านใหม่ตามจังหวะข้างล่าง */
    let top = flow.offsetTop;
    let full = flow.scrollHeight;
    let ceiling = 0;

    /** ไม่หุ้มด้วย requestAnimationFrame ตั้งใจ
        เคยเขียนแบบหุ้มไว้แล้วเจอว่าถ้าเบราว์เซอร์วาดเฟรมไม่ทัน งานจะไม่ถูกทำ
        ผู้อ่านเลื่อนถึงก้นหน้าแล้วหน้าไม่ยอมโตต่อ กลายเป็นชนกำแพง
        งานในนี้เป็นเลขคณิตล้วนกับค่าที่แคชไว้ จึงถูกพอที่จะทำตรง ๆ ทุกครั้งที่เลื่อน */
    const grow = (): void => {
      const want = window.scrollY + window.innerHeight * (1 + LEAD) - top;
      if (want <= ceiling) return;
      ceiling = want;
      if (ceiling >= full) {
        // ใกล้ถึงท้ายบทแล้ว วัดความสูงจริงอีกครั้งเผื่อมีคนกางกล่องพับระหว่างทาง
        full = flow.scrollHeight;
        if (ceiling >= full) {
          openAll();
          return;
        }
      }
      flow.style.maxHeight = ceiling + 'px';
    };
    /** เลิกตัดความสูง แล้วถอดตัวฟังทิ้งทั้งหมด ใช้สองจังหวะ
        หนึ่งคือผู้อ่านเลื่อนมาถึงท้ายบทเองตามปกติ
        สองคือผู้อ่านกดสารบัญกระโดดไปหัวข้อที่ยังไม่ถูกเปิด ซึ่งถ้าไม่กางก่อน
        ตำแหน่งปลายทางยังไม่มีอยู่จริงในผัง หน้าจะเลื่อนไปไม่ถึง */
    const openAll = (): void => {
      flow.style.maxHeight = '';
      /* กล่องที่ overflow:hidden ยังถูกเลื่อนภายในได้ด้วยสคริปต์หรือการกระโดดตามแองเคอร์
         ถ้าเคยโดนเลื่อนไว้ เนื้อหาจะเหลื่อมกับหน้าถาวร ดึงกลับศูนย์ทุกครั้งที่กาง */
      flow.scrollTop = 0;
      window.removeEventListener('scroll', grow);
      window.removeEventListener('resize', remeasure);
      window.removeEventListener('wheel', grow);
      window.removeEventListener('touchmove', grow);
    };
    const remeasure = (): void => {
      top = flow.offsetTop;
      full = flow.scrollHeight;
      grow();
    };

    /* สารบัญของเลย์เอาต์กางเนื้อหาผ่านเหตุการณ์นี้ก่อนกระโดดไปหัวข้อที่ยังไม่ถูกเปิด
       ใช้เหตุการณ์แทนการฝากฟังก์ชันไว้บนโหนด เพราะสองสคริปต์นี้อยู่คนละไฟล์
       และการฝากพร็อปเพอร์ตี้ไว้บนอิลิเมนต์เป็นสัญญาที่มองไม่เห็นจากฝั่งที่เรียก */
    panel.addEventListener('dl-reveal-open-all', openAll);

    /** เลื่อนหน้าไปที่หัวข้อ โดยไม่ใช้ scrollIntoView
        กล่อง .btc-flow เป็น overflow:hidden ซึ่งยังนับเป็นกล่องเลื่อนได้
        scrollIntoView จะเลือกกล่องเลื่อนที่ใกล้ที่สุด ซึ่งอาจเป็นตัวกล่องเอง
        ผลคือเนื้อหาถูกเลื่อนอยู่ข้างในและเหลื่อมกับหน้าถาวร */
    const jumpTo = (el: Element): void => {
      flow.scrollTop = 0;
      window.scrollTo(0, el.getBoundingClientRect().top + window.scrollY);
    };

    /* ลิงก์ข้ามหัวข้อในบทเดียวกันก็เจอปัญหาเดียวกับสารบัญ คือปลายทางอาจยังไม่ถูกกาง
       ปล่อยให้เบราว์เซอร์กระโดดเองจะยิ่งแย่ เพราะมันไปเลื่อน "ข้างใน" กล่องที่ตัดความสูงอยู่
       ซึ่งทำให้เนื้อหาเหลื่อมกับหน้าถาวร ดักไว้ตรงนี้ทีเดียวครอบคลุมทุกลิงก์ในหน้า
       ลิงก์ในสารบัญมีตัวจัดการของเลย์เอาต์อยู่แล้ว จึงข้ามไป */
    document.addEventListener('click', (e: MouseEvent) => {
      /* ไม่เช็ค defaultPrevented ตรงนี้ เพราะ ClientRouter ของ Astro ดักคลิกลิงก์ในหน้าเดียวกัน
         แล้วสั่ง preventDefault ไปก่อนแล้วเสมอ ถ้าเช็คจะเด้งออกทุกครั้งและไม่มีวันทำงาน
         ตัวจัดการนี้ทำงานทีหลัง และเลื่อนหน้าในเฟรมถัดไป จึงเป็นคนสุดท้ายที่กำหนดตำแหน่ง */
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      if (!(e.target instanceof Element)) return;
      const link = e.target.closest('a[href^="#"]');
      if (!link || link.closest('.dl-toc-list')) return;
      const id = (link.getAttribute('href') ?? '').slice(1);
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      e.preventDefault();
      openAll();
      requestAnimationFrame(() => {
        jumpTo(target);
        history.replaceState(null, '', `#${id}`);
      });
    });

    window.addEventListener('scroll', grow, { passive: true });
    window.addEventListener('resize', remeasure, { passive: true });
    /* ฟัง wheel กับ touchmove เพิ่มเป็นตาข่ายรองรับ
       เบราว์เซอร์ยิง scroll event ตามจังหวะเฟรม ถ้าเครื่องช้าจนเฟรมหล่น
       ผู้อ่านอาจเลื่อนไปชนก้นหน้าก่อนที่หน้าจะทันโต สองตัวนี้มาก่อนเฟรมเสมอ */
    window.addEventListener('wheel', grow, { passive: true });
    window.addEventListener('touchmove', grow, { passive: true });
    grow();
  })();
</script>
