  /* ไทม์ไลน์ประวัติ เป็น HTML ไม่ใช่ SVG เพราะเนื้อหาเป็นข้อความล้วน
     ถ้าวาดเป็น SVG ตัวอักษรจะถูกสเกลขึ้นตามความกว้างคอลัมน์จนใหญ่ผิดสัดส่วน */
  .tl{list-style:none;padding:0;margin:1.25rem 0 0.4rem;border-left:2px solid var(--dl-border);}
