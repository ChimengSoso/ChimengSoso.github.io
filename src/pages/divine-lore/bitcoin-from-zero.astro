/** เขียนเลขมหึมาเป็นสัญกรณ์วิทยาศาสตร์แบบอ่านออก เช่น 5.40 x 10^23 */
const expo = (n: number): string => {
  const e = Math.floor(Math.log10(n));
  return (n / Math.pow(10, e)).toFixed(2) + ' x 10 ยกกำลัง ' + e;
};

