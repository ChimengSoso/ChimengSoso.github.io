/**
 * ตัวเลขทุกตัวในบทความนี้คำนวณตอน build ไม่ได้พิมพ์มือ
 * โมเดลหลักมีสามชุด
 *  1) ผลตอบแทนที่ Forex-3D สัญญาไว้ (10% ต่อเดือน) แปลงเป็นรายปี
 *  2) เครื่องยนต์ปอนซี: เงินใหม่เข้า เทียบกับภาระผลตอบแทนที่สะสม
 *  3) ภาษีเงินได้บุคคลธรรมดา เทียบกับภาษีเงินได้นิติบุคคลอัตรา SME
 */

/* ---------- 1) ผลตอบแทนที่สัญญา ---------- */
const MONTHLY = 0.10;
const YEARLY_COMPOUND = Math.pow(1 + MONTHLY, 12) - 1;
const YEARLY_SIMPLE = MONTHLY * 12;
const SEED = 100_000;
const seedAfter5y = SEED * Math.pow(1 + MONTHLY, 60);
const setAfter5y = SEED * Math.pow(1.08, 5);

/* ---------- 2) เครื่องยนต์ปอนซี ---------- */
interface PonziRow {
  month: number;
  inflow: number;
  cumPrincipal: number;
  due: number;
  net: number;
}

/** เงินใหม่เข้าเดือนละเท่ากัน ภาระจ่ายผลตอบแทนโตตามเงินต้นที่รับสะสมมา */
function ponzi(inflow: number, rate: number, months: number): PonziRow[] {
  const rows: PonziRow[] = [];
  let cum = 0;
  for (let m = 1; m <= months; m++) {
    const due = rate * cum;
    rows.push({ month: m, inflow, cumPrincipal: cum, due, net: inflow - due });
    cum += inflow;
  }
  return rows;
}

/**
 * เดือนแรกที่เงินใหม่จ่ายผลตอบแทนไม่ไหว
 * ตั้งเงินเข้าเดือนแรกเป็น 1 หน่วย แล้วให้โตเดือนละ growth
 * คืน 0 เมื่อไม่พังภายในกรอบที่คำนวณ (แปลว่าต้องโตแบบนี้ไปตลอดกาล)
 * สูตรเดียวกันนี้ถูกเขียนซ้ำในสคริปต์ของเครื่องคิดเลขข้างล่าง ห้ามแก้ข้างเดียว
 */
function collapseMonth(rate: number, growth: number, maxMonths = 600): number {
  // กรณี growth >= rate พิสูจน์ได้ว่าไม่มีวันติดลบ ตัดออกก่อนเพราะพอ n ใหญ่มาก
  // ความคลาดเคลื่อนของเลขทศนิยมจะทำให้เงื่อนไขข้างล่างติดหลอก ๆ
  if (growth >= rate) return 0;
  for (let n = 1; n <= maxMonths; n++) {
    const inflow = Math.pow(1 + growth, n - 1);
    const cumP = growth === 0 ? n - 1 : (Math.pow(1 + growth, n - 1) - 1) / growth;
    if (rate * cumP > inflow) return n;
  }
  return 0;
}

const INFLOW = 10_000_000;
const ponziRows = ponzi(INFLOW, MONTHLY, 14);
const breakEvenMonth = ponziRows.find((r) => r.net <= 0)!.month;
const firstNegative = ponziRows.find((r) => r.net < 0)!.month;
const growthCases = [0, 0.03, 0.05, 0.08, 0.1].map((g) => ({ g, die: collapseMonth(MONTHLY, g) }));
/** ถ้าต้องโตเดือนละ 10% จริง ๆ ห้าปีผ่านไปเงินเข้าต่อเดือนต้องใหญ่ขึ้นกี่เท่า */
const growthAfter5y = Math.pow(1 + MONTHLY, 60);

/* พิกัดกราฟเทียบเงินเข้ากับภาระจ่าย */
const PC = { x0: 62, y0: 34, w: 606, h: 178 };
const pcMax = INFLOW * 1.45;
const pcSlot = PC.w / ponziRows.length;
const pcBarW = pcSlot * 0.52;
const pcY = (v: number) => PC.y0 + PC.h - (v / pcMax) * PC.h;
const pcDuePath = ponziRows
  .map((r, i) => `${i === 0 ? 'M' : 'L'}${(PC.x0 + (i + 0.5) * pcSlot).toFixed(2)} ${pcY(r.due).toFixed(2)}`)
  .join(' ');
const pcCrossX = PC.x0 + (breakEvenMonth - 0.5) * pcSlot;

/* ---------- 3) ภาษี ---------- */
/** ภาษีเงินได้บุคคลธรรมดา คิดจากเงินได้สุทธิ (หลังหักค่าใช้จ่ายและค่าลดหย่อนแล้ว) */
function pit(net: number): number {
  const bands: [number, number][] = [
    [150_000, 0],
    [150_000, 0.05],
    [200_000, 0.1],
    [250_000, 0.15],
    [250_000, 0.2],
    [1_000_000, 0.25],
    [3_000_000, 0.3],
    [Infinity, 0.35],
  ];
  let left = net;
  let tax = 0;
  for (const [width, rate] of bands) {
    const take = Math.min(left, width);
    if (take <= 0) break;
    tax += take * rate;
    left -= take;
  }
  return tax;
}

/** ภาษีเงินได้นิติบุคคล อัตรา SME (ทุนชำระแล้วไม่เกิน 5 ล้าน รายได้ไม่เกิน 30 ล้าน) */
function cit(profit: number): number {
  let tax = 0;
  let p = profit;
  if (p > 3_000_000) {
    tax += (p - 3_000_000) * 0.2;
    p = 3_000_000;
  }
  if (p > 300_000) tax += (p - 300_000) * 0.15;
  return tax;
}

const DIVIDEND_WHT = 0.1;
const taxRows = [500_000, 1_000_000, 3_000_000, 5_000_000, 10_000_000].map((p) => {
  const personal = pit(p);
  const company = cit(p);
  const dividend = (p - company) * DIVIDEND_WHT;
  return { p, personal, company, both: company + dividend };
});
/** กำไรที่บริษัทเริ่มถูกกว่าบุคคลธรรมดา (ยังไม่นับตอนดึงเงินออก) */
const citWinsAt = taxRows.find((r) => r.company < r.personal)!.p;
/** กำไรที่บริษัทถูกกว่าจริง แม้จะจ่ายปันผลออกมาทั้งก้อนแล้ว */
const bothWinsAt = taxRows.find((r) => r.both < r.personal)!.p;

/* ---------- 4) ตัวเลขคดี ---------- */
const VICTIMS_COURT = 9_822;
const VICTIMS_REPORTED = 9_824;
const LOSS = 2_489_820_321.52;
const PER_COUNT_YEARS = 5;
const PER_COUNT_FINE = 500_000;
const TOTAL_YEARS = VICTIMS_COURT * PER_COUNT_YEARS;
const TOTAL_FINE = VICTIMS_COURT * PER_COUNT_FINE;
const CAP_YEARS = 20;
const SEIZED = 586_000_000;
const recoveryPct = (SEIZED / LOSS) * 100;
const perHeadLoss = LOSS / VICTIMS_REPORTED;
const perHeadBack = SEIZED / VICTIMS_REPORTED;
const interestPerYear = LOSS * 0.075;

/* ---------- ไทม์ไลน์ ---------- */
interface Beat {
  when: string;
  year: number;
  what: string;
}
const timeline: Beat[] = [
  { when: 'มี.ค. 2558', year: 2015, what: 'จดทะเบียนบริษัท อาร์เอ็มเอส แฟมิเลีย และเปิดเว็บไซต์ forex-3d.com ชูจุดขายว่ามีทีมเทรดระดับโลกและใช้ระบบคอมพิวเตอร์คำนวณค่าเงินให้' },
  { when: 'พ.ย. 2558', year: 2015, what: 'ศาลนับช่วงเวลากระทำผิดจากเดือนนี้เป็นต้นไป เริ่มรับเงินจากประชาชนเข้าระบบ' },
  { when: '2559 ถึง 2560', year: 2016, what: 'ระบบจ่ายผลตอบแทนได้จริงและตรงเวลา ผู้ลงทุนรุ่นแรกกลายเป็นพยานบุคคลที่ดีที่สุดของขบวนการ ยอดสมาชิกขยายผ่านสายงานแนะนำ' },
  { when: 'ส.ค. 2561', year: 2018, what: 'เปิดโชว์รูมรถหรูและขยายเข้าธุรกิจบันเทิง พาคนดังเข้ามาอยู่ในภาพ ความน่าเชื่อถือถูกเติมด้วยของที่จับต้องได้' },
  { when: 'ปลาย 2561', year: 2018, what: 'เริ่มจ่ายช้า ถอนเงินต้นไม่ได้ อ้างระบบมีปัญหาและตลาดผันผวน' },
  { when: 'พ.ย. 2562', year: 2019, what: 'กรมสอบสวนคดีพิเศษรับเป็นคดีพิเศษ ผู้เสียหายเข้าร้องทุกข์รวม 9,824 ราย ความเสียหายราว 2,489 ล้านบาท' },
  { when: 'ก.ย. 2563', year: 2020, what: 'ปลายทางของช่วงเวลากระทำผิดตามที่อัยการฟ้อง สำนักงาน ปปง. เริ่มยึดและอายัดทรัพย์เป็นชุด' },
  { when: 'ม.ค. 2564', year: 2021, what: 'จับกุมผู้ก่อตั้งได้ที่คอนโดย่านทองหล่อ' },
  { when: 'มี.ค. 2564', year: 2021, what: 'อัยการยื่นฟ้องชุดใหญ่ คดีถูกแยกออกเป็นหลายสำนวนตามกลุ่มจำเลย' },
  { when: 'ธ.ค. 2567', year: 2024, what: 'สำนวนของกลุ่มผู้สนับสนุนตัดสินก่อน จำคุกสามคน คนละ 49,125 ปี ยกฟ้องอีกสี่คน' },
  { when: '13 ส.ค. 2569', year: 2026, what: 'สำนวนหลัก 24 จำเลยตัดสิน จำคุกห้าคน คนละ 49,110 ปี ปรับนิติบุคคลสองรายรายละ 4,911 ล้านบาท และยกฟ้องที่เหลือ' },
];
const TL = { x0: 46, y0: 96, w: 632 };
const tlYears = [2015, 2017, 2019, 2021, 2023, 2026];
const tlX = (y: number) => TL.x0 + ((y - 2015) / (2026 - 2015)) * TL.w;

const baht = (n: number) => Math.round(n).toLocaleString('en-US');
const mB = (n: number) => (n / 1_000_000).toLocaleString('en-US', { maximumFractionDigits: 0 });
const pct = (n: number) => (n * 100).toFixed(1);
