<script>
  // เครื่องหาวันหมดอายุของแชร์ลูกโซ่
  // สูตรนี้ต้องตรงกับ collapseMonth() ในเฟรนต์แมตเตอร์เป๊ะ ๆ แก้ที่เดียวไม่ได้
  function collapseMonth(rate: number, growth: number, maxMonths = 600): number {
    if (growth >= rate) return 0;
    for (let n = 1; n <= maxMonths; n++) {
      const inflow = Math.pow(1 + growth, n - 1);
      const cumP = growth === 0 ? n - 1 : (Math.pow(1 + growth, n - 1) - 1) / growth;
      if (rate * cumP > inflow) return n;
    }
    return 0;
  }

  function initPonziCalc() {
    document.querySelectorAll<HTMLElement>('[data-ponzi]').forEach((root) => {
      const rateIn = root.querySelector<HTMLInputElement>('[data-in="rate"]');
      const growthIn = root.querySelector<HTMLInputElement>('[data-in="growth"]');
      const rateOut = root.querySelector<HTMLElement>('[data-out="rate"]');
      const growthOut = root.querySelector<HTMLElement>('[data-out="growth"]');
      const verdict = root.querySelector<HTMLElement>('[data-out="verdict"]');
      const note = root.querySelector<HTMLElement>('[data-out="note"]');
      if (!rateIn || !growthIn || !rateOut || !growthOut || !verdict || !note) return;

      const render = () => {
        const ratePct = Number(rateIn.value);
        const growthPct = Number(growthIn.value);
        rateOut.textContent = String(ratePct);
        growthOut.textContent = String(growthPct);

        const die = collapseMonth(ratePct / 100, growthPct / 100);
        if (die === 0) {
          const mult = Math.pow(1 + growthPct / 100, 60);
          verdict.innerHTML = '<span class="safe">ไม่พังทางเลขคณิต</span> แต่ต้องหาเงินใหม่ให้โตแบบนี้ไปตลอดกาล';
          note.textContent =
            `โตเดือนละ ${growthPct}% แปลว่าอีกห้าปีข้างหน้า เงินใหม่ที่ต้องหาได้ในเดือนเดียว` +
            ` ต้องใหญ่กว่าเดือนแรก ${Math.round(mult).toLocaleString('en-US')} เท่า`;
        } else {
          const years = Math.floor(die / 12);
          const months = die % 12;
          const human =
            years > 0 ? (months > 0 ? `${years} ปี ${months} เดือน` : `${years} ปีพอดี`) : `${months} เดือน`;
          verdict.innerHTML = `จ่ายไม่ไหวตั้งแต่ <span class="big">เดือนที่ ${die}</span>`;
          note.textContent = `คือราว ${human} หลังรับเงินก้อนแรก นับจากเดือนที่หนึ่งเป็นเดือนที่เริ่มรับเงิน`;
        }
      };

      rateIn.addEventListener('input', render);
      growthIn.addEventListener('input', render);
      render();
    });
  }

  document.addEventListener('astro:page-load', initPonziCalc);
</script>
