/* ---------- S4 เดินตามคอลัมน์ทีละก้าว ----------
   ทุกพิกัดในภาพคำนวณจากเมทริกซ์จริง ไม่มีเลขไหนวางด้วยมือ */
const WALK = { u: 3, v: 2, tilt: 40 };
const walkAxes = (deg: number): { e1: [number, number]; e2: [number, number] } => {
  const t = (deg * Math.PI) / 180;
  return { e1: [Math.cos(t), Math.sin(t)], e2: [-Math.sin(t), Math.cos(t)] };
};
const walkSvg = (deg: number, steps: number): string => {
  const { e1, e2 } = walkAxes(deg);
  const O = [180, 210];
  const U = 46;
  const at = (a: number, b: number): [number, number] => [
    O[0] + (a * e1[0] + b * e2[0]) * U,
    O[1] - (a * e1[1] + b * e2[1]) * U,
  ];
  const p = (c: [number, number]): string => `${c[0].toFixed(1)} ${c[1].toFixed(1)}`;
  const arrow = (from: [number, number], to: [number, number], color: string, w = 2.4): string =>
    `<line x1="${from[0].toFixed(1)}" y1="${from[1].toFixed(1)}" x2="${to[0].toFixed(1)}" y2="${to[1].toFixed(1)}" stroke="${color}" stroke-width="${w}" marker-end="url(#s4a-${color.slice(1)})"/>`;
  const legs: string[] = [];
  if (steps >= 1) legs.push(arrow(at(0, 0), at(WALK.u, 0), '#4ade80', 3));
  if (steps >= 2) legs.push(arrow(at(WALK.u, 0), at(WALK.u, WALK.v), '#e0b400', 3));
  const dest = at(WALK.u, WALK.v);
  const grid: string[] = [];
  for (let i = -1; i <= 4; i += 1) {
    grid.push(`<line x1="${p(at(i, -1)).split(' ')[0]}" y1="${p(at(i, -1)).split(' ')[1]}" x2="${p(at(i, 3)).split(' ')[0]}" y2="${p(at(i, 3)).split(' ')[1]}" stroke="#232b40" stroke-width="1"/>`);
  }
  for (let j = -1; j <= 3; j += 1) {
    grid.push(`<line x1="${p(at(-1, j)).split(' ')[0]}" y1="${p(at(-1, j)).split(' ')[1]}" x2="${p(at(4, j)).split(' ')[0]}" y2="${p(at(4, j)).split(' ')[1]}" stroke="#232b40" stroke-width="1"/>`);
  }
  return `<svg viewBox="0 0 420 300" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="ตารางที่สร้างจากแกนสองแกน มีการเดินตามแกนแรกสามก้าวแล้วเลี้ยวเดินตามแกนที่สองสองก้าว" style="font-family:'Sarabun',sans-serif">
    <defs>
      <marker id="s4a-4ade80" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#4ade80"/></marker>
      <marker id="s4a-e0b400" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#e0b400"/></marker>
    </defs>
    ${grid.join('')}
    ${arrow(at(0, 0), at(1, 0), '#4ade80')}
    ${arrow(at(0, 0), at(0, 1), '#e0b400')}
    <text x="${at(1.18, 0)[0].toFixed(1)}" y="${at(1.18, 0)[1].toFixed(1)}" font-size="12" fill="#4ade80" text-anchor="middle">แกนที่ 1</text>
    <text x="${at(0, 1.2)[0].toFixed(1)}" y="${at(0, 1.2)[1].toFixed(1)}" font-size="12" fill="#e0b400" text-anchor="middle">แกนที่ 2</text>
    ${legs.join('')}
    ${steps >= 2 ? `<circle cx="${dest[0].toFixed(1)}" cy="${dest[1].toFixed(1)}" r="5.5" fill="#f8f8f2"/>` : ''}
    <circle cx="${O[0]}" cy="${O[1]}" r="3.5" fill="#4d72a9"/>
  </svg>`;
};
