      <line x1="207.4" y1="63.4" x2="207.4" y2="120" stroke="#8a97ad" stroke-width="1" stroke-dasharray="4 3"/>
      <line x1="207.4" y1="63.4" x2="140" y2="63.4" stroke="#8a97ad" stroke-width="1" stroke-dasharray="4 3"/>

      <line x1="140" y1="120" x2="207.4" y2="120" stroke="#4ade80" stroke-width="3.4"/>
      <line x1="140" y1="120" x2="140" y2="63.4" stroke="#e0b400" stroke-width="3.4"/>
