      <text x="216" y="42" font-size="11" fill="#8a97ad">รัศมี 1</text>

      <circle cx="228" cy="120" r="3" fill="#8a97ad"/>
      <text x="236" y="138" font-size="10.5" fill="#8a97ad">0°</text>
      <circle cx="140" cy="32" r="3" fill="#8a97ad"/>
      <text x="140" y="22" font-size="10.5" fill="#8a97ad" text-anchor="middle">90°</text>
