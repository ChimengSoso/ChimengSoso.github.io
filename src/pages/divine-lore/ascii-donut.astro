  <h1>เข้าใจ donut.c ตั้งแต่ศูนย์</h1>
  <p class="subtitle">
    โค้ดก้อนนี้ถูกแชร์ต่อกันมาสิบกว่าปี ทุกคนบอกว่าสวย แต่คำอธิบายที่หาเจอทุกอันเริ่มต้นที่คำว่าเมทริกซ์หมุนสามชั้น บทนี้เริ่มจากศูนย์จริง ๆ ปูไซน์กับโคไซน์ด้วยสามเหลี่ยมมุมฉาก ปูเปอร์สเปกทีฟด้วยสามเหลี่ยมคล้าย แล้วต่อขึ้นไปทีละชั้นจนครบหกชั้น อ่านจบแล้วคุณจะเขียนมันออกมาเองได้ทุกบรรทัด
  </p>

  <script is:inline>
    /* ทำงานทันทีตอนแยกวิเคราะห์ ก่อนที่ส่วนล่างของหน้าจะถูกวาด
       เพื่อไม่ให้หน้าถูกวางเต็มความยาวแล้วค่อยยุบ ซึ่งทำให้แถบเลื่อนกระโดด
       ถ้าปิด JS สคริปต์นี้ไม่ทำงาน คลาสจึงไม่ถูกใส่ และบทความจะแสดงเต็มตามเดิม */
    (function () {
      const el = document.documentElement;
      if (!('onbeforematch' in document.documentElement)) return;
      el.classList.add('dn-folding');
      /* กันเหนียว ถ้าตัวจัดก้อนไม่ได้ทำงานใน 5 วินาที ให้คลี่ทิ้งไว้ทั้งหมด */
      setTimeout(function () { el.classList.remove('dn-folding'); }, 5000);
    })();
  </script>


