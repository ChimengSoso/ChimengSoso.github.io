---
import DivineLoreLayout from '../../layouts/DivineLoreLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import ExplainNumber from '../../components/ExplainNumber.astro';
import { texCode, texBlock, mc } from '../../lib/math';

/* ---------- ค่าคงที่ของโค้ดจริง (ตัวเลขทุกตัวในบทความดึงจากตรงนี้) ---------- */
const R1 = 1;
const R2 = 2;
const K2 = 5;
const THETA_SPACING = 0.07;
const PHI_SPACING = 0.02;
const MULT_X = 30;
const MULT_Y = 15;
const SCREEN_W = 80;
const SCREEN_H = 22;
const CHARS = '.,-~:;=!*#$@';
/* จุดกลางจอที่โค้ดจริงใช้ ไม่ใช่ 80/2 กับ 22/2 เป๊ะ ๆ ต้นฉบับเขียน 40 กับ 12 ไว้ตรง ๆ */
const CENTER_X = 40;
const CENTER_Y = 12;

/**
 * เดินมุมแบบเดียวกับโค้ด C เป๊ะ ๆ
 * โค้ดจริงประกาศ `float phi` ไม่ใช่ double การบวกสะสมจึงคลาดคนละแบบกับ JS
 * ต้องบีบทุกก้าวลงความละเอียดของ float ด้วย Math.fround ไม่งั้นจำนวนรอบต่างกันหนึ่งรอบ
 */
const floatAngles = (step: number): number[] => {
  const out: number[] = [];
  const s = Math.fround(step);
  for (let v = Math.fround(0); v < 6.28; v = Math.fround(v + s)) out.push(v);
  return out;
};
const loopCount = (step: number): number => floatAngles(step).length;
const thetaSteps = loopCount(THETA_SPACING);
const phiSteps = loopCount(PHI_SPACING);
const pointsPerFrame = thetaSteps * phiSteps;
const cells = SCREEN_W * SCREEN_H;
const wastedPercent = Math.round((1 - cells / pointsPerFrame) * 1000) / 10;
const aspectRatio = MULT_X / MULT_Y;

/* ---------- สูตรที่ย้อมสีแบบโค้ด ---------- */
const cos = mc.trig('\\cos');
const sin = mc.trig('\\sin');
const TEX = {
  circle: texCode(
    `(${mc.fn('x')}, ${mc.fn('y')}) ${mc.op('=')} (${cos}\\theta, ${sin}\\theta)`,
  ),
  circleR1: texCode(
    `(${mc.fn('x')}, ${mc.fn('y')}) ${mc.op('=')} (${mc.fn('R1')} ${mc.op('\\cdot')} ${cos}\\theta,\\; ${mc.fn('R1')} ${mc.op('\\cdot')} ${sin}\\theta)`,
  ),
  circleShift: texCode(
    `${mc.fn('circlex')} ${mc.op('=')} ${mc.fn('R2')} ${mc.op('+')} ${mc.fn('R1')} ${mc.op('\\cdot')} ${cos}\\theta \\qquad ${mc.fn('circley')} ${mc.op('=')} ${mc.fn('R1')} ${mc.op('\\cdot')} ${sin}\\theta`,
  ),
  sweep: texCode(
    `(${mc.fn('x')}, ${mc.fn('y')}, ${mc.fn('z')}) ${mc.op('=')} (${mc.fn('circlex')} ${mc.op('\\cdot')} ${cos}\\varphi,\\; ${mc.fn('circley')},\\; ${mc.fn('circlex')} ${mc.op('\\cdot')} ${sin}\\varphi)`,
  ),
  rotFull: texCode(
    `\\begin{aligned}
      ${mc.fn('x')} &${mc.op('=')} ${mc.fn('circlex')}\\,(${cos}B\\,${cos}\\varphi ${mc.op('+')} ${sin}A\\,${sin}B\\,${sin}\\varphi) ${mc.op('-')} ${mc.fn('circley')}\\,${cos}A\\,${sin}B \\\\
      ${mc.fn('y')} &${mc.op('=')} ${mc.fn('circlex')}\\,(${sin}B\\,${cos}\\varphi ${mc.op('-')} ${sin}A\\,${cos}B\\,${sin}\\varphi) ${mc.op('+')} ${mc.fn('circley')}\\,${cos}A\\,${cos}B \\\\
      ${mc.fn('z')} &${mc.op('=')} ${mc.fn('K2')} ${mc.op('+')} ${cos}A\\,${mc.fn('circlex')}\\,${sin}\\varphi ${mc.op('+')} ${mc.fn('circley')}\\,${sin}A
    \\end{aligned}`,
  ),
  project: texCode(
    `${mc.fn('xp')} ${mc.op('=')} ${mc.num('40')} ${mc.op('+')} ${mc.num('30')} ${mc.op('\\cdot')} \\dfrac{${mc.fn('x')}}{${mc.fn('z')}} \\qquad ${mc.fn('yp')} ${mc.op('=')} ${mc.num('12')} ${mc.op('-')} ${mc.num('15')} ${mc.op('\\cdot')} \\dfrac{${mc.fn('y')}}{${mc.fn('z')}}`,
  ),
  ooz: texCode(
    `${mc.fn('ooz')} ${mc.op('=')} \\dfrac{${mc.num('1')}}{${mc.fn('z')}} \\qquad ${mc.fn('xp')} ${mc.op('=')} ${mc.num('40')} ${mc.op('+')} ${mc.num('30')} ${mc.op('\\cdot')} ${mc.fn('ooz')} ${mc.op('\\cdot')} ${mc.fn('x')}`,
  ),
  normal: texCode(
    `${mc.fn('N')} ${mc.op('=')} (${cos}\\theta\\,${cos}\\varphi,\\; ${sin}\\theta,\\; ${cos}\\theta\\,${sin}\\varphi)`,
  ),
  dot: texCode(
    `${mc.fn('L')} ${mc.op('=')} ${mc.fn('N')} ${mc.op('\\cdot')} (${mc.num('0')}, ${mc.num('1')}, ${mc.op('-')}${mc.num('1')}) ${mc.op('=')} ${mc.fn('Ny')} ${mc.op('-')} ${mc.fn('Nz')}`,
  ),
  charIndex: texCode(
    `${mc.fn('index')} ${mc.op('=')} ${mc.num('8')} ${mc.op('\\cdot')} ${mc.fn('L')}`,
  ),
  sqrt2: texCode(
    `|(${mc.num('0')}, ${mc.num('1')}, ${mc.op('-')}${mc.num('1')})| ${mc.op('=')} \\sqrt{${mc.num('0')}^{${mc.num('2')}} ${mc.op('+')} ${mc.num('1')}^{${mc.num('2')}} ${mc.op('+')} (${mc.op('-')}${mc.num('1')})^{${mc.num('2')}}} ${mc.op('=')} \\sqrt{${mc.num('2')}} \\approx ${mc.num('1.414')}`,
  ),
};

/* สูตรในกล่องบทพิสูจน์
   เส้นแบ่งคือ ถ้าสมการเอ่ยชื่อของที่มีอยู่จริงในโปรแกรม (K1, K2, z, circlex, ทิศแสง) ให้ย้อมสีเป็นหน้าต่างโค้ด
   ถ้าเป็นเอกลักษณ์ทางคณิตศาสตร์ที่จริงอยู่แล้วโดยไม่ต้องมีโปรแกรมนี้ ให้ปล่อยขาวดำ */
const PRF = {
  pythagoras: texBlock(String.raw`\cos^2\theta + \sin^2\theta = 1^2 = 1`),
  tangent: texBlock(String.raw`\frac{d}{d\theta}(\cos\theta,\; \sin\theta) = (-\sin\theta,\; \cos\theta)`),
  sumAngle: texBlock(String.raw`\begin{aligned} \cos(\alpha + \beta) &= \cos\alpha\cos\beta - \sin\alpha\sin\beta \\ \sin(\alpha + \beta) &= \sin\alpha\cos\beta + \cos\alpha\sin\beta \end{aligned}`),
  rotKeepsLength: texBlock(String.raw`\begin{aligned} x'^2 + y'^2 &= (x\cos\theta - y\sin\theta)^2 + (x\sin\theta + y\cos\theta)^2 \\ &= x^2(\cos^2\theta + \sin^2\theta) + y^2(\sin^2\theta + \cos^2\theta) \\ &= x^2 + y^2 \end{aligned}`),
  similar: texCode(
    `\\dfrac{y_{\\text{จอ}}}{${mc.fn('K1')}} ${mc.op('=')} \\dfrac{y}{${mc.fn('z')}} \\quad\\Longrightarrow\\quad y_{\\text{จอ}} ${mc.op('=')} ${mc.fn('K1')} ${mc.op('\\cdot')} \\dfrac{y}{${mc.fn('z')}}`,
  ),
  k1: texCode(
    `${mc.fn('K1')} ${mc.op('=')} \\dfrac{${mc.fn('\\text{screen width}')} ${mc.op('\\times')} ${mc.fn('K2')} ${mc.op('\\times')} ${mc.num('3')}}{${mc.num('8')}\\,(${mc.fn('R1')} ${mc.op('+')} ${mc.fn('R2')})}`,
  ),
  oozOrder: texCode(
    `${mc.num('0')} ${mc.op('<')} ${mc.fn('z')}_a ${mc.op('<')} ${mc.fn('z')}_b \\quad\\Longleftrightarrow\\quad \\dfrac{${mc.num('1')}}{${mc.fn('z')}_a} ${mc.op('>')} \\dfrac{${mc.num('1')}}{${mc.fn('z')}_b}`,
  ),
  dotCos: texBlock(String.raw`\vec{a}\cdot\vec{b} = |\vec{a}|\,|\vec{b}|\cos\gamma`),
  lawOfCos: texBlock(String.raw`|\vec{a} - \vec{b}|^2 = |\vec{a}|^2 + |\vec{b}|^2 - 2|\vec{a}||\vec{b}|\cos\gamma`),
  incremental: texCode(
    `\\begin{aligned}
      ${cos}(A ${mc.op('+')} \\delta) &${mc.op('=')} ${cos}A\\,${cos}\\delta ${mc.op('-')} ${sin}A\\,${sin}\\delta \\\\
      ${sin}(A ${mc.op('+')} \\delta) &${mc.op('=')} ${sin}A\\,${cos}\\delta ${mc.op('+')} ${cos}A\\,${sin}\\delta
    \\end{aligned}`,
  ),
  newton: texCode(
    `m ${mc.op('=')} c^{${mc.num('2')}} ${mc.op('+')} s^{${mc.num('2')}} \\approx ${mc.num('1')} \\quad\\Longrightarrow\\quad \\dfrac{${mc.num('1')}}{\\sqrt{m}} \\approx \\dfrac{${mc.num('3')} ${mc.op('-')} m}{${mc.num('2')}}`,
  ),
};

/* ================================================================
   แบบจำลองของตัวเดินทีละขั้น ทุกตัวเลขที่โผล่บนหน้าเว็บคำนวณจากตรงนี้
   ไม่มีเลขตัวไหนพิมพ์ด้วยมือ ตารางกับคำอธิบายจึงขัดกันเองไม่ได้
   ================================================================ */
interface V3 {
  x: number;
  y: number;
  z: number;
}
const surf = (theta: number, phi: number, r1: number, r2: number): V3 => {
  const cx = r2 + r1 * Math.cos(theta);
  return { x: cx * Math.cos(phi), y: r1 * Math.sin(theta), z: cx * Math.sin(phi) };
};
const rot = (p: V3, A: number, B: number): V3 => {
  const y1 = p.y * Math.cos(A) - p.z * Math.sin(A);
  const z1 = p.y * Math.sin(A) + p.z * Math.cos(A);
  return { x: p.x * Math.cos(B) - y1 * Math.sin(B), y: p.x * Math.sin(B) + y1 * Math.cos(B), z: z1 };
};
const f3 = (v: number): string => v.toFixed(3);
const f5 = (v: number): string => v.toFixed(5);

/* ---------- S1 จุดหนึ่งจุดเดินทะลุท่อทั้งหกชั้น ---------- */
const S1 = { theta: 2.6, phi: 1.4, A: 1.0, B: 0.6 };
const s1CircleX = R2 + R1 * Math.cos(S1.theta);
const s1CircleY = R1 * Math.sin(S1.theta);
const s1Swept = surf(S1.theta, S1.phi, R1, R2);
const s1Rot = rot(s1Swept, S1.A, S1.B);
const s1Z = K2 + s1Rot.z;
const s1Ooz = 1 / s1Z;
const s1Xp = Math.floor(CENTER_X + MULT_X * s1Ooz * s1Rot.x);
const s1Yp = Math.floor(CENTER_Y - MULT_Y * s1Ooz * s1Rot.y);
const s1N = rot(surf(S1.theta, S1.phi, 1, 0), S1.A, S1.B);
const s1L = s1N.y - s1N.z;
const s1Index = Math.floor(8 * s1L);
const s1Char = CHARS[Math.max(0, Math.min(CHARS.length - 1, s1Index))];

interface SimRow {
  layer: string;
  what: string;
  value: string;
}
const s1Rows: SimRow[] = [
  { layer: 'ตั้งต้น', what: 'มุมสองตัวที่หยิบมาหนึ่งจุด', value: `θ = ${f3(S1.theta)} · φ = ${f3(S1.phi)}` },
  { layer: 'ชั้นที่ 1', what: 'จุดบนวงกลมหน้าตัด', value: `circlex = ${f3(s1CircleX)} · circley = ${f3(s1CircleY)}` },
  { layer: 'ชั้นที่ 2', what: 'กวาดรอบแกนแล้วได้แกนที่สาม', value: `(${f3(s1Swept.x)}, ${f3(s1Swept.y)}, ${f3(s1Swept.z)})` },
  { layer: 'ชั้นที่ 3', what: 'หมุนด้วย A แล้ว B แล้วถอยออกไป K2', value: `(${f3(s1Rot.x)}, ${f3(s1Rot.y)}, ${f3(s1Z)})` },
  { layer: 'ชั้นที่ 4', what: 'หารด้วยระยะ แล้วปัดลงช่องบนจอ', value: `1/z = ${f3(s1Ooz)} · ช่อง (${s1Xp}, ${s1Yp})` },
  { layer: 'ชั้นที่ 5', what: 'เทียบความลึกกับของเดิมในช่องนั้น', value: `ช่องยังว่าง จึงได้ที่ไป` },
  { layer: 'ชั้นที่ 6', what: 'ความสว่าง แล้วแปลงเป็นตัวอักษร', value: `L = ${f3(s1L)} · ลำดับที่ ${s1Index} · "${s1Char}"` },
];
const s1Says: string[] = [
  `เลือกมุมมาสองตัว θ = ${f3(S1.theta)} กับ φ = ${f3(S1.phi)} ตอนนี้ยังไม่มีพิกัดอะไรทั้งนั้น มีแค่มุมสองตัวกับค่าคงที่ในโค้ด`,
  `มุม θ ชี้ไปที่จุดหนึ่งบนวงกลมหน้าตัด ระยะจากแกนกลางคือ ${f3(s1CircleX)} ซึ่งมาจาก R2 = ${R2} บวก R1 คูณโคไซน์ของ θ ส่วนความสูงคือ ${f3(s1CircleY)}`,
  `กวาดจุดนั้นไปรอบแกนเป็นมุม φ ระยะ ${f3(s1CircleX)} จึงถูกแบ่งไปเป็นแกนหน้าหลังกับแกนซ้ายขวา ส่วนความสูงไม่เปลี่ยน เพราะการกวาดไม่ยกจุดขึ้นลง`,
  `หมุนทั้งก้อนด้วย A = ${f3(S1.A)} แล้ว B = ${f3(S1.B)} จากนั้นบวก K2 = ${K2} เข้าที่แกนความลึก จุดนี้จึงอยู่ห่างตา ${f3(s1Z)} หน่วย ซึ่งเป็นบวก คือยังอยู่หน้ากล้อง`,
  `หารด้วยระยะได้ 1/z = ${f3(s1Ooz)} คูณกับตัวคูณสองแกนแล้วบวกจุดกลางจอ ได้ช่องที่ ${s1Xp} จากซ้าย และแถวที่ ${s1Yp} จากบน`,
  `ก่อนเขียนลงไป ต้องถามช่องนั้นก่อนว่ามีใครจองไว้หรือยัง รอบนี้ยังว่าง จุดนี้จึงได้ที่ ถ้ามีของที่ใกล้กว่าจองไว้แล้ว จุดนี้จะถูกปฏิเสธทันที`,
  `สุดท้ายคือความสว่าง ทิศตั้งฉากของผิวจุดนี้เทียบกับทิศแสงได้ L = ${f3(s1L)} คูณ 8 แล้วปัดลงได้ลำดับที่ ${s1Index} ในแถบอักขระ ซึ่งคือตัว "${s1Char}"`,
];
const s1Steps = s1Says.map((say, i) => ({ say, upto: i }));

/* ---------- S2 z-buffer เติมทีละจุด ---------- */
const WIN_X0 = 38;
const WIN_Y0 = 6;
const WIN_W = 4;
const WIN_H = 3;
interface Arrival {
  xp: number;
  yp: number;
  ooz: number;
  ch: string;
}
const collectArrivals = (): Arrival[] => {
  const A = 1.0;
  const B = 0.6;
  const found: Arrival[] = [];
  // เดินมุมด้วยลำดับเดียวกับโค้ด C จุดที่ได้จึงเป็นจุดจริงในลำดับจริง
  for (const theta of floatAngles(THETA_SPACING)) {
    if (found.length >= 12) break;
    for (const phi of floatAngles(PHI_SPACING)) {
      if (found.length >= 12) break;
      const p = rot(surf(theta, phi, R1, R2), A, B);
      const z = K2 + p.z;
      if (z <= 0.1) continue;
      const ooz = 1 / z;
      const xp = Math.floor(CENTER_X + MULT_X * ooz * p.x);
      const yp = Math.floor(CENTER_Y - MULT_Y * ooz * p.y);
      if (xp < WIN_X0 || xp >= WIN_X0 + WIN_W || yp < WIN_Y0 || yp >= WIN_Y0 + WIN_H) continue;
      const n = rot(surf(theta, phi, 1, 0), A, B);
      const L = n.y - n.z;
      if (L <= 0) continue;
      const li = Math.floor(8 * L);
      found.push({ xp, yp, ooz, ch: CHARS[Math.max(0, Math.min(CHARS.length - 1, li))] });
    }
  }
  return found;
};
const arrivals = collectArrivals();

interface S2Cell {
  ooz: number | null;
  ch: string | null;
}
interface S2Step {
  say: string;
  cells: S2Cell[];
  active: number;
  ok: boolean;
}
const buildS2 = (): S2Step[] => {
  const cells: S2Cell[] = new Array(WIN_W * WIN_H).fill(null).map(() => ({ ooz: null, ch: null }));
  const steps: S2Step[] = [
    {
      say: `นี่คือมุมเล็ก ๆ ของจอ กว้าง ${WIN_W} ช่อง สูง ${WIN_H} แถว ทุกช่องยังว่าง จุดที่คำนวณเสร็จจะทยอยวิ่งเข้ามาขอที่ทีละจุด`,
      cells: cells.map((c) => ({ ...c })),
      active: -1,
      ok: true,
    },
  ];
  for (const a of arrivals) {
    const idx = (a.yp - WIN_Y0) * WIN_W + (a.xp - WIN_X0);
    const prev = cells[idx].ooz;
    const ok = prev === null || a.ooz > prev;
    const say = prev === null
      ? `จุดใหม่ขอลงช่อง (${a.xp}, ${a.yp}) ช่องนี้ยังว่าง เขียนค่าความลึก ${f5(a.ooz)} กับตัวอักษร "${a.ch}" ลงไปได้เลย`
      : ok
        ? `จุดใหม่ขอลงช่อง (${a.xp}, ${a.yp}) ค่าใหม่ ${f5(a.ooz)} มากกว่าของเดิม ${f5(prev)} แปลว่าอยู่ใกล้ตากว่า จึงเขียนทับได้`
        : `จุดใหม่ขอลงช่อง (${a.xp}, ${a.yp}) ค่าใหม่ ${f5(a.ooz)} น้อยกว่าของเดิม ${f5(prev)} แปลว่าอยู่ไกลกว่า ของเดิมบังอยู่ จุดนี้ถูกปฏิเสธ`;
    if (ok) {
      cells[idx] = { ooz: a.ooz, ch: a.ch };
    }
    steps.push({ say, cells: cells.map((c) => ({ ...c })), active: idx, ok });
  }
  return steps;
};
const s2Steps = buildS2();
const s2Rejected = s2Steps.filter((s) => !s.ok).length;
/** คู่ตัวเลขจากขั้นที่ถูกปฏิเสธจริงใน S2 เอาไว้อ้างในบทพิสูจน์ ห้ามพิมพ์มือซ้ำ */
const s2Clash = ((): { winner: number; loser: number } => {
  for (let i = s2Steps.length - 1; i >= 1; i -= 1) {
    const st = s2Steps[i];
    if (st.ok) continue;
    return { winner: s2Steps[i - 1].cells[st.active].ooz ?? 0, loser: arrivals[i - 1].ooz };
  }
  return { winner: 0, loser: 0 };
})();

/* ---------- ตัวเลขที่กล่องบทพิสูจน์ใช้ ทุกตัวคำนวณจากแบบจำลองเดียวกัน ---------- */
/** โดนัทกินพื้นที่จอกี่ช่อง เมื่อไล่หมุนดูทุกมุม (สแกนจริง ไม่ใช่ประมาณ) */
const measureSpan = (): { cols: number; rows: number } => {
  let maxDx = 0;
  let maxDy = 0;
  for (let A = 0; A < 6.28; A += 0.25) {
    for (let B = 0; B < 6.28; B += 0.25) {
      for (let theta = 0; theta < 6.28; theta += 0.2) {
        for (let phi = 0; phi < 6.28; phi += 0.2) {
          const p = rot(surf(theta, phi, R1, R2), A, B);
          const z = K2 + p.z;
          if (z <= 0.1) continue;
          maxDx = Math.max(maxDx, Math.abs((MULT_X * p.x) / z));
          maxDy = Math.max(maxDy, Math.abs((MULT_Y * p.y) / z));
        }
      }
    }
  }
  return { cols: maxDx * 2, rows: maxDy * 2 };
};
const span = measureSpan();
/** ค่า K1 ตามกฎที่ Andy เขียนไว้ในหน้าอธิบายของเขาเอง */
const k1Rule = (SCREEN_W * K2 * 3) / (8 * (R1 + R2));
