      <text x="300" y="56" font-size="11" fill="#4ade80" text-anchor="middle">1/z มากกว่า จึงได้ช่องไป</text>

      <circle cx="470" cy="87.8" r="6" fill="#f08b8b"/>
      <text x="470" y="152" font-size="11.5" font-weight="700" fill="#f08b8b" text-anchor="middle">ผิวด้านหลัง</text>
      <text x="470" y="168" font-size="11" fill="#f08b8b" text-anchor="middle">1/z น้อยกว่า จึงถูกปฏิเสธ</text>

      <line x1="300" y1="118" x2="300" y2="134" stroke="#4ade80" stroke-width="1" stroke-dasharray="3 3"/>
      <line x1="470" y1="102" x2="470" y2="134" stroke="#f08b8b" stroke-width="1" stroke-dasharray="3 3"/>
      <line x1="470" y1="134" x2="186" y2="134" stroke="#f08b8b" stroke-width="1" stroke-dasharray="3 3"/>
