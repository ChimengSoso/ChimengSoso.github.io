      <rect x="120" y="120" width="52" height="34" fill="#1f3324" stroke="#2f9e5c" stroke-width="1.6"/>
      <rect x="120" y="154" width="52" height="34" fill="#101725" stroke="#39435c"/>
      <text x="146" y="145" font-size="17" font-weight="700" fill="#4ade80" text-anchor="middle" style="font-family:'JetBrains Mono',monospace">@</text>
      <text x="146" y="208" font-size="11" fill="#8a97ad" text-anchor="middle">ช่องบนจอ</text>

      <circle cx="300" cy="104.1" r="6" fill="#4ade80"/>
