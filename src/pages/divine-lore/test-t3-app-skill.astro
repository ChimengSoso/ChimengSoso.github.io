---
import DivineLoreLayout from '../../layouts/DivineLoreLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { divineLoreEntries } from '../../data/divineLore';

const entry = divineLoreEntries.find((e) => e.href === 'test-t3-app-skill/');
if (!entry) throw new Error('test-t3-app-skill/ ไม่มีใน divineLore.ts');

const installT3 = `# macOS / Linux
curl -fsSL https://t3.codes/install.sh | sh

# Windows (PowerShell)
irm https://t3.codes/install.ps1 | iex

# หรือลองครั้งเดียวโดยไม่ติดตั้ง
npx t3@latest`;

const installDesktop = `winget install T3Tools.T3Code        # Windows
brew install --cask t3-code          # macOS`;

const mcpCode = `claude mcp add --transport http t3 https://<ที่อยู่-environment>/mcp
claude mcp login t3
claude mcp list`;

const promptT3Repo = `/pstack:poteto-mode ปุ่มปิด thread ในแถบด้านข้างกดแล้วไม่หาย
ช่วยหาสาเหตุแล้วแก้ ใช้ /test-t3-app ยืนยันบน Browser panel
แนบภาพก่อนและหลังแก้ แล้วเปิด server ทิ้งไว้ให้ผมลองเอง`;

const promptOwnRepo = `/pstack:create-verification-skill
ใช้โครงเดียวกับ test-t3-app ของ T3 Code: แยก state ไว้ในโฟลเดอร์ของ worktree,
อ่านพอร์ตจริงจาก output, ถ้าไม่มีเครื่องมือขับ browser ให้หยุดแล้วบอก,
ปิดเฉพาะ process ที่ตัวเองเปิด, เปิด server ทิ้งไว้หลังตรวจเสร็จ`;

const templateSkill = `---
name: test-<app>
description: Verify <app>'s web UI in a real browser against isolated dev
  state. Use after any user-visible change. Not for unit tests.
---

# Test <app>

Use <browser tools available in this harness>. If they are missing, say what
is blocked and stop. Do not install another automation tool to get around it.

## Start
Reuse a healthy dev server from this task. Otherwise run \`<dev command>\`
and keep its terminal. Read the real port from its output; never guess it.
State lives in <worktree-local data dir>. Never point the app at <real data>.

## Data
Test with realistic data. Read references/fixtures.md only when seeding.
Stop the server before writing fixtures directly.

## Drive
Open <url>, take a snapshot, then walk the exact flow the change touched.

## Prove and keep
Capture what proves the flow works (screenshot, recording, DB row).
Leave the server running for the user. Ending a turn is not teardown.
Stop only processes you started, by the PID you recorded.
Keep tokens and secrets out of screenshots, commits and replies.`;

const launchJson = `{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astro-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 4321,
      "autoPort": true
    }
  ]
}`;

const desktopSkill = `---
name: test-<app>
description: Verify <app>'s web UI in Claude's built-in browser against
  isolated dev state. Use after any user-visible change.
---

# Test <app> in Claude Desktop

Use the built-in browser tools (preview_start, navigate, read_page, find,
computer, javascript_tool). If they are missing, say what is blocked and
stop. Do not install Playwright or drive another browser instead.

## Start
Start the dev server with preview_start {name: "<name in launch.json>"}.
Never start it from a shell; preview_start reuses a running server.
Data lives in <isolated dev data>. Never point the app at <real data>.

## Check the pane before measuring
Read window.innerWidth first. If it is 0 the pane is hidden: call
resize_window with the desktop preset, then the size you need, and re-read.

## Drive
navigate to the page. Read it with read_page or get_page_text.
Act with find, then computer left_click or type.
Prefer reading the page over screenshots; screenshots can time out.

## Prove and keep
Capture what proves the flow: read_page output, values read with
javascript_tool, one screenshot if it works. Check read_console_messages.
Leave the server running while the user looks. Stop it later with
preview_stop, never by killing node by name.`;

const desktopPrompt = `/pstack:poteto-mode ปุ่ม export CSV ในหน้ารายงานกดแล้วไม่มีไฟล์
ช่วยหาสาเหตุแล้วแก้ ใช้ /test-<app> ยืนยันในเบราว์เซอร์ของ Claude
บอกค่าที่อ่านได้จากหน้าจอก่อนและหลังแก้ แล้วเปิด server ทิ้งไว้`;
