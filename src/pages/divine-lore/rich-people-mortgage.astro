---
import DivineLoreLayout from '../../layouts/DivineLoreLayout.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

/**
 * ตัวเลขทุกตัวในบทความนี้คำนวณตอน build ไม่ได้พิมพ์มือ
 * โมเดล: ลดต้นลดดอกแบบคิดดอกเบี้ยรายเดือน (r = อัตราต่อปี / 12) ค่างวดคงที่
 */
const LOAN = 3_000_000;
const ANNUAL = 0.06;
const YEARS = 30;
const N = YEARS * 12;
const R = ANNUAL / 12;

function payment(principal: number, monthlyRate: number, months: number): number {
  if (monthlyRate === 0) return principal / months;
  return (principal * monthlyRate) / (1 - Math.pow(1 + monthlyRate, -months));
}

interface Row {
  month: number;
  interest: number;
  principal: number;
  balance: number;
}

function schedule(principal: number, monthlyRate: number, months: number, extra = 0): Row[] {
  const base = payment(principal, monthlyRate, months);
  const rows: Row[] = [];
  let balance = principal;
  for (let m = 1; m <= months && balance > 0.005; m++) {
    const interest = balance * monthlyRate;
    let paid = base + extra - interest;
    if (paid > balance) paid = balance;
    balance -= paid;
    rows.push({ month: m, interest, principal: paid, balance });
  }
  return rows;
}

const PMT = payment(LOAN, R, N);
const plan = schedule(LOAN, R, N);
const totalInterest = plan.reduce((s, x) => s + x.interest, 0);

/** รวมดอกเบี้ย/เงินต้นเป็นรายปี เอาไปวาดกราฟแท่งซ้อน */
const byYear = Array.from({ length: YEARS }, (_, y) => {
  const slice = plan.slice(y * 12, y * 12 + 12);
  return {
    year: y + 1,
    interest: slice.reduce((s, x) => s + x.interest, 0),
    principal: slice.reduce((s, x) => s + x.principal, 0),
  };
});

const crossover = plan.find((x) => x.principal > x.interest)!;
const halfway = plan.find((x) => x.balance <= LOAN / 2)!;

/** โปะเพิ่มเดือนละ 5,000 */
const EXTRA = 5_000;
const planExtra = schedule(LOAN, R, N, EXTRA);
const extraInterest = planExtra.reduce((s, x) => s + x.interest, 0);

/** โปะก้อน 300,000 ตั้งแต่งวดแรก (ค่างวดเดิม) */
const LUMP = 300_000;
const planLump = schedule(LOAN - LUMP, R, N);
const lumpRows: Row[] = [];
{
  let balance = LOAN - LUMP;
  for (let m = 1; m <= N && balance > 0.005; m++) {
    const interest = balance * R;
    let paid = PMT - interest;
    if (paid > balance) paid = balance;
    balance -= paid;
    lumpRows.push({ month: m, interest, principal: paid, balance });
  }
}
const lumpInterest = lumpRows.reduce((s, x) => s + x.interest, 0);
void planLump;

/** สองทางเลือก: จ่ายสดแล้วลงทุนค่างวด vs กู้แล้วปล่อยเงินก้อนลงทุน */
function twoPaths(growth: number): { cash: number; loan: number } {
  const g = growth / 12;
  return {
    cash: PMT * ((Math.pow(1 + g, N) - 1) / g),
    loan: LOAN * Math.pow(1 + g, N),
  };
}
const paths = [0.04, 0.05, 0.06, 0.07, 0.08, 0.1].map((g) => ({ g, ...twoPaths(g) }));

const baht = (n: number) => Math.round(n).toLocaleString('en-US');
const mB = (n: number) => (n / 1_000_000).toFixed(2);

/** พิกัดกราฟแท่งซ้อนรายปี */
const CH = { x0: 56, y0: 30, w: 620, h: 176 };
const yearTotal = byYear[0].interest + byYear[0].principal;
const slot = CH.w / YEARS;
const barW = slot * 0.66;
---
<DivineLoreLayout
  title="คนรวยก็กู้ซื้อบ้าน: แกะดอกเบี้ยทีละบาท | บันทึกศาสตร์แห่งเทพ"
  description="เกร็ดการเงินชิ้นแรก แกะโพสต์ยอดนิยมเรื่องคนรวยที่ยังกู้แบงก์ซื้อบ้าน ว่า amortizing loan ทำงานยังไง ประวัติของ Buffett, Zuckerberg, Musk, Griffin, Jay-Z จริงแค่ไหน พร้อมเครื่องคิดเลขเทียบทางจ่ายสดกับทางกู้"
>
  <nav class="dl-nav">
    <a href="../">
      <svg class="dl-nav-arrow" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
      กลับไปที่บันทึกลับ
    </a>
  </nav>
  <p class="tag">บันทึกการเงิน</p>
  <h1>คนรวยก็กู้ซื้อบ้าน: แกะดอกเบี้ยทีละบาท</h1>
  <p class="subtitle">
    มีโพสต์แนวนี้วนกลับมาทุกปี "Buffett ก็กู้ 30 ปี, Zuckerberg ก็รีไฟแนนซ์, Musk ก็กู้ Morgan Stanley เพราะฉะนั้นอย่ากลัวดอกเบี้ยบ้าน" อ่านแล้วรู้สึกดี แต่ยังไม่รู้อะไรเพิ่ม บันทึกนี้เลยไปขุดว่าแต่ละเคสจริงแค่ไหน ตัวเลขดอกเบี้ยข้างในทำงานยังไง และส่วนไหนของวิธีคิดนั้นที่ใช้ในไทยไม่ได้เลย
  </p>

  <hr class="divider" />

  <div class="callout callout-warn">
    <p class="callout-label">อ่านก่อน</p>
    <p>
      บันทึกนี้ทำเพื่อการศึกษาเท่านั้น ไม่ใช่คำแนะนำการลงทุนหรือคำแนะนำเรื่องสินเชื่อ ตัวเลขอัตราดอกเบี้ยและกฎภาษีที่อ้างถึงเป็นข้อมูลช่วงกลางปี 2026 ซึ่งเปลี่ยนได้ ก่อนตัดสินใจจริงกรุณาไปคุยกับธนาคารและตรวจกฎล่าสุดด้วยตัวเองอีกรอบครับ
    </p>
  </div>

  <p>
    นี่เป็นชิ้นแรกของหมวดเกร็ดการเงิน วัตถุดิบมาสองทาง ทางแรกเป็นทวีตที่เล่าถึงอินฟลูฯ คนหนึ่งที่ถูกตั้งคำถามว่ารวยแล้วยังกู้แบงก์ซื้อคอนโดทำไม เจ้าตัวตอบว่าเอาเงินก้อนไปลงกับอย่างอื่นดีกว่าเพราะหักกลบกับเบี้ยธนาคารแล้วยังคุ้ม ทางที่สองเป็นโพสต์เฟซบุ๊กที่ไล่รายชื่อมหาเศรษฐีที่กู้ซื้อบ้าน แล้วปิดท้ายว่าเหตุผลคือ Opportunity Cost บวก Leverage
  </p>
  <p>
    สองชิ้นนี้พูดถูกในภาพใหญ่ ปัญหาคือมันหยุดตรงจุดที่น่าสนใจที่สุดพอดี คำว่า "หักกลบกับเบี้ยธนาคาร" ต้องหักกลบที่เท่าไหร่ถึงคุ้ม โพสต์ไม่ได้บอก และคำว่า amortizing loan interest ที่ต้นทางบอกให้ไปเสิร์ชเอง ก็คือหัวใจทั้งหมดที่ควรเล่าให้จบในโพสต์นั้นเลย
  </p>
  <p>
    ผมจะเริ่มจากตัวเลขก่อน แล้วค่อยไปดูประวัติของแต่ละคน เพราะถ้ายังไม่เห็นว่าดอกเบี้ยเดินยังไง อ่านประวัติเขาไปก็ได้แค่ความรู้สึก
  </p>

  <hr class="divider-solid" />

  <h2>ดอกเบี้ยบ้านคิดจากยอดที่ยังค้าง ไม่ใช่จากยอดที่กู้</h2>
  <p>
    เรื่องที่คนเข้าใจผิดกันมากที่สุดคือคิดว่ากู้ 3 ล้าน ดอกเบี้ย 6% ต่อปี แปลว่าเสียดอกปีละ 180,000 บาทเท่ากันทุกปีไปสามสิบปี รวมเป็นดอกเบี้ย 5.4 ล้าน ถ้าเป็นแบบนั้นจริงคือน่ากลัวมาก แต่มันไม่ใช่แบบนั้น
  </p>
  <div class="callout callout-note">
    <p class="callout-label">แกะคำศัพท์</p>
    <p>
      <strong>Amortizing loan</strong> อ่านว่า <strong>"อะมอร์ไทซิง โลน"</strong> แปลว่า <strong>"เงินกู้แบบทยอยตัดต้น"</strong> ที่บ้านเราเรียกว่า <strong>ลดต้นลดดอก</strong> รากศัพท์สนุกมาก <i>amortize</i> มาจากภาษาละติน <i>ad mortem</i> ที่แปลตรงตัวว่า "ไปสู่ความตาย" เพราะเราค่อย ๆ ฆ่าหนี้ให้ตายไปทีละงวด คำว่า <i>mortgage</i> ก็ญาติกัน คือ <i>mort</i> (ตาย) บวก <i>gage</i> (คำมั่น) แปลว่าคำมั่นที่จะตายไปเอง คือตายเพราะผ่อนหมด หรือตายเพราะบ้านถูกยึด อย่างใดอย่างหนึ่ง
    </p>
  </div>
  <p>
    กฎมีข้อเดียว ดอกเบี้ยงวดนี้คิดจาก <strong>เงินต้นที่ยังค้างอยู่ตอนนั้น</strong> เท่านั้น ยอดที่เคยกู้มาไม่เกี่ยวอีกแล้ว
  </p>
  <div class="card">
    <p>ดอกเบี้ยงวดนี้ = เงินต้นคงเหลือ × อัตราต่อปี × จำนวนวันในงวด ÷ 365</p>
    <p>เงินต้นที่ตัดได้งวดนี้ = ค่างวดที่จ่าย − ดอกเบี้ยงวดนี้</p>
  </div>
  <p>
    ธนาคารไทยส่วนใหญ่คิดแบบรายวันจริง ๆ ตามสูตรบรรทัดแรก บทความนี้จะใช้เวอร์ชันย่อคือคิดเป็นรายเดือน (อัตราต่อปีหารสิบสอง) เพื่อให้ตารางอ่านง่าย ตัวเลขจะเพี้ยนจากใบเสร็จจริงเล็กน้อย แต่รูปทรงเหมือนกันหมด
  </p>
  <details class="expander">
    <summary>ทำไมจ่ายวันที่ 5 กับวันที่ 25 ของเดือนแล้วดอกเบี้ยไม่เท่ากัน</summary>
    <div class="expander-body">
      <p>
        เพราะการคิดแบบรายวัน (ศัพท์ธนาคารเรียก <i>daily rest</i>) นับดอกเบี้ยทุกวันที่เงินต้นก้อนนั้นยังค้างอยู่ ถ้างวดนี้เราจ่ายเร็วขึ้น 20 วัน เงินต้นก็ถูกตัดลงเร็วขึ้น 20 วัน ดอกเบี้ยของ 20 วันนั้นบนยอดส่วนที่ตัดไปเลยหายไปด้วย
      </p>
      <p>
        ผลอีกอย่างของ actual/365 คือเดือนกุมภาพันธ์เสียดอกเบี้ยน้อยกว่าเดือนมีนาคมโดยธรรมชาติ เพราะมันสั้นกว่าสามวัน ไม่ใช่ธนาคารใจดี
      </p>
      <p>
        และเพราะดอกเบี้ยเดินทุกวันแต่ค่างวดมาเดือนละครั้ง ถ้าเดือนไหนดอกเบี้ยที่เดินสะสมมากกว่าค่างวด เงินต้นจะไม่ลดเลยแม้จ่ายครบ กรณีนี้เกิดจริงตอนดอกเบี้ยลอยตัวขึ้นแรงแต่ค่างวดยังตรึงเท่าเดิม
      </p>
    </div>
  </details>

  <hr class="divider-solid" />

  <h2>ตารางจริง กู้ 3 ล้าน 30 ปี ดอกเบี้ย 6%</h2>
  <p>
    ใส่เลขเข้าสูตรค่างวดจะได้ผ่อนเดือนละ <strong>{baht(PMT)} บาท</strong> เท่ากันทุกงวดจนจบ ทีนี้มาดูว่าข้างในค่างวดก้อนนี้มีอะไร
  </p>

  <figure class="tbl">
    <table class="amo">
      <caption>เงินก้อนเดิม {baht(PMT)} บาท แต่ข้างในเปลี่ยนไปเรื่อย ๆ</caption>
      <thead>
        <tr><th>งวดที่</th><th>ไปเป็นดอกเบี้ย</th><th>ตัดเงินต้นได้</th><th>เงินต้นคงเหลือ</th></tr>
      </thead>
      <tbody>
        {[1, 12, 60, 120, 180, 240, 300, 360].map((m) => {
          const row = plan[m - 1];
          return (
            <tr>
              <td>{m}</td>
              <td class="hot">{baht(row.interest)}</td>
              <td class="cool">{baht(row.principal)}</td>
              <td>{baht(Math.max(row.balance, 0))}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    <figcaption>งวดแรกจ่ายไป {baht(PMT)} บาท แต่บ้านเป็นของเราเพิ่มขึ้นแค่ {baht(plan[0].principal)} บาท ที่เหลือคือค่าเช่าเงินของธนาคาร</figcaption>
  </figure>

  <p>
    งวดแรก ดอกเบี้ยกิน <strong>{((plan[0].interest / PMT) * 100).toFixed(1)}%</strong> ของค่างวด ตลอดปีแรกเราจ่ายไปทั้งหมด {baht(PMT * 12)} บาท ในนั้นเป็นดอกเบี้ย {baht(byYear[0].interest)} บาท และตัดเงินต้นได้แค่ {baht(byYear[0].principal)} บาท คิดเป็น {((byYear[0].principal / (PMT * 12)) * 100).toFixed(0)}% ของเงินที่จ่ายไป
  </p>
  <p>
    ที่เป็นแบบนี้เพราะงวดแรกเงินต้นยังค้างอยู่เต็ม 3 ล้าน ดอกเบี้ยจึงเต็มที่สุด แล้วหลังจากนั้นมันจะไล่ลงทุกงวดเพราะยอดค้างลดลง ทำให้ส่วนที่ตัดเงินต้นโตขึ้นทุกงวดโดยที่ค่างวดไม่ขยับ
  </p>

  <ZoomableDiagram caption="ทุกแท่งสูงเท่ากันเพราะเราจ่ายเท่ากันทุกปี ที่เปลี่ยนคือสัดส่วนข้างใน (diagram สร้างจากตัวเลขที่คำนวณตอน build)">
    <svg viewBox="0 0 720 260" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={`กราฟแท่งซ้อนสามสิบแท่ง แท่งละหนึ่งปี ความสูงเท่ากันทุกแท่งเพราะค่างวดรวมทั้งปีคงที่ ส่วนสีทองด้านบนคือดอกเบี้ย ส่วนสีเขียวด้านล่างคือเงินต้น ปีแรกดอกเบี้ยกินพื้นที่เกือบทั้งแท่ง แล้วสัดส่วนดอกเบี้ยลดลงเรื่อย ๆ จนปีที่สามสิบเป็นเงินต้นเกือบทั้งแท่ง จุดที่เงินต้นแซงดอกเบี้ยอยู่ราวปีที่ ${Math.ceil(crossover.month / 12)}`} style="font-family:'Sarabun',sans-serif">
      <text x="8" y="18" font-size="11" fill="#f0d060">■ ดอกเบี้ย</text>
      <text x="90" y="18" font-size="11" fill="#4ade80">■ เงินต้น</text>
      <line x1={CH.x0} y1={CH.y0 + CH.h} x2={CH.x0 + CH.w} y2={CH.y0 + CH.h} stroke="#3a4666" stroke-width="1"/>
      <text x={CH.x0 - 8} y={CH.y0 + 6} font-size="10" fill="#8a97ad" text-anchor="end">{baht(yearTotal)}</text>
      <text x={CH.x0 - 8} y={CH.y0 + CH.h + 4} font-size="10" fill="#8a97ad" text-anchor="end">0</text>
      {byYear.map((y, i) => {
        const hI = (y.interest / yearTotal) * CH.h;
        const hP = (y.principal / yearTotal) * CH.h;
        const x = CH.x0 + i * slot + (slot - barW) / 2;
        return (
          <g>
            <rect x={x} y={CH.y0} width={barW} height={hI} fill="#e0b400" opacity="0.85"/>
            <rect x={x} y={CH.y0 + hI} width={barW} height={hP} fill="#2f9e5c"/>
          </g>
        );
      })}
      {[1, 5, 10, 15, 20, 25, 30].map((yr) => (
        <text x={CH.x0 + (yr - 0.5) * slot} y={CH.y0 + CH.h + 18} font-size="10" fill="#8a97ad" text-anchor="middle">{yr}</text>
      ))}
      <text x={CH.x0 + CH.w / 2} y={CH.y0 + CH.h + 38} font-size="10.5" fill="#8a97ad" text-anchor="middle">ปีที่</text>
      <line x1={CH.x0 + Math.ceil(crossover.month / 12) * slot} y1={CH.y0 - 4} x2={CH.x0 + Math.ceil(crossover.month / 12) * slot} y2={CH.y0 + CH.h} stroke="#f08b8b" stroke-width="1.4" stroke-dasharray="4 3"/>
      <text x={CH.x0 + Math.ceil(crossover.month / 12) * slot + 6} y={CH.y0 + 14} font-size="10.5" fill="#f08b8b">เงินต้นเพิ่งแซงดอกเบี้ย</text>
    </svg>
  </ZoomableDiagram>

  <p>
    เส้นประสีแดงคือจุดที่หลายคนไม่เคยรู้ ผ่อนไปถึงงวดที่ {crossover.month} หรือราวปีที่ {(crossover.month / 12).toFixed(1)} นั่นแหละที่เงินต้นเพิ่งจะเริ่มมากกว่าดอกเบี้ยในค่างวดหนึ่งงวด และหนี้จะเหลือครึ่งหนึ่งของยอดที่กู้ตอนงวดที่ {halfway.month} หรือปีที่ {(halfway.month / 12).toFixed(1)} ทั้งที่จ่ายเงินมาแล้ว {mB(PMT * halfway.month)} ล้านบาท
  </p>
  <div class="callout callout-warn">
    <p class="callout-label">ตัวเลขที่ควรจำ</p>
    <p>
      กู้ {mB(LOAN)} ล้าน ครบสามสิบปีจะจ่ายเงินไปทั้งหมด <strong>{baht(PMT * N)}</strong> บาท เป็นดอกเบี้ย <strong>{baht(totalInterest)}</strong> บาท คิดเป็น {((totalInterest / LOAN) * 100).toFixed(0)}% ของเงินต้น พูดง่าย ๆ คือเสียดอกเบี้ยมากกว่าราคาบ้านที่กู้มา
    </p>
  </div>
  <p>
    ตรงนี้ต้องพูดให้เป็นธรรมกับสินเชื่อบ้านด้วย ตัวเลข 3.4 ล้านนั้นเป็นเงินของอีกสามสิบปีข้างหน้า ซึ่งค่าของมันไม่เท่ากับเงินวันนี้ ค่างวด 17,987 บาทในปี 2056 จะรู้สึกเล็กกว่าตอนนี้มาก เพราะเงินเดือนและราคาของโดยทั่วไปขยับขึ้นตามเวลา นี่คือข้อดีที่แท้จริงของการล็อกหนี้ก้อนใหญ่ไว้นาน ๆ ในสกุลเงินที่เฟ้อได้ ผู้กู้ได้เปรียบเงินเฟ้อ
  </p>
  <details class="expander">
    <summary>สูตรค่างวดมาจากไหน (คณิตศาสตร์ล้วน)</summary>
    <div class="expander-body">
      <p>
        เราอยากหาค่างวด M ที่ทำให้ผ่อน n งวดแล้วหนี้เหลือศูนย์พอดี วิธีคิดที่ตรงที่สุดคือมองว่าเงินต้นวันนี้ต้องเท่ากับมูลค่าปัจจุบันของค่างวดทุกงวดรวมกัน
      </p>
      <p>
        <code>L = M/(1+r) + M/(1+r)² + … + M/(1+r)ⁿ</code>
      </p>
      <p>
        ก้อนขวาคืออนุกรมเรขาคณิต (geometric series) อัตราส่วน 1/(1+r) พอยุบด้วยสูตรผลบวกอนุกรมจะได้
      </p>
      <p>
        <code>L = M × (1 − (1+r)⁻ⁿ) / r</code> ซึ่งย้ายข้างเป็น <code>M = L × r / (1 − (1+r)⁻ⁿ)</code>
      </p>
      <p>
        แทน L = 3,000,000, r = 0.06/12 = 0.005, n = 360 จะได้ M = {PMT.toFixed(2)} บาท ก้อน <code>(1 − (1+r)⁻ⁿ)/r</code> มีชื่อเรียกว่า <strong>annuity factor</strong> ("แอนนูอิตี แฟกเตอร์" แปลว่าตัวคูณของกระแสเงินงวดเท่ากัน) เดี๋ยวจะได้ใช้อีกในหัวข้อจุดคุ้มทุน
      </p>
    </div>
  </details>

  <hr class="divider-solid" />

  <h2>ทำไมโปะเงินต้นถึงแรงเกินคาด</h2>
  <p>
    เพราะดอกเบี้ยคิดจากยอดค้าง เงินที่โปะเข้าไปตัดเงินต้นวันนี้จึงไม่ได้ช่วยแค่งวดนี้ มันลบดอกเบี้ยของทุกงวดที่เหลือทิ้งไปด้วย ยิ่งโปะเร็ว จำนวนงวดที่ถูกลบก็ยิ่งมาก
  </p>

  <figure class="tbl">
    <table class="amo">
      <caption>กู้ {mB(LOAN)} ล้าน 30 ปี 6% เทียบสามแบบ</caption>
      <thead>
        <tr><th>วิธีผ่อน</th><th>ผ่อนหมดใน</th><th>ดอกเบี้ยรวม</th><th>ประหยัดได้</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>ผ่อนตามตารางเฉย ๆ</td>
          <td>{YEARS} ปี</td>
          <td class="hot">{baht(totalInterest)}</td>
          <td>0</td>
        </tr>
        <tr>
          <td>โปะเพิ่มเดือนละ {baht(EXTRA)}</td>
          <td>{(planExtra.length / 12).toFixed(1)} ปี</td>
