    width:100%;
    accent-color:var(--dl-emerald);
    cursor:pointer;
  }
  .calc-grid{
    display:grid;
    grid-template-columns:repeat(2, minmax(0,1fr));
    gap:0.7rem;
    margin-top:1.2rem;
  }
  .calc-cell{
    background:#1c2536;
    border:1px solid var(--dl-border);
    border-radius:11px;
    padding:0.65rem 0.8rem;
  }
  .calc-k{
    font-size:0.74rem;
    color:var(--dl-muted);
    margin:0 0 0.15rem;
  }
  .calc-v{
    font-size:1.02rem;
    font-weight:700;
    color:#fff;
    margin:0;
    font-variant-numeric:tabular-nums;
  }
  .calc-v.hot{color:#f0c860;}
  .calc-slice{margin-top:1.2rem;}
  .calc-slice .calc-k b{color:var(--dl-emerald-bright);}
  .calc-bar{
    display:flex;
    height:26px;
    border-radius:7px;
    overflow:hidden;
    margin-top:0.5rem;
    background:#1c2536;
  }
  .calc-bar-i{background:#e0b400;}
  .calc-bar-p{background:var(--dl-emerald);}
  .calc-legend{
    font-size:0.78rem;
    color:var(--dl-muted);
    margin-top:0.45rem;
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:0.35rem 0.7rem;
  }
  .calc-legend b{color:#e7ecf6;font-variant-numeric:tabular-nums;}
  .calc-legend .sw-i, .calc-legend .sw-p{
    width:10px;
    height:10px;
    border-radius:3px;
    display:inline-block;
  }
  .calc-legend .sw-i{background:#e0b400;}
  .calc-legend .sw-p{background:var(--dl-emerald);}
  .calc-legend .calc-bal{margin-left:auto;}
  .calc-verdict{
    margin-top:1.3rem;
    padding:0.9rem 1rem;
    border-radius:12px;
    background:#1c2536;
    border:1px solid var(--dl-border);
  }
  .calc-verdict p{font-size:0.84rem;margin:0.2rem 0;}
  .calc-verdict b{color:#fff;font-variant-numeric:tabular-nums;}
  .calc-say{
    margin-top:0.6rem !important;
    padding-top:0.55rem;
    border-top:1px dashed var(--dl-border);
    font-weight:700;
  }
  .calc-say.win{color:var(--dl-emerald-bright);}
  .calc-say.lose{color:#f0c860;}
  .calc-note{
    font-size:0.74rem;
    color:#6b7690;
    margin-top:0.8rem;
  }
  @media (max-width: 480px){
    .calc-grid{grid-template-columns:1fr;}
  }
</style>

<script>
  // เครื่องคิดเลขสองทาง: คิดสดในเบราว์เซอร์ ไม่ส่งข้อมูลออกไปไหน
  (function () {
    interface Refs {
      loan: HTMLInputElement;
      rate: HTMLInputElement;
      years: HTMLInputElement;
      growth: HTMLInputElement;
      peek: HTMLInputElement;
    }

    const money = (n: number): string => Math.round(n).toLocaleString('en-US');
    const millions = (n: number): string => `${(n / 1_000_000).toFixed(2)} ล้านบาท`;

    function pmt(principal: number, monthlyRate: number, months: number): number {
      if (monthlyRate === 0) return principal / months;
      return (principal * monthlyRate) / (1 - Math.pow(1 + monthlyRate, -months));
    }

    function initOne(root: HTMLElement): void {
      if (root.dataset.wired === '1') return;
      const get = (name: string): HTMLInputElement | null =>
        root.querySelector<HTMLInputElement>(`[data-in="${name}"]`);
      const loan = get('loan');
      const rate = get('rate');
      const years = get('years');
      const growth = get('growth');
      const peek = get('peek');
      if (!loan || !rate || !years || !growth || !peek) return;
      const refs: Refs = { loan, rate, years, growth, peek };

      const out = (name: string): HTMLElement | null =>
        root.querySelector<HTMLElement>(`[data-out="${name}"]`);
      const put = (name: string, text: string): void => {
        const el = out(name);
        if (el) el.textContent = text;
      };

      const barI = out('bari');
      const barP = out('barp');
      const say = out('say');
      const barBox = out('barlabel');

      function render(): void {
        const L = Number(refs.loan.value);
        const annual = Number(refs.rate.value) / 100;
        const yrs = Number(refs.years.value);
        const g = Number(refs.growth.value) / 100;
        const n = yrs * 12;
        const r = annual / 12;
        const M = pmt(L, r, n);

        // งวดที่ส่อง: ยืดหยุ่นตามระยะเวลาผ่อนที่เลือกอยู่
        if (refs.peek.max !== String(n)) {
          refs.peek.max = String(n);
          if (Number(refs.peek.value) > n) refs.peek.value = String(n);
        }
        const target = Number(refs.peek.value);

        let balance = L;
        let totalInterest = 0;
        let slice = { interest: 0, principal: 0, balance: L };
        for (let m = 1; m <= n; m++) {
          const interest = balance * r;
          let paid = M - interest;
          if (paid > balance) paid = balance;
          balance -= paid;
          totalInterest += interest;
          if (m === target) slice = { interest, principal: paid, balance };
        }

        put('loan', money(L));
        put('rate', Number(refs.rate.value).toFixed(2));
        put('years', String(yrs));
        put('growth', Number(refs.growth.value).toFixed(1));
        put('pmt', `${money(M)} บาท`);
        put('totint', `${money(totalInterest)} บาท`);
        put('totpay', `${money(M * n)} บาท`);
        put('ratio', `${(totalInterest / L).toFixed(2)} เท่า`);

        put('peekm', `งวดที่ ${target}`);
        put('peeky', (target / 12).toFixed(1));
        put('peekint', `${money(slice.interest)} บาท`);
        put('peekprin', `${money(slice.principal)} บาท`);
        put('peekbal', `${money(Math.max(slice.balance, 0))} บาท`);
        const shareI = (slice.interest / M) * 100;
        if (barI) barI.style.width = `${shareI.toFixed(2)}%`;
        if (barP) barP.style.width = `${(100 - shareI).toFixed(2)}%`;
        if (barBox) {
          barBox.setAttribute(
            'aria-label',
            `ค่างวดงวดที่ ${target} เป็นดอกเบี้ย ${shareI.toFixed(0)} เปอร์เซ็นต์ ที่เหลือเป็นเงินต้น`,
          );
        }

        // ปลายทางสองทาง: A เติมค่างวดเข้าพอร์ต, B ปล่อยเงินก้อนไว้ในพอร์ต
        const gm = g / 12;
        const fvA = gm === 0 ? M * n : M * ((Math.pow(1 + gm, n) - 1) / gm);
        const fvB = L * Math.pow(1 + gm, n);
        put('fva', millions(fvA));
        put('fvb', millions(fvB));

        const diff = fvB - fvA;
        const gap = Math.abs(diff);
        if (say) {
          if (gap < L * 0.001) {
            say.textContent = 'เสมอกันพอดี เพราะผลตอบแทนลงทุนเท่ากับดอกเบี้ยเงินกู้';
            say.className = 'calc-say';
          } else if (diff > 0) {
            say.textContent = `ทาง B (กู้) นำอยู่ ${millions(gap)} เพราะผลตอบแทนที่คาดหวังสูงกว่าดอกเบี้ยเงินกู้`;
            say.className = 'calc-say win';
          } else {
            say.textContent = `ทาง A (จ่ายสด) นำอยู่ ${millions(gap)} เพราะผลตอบแทนที่คาดหวังต่ำกว่าดอกเบี้ยเงินกู้`;
            say.className = 'calc-say lose';
          }
        }
      }

      (['loan', 'rate', 'years', 'growth', 'peek'] as const).forEach((k) => {
        refs[k].addEventListener('input', render);
      });
      render();
      root.dataset.wired = '1';
    }

    function initAll(): void {
      document.querySelectorAll<HTMLElement>('[data-calc]').forEach(initOne);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
    document.addEventListener('astro:page-load', initAll);
  })();
</script>
