---
import DivineLoreLayout from '../../layouts/DivineLoreLayout.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { tex, texBlock } from '../../lib/math';

/**
 * ตัวเลขทุกตัวในบทความนี้คำนวณตอน build ไม่ได้พิมพ์มือ
 * โมเดล: ลดต้นลดดอกแบบคิดดอกเบี้ยรายเดือน (r = อัตราต่อปี / 12) ค่างวดคงที่
 */
const LOAN = 3_000_000;
const ANNUAL = 0.06;
const YEARS = 30;
const N = YEARS * 12;
const R = ANNUAL / 12;

function payment(principal: number, monthlyRate: number, months: number): number {
  if (monthlyRate === 0) return principal / months;
  return (principal * monthlyRate) / (1 - Math.pow(1 + monthlyRate, -months));
}

interface Row {
  month: number;
  interest: number;
  principal: number;
  balance: number;
}

function schedule(principal: number, monthlyRate: number, months: number, extra = 0): Row[] {
  const base = payment(principal, monthlyRate, months);
  const rows: Row[] = [];
  let balance = principal;
  for (let m = 1; m <= months && balance > 0.005; m++) {
    const interest = balance * monthlyRate;
    let paid = base + extra - interest;
    if (paid > balance) paid = balance;
    balance -= paid;
    rows.push({ month: m, interest, principal: paid, balance });
  }
  return rows;
}

const PMT = payment(LOAN, R, N);
const plan = schedule(LOAN, R, N);
const totalInterest = plan.reduce((s, x) => s + x.interest, 0);

/** รวมดอกเบี้ย/เงินต้นเป็นรายปี เอาไปวาดกราฟแท่งซ้อน */
const byYear = Array.from({ length: YEARS }, (_, y) => {
  const slice = plan.slice(y * 12, y * 12 + 12);
  return {
    year: y + 1,
    interest: slice.reduce((s, x) => s + x.interest, 0),
    principal: slice.reduce((s, x) => s + x.principal, 0),
  };
});

const crossover = plan.find((x) => x.principal > x.interest)!;
const halfway = plan.find((x) => x.balance <= LOAN / 2)!;

/** โปะเพิ่มเดือนละ 5,000 */
const EXTRA = 5_000;
const planExtra = schedule(LOAN, R, N, EXTRA);
const extraInterest = planExtra.reduce((s, x) => s + x.interest, 0);

/** โปะก้อน 300,000 ตั้งแต่งวดแรก (ค่างวดเดิม) */
const LUMP = 300_000;
const lumpRows: Row[] = [];
{
  let balance = LOAN - LUMP;
  for (let m = 1; m <= N && balance > 0.005; m++) {
    const interest = balance * R;
    let paid = PMT - interest;
    if (paid > balance) paid = balance;
    balance -= paid;
    lumpRows.push({ month: m, interest, principal: paid, balance });
  }
}
const lumpInterest = lumpRows.reduce((s, x) => s + x.interest, 0);

/** สองทางเลือก: จ่ายสดแล้วลงทุนค่างวด vs กู้แล้วปล่อยเงินก้อนลงทุน */
function twoPaths(growth: number): { cash: number; loan: number } {
  const g = growth / 12;
  return {
    // g = 0 คือกรณีลิมิต เงินที่เติมไม่โตเลย ปลายทางจึงเท่ากับผลรวมของค่างวด
    cash: g === 0 ? PMT * N : PMT * ((Math.pow(1 + g, N) - 1) / g),
    loan: LOAN * Math.pow(1 + g, N),
  };
}
const paths = [0.04, 0.05, 0.06, 0.07, 0.08, 0.1].map((g) => ({ g, ...twoPaths(g) }));

/** ดอกเบี้ยงวดแรกถ้าคิดแบบรายวันจริง ใช้โชว์ว่าจำนวนวันในงวดทำให้ตัวเลขขยับแค่ไหน */
const dailyInterest = (days: number) => LOAN * ANNUAL * (days / 365);
const dayCases = [28, 30, 31];

const baht = (n: number) => Math.round(n).toLocaleString('en-US');
const mB = (n: number) => (n / 1_000_000).toFixed(2);

/** พิกัดกราฟแท่งซ้อนรายปี */
const CH = { x0: 56, y0: 44, w: 620, h: 176 };
const yearTotal = byYear[0].interest + byYear[0].principal;
const slot = CH.w / YEARS;
const barW = slot * 0.66;
/** แท่งแรกที่ยอดเงินต้นทั้งปีแซงดอกเบี้ยทั้งปี (เส้นประต้องปักกลางแท่งนี้ ไม่ใช่ที่ขอบ slot) */
const crossYear = byYear.find((y) => y.principal > y.interest)!.year;
const crossoverX = CH.x0 + (crossYear - 0.5) * slot;

/**
 * กราฟเส้นเทียบ FV ของทางจ่ายสด (A) กับทางกู้ (B) ตามผลตอบแทนลงทุน g
 * พิกัดทุกจุด derive จาก twoPaths() ตัวเดียวกับที่ตารางใช้ ไม่มีพิกัดพิมพ์มือ
 */
const FV = { x0: 74, y0: 30, w: 596, h: 186 };
const G_MIN = 0;
const G_MAX = 0.12;
const fvPoints = Array.from({ length: 61 }, (_, i) => {
  const g = G_MIN + ((G_MAX - G_MIN) * i) / 60;
  const { cash, loan } = twoPaths(g);
  return { g, cash, loan };
});
const fvMax = Math.max(...fvPoints.map((p) => Math.max(p.cash, p.loan)));
const fvX = (g: number) => FV.x0 + ((g - G_MIN) / (G_MAX - G_MIN)) * FV.w;
const fvY = (v: number) => FV.y0 + FV.h - (v / fvMax) * FV.h;
const fvPath = (pick: (p: (typeof fvPoints)[number]) => number) =>
  fvPoints.map((p, i) => `${i === 0 ? 'M' : 'L'}${fvX(p.g).toFixed(2)} ${fvY(pick(p)).toFixed(2)}`).join(' ');
const pathA = fvPath((p) => p.cash);
const pathB = fvPath((p) => p.loan);
const tieX = fvX(ANNUAL);
const tieY = fvY(twoPaths(ANNUAL).loan);
---
<DivineLoreLayout
  title="คนรวยก็กู้ซื้อบ้าน: แกะดอกเบี้ยทีละบาท | บันทึกศาสตร์แห่งเทพ"
  description="เกร็ดการเงินชิ้นแรก แกะโพสต์ยอดนิยมเรื่องคนรวยที่ยังกู้แบงก์ซื้อบ้าน ว่า amortizing loan ทำงานยังไง ประวัติของ Buffett, Zuckerberg, Musk, Griffin, Jay-Z จริงแค่ไหน พร้อมเครื่องคิดเลขเทียบทางจ่ายสดกับทางกู้"
>
  <nav class="dl-nav">
    <a href="../">
      <svg class="dl-nav-arrow" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
      กลับไปที่บันทึกลับ
    </a>
  </nav>
  <p class="tag">บันทึกการเงิน</p>
  <h1>คนรวยก็กู้ซื้อบ้าน: แกะดอกเบี้ยทีละบาท</h1>
  <p class="subtitle">
    กู้บ้าน {mB(LOAN)} ล้าน ผ่อนสามสิบปี จ่ายจริง {mB(PMT * N)} ล้าน เป็นดอกเบี้ย {mB(totalInterest)} ล้าน แพงกว่าตัวบ้านที่กู้มา แต่คนที่ควักเงินสดซื้อทั้งหลังได้สบาย ๆ กลับเลือกกู้ บันทึกนี้แกะดอกเบี้ยทีละบาทจนเห็นว่าเส้นแบ่งระหว่างจ่ายสดกับกู้อยู่ตรงไหนเป๊ะ ๆ และวิธีคิดแบบมหาเศรษฐีอเมริกันส่วนไหนที่ใช้ในไทยไม่ได้เลย
  </p>

  <hr class="divider" />

  <div class="callout callout-warn">
    <p class="callout-label">อ่านก่อน</p>
    <p>
      บันทึกนี้ทำเพื่อการศึกษาเท่านั้น ไม่ใช่คำแนะนำการลงทุนหรือคำแนะนำเรื่องสินเชื่อ ตัวเลขอัตราดอกเบี้ยและกฎภาษีที่อ้างถึงเป็นข้อมูลช่วงกลางปี 2026 ซึ่งเปลี่ยนได้ ก่อนตัดสินใจจริงกรุณาไปคุยกับธนาคารและตรวจกฎล่าสุดด้วยตัวเองอีกรอบครับ
    </p>
  </div>

  <p>
    ลองคิดเลขเล่น ๆ กู้ {mB(LOAN)} ล้านซื้อบ้าน ดอกเบี้ย {(ANNUAL * 100).toFixed(0)}% ต่อปี ผ่อนสามสิบปี ครบสัญญาแล้วเงินที่ไหลออกจากบัญชีเราทั้งหมดคือ {mB(PMT * N)} ล้านบาท ในนั้นเป็นดอกเบี้ย {mB(totalInterest)} ล้าน แปลว่าค่าเช่าเงินที่จ่ายให้ธนาคารแพงกว่าราคาบ้านที่ขอกู้มา ใครเห็นเลขนี้ครั้งแรกแล้วอยากรีบหาทางโปะให้จบไว ๆ ถือว่าปกติมาก
  </p>
  <p>
    ทีนี้เรื่องที่แปลกคือ คนที่ควักเงินสดซื้อบ้านทั้งหลังได้โดยไม่สะเทือนอะไรเลย หลายคนกลับเลือกกู้ ทุกปีจะมีโพสต์ไล่รายชื่อพวกนี้วนกลับมา Buffett กู้สามสิบปีทั้งที่รวยระดับโลก Zuckerberg รีไฟแนนซ์ (refinance) บ้านตัวเอง คือย้ายหนี้ก้อนเดิมไปแบงก์ใหม่ที่คิดดอกถูกกว่า ส่วน Musk กู้จาก Morgan Stanley เวลามีคนถามว่ารวยขนาดนั้นแล้วกู้ทำไม คำตอบที่ได้ยินบ่อยที่สุดคือเอาเงินก้อนไปลงทุนต่อคุ้มกว่าดอกเบี้ยที่เสีย
  </p>
  <p>
    คำตอบนั้นถูก แล้วก็หยุดตรงจุดที่น่าสนใจที่สุดพอดี <strong>คุ้มกว่าที่ผลตอบแทนกี่เปอร์เซ็นต์</strong> ไม่มีโพสต์ไหนบอก ทั้งที่คำถามนี้มีคำตอบเป๊ะ ๆ เป็นตัวเลขตัวเดียว และพิสูจน์ได้ด้วยพีชคณิตไม่กี่บรรทัด
  </p>
  <p>
    ก่อนจะไปถึงเส้นแบ่งนั้น ต้องรู้ก่อนว่าดอกเบี้ยบ้านเดินยังไง เพราะเกือบทุกความเข้าใจผิดเรื่องนี้เริ่มจากการเดาวิธีเดินของมันผิดตั้งแต่บรรทัดแรก บันทึกนี้เลยเริ่มจากการกางตัวเลขให้เห็นทีละบาทก่อน แล้วค่อยไปดูว่าประวัติของมหาเศรษฐีแต่ละคนจริงแค่ไหน และกติกาภาษีที่ทำให้วิธีคิดของพวกเขาเวิร์ก มีข้อไหนบ้างที่ยกมาใช้ในไทยไม่ได้เลย
  </p>
  <div class="card">
    <p><strong>ทางเดินของบันทึกนี้</strong></p>
    <p>1. กฎสองบรรทัดที่ดอกเบี้ยบ้านทุกก้อนในโลกเดินตาม แล้วไล่มือดูเคสจิ๋วสองงวดให้เห็นกับตา</p>
    <p>2. กางตารางกู้ 3 ล้านจริง ๆ ว่าค่างวดที่จ่ายไปแต่ละงวดหายไปไหนบ้าง</p>
    <p>3. ทำไมโปะเงินต้นถึงแรงเกินคาด และเส้นแบ่งระหว่างจ่ายสดกับกู้อยู่ตรงไหนเป๊ะ ๆ</p>
    <p>4. เครื่องคิดเลขให้ลากเล่นเอง แล้วไล่ประวัติมหาเศรษฐีห้ารายว่าจริงแค่ไหน</p>
    <p>5. กติกาไทยกับสหรัฐต่างกันข้อไหน และข้อไหนที่ลอกตามไม่ได้</p>
    <p>ถ้ามีเวลาน้อย อ่านข้อ 1 ถึง 3 ก็ได้ของครบแล้วครับ ส่วนกล่องที่พับไว้ทุกกล่องเป็นของแถมสำหรับคนอยากเห็นเบื้องหลัง ข้ามได้โดยไม่เสียเนื้อเรื่อง</p>
  </div>

  <hr class="divider-solid" />

  <h2>ดอกเบี้ยบ้านคิดจากยอดที่ยังค้าง ไม่ใช่จากยอดที่กู้</h2>
  <p>
    เรื่องที่คนเข้าใจผิดกันมากที่สุดคือคิดว่ากู้ 3 ล้าน ดอกเบี้ย 6% ต่อปี แปลว่าเสียดอกปีละ 180,000 บาทเท่ากันทุกปีไปสามสิบปี รวมเป็นดอกเบี้ย 5.4 ล้าน ถ้าเป็นแบบนั้นจริงคือน่ากลัวมาก แต่มันไม่ใช่แบบนั้น
  </p>
  <div class="callout callout-tip">
    <p class="callout-label">สี่คำที่ต้องมีติดตัวก่อน</p>
    <p>
      ทั้งบันทึกนี้ใช้คำสี่คำวนไปวนมา ถ้าจับสี่คำนี้ได้ ที่เหลืออ่านรวดเดียวจบ
    </p>
    <p>
      <strong>เงินต้น</strong> คือเงินที่เรายืมมาจริง ๆ ยังไม่รวมดอกเบี้ย ในเคสนี้คือ {baht(LOAN)} บาท ณ วันเซ็นสัญญา
    </p>
    <p>
      <strong>ดอกเบี้ย</strong> คือค่าเช่าเงิน เราจ่ายให้ธนาคารเพื่อแลกกับการได้ใช้เงินก้อนนั้นก่อน
    </p>
    <p>
      <strong>ค่างวด</strong> คือเงินที่เราโอนให้ธนาคารเดือนละครั้ง ข้างในก้อนนี้มีทั้งดอกเบี้ยและเงินต้นปนกันอยู่ ซึ่งสัดส่วนข้างในคือพระเอกของหัวข้อถัดไป
    </p>
    <p>
      <strong>เงินต้นคงเหลือ</strong> หรือที่บันทึกนี้เรียกสั้น ๆ ว่ายอดค้าง คือเงินต้นส่วนที่ยังไม่ได้คืนธนาคาร เริ่มที่ {baht(LOAN)} แล้วลดลงทุกงวด
    </p>
  </div>
  <div class="callout callout-note">
    <p class="callout-label">แกะคำศัพท์</p>
    <p>
      <strong>Amortizing loan</strong> อ่านว่า <strong>"อะมอร์ไทซิง โลน"</strong> แปลว่า <strong>"เงินกู้แบบทยอยตัดต้น"</strong> ที่บ้านเราเรียกว่า <strong>ลดต้นลดดอก</strong> รากศัพท์สนุกมาก <i>amortize</i> มาจากภาษาละติน <i>ad mortem</i> ที่แปลตรงตัวว่า "ไปสู่ความตาย" เพราะเราค่อย ๆ ฆ่าหนี้ให้ตายไปทีละงวด คำว่า <i>mortgage</i> ก็ญาติกัน คือ <i>mort</i> (ตาย) บวก <i>gage</i> (คำมั่น) แปลว่าคำมั่นที่จะตายไปเอง คือตายเพราะผ่อนหมด หรือตายเพราะบ้านถูกยึด อย่างใดอย่างหนึ่ง
    </p>
  </div>
  <p>
    กฎมีข้อเดียว ดอกเบี้ยงวดนี้คิดจาก <strong>เงินต้นที่ยังค้างอยู่ตอนนั้น</strong> เท่านั้น ยอดที่เคยกู้มาไม่เกี่ยวอีกแล้ว
  </p>
  <div class="card">
    <Fragment set:html={texBlock(String.raw`\text{ดอกเบี้ยงวดนี้} \;=\; \text{เงินต้นคงเหลือ} \times \text{อัตราดอกเบี้ยต่องวด}`)} />
    <Fragment set:html={texBlock(String.raw`\text{เงินต้นที่ตัดได้งวดนี้} \;=\; \text{ค่างวดที่จ่าย} \;-\; \text{ดอกเบี้ยงวดนี้}`)} />
  </div>
  <p>
    ที่ต้องมีคำว่า <strong>ต่องวด</strong> ห้อยท้าย เพราะอัตราที่ธนาคารประกาศเป็นอัตรา <strong>ต่อปี</strong> เงินที่เรายืมมาไม่ได้อยู่กับเราครบปีในงวดเดียว มันอยู่แค่เดือนเดียว เราจึงจ่ายค่าเช่าตามสัดส่วนของเวลาที่ยืมจริง คือหารด้วยสิบสอง อัตรา {(ANNUAL * 100).toFixed(0)}% ต่อปีจึงกลายเป็น {(R * 100).toFixed(1)}% ต่อเดือน แปลว่างวดแรกที่ยังค้างเต็ม {baht(LOAN)} บาท ดอกเบี้ยคือ {baht(LOAN * R)} บาท
  </p>
  <p>
    สูตรสองบรรทัดนี้คือทุกอย่างที่ต้องรู้จริง ๆ ตัวเลขทุกตัวที่เหลือในบันทึกนี้ ทั้งตาราง กราฟ และเครื่องคิดเลขข้างล่าง ล้วนงอกออกมาจากการวนสองบรรทัดนี้ซ้ำ ๆ 360 รอบเท่านั้น
  </p>
  <p>
    (ของจริงธนาคารไทยละเอียดกว่านี้อีกขั้น คือคิดดอกเบี้ยตามจำนวนวันจริงของแต่ละงวด งวดที่ยาว 31 วันกับงวดที่ยาว 28 วันจึงเสียดอกต่างกันราว {baht(dailyInterest(31) - dailyInterest(28))} บาท ซึ่งเป็นเหตุผลที่ใบเสร็จแต่ละเดือนไม่เคยเท่ากันเป๊ะ บันทึกนี้ใช้เวอร์ชันย่อคือถือว่าทุกงวดยาวเท่ากันหมด รายละเอียดกางไว้ในกล่องท้ายหัวข้อนี้)
  </p>
  <p>
