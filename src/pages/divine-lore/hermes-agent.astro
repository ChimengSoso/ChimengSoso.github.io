---
import LoreDates from '../../components/LoreDates.astro';
import DivineLoreLayout from '../../layouts/DivineLoreLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { divineLoreEntries } from '../../data/divineLore';

const entry = divineLoreEntries.find((e) => e.href === 'hermes-agent/');
if (!entry) throw new Error('hermes-agent/ ไม่มีใน divineLore.ts');

const installCode = `# Linux / macOS / WSL2
curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash

# Windows (PowerShell) ติดตั้งไว้ที่ %LOCALAPPDATA%\\hermes
iex (irm https://hermes-agent.nousresearch.com/install.ps1)`;

const safeConfig = `# ~/.hermes/config.yaml (ตั้งก่อนคุยครั้งแรก)
auth:
  adopt_external_logins: false   # ไม่ยืม login ของ Claude Code / Codex
approvals:
  mode: manual                   # ถามทุกคำสั่งที่เสี่ยง
skills:
  write_approval: true           # skill ที่ agent เขียนเอง ต้องรอเราอนุมัติ
memory:
  write_approval: true           # ความจำใหม่ ต้องรอเราอนุมัติ`;

const firstRun = `hermes setup        # เลือก Blank Slate ถ้าอยากเริ่มจากเครื่องมือน้อยที่สุด
hermes model        # เลือกเจ้าของโมเดลกับตัวโมเดล
hermes doctor       # ตรวจว่าลงครบ
hermes --tui        # เริ่มคุย (หน้าจอแบบใหม่)`;

const skillsConfig = `skills:
  external_dirs:
    - ~/.agents/skills   # ที่เดียวกับที่ T3 Code และ Codex อ่าน`;

const approveCmds = `/skills pending          # ดู skill ที่ agent อยากเขียน
/skills diff <id>        # ดูว่ามันจะแก้อะไร
/skills approve <id>     # อนุมัติ
/skills reject <id>      # ปฏิเสธ
/memory pending          # แบบเดียวกันสำหรับความจำ`;
---
<DivineLoreLayout title={`${entry.title} | บันทึกศาสตร์แห่งเทพ`} description={entry.desc} toc>
  <nav class="dl-nav">
    <a href="../">
      <svg class="dl-nav-arrow" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
      กลับไปที่บันทึกลับ
    </a>
    <a href="../pstack-guide/">อ่านบท pstack</a>
    <a href="../test-t3-app-skill/">อ่านบท test-t3-app</a>
  </nav>
  <p class="tag">{entry.tag}</p>
  <h1>{entry.title}</h1>
  <p class="subtitle">
    สองบทก่อนพูดถึงเครื่องมือที่ช่วยให้ agent เขียนโค้ดได้ดีขึ้น บทนี้เป็นของอีกแบบ Hermes Agent คือ agent ที่อยู่ประจำ คุยผ่านแอปแชตได้ จำเราได้ข้ามวัน และเขียน skill ให้ตัวเองจากงานที่ทำ บทนี้อธิบายว่ามันอยู่ตรงไหนเทียบกับของที่เรามี ลงยังไงให้ปลอดภัย และระบบ skill กับความจำของมันทำงานยังไง
  </p>
  <LoreDates href="hermes-agent/" />

  <hr class="divider" />

  <div class="callout callout-warn">
    <p class="callout-label">บทนี้เขียนจากเอกสาร ยังไม่ได้ลองรันจริง</p>
    <p>
      ทุกอย่างในบทนี้มาจากเอกสารทางการบนเว็บ hermes-agent.nousresearch.com และ README บน GitHub ที่อ่านเมื่อ 12 ตุลาคม 2026 ยังไม่ได้ลงโปรแกรมแล้วลองเอง ตรงไหนที่ต้องลองถึงจะรู้ บทความจะบอกไว้ตรงนั้น โปรเจกต์นี้อัปเดตบ่อย ถ้าคำสั่งหรือค่าตั้งไม่ตรงกับที่เห็น ให้เชื่อเอกสารล่าสุดของเขา
    </p>
  </div>

  <p>
    ในบท <a href="../pstack-guide/">pstack</a> Lauren Tan เล่าเรื่อง "วงนอก" (outer loop) คือ bot ที่คอยฟังแชตใน Slack ฟังรายงานบั๊ก แล้วส่งงานต่อให้ agent ที่เขียนโค้ด Lauren ใช้ Grok Bot ทำหน้าที่นี้ <strong>Hermes Agent</strong> ของ Nous Research เป็นของประเภทเดียวกันในฉบับ open source (สัญญาอนุญาต MIT) ใช้โมเดลของเจ้าไหนก็ได้ และรันบนเครื่องเรา บน VPS ราคาถูก หรือบน cloud ก็ได้
  </p>
  <div class="callout callout-note">
    <p class="callout-label">แกะคำศัพท์</p>
    <p>
      <strong>Hermes</strong> อ่านว่า <strong>"เฮอร์มีส"</strong> เป็นชื่อเทพผู้ส่งสารของกรีก เทพที่วิ่งส่งข่าวระหว่างเทพกับมนุษย์ ชื่อนี้เข้ากับ agent ที่อยู่ในแอปแชตทุกแอปของเราพอดี ส่วน <strong>Nous</strong> อ่านว่า <strong>"นูส"</strong> เป็นคำกรีกแปลว่า <strong>"ปัญญา"</strong> หรือ "ใจที่คิดได้" Nous Research มีโมเดลภาษาตระกูลชื่อ Hermes อยู่ก่อนแล้วด้วย แต่ Hermes Agent คือตัว agent ที่ห่อโมเดลอะไรก็ได้ ไม่ได้ผูกกับโมเดลของเขาเอง
    </p>
  </div>

  <hr class="divider-solid" />

  <h2>Hermes อยู่ตรงไหน เทียบกับของที่เรามี</h2>
  <p>
    ถ้าเอาสามบทมาวางเรียงกัน ของแต่ละตัวตอบคำถามคนละข้อ
  </p>
  <div class="cmp">
    <div class="cmp-row cmp-head"><span></span><span>Claude Code</span><span>T3 Code</span><span>Hermes Agent</span></div>
    <div class="cmp-row"><span>มันคืออะไร</span><span>agent เขียนโค้ด</span><span>แผงคุม agent หลายตัว</span><span>agent ผู้ช่วยประจำตัว</span></div>
    <div class="cmp-row"><span>โมเดล</span><span>Claude</span><span>ของ agent ที่มันคุม</span><span>เจ้าไหนก็ได้</span></div>
    <div class="cmp-row"><span>อยู่ที่ไหน</span><span>เครื่องเรา เปิดเมื่อสั่ง</span><span>เครื่องเรา คุมจากมือถือได้</span><span>เครื่องเรา, VPS หรือ cloud เปิดทิ้งไว้</span></div>
    <div class="cmp-row"><span>คุยทางไหน</span><span>เทอร์มินัล, แอป</span><span>เว็บ, เดสก์ท็อป, มือถือ</span><span>Telegram, Discord, Slack, WhatsApp, Signal, CLI</span></div>
    <div class="cmp-row"><span>skill</span><span>เราเขียน</span><span>ใช้ของ agent ที่คุม</span><span>เราเขียน และ agent เขียนเองได้</span></div>
    <div class="cmp-row"><span>เหมาะกับ</span><span>งานโค้ดตรงหน้า</span><span>คุมงานโค้ดหลายสาย</span><span>งานประจำ งานตามเวลา งานที่สั่งจากแชต</span></div>
  </div>
  <p>
    สรุปแบบสั้นคือ งานเขียนโค้ดตรงหน้ายังเป็นของ Claude Code ส่วน Hermes เหมาะกับงานที่ต้องมีคนเฝ้าอยู่ตลอด เช่น สรุปข่าวทุกเช้า สำรองไฟล์ทุกคืน รับคำสั่งจากมือถือระหว่างเดินทาง ซึ่งเป็นงานที่ Claude Code ในเทอร์มินัลไม่ได้ออกแบบมาให้ทำ
  </p>

  <ZoomableDiagram caption="โครงของ Hermes Agent วาดจาก README และหน้า Features, Tools และ Security ในเอกสารทางการ">
    <svg viewBox="0 0 720 314" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="แผนภาพ Hermes Agent ด้านซ้ายเป็นช่องทางคุย Telegram Discord Slack WhatsApp Signal และ CLI ส่งเข้า gateway ที่ตรวจสิทธิ์ผู้ส่ง แล้วเข้าตัว Hermes Agent ที่ใช้โมเดลเจ้าไหนก็ได้และมีเครื่องมือ terminal ไฟล์ เบราว์เซอร์ เว็บ cronjob และ delegate_task ด้านขวาเป็นที่รันคำสั่ง ได้แก่ local ที่ไม่มีกำแพงกั้น docker ssh และ cloud sandbox ด้านล่างเป็นที่เก็บข้อมูลในโฟลเดอร์ .hermes มีความจำ skill และประวัติแชต" style="font-family:'Sarabun',sans-serif">
      <defs>
        <marker id="hm-a1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 z" fill="#9aa7bd"/>
        </marker>
      </defs>
      <text x="72" y="26" font-size="12" font-weight="700" fill="#7cc4ff" text-anchor="middle">ช่องทางคุย</text>
      <g font-size="11.5" fill="#cfe6ff" text-anchor="middle">
        <rect x="12" y="38" width="120" height="28" rx="8" fill="#18263a" stroke="#3b5b86"/><text x="72" y="57">Telegram</text>
        <rect x="12" y="72" width="120" height="28" rx="8" fill="#18263a" stroke="#3b5b86"/><text x="72" y="91">Discord</text>
        <rect x="12" y="106" width="120" height="28" rx="8" fill="#18263a" stroke="#3b5b86"/><text x="72" y="125">Slack</text>
        <rect x="12" y="140" width="120" height="28" rx="8" fill="#18263a" stroke="#3b5b86"/><text x="72" y="159">WhatsApp</text>
        <rect x="12" y="174" width="120" height="28" rx="8" fill="#18263a" stroke="#3b5b86"/><text x="72" y="193">Signal</text>
        <rect x="12" y="208" width="120" height="28" rx="8" fill="#18263a" stroke="#3b5b86"/><text x="72" y="227">CLI / TUI</text>
      </g>
      <g stroke="#9aa7bd" stroke-width="1.3" fill="none">
        <path d="M134 52 L158 120" marker-end="url(#hm-a1)"/>
        <path d="M134 137 L158 137"/>
        <path d="M134 222 L158 154" marker-end="url(#hm-a1)"/>
      </g>
      <rect x="160" y="108" width="112" height="58" rx="10" fill="#2b2410" stroke="#e0b400"/>
      <text x="216" y="132" font-size="12.5" font-weight="700" fill="#f0d060" text-anchor="middle">gateway</text>
      <text x="216" y="151" font-size="10.5" fill="#d8b862" text-anchor="middle">ตรวจสิทธิ์ผู้ส่ง</text>
      <line x1="274" y1="137" x2="296" y2="137" stroke="#9aa7bd" stroke-width="1.4" marker-end="url(#hm-a1)"/>
      <rect x="300" y="60" width="200" height="156" rx="12" fill="#12301f" stroke="#2f9e5c" stroke-width="1.6"/>
      <text x="400" y="88" font-size="15" font-weight="700" fill="#4ade80" text-anchor="middle">Hermes Agent</text>
      <text x="400" y="108" font-size="11" fill="#e7ecf6" text-anchor="middle">โมเดลเจ้าไหนก็ได้</text>
      <g font-size="10.5" fill="#9aa7bd" text-anchor="middle">
        <text x="400" y="134">terminal, ไฟล์, เบราว์เซอร์, เว็บ</text>
        <text x="400" y="152">memory, skills, session_search</text>
        <text x="400" y="170">cronjob (งานตามเวลา)</text>
        <text x="400" y="188">delegate_task (ส่งงานให้ subagent)</text>
      </g>
      <line x1="502" y1="137" x2="526" y2="137" stroke="#9aa7bd" stroke-width="1.4" marker-end="url(#hm-a1)"/>
      <text x="619" y="26" font-size="12" font-weight="700" fill="#f2f5fb" text-anchor="middle">ที่รันคำสั่ง (backend)</text>
      <g font-size="11" text-anchor="middle">
        <rect x="530" y="40" width="178" height="38" rx="8" fill="#2a1414" stroke="#d64545"/>
        <text x="619" y="57" fill="#f08b8b" font-weight="700">local (ค่าเริ่มต้น)</text>
        <text x="619" y="71" font-size="9.5" fill="#e7b9b9">รันบนเครื่องจริง ไม่มีกำแพง</text>
        <rect x="530" y="86" width="178" height="30" rx="8" fill="#1c2536" stroke="#3a4666"/>
        <text x="619" y="106" fill="#e7ecf6">docker</text>
        <rect x="530" y="124" width="178" height="30" rx="8" fill="#1c2536" stroke="#3a4666"/>
        <text x="619" y="144" fill="#e7ecf6">ssh</text>
        <rect x="530" y="162" width="178" height="38" rx="8" fill="#1c2536" stroke="#3a4666"/>
        <text x="619" y="179" fill="#e7ecf6">singularity, modal</text>
        <text x="619" y="193" font-size="9.5" fill="#9aa7bd">daytona, vercel sandbox</text>
      </g>
      <line x1="400" y1="218" x2="400" y2="234" stroke="#9aa7bd" stroke-width="1.3" stroke-dasharray="3 3"/>
      <rect x="290" y="238" width="220" height="48" rx="10" fill="#0f1524" stroke="#3a4666"/>
      <text x="400" y="258" font-size="12" font-weight="700" fill="#f2f5fb" text-anchor="middle">โฟลเดอร์ .hermes</text>
      <text x="400" y="276" font-size="10.5" fill="#9aa7bd" text-anchor="middle">memories, skills, state.db, .env</text>
    </svg>
  </ZoomableDiagram>

  <p>
    <strong>gateway</strong> อ่านว่า <strong>"เกตเวย์"</strong> แปลว่า "ประตูทางผ่าน" ในที่นี้คือ process ตัวเดียวที่ต่อกับทุกแอปแชต รับข้อความเข้ามา ตรวจว่าคนส่งมีสิทธิ์ไหม แล้วส่งต่อให้ตัว agent ส่วน <strong>backend</strong> คือที่ที่คำสั่ง terminal ของ agent ไปรันจริง ค่าเริ่มต้นคือ local หรือเครื่องที่ Hermes ลงอยู่นั่นเอง ซึ่งเป็นตัวเดียวในรายการที่ไม่มีกำแพงกั้นอะไรเลย
  </p>

  <hr class="divider-solid" />

  <h2>ลงให้ปลอดภัยตั้งแต่วันแรก</h2>
  <p>
    เอกสารแนะนำให้คนใช้ macOS กับ Windows ลงผ่านแอปเดสก์ท็อปจากหน้าเว็บ ซึ่งจะได้ทั้ง CLI และแอปมาพร้อมกัน ถ้าอยากได้แค่ CLI ใช้คำสั่งข้างล่าง Windows รองรับแบบ native ไม่ต้องผ่าน WSL2 (แต่ถ้าใช้ WSL2 อยู่แล้วก็ใช้คำสั่งของ Linux ได้)
  </p>
  <CodeBlock code={installCode} lang="bash" title="ติดตั้ง CLI" />
  <p>
    README เตือนไว้ด้วยว่าบน Windows โปรแกรมกันไวรัสอาจจับ <code>uv.exe</code> ที่มากับ Hermes ว่าเป็นมัลแวร์ เขาบอกว่าเป็นการแจ้งเตือนผิด และอธิบายวิธีตรวจว่าไฟล์เป็นของแท้ไว้ใน README ให้ตรวจตามนั้นก่อน อย่ารีบสั่งยกเว้นทั้งโฟลเดอร์
  </p>

  <h3>ก่อนคุยครั้งแรก ตั้งสี่ค่านี้</h3>
  <p>
    ค่าเริ่มต้นของ Hermes ตั้งมาให้ลื่น ไม่ได้ตั้งมาให้ระวัง มีสี่ค่าที่ควรเปลี่ยนก่อนเริ่มใช้งานจริง โดยเฉพาะข้อแรก
  </p>
  <CodeBlock code={safeConfig} lang="yaml" title="~/.hermes/config.yaml" />
  <div class="card">
    <ul>
      <li><strong>adopt_external_logins</strong> ค่าเริ่มต้นเป็น <code>true</code> แปลว่า Hermes จะยืม login ของ Claude Code และ Codex CLI ที่อยู่ในเครื่องไปใช้เอง เอกสารด้านความปลอดภัยของเขาเตือนเองว่า token ของสองโปรแกรมนี้หมุนเปลี่ยนตลอด ถ้าใช้ร่วมกันอาจทำให้ฝั่งใดฝั่งหนึ่ง login หลุด ใครใช้ Claude Code ทำงานทุกวันควรปิดข้อนี้ก่อนรันครั้งแรก</li>
      <li><strong>approvals.mode</strong> ค่าเริ่มต้นคือ <code>smart</code> ใช้โมเดลอีกตัวช่วยตัดสินว่าคำสั่งไหนเสี่ยง ตั้งเป็น <code>manual</code> ช่วงแรกเพื่อให้ถามทุกครั้ง พอเห็นนิสัยของมันแล้วค่อยผ่อน</li>
      <li><strong>skills.write_approval</strong> ค่าเริ่มต้นเป็น <code>false</code> agent เขียนและแก้ skill ของตัวเองได้ทันที เปิดข้อนี้แล้วทุกการเขียนจะรอเราดูก่อน</li>
      <li><strong>memory.write_approval</strong> แบบเดียวกัน สำหรับความจำ</li>
    </ul>
  </div>

  <h3>รันครั้งแรก</h3>
  <CodeBlock code={firstRun} lang="bash" title="ในเทอร์มินัล" />
  <p>
    ตอน <code>hermes setup</code> จะมีให้เลือกสามแบบ แบบ Quick Setup ผูกกับ Nous Portal ซึ่งเป็นบริการเสียเงินรายเดือนของ Nous (มีแบบฟรีด้วย) แบบ Full Setup ให้ใส่ key ของแต่ละเจ้าเอง และแบบ Blank Slate ที่เปิดแค่เครื่องมือไฟล์กับ terminal ปิดความจำอัตโนมัติไว้ด้วย แบบสุดท้ายเหมาะกับการเรียนรู้ เพราะเราจะเห็นว่าความสามารถแต่ละอย่างที่เปิดเพิ่มทำอะไร ข้อจำกัดหนึ่งที่ควรรู้คือโมเดลต้องมี context อย่างน้อย 64,000 token ถ้าน้อยกว่านี้ Hermes จะไม่ยอมเริ่ม คนที่อยากรันโมเดลในเครื่องเองต้องตั้งค่านี้ให้ถึง
  </p>

  <hr class="divider-solid" />

  <h2>skill ของ Hermes คือ SKILL.md แบบเดียวกับที่เรารู้จัก</h2>
  <p>
    skill ของ Hermes เป็นโฟลเดอร์ที่มี <code>SKILL.md</code> หัวไฟล์เป็น YAML มี <code>name</code> กับ <code>description</code> ตามด้วยเนื้อหา Markdown และมีโฟลเดอร์ <code>references/</code>, <code>scripts/</code>, <code>templates/</code> แนบได้ หน้าตาเดียวกับ skill ของ Claude Code และ test-t3-app ในบทก่อน README บอกว่ารองรับมาตรฐานเปิดของ agentskills.io
  </p>
  <p>
    การโหลดก็ใช้หลักเดียวกับที่ test-t3-app ใช้ คือเปิดเผยทีละชั้น agent เห็นแค่ชื่อกับคำอธิบายของทุก skill ก่อน (<code>skills_list</code>) เลือกตัวที่ตรงงานแล้วค่อยโหลดเนื้อหาเต็ม (<code>skill_view</code>) และโหลดไฟล์ใน references ทีละไฟล์เมื่อต้องใช้
  </p>
  <p>
    ที่เก็บหลักอยู่ที่ <code>~/.hermes/skills/</code> แต่สั่งให้มันไปอ่านโฟลเดอร์อื่นเพิ่มได้ เช่น <code>~/.agents/skills/</code> ซึ่งเป็นที่เดียวกับที่ T3 Code และ Codex อ่าน ส่วน skill ของโปรเจกต์ใน <code>.hermes/skills/</code> หรือ <code>.agents/skills/</code> ของ repo จะโหลดหลังจากเราบอกว่าไว้ใจ repo นั้นแล้วเท่านั้น
  </p>
  <CodeBlock code={skillsConfig} lang="yaml" title="~/.hermes/config.yaml" />
  <div class="callout callout-tip">
    <p class="callout-label">skill จากสองบทก่อนใช้กับ Hermes ได้ไหม</p>
    <p>
      รูปแบบไฟล์ใช้ได้ แต่เนื้อหาอาจใช้ไม่ได้ skill ที่ดีมักเรียกชื่อเครื่องมือของ harness ที่มันเขียนให้ test-t3-app เรียก <code>preview_*</code> ของ T3 ส่วน pstack ฉบับ Claude Code เรียกเครื่องมือของ Claude อย่าง <code>Agent</code> กับ <code>AskUserQuestion</code> ใน Hermes เครื่องมือชื่อไม่ตรงกัน (เช่น ส่งงานให้ subagent ใช้ <code>delegate_task</code> ส่วนเบราว์เซอร์ใช้ <code>browser_navigate</code>) skill ที่เรียกเครื่องมือเฉพาะจึงต้องแปลงชื่อก่อน แบบเดียวกับที่ p3-stack แปลง pstack ให้ T3 skill ที่เป็นขั้นตอนล้วน ๆ ไม่ผูกกับเครื่องมือ น่าจะใช้ได้เลย ข้อนี้ยังไม่ได้ลองจริง
    </p>
  </div>

  <h3>วงจรเรียนรู้: agent เขียน skill ให้ตัวเอง</h3>
  <p>
    จุดที่ Hermes ต่างจากของในสองบทก่อนคือมันเขียน skill เองได้ เอกสารเรียก skill ว่า "ความจำเชิงขั้นตอน" (<i>procedural memory</i>) เมื่อ agent หาวิธีทำงานหลายขั้นตอนสำเร็จ หรือถูกเราแก้ มันจะบันทึกวิธีนั้นเป็น skill ผ่านเครื่องมือ <code>skill_manage</code> และหลังจบแต่ละเทิร์นยังมีการทบทวนเบื้องหลัง (background review) ที่อาจเพิ่มความจำหรือแก้ skill ด้วย
  </p>

