  <script>
    document.addEventListener('astro:page-load', () => {
      const root = document.querySelector<HTMLElement>('[data-sizer]');
      if (!root) return;

      const get = (name: string) => root.querySelector<HTMLInputElement>(`[data-in="${name}"]`);
      const premiumEl = get('premium');
      const contractsEl = get('contracts');
      const feeEl = get('fee');
      const pctEl = get('pct');
      const portEl = get('port');
      const rateEl = get('rate');
      const strikeEl = get('strike');
      if (!premiumEl || !contractsEl || !feeEl || !pctEl || !portEl || !rateEl || !strikeEl) return;

      const usd0 = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 });
      const usd2 = new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const thb0 = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 });
      const baht = (usd: number, rate: number) => `฿${thb0.format(usd * rate)}`;

      const setLbl = (name: string, text: string) => {
        const el = root.querySelector<HTMLElement>(`[data-lbl="${name}"]`);
        if (el) el.textContent = text;
      };
      const setOut = (name: string, text: string) => {
        const el = root.querySelector<HTMLElement>(`[data-out="${name}"]`);
        if (el) el.textContent = text;
      };

      const answer = root.querySelector<HTMLElement>('[data-answer]');
      const ansLabel = root.querySelector<HTMLElement>('[data-answer-label]');
      const ansValue = root.querySelector<HTMLElement>('[data-answer-value]');
      const ansSub = root.querySelector<HTMLElement>('[data-answer-sub]');

      let mode: 'port' | 'pct' = 'port';

      const recompute = () => {
        const premium = Number(premiumEl.value);
        const contracts = Number(contractsEl.value);
        const fee = Number(feeEl.value);
        const rate = Number(rateEl.value);
        const strike = Number(strikeEl.value);
        const premiumTotal = premium * 100 * contracts;
        const feeTotal = fee * contracts;
        const risk = premiumTotal + feeTotal;
        const exercise = strike * 100 * contracts;

        setLbl('premium', `$${premium}`);
        setLbl('contracts', String(contracts));
        setLbl('fee', `$${usd2.format(fee)}`);
        setLbl('strike', `$${strike}`);
        setLbl('rate', `฿${usd2.format(rate)}`);
        setOut('premium', `$${usd2.format(premiumTotal)}`);
        setOut('fee', `$${usd2.format(feeTotal)}`);
        setOut('risk', `$${usd2.format(risk)}`);
        setOut('riskthb', baht(risk, rate));
        setOut('exercise', `$${usd0.format(exercise)}`);
        setOut('exercisethb', baht(exercise, rate));

        if (!answer || !ansLabel || !ansValue || !ansSub) return;

        if (mode === 'port') {
          const pct = Number(pctEl.value);
          setLbl('pct', `${pct}%`);
          const need = risk / (pct / 100);
          answer.className = 'sizer-answer';
          ansLabel.textContent = 'พอร์ตที่ต้องมีอย่างน้อย ≈';
          ansValue.textContent = `$${usd0.format(need)}`;
          ansSub.textContent = `${baht(need, rate)} เพื่อให้ไม้นี้เสี่ยงแค่ ${pct}% ของพอร์ตทั้งก้อน`;
        } else {
          const port = Number(portEl.value);
          setLbl('port', `$${usd0.format(port)} (${baht(port, rate)})`);
          const actual = (risk / port) * 100;
          const shown = Math.round(actual * 10) / 10;
          const tier = shown <= 2 ? 'ok' : shown <= 5 ? 'warn' : 'danger';
          const verdict = tier === 'ok'
            ? 'อยู่ในโซนคอนเซอร์เวทีฟ (เสี่ยง 1 ถึง 2%)'
            : tier === 'warn'
              ? 'เริ่มหนักมือ (เกิน 2% แล้ว)'
              : 'เกินตัว ไม้เดียวเสี่ยงเกิน 5% ของพอร์ต';
          answer.className = tier === 'ok' ? 'sizer-answer' : `sizer-answer tier-${tier}`;
          ansLabel.textContent = 'ไม้นี้คิดเป็น';
          ansValue.textContent = `${shown.toFixed(1)}%`;
          ansSub.textContent = verdict;
        }
      };

      [premiumEl, contractsEl, feeEl, pctEl, portEl, rateEl, strikeEl].forEach((el) => {
        el.addEventListener('input', recompute);
      });

      const modeBtns = root.querySelectorAll<HTMLButtonElement>('.sizer-mode');
      modeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const m = btn.dataset.mode;
          if (m !== 'port' && m !== 'pct') return;
          mode = m;
          modeBtns.forEach((b) => {
            const on = b === btn;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-selected', String(on));
          });
          root.querySelectorAll<HTMLElement>('[data-when]').forEach((el) => {
            el.hidden = el.dataset.when !== mode;
          });
          recompute();
        });
      });

      recompute();
    });
  </script>

  <hr class="divider-solid" />

  <h2>อีกฝั่งของโต๊ะ: คนขาย Option</h2>
  <p>
    ที่ผ่านมาเราพูดถึงฝั่งซื้ออย่างเดียว แต่ทุกใบจองต้องมีคนออกให้ คนซื้อจ่าย premium เพื่อแลกกับสิทธิ์ แปลว่า <strong>คนขายคือคนที่ได้ premium ไปเลยตั้งแต่วันแรก</strong>
  </p>
  <p>
    ฟังดูดี แต่ของแถมคือภาระ และตรงนี้คือจุดที่คนงงกันมากที่สุดทั้งบท ผมขอไล่ทีละขั้นช้า ๆ
  </p>
  <div class="card">
    <p><strong>ขั้นที่ 1</strong> ขายสิทธิ์แปลว่าเราเป็น <strong>คนออกใบจอง</strong> ไม่ใช่คนถือใบจอง เราคือฝ่ายที่รับเงินค่าใบจองไปแล้ว</p>
    <p><strong>ขั้นที่ 2</strong> พอเราเป็นคนออกใบจอง เราก็เป็นฝ่ายตั้งรับล้วน ๆ <strong>คนตัดสินใจว่าจะใช้สิทธิ์หรือไม่คืออีกฝ่าย</strong> ไม่ใช่เรา เขาจะใช้ก็ต่อเมื่อมันได้เปรียบเขา ซึ่งแปลว่าเสียเปรียบเราพอดี</p>
    <p><strong>ขั้นที่ 3</strong> ถ้าเราขายสิทธิ์ <strong>ซื้อ</strong> (ขาย Call) แล้วโดนใช้สิทธิ์ หน้าที่ของเราคือ <strong>ส่งมอบหุ้น</strong> ให้เขาที่ราคา strike</p>
    <p><strong>ขั้นที่ 4</strong> ถ้าเราขายสิทธิ์ <strong>ขาย</strong> (ขาย Put) แล้วโดนใช้สิทธิ์ หน้าที่ของเราคือ <strong>รับซื้อหุ้น</strong> ของเขาที่ราคา strike</p>
  </div>
  <p>
    ขั้นที่ 4 คือประโยคที่อ่านแล้วสมองสะดุดกันทุกคน "ขายสิทธิ์การขาย" ทำไมกลายเป็นเราต้องซื้อ ลองอ่านช้า ๆ อีกรอบครับ สิทธิ์ที่เราขายให้เขาไปคือสิทธิ์ที่เขาจะ <i>ขาย</i> หุ้น พอเขาใช้สิทธิ์นั้น เขาก็ยัดหุ้นมาให้เรา แล้วคนที่ต้องอยู่ปลายทางรับของไว้ก็คือเรา การขายสิทธิ์ขายจึงเท่ากับการรับปากล่วงหน้าว่า "ถ้าราคาลงมาถึงจุดนี้ ผมรับซื้อเอง"
  </p>
  <div class="callout callout-note">
    <p class="callout-label">แกะคำศัพท์</p>
    <p>
      <strong>Long</strong> และ <strong>short</strong> อ่านว่า <strong>"ลอง"</strong> และ <strong>"ช็อต"</strong> เป็นคำที่บอกว่าเรายืนอยู่ฝั่งไหนของสัญญา <strong>long คือฝั่งที่ถือของไว้</strong> ซื้อมาก่อนแล้วรอราคาขึ้น ส่วน <strong>short คือฝั่งที่ขายออกไปก่อน</strong> แล้วค่อยไปหาของมาคืนทีหลัง เวลาเจอคำว่า long call ก็คือคนซื้อ Call ส่วน short call คือคนขาย Call เหมือนกันกับ long put และ short put
    </p>
    <p>
      <strong>Exercise</strong> อ่านว่า <strong>"เอ็กเซอร์ไซซ์"</strong> แปลว่า <strong>"การใช้สิทธิ์"</strong> คำเดียวกับที่แปลว่าออกกำลังกายหรือแบบฝึกหัดนั่นแหละ รากของมันคือ "การเอาสิ่งที่มีอยู่ออกมาใช้งานจริง" กล้ามเนื้อเอามาใช้ก็เรียก exercise สิทธิ์ในสัญญาเอามาใช้ก็เรียก exercise เหมือนกัน
    </p>
    <p>
      <strong>Assignment</strong> อ่านว่า <strong>"แอสไซน์เมนต์"</strong> แปลว่า <strong>"การถูกมอบหมายให้ทำตามสัญญา"</strong> มาจาก <i>assign</i> ที่แปลว่ามอบหมายหรือจับคู่ให้ พอมีคนใช้สิทธิ์ สำนักหักบัญชีจะสุ่มจับคู่ว่าคนขายรายไหนต้องเป็นคนทำตามสัญญาใบนั้น คนที่ถูกจับได้ก็คือคนที่โดน assignment ที่มันแปลว่า "การบ้าน" ในชีวิตประจำวันได้ด้วย ก็เพราะเป็นการมอบหมายงานเหมือนกัน คนละบริบทแต่รากเดียวกัน
    </p>
  </div>
  <p>
    ลองคิดตามฉากที่อาจารย์ยกไว้ เราขายสิทธิ์ซื้อหุ้นที่ 200 โดยที่มือเราไม่มีหุ้นเลย พอถึงเวลาหุ้นดันวิ่งไป 300 หรือ 400 เราต้องไปไล่ซื้อของในตลาดที่ 400 มาส่งมอบให้เขาที่ราคา 200 ยิ่งหุ้นวิ่งขึ้นไม่หยุด ความเสียหายก็ยิ่งไม่มีเพดาน
  </p>

  <ZoomableDiagram caption="ขาย Call ทั้งที่ไม่มีหุ้นในมือ กำไรมีเพดานเตี้ยแค่ค่า premium ส่วนขาดทุนวิ่งลงได้ไม่จบ นี่คือเหตุผลที่โบรกส่วนใหญ่ไม่ยอมให้มือใหม่ทำ (diagram วาดประกอบโดยผู้เขียน)">
