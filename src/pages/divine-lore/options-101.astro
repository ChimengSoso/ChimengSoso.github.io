      <text x="520" y="70" font-size="10.5" fill="#8a97ad" text-anchor="middle">% คิดจากฐาน = ค่าสัญญา 5</text>

      <text x="70" y="102" font-size="12" fill="#c3cbdc">หุ้นไป 300</text>
      <rect x="150" y="82" width="160" height="30" rx="8" fill="#173626" stroke="#2f9e5c"/>
      <text x="230" y="102" font-size="12" fill="#4ade80" text-anchor="middle">+200%</text>
      <rect x="380" y="82" width="280" height="30" rx="8" fill="#173626" stroke="#4ade80" stroke-width="1.8"/>
      <text x="520" y="102" font-size="12.5" font-weight="700" fill="#4ade80" text-anchor="middle">+2,900%</text>

      <text x="70" y="164" font-size="12" fill="#c3cbdc">หุ้นอยู่ที่ 100</text>
