      <text x="545" y="90" font-size="11.5" fill="#4ade80" text-anchor="middle">ได้มูลค่าที่ควรจะเป็น</text>

      <text x="60" y="162" font-size="12.5" font-weight="700" fill="#e0b400">Reverse DCF</text>
      <rect x="430" y="174" width="230" height="52" rx="10" fill="#1c2536" stroke="#3a4666"/>
      <text x="545" y="196" font-size="11.5" fill="#c3cbdc" text-anchor="middle">ใส่ราคาตลาดวันนี้</text>
      <text x="545" y="214" font-size="11" fill="#8a97ad" text-anchor="middle">EV 37B</text>
      <line x1="420" y1="200" x2="300" y2="200" stroke="#e0b400" stroke-width="2" marker-end="url(#rv-arrow-g)"/>
