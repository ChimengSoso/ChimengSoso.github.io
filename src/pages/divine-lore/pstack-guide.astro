<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-recipes]').forEach((root) => {
      if (root.dataset.wired) return;
      root.dataset.wired = '1';
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.rc-tab'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('.rc-panel'));
      const select = (id: string) => {
        tabs.forEach((t) => t.setAttribute('aria-selected', t.dataset.recipe === id ? 'true' : 'false'));
        panels.forEach((p) => { p.hidden = p.dataset.panel !== id; });
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t.dataset.recipe ?? ''));
        t.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          e.preventDefault();
          const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
          next.focus();
          select(next.dataset.recipe ?? '');
        });
      });
    });
  });
</script>
