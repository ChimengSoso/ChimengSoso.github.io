---
import DivineLoreLayout from '../../layouts/DivineLoreLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { divineLoreEntries } from '../../data/divineLore';

const entry = divineLoreEntries.find((e) => e.href === 'pstack-guide/');
if (!entry) throw new Error('pstack-guide/ ไม่มีใน divineLore.ts');

const installCode = `/plugin marketplace add michael-denyer/pstack-claude
/plugin install pstack@pstack-claude`;

const setupCode = `/pstack:setup-pstack`;

const firstPrompt = `/pstack:poteto-mode ฟิลเตอร์ค้นหาเด้งกลับเป็นค่าเริ่มต้นทุกครั้งที่กดเปลี่ยนหน้า ช่วยแก้ให้หน่อย`;

const sheetCode = `# ~/.claude/pstack-models.md (setup-pstack เขียนไฟล์นี้ให้)
arena runners: opus, sonnet
interrogate reviewers: opus, sonnet
session hook: on`;

const verifyCreate = `/pstack:create-verification-skill`;

const verifyPrompt = `/pstack:poteto-mode เพิ่มปุ่ม export รายการเป็น CSV ในหน้ารายงาน
ใช้ /verify ยืนยันว่ากดแล้วได้ไฟล์ที่เปิดอ่านได้จริง แนบภาพหน้าจอเป็นหลักฐาน`;

const cliCode = `# เช็กก่อนว่าแอปที่รันอยู่พร้อมให้ขับไหม
node .claude/skills/verify/control-app.mjs doctor

# เปิดหน้าใหม่ แล้วพิมพ์คำสั่งลงช่องค้นหา
node .claude/skills/verify/control-app.mjs new-session
node .claude/skills/verify/control-app.mjs type "#search" "รายงานเดือนกันยา"

# กดคีย์ลัด แล้วรอให้หน้าจอนิ่ง
node .claude/skills/verify/control-app.mjs press "Meta+KeyK"
node .claude/skills/verify/control-app.mjs wait-settle

# ดึงโครงหน้าจอแบบที่ screen reader เห็น (อ่านง่ายกว่าภาพสำหรับ agent)
node .claude/skills/verify/control-app.mjs snapshot

# เก็บภาพไว้เป็นหลักฐาน
node .claude/skills/verify/control-app.mjs screenshot proof/after.png`;

const featureMapCode = `# Preferences

หน้าต่างตั้งค่าแบบเต็มจอ กับแท็บย่อยทั้งหมด

## Sub-features
- settings-overlay: เปิดจากรูปเฟือง หรือกด Cmd/Ctrl+,
- settings-nav: แท็บด้านซ้าย (General, Appearance, Models, ...)
- theme-picker: ตัวเลือกธีมในแท็บ Appearance

## How to get to it (user POV)
คลิกรูปเฟืองข้างรูปโปรไฟล์ หรือกด Cmd/Ctrl+, แล้วเลือกแท็บด้านซ้าย
กด Escape เพื่อปิด

## Driving it with control-app
node .claude/skills/verify/control-app.mjs press "Meta+Comma"
node .claude/skills/verify/control-app.mjs snapshot
node .claude/skills/verify/control-app.mjs press "Escape"

## Gotchas
- ปิดหน้าตั้งค่ากลางคันแล้ว focus อาจหลุด สั่ง new-session เพื่อกู้
- บางแท็บเห็นเฉพาะบางบัญชี ถ้าข้ามต้องบอกเหตุผล`;

const routineCode = `ทุกเช้า 9 โมง ให้รัน /pstack:maintain-verification-skill
