---
import '../../styles/fonts.css';
import { footerSocialLinks } from '../../data/socialLinks';

const year = new Date().getFullYear();
const title = 'หนีหนู: เกมกระแสเงินสดฉบับภาษาไทย | ChimengSoso';
const description =
  'เกมกระดานการเงินเล่นฟรีบนเว็บ สลับไทย/อังกฤษได้ เลือกอาชีพ สะสมสินทรัพย์ที่ให้เงินไหลเข้าทุกเดือน แล้วหนีออกจากวงล้อเงินเดือน';
---
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0f1520" />
  <title>{title}</title>
  <link rel="canonical" href={Astro.url.href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
  <link rel="icon" type="image/jpeg" href="/img.jpg" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ChimengSoso" />
  <meta property="og:title" content="หนีหนู: เกมกระแสเงินสดฉบับภาษาไทย" />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={Astro.url.href} />
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "9e5cb1eb46564e6ea4b2c19ff35ad2ec", "spa": true}'></script>

  <style is:global>
    :root{
      --nn-bg:#0f1520;
      --nn-panel:#19212f;
      --nn-panel-2:#131a26;
      --nn-border:#2a3446;
      --nn-border-soft:#212a3a;
      --nn-ink:#e8edf6;
      --nn-muted:#93a1b8;
      --nn-green:#35a86a;
      --nn-green-bright:#5fd694;
      --nn-gold:#e2b23c;
      --nn-red:#d9534f;
      --nn-red-soft:#f0918d;
      --nn-blue:#4d72a9;
      --nn-violet:#8b7fd4;
    }
    *{margin:0;padding:0;box-sizing:border-box;}
    html{font-size:clamp(15px, 0.95rem + 0.22vw, 19px);}
    html,body{
      font-family:"Sarabun", system-ui, sans-serif;
      background:var(--nn-bg);
      color:var(--nn-ink);
    }
    body{min-height:100vh;}
    button{font:inherit;color:inherit;background:none;border:none;cursor:pointer;}
    input{font:inherit;}

    .nn{
      max-width:76rem;
      margin:0 auto;
      padding:1.5rem 1rem 3rem;
    }

    /* ------------------------------------------------------------- header */
    /* The back link gets its own line so the title starts at the container's
       real left edge, in line with everything below it. */
    .nn-head{margin-bottom:1.5rem;}
    .nn-headrow{
      display:flex;
      flex-wrap:wrap;
      align-items:flex-start;
      justify-content:space-between;
      gap:0.75rem 1.25rem;
    }
    .nn-back{
      color:var(--nn-muted);
      text-decoration:none;
      font-size:0.8rem;
      display:flex;
      width:fit-content;
      align-items:center;
      gap:0.35rem;
      margin-bottom:1rem;
      transition:color .15s;
    }
    .nn-back:hover{color:var(--nn-green-bright);}
    .nn-back svg{flex-shrink:0;transition:transform .15s ease;}
    .nn-back:hover svg{transform:translateX(-3px);}
    .nn-brand{flex:1 1 18rem;min-width:0;}
    .nn-brand h1{
      font-size:1.5rem;
      letter-spacing:-.3px;
      color:#fff;
      line-height:1.25;
    }
    .nn-sub{font-size:0.8rem;color:var(--nn-muted);margin-top:0.15rem;}
    .nn-tools{display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;}

    .nn-btn{
      border:1px solid var(--nn-border);
      background:var(--nn-panel);
      border-radius:10px;
      padding:0.42rem 0.9rem;
      font-size:0.82rem;
      transition:border-color .15s, background .15s, transform .1s;
    }
    .nn-btn:hover:not(:disabled){border-color:var(--nn-green);background:#202b3c;}
    .nn-btn:active:not(:disabled){transform:translateY(1px);}
    .nn-btn:disabled{opacity:.4;cursor:not-allowed;}
    .nn-btn-go{
      background:var(--nn-green);
      border-color:var(--nn-green);
      color:#06210f;
      font-weight:700;
      padding:0.6rem 1.6rem;
      font-size:0.92rem;
    }
    .nn-btn-go:hover:not(:disabled){background:var(--nn-green-bright);border-color:var(--nn-green-bright);}
    .nn-btn-gold{border-color:var(--nn-gold);color:var(--nn-gold);}
    .nn-btn-gold:hover:not(:disabled){background:rgba(226,178,60,.12);border-color:var(--nn-gold);}
    .nn-btn-quiet{color:var(--nn-muted);}
    .nn-btn-danger{border-color:var(--nn-red);color:var(--nn-red-soft);}
    .nn-btn-danger:hover:not(:disabled){background:rgba(217,83,79,.12);}

    .nn-lang{display:inline-flex;border:1px solid var(--nn-border);border-radius:10px;overflow:hidden;}
    .nn-lang button{padding:0.42rem 0.72rem;font-size:0.78rem;color:var(--nn-muted);transition:background .15s,color .15s;}
    .nn-lang button[aria-pressed="true"]{background:var(--nn-green);color:#06210f;font-weight:700;}

    /* -------------------------------------------------------------- setup */
    .nn-setup h2{
      font-size:0.95rem;
      color:var(--nn-green-bright);
      border-left:3px solid var(--nn-green);
      padding-left:0.7rem;
      margin:2rem 0 0.5rem;
      text-transform:uppercase;
      letter-spacing:.5px;
    }
    .nn-setup h2:first-of-type{margin-top:0.5rem;}
    .nn-hint{font-size:0.83rem;color:var(--nn-muted);margin-bottom:1rem;line-height:1.7;}
    .nn-resume{margin-bottom:1rem;}
    .nn-profs{display:grid;grid-template-columns:repeat(auto-fill,minmax(15rem,1fr));gap:0.75rem;}
    .nn-dreams{display:grid;grid-template-columns:repeat(auto-fill,minmax(13rem,1fr));gap:0.75rem;}
    .nn-pick{
      text-align:left;
      width:100%;
      background:var(--nn-panel);
      border:1px solid var(--nn-border);
      border-radius:14px;
      padding:0.9rem 1rem;
      transition:border-color .15s, background .15s;
    }
    .nn-pick:hover{border-color:var(--nn-green);}
    .nn-pick[aria-pressed="true"]{border-color:var(--nn-green);background:#1c2a25;box-shadow:0 0 0 1px var(--nn-green) inset;}
    .nn-pick h3{font-size:0.95rem;color:#fff;margin-bottom:0.2rem;}
    .nn-pick p{font-size:0.78rem;color:var(--nn-muted);line-height:1.6;}
    .nn-pick dl{display:grid;grid-template-columns:auto 1fr;gap:0.1rem 0.6rem;margin-top:0.6rem;font-size:0.76rem;}
    .nn-pick dt{color:var(--nn-muted);}
    .nn-pick dd{text-align:right;font-variant-numeric:tabular-nums;}
    .nn-pick dd.pos{color:var(--nn-green-bright);}
    .nn-pick dd.warn{color:var(--nn-gold);}
    /* Eight jobs plus eight dreams push the start button roughly two screens
       below the fold on a phone, so it rides along at the bottom instead. */
    .nn-startrow{
      position:sticky;
      bottom:0;
      z-index:20;
      margin:1.75rem -1rem 0;
      padding:0.85rem 1rem calc(0.85rem + env(safe-area-inset-bottom, 0px));
      display:flex;
      align-items:center;
      justify-content:center;
      gap:0.9rem;
      flex-wrap:wrap;
      background:linear-gradient(to top, var(--nn-bg) 55%, rgba(15,21,32,0));
    }
    .nn-startpick{
      font-size:0.8rem;
      color:var(--nn-muted);
      text-align:right;
      min-width:0;
    }
    .nn-startpick b{color:var(--nn-ink);font-weight:600;}
    @media (max-width:560px){
      .nn-startrow{margin-left:-0.6rem;margin-right:-0.6rem;padding-left:0.6rem;padding-right:0.6rem;}
      .nn-startpick{font-size:0.74rem;width:100%;text-align:center;order:-1;}
    }

    /* --------------------------------------------------------------- game */
    .nn-grid{
      display:grid;
      grid-template-columns:minmax(0,19rem) minmax(0,1fr) minmax(0,17rem);
      gap:1rem;
      align-items:start;
    }
    @media (max-width:1080px){
      .nn-grid{grid-template-columns:minmax(0,1fr) minmax(0,17rem);}
      .nn-play{order:-1;grid-column:1 / -1;}
    }
    @media (max-width:760px){
      .nn-grid{grid-template-columns:minmax(0,1fr);}
      .nn-play{grid-column:auto;}
    }
    .nn-panel{
      background:var(--nn-panel);
      border:1px solid var(--nn-border);
      border-radius:16px;
      padding:1rem 1.1rem;
    }
    .nn-panel h2{
      font-family:"JetBrains Mono", monospace;
      font-size:0.68rem;
      text-transform:uppercase;
      letter-spacing:.6px;
      color:var(--nn-muted);
      margin-bottom:0.7rem;
    }

    /* statement */
    .nn-rows{display:grid;grid-template-columns:1fr auto;gap:0.22rem 0.75rem;font-size:0.82rem;}
    .nn-rows dt{color:var(--nn-muted);min-width:0;}
    .nn-rows dd{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;}
    .nn-rows .sub{padding-left:0.7rem;font-size:0.78rem;}
    /* A row that is a heads-up rather than a monthly bill says so under itself,
       so the figure beside it is never read as part of the cash-flow total. */
    .nn-rows .nn-rownote{display:block;font-size:0.7rem;line-height:1.35;opacity:0.75;}
    /* A statement row that can explain itself. Styled as the label it replaces
       so the sheet still scans as a list, with only the marker to say it opens. */
    .nn-why{
      background:none;border:0;padding:0;font:inherit;color:inherit;cursor:pointer;
      display:inline-flex;align-items:center;gap:0.3rem;text-align:left;
      border-bottom:1px dashed currentColor;
    }
    .nn-why span{
      font-size:0.62rem;line-height:1;font-weight:700;
      width:0.95rem;height:0.95rem;flex:none;border-radius:50%;
      display:inline-flex;align-items:center;justify-content:center;
      background:var(--nn-line);color:var(--nn-ink);
    }
    .nn-why:hover span, .nn-why:focus-visible span{background:var(--nn-gold);color:#10151f;}
    /* Working shown as a table, scrolling inside its own card so a narrow phone
       never scrolls the whole dialog sideways. */
    .nn-tbl{margin:0.9rem 0;overflow-x:auto;border:1px solid var(--nn-line);border-radius:0.6rem;background:rgba(0,0,0,0.18);}
    .nn-tbl table{border-collapse:collapse;width:100%;font-size:0.78rem;}
    .nn-tbl caption{
      text-align:left;padding:0.5rem 0.7rem;font-size:0.66rem;letter-spacing:0.08em;
      text-transform:uppercase;color:var(--nn-muted);border-bottom:1px solid var(--nn-line);
    }
    .nn-tbl th, .nn-tbl td{padding:0.4rem 0.7rem;text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums;}
    .nn-tbl thead th{font-size:0.66rem;color:var(--nn-muted);font-weight:600;}
    .nn-tbl tbody th{text-align:left;font-weight:600;white-space:normal;}
    .nn-tbl tbody th small{display:block;font-weight:400;font-size:0.66rem;color:var(--nn-muted);}
    .nn-tbl tbody tr + tr{border-top:1px solid var(--nn-line);}
    .nn-tbl .muted{color:var(--nn-muted);}
    /* The bracket the player is standing in right now. */
    .nn-tbl .nn-taxhere{background:rgba(214,168,74,0.14);}
    /* The company's books sit in the sheet but must not read as the player's
       own money, so the block is tinted and its rows keep their own frame. */
    .nn-corp{border:1px solid rgba(214,168,74,0.35);border-radius:0.7rem;padding:0.7rem 0.8rem;background:rgba(214,168,74,0.06);}
    .nn-corpbtn{margin-top:0.6rem;width:100%;}
    .nn-owner{
      display:inline-block;padding:0 0.32rem;margin-right:0.3rem;border-radius:0.3rem;
      font-size:0.62rem;letter-spacing:0.04em;background:rgba(214,168,74,0.2);color:var(--nn-gold);
    }
    .nn-hero-note{margin:0.15rem 0 0;font-size:0.72rem;color:var(--nn-muted);}
    .nn-hero-note b{color:var(--nn-ink);}
    /* The credit assessment and the annual report are both "the other side's
       paperwork", so they share one framed look that sets them off from the
       card's own facts. */
    .nn-credit, .nn-books{
      margin-top:0.9rem;border:1px solid var(--nn-line);border-radius:0.7rem;
      padding:0.7rem 0.8rem;background:rgba(0,0,0,0.18);
    }
    .nn-credit h3, .nn-books h3{
      margin:0 0 0.5rem;font-size:0.68rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--nn-muted);
    }
    .nn-credit .facts, .nn-books .facts{margin:0;}
    .nn-credit .nn-empty, .nn-books .nn-empty{margin:0.5rem 0 0;font-size:0.72rem;line-height:1.5;}
    /* The sentence a card carries on with when the offer cannot touch you. */
    .nn-but{opacity:0.85;}
    /* The two starting-life switches: one row per thing, both options visible at
       once so the trade is read rather than discovered. */
    .nn-swaps{display:grid;gap:0.7rem;margin:0.6rem 0 1.2rem;}
    .nn-swapside{display:grid;grid-template-columns:1fr 1fr;gap:0.6rem;}
    @media (max-width:520px){.nn-swapside{grid-template-columns:1fr;}}
    .nn-learnrow{display:flex;justify-content:flex-end;margin-bottom:0.4rem;}
    /* The how-to: numbered steps down one column, each with its own heading. */
    .nn-learnstep{display:flex;gap:0.7rem;margin:0.9rem 0;}
    .nn-learnstep h3{margin:0 0 0.2rem;font-size:0.95rem;}
    .nn-learnstep p{margin:0;font-size:0.82rem;line-height:1.6;color:var(--nn-muted);}
    .nn-learnnum{
      flex:none;width:1.6rem;height:1.6rem;border-radius:50%;
      display:inline-flex;align-items:center;justify-content:center;
      background:var(--nn-line);color:var(--nn-ink);font-size:0.8rem;font-weight:700;
    }
    .nn-dgm{margin:0.8rem 0;}
    .nn-dgm svg{width:100%;height:auto;display:block;}
    .nn-dgm figcaption{margin-top:0.4rem;font-size:0.74rem;line-height:1.5;color:var(--nn-muted);}
    .nn-tbl .nn-taxhere th{color:var(--nn-gold);}
    .nn-tbl figcaption, .nn-tbl + figcaption{font-size:0.7rem;}
    .nn-tbl figcaption{padding:0.45rem 0.7rem;color:var(--nn-muted);border-top:1px solid var(--nn-line);}
    .facts dt small{display:block;font-weight:400;font-size:0.66rem;color:var(--nn-muted);}
    .facts dd small{display:block;font-weight:400;font-size:0.66rem;color:var(--nn-muted);}
    .nn-sec{
      margin-top:0.9rem;
      padding-top:0.7rem;
      border-top:1px dashed var(--nn-border);
    }
    .nn-sec:first-child{margin-top:0;padding-top:0;border-top:none;}
    .nn-sec h3{
      font-size:0.74rem;
      text-transform:uppercase;
      letter-spacing:.5px;
      color:var(--nn-gold);
      margin-bottom:0.4rem;
    }
    .nn-big{
      display:flex;
      justify-content:space-between;
      align-items:baseline;
      gap:0.5rem;
      margin-top:0.5rem;
      padding:0.5rem 0.65rem;
      background:var(--nn-panel-2);
      border-radius:10px;
    }
    .nn-big span:first-child{font-size:0.76rem;color:var(--nn-muted);}
    .nn-big strong{font-size:1.05rem;font-variant-numeric:tabular-nums;}
    .pos{color:var(--nn-green-bright);}
    .neg{color:var(--nn-red-soft);}
    .nn-list{list-style:none;display:grid;gap:0.35rem;font-size:0.78rem;}
    .nn-list li{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:0.5rem;
      background:var(--nn-panel-2);
      border-radius:9px;
      padding:0.4rem 0.6rem;
    }
    .nn-list .nm{min-width:0;}
    .nn-list .nm b{display:block;font-weight:600;color:var(--nn-ink);}
    .nn-list .nm small{display:block;color:var(--nn-muted);font-size:0.72rem;}
    .nn-list .amt{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;}
    .nn-empty{font-size:0.78rem;color:var(--nn-muted);font-style:normal;}
    .nn-mini{
      border:1px solid var(--nn-border);
      border-radius:8px;
      padding:0.2rem 0.5rem;
      font-size:0.7rem;
      color:var(--nn-muted);
      white-space:nowrap;
    }
    .nn-mini:hover:not(:disabled){border-color:var(--nn-green);color:var(--nn-green-bright);}
    .nn-mini:disabled{opacity:.35;cursor:not-allowed;}

    /* board */
    .nn-board{
      display:grid;
      grid-template-columns:repeat(7,1fr);
      grid-template-rows:repeat(7,1fr);
      gap:0.3rem;
      aspect-ratio:1;
      width:100%;
      max-width:34rem;
      margin:0 auto;
    }
    .nn-tile{
      background:var(--nn-panel-2);
      border:1px solid var(--nn-border-soft);
      border-radius:8px;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:1px;
      padding:2px;
      font-size:clamp(0.6rem, 1.35vw, 0.66rem);
      line-height:1.15;
      letter-spacing:-0.2px;
      text-align:center;
      color:var(--nn-muted);
      overflow:hidden;
      transition:transform .15s, box-shadow .15s;
    }
    .nn-tile-payday{border-color:rgba(53,168,106,.55);color:var(--nn-green-bright);}
    .nn-tile-deal{border-color:rgba(77,114,169,.55);color:#9dbbe8;}
    .nn-tile-market{border-color:rgba(139,127,212,.55);color:#b7aef0;}
    .nn-tile-doodad{border-color:rgba(217,83,79,.5);color:var(--nn-red-soft);}
    .nn-tile-baby, .nn-tile-charity{border-color:rgba(226,178,60,.5);color:var(--nn-gold);}
    .nn-tile-downsized{border-color:rgba(217,83,79,.75);color:var(--nn-red-soft);background:rgba(217,83,79,.08);}
    .nn-tile-fastpay{border-color:rgba(53,168,106,.55);color:var(--nn-green-bright);}
    .nn-tile-fastdeal{border-color:rgba(77,114,169,.55);color:#9dbbe8;}
    .nn-tile-dream{border-color:rgba(226,178,60,.7);color:var(--nn-gold);background:rgba(226,178,60,.07);}
    .nn-tile-bonus{border-color:rgba(53,168,106,.4);color:var(--nn-green-bright);}
    .nn-tile-setback{border-color:rgba(217,83,79,.5);color:var(--nn-red-soft);}
    .nn-tile.is-here{
      transform:scale(1.06);
      box-shadow:0 0 0 2px var(--nn-gold), 0 6px 18px -6px rgba(226,178,60,.6);
      background:#242f42;
      color:#fff;
    }
    /* The tile is rebuilt on every step, so the animation replays by itself
       each time the token arrives somewhere. */
    .nn-tile.is-here{animation:nn-land .26s ease-out;}
    @keyframes nn-land{
      0%{transform:scale(1);}
      60%{transform:scale(1.16);}
      100%{transform:scale(1.06);}
    }
    .nn-tile.is-pay{
      animation:nn-pay .7s ease-out;
      box-shadow:0 0 0 2px var(--nn-green-bright), 0 8px 24px -6px rgba(95,214,148,.7);
    }
    @keyframes nn-pay{
      0%{transform:scale(1.06);background:#2b5a41;}
      35%{transform:scale(1.2);background:#2f7a52;}
      100%{transform:scale(1.06);background:#242f42;}
    }
    .nn-token{
      width:1.05rem;
      height:1.05rem;
      display:block;
      color:var(--nn-gold);
      filter:drop-shadow(0 0 6px rgba(226,178,60,.85));
      animation:nn-hop .45s ease-out;
    }
    @keyframes nn-hop{
      0%{transform:translateY(-9px) scale(.75);}
      55%{transform:translateY(2px) scale(1.12);}
      100%{transform:none;}
    }

    /* tier badge + debt breakdown */
    /* A bare `display` here outranks the user agent's [hidden] rule, so an
       empty pill kept floating under the title on the setup screen. Same trap
       as .nn-ovl before it: every hidden-able element needs its own opt-out. */
    .nn-tier[hidden]{display:none;}
    .nn-tier{
      display:inline-flex;
      align-items:center;
      gap:0.4rem;
      margin-top:0.35rem;
      font-size:0.72rem;
      background:rgba(226,178,60,.12);
      border:1px solid rgba(226,178,60,.4);
      border-radius:999px;
      padding:0.14rem 0.7rem;
    }
    .nn-tier-n{font-family:"JetBrains Mono",monospace;color:var(--nn-gold);}
    .nn-tier-name{color:var(--nn-ink);}
    .nn-rows dd.muted, .nn-rows dt.sub{color:var(--nn-muted);}
    .nn-debt{flex-wrap:wrap;}
    .nn-debt-head{
      flex:1 1 auto;
      text-align:left;
      min-width:0;
      padding:0;
      background:none;
      border:none;
      cursor:pointer;
      /* The caret is the only thing on the row that says it opens. Without it
         players read a mortgaged holding as a fixed line of text and never find
         the breakdown, or the button that pays the loan off. */
      display:flex;
      align-items:center;
      gap:0.4rem;
    }
    .nn-debt-head::before{
      content:'';
      flex:none;
      width:0.42rem;height:0.42rem;
      border-right:1.5px solid var(--nn-muted);
      border-bottom:1.5px solid var(--nn-muted);
      transform:rotate(-45deg);
      transition:transform 0.15s ease;
    }
    .nn-debt.is-open > .nn-debt-head::before{transform:rotate(45deg);}
    .nn-debt-head:hover::before{border-color:var(--nn-green-bright);}
    @media (prefers-reduced-motion: reduce){.nn-debt-head::before{transition:none;}}
    .nn-debt-head .nm{flex:1 1 auto;}
    .nn-debt-head.is-static{cursor:default;}
    .nn-debt-head.is-static::before{display:none;}
    .nn-debt.is-open{outline:1px solid var(--nn-border);}
    /* A group is already outlined; its children would double the border. */
    .nn-sublist .nn-debt.is-open{outline:none;}
    .nn-debt-body{
      flex-basis:100%;
      margin-top:0.45rem;
      padding-top:0.45rem;
      border-top:1px dashed var(--nn-border);
    }
    /* headline block: the part worth screenshotting */
    .nn-hero{
      background:linear-gradient(160deg,#1d2a24,var(--nn-panel-2));
      border:1px solid #2f4a3b;
      border-radius:14px;
      padding:0.85rem 0.95rem;
      margin-bottom:1rem;
    }
    .nn-hero-label{
      font-size:0.7rem;
      text-transform:uppercase;
      letter-spacing:.6px;
      color:var(--nn-muted);
    }
    .nn-hero-figure{
      display:block;
      font-size:1.65rem;
      line-height:1.2;
      letter-spacing:-.5px;
      font-variant-numeric:tabular-nums;
      margin:0.1rem 0 0.55rem;
    }
    .nn-hero-figure.pos{color:var(--nn-green-bright);}
    .nn-hero-figure.neg{color:var(--nn-red-soft);}
    /* Three across only where three fit: a seven-figure passive income needs
       about 7rem of its own, and the panel is narrower than that x3. */
    .nn-hero-sub{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(7.5rem,1fr));
      gap:0.4rem 0.6rem;
      padding-top:0.55rem;
      border-top:1px solid rgba(255,255,255,.07);
    }
    .nn-hero-sub span{display:flex;flex-direction:column;gap:0.1rem;min-width:0;}
    .nn-hero-sub i{font-style:normal;font-size:0.68rem;color:var(--nn-muted);}
    .nn-hero-sub b{font-size:0.82rem;font-variant-numeric:tabular-nums;white-space:nowrap;}
    .nn-hero-tier{
      margin-top:0.55rem;
      font-size:0.72rem;
      color:var(--nn-gold);
    }
    .nn-more{
      width:100%;
      margin-top:0.5rem;
      padding:0.35rem;
      border:1px dashed var(--nn-border);
      border-radius:10px;
      font-size:0.74rem;
      color:var(--nn-muted);
      transition:border-color .15s,color .15s;
    }
    .nn-more:hover{border-color:var(--nn-green);color:var(--nn-green-bright);}
    .nn-sublist{margin-top:0.2rem;}
    .nn-sublist li{background:rgba(0,0,0,.18);border-radius:8px;padding:0.4rem 0.5rem;}
    .nn-dreamlist{list-style:none;display:grid;gap:0.3rem;margin-bottom:0.5rem;}
    .nn-dreamlist li{
      display:flex;
      justify-content:space-between;
      align-items:baseline;
      gap:0.5rem;
      font-size:0.78rem;
      padding:0.3rem 0.5rem;
      border-left:2px solid var(--nn-gold);
      background:rgba(226,178,60,.08);
      border-radius:0 8px 8px 0;
    }
    .nn-dreamlist small{color:var(--nn-muted);font-variant-numeric:tabular-nums;white-space:nowrap;}
    .nn-legacy{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));
      gap:0.6rem;
      margin-top:0.9rem;
    }
    .nn-legacy .nn-pick:disabled{opacity:.45;cursor:not-allowed;}
    .nn-legacy-sec{border-top-color:var(--nn-gold);}
    .nn-legacy-sec .nn-big strong{color:var(--nn-gold);}
    .nn-dreampick{
      display:grid;
      grid-template-columns:repeat(auto-fill,minmax(13rem,1fr));
      gap:0.6rem;
      margin-top:0.9rem;
      max-height:22rem;
      overflow-y:auto;
    }
    .nn-dreamdone{
      display:flex;
      flex-wrap:wrap;
      gap:0.35rem;
      margin-top:0.7rem;
    }
    .nn-dreamdone span{
      font-size:0.7rem;
      padding:0.15rem 0.5rem;
      border-radius:999px;
      background:rgba(226,178,60,.14);
      color:var(--nn-gold);
    }
    .nn-debt-clear{width:100%;margin-top:0.5rem;padding:0.35rem 0.6rem;font-size:0.76rem;}
    /* the "left for you" line closes the rent-minus-payment sum above it */
    .nn-rows .nn-rowsplit{
      border-top:1px solid var(--nn-border);
      padding-top:0.22rem;
      margin-top:0.12rem;
      font-weight:600;
    }
    .nn-rows dt.nn-rowsplit{color:var(--nn-ink);}
    .nn-debtsum{margin-bottom:0.55rem;}
    .nn-debtsum .nn-total{font-size:0.9rem;font-weight:700;}
    .nn-rows .nn-rowhead{
      margin-top:0.5rem;
      font-size:0.72rem;
      text-transform:uppercase;
      letter-spacing:.4px;
      color:var(--nn-gold);
    }
    .nn-paper{flex-wrap:wrap;row-gap:0.4rem;}
    .nn-paper .nm{flex:1 1 9rem;min-width:0;}
    .nn-rowend{
      display:flex;
      align-items:center;
      justify-content:flex-end;
      gap:0.4rem;
      margin-left:auto;
      flex-wrap:wrap;
    }
    .nn-paper-qty{
      width:4.2rem;
      flex-shrink:0;
      background:var(--nn-panel-2);
      border:1px solid var(--nn-border);
      border-radius:8px;
      color:var(--nn-ink);
      padding:0.2rem 0.4rem;
      font-size:0.76rem;
      text-align:right;
      font-variant-numeric:tabular-nums;
    }
    .nn-paper-qty:focus{outline:2px solid var(--nn-green);outline-offset:1px;}
    .nn-list li{position:relative;}
    .nn-pop-debt{top:.15rem;right:.6rem;font-size:.72rem;}
    .nn-warnline{
      margin-top:0.4rem;
      font-size:0.72rem;
      color:var(--nn-gold);
      line-height:1.6;
    }
    .nn-center{
      grid-row:2 / 7;
      grid-column:2 / 7;
      background:var(--nn-panel-2);
      border:1px dashed var(--nn-border);
      border-radius:14px;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:0.5rem;
      padding:0.9rem;
      text-align:center;
    }
    .nn-dice{display:flex;gap:0.4rem;}
    .nn-die{
      width:2.6rem;
      height:2.6rem;
      display:block;
      filter:drop-shadow(0 4px 8px rgba(0,0,0,.45));
      transform:rotate(-4deg);
    }
    .nn-die svg{width:100%;height:100%;display:block;}
    .nn-die.is-idle{opacity:.45;transform:none;filter:none;}
    .nn-die.is-rolling{animation:nn-tumble .18s linear infinite;}
    @keyframes nn-tumble{
      0%{transform:rotate(-16deg) translateY(0) scale(.95);}
      35%{transform:rotate(12deg) translateY(-7px) scale(1.06);}
      70%{transform:rotate(-6deg) translateY(-2px) scale(1);}
      100%{transform:rotate(-16deg) translateY(0) scale(.95);}
    }
    .nn-here{font-size:0.8rem;color:var(--nn-muted);}
    .nn-here b{color:var(--nn-ink);}

    /* the floating delta that rises off the cash row whenever money moves */
    .nn-cashrow{position:relative;}
    .nn-pop{
      position:absolute;
      right:0.65rem;
      top:0;
      font-size:0.8rem;
      font-weight:700;
      font-variant-numeric:tabular-nums;
      pointer-events:none;
      animation:nn-float 1.1s cubic-bezier(.2,.7,.3,1) forwards;
    }
    .nn-pop.up{color:var(--nn-green-bright);}
    .nn-pop.down{color:var(--nn-red-soft);}
    @keyframes nn-float{
      0%{opacity:0;transform:translateY(4px);}
      18%{opacity:1;transform:translateY(-6px);}
      70%{opacity:1;transform:translateY(-20px);}
      100%{opacity:0;transform:translateY(-30px);}
    }
    /* victory confetti: strips falling behind the result card's content */
    .nn-confetti{position:absolute;inset:0;overflow:hidden;pointer-events:none;border-radius:18px;}
    .nn-confetti i{
      position:absolute;
      top:-14px;
      width:7px;
      height:13px;
      border-radius:2px;
      opacity:0;
      animation-name:nn-fall;
      animation-timing-function:linear;
      animation-iteration-count:3;
    }
    @keyframes nn-fall{
      0%{opacity:0;transform:translateY(0) rotate(0deg);}
      8%{opacity:1;}
      85%{opacity:1;}
      100%{opacity:0;transform:translateY(560px) rotate(560deg);}
    }
    .nn-win-title{
      background:linear-gradient(92deg,var(--nn-green-bright),var(--nn-gold));
      -webkit-background-clip:text;
      background-clip:text;
      color:transparent;
      animation:nn-shine .9s ease-out;
    }
    @keyframes nn-shine{
      from{opacity:0;transform:scale(.9);}
      to{opacity:1;transform:none;}
    }
    .nn-logl li:first-child{animation:nn-slidein .3s ease-out;}
    @keyframes nn-slidein{
      from{opacity:0;transform:translateX(-6px);}
      to{opacity:1;transform:none;}
    }
    .nn-meterwrap{width:100%;max-width:15rem;}
    .nn-meterlabel{
      display:flex;
      justify-content:space-between;
      font-size:0.68rem;
      color:var(--nn-muted);
      margin-bottom:0.25rem;
    }
    .nn-meter{height:7px;background:#0d131d;border-radius:99px;overflow:hidden;}
    .nn-meter-fill{height:100%;background:linear-gradient(90deg,var(--nn-green),var(--nn-green-bright));transition:width .35s ease;}
    .nn-meter-fill.gold{background:linear-gradient(90deg,#a5811f,var(--nn-gold));}
    .nn-controls{
      display:flex;
      flex-wrap:wrap;
      gap:0.5rem;
      justify-content:center;
      align-items:center;
      margin-top:1rem;
      padding-top:0.9rem;
      border-top:1px dashed var(--nn-border);
    }
    .nn-speed{
      width:100%;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:0.35rem;
      font-size:0.72rem;
      color:var(--nn-muted);
    }
    .nn-speed span{margin-right:0.2rem;}
    .nn-speed button{
      border:1px solid var(--nn-border-soft);
      border-radius:8px;
      padding:0.16rem 0.55rem;
      font-size:0.72rem;
      color:var(--nn-muted);
      transition:border-color .15s,color .15s,background .15s;
    }
    /* Fingers need more than the 22px this row wants on its own. */
    @media (hover: none){
      .nn-speed button{padding:0.4rem 0.75rem;}
    }
    .nn-speed button:hover{border-color:var(--nn-green);color:var(--nn-ink);}
    .nn-speed button[aria-pressed="true"]{
      border-color:var(--nn-green);
      background:rgba(53,168,106,.16);
      color:var(--nn-green-bright);
    }
    .nn-status{
      width:100%;
      text-align:center;
      font-size:0.75rem;
      color:var(--nn-muted);
      display:flex;
      gap:0.9rem;
      justify-content:center;
      flex-wrap:wrap;
    }

    /* Every scrolling panel gets the dark theme's own bar; the platform default
       is a bright grey slab that sits on this palette like a sticker. */
    .nn-logl, .nn-dreampick, .nn-scroll{
      scrollbar-width:thin;
      scrollbar-color:var(--nn-border) transparent;
    }
    .nn-logl::-webkit-scrollbar,
    .nn-dreampick::-webkit-scrollbar,
    .nn-scroll::-webkit-scrollbar{width:8px;height:8px;}
    .nn-logl::-webkit-scrollbar-track,
    .nn-dreampick::-webkit-scrollbar-track,
    .nn-scroll::-webkit-scrollbar-track{background:transparent;}
    .nn-logl::-webkit-scrollbar-thumb,
    .nn-dreampick::-webkit-scrollbar-thumb,
    .nn-scroll::-webkit-scrollbar-thumb{
      background:var(--nn-border);
      border-radius:99px;
      border:2px solid transparent;
      background-clip:content-box;
    }
    .nn-logl::-webkit-scrollbar-thumb:hover,
    .nn-dreampick::-webkit-scrollbar-thumb:hover,
    .nn-scroll::-webkit-scrollbar-thumb:hover{background:var(--nn-green);background-clip:content-box;}

    /* log */
    .nn-logl{list-style:none;display:grid;gap:0.4rem;max-height:32rem;overflow-y:auto;padding-right:0.3rem;}
    .nn-logl li{
      font-size:0.76rem;
      line-height:1.55;
      color:var(--nn-muted);
      border-left:2px solid var(--nn-border);
      padding:0.1rem 0 0.1rem 0.55rem;
    }
    .nn-logl li.good{border-color:var(--nn-green);color:#cfe6d9;}
    .nn-logl li.bad{border-color:var(--nn-red);color:#eccfce;}

    /* ------------------------------------------------------------ dialogs */
    /* display:flex below outranks the UA stylesheet's [hidden]{display:none},
       so the overlay needs its own hidden rule or it never goes away. */
    .nn-ovl[hidden]{display:none;}
    .nn-ovl{
      position:fixed;
      inset:0;
      background:rgba(6,10,17,.78);
      backdrop-filter:blur(2px);
      display:flex;
      align-items:center;
      justify-content:center;
      padding:1rem;
      z-index:50;
    }
    .nn-dlg{
      background:var(--nn-panel);
      border:1px solid var(--nn-border);
      border-radius:18px;
      box-shadow:0 24px 70px -18px rgba(0,0,0,.8);
      padding:1.4rem 1.5rem 1.5rem;
      width:min(34rem,100%);
      max-height:min(86vh, 46rem);
      overflow-y:auto;
      animation:nn-pop .22s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes nn-pop{from{opacity:0;transform:translateY(12px) scale(.98);}to{opacity:1;transform:none;}}
    /* Setting a card aside: a minimise control in the corner of the card, drawn
       as the bar it collapses to rather than as a close cross, because the
       decision is not being cancelled. */
    .nn-dlg{position:relative;}
    .nn-dlg-min{
      position:absolute;top:0.7rem;right:0.7rem;
      width:1.9rem;height:1.9rem;
      display:flex;align-items:center;justify-content:center;
      border:1px solid var(--nn-border);border-radius:9px;
      background:var(--nn-panel-2);cursor:pointer;
    }
    .nn-dlg-min span{display:block;width:0.75rem;height:2px;border-radius:2px;background:var(--nn-muted);}
    .nn-dlg-min:hover{border-color:var(--nn-gold);}
    .nn-dlg-min:hover span{background:var(--nn-gold);}
    /* The card is still owed, so the way back to it is the loudest thing in the
       control row. */
    .nn-cardback{width:100%;}
    .nn-dlg .kind{
      font-family:"JetBrains Mono", monospace;
      font-size:0.64rem;
      text-transform:uppercase;
      letter-spacing:.7px;
      color:var(--nn-gold);
      margin-bottom:0.35rem;
    }
    .nn-dlg h2{font-size:1.15rem;color:#fff;margin-bottom:0.5rem;line-height:1.35;}
    .nn-dlg h3{font-size:0.85rem;color:var(--nn-green-bright);margin:1rem 0 0.4rem;}
    .nn-dlg .story{font-size:0.86rem;color:var(--nn-muted);line-height:1.75;}
    .nn-dlg .facts{
      display:grid;
      grid-template-columns:1fr auto;
      gap:0.25rem 0.8rem;
      margin:0.9rem 0;
      padding:0.7rem 0.85rem;
      background:var(--nn-panel-2);
      border-radius:11px;
      font-size:0.82rem;
    }
    .nn-dlg .facts dt{color:var(--nn-muted);}
    .nn-dlg .facts dd{text-align:right;font-variant-numeric:tabular-nums;}
    .nn-dlg p{font-size:0.86rem;line-height:1.75;margin:0.5rem 0;}
    .nn-acts{display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:1.1rem;}
    .nn-qty{
      display:flex;
      align-items:center;
      gap:0.5rem;
      margin-top:0.8rem;
      font-size:0.8rem;
      color:var(--nn-muted);
      flex-wrap:wrap;
    }
    .nn-qty input{
      width:6.5rem;
      background:var(--nn-panel-2);
      border:1px solid var(--nn-border);
      border-radius:8px;
      padding:0.35rem 0.55rem;
      color:var(--nn-ink);
      font-variant-numeric:tabular-nums;
      user-select:text;
    }
    .nn-sellrow{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:0.6rem;
      flex-wrap:wrap;
      background:var(--nn-panel-2);
      border-radius:11px;
      padding:0.6rem 0.75rem;
      margin-bottom:0.5rem;
      font-size:0.8rem;
    }
    .nn-sellrow .nm b{display:block;color:#fff;}
    .nn-sellrow .nm small{color:var(--nn-muted);}
    .nn-sellrow input{
      width:5rem;
      background:var(--nn-panel);
      border:1px solid var(--nn-border);
      border-radius:8px;
      padding:0.28rem 0.45rem;
      color:var(--nn-ink);
      user-select:text;
    }
    /* The other side of a price card: a counter to buy at the quoted price. */
    /* Retraining: three real routes side by side, priced honestly. */
    .nn-routes{display:grid;gap:0.7rem;margin-top:0.9rem;}
    .nn-route{
      background:var(--nn-panel-2);
      border:1px solid var(--nn-border);
      border-radius:13px;
      padding:0.75rem 0.85rem 0.85rem;
    }
    .nn-route h3{margin:0 0 0.3rem;font-size:0.85rem;color:#fff;}
    .nn-route p{margin:0 0 0.5rem;font-size:0.78rem;color:var(--nn-muted);line-height:1.55;}
    .nn-route .facts{margin:0 0 0.55rem;}
    .nn-route .nn-btn{width:100%;}
    .nn-route select{
      background:var(--nn-panel);
      border:1px solid var(--nn-border);
      border-radius:8px;
      padding:0.32rem 0.5rem;
      color:var(--nn-ink);
      max-width:100%;
    }
    .nn-route .nn-qty{margin:0 0 0.55rem;flex-direction:column;align-items:stretch;gap:0.3rem;}
    .nn-buybox{
      margin-top:0.9rem;
      padding:0.75rem 0.85rem 0.85rem;
      background:var(--nn-panel-2);
      border:1px solid var(--nn-border);
      border-radius:13px;
    }
    .nn-buybox h3{
      margin:0 0 0.4rem;
      font-size:0.82rem;
      font-weight:700;
      color:#fff;
    }
    .nn-buybox .facts{margin:0;}
    .nn-buybox .nn-acts{margin-top:0.7rem;}
    .nn-note{
      font-size:0.78rem;
      color:var(--nn-muted);
      background:rgba(226,178,60,.08);
      border-left:3px solid var(--nn-gold);
      border-radius:0 9px 9px 0;
      padding:0.55rem 0.75rem;
      margin-top:0.9rem;
      line-height:1.7;
    }

    /* ------------------------------------------------------------- footer */
    .nn-foot{
      max-width:76rem;
      margin:0 auto;
      padding:2rem 1rem 2.5rem;
      border-top:1px solid var(--nn-border);
      text-align:center;
    }
    .nn-foot-social{display:flex;justify-content:center;gap:1.1rem;margin-bottom:0.8rem;}
    .nn-foot-social a{color:var(--nn-muted);line-height:1;transition:color .15s;}
    .nn-foot-social a:hover{color:var(--nn-green-bright);}
    .nn-foot-social svg{width:1.05rem;height:1.05rem;display:block;}
    .nn-foot p{font-size:0.72rem;color:var(--nn-muted);line-height:1.8;}
    .nn-foot a{color:var(--nn-green-bright);text-decoration:underline;text-underline-offset:2px;}
    .nn-disclaim{max-width:44rem;margin:0.6rem auto 0;font-size:0.68rem;color:#6d7a90;}

    /* On a phone every pixel the panel takes is a pixel off each board tile. */
    @media (max-width:560px){
      .nn{padding:1rem 0.6rem 2.5rem;}
      .nn-play{padding:0.7rem 0.6rem;}
      .nn-board{gap:0.22rem;}
      .nn-center{padding:0.6rem;}
      .nn-brand h1{font-size:1.3rem;}
    }

    @media (prefers-reduced-motion: reduce){
      *{animation-duration:.001ms !important;transition-duration:.001ms !important;}
      .nn-tile.is-here{transform:none;}
    }
  </style>
</head>
<body>
  <div class="nn" data-nn>
    <header class="nn-head">
      <a class="nn-back" href="/games/">
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
        <span data-i18n="back">หมวดเกม</span>
      </a>
      <div class="nn-headrow">
        <div class="nn-brand">
          <h1 data-i18n="gameTitle">หนีหนู</h1>
          <p class="nn-tier" data-tier hidden></p>
          <p class="nn-sub" data-i18n="gameSub">เกมกระดานการเงินที่คุณชนะเมื่อเงินไหลเข้าต่อเดือน มากกว่ารายจ่ายต่อเดือน</p>
        </div>
        <div class="nn-tools">
          <button type="button" class="nn-btn" data-act="rules" data-i18n="rules">กติกา</button>
          <button type="button" class="nn-btn nn-btn-quiet" data-act="restart" data-i18n="restart">เริ่มใหม่</button>
          <div class="nn-lang" role="group" aria-label="เลือกภาษา / Language">
            <button type="button" data-lang-btn="th" aria-pressed="true">ไทย</button>
            <button type="button" data-lang-btn="en" aria-pressed="false">EN</button>
          </div>
        </div>
      </div>
    </header>

    <section data-screen="setup"></section>

    <section data-screen="game" hidden>
      <div class="nn-grid">
        <aside class="nn-panel" data-sheet></aside>
        <main class="nn-panel nn-play">
          <div class="nn-board" data-board></div>
          <div class="nn-controls" data-controls></div>
        </main>
        <aside class="nn-panel" data-logpanel></aside>
      </div>
    </section>

    <div class="nn-ovl" data-ovl hidden>
      <div class="nn-dlg" role="dialog" aria-modal="true" aria-labelledby="nn-dlg-title" tabindex="-1" data-dlg></div>
    </div>
  </div>

  <footer class="nn-foot">
    <div class="nn-foot-social">
      {footerSocialLinks.map((s) => (
        <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d={s.iconPath} /></svg>
        </a>
      ))}
    </div>
    <p>&copy; {year} <a href="/">ChimengSoso</a> · <a href="/privacy/">นโยบายความเป็นส่วนตัว</a></p>
    <p class="nn-disclaim">
      เกม "หนีหนู" เขียนขึ้นใหม่ทั้งหมดสำหรับเว็บนี้ ทั้งอาชีพ การ์ด ตัวเลข และถ้อยคำ
      ไม่มีความเกี่ยวข้องกับ ไม่ได้รับอนุญาตจาก และไม่ได้รับการรับรองโดยเจ้าของเกมการเงินเชิงพาณิชย์รายใด
    </p>
  </footer>

  <script>
    import {
      FAST_BOARD,
      RAT_BOARD,
      dealById,
      deals,
      doodadById,
      dreamById,
      dreams,
      fastById,
      marketById,
      professionById,
      professions,
      studyRouteById,
      studyRoutes,
    } from '../../data/neeNoo';
    import {
      LOAN_RATE,
      LOAN_STEP,
      MORTGAGE_RATE,
      fastCardCash,
      landHeld,
      fastGoal,
      fastIncomeLoss,
      severance,
      taxes,
      taxBill,
      startingTax,
      marginalRate,
      TAX_BRACKETS,
      checkEscape,
      checkTier,
      acceptBaby,
      declineBaby,
      nextChildCost,
      nextChildCostGross,
      PARTNER_SHARE,
      coveredNow,
      uninsuredCost,
      MAX_CHILDREN,
      acceptDownsized,
      acceptGraduation,
      acceptFriendHelp,
      assetCashflow,
      assetValue,
      ownsThing,
      ownSale,
      sellOwn,
      homeValue,
      carValue,
      applyForLoan,
      canApplyForLoan,
      creditReview,
      documentedIncome,
      DSR_LIMIT,
      RENT_VS_MORTGAGE,
      COMMUTE_VS_CAR,
      fillCard,
      petPhrase,
      rentCost,
      commuteCost,
      buyDeal,
      buyDream,
      pickDream,
      remainingDreams,
      ownedDreams,
      dreamsDone,
      canRepay,
      canClearMortgage,
      canSellNow,
      canSellBusiness,
      businessExitValue,
      sellBusiness,
      estateTax,
      estateTaxable,
      legacyTotal,
      legacyUnlocked,
      corpSaving,
      corpSetupTotal,
      corpRevenue,
      corpRetained,
      corpTaxMonthly,
      corpEquity,
      householdIncome,
      drawTaken,
      worthAfterWindingUp,
      transferable,
      canBuyAsCorp,
      setDraw,
      payDividend,
      fundCompany,
      isCorpAsset,
      donate,
      incorporate,
      buyInsurance,
      closeLegacy,
      insurancePremium,
      CORP_MONTHLY_COST,
      INSURANCE_PREMIUM_RATE,
      INSURANCE_STEP,
      livePrice,
      marketBuy,
      buyFromMarket,
      totalDebt,
      FIRE_SALE_RATE,
      ageYears,
      monthsToRetire,
      retiredByAge,
      noMoreSalary,
      pensionIncome,
      priceLevel,
      livingCost,
      childStage,
      childExpense,
      childExpenseGross,
      childPremium,
      partnerCost,
      schoolChildren,
      birthdayCost,
      schoolFee,
      payBirthday,
      declineBirthday,
      paySchool,
      tuitionNext,
      studyYear,
      routeTargets,
      canEnrol,
      enrol,
      payLicence,
      acceptRetirement,
      declineCareer,
      heirs,
      heirShare,
      personalDebt,
      assetDebt,
      totalDebtService,
      sellPaper,
      resumeAfterEnd,
      clearMortgage,
      canRoll,
      canQuit,
      callItADay,
      TIER_NAMES,
      quitJob,
      stayEmployed,
      salary,
      tierOf,
      charityCost,
      checkTrouble,
      chooseDeal,
      claimDue,
      closeMarket,
      createGame,
      dealDown,
      dealPrice,
      debtLabel,
      declineDoodad,
      doodadCost,
      escapeProgress,
      fastProgress,
      finishMove,
      fireSale,
      payReward,
      declineReward,
      rewardCost,
      rewardKind,
      fireSaleShortfall,
      DEFICIENCY_PAY_RATE,
      fireSaleValue,
      giveCharity,
      maxAffordable,
      maxBorrow,
      marketMatches,
      marketUnitPrice,
      monthlyCashflow,
      netWorth,
      parseSave,
      passDeal,
      passiveIncome,
      payDoodad,
      profession,
      repay,
      rollDice,
      resolveFastCard,
      sellToMarket,
      skipCharity,
      stepMove,
      skipDream,
      takeInstalment,
      totalExpenses,
      totalIncome,
    } from '../../lib/neeNoo/engine';
    import { TILE_SHORT, UI } from '../../lib/neeNoo/ui-text';
    import type { GameState, Lang, Loc } from '../../lib/neeNoo/types';
    import type { TaxSlice } from '../../lib/neeNoo/engine';

    const SAVE_KEY = 'neeNooSave';
    const LANG_KEY = 'neeNooLang';
    const LEARN_KEY = 'neeNooLearned';
    const SPEED_KEY = 'neeNooSpeed';

    type Root = HTMLElement & { __neeNoo?: boolean };
    /** how long the turn animation is allowed to take; a full game is 100+ turns */
    type Speed = 'normal' | 'fast' | 'off';
    const SPEED_FACTOR: Record<Speed, number> = { normal: 1, fast: 0.4, off: 0 };

    let lang: Lang = 'th';
    let speed: Speed = 'normal';
    let state: GameState | null = null;
    let pickedProfession = professions[0]?.id ?? '';
    let pickedDream = dreams[0]?.id ?? '';
    /** the starting car and house, taken with their loans unless switched off */
    let startCar = true;
    let startHome = true;
    /** the how-to has been read once on this device */
    let seenLearn = false;
    /** fires once per escape, unlike the ending which stays on screen */
    let seenFastIntro = false;
    let modal: 'rules' | 'confirmRestart' | 'fastIntro' | 'borrow' | 'tax' | 'corp' | 'learn' | 'define' | null = null;
    /** which term the glossary popover is explaining */
    let defineKey: GlossaryKey | null = null;
    /**
     * The card the player has pushed aside to go and look at their own numbers.
     *
     * It holds the identity of that particular card rather than a plain flag,
     * so a new one always arrives on screen: minimising the vet bill must not
     * silently swallow the deal that comes after it. The decision itself is
     * still owed, and `canRoll` keeps the dice locked until it is answered.
     */
    let hiddenCard: string | null = null;

    const cardKey = (s: GameState): string => (s.pending ? JSON.stringify(s.pending) : '');
    const cardIsHidden = (s: GameState | null): boolean =>
      !!s && s.pending !== null && modal === null && hiddenCard === cardKey(s);
    /** the player dismissed the result card to look at (or screenshot) the board */
    let endingClosed = false;
    /** which debt row has its breakdown open */
    let openDebt: string | null = null;
    /** the full portfolio is on screen rather than the newest few */
    let assetsExpanded = false;

    /* --- animation state (never saved: it only describes the turn in flight) --- */
    /** a turn is playing out; the roll buttons stay disabled until it finishes */
    let busy = false;
    /** faces to show while the dice tumble, before the real roll is revealed */
    let diceSpin: number[] | null = null;
    /** the cash figure currently on screen, which chases state.cash */
    let shownCash = 0;
    let cashRaf = 0;
    /** set for one render when the tile just stepped onto paid out */
    let flashPay = false;
    /** bumped to orphan a turn animation that has to be abandoned */
    let turnToken = 0;
    /** when the walk last advanced, used to spot a turn frozen by a background tab */
    let lastStepAt = 0;
    const STALE_TURN_MS = 1500;

    const reducedMotion = (): boolean =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches || speed === 'off';
    const sleep = (ms: number): Promise<void> =>
      new Promise((done) => window.setTimeout(done, reducedMotion() ? 0 : ms * SPEED_FACTOR[speed]));

    /** Pip layout for a die face, drawn as a real face rather than a numeral. */
    const DIE_PIPS: Record<number, [number, number][]> = {
      1: [[1, 1]],
      2: [[0, 0], [2, 2]],
      3: [[0, 0], [1, 1], [2, 2]],
      4: [[0, 0], [2, 0], [0, 2], [2, 2]],
      5: [[0, 0], [2, 0], [1, 1], [0, 2], [2, 2]],
      6: [[0, 0], [2, 0], [0, 1], [2, 1], [0, 2], [2, 2]],
    };

    function dieSvg(n: number): string {
      const pips = DIE_PIPS[n] ?? DIE_PIPS[1] ?? [];
      const dots = pips
        .map(([c, r]) => `<circle cx="${14 + c * 18}" cy="${14 + r * 18}" r="5.2" fill="#1b2433"/>`)
        .join('');
      return `<svg viewBox="0 0 60 60" aria-hidden="true">
        <defs><linearGradient id="nnd${n}" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#c9d4e4"/>
        </linearGradient></defs>
        <rect x="2" y="2" width="56" height="56" rx="13" fill="url(#nnd${n})" stroke="#8f9db3" stroke-width="1.5"/>
        <rect x="6" y="6" width="48" height="20" rx="9" fill="#fff" opacity=".55"/>
        ${dots}
      </svg>`;
    }

    /** The player's marker: a small figure rather than an anonymous dot. */
    const TOKEN_SVG = `<svg class="nn-token" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="5" r="3.4" fill="currentColor"/>
      <path d="M12 9c-3 0-5 1.8-5 4.4V16h2.2l.5 6h4.6l.5-6H17v-2.6C17 10.8 15 9 12 9z" fill="currentColor"/>
    </svg>`;

    const T = (l: Loc): string => l[lang];
    const money = (n: number): string => `฿${Math.round(n).toLocaleString('en-US')}`;
    const signed = (n: number): string => `${n >= 0 ? '+' : '-'}${money(Math.abs(n))}`;
    const cls = (n: number): string => (n >= 0 ? 'pos' : 'neg');
    /**
     * A per-unit price, which is the one place rounding to whole baht lies: a
     * ฿5 share that has fallen to ฿6.40 printed as "฿6", and the loss beside it
     * then did not match the arithmetic anybody could do on the two numbers.
     */
    const unitMoney = (n: number): string =>
      Math.abs(n) < 100 && !Number.isInteger(n) ? `฿${n.toFixed(2)}` : money(n);

    /* ------------------------------------------------------------ storage */

    function loadLang(): Lang {
      try {
        return localStorage.getItem(LANG_KEY) === 'en' ? 'en' : 'th';
      } catch {
        return 'th';
      }
    }

    function saveLang(): void {
      try {
        localStorage.setItem(LANG_KEY, lang);
      } catch {
        /* private mode: the game still plays, it just will not be remembered */
      }
    }

    /**
     * The how-to opens by itself the first time somebody arrives and never
     * again, which is the whole reason this flag is on the device rather than
     * in the save: a player who starts their third game has already read it.
     */
    function loadLearned(): boolean {
      try {
        return localStorage.getItem(LEARN_KEY) === '1';
      } catch {
        return false;
      }
    }

    function saveLearned(): void {
      try {
        localStorage.setItem(LEARN_KEY, '1');
      } catch {
        /* ignore */
      }
    }

    function loadSpeed(): Speed {
      try {
        const v = localStorage.getItem(SPEED_KEY);
        return v === 'fast' || v === 'off' ? v : 'normal';
      } catch {
        return 'normal';
      }
    }

    function saveSpeed(): void {
      try {
        localStorage.setItem(SPEED_KEY, speed);
      } catch {
        /* ignore */
      }
    }

    function readSave(): GameState | null {
      try {
        const raw = localStorage.getItem(SAVE_KEY);
        return raw ? parseSave(raw) : null;
      } catch {
        return null;
      }
    }

    function writeSave(): void {
      try {
        if (state) localStorage.setItem(SAVE_KEY, JSON.stringify(state));
      } catch {
        /* ignore quota / private mode */
      }
    }

    function clearSave(): void {
      try {
        localStorage.removeItem(SAVE_KEY);
      } catch {
        /* ignore */
      }
    }

    /* ------------------------------------------------------------- setup */

    /**
     * The preview has to price the same life the player is about to start, so
     * declining the car swaps its instalment for the fare, and declining the
     * house swaps the mortgage for rent. Showing the untouched figure while the
     * switches say otherwise is how a setup screen lies to somebody.
     */
    function professionPreview(id: string): { expenses: number; cashflow: number } {
      const p = professionById.get(id);
      if (!p) return { expenses: 0, cashflow: 0 };
      const kept = p.debts.filter((d) => (d.key === 'car' ? startCar : d.key === 'home' ? startHome : true));
      const swapped =
        (startCar ? 0 : (p.debts.find((d) => d.key === 'car')?.payment ?? 0) * COMMUTE_VS_CAR) +
        (startHome ? 0 : (p.debts.find((d) => d.key === 'home')?.payment ?? 0) * RENT_VS_MORTGAGE);
      const expenses = Math.round(
        startingTax(p) + p.otherExpenses + kept.reduce((sum, d) => sum + d.payment, 0) + swapped,
      );
      return { expenses, cashflow: p.salary - expenses };
    }

    /** The two starting-life switches, as they stand before the game exists. */
    function startingDebt(id: string, key: 'car' | 'home'): { balance: number; payment: number } | null {
      const d = professionById.get(id)?.debts.find((x) => x.key === key);
      return d ? { balance: d.balance, payment: d.payment } : null;
    }

    function renderSetup(root: Root): void {
      const host = root.querySelector<HTMLElement>('[data-screen="setup"]');
      if (!host) return;
      const hasSave = readSave() !== null;

      const profCards = professions
        .map((p) => {
          const pre = professionPreview(p.id);
          return `<button type="button" class="nn-pick" data-act="pick-prof" data-id="${p.id}" aria-pressed="${p.id === pickedProfession}">
            <h3>${T(p.name)}</h3>
            <p>${T(p.blurb)}</p>
            <dl>
              <dt>${T(UI.salary)}</dt><dd>${money(p.salary)}</dd>
              <dt>${T(UI.expensesIsBar)}</dt><dd class="warn">${money(pre.expenses)}${T(UI.perMonth)}</dd>
              <dt>${T(UI.startCf)}</dt><dd class="pos">${signed(pre.cashflow)}</dd>
              <dt>${T(UI.startCash)}</dt><dd>${money(p.cash)}</dd>
            </dl>
          </button>`;
        })
        .join('');

      const dreamCards = dreams
        .map(
          (d) => `<button type="button" class="nn-pick" data-act="pick-dream" data-id="${d.id}" aria-pressed="${d.id === pickedDream}">
            <h3>${T(d.title)}</h3>
            <p>${T(d.story)}</p>
            <dl><dt>${T(UI.price)}</dt><dd>${money(d.cost)}</dd></dl>
          </button>`,
        )
        .join('');

      // The sticky bar is the only part of the choice still on screen once the
      // player has scrolled past the cards, so it repeats what they picked.
      const pickedJob = professionById.get(pickedProfession);
      const pickedName = pickedJob ? T(pickedJob.name) : '';
      const pickedDreamEntry = dreams.find((d) => d.id === pickedDream);
      const pickedDreamName = pickedDreamEntry ? T(pickedDreamEntry.title) : '';

      // The starting car and house, priced both ways. A profession that never
      // had one of these loans is not asked about it.
      const swapCard = (
        key: 'car' | 'home',
        keepLabel: Loc,
        skipLabel: Loc,
        keepNote: Loc,
        skipNote: Loc,
        taken: boolean,
      ): string => {
        const debt = startingDebt(pickedProfession, key);
        if (!debt) return '';
        const alt = Math.round(debt.payment * (key === 'car' ? COMMUTE_VS_CAR : RENT_VS_MORTGAGE));
        return `<div class="nn-swap">
          <div class="nn-swapside">
            <button type="button" class="nn-pick" data-act="pick-${key}" data-id="yes" aria-pressed="${taken}">
              <h3>${T(keepLabel)}</h3>
              <p>${T(keepNote).replace('{pay}', money(debt.payment)).replace('{debt}', money(debt.balance))}</p>
            </button>
            <button type="button" class="nn-pick" data-act="pick-${key}" data-id="no" aria-pressed="${!taken}">
              <h3>${T(skipLabel)}</h3>
              <p>${T(skipNote).replace('{cost}', money(alt))}</p>
            </button>
          </div>
        </div>`;
      };
      const swaps = swapCard('car', UI.takeCar, UI.skipCar, UI.carKeepNote, UI.carSkipNote, startCar)
        + swapCard('home', UI.takeHome, UI.skipHome, UI.homeKeepNote, UI.homeSkipNote, startHome);

      host.innerHTML = `<div class="nn-setup">
        ${hasSave ? `<div class="nn-resume"><button type="button" class="nn-btn nn-btn-gold" data-act="resume">${T(UI.resume)}</button></div>` : ''}
        <div class="nn-learnrow"><button type="button" class="nn-btn nn-btn-quiet" data-act="learn">${T(UI.learnAgain)}</button></div>
        <h2>${T(UI.setupStep1)}</h2>
        <p class="nn-hint">${T(UI.setupHint)}</p>
        <div class="nn-profs">${profCards}</div>
        <h2>${T(UI.setupStep2)}</h2>
        <p class="nn-hint">${T(UI.dreamHint)}</p>
        <div class="nn-dreams">${dreamCards}</div>
        ${swaps ? `<h2>${T(UI.setupStep3)}</h2>
        <p class="nn-hint">${T(UI.setupStep3Hint)}</p>
        <div class="nn-swaps">${swaps}</div>` : ''}
        <div class="nn-startrow">
          <p class="nn-startpick">${pickedName} · <b>${pickedDreamName}</b></p>
          <button type="button" class="nn-btn nn-btn-go" data-act="start">${T(UI.startGame)}</button>
        </div>
      </div>`;
    }

    /* --------------------------------------------------------- statement */

    function renderSheet(root: Root, s: GameState): void {
      const host = root.querySelector<HTMLElement>('[data-sheet]');
      if (!host) return;
      const passive = passiveIncome(s);
      const income = totalIncome(s);
      const expenses = totalExpenses(s);
      const cf = monthlyCashflow(s);
      const onFast = s.phase === 'fast' || s.phase === 'won';

      // Every loan on the sheet, whether it stands on its own or rides along
      // with an asset, opens the same breakdown: what this month's payment is
      // actually buying, and when the thing finally ends.
      const loanBody = (balance: number, payment: number, rate: number, lead: string, extra: string): string => {
        const interest = balance * rate;
        const principal = Math.max(0, payment - interest);
        const left = principal > 0 ? Math.ceil(balance / principal) : Infinity;
        const totalInt = Number.isFinite(left) ? left * payment - balance : Infinity;
        return `<div class="nn-debt-body">
          <dl class="nn-rows">
            ${lead}
            <dt>${T(UI.interestPart)}</dt><dd class="neg">${money(interest)}</dd>
            <dt>${T(UI.principalPart)}</dt><dd class="${principal > 0 ? 'pos' : 'neg'}">${money(principal)}</dd>
            ${Number.isFinite(left) ? `<dt>${T(UI.monthsLeft)}</dt><dd>${left} ${T(UI.monthsUnitShort)}</dd>
            <dt>${T(UI.totalInterest)}</dt><dd class="neg">${money(totalInt)}</dd>
            <dt>${T(UI.payoffSaves)}</dt><dd class="pos">${money(totalInt)}</dd>` : ''}
          </dl>
          ${extra}
        </div>`;
      };

      // Late in a game the portfolio runs to thirty-odd lines of the same few
      // cards. Identical holdings fold into one row with the quantities added
      // up, newest first, and everything past the first handful hides behind a
      // toggle so the panel stays readable (and screenshottable).
      const groups = new Map<string, typeof s.assets>();
      s.assets.forEach((a) => {
        const list = groups.get(a.cardId);
        if (list) list.push(a);
        else groups.set(a.cardId, [a]);
      });
      const order = new Map<string, number>();
      s.assets.forEach((a, i) => order.set(a.cardId, i));
      const grouped = Array.from(groups.values()).sort(
        (a, b) => (order.get(b[0]?.cardId ?? '') ?? 0) - (order.get(a[0]?.cardId ?? '') ?? 0),
      );
      const VISIBLE_ASSETS = 6;
      const hiddenCount = Math.max(0, grouped.length - VISIBLE_ASSETS);
      const shown = assetsExpanded ? grouped : grouped.slice(0, VISIBLE_ASSETS);

      const groupRow = (list: typeof s.assets): string => {
        const first = list[0];
        if (!first) return '';
        if (list.length === 1) return singleAssetRow(first);
        const qty = list.reduce((n, a) => n + a.qty, 0);
        const value = list.reduce((n, a) => n + assetValue(a), 0);
        const flow = list.reduce((n, a) => n + assetCashflow(a), 0);
        const debt = list.reduce((n, a) => n + a.debt, 0);
        const pay = list.reduce((n, a) => n + (a.debt > 0 ? a.mortgagePay : 0), 0);
        const open = openDebt === first.cardId;
        const meta = `${list.length} ${T(UI.holdings)} · ${qty} ${T(UI.units)} · ${money(value)}${debt > 0 ? ` · ${T(UI.liabilities)} ${money(debt)} · ${T(UI.mortgageOn)} ${money(pay)}` : ''}`;
        return `<li class="nn-debt${open ? ' is-open' : ''}">
          <button type="button" class="nn-debt-head" data-act="opendebt" data-id="${first.cardId}" aria-expanded="${open}">
            <span class="nm"><b>${T(first.name)}</b><small>${meta}</small></span>
          </button>
          <span class="amt ${flow !== 0 ? cls(flow) : ''}">${flow !== 0 ? `${signed(flow)}${T(UI.perMonth)}` : '—'}</span>
          ${open ? `<div class="nn-debt-body"><ul class="nn-list nn-sublist">${list.map((a) => singleAssetRow(a, true)).join('')}</ul></div>` : ''}
        </li>`;
      };

      // The house and the car are not holdings, but they are things the player
      // owns, and leaving them off the sheet is what made every starting
      // balance a million baht in the red for living a completely ordinary
      // life. The car row also says the thing a car does: it is worth less
      // every year while the loan on it is not.
      const ownRows = [
        s.hasHome && homeValue(s) > 0
          ? `<li><span class="nm"><b>${T(UI.homeOwned)}</b><small>${T(UI.ownNote)}</small></span><span class="amt">${money(homeValue(s))}</span></li>`
          : '',
        s.hasCar && carValue(s) > 0
          ? `<li><span class="nm"><b>${T(UI.carOwned)}</b><small>${T(UI.carNote)}</small></span><span class="amt">${money(carValue(s))}</span></li>`
          : '',
      ].join('');

      const assetRows = s.assets.length || ownRows
        ? `<ul class="nn-list">${ownRows}${shown.map(groupRow).join('')}</ul>
           ${hiddenCount > 0 || assetsExpanded ? `<button type="button" class="nn-more" data-act="moreassets">${assetsExpanded ? T(UI.showLess) : `${T(UI.showMore)} (${hiddenCount})`}</button>` : ''}`
        : `<p class="nn-empty">${T(UI.noAssets)}</p>`;

      /**
       * `nested` marks a row living inside an opened group. `openDebt` only
       * holds one key at a time, so a nested row could never be opened: tapping
       * its header closed the parent and took the row with it, leaving a
       * mortgage nobody could reach the pay-off button for. Inside a group the
       * detail is simply always shown, since opening the group was the request
       * to see it.
       */
      function singleAssetRow(a: (typeof s.assets)[number], nested = false): string {
        return [a]
            .map((a) => {
              const flow = assetCashflow(a);
              const open = nested || openDebt === a.uid;
              // A holding in the company's name has to say so on its own row, or
              // the two pockets blur back into one on the only screen that lists
              // what is actually owned.
              const owner = isCorpAsset(a) ? `<span class="nn-owner">${T(UI.ownedByCorp)}</span> ` : '';
              const meta = `${owner}${a.qty > 1 ? `${a.qty} ${T(UI.units)} · ` : ''}${money(assetValue(a))}${a.debt > 0 ? ` · ${T(UI.liabilities)} ${money(a.debt)} · ${T(UI.mortgageOn)} ${money(a.mortgagePay)}` : ''}`;
              // A holding that costs money every month has to say so; showing
              // a dash there hid the whole point of the negative-carry cards.
              const amt = `<span class="amt ${flow !== 0 ? cls(flow) : ''}">${flow !== 0 ? `${signed(flow)}${T(UI.perMonth)}` : '—'}</span>`;
              if (a.debt <= 0) {
                // Shares and gold are liquid: their row carries its own sell
                // button and the price it would fetch today.
                if (canSellNow(a)) {
                  const unit = livePrice(s, a);
                  const value = unit * a.qty;
                  const up = unit >= a.costPerUnit;
                  // What was paid, what it is worth now, and the gap as a
                  // percentage. Without the cost basis the price on the row was
                  // a number with nothing to be measured against, so a holding
                  // 40% under water looked exactly like one 40% up.
                  const gain = (unit - a.costPerUnit) * a.qty;
                  const pct = a.costPerUnit > 0 ? (unit / a.costPerUnit - 1) * 100 : 0;
                  const pnl = `<span class="${up ? 'pos' : 'neg'}">${signed(gain)} (${pct >= 0 ? '+' : ''}${pct.toFixed(1)}%)</span>`;
                  // Defaults to the whole holding; a share count can be typed in
                  // to take part of the position off instead.
                  return `<li class="nn-paper">
                    <span class="nm"><b>${T(a.name)}</b><small>${a.qty} ${T(UI.units)} · ${T(UI.costBasis)} ${unitMoney(a.costPerUnit)} · ${T(UI.livePrice)} <span class="${up ? 'pos' : 'neg'}">${unitMoney(unit)}</span>
                      <br>${money(value)} · ${T(UI.unrealised)} ${pnl}</small></span>
                    <span class="nn-rowend">
                      ${a.qty > 1 ? `<input type="number" class="nn-paper-qty" data-qty="${a.uid}" min="1" max="${a.qty}" value="${a.qty}" aria-label="${T(UI.qty)}">` : ''}
                      <button type="button" class="nn-mini" data-act="sellnow" data-id="${a.uid}">${T(UI.sellNow)}</button>
                    </span>
                  </li>`;
                }
                // A business is a living thing: it can be sold, closed, and it
                // wears its trend where the player can see it.
                if (canSellBusiness(a)) {
                  const base = a.baseCashflow ?? 0;
                  const trend = a.volatility && base > 0
                    ? a.cashflowPerUnit > base * 1.05 ? ` · <span class="pos">${T(UI.growing)}</span>`
                    : a.cashflowPerUnit < base * 0.95 ? ` · <span class="neg">${T(UI.shrinking)}</span>` : ''
                    : '';
                  const exit = businessExitValue(a);
                  // Three things on one line is one too many for a 340px
                  // panel, so the figure and the button travel together and
                  // drop to their own line when the name needs the width.
                  return `<li class="nn-paper">
                    <span class="nm"><b>${T(a.name)}</b><small>${meta}${trend}${a.impact ? ` · ${T(UI.impactLabel)} ${a.impact.toLocaleString('en-US')}` : ''}</small></span>
                    <span class="nn-rowend">
                      ${amt}
                      <button type="button" class="nn-mini" data-act="sellbiz" data-id="${a.uid}" title="${T(UI.bizExitNote)}">${exit > 0 ? `${T(UI.sellBiz)} ${money(exit)}` : T(UI.closeBiz)}</button>
                    </span>
                  </li>`;
                }
                return `<li><span class="nm"><b>${T(a.name)}</b><small>${meta}</small></span>${amt}</li>`;
              }
              return `<li class="nn-debt${open ? ' is-open' : ''}">
                ${nested
                  ? `<span class="nn-debt-head is-static"><span class="nm"><b>${T(a.name)}</b><small>${meta}</small></span></span>`
                  : `<button type="button" class="nn-debt-head" data-act="opendebt" data-id="${a.uid}" aria-expanded="${open}">
                  <span class="nm"><b>${T(a.name)}</b><small>${meta}</small></span>
                </button>`}
                ${amt}
                <!-- The pay-off button used to live inside the breakdown, which
                     meant it only existed for players who had already worked out
                     that the row opens. It sits on the row itself now, greyed
                     out when the money is not there, which is how somebody
                     learns the option exists at all. -->
                ${nested ? '' : `<button type="button" class="nn-mini" data-act="clearmortgage" data-id="${a.uid}" ${canClearMortgage(s, a.uid) ? '' : 'disabled'} title="${T(UI.clearMortgage)} ${money(a.debt)}">${T(UI.payoff)}</button>`}
                ${open ? loanBody(a.debt, a.mortgagePay, MORTGAGE_RATE,
                  // The rent, the payment and what is left are laid out in that
                  // order first, so nobody has to work out whether the interest
                  // is being paid out of the rent or out of their pocket.
                  `<dt>${T(UI.rentGross)}</dt><dd class="pos">${money(flow + a.mortgagePay)}</dd>
                   <dt>${T(UI.minusMortgage)}</dt><dd class="neg">-${money(a.mortgagePay)}</dd>
                   <dt class="nn-rowsplit">${T(UI.netToYou)}</dt><dd class="nn-rowsplit ${flow > 0 ? 'pos' : 'neg'}">${money(flow)}</dd>
                   <dt class="nn-rowhead">${T(UI.insideThePayment)}</dt><dd></dd>`,
                  `<button type="button" class="nn-btn nn-btn-gold nn-debt-clear" data-act="clearmortgage" data-id="${a.uid}" ${canClearMortgage(s, a.uid) ? '' : 'disabled'}>${T(UI.clearMortgage)} ${money(a.debt)}</button>`) : ''}
              </li>`;
            })
            .join('');
      }

      const debtRows = s.debts.length
        ? `<ul class="nn-list">${s.debts
            .map((d) => {
              const open = openDebt === d.key;
              return `<li class="nn-debt${open ? ' is-open' : ''}">
                <button type="button" class="nn-debt-head" data-act="opendebt" data-id="${d.key}" aria-expanded="${open}">
                  <span class="nm"><b>${T(debtLabel(d.key))}</b><small>${money(d.balance)} · ${money(d.payment)}${T(UI.perMonth)}</small></span>
                </button>
                <button type="button" class="nn-mini" data-act="repay" data-id="${d.key}" ${canRepay(s, d.key) ? '' : 'disabled'}>${T(UI.payoff)}</button>
                ${open ? loanBody(d.balance, d.payment, d.rate, '', d.key === 'bank' ? `<p class="nn-warnline">${T(UI.bankNote)}</p>` : '') : ''}
              </li>`;
            })
            .join('')}</ul>`
        // With no personal debt but a mortgaged portfolio, "no debts" would
        // contradict the total sitting right above it, so the summary speaks
        // alone in that case.
        : assetDebt(s) > 0 ? '' : `<p class="nn-empty">${T(UI.noDebts)}</p>`;

      const tierName = TIER_NAMES[Math.max(s.tier, tierOf(s)) - 1];
      const owned = ownedDreams(s);
      const impactTotal = s.assets.reduce((n, a) => n + (a.impact ?? 0), 0);

      host.innerHTML = `<h2>${T(UI.statement)}</h2>
        <!-- The headline figures sit above everything, so a screenshot of the
             top of the panel already tells the whole story. -->
        <div class="nn-hero">
          <!-- Every money word on this panel opens its own definition, with
               this game's figures already in it. -->
          <span class="nn-hero-label">${term('netWorth', UI.netWorth)}</span>
          <strong class="nn-hero-figure ${cls(netWorth(s))}">${money(netWorth(s))}</strong>
          <!-- Owning the company means owning its net assets, so they are part
               of this figure. What they are worth as spendable money is less,
               because getting them out is a taxable event, and saying so here is
               the difference between a lesson and a scoreboard. -->
          ${s.incorporated && corpEquity(s) !== 0
            ? `<p class="nn-hero-note">${T(UI.worthIfCashedOut)} <b>${money(worthAfterWindingUp(s))}</b></p>`
            : ''}
          <div class="nn-hero-sub">
            <span><i>${term('passive', s.incorporated ? UI.householdIncomeLabel : UI.passive)}</i><b class="${householdIncome(s) > 0 ? 'pos' : ''}">${money(householdIncome(s))}${T(UI.perMonth)}</b></span>
            <span><i>${term('cashflow', UI.cashflow)}</i><b class="${cls(cf)}">${signed(cf)}</b></span>
            <span><i>${T(UI.cash)}</i><b class="${cls(s.cash)}" data-cash>${money(shownCash)}</b></span>
          </div>
          <p class="nn-hero-tier">${T(UI.tier)} ${Math.max(s.tier, tierOf(s))} · ${tierName ? T(tierName) : ''}${owned.length ? ` · ${T(UI.dreamCollection)} ${owned.length}/${dreams.length}` : ''}</p>
        </div>
        <div class="nn-sec">
          <h3>${T(UI.income)}</h3>
          <dl class="nn-rows">
            <!-- The job was named on the setup screen and nowhere else, so
                 finishing a course and walking into a different career changed
                 nothing the player could actually see. -->
            <dt>${T(UI.jobLabel)}</dt><dd>${T(profession(s).name)}${s.entryPay < 1 ? ` <small class="muted">${Math.round(s.entryPay * 100)}%</small>` : ''}</dd>
            <dt>${T(UI.salary)}</dt><dd class="${noMoreSalary(s) ? 'muted' : ''}">${noMoreSalary(s) ? T(s.quit ? UI.salaryGone : UI.salaryEnded) : money(salary(s))}</dd>
            ${pensionIncome(s) > 0 ? `<dt>${T(pensionLabelOf(s))}</dt><dd class="pos">${money(pensionIncome(s))}</dd>` : ''}
            ${s.incorporated ? `<dt>${T(UI.drawLabel)}</dt><dd class="pos">${money(drawTaken(s))}</dd>` : ''}
            <dt>${T(s.incorporated ? UI.passiveMine : UI.passive)}</dt><dd class="${passive > 0 ? 'pos' : ''}">${money(passive)}</dd>
          </dl>
        </div>
        <div class="nn-sec">
          <h3>${T(UI.expenses)}</h3>
          <dl class="nn-rows">
            <!-- The one number on the sheet nobody can reproduce in their head,
                 so it opens its own working. -->
            <dt><button type="button" class="nn-why" data-act="taxwhy">${T(UI.taxes)}<span aria-hidden="true">?</span></button></dt><dd>${money(taxes(s))}</dd>
            <dt>${T(UI.other)}</dt><dd>${money(livingCost(s))}</dd>
            <!-- The bills that stand where a loan was declined. They are listed
                 separately from the rest of living because the player chose
                 them, and because they are what the mortgage row would say. -->
            ${rentCost(s) > 0 ? `<dt>${T(UI.rentLabel)}</dt><dd>${money(rentCost(s))}</dd>` : ''}
            ${commuteCost(s) > 0 ? `<dt>${T(UI.commuteLabel)}</dt><dd>${money(commuteCost(s))}</dd>` : ''}
            ${s.childBorn.length > 0 ? `<dt>${T(UI.childrenCost)} (${s.childBorn.map((b) => `${childStage(s, b).years}`).join(', ')} ${T(UI.yearsUnit) || 'yr'})<span class="nn-rownote">${T(UI.childHalfNote)} ${money(childExpenseGross(s))}</span></dt><dd>${money(childExpense(s))}</dd>` : ''}
            <!-- The two lines a household has that a single person does not.
                 They are listed apart from the children's own costs because
                 they are separate decisions with separate ways out. -->
            ${childPremium(s) > 0 ? `<dt>${T(UI.childCoverLabel)}</dt><dd>${money(childPremium(s))}</dd>` : ''}
            ${partnerCost(s) > 0 ? `<dt>${T(UI.partnerLabel)}</dt><dd>${money(partnerCost(s))}</dd>` : ''}
            ${tuitionRow(s)}
<!-- The accountant is the company's bill, not the player's. It is listed in
                 the company block below; leaving it here as well showed it twice
                 while only charging it once. -->
            ${s.insuranceCover > 0 ? `<dt>${T(UI.premium)}</dt><dd>${money(insurancePremium(s))}</dd>` : ''}
            ${s.debts.map((d) => `<dt class="sub">${T(debtLabel(d.key))}</dt><dd>${money(d.payment)}</dd>`).join('')}
          </dl>
        </div>
        <div class="nn-big nn-cashrow">
          <span>${term('cashflow', UI.cashflow)}</span>
          <strong class="${cls(cf)}">${signed(cf)}</strong>
        </div>
        <!-- The company's own books. Without this the player had a structure
             they could not see and could not feel: money went in, a tax rate
             changed somewhere, and nothing on the sheet ever said "this is the
             company's, not yours". -->
        ${s.incorporated ? `<div class="nn-sec nn-corp">
          <h3>${T(UI.corpTitle)}</h3>
          <dl class="nn-rows">
            <dt>${T(UI.corpRevenue)}</dt><dd class="${corpRevenue(s) > 0 ? 'pos' : ''}">${money(corpRevenue(s))}</dd>
            <dt class="sub">${T(UI.corpDrawOut)}</dt><dd class="sub">-${money(drawTaken(s))}</dd>
            <dt class="sub">${T(UI.accounting)}</dt><dd class="sub">-${money(CORP_MONTHLY_COST)}</dd>
            <dt class="sub">${T(UI.corpTaxLabel)}</dt><dd class="sub">-${money(corpTaxMonthly(s))}</dd>
            <dt class="nn-rowsplit">${T(UI.corpRetained)}</dt><dd class="nn-rowsplit ${cls(corpRetained(s))}">${signed(corpRetained(s))}${T(UI.perMonth)}</dd>
            <dt>${T(UI.corpCash)}</dt><dd class="${cls(s.corpCash)}">${money(s.corpCash)}</dd>
            <dt class="nn-total">${term('equity', UI.corpEquityLabel)}</dt><dd class="nn-total ${cls(corpEquity(s))}">${money(corpEquity(s))}</dd>
          </dl>
          <button type="button" class="nn-btn nn-btn-gold nn-corpbtn" data-act="corp">${T(UI.corpManage)}</button>
        </div>` : ''}
        <div class="nn-sec">
          <h3>${term('assets', UI.assets)}</h3>
          ${assetRows}
        </div>
        <div class="nn-sec">
          <h3>${term('liabilities', UI.liabilities)}</h3>
          <!-- Mortgages live inside their own asset rows, so without this block
               the liabilities heading reported a fraction of what is owed. -->
          ${totalDebt(s) > 0 ? `<dl class="nn-rows nn-debtsum">
            <dt class="nn-total">${T(UI.totalDebt)}</dt><dd class="nn-total neg">${money(totalDebt(s))}</dd>
            <dt class="sub">${T(UI.personalDebt)}</dt><dd class="sub">${money(personalDebt(s))}</dd>
            <dt class="sub">${T(UI.assetDebt)}</dt><dd class="sub">${money(assetDebt(s))}</dd>
            <dt class="nn-rowsplit">${term('debtService', UI.debtService)}</dt><dd class="nn-rowsplit neg">${money(totalDebtService(s))}${T(UI.perMonth)}</dd>
          </dl>` : ''}
          ${debtRows}
        </div>
        <div class="nn-big">
          <span>${T(UI.karma)}</span><strong class="${s.karma >= 0 ? 'pos' : 'neg'}">${s.karma > 0 ? '+' : ''}${s.karma}</strong>
        </div>
        ${onFast ? `<div class="nn-sec">
          <h3>${T(UI.dreamCollection)} ${owned.length}/${dreams.length}</h3>
          ${owned.length ? `<ul class="nn-dreamlist">${owned.map((d) => `<li><b>${T(d.title)}</b><small>${money(d.cost)}</small></li>`).join('')}</ul>` : ''}
          <p class="nn-empty">${dreamsDone(s) ? T(UI.allDreamsDone) : `${T(UI.yourDream)}: ${T(dreamById.get(s.dreamId)?.title ?? UI.notYet)} · ${money(dreamById.get(s.dreamId)?.cost ?? 0)}`}</p>
        </div>
        <p class="nn-empty" style="margin-top:.6rem">${T(UI.fastGoalLabel)} ${money(fastGoal(s))}${T(UI.perMonth)}</p>` : ''}
        ${legacyUnlocked(s) ? `<div class="nn-sec nn-legacy-sec">
          <h3>${T(UI.legacyTitle)}</h3>
          <dl class="nn-rows">
            <dt>${T(UI.netWorth)}</dt><dd>${money(netWorth(s))}</dd>
            <dt>${T(UI.estateTaxDue)}</dt><dd class="${estateTaxable(s) ? 'neg' : 'muted'}">${estateTaxable(s) ? `-${money(estateTax(s))}` : T(UI.estateTaxNone)}</dd>
            ${s.insuranceCover > 0 ? `<dt>${T(UI.insuranceCover)}</dt><dd class="pos">+${money(s.insuranceCover)}</dd>` : ''}
            ${s.donated > 0 ? `<dt>${T(UI.donatedTotal)}</dt><dd class="pos">+${money(s.donated)}</dd>` : ''}
            ${impactTotal > 0 ? `<dt>${T(UI.impactLabel)}</dt><dd>${impactTotal.toLocaleString('en-US')}</dd>` : ''}
          </dl>
          <div class="nn-big"><span>${T(UI.legacyTitle)}</span><strong class="pos">${money(legacyTotal(s))}</strong></div>
        </div>` : ''}
        ${expenses > 0 && !onFast ? `<p class="nn-empty" style="margin-top:.6rem">${T(UI.escapeNeed)} ${money(expenses)}${T(UI.perMonth)} · ${T(UI.income)} ${money(income)}</p>` : ''}`;
    }

    /* -------------------------------------------------------------- board */

    function ringCell(i: number): { row: number; col: number } {
      if (i < 7) return { row: 1, col: i + 1 };
      if (i < 13) return { row: i - 5, col: 7 };
      if (i < 19) return { row: 7, col: 19 - i };
      return { row: 25 - i, col: 1 };
    }

    function renderBoard(root: Root, s: GameState): void {
      const host = root.querySelector<HTMLElement>('[data-board]');
      if (!host) return;
      const onFast = s.phase === 'fast' || s.phase === 'won';
      const tiles: readonly string[] = onFast ? FAST_BOARD : RAT_BOARD;
      const at = onFast ? s.fastPos : s.pos;

      const cells = tiles
        .map((tile, i) => {
          const { row, col } = ringCell(i);
          const short = TILE_SHORT[tile as keyof typeof TILE_SHORT];
          const long = UI[`tile${tile.charAt(0).toUpperCase()}${tile.slice(1)}` as keyof typeof UI];
          const here = i === at;
          return `<div class="nn-tile nn-tile-${tile}${here ? ' is-here' : ''}${here && flashPay ? ' is-pay' : ''}" style="grid-row:${row};grid-column:${col}" role="img" aria-label="${T(long)}${here ? ' · ' + T(UI.turn) + ' ' + s.turn : ''}">
            <span>${T(short)}</span>${here ? TOKEN_SVG : ''}
          </div>`;
        })
        .join('');

      const tile = tiles[at] ?? 'payday';
      const longName = UI[`tile${tile.charAt(0).toUpperCase()}${tile.slice(1)}` as keyof typeof UI];
      const pct = Math.round((onFast ? fastProgress(s) : escapeProgress(s)) * 100);
      const faces = diceSpin ?? s.lastRoll;
      const dice = faces.length
        ? faces.map((d) => `<span class="nn-die${diceSpin ? ' is-rolling' : ''}">${dieSvg(d)}</span>`).join('')
        : `<span class="nn-die is-idle">${dieSvg(1)}</span>`;
      // While the token is still travelling, the tile under it is not yet the
      // answer to anything, so the readout says so instead of naming it.
      const heading = s.walking > 0 ? `${T(UI.walking)} ${s.walking}` : `<b>${T(longName)}</b>`;

      host.innerHTML = `${cells}
        <div class="nn-center">
          <div class="nn-dice">${dice}</div>
          <p class="nn-here">${heading}</p>
          <div class="nn-meterwrap">
            <div class="nn-meterlabel"><span>${onFast ? T(UI.fastProgressLabel) : T(UI.progress)}</span><span>${pct}%</span></div>
            <div class="nn-meter"><div class="nn-meter-fill${onFast ? ' gold' : ''}" style="width:${pct}%"></div></div>
          </div>
        </div>`;
    }

    /**
     * The countdown only means something while there is still a salary to lose,
     * so it turns into a plain label once the wage has stopped for good.
     */
    function pensionLabelOf(s: GameState): Loc {
      const kind = professionById.get(s.professionId)?.pension;
      return kind === 'civil' ? UI.pensionCivil : kind === 'sso' ? UI.pensionSso : UI.pensionNone;
    }

    /**
     * Tuition is charged as a lump the month a term falls due, so it is shown as
     * a bill on its way rather than as a monthly expense. It used to sit in the
     * expenses list and in `totalExpenses`, which billed it twice.
     */
    function tuitionRow(s: GameState): string {
      const next = tuitionNext(s);
      if (!next) return '';
      const when = next.inMonths <= 0
        ? T(UI.dueThisMonth)
        : `${T(UI.dueInMonths)} ${next.inMonths} ${T(UI.monthsWord)}`;
      return `<dt class="sub">${T(UI.tuitionNextLabel)} · ${when}<small class="nn-rownote">${T(UI.notInCashflow)}</small></dt><dd class="warn">${money(next.amount)}</dd>`;
    }

    function retireLine(s: GameState): string {
      if (s.quit) return '';
      if (noMoreSalary(s)) return `<span class="neg">${T(retiredByAge(s) ? UI.retiredTag : UI.careerEnded)}</span>`;
      const left = monthsToRetire(s);
      if (!Number.isFinite(left)) return `<span class="pos">${T(UI.noRetire)}</span>`;
      return `<span class="${left <= 24 ? 'neg' : ''}">${T(UI.toRetire)} ${Math.round(left / 12)} ${T(UI.monthsWord) === 'months' ? 'yr' : 'ปี'}</span>`;
    }

    function renderControls(root: Root, s: GameState): void {
      const host = root.querySelector<HTMLElement>('[data-controls]');
      if (!host) return;
      const rollable = canRoll(s) && !busy;
      const two = s.charityTurns > 0;
      const borrowable = s.phase === 'rat' && maxBorrow(s) >= LOAN_STEP && !busy;

      if (s.phase === 'won' || s.phase === 'lost') {
        host.innerHTML = `
          <button type="button" class="nn-btn nn-btn-gold" data-act="seeending">${T(UI.seeSummary)}</button>
          ${s.phase === 'won' ? `<button type="button" class="nn-btn nn-btn-go" data-act="resume-run">${T(UI.resumeRun)}</button>` : ''}
          <button type="button" class="nn-btn ${s.phase === 'won' ? '' : 'nn-btn-go'}" data-act="restart-confirm">${T(UI.playAgain)}</button>
          <div class="nn-status"><span>${T(UI.wonBanner)} · ${T(UI.turn)} ${s.turn} · ${s.months} ${T(UI.monthsUnit)}</span></div>`;
        return;
      }

      host.innerHTML = `
        <!-- A card that was pushed aside has to be obvious and it has to be the
             first thing here, because the dice stay locked until it is answered
             and the disabled roll button alone never says why. -->
        ${cardIsHidden(s) ? `<button type="button" class="nn-btn nn-btn-gold nn-cardback" data-act="showcard">${T(UI.backToCard)}</button>` : ''}
        <button type="button" class="nn-btn nn-btn-go" data-act="roll" data-id="1" ${rollable ? '' : 'disabled'}>${T(UI.roll1)}</button>
        ${two ? `<button type="button" class="nn-btn nn-btn-gold" data-act="roll" data-id="2" ${rollable ? '' : 'disabled'}>${T(UI.roll2)}</button>` : ''}
        ${borrowable ? `<button type="button" class="nn-btn" data-act="borrow">${T(UI.borrowBtn)}</button>` : ''}
        <!-- The company used to be reachable only from the legacy tile, which
             needs every dream bought first, so most players never met it. It is
             a decision about a portfolio, so it belongs wherever the portfolio
             is big enough for the question to be real. -->
        ${!busy && (s.incorporated || transferable(s).length > 0) ? `<button type="button" class="nn-btn ${s.incorporated ? '' : 'nn-btn-quiet'}" data-act="corp">${T(s.incorporated ? UI.corpManage : UI.corpOpen)}</button>` : ''}
        ${canQuit(s) && !busy ? `<button type="button" class="nn-btn nn-btn-gold" data-act="quit">${T(UI.quitBtn)}</button>` : ''}
        ${s.quit && !busy ? `<button type="button" class="nn-btn nn-btn-quiet" data-act="endnow">${T(UI.endNow)}</button>` : ''}
        <div class="nn-speed" role="group" aria-label="${T(UI.speed)}">
          <span>${T(UI.speed)}</span>
          <button type="button" data-act="speed" data-id="normal" aria-pressed="${speed === 'normal'}">${T(UI.speedNormal)}</button>
          <button type="button" data-act="speed" data-id="fast" aria-pressed="${speed === 'fast'}">${T(UI.speedFast)}</button>
          <button type="button" data-act="speed" data-id="off" aria-pressed="${speed === 'off'}">${T(UI.speedOff)}</button>
        </div>
        <div class="nn-status">
          <span>${T(UI.turn)} ${s.turn}</span>
          <span>${T(UI.months)} ${s.months}</span>
          <span>${T(UI.age)} ${ageYears(s)} ${T(UI.yearsUnit)}</span>
          ${retireLine(s)}
          ${s.study ? `<span class="warn">${T(UI.studyLabel)} ${T(UI.studyYearOf)} ${studyYear(s).done}/${studyYear(s).total} · ${T(UI.studyingTo)} ${T(professionById.get(s.study.targetId)?.name ?? UI.notYet)}</span>` : ''}
          <!-- Cover was invisible: the player paid the premium, twenty turns
               went by, it lapsed, and the next repair bill arrived at full
               price with nothing on screen having ever mentioned it. -->
          ${!s.hasCar
            ? ''
            : s.carCoverMonths > 0
            ? `<span class="${s.carCoverMonths <= 2 ? 'warn' : 'pos'}">${T(UI.coverChip)} ${s.carCoverMonths} ${T(UI.monthsWord)}</span>`
            : `<span class="neg">${T(UI.coverNone)}</span>`}
          ${s.pet ? `<span>${T(UI.petAtHome)} ${T(petPhrase(s))}</span>` : ''}
          ${s.bondMonths > 0 ? `<span class="warn">${T(UI.bondActive)} ${s.bondMonths}</span>` : ''}
          ${s.slumpMonths > 0 ? `<span class="neg">${T(UI.slumpActive)} ${s.slumpMonths}</span>` : ''}
          ${s.skipTurns > 0 ? `<span class="neg">${T(UI.skipping)} ${s.skipTurns}</span>` : ''}
          ${two ? `<span class="pos">${T(UI.charityLeft)} ${s.charityTurns}</span>` : ''}
        </div>`;
    }

    function renderTier(root: Root, s: GameState): void {
      const host = root.querySelector<HTMLElement>('[data-tier]');
      if (!host) return;
      // The badge shows the rank that was awarded, not a live recomputation:
      // buying a fresh leveraged asset briefly fails the "no debt" test for
      // tier 4, and a title should never be taken back for investing.
      const t = Math.max(s.tier, tierOf(s));
      const name = TIER_NAMES[t - 1];
      host.hidden = false;
      host.innerHTML = `<span class="nn-tier-n">${T(UI.tier)} ${t}</span><span class="nn-tier-name">${name ? T(name) : ''}</span>`;
    }

    function renderLog(root: Root, s: GameState): void {
      const host = root.querySelector<HTMLElement>('[data-logpanel]');
      if (!host) return;
      host.innerHTML = `<h2>${T(UI.log)}</h2>
        <ol class="nn-logl">${s.log.map((e) => `<li class="${e.tone}">${T(e.text)}</li>`).join('')}</ol>`;
    }

    /* ------------------------------------------------------------ dialogs */

    function dialogHtml(s: GameState | null): string | null {
      if (modal === 'rules') return rulesDialog();
      if (modal === 'learn') return learnDialog();
      if (modal === 'confirmRestart') return confirmRestartDialog();
      // A definition is asked for from inside another card, so it answers first
      // and hands the card back when it closes.
      if (modal === 'define' && s && defineKey) return defineDialog(s, defineKey);
      if (!s) return null;
      // A finished game keeps its result on screen until the player dismisses
      // it. Nobody should be rushed off a win they just spent 80 turns earning.
      if ((s.phase === 'won' || s.phase === 'lost') && !endingClosed) return endingDialog(s);
      if (modal === 'tax') return taxDialog(s);
      if (modal === 'corp') return corpDialog(s);
      if (modal === 'fastIntro') return fastIntroDialog(s);
      // Sits on top of the rescue card, since borrowing is one of the two ways
      // out of it.
      if (modal === 'borrow') return borrowDialog(s);
      if (cardIsHidden(s)) return null;
      return pendingDialog(s);
    }

    /**
     * The tax line, shown as the sum it actually is.
     *
     * Each category is laid out the way a filing is: what came in, what the code
     * lets you take off it, and what is left to be taxed. The three that climb
     * the ladder are added up, the allowances come off, and the brackets are
     * walked one at a time so the player can see which one they are standing in
     * and what the next baht would cost. Dividends sit apart, because they are
     * settled at source and never reach the ladder at all.
     */
    function taxDialog(s: GameState): string {
      const b = taxBill(s);
      const perMonth = (n: number): string => money(n / 12);
      const cat = (label: Loc, note: Loc, line: TaxSlice): string =>
        line.gross <= 0
          ? ''
          : `<tr><th>${T(label)}<small>${T(note)}</small></th>
              <td>${perMonth(line.gross)}</td>
              <td class="pos">-${perMonth(line.deduct)}</td>
              <td><b>${perMonth(line.taxable)}</b></td></tr>`;

      // Only the brackets the player has actually reached, plus the one they are
      // standing in, so a ฿26,000 salary does not scroll through eight rows to
      // find out it owes ฿8.
      let left = b.net;
      const rows: string[] = [];
      let floor = 0;
      for (const br of TAX_BRACKETS) {
        const slice = Math.min(Math.max(0, left), br.size);
        const top = Number.isFinite(br.size) ? floor + br.size : Number.POSITIVE_INFINITY;
        const here = slice > 0 && left > 0;
        rows.push(`<tr class="${here && left <= br.size ? 'nn-taxhere' : ''}">
          <th>${money(floor)}${Number.isFinite(top) ? ` - ${money(top)}` : '+'}</th>
          <td>${Math.round(br.rate * 100)}%</td>
          <td>${slice > 0 ? money(slice) : '—'}</td>
          <td class="${slice > 0 && br.rate > 0 ? 'neg' : 'muted'}">${slice > 0 ? money(slice * br.rate) : '—'}</td>
        </tr>`);
        left -= slice;
        floor = Number.isFinite(top) ? top : floor;
        if (left <= 0) break;
      }

      return `<div class="kind">${T(UI.taxes)}</div>
        <h2 id="nn-dlg-title">${T(UI.taxWhyTitle)}</h2>
        <p class="story">${T(UI.taxWhyBody)}</p>
        <figure class="nn-tbl">
          <table>
            <caption>${T(UI.taxByCategory)}</caption>
            <thead><tr><th>${T(UI.taxCatHead)}</th><th>${T(UI.taxGross)}</th><th>${T(UI.taxDeduct)}</th><th>${T(UI.taxTaxable)}</th></tr></thead>
            <tbody>
              ${cat(UI.taxCatSalary, UI.taxCatSalaryNote, b.salary)}
              ${cat(UI.taxCatRent, UI.taxCatRentNote, b.rent)}
              ${cat(UI.taxCatBiz, UI.taxCatBizNote, b.business)}
            </tbody>
          </table>
          <figcaption>${T(UI.taxPerMonthNote)}</figcaption>
        </figure>
        <dl class="facts">
          <dt>${T(UI.taxAllowance)}</dt><dd class="pos">-${perMonth(b.allowance)}</dd>
          <!-- The bridge between the two tables: the first is per month because
               that is how the sheet reads, the ladder is per year because that
               is how the law is written and how everyone quotes it. -->
          <dt class="nn-rowsplit">${T(UI.taxNet)}<small>${T(UI.taxNetBridge)}</small></dt>
          <dd class="nn-rowsplit"><b>${perMonth(b.net)}</b><small>${money(b.net)}${T(UI.perYear)}</small></dd>
        </dl>
        <figure class="nn-tbl">
          <table>
            <caption>${T(UI.taxLadder)}</caption>
            <thead><tr><th>${T(UI.taxBand)}</th><th>${T(UI.taxRate)}</th><th>${T(UI.taxInBand)}</th><th>${T(UI.taxOwed)}</th></tr></thead>
            <tbody>${rows.join('')}</tbody>
          </table>
          <figcaption>${T(UI.taxYearNote)} · ${T(UI.taxMarginalNow)} ${Math.round(marginalRate(b.net) * 100)}%</figcaption>
        </figure>
        <dl class="facts">
          <dt>${T(UI.taxFromLadder)}<small>${money(b.ladderYear)}${T(UI.perYear)}</small></dt><dd class="neg">${perMonth(b.ladderYear)}</dd>
          ${b.dividendGross > 0 ? `<dt>${T(UI.taxDividend)}<small>${T(UI.taxDividendNote)}</small></dt><dd class="neg">${perMonth(b.dividendYear)}</dd>` : ''}
          ${b.corpYear > 0 ? `<dt>${T(UI.taxCorp)}</dt><dd class="neg">${perMonth(b.corpYear)}</dd>` : ''}
          <dt class="nn-rowsplit">${T(UI.taxTotalMonth)}</dt><dd class="nn-rowsplit neg"><b>${money(b.month)}</b></dd>
        </dl>
        <p class="nn-warnline">${T(UI.taxDisclaimer)}</p>
        <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="closemodal">${T(UI.ok)}</button></div>`;
    }

    /**
     * The company desk. Two decisions live here and they pull against each
     * other: what to pay yourself, and what to take out as a dividend.
     *
     * The salary is deductible for the company and taxable for you, so raising
     * it moves money from the company's 15% onto your own ladder. The dividend
     * is not deductible, so it has already paid corporate tax and pays 10% again
     * on the way out. Both numbers are shown with what they actually cost right
     * now rather than described, because the crossover moves as the player grows.
     */
    function corpDialog(s: GameState): string {
      if (!s.incorporated) {
        const saving = corpSaving(s);
        const moving = transferable(s);
        return `<div class="kind">${T(UI.corpTitle)}</div>
          <h2 id="nn-dlg-title">${T(UI.corpSetupTitle)}</h2>
          <p class="story">${T(UI.corpSetupBody)}</p>
          <dl class="facts">
            <dt>${T(UI.corpSetupFee)}<small>${T(UI.corpSetupFeeNote)}</small></dt><dd class="neg">${money(corpSetupTotal(s))}</dd>
            <dt>${T(UI.accounting)}</dt><dd class="neg">${money(CORP_MONTHLY_COST)}${T(UI.perMonth)}</dd>
            <dt>${T(UI.corpMoves)}</dt><dd>${moving.length ? moving.map((a) => T(a.name)).join(' · ') : T(UI.corpMovesNone)}</dd>
            <dt class="nn-rowsplit">${T(UI.corpVerdict)}<small>${T(UI.corpVerdictNote)}</small></dt>
            <dd class="nn-rowsplit ${cls(saving)}"><b>${signed(saving)}${T(UI.perMonth)}</b></dd>
          </dl>
          <p class="nn-warnline">${T(saving > 0 ? UI.corpWorthIt : UI.corpNotYet)}</p>
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="incorporate" ${s.cash >= corpSetupTotal(s) ? '' : 'disabled'}>${s.cash >= corpSetupTotal(s) ? T(UI.corpDoIt) : T(UI.cannotAfford)}</button>
            <button type="button" class="nn-btn nn-btn-quiet" data-act="closemodal">${T(UI.notNow)}</button>
          </div>`;
      }

      const draw = drawTaken(s);
      // What one more ฿10,000 of salary would cost, both ways, so the trade is a
      // number rather than a feeling.
      const step = 10000;
      const more: GameState = { ...s, corpDraw: draw + step };
      const nowKeep = corpRetained(s) + draw - taxes(s);
      const moreKeep = corpRetained(more) + drawTaken(more) - taxes(more);
      return `<div class="kind">${T(UI.corpTitle)}</div>
        <h2 id="nn-dlg-title">${T(UI.corpDeskTitle)}</h2>
        <p class="story">${T(UI.corpDeskBody)}</p>
        <dl class="facts">
          <dt>${T(UI.corpRevenue)}</dt><dd class="pos">${money(corpRevenue(s))}${T(UI.perMonth)}</dd>
          <dt>${T(UI.corpRetained)}</dt><dd class="${cls(corpRetained(s))}">${signed(corpRetained(s))}${T(UI.perMonth)}</dd>
          <dt>${T(UI.corpCash)}</dt><dd class="${cls(s.corpCash)}">${money(s.corpCash)}</dd>
        </dl>
        <div class="nn-qty">
          <label for="nn-draw">${T(UI.drawLabel)}</label>
          <input id="nn-draw" type="number" data-qty="draw" min="0" step="1000" value="${draw}">
          <button type="button" class="nn-btn" data-act="setdraw">${T(UI.setIt)}</button>
        </div>
        <p class="nn-empty">${T(UI.drawTradeNote)} <b class="${cls(moreKeep - nowKeep)}">${signed(moreKeep - nowKeep)}</b> ${T(UI.perMonth)}</p>
        <div class="nn-qty">
          <label for="nn-div">${T(UI.dividendLabel)}</label>
          <input id="nn-div" type="number" data-qty="dividend" min="0" step="10000" value="${Math.max(0, Math.floor(s.corpCash / 10000) * 10000)}">
          <button type="button" class="nn-btn" data-act="paydividend" ${s.corpCash > 0 ? '' : 'disabled'}>${T(UI.takeIt)}</button>
        </div>
        <p class="nn-empty">${T(UI.dividendNote)}</p>
        <div class="nn-qty">
          <label for="nn-fund">${T(UI.fundLabel)}</label>
          <input id="nn-fund" type="number" data-qty="fund" min="0" step="10000" value="0">
          <button type="button" class="nn-btn" data-act="fundcorp" ${s.cash > 0 ? '' : 'disabled'}>${T(UI.putIn)}</button>
        </div>
        <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="closemodal">${T(UI.ok)}</button></div>`;
    }

    /* ------------------------------------------------ learning to play at all */

    /**
     * The board used to open on a dice button with no explanation anywhere
     * except a rules dialog nobody clicks. This is the first thing a new device
     * sees: five short answers and one picture of why the game is shaped the
     * way it is. It never appears again once it has been read.
     */
    function learnDialog(): string {
      const step = (n: number, head: Loc, body: Loc): string =>
        `<div class="nn-learnstep"><span class="nn-learnnum">${n}</span><div><h3>${T(head)}</h3><p>${T(body)}</p></div></div>`;
      return `<div class="kind">${T(UI.learnTitle)}</div>
        <h2 id="nn-dlg-title">${T(UI.gameTitle)}</h2>
        <p class="story">${T(UI.learnLead)}</p>
        ${learnDiagram()}
        ${step(1, UI.learn1, UI.learn1Body)}
        ${step(2, UI.learn2, UI.learn2Body)}
        ${step(3, UI.learn3, UI.learn3Body)}
        ${step(4, UI.learn4, UI.learn4Body)}
        ${step(5, UI.learn5, UI.learn5Body)}
        <div class="nn-acts">
          <button type="button" class="nn-btn nn-btn-go" data-act="learn-done">${T(UI.learnGo)}</button>
          <button type="button" class="nn-btn nn-btn-quiet" data-act="closemodal">${T(UI.learnSkip)}</button>
        </div>`;
    }

    /**
     * The one picture the game is about: a salary that expenses eat, the sliver
     * left over turning into holdings, and the income those holdings pay
     * climbing month by month until it stands taller than the expense bar.
     */
    function learnDiagram(): string {
      const wheel = lang === 'th' ? 'เงินเดือน' : 'Salary';
      const spend = lang === 'th' ? 'รายจ่าย' : 'Expenses';
      const left = lang === 'th' ? 'ส่วนที่เหลือ' : 'What is left';
      const buy = lang === 'th' ? 'ซื้อทรัพย์สินที่จ่ายคืน' : 'Buy things that pay you';
      const flow = lang === 'th' ? 'เงินไหลเข้า' : 'Passive income';
      const win = lang === 'th' ? 'วันที่แท่งนี้สูงกว่ารายจ่าย คือวันที่คุณออกจากวงล้อ' : 'The day this bar clears the expense line, you are off the wheel';
      return `<figure class="nn-dgm">
        <svg viewBox="0 0 640 250" role="img" aria-label="${T(UI.learnDiagram)}">
          <defs>
            <marker id="nn-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
              <path d="M0 0 L10 5 L0 10 z" fill="#7f9bc4"></path>
            </marker>
          </defs>
          <rect x="16" y="30" width="150" height="46" rx="8" fill="#1b2740" stroke="#33507d"></rect>
          <text x="91" y="58" text-anchor="middle" fill="#dbe6f7" font-size="15">${wheel}</text>
          <rect x="16" y="96" width="150" height="46" rx="8" fill="#3a1f24" stroke="#7d3b3b"></rect>
          <text x="91" y="124" text-anchor="middle" fill="#f0cfcf" font-size="15">${spend}</text>
          <line x1="170" y1="86" x2="226" y2="86" stroke="#7f9bc4" stroke-width="2" marker-end="url(#nn-arrow)"></line>
          <rect x="232" y="62" width="140" height="46" rx="8" fill="#1b2740" stroke="#33507d"></rect>
          <text x="302" y="90" text-anchor="middle" fill="#dbe6f7" font-size="15">${left}</text>
          <line x1="302" y1="112" x2="302" y2="150" stroke="#7f9bc4" stroke-width="2" marker-end="url(#nn-arrow)"></line>
          <rect x="212" y="156" width="180" height="44" rx="8" fill="#16301f" stroke="#2f7d4e"></rect>
          <text x="302" y="183" text-anchor="middle" fill="#c9f0d6" font-size="14">${buy}</text>
          <line x1="396" y1="178" x2="446" y2="178" stroke="#7f9bc4" stroke-width="2" marker-end="url(#nn-arrow)"></line>
          <rect x="470" y="176" width="26" height="24" rx="3" fill="#2f9e5c"></rect>
          <rect x="504" y="150" width="26" height="50" rx="3" fill="#2f9e5c"></rect>
          <rect x="538" y="112" width="26" height="88" rx="3" fill="#2f9e5c"></rect>
          <rect x="572" y="60" width="26" height="140" rx="3" fill="#43c47a"></rect>
          <line x1="458" y1="104" x2="614" y2="104" stroke="#b23b3b" stroke-width="2" stroke-dasharray="5 4"></line>
          <text x="614" y="98" text-anchor="end" fill="#f0cfcf" font-size="12">${spend}</text>
          <text x="458" y="220" fill="#9fb6d6" font-size="13">${flow}</text>
        </svg>
        <figcaption>${win}</figcaption>
      </figure>`;
    }

    /* ------------------------------------------------------------- glossary */

    /**
     * Every money word on the statement can be tapped, and what opens is the
     * definition together with this game's own numbers in it. A definition with
     * somebody else's numbers in it is a textbook; a definition with yours in it
     * is an explanation.
     */
    /** Everything owned at today's prices: holdings, plus the house and the car. */
    function ownedTotal(s: GameState): number {
      return s.assets.reduce((n, a) => n + assetValue(a), 0) + homeValue(s) + carValue(s);
    }

    const GLOSSARY = {
      netWorth: {
        term: UI.gloNetWorth,
        body: UI.gloNetWorthBody,
        rows: (s: GameState) => [
          // The house and the car belong in this sum or the four rows do not
          // add up to the figure at the top of the panel.
          [UI.assets, money(ownedTotal(s)), 'pos'],
          [UI.cash, money(s.cash), cls(s.cash)],
          [UI.totalDebt, `-${money(totalDebt(s))}`, 'neg'],
          [UI.netWorth, money(netWorth(s)), cls(netWorth(s))],
        ] as [Loc, string, string][],
      },
      cashflow: {
        term: UI.gloCashflow,
        body: UI.gloCashflowBody,
        rows: (s: GameState) => [
          [UI.income, money(totalIncome(s)), 'pos'],
          [UI.expenses, `-${money(totalExpenses(s))}`, 'neg'],
          [UI.cashflow, signed(monthlyCashflow(s)), cls(monthlyCashflow(s))],
        ] as [Loc, string, string][],
      },
      passive: {
        term: UI.gloPassive,
        body: UI.gloPassiveBody,
        rows: (s: GameState) => [
          [UI.passive, money(householdIncome(s)), 'pos'],
          [UI.expenses, money(totalExpenses(s)), 'neg'],
          [UI.escapeNeed, money(Math.max(0, totalExpenses(s) - householdIncome(s))), ''],
        ] as [Loc, string, string][],
      },
      assets: {
        term: UI.gloAssets,
        body: UI.gloAssetsBody,
        rows: (s: GameState) => [
          [UI.assets, money(ownedTotal(s)), ''],
          [UI.passive, money(passiveIncome(s) + corpRevenue(s)), 'pos'],
        ] as [Loc, string, string][],
      },
      liabilities: {
        term: UI.gloLiabilities,
        body: UI.gloLiabilitiesBody,
        rows: (s: GameState) => [
          [UI.personalDebt, money(personalDebt(s)), 'neg'],
          [UI.assetDebt, money(assetDebt(s)), 'neg'],
          [UI.totalDebt, money(totalDebt(s)), 'neg'],
        ] as [Loc, string, string][],
      },
      debtService: {
        term: UI.gloDebtService,
        body: UI.gloDebtServiceBody,
        rows: (s: GameState) => [
          [UI.debtService, money(totalDebtService(s)), 'neg'],
          [UI.docIncome, money(documentedIncome(s)), ''],
          [UI.dsrLabel, `${documentedIncome(s) > 0 ? Math.round((totalDebtService(s) / documentedIncome(s)) * 100) : 0}%`, ''],
        ] as [Loc, string, string][],
      },
      equity: {
        term: UI.gloEquity,
        body: UI.gloEquityBody,
        rows: (s: GameState) => [
          [UI.corpCash, money(s.corpCash), ''],
          [UI.corpEquityLabel, money(corpEquity(s)), cls(corpEquity(s))],
          [UI.worthIfCashedOut, money(worthAfterWindingUp(s)), ''],
        ] as [Loc, string, string][],
      },
      down: {
        term: UI.gloDown,
        body: UI.gloDownBody,
        rows: () => [] as [Loc, string, string][],
      },
    } satisfies Record<string, { term: Loc; body: Loc; rows: (s: GameState) => [Loc, string, string][] }>;

    type GlossaryKey = keyof typeof GLOSSARY;

    const isGlossaryKey = (k: string): k is GlossaryKey => Object.prototype.hasOwnProperty.call(GLOSSARY, k);

    /** A tappable term: the word itself, with the dotted underline that says so. */
    function term(key: GlossaryKey, label: Loc): string {
      return `<button type="button" class="nn-why" data-act="define" data-id="${key}">${T(label)}<span aria-hidden="true">?</span></button>`;
    }

    function defineDialog(s: GameState, key: GlossaryKey): string {
      const entry = GLOSSARY[key];
      const rows = entry.rows(s);
      return `<div class="kind">${T(UI.whatIsIt)}</div>
        <h2 id="nn-dlg-title">${T(entry.term)}</h2>
        <p class="story">${T(entry.body)}</p>
        ${rows.length ? `<dl class="facts">${rows.map(([l, v, c]) => `<dt>${T(l)}</dt><dd class="${c}">${v}</dd>`).join('')}</dl>` : ''}
        <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="closemodal">${T(UI.close)}</button></div>`;
    }

    function rulesDialog(): string {
      return `<div class="kind">${T(UI.rules)}</div>
        <h2 id="nn-dlg-title">${T(UI.gameTitle)}</h2>
        <h3>${T(UI.rulesGoal)}</h3><p>${T(UI.rulesGoalBody)}</p>
        <h3>${T(UI.rulesTurn)}</h3><p>${T(UI.rulesTurnBody)}</p>
        <h3>${T(UI.rulesMoney)}</h3><p>${T(UI.rulesMoneyBody)}</p>
        <h3>${T(UI.rulesTiers)}</h3><p>${T(UI.rulesTiersBody)}</p>
        <h3>${T(UI.rulesNote)}</h3><p>${T(UI.rulesNoteBody)}</p>
        <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="closemodal">${T(UI.close)}</button></div>`;
    }

    function confirmRestartDialog(): string {
      return `<h2 id="nn-dlg-title">${T(UI.restart)}</h2>
        <p>${lang === 'th' ? 'เกมที่เล่นค้างไว้จะหายไปทั้งหมด แน่ใจไหม' : 'The game in progress will be discarded. Are you sure?'}</p>
        <div class="nn-acts">
          <button type="button" class="nn-btn nn-btn-danger" data-act="restart-confirm">${T(UI.restart)}</button>
          <button type="button" class="nn-btn" data-act="closemodal">${T(UI.close)}</button>
        </div>`;
    }

    /**
     * Borrowing used to be a single ฿10,000 button, which meant a doctor short
     * of ฿180,000 had to press it eighteen times. The amount is asked for once,
     * with the monthly cost of that choice shown before it is made.
     */
    function borrowDialog(s: GameState): string {
      const max = maxBorrow(s);
      const need = Math.min(max, Math.max(LOAN_STEP, Math.ceil(Math.max(0, -s.cash) / LOAN_STEP) * LOAN_STEP));
      const start = s.cash < 0 ? need : Math.min(max, LOAN_STEP);
      const blocked = s.months < s.loanBlockedUntil;
      const review = creditReview(s, Math.max(start, LOAN_STEP));
      const band = review.chance >= 0.8 ? UI.chanceHigh : review.chance >= 0.5 ? UI.chanceMid : UI.chanceLow;
      const bandCls = review.chance >= 0.8 ? 'pos' : review.chance >= 0.5 ? '' : 'neg';
      const FACTOR: Record<string, Loc> = {
        income: UI.factorIncome,
        dsr: UI.factorDsr,
        history: UI.factorHistory,
        buffer: UI.factorBuffer,
      };
      const VERDICT: Record<string, Loc> = { good: UI.verdictGood, fair: UI.verdictFair, poor: UI.verdictPoor };
      // The assessment is written out line by line because every line is
      // something the player did. A refusal that arrives out of nowhere is a
      // dice roll; one that arrives under a debt ratio of 68% is a lesson.
      const factors = review.factors
        .map(
          (f) => `<dt>${T(FACTOR[f.id] ?? UI.factorIncome)}</dt>
            <dd class="${f.verdict === 'good' ? 'pos' : f.verdict === 'poor' ? 'neg' : ''}">${T(VERDICT[f.verdict] ?? UI.verdictFair)}${f.weight !== 0 ? ` <small class="muted">${f.weight > 0 ? '+' : ''}${f.weight}</small>` : ''}</dd>`,
        )
        .join('');
      const history = T(UI.historyLine)
        .replace('{on}', String(s.credit.onTime))
        .replace('{late}', String(s.credit.late))
        .replace('{done}', String(s.credit.cleared));
      return `<div class="kind">${T(UI.creditTitle)}</div>
        <h2 id="nn-dlg-title">${T(UI.borrowTitle)}</h2>
        <p class="story">${T(UI.borrowBody)}</p>
        ${blocked ? `<p class="nn-warnline">${T(UI.loanBlocked).replace('{month}', String(s.loanBlockedUntil))}</p>` : ''}
        <div class="nn-qty">
          <label for="nn-borrow">${T(UI.borrowAmount)}</label>
          <input id="nn-borrow" type="number" data-borrow min="${LOAN_STEP}" max="${max}" step="${LOAN_STEP}" value="${start}">
        </div>
        <p class="nn-empty" data-borrow-note>${T(UI.borrowMonthly)} ${money(start * LOAN_RATE)}</p>
        <div class="nn-credit">
          <h3>${T(UI.creditTitle)}</h3>
          <p class="nn-empty">${T(UI.creditBody)}</p>
          <dl class="facts">
            <dt>${T(UI.docIncome)}</dt><dd>${money(review.income)}${T(UI.perMonth)}</dd>
            <dt>${T(UI.dsrLabel)}</dt><dd class="${review.dsr > DSR_LIMIT * 0.85 ? 'neg' : ''}">${Math.round(review.dsr * 100)}%</dd>
            <dt>${T(UI.dsrCeiling)}</dt><dd>${Math.round(DSR_LIMIT * 100)}%</dd>
            <dt>${T(UI.borrowCeiling)}</dt><dd>${money(max)}</dd>
            ${factors}
            <dt class="nn-rowsplit">${T(UI.creditChance)}</dt><dd class="nn-rowsplit ${bandCls}">${T(band)}</dd>
          </dl>
          <p class="nn-empty">${history}</p>
          <p class="nn-empty">${T(UI.docIncomeNote)}</p>
        </div>
        <div class="nn-acts">
          <button type="button" class="nn-btn nn-btn-go" data-act="borrow-do" ${max >= LOAN_STEP && !blocked ? '' : 'disabled'}>${T(UI.applyLoan)}</button>
          <button type="button" class="nn-btn nn-btn-quiet" data-act="closemodal">${T(UI.cancel)}</button>
        </div>`;
    }

    function fastIntroDialog(s: GameState): string {
      const dream = dreamById.get(s.dreamId);
      return `<div class="kind">${T(UI.fastTitle)}</div>
        <h2 id="nn-dlg-title">${T(UI.wonTitle)}</h2>
        <p>${T(UI.fastIntro)}</p>
        <dl class="facts">
          <dt>${T(UI.fastIncome)}</dt><dd>${money(s.escapeIncome)}</dd>
          <dt>${T(UI.fastGoalLabel)}</dt><dd class="pos">${money(fastGoal(s))}${T(UI.perMonth)}</dd>
          <dt>${T(UI.cash)}</dt><dd>${money(s.cash)}</dd>
          <dt>${T(UI.yourDream)}</dt><dd>${dream ? `${T(dream.title)} · ${money(dream.cost)}` : '—'}</dd>
          <dt>${T(UI.summaryMonths)}</dt><dd>${s.months} ${T(UI.monthsUnit)}</dd>
        </dl>
        <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="closemodal">${T(UI.ok)}</button></div>`;
    }

    /**
     * The pension this career would actually pay at 60, computed against the
     * salary the player would have had by then rather than today's. It is the
     * number the whole run was an argument about.
     */
    function pensionAt60(s: GameState): number {
      const at60: GameState = { ...s, quit: false, careerOver: true, months: Math.max(s.months, (60 - s.startAge) * 12) };
      return pensionIncome(at60);
    }

    function endingDialog(s: GameState): string {
      const won = s.phase === 'won';
      const job = profession(s);
      const done = ownedDreams(s);
      const dreamsSummary = done.length
        ? `${done.length}/${dreams.length} · ${done.map((d) => T(d.title)).join(', ')}`
        : T(UI.notYet);
      const confetti = won && !reducedMotion()
        ? `<div class="nn-confetti" aria-hidden="true">${Array.from({ length: 26 })
            .map((_, i) => {
              const left = Math.round((i * 97) % 100);
              const delay = ((i * 137) % 900) / 1000;
              const dur = 2.2 + ((i * 53) % 120) / 100;
              const hue = ['#5fd694', '#e2b23c', '#4d72a9', '#fff'][i % 4];
              return `<i style="left:${left}%;background:${hue};animation-delay:${delay}s;animation-duration:${dur}s"></i>`;
            })
            .join('')}</div>`
        : '';

      return `${confetti}
        <div class="kind">${won ? T(UI.wonTitle) : T(UI.lostTitle)}</div>
        <h2 id="nn-dlg-title" class="${won ? 'nn-win-title' : ''}">${won ? `${money(netWorth(s))}` : T(UI.lostTitle)}</h2>
        <p>${won ? '' : T(UI.lostBody)}</p>
        <dl class="facts">
          <dt>${T(UI.playedAs)}</dt><dd>${T(job.name)}</dd>
          <dt>${T(UI.tier)}</dt><dd>${Math.max(s.tier, tierOf(s))} · ${T(TIER_NAMES[Math.max(s.tier, tierOf(s)) - 1] ?? UI.notYet)}</dd>
          <dt>${T(UI.dreamCollection)}</dt><dd>${dreamsSummary}</dd>
          <dt>${T(UI.summaryMonths)}</dt><dd>${s.months} ${T(UI.monthsUnit)}</dd>
          <dt>${T(UI.turn)}</dt><dd>${s.turn}</dd>
          <dt>${T(UI.passive)}</dt><dd>${money(householdIncome(s))}${T(UI.perMonth)}</dd>
          <dt>${T(UI.netWorth)}</dt><dd>${money(netWorth(s))}</dd>
          <dt>${T(UI.inflationLabel)}</dt><dd>+${Math.round((priceLevel(s) - 1) * 100)}% ${T(UI.sinceStart)}</dd>
        </dl>
        <!-- The closing argument. What the state would have paid, next to what
             the player built, and what the heirs keep after the taxman. -->
        <div class="nn-sec">
          <h3>${T(UI.ifYouStop)}</h3>
          <dl class="facts">
            <dt>${T(pensionLabelOf(s))}</dt><dd class="${pensionAt60(s) > 0 ? '' : 'neg'}">${money(pensionAt60(s))}${T(UI.perMonth)}</dd>
            <dt>${T(UI.expenses)}</dt><dd class="neg">${money(totalExpenses(s))}${T(UI.perMonth)}</dd>
            <dt>${T(UI.passive)}</dt><dd class="${householdIncome(s) > 0 ? 'pos' : 'neg'}">${money(householdIncome(s))}${T(UI.perMonth)}</dd>
          </dl>
        </div>
        <div class="nn-sec">
          <h3>${T(UI.heirsLabel)} ${heirs(s)}</h3>
          <dl class="facts">
            <dt>${T(UI.perHeir)}</dt><dd>${money(heirShare(s))}</dd>
            <dt>${T(UI.heirTax)}</dt><dd class="${estateTax(s) > 0 ? 'neg' : 'pos'}">${estateTax(s) > 0 ? money(estateTax(s)) : T(UI.heirTaxNone)}</dd>
          </dl>
          <p class="nn-warnline">${T(UI.splitNote)}</p>
        </div>
        <div class="nn-acts">
          <button type="button" class="nn-btn" data-act="closeending">${T(UI.keepLooking)}</button>
          ${won ? `<button type="button" class="nn-btn nn-btn-go" data-act="resume-run">${T(UI.resumeRun)}</button>` : ''}
          <button type="button" class="nn-btn ${won ? '' : 'nn-btn-go'}" data-act="restart-confirm">${T(UI.playAgain)}</button>
        </div>`;
    }

    /**
     * What a quantity actually costs, spelled out under the box. Working out
     * 1,240 shares times ฿42,000 in your head is not the interesting part of
     * the game, and getting it wrong is how you end up staring at a calculator.
     */
    /**
     * What a deck actually holds, priced by the cash it takes to get in. Picking
     * a deck is a blind draw and stays that way, so the least the choice screen
     * can do is say what kind of money each one asks for.
     */
    function deckRange(size: 'small' | 'big' | 'fast' | 'mega'): string {
      const cards = deals.filter((d) => d.size === size);
      const downs = cards.map((d) => d.down);
      const low = Math.min(...downs);
      const high = Math.max(...downs);
      return `${cards.length} ${T(UI.cardsWord)} · ${money(low)}–${money(high)}`;
    }

    /**
     * A per-unit figure below one baht rounds to "+฿0", which reads as a share
     * that pays nothing at all. A ฿40 bank share paying ฿0.34 a month is the
     * whole point of that card, so anything under a baht keeps two decimals.
     */
    function perUnit(flow: number): string {
      if (flow === 0) return '—';
      if (Math.abs(flow) >= 1) return signed(flow);
      return `${flow > 0 ? '+' : '-'}฿${Math.abs(flow).toFixed(2)}`;
    }

    /**
     * The page of the annual report that comes with a share card.
     *
     * Two of the cheap shares in this deck are cheap for opposite reasons, and
     * with only a price and a story on the card there was no way to tell them
     * apart: one earns money and hands it over every month, the other has never
     * earned any. The books are where that difference is visible, so the card
     * prints them and lets the player decide what they are looking at.
     */
    function booksPanel(card: { kind: string; books?: import('../../lib/neeNoo/types').Fundamentals }): string {
      if (card.kind === 'gold') return `<p class="nn-warnline">${T(UI.goldNoBooks)}</p>`;
      const b = card.books;
      if (!b) return '';
      const m = (n: number): string => `${n < 0 ? '-' : ''}฿${Math.abs(n).toLocaleString('en-US')} ${T(UI.bookMillion)}`;
      return `<div class="nn-books">
        <h3>${T(UI.booksTitle)}</h3>
        <dl class="facts">
          <dt>${T(UI.bookRevenue)}</dt><dd>${m(b.revenue)}</dd>
          <dt>${T(UI.bookProfit)}</dt><dd class="${cls(b.profit)}">${m(b.profit)}</dd>
          <dt>${T(UI.bookGrowth)}</dt><dd class="${cls(b.growth)}">${b.growth >= 0 ? '+' : ''}${Math.round(b.growth * 100)}%</dd>
          <dt>${T(UI.bookGearing)}</dt><dd class="${b.gearing >= 2 ? 'neg' : ''}">${b.gearing.toFixed(1)}x</dd>
          <dt>${T(UI.bookPe)}</dt><dd class="${b.pe === 0 ? 'neg' : ''}">${b.pe > 0 ? `${b.pe.toFixed(1)}x` : T(UI.bookNoPe)}</dd>
        </dl>
        <p class="nn-empty">${T(b.note)}</p>
      </div>`;
    }

    function qtyNote(unit: number, flow: number, qty: number): string {
      const n = Math.max(0, qty);
      const total = unit * n;
      const income = flow * n;
      return `${T(UI.totalCost)} <b>${money(total)}</b>${income !== 0 ? ` · ${T(UI.monthlyIn)} <b class="${cls(income)}">${signed(income)}${T(UI.perMonth)}</b>` : ''}`;
    }

    function pendingDialog(s: GameState): string | null {
      const p = s.pending;
      if (!p) return null;

      if (p.kind === 'dealChoice') {
        return `<div class="kind">${T(UI.tileDeal)}</div>
          <h2 id="nn-dlg-title">${T(UI.chooseDeal)}</h2>
          <p class="story">${T(UI.chooseDealHint)}</p>
          <dl class="facts">
            <dt>${T(UI.smallDeal)}</dt><dd>${deckRange('small')}</dd>
            <dt>${T(UI.bigDeal)}</dt><dd>${deckRange('big')}</dd>
          </dl>
          <p class="nn-warnline">${T(UI.deckOneWay)}</p>
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="deal" data-id="small">${T(UI.smallDeal)}</button>
            <button type="button" class="nn-btn nn-btn-gold" data-act="deal" data-id="big">${T(UI.bigDeal)}</button>
            <button type="button" class="nn-btn nn-btn-quiet" data-act="pass">${T(UI.pass)}</button>
          </div>`;
      }

      if (p.kind === 'fastChoice') {
        return `<div class="kind">${T(UI.tileFastdeal)}</div>
          <h2 id="nn-dlg-title">${T(UI.chooseDeal)}</h2>
          <p class="story">${T(UI.chooseFastHint)}</p>
          <dl class="facts">
            <dt>${T(UI.fastDealBtn)}</dt><dd>${deckRange('fast')}</dd>
            <dt>${T(UI.megaDealBtn)}</dt><dd>${deckRange('mega')}</dd>
          </dl>
          <p class="nn-warnline">${T(UI.deckOneWay)}</p>
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="deal" data-id="fast">${T(UI.fastDealBtn)}</button>
            <button type="button" class="nn-btn nn-btn-gold" data-act="deal" data-id="mega">${T(UI.megaDealBtn)}</button>
            <button type="button" class="nn-btn nn-btn-quiet" data-act="pass">${T(UI.pass)}</button>
          </div>`;
      }

      if (p.kind === 'legacy') {
        const tax = estateTax(s);
        const saving = corpSaving(s);
        const give = Math.min(s.cash, Math.max(1000000, Math.round(s.cash * 0.1)));
        const cover = INSURANCE_STEP;
        return `<div class="kind">${T(UI.legacyTitle)}</div>
          <h2 id="nn-dlg-title">${money(legacyTotal(s))}</h2>
          <p class="story">${T(UI.legacyBody)}</p>
          <dl class="facts">
            <dt>${T(UI.netWorth)}</dt><dd>${money(netWorth(s))}</dd>
            <dt>${T(UI.estateTaxDue)}</dt><dd class="${tax > 0 ? 'neg' : ''}">${tax > 0 ? `-${money(tax)}` : T(UI.estateTaxNone)}</dd>
            ${s.insuranceCover > 0 ? `<dt>${T(UI.insuranceCover)}</dt><dd class="pos">+${money(s.insuranceCover)}</dd>` : ''}
            ${s.donated > 0 ? `<dt>${T(UI.donatedTotal)}</dt><dd class="pos">+${money(s.donated)}</dd>` : ''}
          </dl>
          <div class="nn-legacy">
            <button type="button" class="nn-pick" data-act="donate" data-id="${give}" ${s.cash >= 1000000 ? '' : 'disabled'}>
              <h3>${T(UI.optFoundation)}</h3>
              <p>${T(UI.optFoundationBody)}</p>
              <dl><dt>${T(UI.give)}</dt><dd class="pos">${money(give)}</dd></dl>
            </button>
            <button type="button" class="nn-pick" data-act="corp" ${s.incorporated ? 'disabled' : ''}>
              <h3>${T(UI.optCompany)}${s.incorporated ? ` · ${T(UI.alreadyDone)}` : ''}</h3>
              <p>${T(UI.optCompanyBody)}</p>
              <dl>
                <dt>${T(UI.setupCost)}</dt><dd>${money(corpSetupTotal(s))}</dd>
                <dt>${T(UI.savedPerMonth)}</dt><dd class="${saving > 0 ? 'pos' : 'warn'}">${signed(saving)}</dd>
              </dl>
            </button>
            <button type="button" class="nn-pick" data-act="insure" data-id="${cover}" ${s.cash >= 0 ? '' : 'disabled'}>
              <h3>${T(UI.optInsurance)}</h3>
              <p>${T(UI.optInsuranceBody)}</p>
              <dl>
                <dt>${T(UI.coverAdded)}</dt><dd class="pos">+${money(cover)}</dd>
                <dt>${T(UI.premium)}</dt><dd class="neg">${money(Math.round(cover * INSURANCE_PREMIUM_RATE))}${T(UI.perMonth)}</dd>
              </dl>
            </button>
          </div>
          <p class="nn-warnline">${T(UI.legacyDisclaimer)}</p>
          <div class="nn-acts"><button type="button" class="nn-btn nn-btn-quiet" data-act="closelegacy">${T(UI.pass)}</button></div>`;
      }

      if (p.kind === 'deal') {
        const card = dealById.get(p.cardId);
        if (!card) return null;
        const per = dealDown(s, card);
        const max = maxAffordable(s, card);
        // Two buyers means two budgets. The quantity box is sized to whichever
        // pocket could take more, so a company with the cash is never capped by
        // what the player happens to be carrying.
        const byCorp = canBuyAsCorp(s, card);
        const corpMax = byCorp ? maxAffordable(s, card, 'corp') : 0;
        const maxAny = Math.max(max, corpMax);
        const kindLabel =
          card.size === 'small' ? UI.smallDeal
          : card.size === 'big' ? UI.bigDeal
          : card.size === 'fast' ? UI.fastDealBtn
          : UI.megaDealBtn;
        return `<div class="kind">${T(kindLabel)}</div>
          <h2 id="nn-dlg-title">${T(card.title)}</h2>
          <p class="story">${T(card.story)}</p>
          <dl class="facts">
            <dt>${T(UI.price)}</dt><dd>${money(dealPrice(s, card))}${card.maxQty > 1 ? ` / ${T(UI.units)}` : ''}</dd>
            ${card.debt > 0 ? `<dt>${term('down', UI.downPayment)}</dt><dd>${money(per)}</dd><dt>${T(UI.loanTaken)}</dt><dd>${money(card.debt)}</dd><dt>${T(UI.mortgageOn)}</dt><dd class="neg">${money(card.mortgagePay ?? 0)}${T(UI.perMonth)}</dd>` : ''}
            <dt>${T(UI.monthlyIn)}</dt><dd class="${card.cashflow !== 0 ? cls(card.cashflow) : ''}">${card.cashflow !== 0 ? `${perUnit(card.cashflow)}${card.maxQty > 1 ? ` / ${T(UI.units)}` : ''}` : '—'}</dd>
            ${card.cashflow > 0 && dealPrice(s, card) > 0 ? `<dt>${T(UI.yearlyYield)}</dt><dd class="pos">${((card.cashflow * 12 * 100) / dealPrice(s, card)).toFixed(1)}%</dd>` : ''}
            ${card.cashflow < 0 ? `<dt>${T(UI.carryCost)}</dt><dd class="neg">${money(Math.abs(card.cashflow) * 12)}${T(UI.perYear)}</dd>` : ''}
            ${card.volatility ? `<dt>${T(UI.swingLabel)}</dt><dd class="warn">${Math.round(card.volatility * 100)}%</dd>` : ''}
            ${card.impact ? `<dt>${T(UI.impactLabel)}</dt><dd>${card.impact.toLocaleString('en-US')}</dd>` : ''}
            <dt>${T(UI.cash)}</dt><dd>${money(s.cash)}</dd>
            ${byCorp ? `<dt>${T(UI.corpCash)}</dt><dd class="${cls(s.corpCash)}">${money(s.corpCash)}</dd>` : ''}
          </dl>
          ${booksPanel(card)}
          ${card.debt > 0 ? `<p class="nn-warnline">${T(UI.leverageNote)}</p>` : ''}
          ${byCorp ? `<p class="nn-empty">${T(UI.buyAsCorpNote)}</p>` : ''}
          ${maxAny > 1 ? `<div class="nn-qty"><label for="nn-qty">${T(UI.qty)} (1–${maxAny})</label><input id="nn-qty" type="number" data-qty data-unit="${per}" data-flow="${card.cashflow}" data-max="${maxAny}" min="1" max="${maxAny}" value="${maxAny}"></div>
          <p class="nn-empty" data-qty-note>${qtyNote(per, card.cashflow, maxAny)}</p>` : ''}
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="buy" ${max > 0 ? '' : 'disabled'}>${max > 0 ? T(byCorp ? UI.buyAsMe : UI.buy) : T(UI.cannotAfford)}</button>
            ${byCorp ? `<button type="button" class="nn-btn nn-btn-gold" data-act="buycorp" ${corpMax > 0 ? '' : 'disabled'}>${corpMax > 0 ? T(UI.buyAsCorp) : T(UI.corpCannotAfford)}</button>` : ''}
            <button type="button" class="nn-btn nn-btn-quiet" data-act="pass">${T(UI.pass)}</button>
          </div>`;
      }

      if (p.kind === 'market') {
        const card = marketById.get(p.cardId);
        if (!card) return null;
        const matches = marketMatches(s, card);
        const rows = matches.length
          ? matches
              .map((a) => {
                const unit = marketUnitPrice(card, a);
                const debtShare = a.qty > 0 ? a.debt / a.qty : 0;
                return `<div class="nn-sellrow">
                  <span class="nm"><b>${T(a.name)}</b><small>${T(UI.offerPrice)} ${money(unit)}${a.qty > 1 ? ` / ${T(UI.units)}` : ''}${debtShare > 0 ? ` · ${T(UI.liabilities)} ${money(debtShare)}` : ''}</small></span>
                  ${a.qty > 1 ? `<input type="number" data-qty="${a.uid}" min="1" max="${a.qty}" value="${a.qty}" aria-label="${T(UI.qty)}">` : ''}
                  <button type="button" class="nn-btn" data-act="sell" data-id="${a.uid}">${T(UI.sell)}</button>
                </div>`;
              })
              .join('')
          : '';
        // A quoted price is not only an exit. When it comes in under the price
        // the thing normally trades at, the useful move is the opposite one, so
        // the card carries its own buy counter next to the sell rows.
        const offer = marketBuy(s);
        let buyBox = '';
        if (offer) {
          const { card: deal, unit, max } = offer;
          const gap = deal.price > 0 ? (unit - deal.price) / deal.price : 0;
          const cheap = gap <= -0.01;
          const badge = Math.abs(gap) >= 0.01
            ? ` <span class="${cheap ? 'pos' : 'neg'}">${T(cheap ? UI.belowNormal : UI.aboveNormal)} ${Math.abs(Math.round(gap * 100))}%</span>`
            : '';
          buyBox = `<div class="nn-buybox">
            <h3>${T(UI.buyAtThisPrice)} · ${T(deal.title)}</h3>
            <dl class="facts">
              <dt>${T(UI.price)}</dt><dd>${money(unit)}${deal.maxQty > 1 ? ` / ${T(UI.units)}` : ''}${badge}</dd>
              ${deal.cashflow > 0 ? `<dt>${T(UI.yearlyYield)}</dt><dd class="pos">${((deal.cashflow * 12 * 100) / unit).toFixed(1)}%</dd>` : ''}
              <dt>${T(UI.cash)}</dt><dd>${money(s.cash)}</dd>
            </dl>
            ${cheap && deal.cashflow > 0 ? `<p class="nn-warnline">${T(UI.cheapYieldNote)}</p>` : ''}
            ${max > 1 ? `<div class="nn-qty"><label for="nn-buyqty">${T(UI.qty)} (1–${max})</label><input id="nn-buyqty" type="number" data-qty="buy" data-unit="${unit}" data-flow="${deal.cashflow}" data-max="${max}" min="1" max="${max}" value="${max}"></div>
            <p class="nn-empty" data-qty-note>${qtyNote(unit, deal.cashflow, max)}</p>` : ''}
            <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="marketbuy" ${max > 0 ? '' : 'disabled'}>${max > 0 ? T(UI.buy) : T(UI.cannotAfford)}</button></div>
          </div>`;
        }
        // The story is written as if the thing is already yours, so when it is
        // not, the card has to carry on the same sentence instead of printing a
        // flat "you hold nothing" underneath a developer waving a cheque.
        const empty = !rows && !buyBox ? `<p class="story nn-but">${T(UI.butNoHolding)}</p>` : '';
        const idle = matches.length || offer;
        return `<div class="kind">${T(UI.tileMarket)}</div>
          <h2 id="nn-dlg-title">${T(card.title)}</h2>
          <p class="story">${T(card.story)}</p>
          <div style="margin-top:1rem">${rows}${empty}</div>
          ${buyBox}
          <div class="nn-acts"><button type="button" class="nn-btn ${idle ? 'nn-btn-quiet' : 'nn-btn-go'}" data-act="closemarket">${offer ? T(UI.marketNone) : matches.length ? T(UI.sellNone) : T(UI.ok)}</button></div>`;
      }

      if (p.kind === 'doodad') {
        const card = doodadById.get(p.cardId);
        if (!card) return null;
        // Cards are written with a hole where the animal goes, so the vet bill
        // belongs to whichever creature this game rolled.
        const title = fillCard(s, card.title);
        const story = fillCard(s, card.story);
        const cost = doodadCost(s, card);
        const covered = coveredNow(s, card);
        const full = uninsuredCost(s, card);
        return `<div class="kind">${T(UI.tileDoodad)}</div>
          <h2 id="nn-dlg-title">${T(title)}</h2>
          <p class="story">${T(story)}</p>
          <dl class="facts">
            ${card.insurable ? `<dt>${T(UI.repairBill)}</dt><dd class="neg">${money(full)}</dd>
            <dt>${T(covered ? UI.insurancePays : UI.noCover)}</dt><dd class="${covered ? 'pos' : 'neg'}">${covered ? `-${money(full - cost)}` : T(UI.youPayItAll)}</dd>` : ''}
            <dt>${T(card.insurable ? UI.youPay : UI.pay)}</dt><dd class="${cost > 0 ? 'neg' : ''}">${cost > 0 ? money(cost) : '—'}</dd>
            <dt>${T(UI.cash)}</dt><dd>${money(s.cash)}</dd>
          </dl>
          ${card.id === 'x-insurance' ? `<p class="nn-warnline">${T(s.carCoverMonths > 0 ? UI.coverInForce : UI.coverLapsed)}</p>` : ''}
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="paydoodad">${cost > 0 ? `${T(UI.pay)} ${money(cost)}` : T(UI.ok)}</button>
            ${card.instalment ? `<button type="button" class="nn-btn nn-btn-gold" data-act="instalment">${T(UI.instalmentBtn)}</button>` : ''}
            ${card.optional ? `<button type="button" class="nn-btn nn-btn-quiet" data-act="declinedoodad">${T(UI.decline)}</button>` : ''}
          </div>`;
      }

      if (p.kind === 'birthday' || p.kind === 'schoolfee') {
        const gift = p.kind === 'birthday';
        const card = doodadById.get(gift ? 'x-gift' : 'x-school');
        if (!card) return null;
        const cost = gift ? birthdayCost(s) : schoolFee(s);
        // Naming the ages is the point: the bill grew because they did.
        const kids = gift ? s.childBorn.map((b) => childStage(s, b)) : schoolChildren(s);
        return `<div class="kind">${T(UI.tileDoodad)}</div>
          <h2 id="nn-dlg-title">${T(card.title)}</h2>
          <p class="story">${T(card.story)}</p>
          <dl class="facts">
            <dt>${T(gift ? UI.childrenTurn : UI.childrenAtSchool)}</dt><dd>${kids.map((c) => `${c.years} ${T(UI.yearsUnit)} (${T(c.label)})`).join(' · ')}</dd>
            <dt>${T(UI.pay)}</dt><dd class="neg">${money(cost)}</dd>
            <dt>${T(UI.cash)}</dt><dd>${money(s.cash)}</dd>
          </dl>
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="${gift ? 'paybirthday' : 'payschool'}">${T(UI.pay)} ${money(cost)}</button>
            ${gift ? `<button type="button" class="nn-btn nn-btn-quiet" data-act="skipbirthday">${T(UI.decline)}</button>` : ''}
          </div>`;
      }

      if (p.kind === 'baby') {
        const full = s.children >= MAX_CHILDREN;
        return `<div class="kind">${T(UI.tileBaby)}</div>
          <h2 id="nn-dlg-title">${T(UI.tileBaby)}</h2>
          <p class="story">${T(UI.babyBody)}</p>
          <!-- Both figures, because the household's number is the one people
               quote and the half is the one that lands on this statement. The
               teenage figure is here so the decision is made against the whole
               of it rather than against the cheapest year of it. -->
          ${full ? '' : `<dl class="facts">
            <dt>${T(UI.childCostHousehold)}</dt><dd class="neg">${money(nextChildCostGross(s))}${T(UI.perMonth)}</dd>
            <dt>${T(UI.childCostNow)}</dt><dd class="neg">${money(nextChildCost(s))}${T(UI.perMonth)}</dd>
            <dt>${T(UI.childCostLater)}</dt><dd class="neg">${money(Math.round(nextChildCost(s) * 2.4))}${T(UI.perMonth)}</dd>
            ${s.children === 0 ? `<dt>${T(UI.partnerLabel)}</dt><dd class="neg">${money(Math.round(livingCost(s) * PARTNER_SHARE))}${T(UI.perMonth)}</dd>` : ''}
            <dt>${T(UI.cashflow)}</dt><dd class="${cls(monthlyCashflow(s))}">${signed(monthlyCashflow(s))}${T(UI.perMonth)}</dd>
          </dl>
          <p class="nn-empty">${T(UI.childShareNote)}</p>`}
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="baby">${T(full ? UI.ok : UI.welcomeChild)}</button>
            ${full ? '' : `<button type="button" class="nn-btn nn-btn-quiet" data-act="nobaby">${T(UI.notNow)}</button>`}
          </div>`;
      }

      if (p.kind === 'retired') {
        const pension = pensionIncome(s);
        const gap = totalExpenses(s) - pension - householdIncome(s);
        return `<div class="kind">${T(UI.retiredTag)}</div>
          <h2 id="nn-dlg-title">${T(UI.retiredTitle)}</h2>
          <p class="story">${T(UI.retiredBody)}</p>
          <dl class="facts">
            <dt>${T(UI.salary)}</dt><dd class="muted">${T(UI.salaryGone)}</dd>
            <dt>${T(pensionLabelOf(s))}</dt><dd class="${pension > 0 ? 'pos' : 'neg'}">${money(pension)}${T(UI.perMonth)}</dd>
            <dt>${T(UI.passive)}</dt><dd class="${householdIncome(s) > 0 ? 'pos' : ''}">${money(householdIncome(s))}${T(UI.perMonth)}</dd>
            <dt>${T(UI.expenses)}</dt><dd class="neg">${money(totalExpenses(s))}${T(UI.perMonth)}</dd>
            <dt class="nn-rowsplit">${T(UI.cashflow)}</dt><dd class="nn-rowsplit ${cls(-gap)}">${signed(-gap)}${T(UI.perMonth)}</dd>
          </dl>
          <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="retiredok">${T(UI.ok)}</button></div>`;
      }

      if (p.kind === 'graduated') {
        const from = professionById.get(s.graduatedFrom ?? '');
        const now = profession(s);
        const wasCost = from ? Math.round(from.otherExpenses * priceLevel(s)) : 0;
        return `<div class="kind">${T(UI.gradTag)}</div>
          <h2 id="nn-dlg-title">${T(UI.gradTitle)}</h2>
          <p class="story">${T(UI.gradBody)}</p>
          <dl class="facts">
            <dt>${T(UI.gradFrom)}</dt><dd class="muted">${from ? T(from.name) : '—'}</dd>
            <dt>${T(UI.gradTo)}</dt><dd><b>${T(now.name)}</b></dd>
            <dt>${T(UI.salary)}</dt><dd class="pos">${money(salary(s))}${T(UI.perMonth)} · ${Math.round(s.entryPay * 100)}% ${T(UI.ofThatJob)}</dd>
            <dt>${T(UI.other)}</dt><dd class="${livingCost(s) > wasCost ? 'neg' : 'pos'}">${money(wasCost)} → ${money(livingCost(s))}</dd>
            <dt class="nn-rowsplit">${T(UI.cashflow)}</dt><dd class="nn-rowsplit ${cls(monthlyCashflow(s))}">${signed(monthlyCashflow(s))}${T(UI.perMonth)}</dd>
          </dl>
          <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="gradok">${T(UI.ok)}</button></div>`;
      }

      if (p.kind === 'reward') {
        const exam = rewardKind(s) === 'exam';
        const cost = rewardCost(s);
        return `<div class="kind">${T(exam ? UI.rewardExamTag : UI.rewardPetTag)}</div>
          <h2 id="nn-dlg-title">${T(fillCard(s, exam ? UI.rewardExamTitle : UI.rewardPetTitle))}</h2>
          <p class="story">${T(fillCard(s, exam ? UI.rewardExamBody : UI.rewardPetBody))}</p>
          <dl class="facts">
            ${exam ? `<dt>${T(UI.childrenCost)}</dt><dd>${s.childBorn.map((b) => `${childStage(s, b).years} ${T(UI.yearsUnit)}`).join(' · ')}</dd>` : ''}
            <dt>${T(UI.rewardPay)}</dt><dd class="neg">${money(cost)}</dd>
            <dt>${T(UI.cash)}</dt><dd class="${s.cash >= cost ? '' : 'neg'}">${money(s.cash)}</dd>
          </dl>
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="payreward">${T(UI.rewardPay)} ${money(cost)}</button>
            <button type="button" class="nn-btn nn-btn-quiet" data-act="skipreward">${T(UI.rewardSkip)}</button>
          </div>`;
      }

      if (p.kind === 'career') {
        // Every route is shown even when it cannot be afforded, because seeing
        // the price of the door you cannot open is most of the lesson.
        const cards = studyRoutes
          .map((r) => {
            const targets = routeTargets(s, r);
            const first = targets[0];
            const perTerm = Math.round(r.tuition / r.terms);
            const ok = canEnrol(s, r) && !!first;
            return `<div class="nn-route">
              <h3>${T(r.title)}</h3>
              <p>${T(r.story)}</p>
              <dl class="facts">
                <dt>${T(UI.courseMonths)}</dt><dd>${r.months} ${T(UI.monthsWord)}</dd>
                <dt>${T(UI.totalTuition)}</dt><dd class="neg">${money(r.tuition)}</dd>
                <dt>${T(UI.firstTerm)}</dt><dd class="${s.cash >= perTerm ? '' : 'neg'}">${money(perTerm)}</dd>
                ${r.licenceFee > 0 ? `<dt>${T(UI.licenceTitle)}</dt><dd class="neg">${money(r.licenceFee)}</dd>` : ''}
                <dt>${T(UI.entryPayLabel)}</dt><dd>${Math.round(r.entrySalary * 100)}% ${T(UI.ofThatJob)}</dd>
                <dt>${T(UI.salary)}</dt><dd class="${r.fullTime ? 'neg' : 'pos'}">${T(r.fullTime ? UI.noSalaryWhile : UI.keepWorking)}</dd>
              </dl>
              ${targets.length ? `<label class="nn-qty"><span>${T(UI.pickTarget)}</span>
                <select data-target="${r.id}">${targets.map((t) => `<option value="${t.id}">${T(t.name)} · ${money(t.salary)}</option>`).join('')}</select></label>` : ''}
              <button type="button" class="nn-btn nn-btn-go" data-act="enrol" data-id="${r.id}" ${ok ? '' : 'disabled'}>${ok ? T(UI.enrolBtn) : T(UI.cannotAfford)}</button>
            </div>`;
          })
          .join('');
        return `<div class="kind">${T(UI.tileDownsized)}</div>
          <h2 id="nn-dlg-title">${T(UI.careerTitle)}</h2>
          <p class="story">${T(UI.careerBody)}</p>
          <div class="nn-routes">${cards}</div>
          <div class="nn-acts"><button type="button" class="nn-btn nn-btn-quiet" data-act="keepjob">${T(UI.keepJob)}</button></div>`;
      }

      if (p.kind === 'licence') {
        const route = studyRouteById.get(p.routeId);
        if (!route) return null;
        const fee = route.licenceFee;
        return `<div class="kind">${T(UI.studyLabel)}</div>
          <h2 id="nn-dlg-title">${T(UI.licenceTitle)}</h2>
          <p class="story">${T(UI.licenceBody)}</p>
          <dl class="facts">
            <dt>${T(UI.licenceTitle)}</dt><dd class="neg">${money(fee)}</dd>
            <dt>${T(UI.cash)}</dt><dd class="${s.cash >= fee ? '' : 'neg'}">${money(s.cash)}</dd>
          </dl>
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="licence" data-id="cash" ${s.cash >= fee ? '' : 'disabled'}>${T(UI.payCash)}</button>
            <button type="button" class="nn-btn" data-act="licence" data-id="loan">${T(UI.payLoan)}</button>
            <button type="button" class="nn-btn nn-btn-gold" data-act="licence" data-id="bond">${T(UI.payBond)}</button>
          </div>
          <p class="nn-warnline">${T(UI.bondNote)}</p>`;
      }

      if (p.kind === 'downsized') {
        // Two months of bills with no salary behind them, against the severance
        // paid today. Passive income big enough to cover the gap leaves the
        // player ahead, and the row says so rather than reporting a loss of ฿0.
        const monthlyGap = Math.max(0, totalExpenses(s) - householdIncome(s));
        const net = severance(s) - 2 * monthlyGap;
        return `<div class="kind">${T(UI.tileDownsized)}</div>
          <h2 id="nn-dlg-title">${T(UI.tileDownsized)}</h2>
          <p class="story">${T(UI.downsizedBody)}</p>
          <dl class="facts">
            <dt>${T(UI.expenses)}</dt><dd class="neg">${money(totalExpenses(s))}${T(UI.perMonth)}</dd>
            <dt>${T(UI.passive)}</dt><dd class="${householdIncome(s) > 0 ? 'pos' : ''}">${money(householdIncome(s))}${T(UI.perMonth)}</dd>
            <dt>${T(UI.severance)}</dt><dd class="pos">${signed(severance(s))}</dd>
            <dt>${T(net < 0 ? UI.downsizedCost : UI.downsizedSpare)}</dt><dd class="${cls(net)}">${signed(net)}</dd>
          </dl>
          ${!s.quit && householdIncome(s) >= totalExpenses(s) ? `<p class="nn-warnline">${T(UI.quitPaused)}</p>` : ''}
          <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="downsized">${T(UI.ok)}</button></div>`;
      }

      if (p.kind === 'charity') {
        const cost = charityCost(s);
        return `<div class="kind">${T(UI.tileCharity)}</div>
          <h2 id="nn-dlg-title">${T(UI.tileCharity)}</h2>
          <p class="story">${T(UI.charityBody)}</p>
          <dl class="facts"><dt>${T(UI.give)}</dt><dd>${money(cost)}</dd><dt>${T(UI.cash)}</dt><dd>${money(s.cash)}</dd></dl>
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="charity-give" ${s.cash >= cost ? '' : 'disabled'}>${T(UI.give)}</button>
            <button type="button" class="nn-btn nn-btn-quiet" data-act="charity-skip">${T(UI.dontGive)}</button>
          </div>`;
      }

      if (p.kind === 'quit') {
        return `<div class="kind">${T(UI.quitTitle)}</div>
          <h2 id="nn-dlg-title">${T(UI.quitTitle)}</h2>
          <p class="story">${T(UI.quitBody)}</p>
          <dl class="facts">
            <dt>${T(UI.quitLose)}</dt><dd class="neg">${money(salary(s))}${T(UI.perMonth)}</dd>
            <dt>${T(UI.quitKeep)}</dt><dd class="pos">${money(householdIncome(s))}${T(UI.perMonth)}</dd>
            <dt>${T(UI.quitBills)}</dt><dd>${money(totalExpenses(s))}${T(UI.perMonth)}</dd>
          </dl>
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="quit">${T(UI.quitNow)}</button>
            <button type="button" class="nn-btn nn-btn-quiet" data-act="stay">${T(UI.stayOn)}</button>
          </div>`;
      }

      if (p.kind === 'friend') {
        return `<div class="kind">${T(UI.friendTitle)}</div>
          <h2 id="nn-dlg-title">${T(UI.friendTitle)}</h2>
          <p class="story">${T(UI.friendBody)}</p>
          <dl class="facts"><dt>${T(UI.karma)}</dt><dd class="pos">${s.karma}</dd></dl>
          <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="friend">${T(UI.friendAccept)}</button></div>`;
      }

      if (p.kind === 'tierUp') {
        const name = TIER_NAMES[p.tier - 1];
        const confetti = reducedMotion() ? '' : `<div class="nn-confetti" aria-hidden="true">${Array.from({ length: 18 })
          .map((_, i) => `<i style="left:${(i * 89) % 100}%;background:${['#5fd694', '#e2b23c', '#4d72a9', '#fff'][i % 4]};animation-delay:${((i * 131) % 800) / 1000}s;animation-duration:${2 + ((i * 47) % 90) / 100}s"></i>`)
          .join('')}</div>`;
        return `${confetti}
          <div class="kind">${T(UI.tierUpTitle)}</div>
          <h2 id="nn-dlg-title" class="nn-win-title">${T(UI.tier)} ${p.tier} · ${name ? T(name) : ''}</h2>
          <dl class="facts">
            <dt>${T(UI.passive)}</dt><dd class="pos">${money(householdIncome(s))}${T(UI.perMonth)}</dd>
            <dt>${T(UI.netWorth)}</dt><dd>${money(netWorth(s))}</dd>
          </dl>
          <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="tierok">${T(UI.keepPlaying)}</button></div>`;
      }

      if (p.kind === 'rescue') {
        // Sorted by what each sale actually raises, because in a panic the
        // useful ones have to be at the top. A heavily mortgaged property
        // raises nothing at all, and the row now shows the subtraction that
        // gets it to nothing instead of printing a bare ฿0 nobody can explain.
        const rows = s.assets
          .slice()
          .sort((a, b) => fireSaleValue(b, b.qty) - fireSaleValue(a, a.qty))
          .map((a) => {
            const raised = fireSaleValue(a, a.qty);
            const short = fireSaleShortfall(a, a.qty);
            const half = a.pricePerUnit * FIRE_SALE_RATE * a.qty;
            const flow = assetCashflow(a);
            return `<div class="nn-sellrow">
              <span class="nm"><b>${T(a.name)}</b><small>${T(UI.offerPrice)} <b class="${raised > 0 ? 'pos' : 'neg'}">${money(raised)}</b>${a.qty > 1 ? ` (${a.qty} ${T(UI.units)})` : ''}
                <br>${T(UI.halfPrice)} ${money(half)}${a.debt > 0 ? ` · ${T(UI.minusItsDebt)} ${money(a.debt)}` : ''}${flow > 0 ? ` · ${T(UI.andLoses)} ${money(flow)}${T(UI.perMonth)}` : ''}
                ${short > 0 ? `<br><b class="neg">${T(UI.stillOwed)} ${money(short)}</b> · ${T(UI.deficiencyPay)} ${money(Math.round(short * DEFICIENCY_PAY_RATE))}${T(UI.perMonth)}` : ''}</small></span>
              ${a.qty > 1 ? `<input type="number" data-qty="${a.uid}" min="1" max="${a.qty}" value="${a.qty}" aria-label="${T(UI.qty)}">` : ''}
              <button type="button" class="nn-btn nn-btn-danger" data-act="firesale" data-id="${a.uid}">${T(UI.fireSaleBtn)}</button>
            </div>`;
          })
          .join('');
        // The house and the car sit at the bottom of the list on purpose: they
        // raise the most and they cost the most to have sold, and a player
        // scanning downwards should meet the holdings first.
        const ownRow = (kind: 'home' | 'car', label: Loc): string => {
          if (!ownsThing(s, kind)) return '';
          const o = ownSale(s, kind);
          return `<div class="nn-sellrow">
            <span class="nm"><b>${T(label)}</b><small>${T(UI.offerPrice)} <b class="${o.raise > 0 ? 'pos' : 'neg'}">${money(o.raise)}</b>
              <br>${T(UI.halfPrice)} ${money(o.price)}${o.debt > 0 ? ` · ${T(UI.minusItsDebt)} ${money(o.debt)}` : ''}
              ${o.shortfall > 0 ? `<br><b class="neg">${T(UI.stillOwed)} ${money(o.shortfall)}</b> · ${T(UI.deficiencyPay)} ${money(Math.round(o.shortfall * DEFICIENCY_PAY_RATE))}${T(UI.perMonth)}` : ''}
              <br><b class="neg">${T(kind === 'home' ? UI.thenRent : UI.thenCommute)} ${money(o.newCost)}${T(UI.perMonth)}</b></small></span>
            <button type="button" class="nn-btn nn-btn-danger" data-act="sellown" data-id="${kind}">${T(UI.fireSaleBtn)}</button>
          </div>`;
        };
        const ownRows = ownRow('home', UI.homeOwned) + ownRow('car', UI.carOwned);
        const useless = s.assets.length > 0 && s.assets.every((a) => fireSaleValue(a, a.qty) <= 0);
        return `<div class="kind">${T(UI.rescueTitle)}</div>
          <h2 id="nn-dlg-title">${money(s.cash)}</h2>
          <p class="story">${T(UI.rescueBody)}</p>
          ${s.phase === 'rat' && canApplyForLoan(s) ? `<div class="nn-acts">
          <button type="button" class="nn-btn nn-btn-gold" data-act="borrow-enough">${T(UI.borrowJustEnough)}</button>
          <button type="button" class="nn-btn" data-act="borrow">${T(UI.borrowBtn)}</button>
        </div>` : ''}
          ${s.phase === 'rat' && s.months < s.loanBlockedUntil ? `<p class="nn-warnline">${T(UI.loanBlocked).replace('{month}', String(s.loanBlockedUntil))}</p>` : ''}
          ${useless ? `<p class="nn-warnline">${T(UI.allUnderwater)}</p>` : ''}
          <div style="margin-top:1rem">${rows}${ownRows}</div>`;
      }

      if (p.kind === 'fastbonus' || p.kind === 'fastsetback') {
        const card = fastById.get(p.cardId);
        if (!card) return null;
        // A one-off cheque, never a monthly figure. Labelling it "เงินเข้าต่อเดือน"
        // made a ฿2.5M lump read as ฿2.5M a month for the rest of the game.
        const cash = fastCardCash(s, card);
        const loss = card.type === 'setback' && card.incomeLossPct ? fastIncomeLoss(s, card.incomeLossPct) : 0;
        const good = card.type === 'bonus';
        const taken = card.type === 'bonus' && card.effect === 'expropriate' ? landHeld(s)[0] : undefined;
        return `<div class="kind">${good ? T(UI.tileBonus) : T(UI.tileSetback)}</div>
          <h2 id="nn-dlg-title">${T(card.title)}</h2>
          <p class="story">${T(card.story)}</p>
          <dl class="facts">
            ${taken ? `<dt>${T(UI.landTaken)}</dt><dd class="neg">${T(taken.name)} · ${money(assetValue(taken))}${taken.debt > 0 ? ` · ${T(UI.minusItsDebt)} ${money(taken.debt)}` : ''}</dd>` : ''}
            ${cash > 0 ? `<dt>${good ? T(UI.lumpSum) : T(UI.pay)}</dt><dd class="${good ? 'pos' : 'neg'}">${signed(good ? cash : -cash)}</dd>` : ''}
            ${loss > 0 ? `<dt>${T(UI.passive)}</dt><dd class="neg">${signed(-loss)}${T(UI.perMonth)}</dd>` : ''}
            <dt>${T(UI.cash)}</dt><dd>${money(s.cash)}</dd>
          </dl>
          <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="fastresolve">${T(UI.ok)}</button></div>`;
      }

      if (p.kind === 'dream') {
        const dream = dreamById.get(s.dreamId);
        if (!dream) return null;
        const done = s.dreamsOwned.length;
        return `<div class="kind">${T(UI.tileDream)} · ${T(UI.dreamsDone)} ${done}/${dreams.length}</div>
          <h2 id="nn-dlg-title">${T(dream.title)}</h2>
          <p class="story">${T(dream.story)}</p>
          <dl class="facts"><dt>${T(UI.price)}</dt><dd>${money(dream.cost)}</dd><dt>${T(UI.cash)}</dt><dd>${money(s.cash)}</dd></dl>
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="dreambuy" ${s.cash >= dream.cost ? '' : 'disabled'}>${s.cash >= dream.cost ? T(UI.buyDream) : T(UI.cannotAfford)}</button>
            ${remainingDreams(s).length > 1 ? `<button type="button" class="nn-btn nn-btn-gold" data-act="dreamswap">${T(UI.swapDream)}</button>` : ''}
            <button type="button" class="nn-btn nn-btn-quiet" data-act="dreamskip">${T(UI.pass)}</button>
          </div>`;
      }

      if (p.kind === 'dreamPick') {
        const left = remainingDreams(s);
        const owned = ownedDreams(s);
        return `<div class="kind">${T(UI.tileDream)} · ${T(UI.dreamsDone)} ${owned.length}/${dreams.length}</div>
          <h2 id="nn-dlg-title">${T(UI.pickNextDream)}</h2>
          <p class="story">${T(UI.pickNextDreamBody)}</p>
          ${owned.length ? `<p class="nn-dreamdone">${owned.map((d) => `<span>${T(d.title)}</span>`).join('')}</p>` : ''}
          <div class="nn-dreampick">
            ${left
              .map(
                (d) => `<button type="button" class="nn-pick" data-act="dreampick" data-id="${d.id}">
                  <h3>${T(d.title)}</h3>
                  <p>${T(d.story)}</p>
                  <dl><dt>${T(UI.price)}</dt><dd class="${s.cash >= d.cost ? 'pos' : 'warn'}">${money(d.cost)}</dd></dl>
                </button>`,
              )
              .join('')}
          </div>
          <div class="nn-acts"><button type="button" class="nn-btn nn-btn-quiet" data-act="dreamskip">${T(UI.pass)}</button></div>`;
      }

      return null;
    }

    /* -------------------------------------------------------------- render */

    function render(root: Root): void {
      for (const el of Array.from(root.querySelectorAll<HTMLElement>('[data-i18n]'))) {
        const key = el.dataset.i18n;
        if (key && key in UI) el.textContent = T(UI[key as keyof typeof UI]);
      }
      for (const btn of Array.from(root.querySelectorAll<HTMLButtonElement>('[data-lang-btn]'))) {
        btn.setAttribute('aria-pressed', String(btn.dataset.langBtn === lang));
      }
      document.documentElement.lang = lang;

      const setup = root.querySelector<HTMLElement>('[data-screen="setup"]');
      const game = root.querySelector<HTMLElement>('[data-screen="game"]');
      if (!setup || !game) return;

      if (!state) {
        setup.hidden = false;
        game.hidden = true;
        // The badge belongs to a game in progress. Left showing, it survives
        // "play again" as an empty pill floating under the title.
        const tier = root.querySelector<HTMLElement>('[data-tier]');
        if (tier) {
          tier.hidden = true;
          tier.innerHTML = '';
        }
        renderSetup(root);
      } else {
        setup.hidden = true;
        game.hidden = false;
        renderSheet(root, state);
        renderBoard(root, state);
        renderControls(root, state);
        renderLog(root, state);
        renderTier(root, state);
        settleCash(root, state.cash);
      }

      const ovl = root.querySelector<HTMLElement>('[data-ovl]');
      const dlg = root.querySelector<HTMLElement>('[data-dlg]');
      if (!ovl || !dlg) return;
      const html = dialogHtml(state);
      if (html) {
        // Only a card the board is waiting on can be pushed aside. A modal the
        // player opened themselves already has its own way out.
        const canHide = !!state && state.pending !== null && modal === null;
        dlg.innerHTML = (canHide
          ? `<button type="button" class="nn-dlg-min" data-act="hidecard" aria-label="${T(UI.setAside)}" title="${T(UI.setAside)}"><span aria-hidden="true"></span></button>`
          : '') + html;
        ovl.hidden = false;
        const first = dlg.querySelector<HTMLElement>('button:not(.nn-dlg-min), input');
        if (first) first.focus();
        else dlg.focus();
      } else {
        ovl.hidden = true;
        dlg.innerHTML = '';
        // A pending decision that draws no dialog would leave the board waiting
        // on a card nobody can answer, with every button disabled and nothing in
        // the console. Rather than deadlock, drop it and let play continue.
        if (state && state.pending !== null && !cardIsHidden(state)) {
          state.pending = null;
          writeSave();
          renderControls(root, state);
        }
      }
    }

    /* --------------------------------------------------------- animation */

    /**
     * Counts the on-screen cash figure from where it was to where it now is,
     * and floats the delta above the row. Called after every render, so a
     * purchase animates exactly the same way a payday does.
     */
    function settleCash(root: Root, to: number): void {
      const el = root.querySelector<HTMLElement>('[data-cash]');
      if (!el) {
        shownCash = to;
        return;
      }
      const from = shownCash;
      if (from === to) {
        el.textContent = money(to);
        return;
      }

      const row = el.parentElement;
      if (row) {
        const pop = document.createElement('span');
        pop.className = `nn-pop ${to > from ? 'up' : 'down'}`;
        pop.textContent = signed(to - from);
        row.appendChild(pop);
        window.setTimeout(() => pop.remove(), 1100);
      }

      const dur = reducedMotion() ? 0 : 560;
      const t0 = performance.now();
      window.cancelAnimationFrame(cashRaf);
      const tick = (now: number): void => {
        const p = dur === 0 ? 1 : Math.min(1, (now - t0) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = money(from + (to - from) * eased);
        if (p < 1) cashRaf = window.requestAnimationFrame(tick);
        else {
          shownCash = to;
          el.textContent = money(to);
        }
      };
      cashRaf = window.requestAnimationFrame(tick);
    }

/**
     * On a new month, float the principal coming off each debt above its row,
     * one after another, so paying down debt is something the player watches
     * happen rather than something they have to infer from a shrinking number.
     */
    function showDebtCuts(root: Root, s: GameState): void {
      if (reducedMotion()) return;
      // Both lists use .nn-debt, and the asset rows are rendered first, so the
      // cuts are matched by row order across assets-with-a-mortgage then debts.
      const rows = Array.from(root.querySelectorAll<HTMLElement>('.nn-debt'));
      const cuts: number[] = [
        ...s.assets.filter((a) => a.debt > 0).map((a) => Math.max(0, a.mortgagePay - a.debt * MORTGAGE_RATE)),
        ...s.debts.map((d) => Math.max(0, d.payment - d.balance * d.rate)),
      ];
      cuts.forEach((principal, i) => {
        const row = rows[i];
        if (!row || principal <= 0) return;
        const pop = document.createElement('span');
        pop.className = 'nn-pop down nn-pop-debt';
        pop.textContent = `-${money(principal)}`;
        pop.style.animationDelay = `${i * 0.18}s`;
        row.appendChild(pop);
        window.setTimeout(() => pop.remove(), 1400 + i * 180);
      });
    }

    /** Tumble the dice for a beat before the real faces are shown. */
    async function spinDice(root: Root, s: GameState): Promise<void> {
      if (reducedMotion() || s.lastRoll.length === 0) return;
      for (let i = 0; i < 7; i++) {
        diceSpin = s.lastRoll.map(() => 1 + Math.floor(Math.random() * 6));
        renderBoard(root, s);
        await sleep(55);
      }
      diceSpin = null;
      renderBoard(root, s);
      await sleep(180);
    }

    /**
     * Plays a whole turn as a sequence the eye can follow: dice, then one tile
     * at a time, pausing on each payday so the money is seen arriving, and only
     * then opening whatever card the landing tile drew.
     */
    async function runTurn(root: Root, s: GameState, dice: number): Promise<void> {
      const token = ++turnToken;
      busy = true;
      lastStepAt = Date.now();
      try {
        const before = s.turn;
        rollDice(s, dice);
        // A skipped turn never moves, so there is nothing to walk through.
        if (s.walking === 0) {
          if (s.turn !== before) writeSave();
          return;
        }

        render(root);
        await spinDice(root, s);
        if (token !== turnToken) return;

        let guard = 0;
        while (s.walking > 0 && guard++ < 64) {
          const months = s.months;
          stepMove(s);
          lastStepAt = Date.now();
          flashPay = s.months > months;
          renderBoard(root, s);
          renderControls(root, s);
          if (flashPay) {
            renderSheet(root, s);
            renderLog(root, s);
            settleCash(root, s.cash);
            showDebtCuts(root, s);
            await sleep(760);
          } else {
            await sleep(230);
          }
          if (token !== turnToken) return;
          flashPay = false;
        }

        await sleep(220);
        if (token !== turnToken) return;
        finishTurn(root, s);
      } finally {
        // A turn that was taken over by abortTurn has already been settled, so
        // this must not run again for it.
        if (token === turnToken) {
          busy = false;
          diceSpin = null;
          flashPay = false;
          if (s.walking > 0) finishTurn(root, s);
          render(root);
        }
      }
    }

    function finishTurn(root: Root, s: GameState): void {
      if (s.walking > 0) finishMove(s);
      if (s.pending === null) checkTrouble(s);
      // A payday passed mid-walk can raise the quit offer only to have the
      // landing tile's card overwrite it, so the crossing is re-checked here.
      if (s.pending === null) checkEscape(s);
      if (s.pending === null) checkTier(s);
      syncPhaseModals();
      writeSave();
      render(root);
    }

    /**
     * Give up on the animation and settle the turn immediately. A backgrounded
     * tab freezes the timers the walk awaits, which would otherwise leave every
     * button disabled with no way back.
     */
    function abortTurn(root: Root): void {
      if (!busy || !state) return;
      turnToken += 1;
      busy = false;
      diceSpin = null;
      flashPay = false;
      finishTurn(root, state);
    }

    const turnIsStale = (): boolean => busy && Date.now() - lastStepAt > STALE_TURN_MS;

    /** Dialogs that are triggered by a phase change rather than by `pending`. */
    function syncPhaseModals(): void {
      if (!state) return;
      if (state.phase === 'fast' && !seenFastIntro) {
        seenFastIntro = true;
        modal = 'fastIntro';
      }
    }

    /* ------------------------------------------------------------ actions */

    /**
     * The quantity box belonging to the button that was pressed. Searching the
     * whole board found the wrong one: the balance sheet is rendered before the
     * dialog, and a paper holding carries a quantity box of its own under the
     * same asset id, so a purchase read the sell box in the sheet and bought
     * whatever number happened to be sitting in it. `scope` is the panel the
     * button lives in, which is the only place its own box can be.
     */
    function qtyOf(scope: ParentNode, id?: string): number {
      const sel = id ? `[data-qty="${id}"]` : '[data-qty]';
      const input = scope.querySelector<HTMLInputElement>(sel);
      return input ? clampQty(input) : 1;
    }

    /**
     * Like `qtyOf`, but zero is a real answer. A quantity of zero means "you
     * did not fill this in" and becomes 1; a director's salary of zero means
     * exactly zero, and that is a position the player is allowed to take.
     * The two are told apart by the box's own `min`, which `clampQty` reads.
     */
    function amountOf(scope: ParentNode, id: string): number {
      const input = scope.querySelector<HTMLInputElement>(`[data-qty="${id}"]`);
      return input ? clampQty(input) : 0;
    }

    /**
     * What a quantity box is really worth, folded back into its own min/max.
     *
     * A blank box, a zero and a figure past the ceiling are all things a player
     * can type, and each used to act on a different number than the box was
     * showing: typing 0 into a share order priced the purchase at ฿0 on screen
     * and then bought one share anyway. The value is written back into the
     * field as well, so what the box says and what the button does can never
     * disagree.
     */
    function clampQty(input: HTMLInputElement): number {
      const min = Number.parseInt(input.min, 10);
      const max = Number.parseInt(input.max, 10);
      const floor = Number.isFinite(min) ? min : 1;
      const ceiling = Number.isFinite(max) ? max : Number.POSITIVE_INFINITY;
      const raw = Number.parseInt(input.value, 10);
      const n = Math.min(Math.max(Number.isFinite(raw) ? raw : floor, floor), ceiling);
      if (input.value !== String(n)) input.value = String(n);
      return n;
    }

    /** The panel a clicked control belongs to: dialog, sheet, log or the board. */
    function panelOf(root: Root, from: HTMLElement | undefined): ParentNode {
      return from?.closest('.nn-ovl, [data-sheet], [data-logpanel], [data-controls]') ?? root;
    }

    /** Take a state as the live game: match the cash display and settle any walk. */
    function adoptState(s: GameState): void {
      // A save is only written between turns, so a dangling walk means the tab
      // was closed mid-turn. Finish it silently rather than dropping the roll.
      if (s.walking > 0) finishMove(s);
      shownCash = s.cash;
    }

    function act(root: Root, action: string, id: string | undefined, from?: HTMLElement): void {
      const s = state;
      if (busy) return;
      const panel = panelOf(root, from);

      switch (action) {
        case 'pick-prof':
          if (id) pickedProfession = id;
          break;
        case 'pick-dream':
          if (id) pickedDream = id;
          break;
        case 'pick-car':
          startCar = id === 'yes';
          break;
        case 'pick-home':
          startHome = id === 'yes';
          break;
        case 'learn':
          modal = 'learn';
          break;
        case 'learn-done':
          seenLearn = true;
          saveLearned();
          modal = null;
          break;
        case 'start':
          hiddenCard = null;
          state = createGame(pickedProfession, pickedDream, Date.now() & 0x7fffffff, { car: startCar, home: startHome });
          adoptState(state);
          seenFastIntro = false;
          modal = null;
          endingClosed = false;
          break;
        case 'resume': {
          hiddenCard = null;
          const saved = readSave();
          if (saved) {
            state = saved;
            adoptState(state);
            seenFastIntro = saved.phase !== 'rat';
            modal = null;
          }
          break;
        }
        case 'rules':
          modal = 'rules';
          break;
        case 'taxwhy':
          modal = 'tax';
          break;
        case 'hidecard':
          if (s && s.pending) hiddenCard = cardKey(s);
          break;
        case 'showcard':
          hiddenCard = null;
          break;
        case 'define':
          if (id && isGlossaryKey(id)) {
            defineKey = id;
            modal = 'define';
          }
          break;
        case 'corp':
          modal = 'corp';
          break;
        case 'restart':
          modal = state ? 'confirmRestart' : null;
          break;
        case 'restart-confirm':
          hiddenCard = null;
          state = null;
          modal = null;
          seenFastIntro = false;
          clearSave();
          break;
        case 'closemodal':
          modal = null;
          break;
        case 'opendebt':
          openDebt = openDebt === id ? null : (id ?? null);
          break;
        case 'borrow':
          modal = 'borrow';
          break;
        case 'speed':
          speed = id === 'fast' ? 'fast' : id === 'off' ? 'off' : 'normal';
          saveSpeed();
          break;
        case 'moreassets':
          assetsExpanded = !assetsExpanded;
          break;
        case 'closeending':
          endingClosed = true;
          break;
        case 'seeending':
          endingClosed = false;
          break;
        default:
          if (!s) break;
          if (action === 'roll') {
            // The turn plays out over time and does its own saving/rendering.
            void runTurn(root, s, id === '2' ? 2 : 1);
            return;
          }
          applyGameAction(panel, s, action, id);
          // Closing one card is the moment to show whatever the calendar has
          // been holding, so a queued birthday appears now rather than waiting
          // for the next roll.
          claimDue(s);
          break;
      }

      syncPhaseModals();
      if (state) writeSave();
      render(root);
    }

    function applyGameAction(panel: ParentNode, s: GameState, action: string, id: string | undefined): void {
      // Answering anything clears the set-aside marker. It holds the card's own
      // contents, and the same card can be drawn again later, so leaving a stale
      // marker behind would make that second copy arrive already minimised.
      hiddenCard = null;
      switch (action) {
        case 'deal':
          // Four decks share this button, so the id is passed through rather
          // than folded into a two-way choice: anything that was not "big"
          // used to become "small", which quietly dealt a rat-race card to a
          // player who had asked for a capitalist one.
          chooseDeal(s, id === 'big' || id === 'fast' || id === 'mega' ? id : 'small');
          break;
        case 'buy':
          buyDeal(s, qtyOf(panel));
          break;
        case 'buycorp':
          buyDeal(s, qtyOf(panel), 'corp');
          break;
        case 'setdraw':
          setDraw(s, amountOf(panel, 'draw'));
          break;
        case 'paydividend':
          payDividend(s, amountOf(panel, 'dividend'));
          break;
        case 'fundcorp':
          fundCompany(s, amountOf(panel, 'fund'));
          break;
        case 'pass':
          passDeal(s);
          break;
        case 'sell':
          if (id) sellToMarket(s, id, qtyOf(panel, id));
          break;
        case 'paybirthday':
          payBirthday(s);
          break;
        case 'skipbirthday':
          declineBirthday(s);
          break;
        case 'payschool':
          paySchool(s);
          break;
        case 'nobaby':
          declineBaby(s);
          break;
        case 'retiredok':
          acceptRetirement(s);
          break;
        case 'keepjob':
          declineCareer(s);
          break;
        case 'gradok':
          acceptGraduation(s);
          break;
        case 'payreward':
          payReward(s);
          break;
        case 'skipreward':
          declineReward(s);
          break;
        case 'enrol': {
          if (!id) break;
          const pick = panel.querySelector<HTMLSelectElement>(`[data-target="${id}"]`);
          if (pick) enrol(s, id, pick.value);
          break;
        }
        case 'licence':
          if (id === 'cash' || id === 'loan' || id === 'bond') payLicence(s, id);
          break;
        case 'marketbuy':
          buyFromMarket(s, qtyOf(panel, 'buy'));
          break;
        case 'closemarket':
          closeMarket(s);
          break;
        case 'paydoodad':
          payDoodad(s);
          break;
        case 'instalment':
          takeInstalment(s);
          break;
        case 'declinedoodad':
          declineDoodad(s);
          break;
        case 'baby':
          acceptBaby(s);
          break;
        case 'quit':
          quitJob(s);
          break;
        case 'stay':
          stayEmployed(s);
          break;
        case 'friend':
          acceptFriendHelp(s);
          break;
        case 'tierok':
          s.pending = null;
          break;
        case 'endnow':
          callItADay(s);
          endingClosed = false;
          break;
        case 'resume-run':
          resumeAfterEnd(s);
          endingClosed = false;
          break;
        case 'downsized':
          acceptDownsized(s);
          break;
        case 'charity-give':
          giveCharity(s);
          break;
        case 'charity-skip':
          skipCharity(s);
          break;
        case 'borrow-enough':
          // One press covers the hole, rounded up to the next lending step.
          applyForLoan(s, Math.max(LOAN_STEP, Math.ceil(Math.max(0, -s.cash) / LOAN_STEP) * LOAN_STEP));
          break;
        case 'borrow-do': {
          const input = panel.querySelector<HTMLInputElement>('[data-borrow]');
          const asked = input ? Number.parseInt(input.value, 10) : LOAN_STEP;
          // A refusal leaves the desk open so the player reads why, and the
          // panel behind it now says when the file reopens.
          const outcome = applyForLoan(s, Number.isFinite(asked) && asked > 0 ? asked : LOAN_STEP);
          if (outcome !== 'refused') modal = null;
          break;
        }
        case 'sellnow':
          if (id) sellPaper(s, id, qtyOf(panel, id));
          break;
        case 'clearmortgage':
          if (id) clearMortgage(s, id);
          break;
        case 'repay':
          if (id) repay(s, id);
          break;
        case 'sellown':
          if (id === 'home' || id === 'car') sellOwn(s, id);
          break;
        case 'firesale':
          if (id) fireSale(s, id, qtyOf(panel, id));
          break;
        case 'fastskip':
        case 'fastresolve':
          resolveFastCard(s);
          break;
        case 'dreambuy':
          buyDream(s);
          break;
        case 'sellbiz':
          if (id) sellBusiness(s, id);
          break;
        case 'donate':
          donate(s, Number(id ?? 0));
          break;
        case 'incorporate':
          incorporate(s);
          break;
        case 'insure':
          buyInsurance(s, Number(id ?? 0));
          break;
        case 'closelegacy':
          closeLegacy(s);
          break;
        case 'dreamswap':
          s.pending = { kind: 'dreamPick' };
          break;
        case 'dreampick':
          if (id) pickDream(s, id);
          break;
        case 'dreamskip':
          skipDream(s);
          break;
        default:
          break;
      }
      // Every path back to an empty board must re-check solvency: some cards
      // (a passed deal, a closed market) resolve without touching the wallet
      // but leave a debt taken on earlier still unpaid.
      if (s.pending === null) checkTrouble(s);
      if (s.pending === null) checkTier(s);
    }

    /* --------------------------------------------------------------- boot */

    function boot(): void {
      const root = document.querySelector<Root>('[data-nn]');
      if (!root || root.__neeNoo) return;
      root.__neeNoo = true;

      lang = loadLang();
      speed = loadSpeed();
      seenLearn = loadLearned();
      // The saved game is offered on the setup screen rather than forced, so a
      // player who wants a different job is never trapped in the old run.
      const saved = readSave();
      if (saved) {
        seenFastIntro = saved.phase !== 'rat';
        shownCash = saved.cash;
      }
      // A first-time arrival gets the how-to before the job cards, which is the
      // one moment it is worth reading. Anybody with a game already saved, or
      // who has read it once on this device, goes straight to the board.
      if (!seenLearn && !saved) modal = 'learn';

      // A turn whose timers were frozen by a backgrounded tab must not leave the
      // board dead. The watchdog is the load-bearing half: a disabled button
      // swallows its own click, so the player tapping the greyed-out roll button
      // can never reach the click handler below.
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && turnIsStale()) abortTurn(root);
      });
      window.setInterval(() => {
        if (turnIsStale()) abortTurn(root);
      }, 1000);

      root.addEventListener('click', (e: MouseEvent) => {
        if (!(e.target instanceof Element)) return;
        // A click on a button that looks disabled is also a signal that the
        // animation is stuck; recover first, then handle the click normally.
        if (turnIsStale()) abortTurn(root);
        const langBtn = e.target.closest<HTMLElement>('[data-lang-btn]');
        if (langBtn) {
          lang = langBtn.dataset.langBtn === 'en' ? 'en' : 'th';
          saveLang();
          render(root);
          return;
        }
        // Tapping the dark area around a card sets it aside, the way tapping
        // outside any sheet closes it. Only the backdrop itself counts: a click
        // that landed on the card is a click on the card.
        if (e.target.hasAttribute('data-ovl')) {
          if (modal !== null) modal = null;
          else if (state?.pending && !busy) hiddenCard = cardKey(state);
          else return;
          render(root);
          return;
        }
        const actor = e.target.closest<HTMLElement>('[data-act]');
        if (!actor || !root.contains(actor)) return;
        const action = actor.dataset.act;
        if (action) act(root, action, actor.dataset.id, actor);
      });

      // The borrow dialog prices the choice as it is being made, without a
      // re-render that would steal the caret out of the number field.
      root.addEventListener('input', (e: Event) => {
        if (!(e.target instanceof HTMLInputElement)) return;
        const el = e.target;
        if ('borrow' in el.dataset) {
          const note = panelOf(root, el).querySelector<HTMLElement>('[data-borrow-note]');
          const n = Number.parseInt(el.value, 10);
          if (note) note.textContent = `${T(UI.borrowMonthly)} ${money(Number.isFinite(n) && n > 0 ? n * LOAN_RATE : 0)}`;
          return;
        }
        // The quantity box prices itself as it is typed, clamped to what the
        // wallet can actually cover so the figure is never a promise the
        // purchase will refuse to keep.
        if (el.dataset.unit !== undefined) {
          const note = panelOf(root, el).querySelector<HTMLElement>('[data-qty-note]');
          if (!note) return;
          const cap = Number(el.dataset.max ?? 0);
          const raw = Number.parseInt(el.value, 10);
          // One unit is the smallest order there is, so a half-typed or zeroed
          // box is priced as one rather than as nothing: pressing buy on it
          // does buy one, and the note has to say so beforehand.
          const n = Number.isFinite(raw) ? Math.max(1, Math.min(raw, cap)) : 1;
          note.innerHTML = qtyNote(Number(el.dataset.unit), Number(el.dataset.flow ?? 0), n)
            + (Number.isFinite(raw) && raw > cap ? ` · <span class="neg">${T(UI.cappedAt)} ${cap}</span>` : '');
        }
      });

      // Leaving a quantity box settles whatever was typed into it back inside
      // its own range, so the correction is seen before the button is pressed
      // rather than discovered afterwards in the balance sheet.
      root.addEventListener('change', (e: Event) => {
        if (e.target instanceof HTMLInputElement && 'qty' in e.target.dataset) clampQty(e.target);
      });

      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          if (modal !== null) {
            modal = null;
            render(root);
            return;
          }
          // A pending card still has no cancel, but it can be set aside: the
          // decision is kept and owed, the board underneath becomes readable,
          // and the dice stay locked until it is answered.
          if (state?.pending && !busy) {
            hiddenCard = cardKey(state);
            render(root);
          }
          return;
        }
        // A hundred-turn game is a hundred trips to the same button, so the
        // space bar rolls too, as long as nothing is waiting for a decision.
        if (e.key !== ' ' && e.key !== 'Enter') return;
        if (e.target instanceof HTMLElement && e.target.closest('input, button, a')) return;
        if (!state || modal !== null || !canRoll(state) || busy) return;
        e.preventDefault();
        void runTurn(root, state, state.charityTurns > 0 ? 2 : 1);
      });

      render(root);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
    document.addEventListener('astro:page-load', boot);
  </script>
</body>
</html>
