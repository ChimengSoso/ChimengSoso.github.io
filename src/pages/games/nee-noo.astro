        return `<div class="kind">${T(UI.tileDownsized)}</div>
          <h2 id="nn-dlg-title">${T(UI.tileDownsized)}</h2>
          <p class="story">${T(UI.downsizedBody)}</p>
          <dl class="facts">
            <dt>${T(UI.expenses)}</dt><dd class="neg">${money(totalExpenses(s))}${T(UI.perMonth)}</dd>
            <dt>${T(UI.passive)}</dt><dd class="${passiveIncome(s) > 0 ? 'pos' : ''}">${money(passiveIncome(s))}${T(UI.perMonth)}</dd>
            <dt>${T(UI.downsizedCost)}</dt><dd class="neg">${money(-2 * (totalExpenses(s) - passiveIncome(s)))}</dd>
          </dl>
          <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="downsized">${T(UI.ok)}</button></div>`;
      }

      if (p.kind === 'charity') {
        const cost = charityCost(s);
        return `<div class="kind">${T(UI.tileCharity)}</div>
          <h2 id="nn-dlg-title">${T(UI.tileCharity)}</h2>
          <p class="story">${T(UI.charityBody)}</p>
          <dl class="facts"><dt>${T(UI.give)}</dt><dd>${money(cost)}</dd><dt>${T(UI.cash)}</dt><dd>${money(s.cash)}</dd></dl>
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="charity-give" ${s.cash >= cost ? '' : 'disabled'}>${T(UI.give)}</button>
            <button type="button" class="nn-btn nn-btn-quiet" data-act="charity-skip">${T(UI.dontGive)}</button>
          </div>`;
      }

      if (p.kind === 'rescue') {
        const rows = s.assets
          .map(
            (a) => `<div class="nn-sellrow">
              <span class="nm"><b>${T(a.name)}</b><small>${T(UI.offerPrice)} ${money(fireSaleValue(a, a.qty))}${a.qty > 1 ? ` (${a.qty} ${T(UI.units)})` : ''}</small></span>
              ${a.qty > 1 ? `<input type="number" data-qty="${a.uid}" min="1" max="${a.qty}" value="${a.qty}" aria-label="${T(UI.qty)}">` : ''}
              <button type="button" class="nn-btn nn-btn-danger" data-act="firesale" data-id="${a.uid}">${T(UI.fireSaleBtn)}</button>
            </div>`,
          )
          .join('');
        return `<div class="kind">${T(UI.rescueTitle)}</div>
          <h2 id="nn-dlg-title">${money(s.cash)}</h2>
          <p class="story">${T(UI.rescueBody)}</p>
          ${s.phase === 'rat' && maxBorrow(s) >= LOAN_STEP ? `<div class="nn-acts"><button type="button" class="nn-btn nn-btn-gold" data-act="borrow">${T(UI.borrowBtn)} · ${money(LOAN_STEP * LOAN_RATE)}${T(UI.perMonth)}</button></div>` : ''}
          <div style="margin-top:1rem">${rows}</div>`;
      }

      if (p.kind === 'fastdeal') {
        const card = fastById.get(p.cardId);
        if (!card || card.type !== 'deal') return null;
        return `<div class="kind">${T(UI.tileFastdeal)}</div>
          <h2 id="nn-dlg-title">${T(card.title)}</h2>
          <p class="story">${T(card.story)}</p>
          <dl class="facts">
            <dt>${T(UI.price)}</dt><dd>${money(card.price)}</dd>
            <dt>${T(UI.monthlyIn)}</dt><dd class="pos">${signed(card.cashflow)}</dd>
            <dt>${T(UI.cash)}</dt><dd>${money(s.cash)}</dd>
          </dl>
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="fastbuy" ${s.cash >= card.price ? '' : 'disabled'}>${s.cash >= card.price ? T(UI.invest) : T(UI.cannotAfford)}</button>
            <button type="button" class="nn-btn nn-btn-quiet" data-act="fastskip">${T(UI.pass)}</button>
          </div>`;
      }

      if (p.kind === 'fastbonus' || p.kind === 'fastsetback') {
        const card = fastById.get(p.cardId);
        if (!card) return null;
        return `<div class="kind">${p.kind === 'fastbonus' ? T(UI.tileBonus) : T(UI.tileSetback)}</div>
          <h2 id="nn-dlg-title">${T(card.title)}</h2>
          <p class="story">${T(card.story)}</p>
          <div class="nn-acts"><button type="button" class="nn-btn nn-btn-go" data-act="fastresolve">${T(UI.ok)}</button></div>`;
      }

      if (p.kind === 'dream') {
        const dream = dreamById.get(s.dreamId);
        if (!dream) return null;
        return `<div class="kind">${T(UI.tileDream)}</div>
          <h2 id="nn-dlg-title">${T(dream.title)}</h2>
          <p class="story">${T(dream.story)}</p>
          <dl class="facts"><dt>${T(UI.price)}</dt><dd>${money(dream.cost)}</dd><dt>${T(UI.cash)}</dt><dd>${money(s.cash)}</dd></dl>
          <div class="nn-acts">
            <button type="button" class="nn-btn nn-btn-go" data-act="dreambuy" ${s.cash >= dream.cost ? '' : 'disabled'}>${s.cash >= dream.cost ? T(UI.buyDream) : T(UI.cannotAfford)}</button>
            <button type="button" class="nn-btn nn-btn-quiet" data-act="dreamskip">${T(UI.pass)}</button>
          </div>`;
