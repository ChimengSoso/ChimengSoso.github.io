    function endingDialog(s: GameState): string {
      const won = s.phase === 'won';
      const dream = dreamById.get(s.dreamId);
      const job = profession(s);
      const confetti = won && !reducedMotion()
        ? `<div class="nn-confetti" aria-hidden="true">${Array.from({ length: 26 })
            .map((_, i) => {
              const left = Math.round((i * 97) % 100);
              const delay = ((i * 137) % 900) / 1000;
              const dur = 2.2 + ((i * 53) % 120) / 100;
              const hue = ['#5fd694', '#e2b23c', '#4d72a9', '#fff'][i % 4];
