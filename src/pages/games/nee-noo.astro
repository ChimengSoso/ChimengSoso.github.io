        return `<div class="kind">${T(UI.tileDoodad)}</div>
          <h2 id="nn-dlg-title">${T(card.title)}</h2>
          <p class="story">${T(card.story)}</p>
          <dl class="facts">
            <dt>${T(UI.pay)}</dt><dd class="${cost > 0 ? 'neg' : ''}">${cost > 0 ? money(cost) : '—'}</dd>
