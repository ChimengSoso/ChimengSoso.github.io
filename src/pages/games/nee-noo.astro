          <div class="nn-acts"><button type="button" class="nn-btn ${matches.length ? 'nn-btn-quiet' : 'nn-btn-go'}" data-act="closemarket">${matches.length ? T(UI.sellNone) : T(UI.ok)}</button></div>`;
