---
import '../../styles/fonts.css';
import { footerSocialLinks } from '../../data/socialLinks';
import { games } from '../../data/games';

const year = new Date().getFullYear();
const title = 'หมวดเกม | ChimengSoso';
const description = 'เกมที่เขียนขึ้นเองบนเว็บนี้ เล่นฟรีในเบราว์เซอร์ ไม่ต้องสมัคร ไม่ต้องติดตั้ง';
---
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0f1520" />
  <title>{title}</title>
  <link rel="canonical" href={Astro.url.href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
  <link rel="icon" type="image/jpeg" href="/img.jpg" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ChimengSoso" />
  <meta property="og:title" content="หมวดเกม" />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={Astro.url.href} />
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "9e5cb1eb46564e6ea4b2c19ff35ad2ec", "spa": true}'></script>

  <style is:global>
    /* Same palette as the games themselves, so walking from this hub into a
       game does not change the world under the player's feet. */
    :root{
      --nn-bg:#0f1520;
      --nn-panel:#19212f;
      --nn-panel-2:#131a26;
      --nn-border:#2a3446;
      --nn-ink:#e8edf6;
      --nn-muted:#93a1b8;
      --nn-green:#35a86a;
      --nn-green-bright:#5fd694;
      --nn-gold:#e2b23c;
    }
    *{margin:0;padding:0;box-sizing:border-box;}
    html{font-size:clamp(15px, 0.95rem + 0.22vw, 19px);}
    html,body{
      font-family:"Sarabun", system-ui, sans-serif;
      background:var(--nn-bg);
      color:var(--nn-ink);
    }
    body{min-height:100vh;display:flex;flex-direction:column;}
  </style>
  <style>
    .wrap{width:100%;max-width:46rem;margin:0 auto;padding:2.5rem 1rem 1rem;flex:1;}
    /* display:flex (not inline-flex) so the tag pill below starts its own line
       instead of riding along next to the link. */
    .back{
      display:flex;
      width:fit-content;
      align-items:center;
      gap:0.35rem;
      font-size:0.8rem;
      color:var(--nn-muted);
      text-decoration:none;
      margin-bottom:2rem;
      transition:color .15s;
    }
    .back:hover{color:var(--nn-green-bright);}
    .back svg{width:14px;height:14px;flex-shrink:0;transition:transform .15s ease;}
    .back:hover svg{transform:translateX(-3px);}

    .tag{
      display:inline-block;
      font-family:"JetBrains Mono", monospace;
      font-size:0.66rem;
      background:var(--nn-green);
      color:#06210f;
      padding:0.25rem 0.75rem;
      border-radius:1.25rem;
      text-transform:uppercase;
      letter-spacing:.4px;
      margin-bottom:0.875rem;
    }
    h1{font-size:1.7rem;color:#fff;margin-bottom:0.4rem;letter-spacing:-.3px;}
    .lede{color:var(--nn-muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.5rem;}
    .count{
      font-family:"JetBrains Mono", monospace;
      font-size:0.68rem;
      text-transform:uppercase;
      letter-spacing:.6px;
      color:var(--nn-muted);
      margin:2rem 0 0.75rem;
      padding-bottom:0.5rem;
      border-bottom:1px solid var(--nn-border);
    }

    .list{display:flex;flex-direction:column;gap:0.75rem;}
    .item{
      display:block;
      background:var(--nn-panel);
      border:1px solid var(--nn-border);
      border-radius:16px;
      padding:1.2rem 1.35rem;
      text-decoration:none;
      color:var(--nn-ink);
      transition:border-color .18s ease, background .18s ease, transform .18s ease;
    }
    .item:hover{border-color:var(--nn-green);background:#1c2739;transform:translateY(-2px);}
    .item-tag{
      display:inline-block;
      font-family:"JetBrains Mono", monospace;
      font-size:0.62rem;
      color:var(--nn-gold);
      text-transform:uppercase;
      letter-spacing:.5px;
      margin-bottom:0.4rem;
    }
    .item h2{font-size:1.15rem;color:#fff;margin-bottom:0.35rem;line-height:1.4;}
    .item p{font-size:0.88rem;color:var(--nn-muted);line-height:1.7;margin:0;}
    .win{
      display:block;
      margin-top:0.6rem;
      font-size:0.82rem;
      color:var(--nn-green-bright);
      border-left:2px solid var(--nn-green);
      padding-left:0.6rem;
    }
    .meta{
      display:flex;
      align-items:center;
      gap:0.65rem;
      margin-top:0.9rem;
      font-family:"JetBrains Mono", monospace;
      font-size:0.72rem;
      color:var(--nn-muted);
    }
    .go{
      margin-left:auto;
      display:inline-flex;
      align-items:center;
      gap:3px;
      color:var(--nn-green-bright);
      font-weight:600;
    }
    .go svg{width:13px;height:13px;flex-shrink:0;transition:transform .15s ease;}
    .item:hover .go svg{transform:translateX(3px);}
    .soon{opacity:.55;pointer-events:none;}

    .foot{
      max-width:46rem;
      width:100%;
      margin:2.5rem auto 0;
      padding:1.75rem 1rem 2.5rem;
      border-top:1px solid var(--nn-border);
      text-align:center;
    }
    .foot-social{display:flex;justify-content:center;gap:1.1rem;margin-bottom:0.8rem;}
    .foot-social a{color:var(--nn-muted);line-height:1;transition:color .15s;}
    .foot-social a:hover{color:var(--nn-green-bright);}
    .foot-social svg{width:1.05rem;height:1.05rem;display:block;}
    .foot p{font-size:0.72rem;color:var(--nn-muted);line-height:1.8;}
    .foot a{color:var(--nn-green-bright);text-decoration:underline;text-underline-offset:2px;}

    @media (prefers-reduced-motion: reduce){
      .item,.back svg,.go svg{transition:none;}
      .item:hover{transform:none;}
      .item:hover .go svg,.back:hover svg{transform:none;}
    }
  </style>
</head>
<body>
  <div class="wrap">
    <a class="back" href="/divine-lore/">
      <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
      บันทึกลับ
    </a>

    <span class="tag">หมวดเกม</span>
    <h1>เกมที่ผมเขียนเอง</h1>
    <p class="lede">
      เล่นฟรีในเบราว์เซอร์ ไม่ต้องสมัครสมาชิก ไม่ต้องติดตั้งอะไร ความคืบหน้าเก็บไว้ในเครื่องคุณเอง
      ไม่มีอะไรถูกส่งขึ้นเซิร์ฟเวอร์
    </p>

    <p class="count">{games.length} เกม</p>

    <div class="list">
      {games.map((g) => (
        <a class={`item${g.soon ? ' soon' : ''}`} href={g.soon ? '#' : `/games/${g.href}`}>
          <span class="item-tag">{g.tag}</span>
          <h2>{g.title}</h2>
          <p>{g.desc}</p>
          <span class="win">{g.howToWin}</span>
          <div class="meta">
            <span class="go" aria-hidden="true">
              {g.soon ? 'เร็วๆ นี้' : 'เข้าเล่น'}
              <svg viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <footer class="foot">
    <div class="foot-social">
      {footerSocialLinks.map((s) => (
        <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d={s.iconPath} /></svg>
        </a>
      ))}
    </div>
    <p>&copy; {year} <a href="/">ChimengSoso</a> · <a href="/privacy/">นโยบายความเป็นส่วนตัว</a></p>
  </footer>
</body>
</html>
