  table.rec.dnaboard th:nth-child(1),
  table.rec.dnaboard th:nth-child(2),
  table.rec.dnaboard th:nth-child(4){width:16%;}

  /* ---------- แถบตัวอักษรของมินิเกม DNA ---------- */
  .dn-strip{display:flex;gap:5px;width:max-content;}
  .dn-strip :global(.dn-cell){
    flex:0 0 auto;
    width:2rem;height:2.4rem;
    display:flex;align-items:center;justify-content:center;
    font-family:var(--dl-mono,monospace);font-size:1rem;
    border:1px solid #2a3350;border-radius:7px;
    background:#101827;color:#cdd6ea;
  }
  .dn-strip :global(.dn-cell.slot){cursor:pointer;border-color:#3d5a80;color:#9ecbff;}
  .dn-strip :global(.dn-cell.slot:hover){border-color:var(--dl-emerald);}
  .dn-strip :global(.dn-cell.fixed){color:#7b8397;}
  .cpg-score :global(.fail){color:#f0a6a6;}
</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type DnPuzzle = {
    id: string;
    label: string;
    tease: string;
    pat: string;
    k: number;
    r: number;
    total: number;
    answer: string;
    slots: number[];
  };

  /* นิยามรูปแบบ-k ตามโจทย์คำต่อคำ: รูปแบบ-1 = เรียงไม่ลด
     รูปแบบ-k = เป็นรูปแบบ-(k-1) อยู่แล้ว หรือ (รูปแบบ-(k-1) ต่อด้วย รูปแบบ-1) */
  function sortedUp(s: string): boolean {
    for (let i = 0; i + 1 < s.length; i++) if (s[i] > s[i + 1]) return false;
    return true;
  }
  const memo = new Map<string, boolean>();
  function isForm(s: string, k: number): boolean {
    const key = `${s}|${k}`;
    const hit = memo.get(key);
    if (hit !== undefined) return hit;
    let ok = sortedUp(s);
    if (!ok && k > 1) {
      ok = isForm(s, k - 1);
      for (let p = 1; !ok && p < s.length; p++) ok = isForm(s.slice(0, p), k - 1) && sortedUp(s.slice(p));
    }
    memo.set(key, ok);
    return ok;
  }

  const IDLE = 'กดที่ช่อง N เพื่อวนเปลี่ยนตัวอักษร';

  function initDnaGame(): void {
    const maybeUi = cpGameUi('[data-dnagame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as DnPuzzle[];
    if (puzzles.length === 0) return;

    const stripEl = ui.root.querySelector<HTMLElement>('[data-dn-strip]');
    const passEl = ui.root.querySelector<HTMLElement>('[data-dn-pass]');
    const patEl = ui.root.querySelector<HTMLElement>('[data-dn-pat]');
    const kEl = ui.root.querySelector<HTMLElement>('[data-dn-k]');
    const k2El = ui.root.querySelector<HTMLElement>('[data-dn-k2]');
    const rEl = ui.root.querySelector<HTMLElement>('[data-dn-r]');
    const totalEl = ui.root.querySelector<HTMLElement>('[data-dn-total]');
    if (!stripEl || !passEl || !patEl || !kEl || !k2El || !rEl || !totalEl) return;
    const strip: HTMLElement = stripEl;
    const passOut: HTMLElement = passEl;
    const patOut: HTMLElement = patEl;
    const kOut: HTMLElement = kEl;
    const k2Out: HTMLElement = k2El;
    const rOut: HTMLElement = rEl;
    const totalOut: HTMLElement = totalEl;

    const AL = 'ACGT';
    let pi = 0;
    let cur: string[] = [];

    const pz = (): DnPuzzle => puzzles[pi];

    function buildStrip(): void {
      const p = pz();
      strip.textContent = '';
      for (let i = 0; i < p.pat.length; i++) {
        const isSlot = p.pat[i] === 'N';
        const cell = document.createElement(isSlot ? 'button' : 'span');
        cell.className = isSlot ? 'dn-cell slot' : 'dn-cell fixed';
        cell.dataset.i = String(i);
        if (cell instanceof HTMLButtonElement) {
          cell.type = 'button';
          cell.setAttribute('aria-label', `ช่องที่ ${i + 1} กดเพื่อเปลี่ยนตัวอักษร`);
        }
        strip.appendChild(cell);
      }
    }

    function render(): void {
      const p = pz();
      const cells = Array.from(strip.querySelectorAll<HTMLElement>('.dn-cell'));
      cells.forEach((cell, i) => {
        cell.textContent = cur[i];
      });
      const pass = isForm(cur.join(''), p.k);
      passOut.textContent = pass ? 'เป็น' : 'ยังไม่เป็น';
      passOut.className = pass ? '' : 'fail';
      patOut.textContent = p.pat;
      kOut.textContent = String(p.k);
      k2Out.textContent = String(p.k);
      rOut.textContent = String(p.r);
      totalOut.textContent = String(p.total);
    }

    function check(): void {
      const p = pz();
      const s = cur.join('');
      if (!isForm(s, p.k)) {
        ui.setStatus(`${s} ยังไม่เป็นรูปแบบ-${p.k} ตามนิยาม จึงไม่อยู่ในรายการที่นับอันดับ`, 'bad');
        return;
      }
      if (s === p.answer) {
        ui.setStatus(`ถูกต้องครับ ${s} คือลำดับอันดับที่ ${p.r} พอดี`, 'good');
        return;
      }
      const cmp = s < p.answer ? 'มาก่อน' : 'มาหลัง';
      ui.setStatus(`${s} เป็นรูปแบบ-${p.k} จริง แต่มัน${cmp}อันดับที่ ${p.r} ในพจนานุกรม`, 'bad');
    }

    function selectPuzzle(k: number): void {
      pi = k;
      const p = pz();
      cur = p.pat.split('').map((c) => (c === 'N' ? 'A' : c));
      ui.selectTab(k);
      ui.setTease(p.tease);
      buildStrip();
      ui.setStatus(IDLE);
      render();
    }

    strip.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const cell = e.target.closest('.dn-cell.slot');
      if (!(cell instanceof HTMLElement)) return;
      const i = Number(cell.dataset.i);
      cur[i] = AL[(AL.indexOf(cur[i]) + 1) % AL.length];
      ui.setStatus(IDLE);
      render();
    });

    ui.onClick('data-dn-reset', () => selectPuzzle(pi));
    ui.onClick('data-dn-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initDnaGame);
</script>

