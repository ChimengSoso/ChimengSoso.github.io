import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const href = 'dna-kth/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

const AL = 'ACGT';

/** จำนวนรอยต่อที่ตัวถัดไปเล็กลง ลำดับรูปแบบ-K คือลำดับที่มีรอยต่อไม่เกิน K-1 */
const drops = (s: string): number => {
  let d = 0;
  for (let i = 0; i + 1 < s.length; i++) if (s[i] > s[i + 1]) d++;
  return d;
};

/** ลำดับสมบูรณ์ทุกอันที่เข้ากันได้กับแพตเทิร์นและเป็นรูปแบบ-K เรียงตามพจนานุกรม */
function enumerate(pat: string, K: number): string[] {
  const out: string[] = [];
  const rec = (cur: string): void => {
    if (cur.length === pat.length) {
      if (drops(cur) <= K - 1) out.push(cur);
      return;
    }
    const c = pat[cur.length];
    for (const x of AL) if (c === 'N' || c === x) rec(cur + x);
  };
  rec('');
  return out;
}

const PAT = 'ACANNCNNG';
const KK = 3;
const RR = 5;
const listed = enumerate(PAT, KK);
const answer = listed[RR - 1];
const firstSeven = listed.slice(0, 7);
/* เจ็ดตัวแรกที่โจทย์พิมพ์ไว้ และคำตอบของตัวอย่างทั้งสอง */
const STATEMENT_SEVEN = ['ACAAACAAG', 'ACAAACACG', 'ACAAACAGG', 'ACAAACCAG', 'ACAAACCCG', 'ACAAACCGG', 'ACAAACCTG'];
if (firstSeven.join() !== STATEMENT_SEVEN.join() || answer !== 'ACAAACCCG') {
  throw new Error('dna-kth: เจ็ดตัวแรกหรือคำตอบตัวอย่างแรกไม่ตรงกับโจทย์');
}

/* ---------- ภาพเทียบลำดับที่ผ่านกับลำดับที่ตกเพราะรอยต่อเกิน ----------
   ตัวที่ตกหามาจากการไล่ทุกลำดับที่เข้ากันได้กับแพตเทิร์นโดยไม่กรองรอยต่อ
   แล้วเอาตัวแรกที่รอยต่อถึงเพดาน จึงเป็นตัวอย่างจริง ไม่ใช่ตัวที่ยกมาลอย ๆ */
function allMatching(pat: string): string[] {
  const out: string[] = [];
  const rec = (cur: string): void => {
    if (cur.length === pat.length) {
      out.push(cur);
      return;
    }
    const c = pat[cur.length];
    for (const x of AL) if (c === 'N' || c === x) rec(cur + x);
  };
  rec('');
  return out;
}
const rejected = allMatching(PAT).find((x) => drops(x) >= KK) as string;
/** ตำแหน่งรอยต่อ คือช่องที่ตัวถัดไปเล็กลง */
const dropAt = (x: string): number[] => {
  const out: number[] = [];
  for (let i = 0; i + 1 < x.length; i++) if (x[i] > x[i + 1]) out.push(i);
  return out;
};
const slotSet = new Set<number>();
for (let i = 0; i < PAT.length; i++) if (PAT[i] === 'N') slotSet.add(i);

const DC = 40;
const DGAP = 10;
const dx = (i: number): number => 26 + i * (DC + DGAP);
const DROW1 = 60;
const DROW2 = 168;
const DCH = 42;
const dnaVB = `0 0 ${dx(PAT.length - 1) + DC + 12} 274`;
/** เครื่องหมายรอยต่อวางกลางช่องไฟระหว่างสองตัวอักษร */
const gapX = (i: number): number => dx(i) + DC + DGAP / 2;


const PAT2 = 'ACANN';
const K2 = 4;
const R2 = 10;
const answer2 = enumerate(PAT2, K2)[R2 - 1];

/* ---------- นิยามรูปแบบ-k ตามโจทย์คำต่อคำ (ไม่ใช้การนับรอยต่อ) ----------
   รูปแบบ-1 = เรียงไม่ลด, รูปแบบ-k = เป็นรูปแบบ-(k-1) อยู่แล้ว หรือ (รูปแบบ-(k-1) ต่อด้วย รูปแบบ-1) */
const sortedUp = (s: string): boolean => {
  for (let i = 0; i + 1 < s.length; i++) if (s[i] > s[i + 1]) return false;
  return true;
};
const formMemo = new Map<string, boolean>();
function isForm(s: string, k: number): boolean {
  const key = `${s}|${k}`;
  const hit = formMemo.get(key);
  if (hit !== undefined) return hit;
  let ok = sortedUp(s);
  if (!ok && k > 1) {
    ok = isForm(s, k - 1);
    for (let p = 1; !ok && p < s.length; p++) ok = isForm(s.slice(0, p), k - 1) && sortedUp(s.slice(p));
  }
  formMemo.set(key, ok);
  return ok;
}
/** ลำดับที่ผ่านนิยามเรียกซ้ำ เรียงตามพจนานุกรมด้วย sort */
const listByDefinition = (pat: string, k: number): string[] =>
  allMatchingSorted(pat).filter((s) => isForm(s, k));
function allMatchingSorted(pat: string): string[] {
  const out: string[] = [''];
  let cur = out;
  for (const c of pat) {
    const nxt: string[] = [];
    for (const s of cur) for (const x of AL) if (c === 'N' || c === x) nxt.push(s + x);
    cur = nxt;
  }
  return cur.slice().sort();
}

/* ---------- มินิเกม เติมช่องว่างให้ได้ลำดับอันดับที่ R ----------
   คำตอบของเกมมาจากนิยามเรียกซ้ำข้างบน แล้วตรวจไขว้กับการนับรอยต่อ ถ้าไม่ตรงกัน บิลด์ล้ม */
type DnaPuzzle = { id: string; label: string; tease: string; pat: string; k: number; r: number };
const DNA_PUZZLES: DnaPuzzle[] = [
  { id: 'd1', label: 'ชุดที่ 1 · อุ่นเครื่อง', tease: 'ช่องว่างสองช่อง ลองทุกแบบได้ในเวลาไม่นาน', pat: 'ACNN', k: 2, r: 3 },
  { id: 'd2', label: 'ชุดที่ 2 · ตัวอย่างในโจทย์', tease: 'ตัวอย่างแรกของโจทย์', pat: PAT, k: KK, r: RR },
  { id: 'd3', label: 'ชุดที่ 3 · K น้อยลง', tease: 'ชุดนี้ K = 2 ช่องว่างสี่ช่อง เติมแล้วไม่ผ่านทุกสาย', pat: 'NNCNN', k: 2, r: 12 },
];
for (const p of DNA_PUZZLES) {
  if (listByDefinition(p.pat, p.k).join() !== enumerate(p.pat, p.k).join()) {
    throw new Error(`dna-kth: ชุด ${p.id} นิยามเรียกซ้ำกับการนับรอยต่อให้รายการไม่ตรงกัน`);
  }
}

type DnaPuzzleData = {
  id: string;
  label: string;
  tease: string;
  pat: string;
  k: number;
  r: number;
  total: number;
  answer: string;
  slots: number[];
};
const dnaPuzzles: DnaPuzzleData[] = DNA_PUZZLES.map((p) => {
  const list = listByDefinition(p.pat, p.k);
  if (p.r < 1 || p.r > list.length) {
    throw new Error(`มินิเกมของ dna-kth: ชุด ${p.id} ขออันดับ ${p.r} แต่มีลำดับที่ผ่านแค่ ${list.length} แบบ`);
  }
  const slots: number[] = [];
  for (let i = 0; i < p.pat.length; i++) if (p.pat[i] === 'N') slots.push(i);
  return {
    id: p.id,
    label: p.label,
    tease: p.tease,
    pat: p.pat,
    k: p.k,
    r: p.r,
    total: list.length,
    answer: list[p.r - 1],
    slots,
  };
});
const dnaJson = JSON.stringify(dnaPuzzles);
/* สถานะแรกของเกม (ช่อง N เริ่มเป็น A) เรนเดอร์ไว้ก่อนสคริปต์ทำงาน ให้ตรงกับที่สคริปต์จะแสดง */
const game0 = dnaPuzzles[0].pat.replace(/N/g, 'A');
const game0Pass = isForm(game0, dnaPuzzles[0].k);

/** ตัวอย่างที่โจทย์ยกมา: k คือรูปแบบที่โจทย์พูดถึง claim คือโจทย์บอกว่าเป็นหรือไม่ */
const SHAPE_CLAIMS: { s: string; k: number; claim: boolean }[] = [
  { s: 'AACCGT', k: 1, claim: true },
  { s: 'AACGTC', k: 1, claim: false },
  { s: 'AACCC', k: 3, claim: true },
  { s: 'ACACC', k: 3, claim: true },
  { s: 'ACACA', k: 3, claim: true },
  { s: 'GCACAC', k: 3, claim: false },
  { s: 'ACACACA', k: 3, claim: false },
];
const shapeDemo = SHAPE_CLAIMS.map(({ s, k, claim }) => {
  const byDrops = drops(s) < k;
  if (byDrops !== claim) throw new Error(`dna-kth: การนับรอยต่อของ ${s} ไม่ตรงกับที่โจทย์บอก`);
  return { s, d: drops(s), form: drops(s) + 1, said: `${claim ? 'เป็น' : 'ไม่เป็น'}รูปแบบ-${k}` };
});

/* ---------- ตาราง f แบบเดียวกับโค้ด C++ (ดัชนีตำแหน่งนับจาก 0) ----------
   f[i][c][d] = จำนวนวิธีเติมตำแหน่ง i..n-1 เมื่อตัวก่อนหน้าคือ c (4 = ยังไม่มี) และยังใช้ได้อีก d ท่อน */
function buildF(pat: string, K: number): number[][][] {
  const n = pat.length;
  const f: number[][][] = Array.from({ length: n + 1 }, () =>
    Array.from({ length: 5 }, () => new Array<number>(K + 1).fill(0)),
  );
  for (let c = 0; c < 5; c++) for (let d = 1; d <= K; d++) f[n][c][d] = 1;
  for (let i = n - 1; i >= 0; i--)
    for (let c = 0; c < 5; c++)
      for (let d = 1; d <= K; d++) {
        let v = 0;
        for (let x = 0; x < 4; x++) {
          if (pat[i] !== 'N' && pat[i] !== AL[x]) continue;
          const nd = c < 4 && x < c ? d - 1 : d;
          if (nd < 1) continue;
          v += f[i + 1][x][nd];
        }
        f[i][c][d] = v;
      }
  return f;
}
const fEx = buildF(PAT, KK);
if (fEx[0][4][KK] !== listed.length) throw new Error('dna-kth: f[0][4][K] ต้องเท่ากับจำนวนลำดับที่ผ่าน');

/* ช่องตัวอย่างหนึ่งช่องสำหรับอธิบายสูตร: ตำแหน่งท้าย ๆ ที่เป็น N มีทั้งตัวที่ถูกข้ามเพราะท่อนหมดและตัวที่แพตเทิร์นตัดทิ้ง */
const EX_I = PAT.length - 2;
const EX_C = 1; // C
const EX_D = 1;
type ExTerm = { ch: string; why: string; val: number };
const exTerms: ExTerm[] = [];
for (let x = 0; x < 4; x++) {
  const nd = x < EX_C ? EX_D - 1 : EX_D;
  if (nd < 1) {
    exTerms.push({ ch: AL[x], why: `${AL[x]} เล็กกว่า C ต้องขึ้นท่อนใหม่ แต่ไม่มีท่อนเหลือ ข้าม`, val: 0 });
    continue;
  }
  exTerms.push({ ch: AL[x], why: `อ่าน f[${EX_I + 1}][${AL[x]}][${nd}]`, val: fEx[EX_I + 1][x][nd] });
}
const exSum = exTerms.reduce((s, t) => s + t.val, 0);
if (PAT[EX_I] !== 'N' || exSum !== fEx[EX_I][EX_C][EX_D] || !exTerms.some((t) => t.val === 0 && t.why.includes('ไม่มีท่อน'))) {
  throw new Error('dna-kth: ช่องตัวอย่างของสูตรต้องเป็นช่อง N และมีตัวที่ถูกข้ามเพราะท่อนหมด');
}
const exNext = PAT[EX_I + 1];
/* สายที่ช่องนี้นับ หาด้วยการไล่ตรง ๆ: ต่อท้าย C แล้วต้องไม่มีรอยต่อเพิ่ม (เหลือท่อนเดียว) */
const exStrings = allMatchingSorted(PAT.slice(EX_I)).filter((s) => drops(AL[EX_C] + s) <= EX_D - 1);
if (exStrings.length !== fEx[EX_I][EX_C][EX_D]) throw new Error('dna-kth: สายของช่องตัวอย่างไม่ตรงกับค่าในตาราง');

/* เดินหาตัวที่ R ทีละตำแหน่ง เพื่อทำตารางไล่ ตำแหน่ง i ในแถวนับจาก 1 จำนวนที่ตามมาอ่านจาก f[i][x][nd] */
type Tried = { ch: string; nd: number; cnt: number; taken: boolean };
type Walk = { i: number; tried: Tried[]; pick: string; rest: number };
function walk(pat: string, K: number, R: number): Walk[] {
  const n = pat.length;
  const f = buildF(pat, K);
  const rows: Walk[] = [];
  let c = 4;
  let d = K;
  let r = R;
  for (let i = 0; i < n; i++) {
    const tried: Tried[] = [];
    for (let x = 0; x < 4; x++) {
      if (pat[i] !== 'N' && pat[i] !== AL[x]) continue;
      const nd = c < 4 && x < c ? d - 1 : d;
      if (nd < 1) {
        tried.push({ ch: AL[x], nd, cnt: 0, taken: false });
        continue;
      }
      const cnt = f[i + 1][x][nd];
      if (r <= cnt) {
        tried.push({ ch: AL[x], nd, cnt, taken: true });
        rows.push({ i: i + 1, tried, pick: AL[x], rest: r });
        c = x;
        d = nd;
        break;
      }
      tried.push({ ch: AL[x], nd, cnt, taken: false });
      r -= cnt;
    }
  }
  return rows;
}
const walkRows = walk(PAT, KK, RR);

const MMAX = 50000;
const KMAX = 10;
const RMAX = '2 × 10^12';
const fmt = (n: number): string => n.toLocaleString('en-US');

/* ---------- กับดักที่ทำให้ R ≤ cnt ต้องเป็น ≤ ----------
   เขียนเป็น R < cnt คือการเดินแบบนับจาก 0 จึงได้ตัวถัดไปจากที่ขอ */
const ltWrong1 = listed[RR];
const ltWrong2 = enumerate(PAT2, K2)[R2];
if (!ltWrong1 || !ltWrong2 || ltWrong1 === answer || ltWrong2 === answer2) {
  throw new Error('dna-kth: ตัวอย่างของกับดัก R < cnt ต้องให้คำตอบที่ต่างจากคำตอบจริง');
}

/* ---------- ช่องที่เดินไม่ถึงแต่ใหญ่เกิน long long ----------
   แพตเทิร์น TA ตามด้วย N อีก n ตัว และ K = 2 รอยต่อที่ T→A ใช้ท่อนที่สองไปแล้ว
   ช่อง f[2][A][2] (ยังเหลือสองท่อน) จึงไม่มีคำนำหน้าไหนเดินถึง แต่มันนับสายยาว n ที่มีรอยต่อไม่เกินหนึ่งรอย
   (ตัวก่อนหน้าคือ A ซึ่งเล็กที่สุด จึงไม่เกิดรอยต่อตรงรอยเชื่อม) นับด้วย BigInt หา n แรกที่เกิน */
const LL_MAX = BigInt('9223372036854775807');
function firstOverflowN(): { n: number; cell: bigint; reach: bigint } {
  const zero = BigInt(0);
  const one = BigInt(1);
  // g[c][e] = จำนวนสายที่จบด้วยตัว c และใช้รอยต่อไป e รอย (e = 0 หรือ 1)
  let g: bigint[][] = [0, 1, 2, 3].map(() => [one, zero]);
  for (let n = 1; n < 5000; n++) {
    const cell = g.reduce((s, r) => s + r[0] + r[1], zero);
    if (cell > LL_MAX) {
      const reach = (BigInt(n + 3) * BigInt(n + 2) * BigInt(n + 1)) / BigInt(6);
      return { n, cell, reach };
    }
    const h: bigint[][] = [0, 1, 2, 3].map(() => [zero, zero]);
    for (let c = 0; c < 4; c++)
      for (let e = 0; e < 2; e++)
        for (let x = 0; x < 4; x++) {
          const ne = x < c ? e + 1 : e;
          if (ne < 2) h[x][ne] += g[c][e];
        }
    g = h;
  }
  throw new Error('dna-kth: หา n ที่ช่องล้นไม่เจอ');
}
const ovf = firstOverflowN();
/* ตรวจตัวนับข้างบนกับการไล่ทุกสายตรง ๆ ที่ n เล็ก */
{
  const zero = BigInt(0);
  const one = BigInt(1);
  let g: bigint[][] = [0, 1, 2, 3].map(() => [one, zero]);
  for (let n = 1; n <= 6; n++) {
    const viaDp = g.reduce((s, r) => s + r[0] + r[1], zero);
    const viaBrute = allMatching('N'.repeat(n)).filter((x) => drops(x) <= 1).length;
    if (viaDp !== BigInt(viaBrute)) throw new Error(`dna-kth: ตัวนับสายรอยต่อไม่เกินหนึ่งไม่ตรงที่ n = ${n}`);
    const h: bigint[][] = [0, 1, 2, 3].map(() => [zero, zero]);
    for (let c = 0; c < 4; c++)
      for (let e = 0; e < 2; e++)
        for (let x = 0; x < 4; x++) {
          const ne = x < c ? e + 1 : e;
          if (ne < 2) h[x][ne] += g[c][e];
        }
    g = h;
  }
}
const ovfN = ovf.n;
const ovfReach = fmt(Number(ovf.reach));

/* ---------- ค่าใช้จ่าย นับรอบของลูปในสุดตามโค้ดแต่ละวิธี ----------
   ไล่สร้าง: โหนดภายใน (4^M − 1)/3 ตัว วนตัวอักษรตัวละ 4 รอบ บวกใบ 4^M ใบ ใบละเทียบรอยต่อ M − 1 รอบ
   นับแล้วเดิน: ลูป x ของตาราง M × 5 × K × 4 รอบ (โค้ดข้าม d = 0) บวกการเดินไม่เกิน 4M รอบ */
const SUB_M = 10;
const bruteLoops = (m: number): number => ((Math.pow(4, m) - 1) / 3) * 4 + Math.pow(4, m) * (m - 1);
const dpLoops = (m: number, k: number): number => m * 5 * k * 4 + 4 * m;
const bruteSub = fmt(bruteLoops(SUB_M));
const bruteFullExp = Math.round(MMAX * Math.log10(4));
const dpSub = fmt(dpLoops(SUB_M, KMAX));
const dpFull = fmt(dpLoops(MMAX, KMAX));
const subStrings = fmt(Math.pow(4, SUB_M));
/* หน่วยความจำใช้ MB = 10^6 ไบต์ทั้งหน้า ให้เทียบกับลิมิต 128 MB ได้ตรง ๆ */
const subMB = ((Math.pow(4, SUB_M) * 32) / 1e6).toFixed(1);
const tableMB = (((MMAX + 1) * 5 * (KMAX + 1) * 8) / 1e6).toFixed(1);
const dpCells = fmt(MMAX * 5 * KMAX);
const dpTries = fmt(MMAX * 5 * KMAX * 4);
if (bruteLoops(SUB_M) !== 10835284 || dpLoops(MMAX, KMAX) !== 10200000) {
  throw new Error('dna-kth: สูตรนับรอบไม่ตรงกับที่คิดมือไว้');
}

/* ---------- ผลการทดสอบ (วัดจริงด้วย WSL g++ 11.4 -O2 สคริปต์อยู่ใน scratchpad ของรอบแก้ 2026-10-20) ---------- */
const T_CHAR_PAIRS = fmt(174752);
const T_SMALL = 500;
const T_MID = 200;
const T_FULL_MS = 30;
const T_FULL_MB = '25.8'; // 25,188 KiB จาก /usr/bin/time -v
const T_SUB_S = '0.05';
const T_SUB_MB = '37.3'; // 36,404 KiB, M = 10, N ทั้งสาย, K = 10 (เก็บครบ 4^10 สาย)

/* ---------- ทดสอบตัวเอง ---------- */
const QUIZ1 = 'CATGA';
const quiz1Drops = dropAt(QUIZ1).map((i) => `${QUIZ1[i]}→${QUIZ1[i + 1]}`);
const quiz1Form = drops(QUIZ1) + 1;
if (quiz1Drops.length !== 3) throw new Error('dna-kth: ข้อทดสอบตัวเอง 1 ต้องมีรอยต่อสามรอย');

/** รอยต่อเขียนเป็นคู่ตัวอักษร (C→A) ไม่ใช้เลขตำแหน่ง จะได้ไม่ชนกับการนับตำแหน่งของตาราง */
const dropPairs = (x: string): string => dropAt(x).map((i) => `${x[i]}→${x[i + 1]}`).join(', ');

/* N ทั้งสาย M = 50,000 K = 1: ผ่านแค่สายที่เรียงขึ้นล้วน = C(M+3, 3) ยังอยู่ในคำรับประกัน 4 × 10^18 */
const allNK1 = ((MMAX + 3) * (MMAX + 2) * (MMAX + 1)) / 6;
if (allNK1 > 4e18 || allNK1 < 2 * 10 ** 12) throw new Error('dna-kth: ชุด N ทั้งสาย K = 1 ต้องเป็นอินพุตที่ถูกต้อง');
const allNK1Text = `${(allNK1 / 1e13).toFixed(1)} × 10^13`;

/* ช่องตัวอย่างของสูตร เขียนเป็นบรรทัดสำเร็จรูป (เลี่ยงการเทียบค่าในเทมเพลต) */
const exLines = exTerms.map((t) =>
  t.why.includes('ข้าม')
    ? `x = ${t.ch}: ${t.why}`
    : t.val === 0
      ? `x = ${t.ch}: ${t.why} = 0 เพราะตำแหน่ง ${EX_I + 1} ต้องเป็น ${exNext} ซึ่งเล็กกว่า ${t.ch} และไม่มีท่อนเหลือ`
      : `x = ${t.ch}: ${t.why} = ${t.val}`,
);
if (!exTerms.some((t) => t.val === 0 && !t.why.includes('ข้าม'))) {
  throw new Error('dna-kth: ช่องตัวอย่างควรมีพจน์ที่เป็น 0 เพราะตัวถัดไปถูกบังคับ');
}

const recurText = `f[M][c][d] = 1                     เมื่อ d ≥ 1 (เติมครบแล้ว)
f[i][c][d] = ผลรวมของ f[i+1][x][nd]  ทุก x ใน A C G T ที่แพตเทิร์นตำแหน่ง i ยอม
    nd = d − 1   ถ้า c < 4 และ x < c   (เกิดรอยต่อ ขึ้นท่อนใหม่)
    nd = d       ถ้าไม่ใช่กรณีนั้น
    ข้าม x ที่ทำให้ nd < 1              (ท่อนหมด)`;
const walkText = `เริ่ม c = 4, d = K
ทุกตำแหน่ง i จาก 0 ถึง M − 1:
    ไล่ x = A, C, G, T ที่แพตเทิร์นยอม (คำนวณ nd แบบเดียวกับข้างบน ข้าม nd < 1)
        cnt = f[i+1][x][nd]
        ถ้า R ≤ cnt: เลือก x ตั้ง c = x, d = nd แล้วไปตำแหน่งถัดไป
        ไม่อย่างนั้น: R = R − cnt แล้วลอง x ตัวถัดไป`;

const solution = `#include <bits/stdc++.h>
using namespace std;
typedef unsigned long long ull;
static const ull CAP = 4000000000000000000ULL;   // เพดานกันล้น ช่องที่เดินถึงไม่มีทางเกินนี้ (โจทย์รับประกัน)
static inline ull addc(ull a, ull b){ ull s=a+b; return (s>CAP||s<a)?CAP:s; }
const char* AL="ACGT";
int main(){
    int M,K; unsigned long long R;
    if(scanf("%d %d %llu",&M,&K,&R)!=3) return 0;
    static char buf[50005]; scanf("%s",buf); string s=buf;
    int D=K;                                   // จำนวน "ท่อน" ที่ยังเหลือใช้ได้ 1..K
    // f[i][c][d] = จำนวนวิธีเติมตำแหน่ง i..M-1 เมื่อตัวก่อนหน้าเป็น c และเหลือท่อนได้อีก d
    // c = 0..3 คือตัวอักษรก่อนหน้า, c = 4 คือยังไม่มีตัวก่อนหน้า (ตำแหน่งแรก)
    vector<array<array<ull,11>,5>> f(M+1);
    for(int c=0;c<5;c++) for(int d=0;d<=D;d++) f[M][c][d]= d>=1 ? 1 : 0;
    for(int i=M-1;i>=0;i--)
        for(int c=0;c<5;c++)
            for(int d=0;d<=D;d++){
                ull v=0;
                if(d>=1) for(int x=0;x<4;x++){
                    if(s[i]!='N' && s[i]!=AL[x]) continue;
                    int nd = (c<4 && x<c) ? d-1 : d;      // ลดลงเมื่อ "ตก" คือเริ่มท่อนใหม่
                    if(nd<1) continue;
                    v=addc(v,f[i+1][x][nd]);
                }
                f[i][c][d]=v;
            }
    string out; int c=4,d=D;
    for(int i=0;i<M;i++){
        for(int x=0;x<4;x++){
            if(s[i]!='N' && s[i]!=AL[x]) continue;
            int nd = (c<4 && x<c) ? d-1 : d;
            if(nd<1) continue;
            ull cnt=f[i+1][x][nd];
            if(R<=cnt){ out.push_back(AL[x]); c=x; d=nd; break; }
            R-=cnt;
        }
    }
    printf("%s\\n",out.c_str());
}`;
const subCode = `// เฉลยชุดทดสอบย่อย M ไม่เกิน 10 (20 คะแนน)
// สร้างลำดับที่เข้ากันได้ทุกอันตรง ๆ แล้วหยิบตัวที่ R ออกมา
#include <bits/stdc++.h>
using namespace std;
int M, K; long long R;
string pat, cur;
vector<string> all;
const char* AL = "ACGT";

void rec(int i) {
    if (i == M) {
        int drop = 0;                                      // จำนวนตำแหน่งที่ตัวถัดไปเล็กลง คือรอยต่อของท่อน
        for (int j = 0; j + 1 < M; j++) if (cur[j] > cur[j + 1]) drop++;
        if (drop <= K - 1) all.push_back(cur);
        return;
    }
    for (int x = 0; x < 4; x++) {
        if (pat[i] != 'N' && pat[i] != AL[x]) continue;
        cur.push_back(AL[x]); rec(i + 1); cur.pop_back();
    }
}

int main() {
    scanf("%d %d %lld", &M, &K, &R);
    char buf[64]; scanf("%s", buf); pat = buf;
    rec(0);                                                // การเรียกซ้ำไล่เรียงตามพจนานุกรมอยู่แล้ว
    printf("%s\\n", all[R - 1].c_str());
}`;
const coreSnippet = `string out; int c = 4, d = D;            // c = ตัวก่อนหน้า (4 คือยังไม่มี), d = ท่อนที่เหลือใช้ได้
for (int i = 0; i < M; i++) {
    for (int x = 0; x < 4; x++) {        // ไล่ A C G T ตามลำดับพจนานุกรม
        if (s[i] != 'N' && s[i] != AL[x]) continue;
        int nd = (c < 4 && x < c) ? d - 1 : d;   // ตัวนี้เล็กกว่าตัวก่อน แปลว่าขึ้นท่อนใหม่
        if (nd < 1) continue;
        ull cnt = f[i + 1][x][nd];       // ถ้าเลือกตัวนี้ จะมีลำดับตามมาได้กี่แบบ
        if (R <= cnt) { out.push_back(AL[x]); c = x; d = nd; break; }
        R -= cnt;                        // ตัวที่ตามหาอยู่หลังก้อนนี้ ข้ามไปทั้งก้อน
    }
}`;
/* คำอธิบายรายตำแหน่งของการเดิน สร้างจาก walkRows ตัวเดียวกับตาราง */
const triedText = (t: Tried, i: number): string =>
  t.cnt === 0 && t.nd < 1
    ? `<b>${t.ch}</b> ใช้ไม่ได้ (ท่อนหมด)`
    : `<b>${t.ch}</b>: f[${i}][${t.ch}][${t.nd}] = <b>${t.cnt}</b>`;
const skippedSum = (r: Walk): number => r.tried.filter((t) => !t.taken).reduce((s, t) => s + t.cnt, 0);
const skippedList = (r: Walk): string =>
  r.tried.filter((t) => !t.taken && t.cnt > 0).map((t) => String(t.cnt)).join(' + ');
const dnaNotes = walkRows.map((r) => ({
  note:
    `ตำแหน่งที่ <b>${r.i}</b> ` +
    (PAT[r.i - 1] !== 'N'
      ? `แพตเทิร์นกำหนดเป็น <b>${r.pick}</b> ตัวเดียว ` + triedText(r.tried[0], r.i) + ` อันดับที่ยังตามหาคือ <b>${r.rest}</b> เท่าเดิม`
      : r.tried.length === 1
      ? `ช่อง N ลอง ` + triedText(r.tried[0], r.i) + ` ตัว ไม่น้อยกว่าอันดับ <b>${r.rest}</b> เลือก <b>${r.pick}</b> โดยไม่หัก`
      : `ช่อง N ลองจากเล็กไปใหญ่ ` +
        r.tried.map((t) => triedText(t, r.i)).join(' · ') +
        ` อันดับ ${r.rest + skippedSum(r)} มากกว่า ${skippedList(r)} จึงหักออก เหลือ <b>${r.rest}</b> คืออันดับในกลุ่มสายที่ใช้ <b>${r.pick}</b> ตรงนี้`),
}));

---
<CpProblemLayout href={href}>
  <h2>โจทย์ · เติมช่องว่างใน DNA แล้วขอตัวที่ R</h2>
  <p>
    สาย DNA เขียนแทนด้วยตัวอักษรสี่ตัวคือ <code>A C G T</code> ตามชื่อนิวคลีโอไทด์สี่ชนิด
    บางตำแหน่งนักชีววิทยาระบุไม่ได้ว่าเป็นตัวไหน จึงเขียนเป็น <code>N</code> ซึ่งแทนตัวไหนก็ได้ในสี่ตัวนั้น
  </p>
  <p>
    เราเรียกลำดับที่มี <code>N</code> ว่า<strong>ลำดับไม่สมบูรณ์</strong> และลำดับที่ไม่มี <code>N</code> เลยว่า
    <strong>ลำดับสมบูรณ์</strong>
  </p>
  <p>
    ลำดับสมบูรณ์ตัวหนึ่ง <strong>เข้ากันได้</strong> กับลำดับไม่สมบูรณ์ ถ้ามันเกิดจากการเติม <code>N</code>
    ทุกตัวด้วยนิวคลีโอไทด์สักตัว เช่น <code>ACCCT</code> เข้ากันได้กับ <code>ACNNT</code> แต่ <code>AGGAT</code> ไม่เข้า
  </p>
  <p>
    ต่อมาโจทย์นิยาม<strong>รูปแบบ</strong>ของลำดับ โดยถือว่า <code>A</code> มาก่อน <code>C</code> มาก่อน
    <code>G</code> มาก่อน <code>T</code>
  </p>
  <ul>
    <li>
      <strong>รูปแบบ-1</strong>: ตัวอักษรเรียงจากน้อยไปมากตลอดสาย (ตัวติดกันซ้ำกันได้) เช่น <code>AACCGT</code>
    </li>
    <li>
      <strong>รูปแบบ-2</strong>: เป็นรูปแบบ-1 อยู่แล้ว หรือเอาสายรูปแบบ-1 สองสายมาต่อกัน
      เช่น <code>ACG</code> ต่อกับ <code>AT</code> ได้ <code>ACGAT</code>
    </li>
    <li>
      <strong>รูปแบบ-j</strong> ทั่วไป: เป็นรูปแบบ-(j−1) อยู่แล้ว
      หรือเอาสายรูปแบบ-(j−1) มาต่อท้ายด้วยสายรูปแบบ-1 อีกหนึ่งสาย
    </li>
  </ul>
  <p>
    งานของเราคือ ให้ลำดับไม่สมบูรณ์ยาว <code>M</code> ตัวมา พร้อมเลข <code>K</code> และ <code>R</code>
    แล้วหาลำดับสมบูรณ์<strong>รูปแบบ-K ตัวที่ R</strong> ตามลำดับพจนานุกรม ที่เข้ากันได้กับลำดับไม่สมบูรณ์นั้น
  </p>

  <div class="callout callout-note spec">
    <p class="callout-label">อินพุต / ขอบเขต / เอาต์พุต</p>
    <ul>
      <li><strong>อินพุต:</strong> บรรทัดแรกคือ <code>M</code>, <code>K</code>, <code>R</code> บรรทัดที่สองคือลำดับไม่สมบูรณ์ยาว <code>M</code> ตัว</li>
      <li>
        <strong>ขอบเขต:</strong> <code>M ≤ {fmt(MMAX)}</code>, <code>K ≤ {KMAX}</code>, <code>R ≤ {RMAX}</code>
        โจทย์รับประกันว่าลำดับรูปแบบ-K ที่เข้ากันได้มีไม่เกิน <code>4 × 10^18</code> ตัว และ <code>R</code> ไม่เกินจำนวนนั้น
        เวลา 1 วินาที หน่วยความจำ 128 MB
      </li>
      <li><strong>เอาต์พุต:</strong> ลำดับรูปแบบ-K ตัวที่ <code>R</code></li>
      <li><strong>ให้คะแนน:</strong> มี 20 คะแนนสำหรับชุดทดสอบที่ <code>M</code> ไม่เกิน 10</li>
    </ul>
