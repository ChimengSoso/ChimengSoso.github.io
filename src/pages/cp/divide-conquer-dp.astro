        </tr>
      </thead>
      <tbody>
        <tr data-dc-prev>
          <td>dp ชั้นที่ 1</td>
          {Array.from({ length: HN + 1 }, (_, i) => <td class="num">{fmt(dpPrev[i])}</td>)}
        </tr>
        <tr data-dc-now>
          <td>dp ชั้นที่ 2</td>
