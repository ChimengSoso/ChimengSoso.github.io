import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { texCode, mc } from '../../lib/math';

const href = 'divide-conquer-dp/';

/* ============================================================================
   ตัวเลขทุกตัวในหน้านี้งอกจากโมเดลข้างล่าง ไม่มีเลขไหนพิมพ์ด้วยมือ
   และโมเดลถูกกันด้วย throw ตอนบิลด์ ถ้าคำตอบของท่าเร็วไม่ตรงกับตัวไล่ทุกกรณี
   หน้านี้จะสร้างไม่ผ่านเลย
   ========================================================================== */

const INF = Number.POSITIVE_INFINITY;
type CostFn = (l: number, r: number) => number;

/** ดีพีสองลูปตรงไปตรงมา ไล่จุดตัดทุกจุดจริง ใช้เป็นตัวตรวจอิสระ */
function bruteLayers(n: number, k: number, C: CostFn): { dp: number[][]; opt: number[][] } {
  const dp: number[][] = Array.from({ length: k + 1 }, () => Array<number>(n + 1).fill(INF));
  const opt: number[][] = Array.from({ length: k + 1 }, () => Array<number>(n + 1).fill(0));
  dp[0][0] = 0;
  for (let j = 1; j <= k; j++) {
    for (let i = 1; i <= n; i++) {
      let best = INF;
      let bm = -1;
      for (let m = 1; m <= i; m++) {
        if (dp[j - 1][m - 1] === INF) continue;
        const v = dp[j - 1][m - 1] + C(m, i);
        if (v < best) {
          best = v;
          bm = m;
        }
      }
      dp[j][i] = best;
      opt[j][i] = bm;
    }
  }
  return { dp, opt };
}

/** ท่าแบ่งครึ่ง keepZero = จงใจปล่อยบักปล่อยกลุ่มว่าง ไว้ใช้เล่าตอนท้าย */
function dcLayers(n: number, k: number, C: CostFn, keepZero = false): { ans: number; scans: number } {
  let before = Array<number>(n + 1).fill(INF);
  before[0] = 0;
  let scans = 0;
  for (let j = 1; j <= k; j++) {
    const cur = Array<number>(n + 1).fill(INF);
    const compute = (l: number, r: number, ol: number, or_: number): void => {
      if (l > r) return;
      const mid = (l + r) >> 1;
      let best = INF;
      let bm = ol;
      const hi = Math.min(mid, or_);
      for (let m = ol; m <= hi; m++) {
        scans++;
        const v = before[m - 1] + C(m, mid);
        if (v < best) {
          best = v;
          bm = m;
        }
      }
      cur[mid] = best;
      compute(l, mid - 1, ol, bm);
      compute(mid + 1, r, bm, or_);
    };
    compute(1, n, 1, n);
    if (keepZero) cur[0] = 0;
    before = cur;
  }
  return { ans: before[n], scans };
}

/* ---------- โจทย์ตัวอย่างที่เดินให้ดูทั้งบท: ม้าแปดตัว สามคอก ---------- */
const HORSES = [1, 1, 0, 1, 0, 1, 1, 0]; // 1 = ดำ, 0 = ขาว
const HN = HORSES.length;
const HK = 3;
const hpb = [0];
for (const v of HORSES) hpb.push(hpb[hpb.length - 1] + v);
const horseCost: CostFn = (l, r) => {
  const b = hpb[r] - hpb[l - 1];
  const w = r - l + 1 - b;
  return b * w;
};
const hBrute = bruteLayers(HN, HK, horseCost);
const hAnswer = hBrute.dp[HK][HN];
const hDc = dcLayers(HN, HK, horseCost);
if (hDc.ans !== hAnswer) {
  throw new Error(`divide-conquer-dp: ท่าแบ่งครึ่งตอบ ${hDc.ans} แต่ตัวไล่ทุกกรณีตอบ ${hAnswer}`);
}
/** จำนวนช่องที่ดีพีสองลูปต้องไล่ต่อหนึ่งชั้น */
const naiveScansPerLayer = (HN * (HN + 1)) / 2;

/** แถว opt ของแต่ละชั้น ใช้โชว์ว่ามันไม่ถอยหลัง */
const optRows = [1, 2, 3].map((j) => ({
  j,
  cells: Array.from({ length: HN }, (_, t) => {
    const i = t + 1;
    return { i, v: hBrute.opt[j][i], dead: hBrute.dp[j][i] === INF };
  }),
}));

/* ---------- สเต็ปของเครื่องเดิน: การเรียกซ้ำของ compute() ในชั้นที่ 2 ---------- */
type DcStep = {
  note: string;
  mid: number;
  lo: number;
  hi: number;
  done: number[];
};
const PLAY_LAYER = 2;
const dpPrev = Array.from({ length: HN + 1 }, (_, i) => hBrute.dp[PLAY_LAYER - 1][i]);
const dpNow = Array.from({ length: HN + 1 }, (_, i) => hBrute.dp[PLAY_LAYER][i]);
const optNow = Array.from({ length: HN + 1 }, (_, i) => hBrute.opt[PLAY_LAYER][i]);

const fmt = (v: number): string => (v === INF ? '∞' : String(v));

const dcSteps: DcStep[] = [];
{
  const done: number[] = [];
  const walk = (l: number, r: number, ol: number, or_: number): void => {
    if (l > r) return;
    const mid = (l + r) >> 1;
    const hi = Math.min(mid, or_);
    let best = INF;
    let bm = ol;
    for (let m = ol; m <= hi; m++) {
      const v = dpPrev[m - 1] + horseCost(m, mid);
      if (v < best) {
        best = v;
        bm = m;
      }
    }
    done.push(mid);
    const scanned = hi - ol + 1;
    const full = mid;
    const chosen =
      best === INF
        ? 'ไม่มีทางที่ใช้ได้เลย ' + fmt(best) + ' เพราะคอกแรกต้องมีม้าอย่างน้อยหนึ่งตัว'
        : 'ได้ค่าน้อยสุด <b>' + fmt(best) + '</b> ตอนตัดที่ <b>' + bm + '</b>';
    dcSteps.push({
      note:
        'ช่วงที่กำลังเติมคือ <b>' +
        l +
        '..' +
        r +
        '</b> หยิบตรงกลางคือ <b>i = ' +
        mid +
        '</b> ก่อน ' +
        'หน้าต่างที่ต้องส่องมีแค่ <em>' +
        ol +
        '..' +
        hi +
        '</em> คือ ' +
        scanned +
        ' ช่อง แทนที่จะเป็น ' +
        full +
        ' ช่อง ' +
        chosen +
        ' จากนี้ครึ่งซ้ายจะส่องได้ไม่เกิน ' +
        bm +
        ' และครึ่งขวาจะเริ่มที่ ' +
        bm +
        ' พอดี',
      mid,
      lo: ol,
      hi,
      done: [...done],
    });
    walk(l, mid - 1, ol, bm);
    walk(mid + 1, r, bm, or_);
  };
  walk(1, HN, 1, HN);
}
const dcScansLayer = dcSteps.reduce((s, st) => s + (st.hi - st.lo + 1), 0);

/* ---------- มินิเกม: วางที่กั้นคอกเอง ----------
   เฉลยมาจากการไล่ทุกวิธีวางที่กั้นจริง ๆ ไม่ได้มาจากดีพีที่บทนี้กำลังสอน
   แล้วยังเทียบกับดีพีอีกชั้นก่อนปล่อยขึ้นหน้า */
function bestByEnumeration(xs: number[], k: number): { cost: number; cuts: number[] } {
  const n = xs.length;
  const pb = [0];
  for (const v of xs) pb.push(pb[pb.length - 1] + v);
  const cost = (l: number, r: number): number => {
    const b = pb[r] - pb[l - 1];
    return b * (r - l + 1 - b);
  };
  let best = INF;
  let bestCuts: number[] = [];
  const rec = (start: number, left: number, cuts: number[], acc: number): void => {
    if (left === 1) {
      const total = acc + cost(start, n);
      if (total < best) {
        best = total;
        bestCuts = [...cuts];
      }
      return;
    }
    for (let end = start; end <= n - (left - 1); end++) {
      rec(end + 1, left - 1, [...cuts, end], acc + cost(start, end));
    }
  };
  rec(1, k, [], 0);
  return { cost: best, cuts: bestCuts };
}

type DcPuzzleSeed = { id: string; label: string; tease: string; xs: number[]; k: number };
const DC_SEEDS: DcPuzzleSeed[] = [
  {
    id: 'g1',
    label: 'ชุดที่ 1 · ตัวอย่างของโจทย์จริง',
    tease: 'ม้าหกตัว สามคอก ชุดนี้คือตัวอย่างที่ติดมากับโจทย์ Timus เอง',
    xs: [1, 1, 0, 1, 0, 1],
    k: 3,
  },
  {
    id: 'g2',
    label: 'ชุดที่ 2 · ชุดที่บทนี้เดินให้ดู',
    tease: 'ม้าแปดตัว สามคอก ชุดเดียวกับตารางที่จะเดินให้ดูทีหลัง จำคำตอบไว้แล้วไปเทียบกันได้',
    xs: HORSES,
    k: HK,
  },
  {
    id: 'g3',
    label: 'ชุดที่ 3 · กับดักของการรีบตัด',
    tease: 'ม้าสิบสองตัว สี่คอก ชุดนี้ลงโทษคนที่รีบวางที่กั้นตรงรอยต่อสีแรก ๆ',
    xs: [1, 0, 1, 0, 1, 1, 1, 1, 0, 0, 0, 0],
    k: 4,
  },
];

/** กฎโลภที่คนคิดออกก่อนเสมอ คือตัดตรงรอยต่อสีที่เจอก่อน จนครบจำนวนที่กั้น */
function greedyFirstBoundaries(xs: number[], k: number): number {
  const marks: number[] = [];
  for (let i = 1; i < xs.length; i++) if (xs[i] !== xs[i - 1]) marks.push(i);
  const cuts = marks.slice(0, k - 1);
  const bounds = [0, ...cuts, xs.length];
  let sum = 0;
  for (let t = 0; t + 1 < bounds.length; t++) {
    const seg = xs.slice(bounds[t], bounds[t + 1]);
    const b = seg.filter((v) => v === 1).length;
    sum += b * (seg.length - b);
  }
  return sum;
}

type DcPuzzle = DcPuzzleSeed & { best: number; bestCuts: number[] };
const dcPuzzles: DcPuzzle[] = DC_SEEDS.map((s) => {
  const enumerated = bestByEnumeration(s.xs, s.k);
  const pb = [0];
  for (const v of s.xs) pb.push(pb[pb.length - 1] + v);
  const C: CostFn = (l, r) => {
    const b = pb[r] - pb[l - 1];
    return b * (r - l + 1 - b);
  };
  const viaDp = bruteLayers(s.xs.length, s.k, C).dp[s.k][s.xs.length];
  const viaDc = dcLayers(s.xs.length, s.k, C).ans;
  if (enumerated.cost !== viaDp || viaDp !== viaDc) {
    throw new Error(
      `มินิเกมของ divide-conquer-dp: ชุด ${s.id} ไล่ทุกวิธีได้ ${enumerated.cost} ดีพีได้ ${viaDp} ท่าแบ่งครึ่งได้ ${viaDc}`,
    );
  }
  return { ...s, best: enumerated.cost, bestCuts: enumerated.cuts };
});
const trapSeed = DC_SEEDS[2];
const trapGreedy = greedyFirstBoundaries(trapSeed.xs, trapSeed.k);
const trapBest = dcPuzzles[2].best;
if (trapGreedy <= trapBest) {
  throw new Error(`divide-conquer-dp: ชุดที่ 3 ควรเป็นกับดักของกฎโลภ แต่กฎโลภได้ ${trapGreedy} ส่วนคำตอบจริง ${trapBest}`);
}

const dcJson = JSON.stringify(
  dcPuzzles.map((p) => ({ id: p.id, label: p.label, tease: p.tease, xs: p.xs, k: p.k, best: p.best })),
);

/* ---------- ตัวอย่างค้าน: ค่าใช้จ่ายที่ทำให้ opt ถอยหลัง แล้วท่าแบ่งครึ่งตอบผิด ---------- */
const CE: Record<string, number> = {
  '1,1': 7,
  '1,2': 6,
  '1,3': 6,
  '1,4': 3,
  '2,2': 4,
  '2,3': 4,
  '2,4': 0,
  '3,3': 0,
  '3,4': 2,
  '4,4': 9,
};
const ceCost: CostFn = (l, r) => CE[`${l},${r}`];
const CE_N = 4;
const CE_K = 2;
const ceBrute = bruteLayers(CE_N, CE_K, ceCost);
const ceTruth = ceBrute.dp[CE_K][CE_N];
const ceGot = dcLayers(CE_N, CE_K, ceCost).ans;
const ceOptRow = Array.from({ length: CE_N }, (_, t) => ceBrute.opt[CE_K][t + 1]);
if (ceGot === ceTruth) {
  throw new Error('divide-conquer-dp: ตัวอย่างค้านไม่ค้านแล้ว ท่าแบ่งครึ่งดันตอบถูก');
}
/** คู่ที่ทำให้อสมการสี่เหลี่ยมพัง หาโดยไล่ทุก a<=b<=c<=d */
function firstQiBreak(n: number, C: CostFn): { a: number; b: number; c: number; d: number } | null {
  for (let a = 1; a <= n; a++)
    for (let b = a; b <= n; b++)
      for (let c = b; c <= n; c++)
        for (let d = c; d <= n; d++) if (C(a, c) + C(b, d) > C(a, d) + C(b, c)) return { a, b, c, d };
  return null;
}
const ceBreak = firstQiBreak(CE_N, ceCost);
if (ceBreak === null) throw new Error('divide-conquer-dp: ตัวอย่างค้านควรทำให้อสมการสี่เหลี่ยมพัง');
const horseQiBreak = firstQiBreak(HN, horseCost);
if (horseQiBreak !== null) throw new Error('divide-conquer-dp: ค่าใช้จ่ายของม้าสองสีควรผ่านอสมการสี่เหลี่ยม');

/* ---------- บักปล่อยกลุ่มว่าง: ค่าใช้จ่ายที่มีค่าเปิดกลุ่ม ---------- */
const FEE = 10;
const FEE_N = 6;
const FEE_K = 3;
const feeCost: CostFn = (l, r) => FEE + (r - l + 1);
const feeTruth = bruteLayers(FEE_N, FEE_K, feeCost).dp[FEE_K][FEE_N];
const feeBuggy = dcLayers(FEE_N, FEE_K, feeCost, true).ans;
const feeFixed = dcLayers(FEE_N, FEE_K, feeCost, false).ans;
if (feeFixed !== feeTruth || feeBuggy === feeTruth) {
  throw new Error('divide-conquer-dp: ตัวอย่างบักปล่อยกลุ่มว่างไม่แสดงอาการตามที่เล่า');
}
if (firstQiBreak(FEE_N, feeCost) !== null) {
  throw new Error('divide-conquer-dp: ค่าใช้จ่ายแบบมีค่าเปิดกลุ่มควรผ่านอสมการสี่เหลี่ยม');
}

/* ---------- ภาพที่ 1: แบ่งของที่เรียงอยู่แล้วเป็นกอง ---------- */
const CW = 96;
const CGAP = 10;
const cellX = (i: number): number => 18 + i * (CW + CGAP);
const D1_RIGHT = cellX(HN - 1) + CW;
const D1_BOTTOM = 188;
const d1Cuts = [3, 5]; // ตัดหลังตัวที่ 3 และตัวที่ 5 เพื่อให้เห็นสามกอง
const d1Groups = [
  { l: 1, r: 3 },
  { l: 4, r: 5 },
  { l: 6, r: HN },
];
const d1Total = d1Groups.reduce((s, g) => s + horseCost(g.l, g.r), 0);
const d1VB = `0 0 ${D1_RIGHT + 12} ${D1_BOTTOM + 34}`;

/* ---------- ภาพที่ 2: ต้นไม้การเรียกซ้ำของ compute() ----------
   วาง x ตามลำดับการเดินแบบ in-order เพื่อให้ลูกอยู่ใต้พ่อจริง ๆ ไม่ใช่แค่เรียงเป็นแถว */
type TreeNode = {
  id: number;
  parent: number;
  l: number;
  r: number;
  ol: number;
  or_: number;
  mid: number;
  depth: number;
  x: number;
};
const TREE_BW = 92;
const TREE_SLOT = 100;
const TREE_BH = 50;
const TREE_GAPY = 74;
const treeNodes: TreeNode[] = [];
{
  let slot = 0;
  const build = (l: number, r: number, ol: number, or_: number, depth: number, parent: number): void => {
    if (l > r) return;
    const mid = (l + r) >> 1;
    const hi = Math.min(mid, or_);
    let best = INF;
    let bm = ol;
    for (let m = ol; m <= hi; m++) {
      const v = dpPrev[m - 1] + horseCost(m, mid);
      if (v < best) {
        best = v;
        bm = m;
      }
    }
    const id = treeNodes.length;
    const node: TreeNode = { id, parent, l, r, ol, or_: hi, mid, depth, x: 0 };
    treeNodes.push(node);
    build(l, mid - 1, ol, bm, depth + 1, id);
    node.x = 14 + slot * TREE_SLOT;
    slot++;
    build(mid + 1, r, bm, or_, depth + 1, id);
  };
  build(1, HN, 1, HN, 0, -1);
}
const treeDepth = Math.max(...treeNodes.map((nd) => nd.depth));
const treeRight = Math.max(...treeNodes.map((nd) => nd.x + TREE_BW));
const treeBottom = 16 + treeDepth * TREE_GAPY + TREE_BH;
const d2VB = `0 0 ${treeRight + 12} ${treeBottom + 34}`;
const treeY = (d: number): number => 16 + d * TREE_GAPY;
const treeEdges = treeNodes
  .filter((nd) => nd.parent >= 0)
  .map((nd) => ({ from: treeNodes[nd.parent], to: nd }));

/* ---------- สูตร ---------- */
const MIN_OP = '\\mathop{\\textcolor{#50FA7B}{\\min}}\\limits';
const DP = mc.fn('dp');
const CC = mc.fn('C');
const OPT = mc.fn('opt');
const ONE = mc.num('1');
const EQ = mc.op('=');
const PLUS = mc.op('+');
const MINUS = mc.op('-');
const LE = mc.op('\\le');

const texRec = texCode(
  DP + '[j][i] ' + EQ + ' ' + MIN_OP + '_{m ' + LE + ' i} \\Big( ' +
    DP + '[j' + MINUS + ONE + '][m' + MINUS + ONE + '] ' + PLUS + ' ' + CC + '(m,\\, i) \\Big)',
);
const texOpt = texCode(
  OPT + '(j, i) ' + EQ + ' \\text{ค่า } m \\text{ ที่ทำให้วงเล็บข้างบนน้อยที่สุด}',
);
const texMono = texCode(OPT + '(j, i) \\; ' + LE + ' \\; ' + OPT + '(j, i' + PLUS + ONE + ')');
const texQi = texCode(
  CC + '(a, c) ' + PLUS + ' ' + CC + '(b, d) \\;' + LE + '\\; ' + CC + '(a, d) ' + PLUS + ' ' + CC + '(b, c)',
);

/* ---------- โค้ด ----------
   ทุกชิ้นคอมไพล์ด้วย g++ 11.4 แล้วสุ่มเทียบกับตัวไล่ทุกกรณี 600 รอบ ตรงกันหมด */
const codeTemplate = `// แม่แบบท่าแบ่งครึ่ง ใช้ได้ทุกข้อที่ dp[j][i] = min ของ dp[j-1][m-1] + C(m, i)
// เปลี่ยนแค่ฟังก์ชัน C กับการอ่านอินพุต ที่เหลือลอกทั้งก้อน
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

int n, k;
vector<ll> dpBefore, dpCur;

ll C(int l, int r);              // ค่าใช้จ่ายของกลุ่มที่รับตัวที่ l..r

const ll INF = LLONG_MAX / 4;

// เติม dpCur[l..r] โดยรู้ว่าจุดตัดที่ดีที่สุดของช่วงนี้อยู่ใน [optl, optr]
void compute(int l, int r, int optl, int optr) {
    if (l > r) return;
    int mid = (l + r) / 2;
    pair<ll, int> best = {INF * 2, -1};
    for (int m = optl; m <= min(mid, optr); m++)
        best = min(best, {dpBefore[m - 1] + C(m, mid), m});
    dpCur[mid] = best.first;
    int opt = best.second;
    compute(l, mid - 1, optl, opt);      // ครึ่งซ้าย จุดตัดไม่เกิน opt
    compute(mid + 1, r, opt, optr);      // ครึ่งขวา จุดตัดไม่น้อยกว่า opt
}

ll solve() {
    dpBefore.assign(n + 1, INF);
    dpCur.assign(n + 1, INF);
    dpBefore[0] = 0;                 // ชั้นที่ 0 ครอบได้แค่ของศูนย์ตัว

    for (int j = 1; j <= k; j++) {
        fill(dpCur.begin(), dpCur.end(), INF);
        compute(1, n, 1, n);
        swap(dpBefore, dpCur);       // dpCur[0] ยังเป็น INF ซึ่งถูกแล้ว เพราะกลุ่มว่างไม่ได้
    }
    return dpBefore[n];
}`;

const codeHorses = `// ม้าสองสี: แบ่งม้า n ตัวที่เรียงอยู่แล้วเป็น k คอก ให้ผลรวม (ดำ x ขาว) ของทุกคอกน้อยที่สุด
// อินพุต: n k แล้วตามด้วย n บรรทัด บรรทัดละ 1 (ดำ) หรือ 0 (ขาว)
// เอาต์พุต: ค่าความไม่พอใจรวมที่น้อยที่สุด
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

int n, k;
vector<int> pb;                 // pb[i] = จำนวนม้าดำในตัวที่ 1..i
vector<ll> dpBefore, dpCur;

// ค่าใช้จ่ายของคอกที่รับม้าตัวที่ l..r (นับจาก 1)
ll C(int l, int r) {
    ll b = pb[r] - pb[l - 1];
    ll w = (r - l + 1) - b;
    return b * w;
}

const ll INF = LLONG_MAX / 4;

// เติม dpCur[l..r] โดยรู้ว่าจุดตัดที่ดีที่สุดของช่วงนี้อยู่ใน [optl, optr]
void compute(int l, int r, int optl, int optr) {
    if (l > r) return;
    int mid = (l + r) / 2;
    pair<ll, int> best = {INF * 2, -1};
    for (int m = optl; m <= min(mid, optr); m++)     // คอกสุดท้ายรับม้าตัวที่ m..mid
        best = min(best, {dpBefore[m - 1] + C(m, mid), m});
    dpCur[mid] = best.first;
    int opt = best.second;
    compute(l, mid - 1, optl, opt);
    compute(mid + 1, r, opt, optr);
}

int main() {
    if (scanf("%d %d", &n, &k) != 2) return 0;
    pb.assign(n + 1, 0);
    for (int i = 1; i <= n; i++) { int c; scanf("%d", &c); pb[i] = pb[i - 1] + c; }

    dpBefore.assign(n + 1, INF);
    dpCur.assign(n + 1, INF);
    dpBefore[0] = 0;                 // ชั้นที่ 0 คือยังไม่เปิดคอกเลย ครอบได้แค่ของศูนย์ตัว

    for (int j = 1; j <= k; j++) {
        fill(dpCur.begin(), dpCur.end(), INF);
        compute(1, n, 1, n);
        swap(dpBefore, dpCur);       // dpCur[0] ยังเป็น INF ซึ่งถูกแล้ว เพราะคอกว่างไม่ได้
    }
    printf("%lld\\n", dpBefore[n]);
    return 0;
}`;

const codeGondolas = `// Ciel and Gondolas: แบ่งคิว n คนเป็น k กลุ่มติดกัน ให้ผลรวมความไม่คุ้นเคยในกลุ่มน้อยที่สุด
// อินพุต: n k แล้วตารางความไม่คุ้นเคย n x n   เอาต์พุต: ผลรวมที่น้อยที่สุด
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

int n, k;
vector<vector<int>> S;          // S[i][j] = ผลรวมสี่เหลี่ยมมุมบนซ้าย (1,1) ถึง (i,j)
vector<ll> dpBefore, dpCur;

// ความไม่คุ้นเคยรวมของกลุ่มที่รับคนที่ l..r  คือครึ่งหนึ่งของสี่เหลี่ยม เพราะตารางสมมาตร
ll C(int l, int r) {
    return (ll)(S[r][r] - S[l - 1][r] - S[r][l - 1] + S[l - 1][l - 1]) / 2;
}

const ll INF = LLONG_MAX / 4;

// เติม dpCur[l..r] โดยรู้ว่าจุดตัดที่ดีที่สุดของช่วงนี้อยู่ใน [optl, optr]
void compute(int l, int r, int optl, int optr) {
    if (l > r) return;
    int mid = (l + r) / 2;
    pair<ll, int> best = {INF * 2, -1};
    for (int m = optl; m <= min(mid, optr); m++)
        best = min(best, {dpBefore[m - 1] + C(m, mid), m});
    dpCur[mid] = best.first;
    int opt = best.second;
    compute(l, mid - 1, optl, opt);
    compute(mid + 1, r, opt, optr);
}

int main() {
    if (scanf("%d %d", &n, &k) != 2) return 0;
    S.assign(n + 1, vector<int>(n + 1, 0));
    for (int i = 1; i <= n; i++)
        for (int j = 1; j <= n; j++) {
            int v; scanf("%d", &v);
            S[i][j] = v + S[i - 1][j] + S[i][j - 1] - S[i - 1][j - 1];
        }

    dpBefore.assign(n + 1, INF);
    dpCur.assign(n + 1, INF);
    dpBefore[0] = 0;                 // ชั้นที่ 0 คือยังไม่เปิดกลุ่มเลย ครอบได้แค่ของศูนย์ตัว

    for (int j = 1; j <= k; j++) {
        fill(dpCur.begin(), dpCur.end(), INF);
        compute(1, n, 1, n);
        swap(dpBefore, dpCur);       // dpCur[0] ยังเป็น INF ซึ่งถูกแล้ว เพราะกลุ่มว่างไม่ได้
    }
    printf("%lld\\n", dpBefore[n]);
    return 0;
}`;

const codeYamp = `// Yet Another Minimization Problem: แบ่งอาเรย์ n ตัวเป็น k ช่วงติดกัน
// ค่าใช้จ่ายของช่วงคือจำนวนคู่ตำแหน่งในช่วงนั้นที่ค่าเท่ากัน ให้ผลรวมน้อยที่สุด
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

int n, k;
vector<int> a, cnt;
vector<ll> dpBefore, dpCur;
int curL = 1, curR = 0;
ll curCost = 0;

void addAt(int i) { curCost += cnt[a[i]]++; }      // ตัวใหม่จับคู่กับตัวที่ค่าเดียวกันซึ่งอยู่ในหน้าต่างแล้ว
void remAt(int i) { curCost -= --cnt[a[i]]; }

// ค่าใช้จ่ายของช่วง l..r ได้จากการเลื่อนขอบหน้าต่างเดิม ขยายก่อนแล้วค่อยหด
ll C(int l, int r) {
    while (curR < r) addAt(++curR);
    while (curL > l) addAt(--curL);
    while (curR > r) remAt(curR--);
    while (curL < l) remAt(curL++);
    return curCost;
}

const ll INF = LLONG_MAX / 4;

// เติม dpCur[l..r] โดยรู้ว่าจุดตัดที่ดีที่สุดของช่วงนี้อยู่ใน [optl, optr]
void compute(int l, int r, int optl, int optr) {
    if (l > r) return;
    int mid = (l + r) / 2;
    pair<ll, int> best = {INF * 2, -1};
    for (int m = optl; m <= min(mid, optr); m++)
        best = min(best, {dpBefore[m - 1] + C(m, mid), m});
    dpCur[mid] = best.first;
    int opt = best.second;
    compute(l, mid - 1, optl, opt);
    compute(mid + 1, r, opt, optr);
}

int main() {
    if (scanf("%d %d", &n, &k) != 2) return 0;
    a.assign(n + 1, 0);
    for (int i = 1; i <= n; i++) scanf("%d", &a[i]);
    cnt.assign(n + 2, 0);

    dpBefore.assign(n + 1, INF);
    dpCur.assign(n + 1, INF);
    dpBefore[0] = 0;                 // ชั้นที่ 0 คือยังไม่เปิดช่วงเลย ครอบได้แค่ของศูนย์ตัว

    for (int j = 1; j <= k; j++) {
        fill(dpCur.begin(), dpCur.end(), INF);
        compute(1, n, 1, n);
        swap(dpBefore, dpCur);       // dpCur[0] ยังเป็น INF ซึ่งถูกแล้ว เพราะช่วงว่างไม่ได้
    }
    printf("%lld\\n", dpBefore[n]);
    return 0;
}`;

const codeBrute = `// ตัวตรวจอิสระ: ดีพีสองลูปตรงไปตรงมา ไล่จุดตัดทุกจุดจริง
// ไม่มีการแบ่งครึ่ง ไม่มีข้ออ้างว่า opt ไม่ถอยหลัง จึงไม่ได้ทดสอบข้ออ้างของตัวจริงเลย
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

ll C(int l, int r);              // ใส่ค่าใช้จ่ายของโจทย์ที่กำลังตรวจ

int main() {
    int n, k; if (scanf("%d %d", &n, &k) != 2) return 0;
    // ... อ่านอินพุตของโจทย์นั้น ...
    const ll INF = LLONG_MAX / 4;
    vector<vector<ll>> dp(k + 1, vector<ll>(n + 1, INF));
    dp[0][0] = 0;
    for (int j = 1; j <= k; j++)
        for (int i = 1; i <= n; i++)
            for (int m = 1; m <= i; m++)
                if (dp[j - 1][m - 1] < INF)
                    dp[j][i] = min(dp[j][i], dp[j - 1][m - 1] + C(m, i));
    printf("%lld\\n", dp[k][n]);
    return 0;
}`;

const codeOptPrint = `// เครื่องมือที่ควรเขียนก่อนเชื่อว่าใช้ท่านี้ได้: พิมพ์แถว opt ออกมาดูเลย
// ถ้าเลขในแถวไหนลดลงแม้แต่ครั้งเดียว แปลว่าท่าแบ่งครึ่งใช้กับโจทย์นี้ไม่ได้
for (int j = 1; j <= k; j++) {
    printf("opt ชั้น %d:", j);
    int last = 0;
    for (int i = 1; i <= n; i++) {
        printf(" %d", opt[j][i]);
        if (opt[j][i] < last) printf("(ถอยหลัง!)");
        last = opt[j][i];
    }
    printf("\\n");
}`;
