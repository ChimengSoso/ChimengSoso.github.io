    white-space:nowrap;
    color:#cdd6ea;
  }
  table.rec th.num{text-align:right;}
  .dim{color:#7b8397;}

  /* ---------- กระดานของเครื่องเดิน ----------
     ล็อกความกว้างคอลัมน์ไว้ ไม่งั้นช่องที่เปลี่ยนจาก · เป็นตัวเลขจะดันตารางทั้งใบ */
  table.rec.dcboard{
    table-layout:fixed;
    width:0;
    min-width:100%;
  }
  table.rec.dcboard th:first-child,
  table.rec.dcboard td:first-child{width:8.2rem;}
  table.rec.dcboard th.num,
  table.rec.dcboard td.num{width:3.1rem;}
  /* คลาสสถานะต้องมี .num ด้วย ไม่งั้นแพ้ table.rec td.num ที่ตั้งสีไว้แล้ว */
  table.rec.dcboard td.num.is-mid{
    background:rgba(74,222,128,0.18);
    color:#eaf4ff;
    font-weight:700;
  }
  table.rec.dcboard td.num.is-src{
    background:rgba(224,180,0,0.16);
    color:#ffe9a8;
  }

  /* ---------- แถวม้าของมินิเกม ---------- */
  .dc-row{display:flex;align-items:stretch;width:max-content;padding:0.2rem 0;}
  .dc-row :global(.dc-h){
    flex:0 0 auto;
    width:2.2rem;height:2.6rem;
    display:flex;align-items:center;justify-content:center;
    font-size:1.05rem;
    border:1px solid #2a3350;border-radius:6px;
    background:#101827;color:#7b8397;
  }
  .dc-row :global(.dc-h.black){background:#1b2436;color:#cdd6ea;border-color:#4a5a7d;}
  .dc-row :global(.dc-gap){
    flex:0 0 auto;
    width:1.1rem;
    border:none;background:none;padding:0;margin:0;
    cursor:pointer;
    display:flex;align-items:center;justify-content:center;
  }
  .dc-row :global(.dc-gap::before){
    content:"";
    display:block;
    width:3px;height:2.2rem;
    border-radius:2px;
    background:#1c2540;
  }
  .dc-row :global(.dc-gap:hover::before){background:#3a4a72;}
  .dc-row :global(.dc-gap.on::before){background:#e0b400;}
  .dc-row :global(.dc-edge){flex:0 0 auto;width:0.4rem;}
</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type DcPuzzle = { id: string; label: string; tease: string; xs: number[]; k: number; best: number };

  function initDcGame(): void {
    const maybeUi = cpGameUi('[data-dcgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as DcPuzzle[];
    if (puzzles.length === 0) return;

    const rowEl = ui.root.querySelector<HTMLElement>('[data-dc-row]');
    const nEl = ui.root.querySelector<HTMLElement>('[data-dc-n]');
    const kEl = ui.root.querySelector<HTMLElement>('[data-dc-k]');
    const cutsEl = ui.root.querySelector<HTMLElement>('[data-dc-cuts]');
    if (!rowEl || !nEl || !kEl || !cutsEl) return;
    const row: HTMLElement = rowEl;
    const nOut: HTMLElement = nEl;
    const kOut: HTMLElement = kEl;
    const cutsOut: HTMLElement = cutsEl;

    let pi = 0;
    let cuts = new Set<number>();

    const pz = (): DcPuzzle => puzzles[pi];

    /** ค่าของการแบ่งปัจจุบัน คือผลรวมของ (ดำ x ขาว) ทุกคอก */
    function totalCost(): number {
      const p = pz();
      const marks = [...cuts].sort((a, b) => a - b);
      const bounds = [0, ...marks, p.xs.length];
      let sum = 0;
      for (let t = 0; t + 1 < bounds.length; t++) {
        const seg = p.xs.slice(bounds[t], bounds[t + 1]);
        const b = seg.filter((v) => v === 1).length;
        sum += b * (seg.length - b);
      }
      return sum;
    }

    function build(): void {
      const p = pz();
      row.textContent = '';
      const edge = document.createElement('span');
      edge.className = 'dc-edge';
      row.appendChild(edge);
      p.xs.forEach((v, t) => {
        const cell = document.createElement('span');
        cell.className = v === 1 ? 'dc-h black' : 'dc-h';
        cell.textContent = v === 1 ? '●' : '○';
        row.appendChild(cell);
        if (t < p.xs.length - 1) {
          const gap = document.createElement('button');
          gap.type = 'button';
          gap.className = 'dc-gap';
          gap.dataset.gap = String(t + 1);
          gap.setAttribute('aria-label', `วางที่กั้นหลังม้าตัวที่ ${t + 1}`);
          row.appendChild(gap);
        }
      });
      const edge2 = document.createElement('span');
      edge2.className = 'dc-edge';
      row.appendChild(edge2);
    }

    function render(): void {
      const p = pz();
      for (const g of Array.from(row.querySelectorAll<HTMLElement>('.dc-gap'))) {
        g.classList.toggle('on', cuts.has(Number(g.dataset.gap)));
      }
      nOut.textContent = String(p.xs.length);
      kOut.textContent = String(p.k);
      cutsOut.textContent = String(p.k - 1);
      if (cuts.size === 0) {
        ui.setScore('ตอนนี้ยังไม่ได้วางที่กั้น');
        return;
      }
      ui.setScore(`วางที่กั้นแล้ว ${cuts.size} จาก ${p.k - 1} อัน ค่าตอนนี้รวม ${totalCost()}`);
    }

    function check(): void {
      const p = pz();
      if (cuts.size !== p.k - 1) {
        ui.setStatus(`ต้องวางที่กั้นให้ครบ ${p.k - 1} อันก่อนครับ ตอนนี้วางไป ${cuts.size} อัน`, 'bad');
        return;
      }
      const got = totalCost();
      if (got === p.best) {
        ui.setStatus(`ถูกต้องครับ ${got} คือค่าที่น้อยที่สุดของกองนี้`, 'good');
        return;
      }
      ui.setStatus(
        `การแบ่งนี้ได้ ${got} ซึ่งยังมากกว่าคำตอบที่ดีที่สุดอยู่ ${got - p.best} ลองขยับที่กั้นดูอีกที`,
        'bad',
      );
    }

    function selectPuzzle(t: number): void {
      pi = t;
      cuts = new Set<number>();
      ui.selectTab(t);
      ui.setTease(pz().tease);
      build();
      ui.setStatus('คลิกช่องว่างระหว่างม้าเพื่อวางที่กั้น');
      render();
    }

    row.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest('.dc-gap');
      if (!(btn instanceof HTMLElement)) return;
      const at = Number(btn.dataset.gap);
      if (cuts.has(at)) cuts.delete(at);
      else cuts.add(at);
      ui.setStatus('คลิกช่องว่างระหว่างม้าเพื่อวางที่กั้น');
      render();
    });

    ui.onClick('data-dc-clear', () => selectPuzzle(pi));
    ui.onClick('data-dc-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initDcGame);
</script>

<script>
  import { initCpPlayers } from '../../lib/cpPlayer';

  /* ตัวเล่นของหน้านี้เดินไปตาม "คอลัมน์" ไม่ใช่ตามแถว เพราะหนึ่งก้าวคือการเรียก compute() หนึ่งครั้ง
     ซึ่งเติมช่องกลางของช่วง ไม่ได้ไล่จากซ้ายไปขวา จึงใช้ initCpRowPlayers ไม่ได้ */
  type DcStep = { note: string; mid: number; lo: number; hi: number; done: number[] };

  function isDcStep(x: unknown): x is DcStep {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return (
      typeof o.note === 'string' &&
      typeof o.mid === 'number' &&
      typeof o.lo === 'number' &&
      typeof o.hi === 'number' &&
      Array.isArray(o.done)
    );
  }

  document.addEventListener('astro:page-load', () => {
    initCpPlayers<DcStep>('[data-dcsim]', {
      narrow: (raw) => {
        const ok = raw.filter(isDcStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      draw: (st, ctx) => {
        const root = ctx.parts.root;
        const prevRow = root.querySelector<HTMLTableRowElement>('[data-dc-prev]');
        const nowRow = root.querySelector<HTMLTableRowElement>('[data-dc-now]');
        const optRow = root.querySelector<HTMLTableRowElement>('[data-dc-opt]');
        if (!prevRow || !nowRow || !optRow) return;

        /* แถวบนคือชั้นที่คำนวณเสร็จแล้ว โชว์ครบตลอด แค่ไฮไลต์ช่องที่กำลังถูกส่อง
           ต้นทางของจุดตัด m คือช่อง m-1 ของแถวบน */
        const prevCells = Array.from(prevRow.querySelectorAll<HTMLTableCellElement>('td.num'));
        prevCells.forEach((td, i) => {
          td.classList.toggle('is-src', i >= st.lo - 1 && i <= st.hi - 1);
        });

        for (const tr of [nowRow, optRow]) {
          const cells = Array.from(tr.querySelectorAll<HTMLTableCellElement>('td.num'));
          cells.forEach((td, i) => {
            const shown = st.done.includes(i);
            td.textContent = shown ? (td.dataset.v ?? '·') : '·';
            td.classList.toggle('is-mid', i === st.mid);
          });
        }
        const live = nowRow.querySelectorAll<HTMLTableCellElement>('td.num')[st.mid];
        ctx.keepInView(live ?? null);
      },
    });
  });
</script>
