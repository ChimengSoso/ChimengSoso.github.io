<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type SwPuzzle = { id: string; label: string; tease: string; arr: number[]; cap: number; best: number };

  function initWindowGame(): void {
    const maybeUi = cpGameUi('[data-swgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as SwPuzzle[];
    if (puzzles.length === 0) return;

    const stripEl = ui.root.querySelector<HTMLElement>('[data-sw-strip]');
    const sumEl = ui.root.querySelector<HTMLElement>('[data-sw-sum]');
    const capEl = ui.root.querySelector<HTMLElement>('[data-sw-cap]');
    const lenEl = ui.root.querySelector<HTMLElement>('[data-sw-len]');
    const bestEl = ui.root.querySelector<HTMLElement>('[data-sw-best]');
    const backEl = ui.root.querySelector<HTMLElement>('[data-sw-back]');
    if (!stripEl || !sumEl || !capEl || !lenEl || !bestEl || !backEl) return;
    const strip: HTMLElement = stripEl;
    const sumOut: HTMLElement = sumEl;
    const capOut: HTMLElement = capEl;
    const lenOut: HTMLElement = lenEl;
    const bestOut: HTMLElement = bestEl;
    const backOut: HTMLElement = backEl;

    let pi = 0;
    let l = 0;
    let r = -1;
    let bestSeen = 0;
    let leftRetreats = 0;

    const pz = (): SwPuzzle => puzzles[pi];
    const sum = (): number => {
      let s = 0;
      for (let k = l; k <= r; k++) s += pz().arr[k];
      return s;
    };
    const len = (): number => Math.max(0, r - l + 1);

    function buildStrip(): void {
      const p = pz();
      strip.textContent = '';
      p.arr.forEach((v, i) => {
        const cell = document.createElement('span');
        cell.className = 'sw-cell';
        cell.dataset.i = String(i);
        cell.textContent = String(v);
        strip.appendChild(cell);
      });
    }

    function render(): void {
      const p = pz();
      const s = sum();
      for (const cell of Array.from(strip.querySelectorAll<HTMLElement>('.sw-cell'))) {
        const i = Number(cell.dataset.i);
        const inside = i >= l && i <= r;
        cell.classList.toggle('in', inside && s <= p.cap);
        cell.classList.toggle('over', inside && s > p.cap);
      }
      sumOut.textContent = String(s);
      capOut.textContent = String(p.cap);
      lenOut.textContent = String(len());
      if (s <= p.cap && len() > bestSeen) bestSeen = len();
      bestOut.textContent = String(bestSeen);
      backOut.textContent = String(leftRetreats);
    }

    function moveRight(d: number): void {
      const p = pz();
      r = Math.max(l - 1, Math.min(p.arr.length - 1, r + d));
      ui.setStatus('ขยับขอบขวาเพื่อรับของเพิ่ม ขยับขอบซ้ายเพื่อทิ้งของออก');
      render();
    }

    function moveLeft(d: number): void {
      if (d < 0 && l === 0) return;
      if (d < 0) leftRetreats++;
      l = Math.max(0, Math.min(r + 1, l + d));
      ui.setStatus(
        d < 0
          ? 'สังเกตว่าคุณเพิ่งถอยขอบซ้ายกลับ ลองถามตัวเองว่าจำเป็นจริงไหม'
          : 'ขยับขอบขวาเพื่อรับของเพิ่ม ขยับขอบซ้ายเพื่อทิ้งของออก',
      );
      render();
    }

    function check(): void {
      const p = pz();
      if (bestSeen === p.best) {
        const note = leftRetreats === 0
          ? ' และคุณทำได้โดยไม่ต้องถอยขอบซ้ายกลับเลยสักครั้ง ซึ่งคือหัวใจของบทนี้'
          : ` โดยถอยขอบซ้ายกลับไป ${leftRetreats} ครั้ง ลองใหม่อีกรอบโดยไม่ถอยเลยดูครับ`;
        ui.setStatus(`ยาวที่สุดคือ ${p.best} ช่อง ซึ่งคุณหาเจอแล้ว${note}`, 'good');
      } else {
        ui.setStatus(`ตอนนี้ยาวที่สุดที่เจอคือ ${bestSeen} ช่อง แต่ยังมีช่วงที่ยาวถึง ${p.best} ช่อง`, 'bad');
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      l = 0;
      r = -1;
      bestSeen = 0;
      leftRetreats = 0;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildStrip();
      ui.setStatus('ขยับขอบขวาเพื่อรับของเพิ่ม ขยับขอบซ้ายเพื่อทิ้งของออก');
      render();
    }

    ui.onClick('data-sw-rplus', () => moveRight(1));
    ui.onClick('data-sw-rminus', () => moveRight(-1));
    ui.onClick('data-sw-lplus', () => moveLeft(1));
    ui.onClick('data-sw-lminus', () => moveLeft(-1));
    ui.onClick('data-sw-check', check);
    ui.onClick('data-sw-reset', () => selectPuzzle(pi));
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initWindowGame);
</script>
