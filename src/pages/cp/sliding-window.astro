---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const href = 'sliding-window/';

/* ---------- ตัวเลขในหน้านี้งอกจากโมเดลข้างล่างนี้ ---------- */

const DEMO = [3, 1, 4, 1, 5, 9, 2, 6];
const S = 10;

/** เดินสองตัวชี้บนตัวอย่าง เก็บทุกก้าวไว้ทำตาราง */
type Step = { r: number; l: number; sum: number; len: number; best: number; shrunk: number };
function trace(a: number[], limit: number): Step[] {
  const out: Step[] = [];
  let sum = 0;
  let l = 0;
  let best = 0;
  for (let r = 0; r < a.length; r++) {
    sum += a[r];
    let shrunk = 0;
    while (sum > limit) {
      sum -= a[l++];
      shrunk++;
    }
    best = Math.max(best, r - l + 1);
    out.push({ r, l, sum, len: r - l + 1, best, shrunk });
  }
  return out;
}
const steps = trace(DEMO, S);
const answer = steps[steps.length - 1].best;
const totalShrinks = steps.reduce((s, x) => s + x.shrunk, 0);

/* ---------- ภาพสองแถว เลือกก้าวจากรอยเดินจริง ไม่ได้เลือกด้วยตา ----------
   แถวบนคือก้าวที่ได้หน้าต่างยาวที่สุด แถวล่างคือก้าวแรกที่ต้องหดตัวชี้ซ้าย
   ทั้งสองก้าวหาจาก steps ที่ trace() คืนมา ถ้าตัวอย่างเปลี่ยน ภาพก็เปลี่ยนตาม */
const winStep = steps.reduce((b, x) => (x.len > b.len ? x : b), steps[0]);
const shrinkStep = steps.find((x) => x.shrunk > 0) as Step;

const CW = 54;
const CGAP = 7;
const cellX = (i: number): number => 16 + i * (CW + CGAP);
const ROW1 = 52;
const ROW2 = 178;
const CH = 44;
const WIN_W = 16 + DEMO.length * (CW + CGAP) - CGAP + 16;
const winVB = `0 0 ${WIN_W - 4} 290`;
/** ปีกกาใต้หน้าต่าง บอกว่าช่วงไหนกำลังถูกนับอยู่ */
const brace = (l: number, r: number, y: number): string => {
  const x1 = cellX(l);
  const x2 = cellX(r) + CW;
  return `M${x1} ${y} L${x1} ${y + 7} L${x2} ${y + 7} L${x2} ${y}`;
};
const inWin = (i: number, st: Step): boolean => i >= st.l && i <= st.r;
/** ช่องที่ถูกทิ้งออกจากหน้าต่างในก้าวนี้ */
const dropped = (i: number, st: Step): boolean => i >= st.l - st.shrunk && i < st.l;

/** ต้นทุนของสองแนวคิด เมื่อ n เป็นล้าน */
const NBIG = 1000000;
const costRows = [
  { name: 'ไล่ทุกช่วง', per: 'ทุกคู่ของขอบซ้ายขวา', total: (NBIG * (NBIG + 1)) / 2 },
  { name: 'สองตัวชี้', per: 'ขอบซ้ายกับขอบขวาเดินหน้าอย่างละรอบ', total: 2 * NBIG },
];
const fmt = (n: number): string => n.toLocaleString('en-US');

const code1 = `// ช่วงติดกันที่ยาวที่สุดซึ่งผลรวมไม่เกิน S  (ทุกตัวเป็นจำนวนเต็มบวก)
#include <bits/stdc++.h>
using namespace std;
int main() {
    int n; long long S;
    scanf("%d %lld", &n, &S);
    vector<long long> a(n);
    for (auto& v : a) scanf("%lld", &v);
    long long sum = 0; int best = 0, l = 0;
    for (int r = 0; r < n; r++) {
        sum += a[r];
        while (sum > S) sum -= a[l++];       // ขอบซ้ายเดินหน้าอย่างเดียว ไม่มีวันถอย
        best = max(best, r - l + 1);
    }
    printf("%d\\n", best);
}`;
const code2 = `// ช่วงติดกันที่สั้นที่สุดซึ่งมีค่าครบทั้ง K ชนิด  (ค่าในอาเรย์อยู่ระหว่าง 1 ถึง K)
#include <bits/stdc++.h>
using namespace std;
int main() {
    int n, K;
    scanf("%d %d", &n, &K);
    vector<int> a(n);
    for (auto& v : a) scanf("%d", &v);
    vector<int> cnt(K + 1, 0);
    int have = 0, best = INT_MAX, l = 0;
    for (int r = 0; r < n; r++) {
        if (cnt[a[r]]++ == 0) have++;        // ชนิดนี้เพิ่งโผล่ครั้งแรกในหน้าต่าง
        while (have == K) {                  // ครบแล้ว หดขอบซ้ายให้สั้นที่สุดเท่าที่ยังครบ
            best = min(best, r - l + 1);
            if (--cnt[a[l++]] == 0) have--;
        }
    }
    printf("%d\\n", best == INT_MAX ? -1 : best);
}`;
/* ---------- มินิเกม ลากหน้าต่างหาช่วงที่ยาวที่สุด ----------
   คำตอบของทุกชุดหาโดยไล่ทุกช่วงตรง ๆ ตอนบิลด์ ไม่ได้ใช้ท่าหน้าต่างเลื่อน
   เกมจึงไม่ได้ตัดสินด้วยท่าเดียวกับที่บทนี้กำลังจะสอน */
type SwPuzzle = { id: string; label: string; tease: string; arr: number[]; cap: number };

/** ช่วงที่ยาวที่สุดที่ผลรวมไม่เกิน cap ไล่ทุกช่วง */
function longestByBrute(a: number[], cap: number): number {
  let best = 0;
  for (let i = 0; i < a.length; i++) {
    let s = 0;
    for (let j = i; j < a.length; j++) {
      s += a[j];
      if (s <= cap) best = Math.max(best, j - i + 1);
    }
  }
  return best;
}

const SW_PUZZLES: SwPuzzle[] = [
  { id: 's1', label: 'ชุดที่ 1 · อุ่นเครื่อง', tease: 'อาเรย์สั้น ๆ ลองลากหน้าต่างดูก่อน', arr: [2, 1, 5, 1, 3, 2], cap: 8 },
  { id: 's2', label: 'ชุดที่ 2 · ยาวขึ้น', tease: 'ชุดนี้ยาวขึ้น ลองสังเกตว่าขอบซ้ายเคยต้องถอยกลับไหม', arr: [4, 2, 1, 7, 1, 1, 2, 3, 1, 5], cap: 9 },
  { id: 's3', label: 'ชุดที่ 3 · ตัวใหญ่เกิน', tease: 'ชุดนี้มีตัวที่ใหญ่เกินเพดานอยู่ ลองดูว่าหน้าต่างทำยังไงตอนเจอมัน', arr: [1, 2, 20, 3, 1, 2], cap: 7 },
];

type SwPuzzleData = {
  id: string;
  label: string;
  tease: string;
  arr: number[];
  cap: number;
  best: number;
};
const swPuzzles: SwPuzzleData[] = SW_PUZZLES.map((p) => ({
  id: p.id,
  label: p.label,
  tease: p.tease,
  arr: p.arr,
  cap: p.cap,
  best: longestByBrute(p.arr, p.cap),
}));
const swJson = JSON.stringify(swPuzzles);

---
<CpProblemLayout href={href}>
  <h2>ปัญหาที่บทนี้แก้</h2>
  <p>
    โจทย์จำนวนมากถามถึง<strong>ช่วงติดกัน</strong>ของอาเรย์หรือสตริง เช่น ช่วงที่ยาวที่สุดที่ผลรวมไม่เกินเท่านี้
    ช่วงที่สั้นที่สุดที่มีของครบทุกชนิด หรือช่วงยาวคงที่ที่มีของตรงตามที่กำหนด
  </p>
  <p>
    ท่าแรกที่ทุกคนคิดออกคือไล่ทุกคู่ของขอบซ้ายขอบขวา ซึ่งเป็น <code>n²</code> ช่วง แค่ <code>n</code> เป็นหมื่นก็เริ่มไม่ไหว
    ส่วนบทนี้จะให้ท่าที่เดินขอบซ้ายกับขอบขวาไป<strong>ข้างหน้าอย่างเดียว คนละรอบ</strong>
    ซึ่งได้คำตอบเดียวกันในเวลาเชิงเส้น
  </p>

  <figure class="tbl">
    <table class="rec">
      <caption>อาเรย์ยาว {fmt(NBIG)} · นับเป็นจำนวนครั้งที่แตะข้อมูล</caption>
      <thead>
        <tr><th>แนวคิด</th><th>แตะอะไรบ้าง</th><th class="num">รวม</th></tr>
      </thead>
      <tbody>
        {costRows.map((r) => (
          <tr><td>{r.name}</td><td>{r.per}</td><td class="num">{fmt(r.total)}</td></tr>
        ))}
      </tbody>
    </table>
    <figcaption>
      ต่างกันประมาณ {fmt(Math.round(costRows[0].total / costRows[1].total))} เท่า และที่สำคัญกว่านั้นคือ
      แนวคิดที่สองไม่ได้แค่เร็วกว่า มันเขียนสั้นกว่าด้วย
    </figcaption>
  </figure>

  <h2>กติกาข้อเดียวที่ทำให้ท่านี้ใช้ได้</h2>
  <p>
    หน้าต่างเลื่อนใช้ได้เมื่อ<strong>การขยายขอบขวาทำให้เงื่อนไขแย่ลงเสมอ และการหดขอบซ้ายทำให้ดีขึ้นเสมอ</strong>
    เรียกคุณสมบัตินี้ว่าความ<strong>เอกโทน</strong> (monotone)
  </p>
  <div class="callout callout-note">
    <p class="callout-label">แกะคำศัพท์</p>
    <p>
      <i>monotone</i> อ่านว่า <strong>"โมโนโทน"</strong> แปลว่า<strong>ไปทางเดียว</strong>
      มาจากคำกรีก <i>monos</i> ที่แปลว่าหนึ่งเดียว กับ <i>tonos</i> ที่แปลว่าเสียงหรือระดับ
      รวมกันแล้วหมายถึงของที่ไม่เคยเปลี่ยนทิศ มีแต่เพิ่มขึ้นตลอดหรือลดลงตลอด
      คำเดียวกันนี้ในภาษาพูดแปลว่าพูดเสียงเดียวราบเรียบ ก็มาจากรากเดียวกัน
    </p>
  </div>
  <p>
    ตัวอย่างที่ใช้ได้ ผลรวมของจำนวนเต็ม<strong>บวก</strong> ยิ่งขยายยิ่งมาก จำนวนชนิดที่ต่างกันในช่วง
    ยิ่งขยายยิ่งไม่ลด ส่วนตัวอย่างที่<strong>ใช้ไม่ได้</strong>คือผลรวมของอาเรย์ที่มีเลขติดลบปนอยู่
    เพราะขยายแล้วผลรวมอาจน้อยลง ขอบซ้ายที่เคยต้องเลื่อนอาจต้องถอยกลับ ซึ่งทำลายเหตุผลทั้งหมด
  </p>
  <div class="callout callout-warn">
    <p class="callout-label">ระวัง</p>
    <p>
      ก่อนเขียนสองตัวชี้ ให้ถามตัวเองหนึ่งคำถามเสมอ <strong>ถ้าขอบขวาขยับไปหนึ่งช่อง ขอบซ้ายมีทางถอยกลับได้ไหม</strong>
      ถ้าตอบว่าได้ ท่านี้ผิดตั้งแต่แรก และมันจะผิดแบบเงียบ ๆ คือตอบตัวอย่างในโจทย์ถูกแต่ตกในเทสจริง
    </p>
  </div>

  <h2>รูปมาตรฐาน</h2>
  <p>โครงของหน้าต่างเลื่อนมีแค่สองแบบ และแทบทุกโจทย์เข้าแบบใดแบบหนึ่ง</p>
  <ul>
    <li>
      <strong>ยาวที่สุดที่ยัง "ผ่าน"</strong> ขยายขวาไปเรื่อย ๆ เมื่อไรที่หลุดเงื่อนไข ก็หดซ้ายจนกลับมาผ่าน
      แล้วบันทึกความยาว
    </li>
    <li>
      <strong>สั้นที่สุดที่ "ผ่าน" แล้ว</strong> ขยายขวาไปเรื่อย ๆ เมื่อไรที่ผ่านเงื่อนไข ก็หดซ้ายเท่าที่ยังผ่านอยู่
      แล้วบันทึกความยาวระหว่างหด
    </li>
  </ul>
  <p>
    ทั้งสองแบบมีจุดร่วมเดียวกันคือ <code>l</code> กับ <code>r</code> ไม่เคยถอยหลัง แต่ละตัวจึงเดินได้มากที่สุด
    <code>n</code> ก้าว รวมเป็น <code>2n</code> ก้าวตลอดโปรแกรม ไม่ว่าลูปข้างในจะดูน่ากลัวแค่ไหน
  </p>

  <ZoomableDiagram caption={`ตัวอย่าง ${DEMO.join(', ')} กับเพดานผลรวม ${S} แถวบนคือก้าวที่หน้าต่างยาวที่สุด คือช่อง ${winStep.l} ถึง ${winStep.r} ผลรวม ${winStep.sum} ยาว ${winStep.len} ช่อง แถวล่างคือก้าวแรกที่ผลรวมล้นเพดาน ตัวชี้ขวาขยับมาถึงช่อง ${shrinkStep.r} แล้วผลรวมเกิน จึงต้องทิ้งช่องทางซ้ายออก ${shrinkStep.shrunk} ช่อง จนผลรวมเหลือ ${shrinkStep.sum} สังเกตว่าตัวชี้ซ้ายเดินไปทางขวาเท่านั้น ไม่เคยถอยกลับ ทั้งการเดินจึงเสียแรงรวมกันไม่เกินสองรอบอาเรย์ (วาดประกอบโดยผู้เขียน)`}>
    <svg viewBox={winVB} xmlns="http://www.w3.org/2000/svg" role="img" aria-label={`สองแถว แถวบนแสดงอาเรย์แปดช่องคือ ${DEMO.join(' ')} โดยช่องที่ ${winStep.l} ถึง ${winStep.r} ถูกเน้นเป็นหน้าต่างที่ยาวที่สุด ผลรวม ${winStep.sum} แถวล่างแสดงอาเรย์เดียวกันในก้าวที่ตัวชี้ขวาอยู่ช่องที่ ${shrinkStep.r} ซึ่งทำให้ผลรวมล้นเพดาน ${S} จึงมีช่องทางซ้าย ${shrinkStep.shrunk} ช่องถูกทิ้งออกจากหน้าต่าง`}>
      <text x={cellX(0)} y="22" fill="#4ade80" font-size="12.5" text-anchor="start" font-weight="700">
        ก้าวที่ชนะ · ยาว {winStep.len} ช่อง ผลรวม {winStep.sum}
      </text>
      {DEMO.map((v, i) => (
        <>
          <rect
            x={cellX(i)}
            y={ROW1}
            width={CW}
            height={CH}
            rx="7"
            fill={inWin(i, winStep) ? '#12291c' : '#141b2b'}
            stroke={inWin(i, winStep) ? '#4ade80' : '#2a3350'}
            stroke-width={inWin(i, winStep) ? '2' : '1.4'}
          />
          <text x={cellX(i) + CW / 2} y={ROW1 + 28} fill={inWin(i, winStep) ? '#d7ffe4' : '#7b8397'} font-size="16" text-anchor="middle" font-weight="700" font-family="monospace">
            {v}
          </text>
          <text x={cellX(i) + CW / 2} y={ROW1 - 9} fill="#7b8397" font-size="10.5" text-anchor="middle" font-family="monospace">
            {i}
          </text>
        </>
      ))}
      <path d={brace(winStep.l, winStep.r, ROW1 + CH)} fill="none" stroke="#4ade80" stroke-width="1.8" />
      <text x={(cellX(winStep.l) + cellX(winStep.r) + CW) / 2} y={ROW1 + CH + 26} fill="#4ade80" font-size="12" text-anchor="middle" font-family="monospace">
        l={winStep.l} r={winStep.r}
      </text>

      <text x={cellX(0)} y={ROW2 - 18} fill="#e0b400" font-size="12.5" text-anchor="start" font-weight="700">
        ก้าวที่ล้นเพดาน · ทิ้งซ้ายออก {shrinkStep.shrunk} ช่อง เหลือผลรวม {shrinkStep.sum}
      </text>
      {DEMO.map((v, i) => (
        <>
          <rect
            x={cellX(i)}
            y={ROW2}
            width={CW}
            height={CH}
            rx="7"
            fill={dropped(i, shrinkStep) ? '#3d1f22' : inWin(i, shrinkStep) ? '#2e2510' : '#141b2b'}
            stroke={dropped(i, shrinkStep) ? '#e06c75' : inWin(i, shrinkStep) ? '#e0b400' : '#2a3350'}
            stroke-width={dropped(i, shrinkStep) || inWin(i, shrinkStep) ? '2' : '1.4'}
            stroke-dasharray={dropped(i, shrinkStep) ? '5 4' : undefined}
          />
          <text
            x={cellX(i) + CW / 2}
            y={ROW2 + 28}
            fill={dropped(i, shrinkStep) ? '#ffb3b8' : inWin(i, shrinkStep) ? '#ffe58a' : '#7b8397'}
            font-size="16"
            text-anchor="middle"
            font-weight="700"
            font-family="monospace"
          >
            {v}
          </text>
        </>
      ))}
      <path d={brace(shrinkStep.l, shrinkStep.r, ROW2 + CH)} fill="none" stroke="#e0b400" stroke-width="1.8" />
      <text x={(cellX(shrinkStep.l) + cellX(shrinkStep.r) + CW) / 2} y={ROW2 + CH + 26} fill="#e0b400" font-size="12" text-anchor="middle" font-family="monospace">
        l={shrinkStep.l} r={shrinkStep.r}
      </text>
      <text x={cellX(0)} y={ROW2 + CH + 26} fill="#e06c75" font-size="11.5" text-anchor="start">
        ช่องเส้นประคือช่องที่หลุดออกไป
      </text>
    </svg>
  </ZoomableDiagram>

  <h2>ลองเอง · ลากหน้าต่างหาช่วงที่ยาวที่สุด</h2>
  <div class="cpgame swgame" data-swgame data-puzzles={swJson}>
    <div class="cpg-tabs" role="tablist" aria-label="เลือกชุดโจทย์">
      {swPuzzles.map((p, k) => (
        <button type="button" class="cpg-tab" role="tab" data-cpg-tab={String(k)} aria-selected={k === 0 ? 'true' : 'false'}>
          {p.label}
        </button>
      ))}
    </div>

    <p class="cpg-tease" data-cpg-tease>{swPuzzles[0].tease}</p>
    <p class="fg-sub">หาช่วงติดกันที่ยาวที่สุด โดยผลรวมต้องไม่เกิน <b data-sw-cap>{swPuzzles[0].cap}</b></p>

    <div class="cpg-scroll"><div class="sw-strip" data-sw-strip></div></div>

    <div class="cpg-controls">
      <button type="button" class="cpg-btn" data-sw-lplus>ขอบซ้ายไปขวา</button>
      <button type="button" class="cpg-btn" data-sw-lminus>ขอบซ้ายถอยกลับ</button>
      <button type="button" class="cpg-btn" data-sw-rminus>ขอบขวาถอยกลับ</button>
      <button type="button" class="cpg-btn" data-sw-rplus>ขอบขวาไปขวา</button>
    </div>

    <div class="cpg-controls">
      <button type="button" class="cpg-btn" data-sw-reset>เริ่มใหม่</button>
      <button type="button" class="cpg-btn main" data-sw-check>ตรวจว่ายาวที่สุดหรือยัง</button>
    </div>

    <p class="cpg-status" data-cpg-status>ขยับขอบขวาเพื่อรับของเพิ่ม ขยับขอบซ้ายเพื่อทิ้งของออก</p>
    <p class="cpg-score" data-cpg-score>ผลรวมตอนนี้ <b data-sw-sum>0</b> · ยาว <b data-sw-len>0</b> ช่อง · ยาวที่สุดที่เจอ <b data-sw-best>0</b> · ถอยขอบซ้ายไปแล้ว <b data-sw-back>0</b> ครั้ง</p>
    <p class="cpg-hint">ตัวนับ "ถอยขอบซ้าย" มีไว้ให้สังเกตตัวเอง ไม่ได้มีไว้ทำโทษ</p>
  </div>
  <p class="io-note">
    ถ้าเล่นจนจบได้โดยตัวนับถอยยังเป็นศูนย์ แปลว่าคุณเพิ่งค้นพบเงื่อนไขที่ทำให้ท่านี้เร็วด้วยตัวเอง
  </p>

  <h2>โจทย์ฝึกข้อที่ 1 · ช่วงที่ยาวที่สุดที่ผลรวมไม่เกิน S</h2>
  <p>
    ให้อาเรย์ของจำนวนเต็ม<strong>บวก</strong>ยาว <code>n</code> กับเลข <code>S</code>
    หาความยาวของช่วงติดกันที่ยาวที่สุดซึ่งผลรวมไม่เกิน <code>S</code>
  </p>
  <div class="callout callout-note spec">
    <p class="callout-label">อินพุต / ขอบเขต / เอาต์พุต</p>
    <ul>
      <li><strong>อินพุต:</strong> บรรทัดแรกคือ <code>n</code> และ <code>S</code> บรรทัดที่สองคือสมาชิก <code>n</code> ตัว</li>
      <li><strong>ขอบเขต:</strong> <code>n ≤ {fmt(NBIG)}</code> สมาชิกทุกตัวเป็นจำนวนเต็มบวก</li>
      <li><strong>เอาต์พุต:</strong> ความยาวของช่วงที่ยาวที่สุด (ถ้าไม่มีเลยให้ตอบ 0)</li>
    </ul>
  </div>
  <table class="io">
    <caption>EXAMPLE</caption>
    <thead><tr><th>Input</th><th>Output</th></tr></thead>
    <tbody><tr><td>{DEMO.length} {S}<br />{DEMO.join(' ')}</td><td>{answer}</td></tr></tbody>
  </table>
  <div class="callout callout-tip">
    <p class="callout-label">ใบ้</p>
    <p>
      สมมติเรารู้แล้วว่าขอบขวาอยู่ที่ <code>r</code> และขอบซ้ายที่เล็กที่สุดที่ยังผ่านคือ <code>l</code>
      พอขอบขวาขยับไปเป็น <code>r + 1</code> ผลรวมมีแต่เพิ่ม แล้วขอบซ้ายที่ถูกต้องของรอบใหม่
      จะอยู่ทางซ้ายของ <code>l</code> ได้ไหม
    </p>
  </div>

  <h2>เฉลยข้อที่ 1</h2>
  <Spoiler>
    <div class="callout callout-note">
      <p class="callout-label">ที่มาของท่านี้</p>
      <p>
        ก่อนจะเขียนหน้าต่างเลื่อน มีคำถามเดียวที่ต้องตอบให้ได้ก่อนเสมอ คือ
        <strong>ถ้าขอบขวาขยับไปหนึ่งช่อง ขอบซ้ายมีทางถอยกลับได้ไหม</strong>
        ถ้าตอบว่าไม่มีทางถอย ท่านี้ใช้ได้ และราคาเหลือเชิงเส้นเพราะขอบซ้ายเดินไปข้างหน้ารวมกันไม่เกิน N ก้าวตลอดทั้งโปรแกรม
      </p>
      <p>
        ข้อนี้ตอบว่าไม่มีทางถอย เพราะเลขทุกตัวไม่ติดลบ ผลรวมของช่วงจึงโตขึ้นเสมอเมื่อขยายขอบขวา
        ขอบซ้ายที่เคยต้องขยับมาแล้ว ไม่มีทางกลับไปยืนที่เดิมได้อีก
      </p>
      <p>
        และนี่คือจุดที่ท่านี้พังแบบเงียบที่สุด <strong>ถ้าอาเรย์มีเลขติดลบได้เมื่อไร คำตอบของคำถามข้างบนกลายเป็น "ถอยได้" ทันที</strong>
        โปรแกรมจะยังคอมไพล์ผ่าน ยังรันเร็ว ยังตอบตัวอย่างเล็ก ๆ ถูก แต่มันผิด
        เพราะช่วงที่ยาวกว่าอาจมีผลรวมน้อยกว่าได้
      </p>
      <p>
        บทเรียนที่ยกไปข้ออื่นได้คือ หน้าต่างเลื่อนไม่ใช่รูปแบบโค้ดที่จำแล้วแปะได้ มันคือ<strong>ข้อสรุปของคำถามข้างบน</strong>
        ถามก่อนทุกครั้ง แล้วค่อยเขียน
      </p>
    </div>
    <p>
      ตอบไม่ได้ครับ เพราะถ้า <code>[l, r]</code> ผลรวมเกินไปแล้ว การเพิ่ม <code>a[r+1]</code> ซึ่งเป็นบวก
      ยิ่งทำให้เกินหนัก ขอบซ้ายของรอบใหม่จึงอยู่ที่ <code>l</code> หรือขวากว่าเสมอ นั่นแปลว่า
      <strong>ไม่ต้องรีเซ็ต <code>l</code> กลับไปที่ศูนย์ทุกรอบ</strong>
    </p>
    <CodeBlock code={code1} lang="cpp" title="sliding_sum.cpp" />
    <figure class="tbl">
      <table class="rec">
        <caption>ไล่ทุกก้าวบนตัวอย่าง (S = {S})</caption>
        <thead>
          <tr>
            <th class="num">ขอบขวา</th><th class="num">ค่าที่เข้ามา</th><th class="num">หดซ้ายกี่ครั้ง</th>
            <th class="num">ขอบซ้าย</th><th class="num">ผลรวม</th><th class="num">ยาว</th><th class="num">ดีที่สุด</th>
          </tr>
        </thead>
        <tbody>
          {steps.map((s) => (
            <tr>
              <td class="num">{s.r}</td>
              <td class="num">{DEMO[s.r]}</td>
              <td class="num">{s.shrunk}</td>
              <td class="num">{s.l}</td>
              <td class="num">{s.sum}</td>
              <td class="num">{s.len}</td>
