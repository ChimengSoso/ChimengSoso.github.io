<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import { initCpRowPlayers } from '../../lib/cpPlayer';
  import type { CpGameUi } from '../../lib/cpGame';

  type DlRoad = { u: number; v: number; w: number };
  type DlFest = { t: number; x: number; y: number };
  type DlPuzzle = {
    id: string;
    label: string;
    tease: string;
    n: number;
    C: number[];
    roads: DlRoad[];
    fest: DlFest[];
    T: number;
    answer: number;
  };

  function initDelicacyGame(): void {
    const maybeUi = cpGameUi('[data-dlcgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as DlPuzzle[];
    const maybeDay = ui.root.querySelector<HTMLElement>('[data-dlc-day]');
    const maybeRoute = ui.root.querySelector<HTMLElement>('[data-dlc-route]');
    if (puzzles.length === 0 || !maybeDay || !maybeRoute) return;
    const dayEl: HTMLElement = maybeDay;
    const routeEl: HTMLElement = maybeRoute;

    let pi = 0;
    let steps: number[] = [];
    const pz = (): DlPuzzle => puzzles[pi];

    function bonusAt(p: DlPuzzle, day: number, city: number): number {
      let s = 0;
      for (const f of p.fest) if (f.t === day && f.x === city) s += f.y;
      return s;
    }

    /* เดินซ้ำจากศูนย์ทุกครั้ง ทำให้ปุ่มถอยหนึ่งก้าวเหลือแค่ตัดสมาชิกท้ายทิ้ง */
    function replay(): { day: number; city: number; sum: number; cities: number[] } {
      const p = pz();
      let day = 0;
      let city = 1;
      let sum = p.C[1] + bonusAt(p, 0, 1);
      const cities = [1];
      for (const ri of steps) {
        const r = p.roads[ri];
        day += r.w;
        city = r.v;
        sum += p.C[city] + bonusAt(p, day, city);
        cities.push(city);
      }
      return { day, city, sum, cities };
    }

    function render(): void {
      const p = pz();
      const st = replay();
      ui.root.querySelectorAll<HTMLElement>('[data-dlc-board]').forEach((b) => {
        b.hidden = Number(b.dataset.dlcBoard) !== pi;
      });
      ui.root.querySelectorAll<HTMLElement>('[data-dlc-roads]').forEach((b) => {
        b.hidden = Number(b.dataset.dlcRoads) !== pi;
      });
      const board = ui.root.querySelector<HTMLElement>(`[data-dlc-board="${pi}"]`);
      board?.querySelectorAll<HTMLElement>('[data-dlc-city]').forEach((g) => {
        g.classList.toggle('is-here', Number(g.dataset.dlcCity) === st.city);
      });
      const done = st.day === p.T;
      ui.root.querySelectorAll<HTMLElement>(`[data-dlc-roads="${pi}"] [data-dlc-road]`).forEach((b) => {
        b.hidden = done || Number(b.dataset.dlcSrc) !== st.city;
      });
      dayEl.textContent = done
        ? `วันที่ ${p.T} จาก ${p.T} ยืนอยู่เมือง ${st.city}`
        : `วันที่ ${st.day} จาก ${p.T} ยืนอยู่เมือง ${st.city} เหลืออีก ${p.T - st.day} วัน`;
      routeEl.textContent = `เส้นทาง ${st.cities.join(' → ')}`;
      ui.setScore(`เก็บได้ ${st.sum} หน่วย`);
    }

    function finish(): void {
      const p = pz();
      const st = replay();
      if (st.city !== 1) {
        ui.setStatus(
          `ครบ ${p.T} วันแล้วแต่คุณยืนอยู่เมือง ${st.city} ทริปนี้ไม่นับ ถึงจะเก็บมาได้ ${st.sum} หน่วยก็ตาม`,
          'bad',
        );
        return;
      }
      if (st.sum === p.answer) {
        ui.setStatus(`กลับถึงบ้านพอดีวัน ได้ ${st.sum} หน่วย ซึ่งเป็นค่ามากที่สุดของชุดนี้`, 'good');
        return;
      }
      ui.setStatus(`กลับถึงบ้านพอดีวัน ได้ ${st.sum} หน่วย แต่ยังมีเส้นทางที่ได้ถึง ${p.answer} ลองอีกรอบ`, 'bad');
    }

    function take(ri: number): void {
      const p = pz();
      const st = replay();
      const r = p.roads[ri];
      if (st.day === p.T) return;
      if (r.u !== st.city) return;
      if (st.day + r.w > p.T) {
        ui.setStatus(`ถนนเส้นนี้ใช้ ${r.w} วัน แต่เหลืออีกแค่ ${p.T - st.day} วัน ไปแล้วจะเลยวันที่ ${p.T}`, 'bad');
        return;
      }
      steps.push(ri);
      const now = replay();
      render();
      if (now.day === p.T) {
        finish();
        return;
      }
      const out = p.roads.filter((e) => e.u === now.city && now.day + e.w <= p.T);
      if (out.length === 0) {
        ui.setStatus(
          `ถึงเมือง ${now.city} วันที่ ${now.day} แล้วไปต่อไม่ได้เลย ถนนทุกเส้นจากที่นี่ยาวเกินวันที่เหลือ`,
          'bad',
        );
        return;
      }
      const gain = p.C[now.city] + bonusAt(p, now.day, now.city);
      ui.setStatus(`ถึงเมือง ${now.city} วันที่ ${now.day} ได้เพิ่ม ${gain} หน่วย`, 'good');
    }

    function undo(): void {
      if (steps.length === 0) {
        ui.setStatus('ยังไม่ได้ออกเดินทางเลย ถอยไม่ได้', 'bad');
        return;
      }
      steps.pop();
      render();
      ui.setStatus('ถอยกลับมาหนึ่งก้าวแล้ว');
    }

    function claimNone(): void {
      const p = pz();
      if (p.answer === -1) {
        ui.setStatus(
          `ถูกครับ ชุดนี้ตอบ -1 ทุกวงรอบที่ผ่านเมือง 1 ยาวเป็นเลขคู่ ส่วน T เท่ากับ ${p.T} ซึ่งเป็นเลขคี่`,
          'good',
        );
        return;
      }
      ui.setStatus(`ชุดนี้มีทางกลับถึงบ้านพอดีวันนะครับ และทางที่ดีที่สุดได้ ${p.answer} หน่วย`, 'bad');
    }

    function selectPuzzle(k: number): void {
      pi = k;
      steps = [];
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ui.setStatus('กดถนนที่อยากไป วงกลมสีทองคือเมือง 1 ซึ่งเป็นทั้งจุดเริ่มและจุดจบ');
      render();
    }

    ui.root.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest('[data-dlc-road]');
      if (!(btn instanceof HTMLElement)) return;
      take(Number(btn.dataset.dlcRoad));
    });
    ui.onClick('data-dlc-undo', undo);
    ui.onClick('data-dlc-reset', () => selectPuzzle(pi));
    ui.onClick('data-dlc-none', claimNone);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', () => {
    initDelicacyGame();
    initCpRowPlayers('[data-dlcvec]');
  });
</script>
