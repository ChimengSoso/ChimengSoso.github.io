          {SAMPLE1.C.slice(1).join(' ')}<br />
          {SAMPLE1.roads.map((r) => <>{[r.u, r.v, r.w].join(' ')}<br /></>)}
        </td>
        <td>{S1_BEST.best}</td>
      </tr>
      <tr>
        <td>
          {SAMPLE2.n} {SAMPLE2.roads.length} {SAMPLE2.T} {SAMPLE2.fest.length}<br />
          {SAMPLE2.C.slice(1).join(' ')}<br />
          {SAMPLE2.roads.map((r) => <>{[r.u, r.v, r.w].join(' ')}<br /></>)}
          {SAMPLE2.fest.map((f) => <>{[f.t, f.x, f.y].join(' ')}<br /></>)}
        </td>
        <td>{S2_BEST.best}</td>
      </tr>
    </tbody>
  </table>

  <ZoomableDiagram caption={`อาณาจักรของตัวอย่างแรก ตัวเลขขาวในวงคือหมายเลขเมือง ตัวเลขทองคือความพึงพอใจของเมืองนั้น ลูกศรคือถนนทางเดียวพร้อมจำนวนวันที่ใช้ ทางขวาคือบัญชีของแผน ${S1_PLAN} ทีละครั้งที่เหยียบเมือง จนได้ ${S1_LAST.run} หน่วยในวันที่ ${SAMPLE1.T}`}>
    <svg viewBox={`0 0 ${D1_VB_W} ${D1_H}`} xmlns="http://www.w3.org/2000/svg" width="100%" style={`display:block;margin:0 auto;max-width:${Math.round(D1_VB_W * 1.25)}px`} role="img" aria-label="แผนที่สามเมืองของตัวอย่างแรก พร้อมบัญชีความพึงพอใจหกบรรทัดตามแผนเดินทางที่โจทย์ยกมา">
