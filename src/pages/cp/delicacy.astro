      </g>
      <text x={D1_COL.day} y="34" fill="#9aa7bd" font-size="12">วันที่</text>
      <text x={D1_COL.city} y="34" fill="#9aa7bd" font-size="12">อยู่เมือง</text>
      <text x={D1_COL.gain} y="34" fill="#9aa7bd" font-size="12">ได้เพิ่ม</text>
      <text x={D1_COL.run} y="34" fill="#9aa7bd" font-size="12">รวม</text>
      <line x1={D1_COL.day} y1="42" x2={D1_COL.run + 34} y2="42" stroke="#1e2a40" stroke-width="1" />
      {S1_STOPS.map((s, i) => (
        <g>
          <text x={D1_COL.day} y={D1_ROW_Y[i]} fill="#cdd6ea" font-size="13" font-family="monospace">{s.day}</text>
          <text x={D1_COL.city} y={D1_ROW_Y[i]} fill="#cdd6ea" font-size="13">เมือง {s.city}</text>
          <text x={D1_COL.gain} y={D1_ROW_Y[i]} fill="#e7b455" font-size="13" font-family="monospace">+{s.gain}</text>
          <text x={D1_COL.run} y={D1_ROW_Y[i]} fill="#a7f3c4" font-size="13" font-family="monospace">{s.run}</text>
        </g>
      ))}
    </svg>
  </ZoomableDiagram>

  <div class="callout callout-tip">
    <p class="callout-label">ใบ้</p>
    <p>
      ถ้า <code>T</code> เล็ก ข้อนี้คือตารางธรรมดา ช่องหนึ่งช่องคือ &ldquo;วันที่ <code>d</code> ยืนอยู่เมือง <code>v</code>
      แล้วได้มากที่สุดเท่าไร&rdquo; ไล่จากวันที่ 0 ไปข้างหน้าจนถึงวันที่ <code>T</code> แล้วอ่านคำตอบที่ช่องของเมือง 1
      ปัญหาคือ <code>T</code> ใหญ่ได้ถึง {fmt(T_MAX)} ตารางนั้นจึงมีแถวเป็นพันล้านแถว
    </p>
    <p>
      ทีนี้ลองสังเกตขอบเขตสองตัวที่ดูเล็กจนน่าสงสัย คือเมืองไม่เกิน {N_MAX} เมือง และถนนยาวไม่เกิน {W_MAX} วัน
      สองตัวนี้เล็กจนแทบไม่มีเหตุผลอื่นนอกจากผู้ออกโจทย์อยากให้เราเอาไปใช้ ถ้าถนนทุกเส้นยาว 1 วันเท่ากันหมด
      หนึ่งวันจะเป็นการก้าวแบบเดียวกันเสมอ และของที่ซ้ำเหมือนกันทุกครั้งมักกระโดดข้ามทีละเยอะได้
      แล้วถนนที่ยาวไม่เท่ากันล่ะ จะทำให้มันยาวเท่ากันได้ไหม
    </p>
  </div>

  <h2>ลองเอง &middot; พาเขาเที่ยวเองสี่อาณาจักร</h2>
  <div class="cpgame dlcgame" data-dlcgame data-puzzles={puzzlesJson}>
    <div class="cpg-tabs" role="tablist" aria-label="เลือกอาณาจักร">
      {puzzles.map((p, k) => (
        <button type="button" class="cpg-tab" role="tab" data-cpg-tab={String(k)} aria-selected={k === 0 ? 'true' : 'false'}>
          {p.label}
        </button>
      ))}
    </div>

