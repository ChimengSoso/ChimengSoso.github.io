---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

const href = 'delicacy/';

/* ---------- โมเดลของโจทย์ ตัวเลขทุกตัวในหน้านี้งอกจากตรงนี้ ---------- */

type Road = { u: number; v: number; w: number };
type Fest = { t: number; x: number; y: number };
/** อาณาจักรหนึ่งชุด เมืองนับ 1..n ส่วน C[0] ไม่ได้ใช้ ให้ดัชนีตรงกับเลขเมือง */
type Kingdom = { n: number; C: number[]; roads: Road[]; fest: Fest[]; T: number };
/** หนึ่งครั้งที่เขาเหยียบเมือง gain คือความพึงพอใจของเมือง bonus คือของเทศกาล */
type Stop = { day: number; city: number; gain: number; bonus: number; run: number };

const road = (u: number, v: number, w: number): Road => ({ u, v, w });
const fmt = (v: number): string => v.toLocaleString('en-US');

function festBonus(k: Kingdom, day: number, city: number): number {
  let s = 0;
  for (const f of k.fest) if (f.t === day && f.x === city) s += f.y;
  return s;
}

/** ตัวตรวจของหน้านี้ ไล่ทุกเส้นทางที่เดินได้จริงจากเมือง 1 วันที่ 0
 *  ไม่มีตารางเก็บค่า ไม่มีการหั่นเมือง ไม่มีเมทริกซ์ คือไม่ใช้อะไรที่หน้านี้กำลังจะสอนเลย
 *  คืน -1 เมื่อไม่มีเส้นทางไหนกลับถึงเมือง 1 ในวันที่ T พอดี */
function walkBest(k: Kingdom): { best: number; path: number[] } {
  let best = -1;
  let bestPath: number[] = [];
  const cur: number[] = [];
  const rec = (day: number, city: number, sum: number): void => {
    if (day === k.T) {
      if (city === 1 && sum > best) {
        best = sum;
        bestPath = [...cur];
      }
      return;
    }
    k.roads.forEach((r, i) => {
      if (r.u !== city) return;
      const nd = day + r.w;
      if (nd > k.T) return;
      cur.push(i);
      rec(nd, r.v, sum + k.C[r.v] + festBonus(k, nd, r.v));
      cur.pop();
    });
  };
  rec(0, 1, k.C[1] + festBonus(k, 0, 1));
  return { best, path: bestPath };
}

/** กางเส้นทาง (ลิสต์ดัชนีถนน) ออกเป็นรายการการเหยียบเมืองพร้อมยอดสะสม */
function walkStops(k: Kingdom, path: number[]): Stop[] {
  const b0 = festBonus(k, 0, 1);
  let run = k.C[1] + b0;
  const stops: Stop[] = [{ day: 0, city: 1, gain: k.C[1], bonus: b0, run }];
  let day = 0;
  for (const i of path) {
    const r = k.roads[i];
    day += r.w;
    const city = r.v;
    const b = festBonus(k, day, city);
    run += k.C[city] + b;
    stops.push({ day, city, gain: k.C[city], bonus: b, run });
  }
  return stops;
}

/** ท่าตะกละ: เลือกถนนที่ให้ความพึงพอใจต่อวันมากที่สุด เสมอกันเอาเส้นที่สั้นกว่า
 *  ไม่คิดเรื่องวันกลับบ้านเลย มีไว้เพื่อพิสูจน์ว่าชุดกับดักลงโทษท่านี้จริง */
function greedyRun(k: Kingdom): { day: number; city: number; sum: number } {
  let day = 0;
  let city = 1;
  let sum = k.C[1] + festBonus(k, 0, 1);
  for (;;) {
    if (day === k.T) break;
    const cand = k.roads.filter((r) => r.u === city && day + r.w <= k.T);
    if (cand.length === 0) break;
    cand.sort((a, b) => k.C[b.v] / b.w - k.C[a.v] / a.w || a.w - b.w);
    const r = cand[0];
    day += r.w;
    city = r.v;
    sum += k.C[city] + festBonus(k, day, city);
  }
  return { day, city, sum };
}

/* ---------- ตัวอย่างสองชุดในโจทย์ ---------- */

const SAMPLE1: Kingdom = {
  n: 3,
  C: [0, 1, 3, 4],
  roads: [road(1, 2, 1), road(2, 1, 3), road(2, 3, 2), road(3, 1, 4)],
  fest: [],
  T: 11,
};
const SAMPLE2: Kingdom = {
  n: 4,
  C: [0, 3, 1, 2, 4],
  roads: [
    road(1, 2, 1),
    road(1, 3, 1),
    road(1, 3, 2),
    road(3, 4, 3),
    road(2, 3, 2),
    road(3, 2, 1),
    road(4, 2, 1),
    road(4, 1, 5),
  ],
  fest: [
    { t: 3, x: 3, y: 5 },
    { t: 1, x: 2, y: 5 },
    { t: 5, x: 4, y: 20 },
  ],
  T: 16,
};

const S1_BEST = walkBest(SAMPLE1);
const S2_BEST = walkBest(SAMPLE2);
if (S1_BEST.best !== 13) throw new Error(`delicacy: ตัวอย่างที่หนึ่งต้องได้ 13 แต่ตัวตรวจได้ ${S1_BEST.best}`);
if (S2_BEST.best !== 39) throw new Error(`delicacy: ตัวอย่างที่สองต้องได้ 39 แต่ตัวตรวจได้ ${S2_BEST.best}`);

/* แผนเดินทางที่โจทย์เขียนไว้ในคำอธิบาย เก็บเป็นดัชนีถนน แล้วเช็กว่าได้ค่าเท่าคำตอบจริง */
const S1_STOPS = walkStops(SAMPLE1, [0, 1, 0, 2, 3]);
const S2_STOPS = walkStops(SAMPLE2, [2, 3, 6, 4, 3, 7]);
const S1_LAST = S1_STOPS[S1_STOPS.length - 1];
const S2_LAST = S2_STOPS[S2_STOPS.length - 1];
if (S1_LAST.run !== 13 || S1_LAST.day !== SAMPLE1.T || S1_LAST.city !== 1)
  throw new Error('delicacy: แผนเดินทางของตัวอย่างที่หนึ่งไม่ตรงกับที่โจทย์เล่า');
if (S2_LAST.run !== 39 || S2_LAST.day !== SAMPLE2.T || S2_LAST.city !== 1)
  throw new Error('delicacy: แผนเดินทางของตัวอย่างที่สองไม่ตรงกับที่โจทย์เล่า');

const S1_PLAN = S1_STOPS.map((s) => s.city).join(' → ');
const S2_PLAN = S2_STOPS.map((s) => s.city).join(' → ');
const S1_WALK = S1_STOPS.map((s) => `วันที่ ${s.day} อยู่เมือง ${s.city} ได้ ${s.gain}`).join(' จากนั้น');
const S1_SUM = S1_STOPS.map((s) => s.gain).join(' + ');
const S2_FEST_DAYS = SAMPLE2.fest.map((f) => f.t).join(', ');
const S2_FEST_SORTED = [...SAMPLE2.fest].sort((a, b) => a.t - b.t);
const S2_HIT = S2_STOPS.filter((s) => s.bonus > 0);
const S2_MISS = S2_FEST_SORTED.filter((f) => !S2_STOPS.some((s) => s.day === f.t && s.city === f.x));

/* ช่วงเวลาระหว่างเทศกาลของตัวอย่างที่สอง ใช้วาดรูปที่สาม */
const gapBits = (g: number): number[] => {
  const out: number[] = [];
  for (let b = 0; (1 << b) <= g; b++) if ((g >> b) & 1) out.push(1 << b);
  return out.reverse();
};
type Gap = { from: number; to: number; len: number; bits: number[] };
const S2_GAPS: Gap[] = [];
{
  let now = 0;
  for (const f of S2_FEST_SORTED) {
    S2_GAPS.push({ from: now, to: f.t, len: f.t - now, bits: gapBits(f.t - now) });
    now = f.t;
  }
  S2_GAPS.push({ from: now, to: SAMPLE2.T, len: SAMPLE2.T - now, bits: gapBits(SAMPLE2.T - now) });
}
const S2_LONG_GAP = S2_GAPS[S2_GAPS.length - 1];

/* ---------- ขอบเขตกับบิลค่าใช้จ่าย ---------- */
const N_MAX = 50;
const M_MAX = 501;
const T_MAX = 1000000000;
const K_MAX = 200;
const C_MAX = 52501;
const W_MAX = 5;
const T_SUB = 52501;
const STATES = N_MAX * W_MAX;
const MUL_COST = STATES * STATES * STATES;
const VMUL_COST = STATES * STATES;
const bitsOf = (T: number): number => Math.floor(Math.log2(T)) + 1;
const dayOps = (T: number): number => T * M_MAX;
const matOps = (T: number): number => (bitsOf(T) - 1) * MUL_COST + (K_MAX + 1) * bitsOf(T) * VMUL_COST;
const MEM_MATRIX = bitsOf(T_MAX) * VMUL_COST * 8;
const MEM_DAYDP = (T_SUB + 1) * N_MAX * 8;
const bill = [
  { name: 'ไล่ทีละวัน ทุกวันผ่อนถนนทุกเส้น', a: dayOps(T_SUB), b: dayOps(T_MAX) },
  { name: 'หั่นเมืองแล้วคูณเมทริกซ์ ยกกำลังทวิภาค', a: matOps(T_SUB), b: matOps(T_MAX) },
];
if (matOps(T_MAX) !== 830000000) throw new Error('delicacy: บิลค่าใช้จ่ายของท่าเมทริกซ์เปลี่ยนไปจากที่หน้านี้อ้าง');

/* ---------- มินิเกม พาเขาเที่ยวเอง ---------- */
type GamePuzzle = {
  id: string;
  label: string;
  tease: string;
  n: number;
  C: number[];
  roads: Road[];
  fest: Fest[];
  T: number;
  answer: number;
};
function makePuzzle(id: string, label: string, tease: string, k: Kingdom, expect: number): GamePuzzle {
  const r = walkBest(k);
  if (r.best !== expect) throw new Error(`delicacy: ชุด ${id} ตัวตรวจได้ ${r.best} แต่หน้านี้อ้าง ${expect}`);
  return { id, label, tease, ...k, answer: r.best };
}

/* ชุดกับดัก: เมือง 3 อร่อยที่สุด เด้ง 2 กับ 3 ไปมาได้วันละเยอะ
   แต่ทางกลับบ้านจากเมือง 3 ยาว 3 วัน คนที่เด้งเพลินจะกลับไม่ทัน */
const TRAP: Kingdom = {
  n: 3,
  C: [0, 1, 4, 12],
  roads: [road(1, 2, 1), road(2, 1, 1), road(2, 3, 1), road(3, 2, 1), road(3, 1, 3)],
  fest: [],
  T: 9,
};
/* ชุดเทศกาล: ถ้าไม่มีเทศกาล วนสี่เมืองรวดเดียวดีที่สุด แต่พอมีเทศกาลวันที่ 5 ที่เมือง 4
   ต้องยอมวนใกล้บ้านก่อนเพื่อไปถึงเมือง 4 ให้ตรงวัน */
const FEST: Kingdom = {
  n: 4,
  C: [0, 1, 2, 3, 2],
  roads: [road(1, 2, 1), road(2, 3, 1), road(3, 4, 1), road(4, 1, 1), road(1, 3, 2), road(3, 1, 2), road(2, 1, 1)],
  fest: [{ t: 5, x: 4, y: 15 }],
  T: 8,
};
/* ชุดที่ทำไม่ได้: ทุกวงรอบที่ผ่านเมือง 1 ยาวเป็นเลขคู่ ส่วน T เป็นเลขคี่ */
const NONE: Kingdom = {
  n: 3,
  C: [0, 1, 5, 4],
  roads: [road(1, 2, 1), road(2, 1, 1), road(2, 3, 1), road(3, 2, 1), road(1, 3, 2), road(3, 1, 2)],
  fest: [],
  T: 7,
};

const TRAP_GREEDY = greedyRun(TRAP);
if (TRAP_GREEDY.city === 1 || TRAP_GREEDY.day !== TRAP.T || TRAP_GREEDY.sum !== 69)
  throw new Error('delicacy: ชุดกับดักต้องทำให้คนเดินแบบตะกละจบวันสุดท้ายนอกเมือง 1');

const FEST_BEST = walkBest(FEST);
const FEST_STOPS = walkStops(FEST, FEST_BEST.path);
const FEST_BONUS = FEST_STOPS.reduce((s, x) => s + x.bonus, 0);
const FEST_BASE = FEST_BEST.best - FEST_BONUS;
const FEST_OFF = walkBest({ ...FEST, fest: [] });
if (FEST_OFF.best !== 17) throw new Error(`delicacy: ชุดเทศกาลถ้าไม่มีเทศกาลต้องได้ 17 แต่ได้ ${FEST_OFF.best}`);
if (FEST_BASE >= FEST_OFF.best)
  throw new Error('delicacy: ชุดเทศกาลต้องเป็นชุดที่เส้นทางชนะเปลี่ยนเพราะเทศกาล');

const puzzles: GamePuzzle[] = [
  makePuzzle('s1', 'ตัวอย่างในโจทย์', 'อาณาจักรเดียวกับตัวอย่างแรก ลองเดินให้กลับถึงเมือง 1 พอดีวันที่ 11 ก่อน แล้วค่อยไล่หายอดที่มากที่สุด', SAMPLE1, 13),
  makePuzzle('trap', 'เมืองอร่อยที่สุด', 'เมือง 3 ให้เยอะที่สุดและเด้งไปมากับเมือง 2 ได้เรื่อย ๆ ลองเก็บให้เต็มที่ดู แล้วดูว่าวันสุดท้ายคุณยืนอยู่ตรงไหน', TRAP, 50),
  makePuzzle('fest', 'มีเทศกาลคั่น', 'ชุดนี้มีเทศกาลหนึ่งงาน ต้องไปยืนให้ตรงเมืองตรงวัน ซึ่งแปลว่าบางทีต้องยอมเดินอ้อมก่อน', FEST, 30),
  makePuzzle('none', 'ชุดสุดท้าย', 'ชุดนี้ผมไม่บอกอะไรเลย ลองหาเส้นทางที่กลับถึงเมือง 1 พอดีวันสุดท้ายให้ได้', NONE, -1),
];
const puzzlesJson = JSON.stringify(puzzles);

/* ---------- แผนที่อาณาจักร ใช้ทั้งในรูปแรกและในกระดานของเกม ---------- */
type MapNode = { city: number; x: number; y: number; c: number; home: boolean };
type MapArc = { d: string; head: string; lx: number; ly: number; text: string };
type MapView = { nodes: MapNode[]; arcs: MapArc[]; box: { x: number; y: number; w: number; h: number } };
const NODE_R = 30;
const rn = (v: number): number => Math.round(v * 10) / 10;

function buildMap(k: Kingdom): MapView {
  const cx = 200;
  const cy = 170;
  const R = 105;
  const pos = (i: number): { x: number; y: number } => {
    const a = Math.PI - (2 * Math.PI * i) / k.n;
    return { x: cx + R * Math.cos(a), y: cy - R * Math.sin(a) };
  };
  const nodes: MapNode[] = [];
  for (let i = 0; i < k.n; i++) {
    const p = pos(i);
    nodes.push({ city: i + 1, x: rn(p.x), y: rn(p.y), c: k.C[i + 1], home: i === 0 });
  }
  const pts: { x: number; y: number }[] = [];
  for (const nd of nodes) {
    pts.push({ x: nd.x - NODE_R, y: nd.y - NODE_R }, { x: nd.x + NODE_R, y: nd.y + NODE_R });
  }
  const arcs: MapArc[] = k.roads.map((r) => {
    const P0 = pos(r.u - 1);
    const P2 = pos(r.v - 1);
    const dx = P2.x - P0.x;
    const dy = P2.y - P0.y;
    const len = Math.hypot(dx, dy) || 1;
    /* ตั้งฉากหันข้างเดียวกันเสมอ ถนนที่สวนทางกันจึงโค้งคนละข้าง ไม่ทับกัน */
    const nx = dy / len;
    const ny = -dx / len;
    const bow = 36;
    const cpx = (P0.x + P2.x) / 2 + nx * bow;
    const cpy = (P0.y + P2.y) / 2 + ny * bow;
    const away = (P: { x: number; y: number }, d: number): { x: number; y: number } => {
      const ax = cpx - P.x;
      const ay = cpy - P.y;
      const al = Math.hypot(ax, ay) || 1;
      return { x: P.x + (ax / al) * d, y: P.y + (ay / al) * d };
    };
    const s = away(P0, NODE_R + 2);
    const e = away(P2, NODE_R + 11);
    const tip = away(P2, NODE_R + 1);
    const hx = tip.x - e.x;
    const hy = tip.y - e.y;
    const hl = Math.hypot(hx, hy) || 1;
    const px = -hy / hl;
    const py = hx / hl;
    const b1 = { x: e.x + px * 5.5, y: e.y + py * 5.5 };
    const b2 = { x: e.x - px * 5.5, y: e.y - py * 5.5 };
    const midx = 0.25 * s.x + 0.5 * cpx + 0.25 * e.x + nx * 13;
    const midy = 0.25 * s.y + 0.5 * cpy + 0.25 * e.y + ny * 13;
    for (const t of [0, 0.25, 0.5, 0.75, 1]) {
      const q = (1 - t) * (1 - t);
      pts.push({
        x: q * s.x + 2 * (1 - t) * t * cpx + t * t * e.x,
        y: q * s.y + 2 * (1 - t) * t * cpy + t * t * e.y,
      });
    }
    pts.push({ x: midx - 22, y: midy - 11 }, { x: midx + 22, y: midy + 11 });
    return {
      d: `M ${rn(s.x)} ${rn(s.y)} Q ${rn(cpx)} ${rn(cpy)} ${rn(e.x)} ${rn(e.y)}`,
      head: `M ${rn(tip.x)} ${rn(tip.y)} L ${rn(b1.x)} ${rn(b1.y)} L ${rn(b2.x)} ${rn(b2.y)} Z`,
      lx: rn(midx),
      ly: rn(midy),
      text: `${r.w} วัน`,
    };
  });
  const xs = pts.map((p) => p.x);
  const ys = pts.map((p) => p.y);
  const x = Math.floor(Math.min(...xs)) - 8;
  const y = Math.floor(Math.min(...ys)) - 8;
  return {
    nodes,
    arcs,
    box: { x, y, w: Math.ceil(Math.max(...xs)) + 8 - x, h: Math.ceil(Math.max(...ys)) + 8 - y },
  };
}

const MAPS: MapView[] = puzzles.map((p) => buildMap({ n: p.n, C: p.C, roads: p.roads, fest: p.fest, T: p.T }));
const mapVb = (m: MapView): string => `${m.box.x} ${m.box.y} ${m.box.w} ${m.box.h}`;
const festLine = (p: GamePuzzle): string =>
  p.fest.length === 0
    ? 'ชุดนี้ไม่มีเทศกาล'
    : `เทศกาล: ${p.fest.map((f) => `วันที่ ${f.t} ที่เมือง ${f.x} ได้เพิ่ม ${f.y}`).join(' และ ')}`;

/* ---------- รูปที่หนึ่ง แผนที่ของตัวอย่างแรก กับบัญชีหกบรรทัด ---------- */
const D1_MAP = MAPS[0];
const D1_LEDGER_X = D1_MAP.box.w + 34;
const D1_ROW_Y = S1_STOPS.map((_, i) => 64 + i * 38);
const D1_COL = { day: D1_LEDGER_X, city: D1_LEDGER_X + 74, gain: D1_LEDGER_X + 168, run: D1_LEDGER_X + 246 };
const D1_W = D1_COL.run + 34 + 12;
const D1_H = Math.max(D1_MAP.box.h, D1_ROW_Y[D1_ROW_Y.length - 1] + 10) + 34;

/* ---------- รูปที่สอง ถนนหนึ่งเส้นกลายเป็นการก้าววันละครั้ง ---------- */
type ChainNode = { label: string; day: number; landed: boolean; x: number; gain: number; road: string };
const CHAIN_X0 = 12;
const CHAIN_STEP = 100;
const CHAIN_W = 74;
const CHAIN_TOP = 52;
const CHAIN_H = 50;
const chain: ChainNode[] = [];
{
  /* ขาสุดท้ายของตัวอย่างแรก: วันที่ 5 อยู่เมือง 2 แล้วไปเมือง 3 (2 วัน) ต่อด้วยเมือง 1 (4 วัน) */
  const legs = [
    { from: 2, to: 3, w: 2, gain: SAMPLE1.C[3] },
    { from: 3, to: 1, w: 4, gain: SAMPLE1.C[1] },
  ];
  let day = 5;
  let i = 0;
  chain.push({ label: '(2,0)', day, landed: true, x: CHAIN_X0, gain: 0, road: '' });
  for (const leg of legs) {
    for (let j = leg.w - 1; j >= 0; j--) {
      day += 1;
      i += 1;
      chain.push({
        label: `(${leg.to},${j})`,
        day,
        landed: j === 0,
        x: CHAIN_X0 + i * CHAIN_STEP,
        gain: j === leg.w - 1 ? leg.gain : 0,
