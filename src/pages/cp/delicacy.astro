            {m.arcs.map((a) => (
              <g>
                <path d={a.d} fill="none" stroke="#37456b" stroke-width="2" />
                <path d={a.head} fill="#37456b" />
                <rect x={a.lx - 21} y={a.ly - 9} width="42" height="18" rx="5" fill="#0b1220" />
                <text x={a.lx} y={a.ly + 4} fill="#9aa7bd" font-size="11" text-anchor="middle">{a.text}</text>
              </g>
            ))}
            {m.nodes.map((nd) => (
              <g class={nd.home ? 'dlc-node is-home' : 'dlc-node'} data-dlc-city={String(nd.city)}>
                <circle cx={nd.x} cy={nd.y} r={NODE_R} fill="#121a2b" stroke="#2a3350" stroke-width="2" />
                <text x={nd.x} y={nd.y - 1} fill="#eaf2ff" font-size="15" text-anchor="middle">{nd.city}</text>
                <text x={nd.x} y={nd.y + 16} fill="#e7b455" font-size="12" text-anchor="middle" font-family="monospace">{nd.c}</text>
              </g>
