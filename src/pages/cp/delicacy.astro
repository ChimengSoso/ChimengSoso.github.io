function traceDays(k: Kingdom, sp: Space, A: number[][]): { vecs: number[][]; cands: VecCand[][][] } {
  const v0 = new Array<number>(sp.S).fill(NEG);
  v0[sp.id(1, 0)] = k.C[1] + festBonus(k, 0, 1);
  const vecs = [v0];
