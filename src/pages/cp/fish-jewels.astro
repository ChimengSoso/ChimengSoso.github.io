#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
int K; ll MOD, ans = 0;
vector<vector<ll>> hi;      // hi[t][s] = หยิบชนิด s ได้มากสุดกี่ชิ้น เมื่อจับชนิด t (ชนิด t นับตัวจับด้วย)

