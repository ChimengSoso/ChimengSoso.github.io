        if (cnt % 2 == 1) ans = (ans + sz) % MOD;   // เซตขนาดคี่บวก
        else ans = (ans - sz + MOD) % MOD;          // เซตขนาดคู่ลบ
        return;
    }
    dfs(t + 1, cnt, up, lo);                        // ไม่เอาชนิด t เข้าเซต
    vector<ll> up2(up), lo2(lo);
    for (int s = 0; s < K; s++) up2[s] = min(up2[s], hi[t][s]);
    lo2[t] = 1;                                     // ชุดของชนิด t ต้องมีอัญมณีของตัวจับอย่างน้อยหนึ่งชิ้น
