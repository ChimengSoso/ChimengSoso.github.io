---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const href = 'fish-jewels/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Fish = { len: number; type: number };
/* ตัวอย่างในโจทย์ */
const FISH: Fish[] = [
  { len: 2, type: 2 },
  { len: 5, type: 1 },
  { len: 8, type: 3 },
  { len: 4, type: 1 },
  { len: 2, type: 3 },
];
const K = 3;
const MODULUS = 7;

/* ตัวอย่างเล็กที่ใช้ตลอดเฉลย หาด้วยสคริปต์ให้มีแถวที่ทุกพจน์ของสูตรไม่เป็นศูนย์
   และเรียงชนิดตามตัวแทนแล้วได้ลำดับเดียวกับหมายเลขชนิดพอดี จะได้ไม่ต้องแปลงเลขสองชั้น */
const EX: Fish[] = [
  { len: 2, type: 1 },
  { len: 5, type: 2 },
  { len: 12, type: 3 },
  { len: 16, type: 4 },
  { len: 4, type: 3 },
  { len: 8, type: 2 },
  { len: 11, type: 2 },
];
const EK = 4;

/** เพดานและจำนวนที่หยิบได้ของแต่ละชนิด เมื่อเลือกจับด้วยตัวแทน (ตัวยาวสุด) ของชนิด t */
function reachOf(fish: Fish[], k: number, t: number): { cap: number; hi: number[] } | null {
  const mine = fish.filter((f) => f.type === t);
  if (mine.length === 0) return null;
  const cap = Math.max(...mine.map((f) => f.len));
  const m = new Array<number>(k + 1).fill(0);
  for (const f of fish) if (2 * f.len <= cap) m[f.type]++;
  const hi = Array.from({ length: k }, (_, i) => m[i + 1] + (i + 1 === t ? 1 : 0));
  return { cap, hi };
}

/** ชุดในกล่องของตัวแทนทุกชนิด ใช้กับมินิเกม */
function combosOf(fish: Fish[], k: number): string[] {
  const set = new Set<string>();
  for (let t = 1; t <= k; t++) {
    const r = reachOf(fish, k, t);
    if (!r) continue;
    const rec = (i: number, cur: number[]): void => {
      if (i === k) {
        if (cur[t - 1] >= 1) set.add(cur.join(','));
        return;
      }
      for (let v = 0; v <= r.hi[i]; v++) rec(i + 1, [...cur, v]);
    };
    rec(0, []);
  }
  return [...set];
}

/** ตัวตรวจอิสระ: ให้ปลาทุกตัวลองเป็นตัวจับ ไม่ใช่แค่ตัวแทน แล้วจดว่าชุดไหนมาจากชนิดไหนบ้าง
 *  ไม่มีเหตุผลเรื่องกันนับซ้ำเลย Map กันซ้ำให้เอง */
function combosAnyCatcher(fish: Fish[], k: number): Map<string, number[]> {
  const out = new Map<string, number[]>();
  for (const x of fish) {
    const hi = new Array<number>(k).fill(0);
    for (const f of fish) if (2 * f.len <= x.len) hi[f.type - 1]++;
    hi[x.type - 1]++;
    const rec = (i: number, cur: number[]): void => {
      if (i === k) {
        if (cur[x.type - 1] < 1) return;
        const key = cur.join(',');
        const by = out.get(key) ?? [];
        if (!by.includes(x.type)) by.push(x.type);
        out.set(key, by.sort((a, b) => a - b));
        return;
      }
      for (let v = 0; v <= hi[i]; v++) rec(i + 1, [...cur, v]);
    };
    rec(0, []);
  }
  return out;
}

const combosS = combosAnyCatcher(FISH, K);
const rawAnswer = combosS.size;
const answer = rawAnswer % MODULUS;
const combosE = combosAnyCatcher(EX, EK);
const rawEx = combosE.size;

/** เขียนชุดหนึ่งชุดเป็นข้อความแบบที่โจทย์ใช้ เช่น [1,2,3,3] */
const showKey = (c: string): string => {
  const v = c.split(',').map(Number);
  const out: number[] = [];
  v.forEach((n, i) => {
    for (let j = 0; j < n; j++) out.push(i + 1);
  });
  return `[${out.join(',')}]`;
};
const comboList = [...combosS.keys()]
  .map(showKey)
  .sort((a, b) => (a.length === b.length ? a.localeCompare(b) : a.length - b.length));

/* ---------- ภาพเพดานกับครึ่งเพดาน (ใบ้ ใช้ตัวอย่างในโจทย์) ---------- */
const PICK_T = FISH.reduce((b, f) => (f.len > b.len ? f : b), FISH[0]).type;
const reach = reachOf(FISH, K, PICK_T) as { cap: number; hi: number[] };
const fishSorted = [...FISH].sort((a, b) => b.len - a.len);
const swallowable = (f: Fish): boolean => 2 * f.len <= reach.cap;
const UNIT = 44;
const FX = 128;
const BAR_H2 = 26;
const BAR_GAP2 = 14;
const fbarY = (k: number): number => 62 + k * (BAR_H2 + BAR_GAP2);
const fux = (len: number): number => FX + len * UNIT;
const TYPE_INK = ['#4ade80', '#e0b400', '#6aa9ff', '#e07ab0'];
const fjVB = `0 0 ${fux(reach.cap) + 73} ${fbarY(fishSorted.length) + 81}`;

/* ---------- มินิเกม เก็บชุดอัญมณีให้ครบทุกแบบ ----------
   เกมใช้กล่องของตัวแทนแต่ละชนิด และจำนวนชุดของชุดตัวอย่างถูกเทียบกับตัวตรวจอิสระข้างบน
   ถ้าไม่ตรงกันบิลด์จะพัง */
type FishGamePuzzle = { id: string; label: string; tease: string; fish: Fish[]; k: number };
const FISH_PUZZLES: FishGamePuzzle[] = [
  {
    id: 'f1',
    label: 'ชุดที่ 1 · อุ่นเครื่อง',
    tease: 'ปลาสามตัวสองชนิด พอให้เห็นว่าตัวจับกลืนใครได้บ้าง',
    fish: [
      { len: 1, type: 1 },
      { len: 3, type: 2 },
      { len: 2, type: 1 },
    ],
    k: 2,
  },
  { id: 'f2', label: 'ชุดที่ 2 · ตัวอย่างในโจทย์', tease: 'ชุดเดียวกับตัวอย่างในโจทย์', fish: FISH, k: K },
  {
    id: 'f3',
    label: 'ชุดที่ 3 · ชุดที่นับซ้ำง่าย',
    tease: 'ชุดนี้มีชุดอัญมณีที่ไปถึงได้จากการจับคนละชนิด ระวังนับซ้ำ',
    fish: [
      { len: 2, type: 1 },
      { len: 2, type: 2 },
      { len: 5, type: 1 },
      { len: 5, type: 2 },
    ],
    k: 2,
  },
];
type FishReach = { type: number; cap: number; hi: number[] };
type FishPuzzleData = {
  id: string;
  label: string;
  tease: string;
  fish: Fish[];
  k: number;
  reach: FishReach[];
  all: string[];
  total: number;
};
const fishPuzzles: FishPuzzleData[] = FISH_PUZZLES.map((p) => {
  const rs: FishReach[] = [];
  for (let t = 1; t <= p.k; t++) {
    const r = reachOf(p.fish, p.k, t);
    if (r) rs.push({ type: t, cap: r.cap, hi: r.hi });
  }
  const all = combosOf(p.fish, p.k).sort();
  if (all.length !== combosAnyCatcher(p.fish, p.k).size) {
    throw new Error(`มินิเกมของ fish-jewels: ${p.label} นับได้ ${all.length} ชุด แต่ตัวตรวจอิสระนับได้อีกค่า`);
  }
  return { id: p.id, label: p.label, tease: p.tease, fish: p.fish, k: p.k, reach: rs, all, total: all.length };
});
const fishJson = JSON.stringify(fishPuzzles);

/* ---------- สูตรที่ใช้จริง: เดินทีละชนิดตามลำดับตัวแทน ---------- */

type Row = {
  pos: number;
  type: number;
  B: number;
  added: Fish[];
  m: number[];
  own: number;
  leftF: number[];
  left: number;
  x: number;
  J: number;
  jType: number;
  midF: { type: number; v: number }[];
  mid: number;
  caseB: number;
  caseA: number;
};
function derive(fish: Fish[], k: number): Row[] {
  const byType: number[][] = Array.from({ length: k + 1 }, () => []);
  for (const f of fish) byType[f.type].push(f.len);
  for (let t = 1; t <= k; t++) byType[t].sort((a, b) => a - b);
  const ord = Array.from({ length: k }, (_, i) => i + 1).sort(
    (a, b) => byType[a][byType[a].length - 1] - byType[b][byType[b].length - 1],
  );
  const Bs = ord.map((t) => byType[t][byType[t].length - 1]);
  const sorted = [...fish].sort((a, b) => a.len - b.len);
  const posOf = new Map<number, number>();
  ord.forEach((t, i) => posOf.set(t, i));

  const m = new Array<number>(k).fill(0);
  let ptr = 0;
  const rows: Row[] = [];
  for (let i = 0; i < k; i++) {
    const added: Fish[] = [];
    while (ptr < sorted.length && 2 * sorted[ptr].len <= Bs[i]) {
      m[posOf.get(sorted[ptr].type) as number]++;
      added.push(sorted[ptr]);
      ptr++;
    }
    const leftF = m.slice(0, i).map((v) => v + 1);
    const left = leftF.reduce((a, b) => a * b, 1);
    const x = byType[ord[i]].find((v) => 2 * v > Bs[i]) as number;
    let J = Bs.findIndex((b) => b >= 2 * x);
    if (J < 0) J = k;
    if (J < i + 1) J = i + 1;
    const midF: { type: number; v: number }[] = [];
    for (let j = i + 1; j < J; j++) midF.push({ type: ord[j], v: m[j] + 1 });
    const mid = midF.reduce((a, b) => a * b.v, 1);
    rows.push({
      pos: i,
      type: ord[i],
      B: Bs[i],
      added,
      m: [...m],
      own: m[i],
      leftF,
      left,
      x,
      J,
      jType: J < k ? ord[J] : 0,
      midF,
      mid,
      caseB: m[i] * left,
      caseA: left * mid,
    });
  }
  return rows;
}
const rowsS = derive(FISH, K);
const rowsE = derive(EX, EK);
const sumRows = (rs: Row[]): number => rs.reduce((s, r) => s + r.caseA + r.caseB, 0);
if (sumRows(rowsS) !== rawAnswer) throw new Error('fish-jewels: สูตรกับตัวอย่างในโจทย์ไม่ตรงกับการไล่นับ');
if (sumRows(rowsE) !== rawEx) throw new Error('fish-jewels: สูตรกับตัวอย่างเล็กไม่ตรงกับการไล่นับ');
if (rowsE.some((r, i) => r.type !== i + 1)) throw new Error('fish-jewels: ลำดับตัวแทนของตัวอย่างเล็กต้องตรงกับหมายเลขชนิด');
const sampleTerms = rowsS.flatMap((r) => [r.caseB, r.caseA]).filter((v) => v > 0);

/* ทุกแถว: แบ่งชุดที่แต่ละชนิดเป็นเจ้าของ (ชนิดหลังสุดในลำดับที่สร้างชุดได้) จากตัวตรวจอิสระ
   แล้วเทียบจำนวนกรณี (ข) กับ (ก) ทีละแถว */
function checkOwners(map: Map<string, number[]>, rs: Row[]): void {
  const pos = new Map<number, number>(rs.map((r) => [r.type, r.pos]));
  const gotB = new Array<number>(rs.length).fill(0);
  const gotA = new Array<number>(rs.length).fill(0);
  for (const [key, by] of map) {
    const c = key.split(',').map(Number);
    const owner = by.reduce((a, t) => ((pos.get(t) as number) > (pos.get(a) as number) ? t : a), by[0]);
    const r = rs[pos.get(owner) as number];
    if (c[owner - 1] > r.own) gotA[r.pos]++;
    else gotB[r.pos]++;
  }
  rs.forEach((r) => {
    if (gotB[r.pos] !== r.caseB || gotA[r.pos] !== r.caseA) {
      throw new Error(`fish-jewels: แถวชนิด ${r.type} สูตรได้ (ข) ${r.caseB} (ก) ${r.caseA} แต่นับตรง ๆ ได้ ${gotB[r.pos]} กับ ${gotA[r.pos]}`);
    }
  });
}
checkOwners(combosS, rowsS);
checkOwners(combosE, rowsE);

/* แถวที่ใช้แกะสูตร ต้องมีทุกพจน์ไม่เป็นศูนย์และไม่เป็นหนึ่งเฉย ๆ */
const W = rowsE.find((r) => r.own >= 1 && r.left >= 2 && r.mid >= 2 && r.J < EK);
if (!W) throw new Error('fish-jewels: ตัวอย่างเล็กไม่มีแถวที่ทุกพจน์ทำงาน');
const wB = W.B;
const wHalf = W.B / 2;

/* ---------- กล่องของตัวอย่างเล็ก และการเพิ่มเข้าตัดออก ---------- */
type Range = { lo: number; hi: number };
const boxOf = (t: number): Range[] =>
  (reachOf(EX, EK, t) as { cap: number; hi: number[] }).hi.map((h, s) => ({ lo: s + 1 === t ? 1 : 0, hi: h }));
const boxSize = (b: Range[]): number => b.reduce((a, r) => a * Math.max(0, r.hi - r.lo + 1), 1);
const meet = (a: Range[], b: Range[]): Range[] => a.map((r, s) => ({ lo: Math.max(r.lo, b[s].lo), hi: Math.min(r.hi, b[s].hi) }));
const showRange = (r: Range): string => (r.hi < r.lo ? 'ว่าง' : r.lo === r.hi ? String(r.lo) : `${r.lo} ถึง ${r.hi}`);
const EX_TYPES = Array.from({ length: EK }, (_, i) => i + 1);
const BOXES = EX_TYPES.map(boxOf);
const boxSum = BOXES.reduce((a, b) => a + boxSize(b), 0);
const dupKeys = [...combosE].filter(([, by]) => by.length >= 2).map(([k]) => k).sort();
if (boxSum - rawEx <= 0 || dupKeys.length === 0) throw new Error('fish-jewels: ตัวอย่างเล็กต้องมีชุดที่อยู่หลายกล่อง');
const dupKey = dupKeys[0];
const dupBy = combosE.get(dupKey) as number[];
const dupOwner = dupBy[dupBy.length - 1];
const dupCounts = dupKey.split(',').map(Number);
const dupOwnerRow = rowsE[dupOwner - 1];
const dupCase = dupCounts[dupOwner - 1] > dupOwnerRow.own ? '(ก)' : '(ข)';

/* คู่กล่องที่ทับกันมากที่สุด ใช้แกะ |A ∪ B| = |A| + |B| − |A ∩ B| */
let pairBest: [number, number] = [0, 0];
let pairInter = -1;
for (let a = 0; a < EK; a++) {
  for (let b = a + 1; b < EK; b++) {
    const s = boxSize(meet(BOXES[a], BOXES[b]));
    if (s > pairInter) {
      pairInter = s;
      pairBest = [a + 1, b + 1];
    }
  }
}
const [PA, PB] = pairBest;
const sizeA = boxSize(BOXES[PA - 1]);
const sizeB = boxSize(BOXES[PB - 1]);
const MEET = meet(BOXES[PA - 1], BOXES[PB - 1]);
const pairUnion = sizeA + sizeB - pairInter;
const pairDirect = [...combosE.values()].filter((by) => by.includes(PA) || by.includes(PB)).length;
if (pairInter <= 0 || pairUnion !== pairDirect) throw new Error('fish-jewels: ตัวอย่างสองกล่องไม่ตรงกับการนับตรง ๆ');

let ieTotal = 0;
let ieTerms = 0;
for (let mask = 1; mask < 1 << EK; mask++) {
  let box: Range[] = EX_TYPES.map(() => ({ lo: 0, hi: Number.MAX_SAFE_INTEGER }));
  let bits = 0;
  for (let t = 0; t < EK; t++) {
    if (mask & (1 << t)) {
      box = meet(box, BOXES[t]);
      bits++;
    }
  }
  ieTerms++;
  ieTotal += (bits % 2 === 1 ? 1 : -1) * boxSize(box);
}
if (ieTotal !== rawEx) throw new Error('fish-jewels: การเพิ่มเข้าตัดออกกับตัวอย่างเล็กไม่ตรงกับการไล่นับ');

/* ---------- ภาพกล่องซ้อนกันของตัวอย่างเล็ก ---------- */
const NX0 = 140;
const NU = 29;
const nx = (v: number): number => NX0 + v * NU;
const NMAXL = Math.max(...EX.map((f) => f.len));
const nRowY = (k: number): number => 92 + k * 46;
const N_AXIS_Y = nRowY(EK) - 10;
const nTicks = Array.from({ length: NMAXL / 2 + 1 }, (_, k) => k * 2);
const nVBW = nx(NMAXL) + 24;
const nVBH = N_AXIS_Y + 22 + 34;
const NEST_ROWS = rowsE.map((r, k) => ({ ...r, y: nRowY(k), half: r.B / 2, ink: TYPE_INK[(r.type - 1) % 4] }));

/* ---------- ตอนที่ 2: ต้นทุนของแต่ละวิธีเทียบงบเวลา ----------
   ความเร็วเครื่องเป็นค่าสมมติแบบหยาบที่เขียนบอกไว้ในหน้า ไม่ใช่ค่าที่วัด */
const FMAX = 500000;
const KSUB1 = 20;
const KSUB2 = 7000;
const TIME_LIMIT = 3;
const OPS_PER_SEC = 1e8;
const BUDGET_OPS = TIME_LIMIT * OPS_PER_SEC;
const IE_OPS = 2 ** KSUB1 * KSUB1;
const IE_DIGITS = Math.floor(KSUB2 * Math.log10(2)) + 1;
const SQ_SUB = KSUB2 * KSUB2;
const SQ_FULL = FMAX * FMAX;
const LOGK = Math.ceil(Math.log2(FMAX));
const LOGF = Math.ceil(Math.log2(FMAX));
/* นับตามโค้ดเต็มที่ F = K = FMAX: แก้ช่องปลาละครั้ง, ถามสองช่วงต่อชนิด ช่วงละราว 2 log K,
   ค้นหาแบบแบ่งครึ่งสองครั้งต่อชนิด, และการเรียงปลาสองรอบ (ทั้งหมด กับแยกตามชนิด) บวกเรียงชนิด */
const TREE_PARTS = [
  { what: 'แก้ช่อง', n: FMAX * LOGK },
  { what: 'ถามช่วง', n: 2 * FMAX * 2 * LOGK },
  { what: 'ค้นหาแบบแบ่งครึ่ง', n: 2 * FMAX * LOGF },
  { what: 'เรียง', n: 2 * FMAX * LOGF + FMAX * LOGK },
];
const TREE_OPS = TREE_PARTS.reduce((a, p) => a + p.n, 0);
const SQ_OVER = Math.round(SQ_FULL / BUDGET_OPS / 10) * 10;
if (IE_OPS > BUDGET_OPS || SQ_SUB > BUDGET_OPS || SQ_FULL < BUDGET_OPS || TREE_OPS > BUDGET_OPS) {
  throw new Error('fish-jewels: กราฟงบเวลาไม่ตรงกับเรื่องที่หน้าเล่า');
}
const CH_LO = 6;
const CH_HI = 12;
const CH_X0 = 250;
const CH_W = 360;
const CH_Y0 = 46;
const CH_ROW = 44;
const chX = (v: number): number => CH_X0 + ((Math.log10(v) - CH_LO) / (CH_HI - CH_LO)) * CH_W;
const sci = (v: number): { m: string; e: number } => {
  const e = Math.floor(Math.log10(v));
  return { m: (v / 10 ** e).toFixed(1).replace(/\.0$/, ''), e };
};
const fmt = (n: number): string => n.toLocaleString('en-US');
const CH_BARS = [
  { name: `เพิ่มเข้าตัดออก · K = ${KSUB1}`, v: IE_OPS },
  { name: `คูณไล่ · K = ${fmt(KSUB2)}`, v: SQ_SUB },
  { name: `คูณไล่ · K = ${fmt(FMAX)}`, v: SQ_FULL },
  { name: `ต้นไม้ช่วง · F = K = ${fmt(FMAX)}`, v: TREE_OPS },
].map((b, k) => ({ ...b, y: CH_Y0 + k * CH_ROW, ok: b.v < BUDGET_OPS, s: sci(b.v) }));
const CH_BOTTOM = CH_Y0 + CH_BARS.length * CH_ROW;
const CH_TICKS = Array.from({ length: CH_HI - CH_LO + 1 }, (_, k) => CH_LO + k);

/* ---------- เวลาที่วัดจริง (WSL, g++ -O2, ค่ากลางของสามรอบ รวมเวลาอ่านอินพุต) ---------- */
const TIMES = [
  { what: 'เฉลยเต็ม', input: `F = ${fmt(FMAX)}, K = 200,000`, sec: '0.57' },
  { what: 'เฉลยเต็ม', input: `F = ${fmt(FMAX)}, K = ${fmt(FMAX)}`, sec: '0.89' },
  { what: 'วิธีที่ 3 (คูณไล่)', input: `F = ${fmt(FMAX)}, K = ${fmt(KSUB2)}`, sec: '0.48' },
