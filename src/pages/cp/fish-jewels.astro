void dfs(int t, int cnt, const vector<ll>& up, const vector<ll>& lo) {
    if (t == K) {
        if (cnt == 0) return;                       // เซตว่างไม่นับ
        ll sz = 1 % MOD;
        for (int s = 0; s < K; s++) {
            ll w = up[s] - lo[s] + 1;               // ชนิด s เลือกได้กี่ค่า
            if (w <= 0) return;                     // กล่องที่ตัดกันว่างเปล่า ไม่มีผล
            sz = sz * (w % MOD) % MOD;
