<style>
  /* ตารางประกอบเนื้อหา การ์ดเลื่อนในตัวเอง หน้าเว็บไม่เลื่อนตาม */
  figure.tbl{
    margin:1.2rem 0 0.4rem;
    padding:0;
    overflow-x:auto;
    background:#0b1220;
    border:1px solid var(--dl-border);
    border-radius:10px;
    box-shadow:0 4px 16px rgba(0,0,0,0.3);
  }
  /* ไทยไม่มีช่องไฟ คำบรรยายยาว ๆ จะถ่างการ์ดที่เป็น fit-content
     width:0 + min-width:100% ทำให้ความยาวกลายเป็นความสูงแทน */
  figure.tbl figcaption{
    width:0;
    min-width:100%;
    font-size:0.78rem;
    color:var(--dl-muted);
    line-height:1.6;
    padding:0.6rem 0.85rem 0.75rem;
    border-top:1px solid var(--dl-border);
  }
  table.rec{
    width:100%;
    border-collapse:separate;
    border-spacing:0;
    font-size:0.84rem;
  }
  figure.tbl table.rec{width:auto;}
  table.rec caption{
    caption-side:top;
    text-align:left;
    font-family:"Fira Code","Fira Mono",monospace;
    font-weight:700;
    letter-spacing:0.18em;
    font-size:0.68rem;
    color:var(--dl-gold);
    background:#070c17;
    padding:0.5rem 0.85rem;
    border-bottom:1px solid var(--dl-border);
    white-space:nowrap;
  }
  table.rec th, table.rec td{
    padding:0.5rem 0.8rem;
    text-align:left;
    vertical-align:middle;
    border-bottom:1px solid var(--dl-border);
  }
  table.rec th + th, table.rec td + td{border-left:1px solid var(--dl-border);}
  table.rec tbody tr:last-child td{border-bottom:none;}
  table.rec th{
    background:#141b2b;
    color:var(--dl-muted);
    font-weight:600;
    font-size:0.68rem;
    letter-spacing:0.1em;
    text-transform:uppercase;
    white-space:nowrap;
  }
  table.rec td{color:var(--dl-ink);line-height:1.55;}
  table.rec td strong{color:var(--dl-gold);}
  table.rec td.num{
    text-align:right;
    font-family:"Fira Code","Fira Mono",monospace;
    font-variant-numeric:tabular-nums;
    white-space:nowrap;
    color:#cdd6ea;
  }
  table.rec th.num{text-align:right;}

  .dim{color:#7b8397;}

  /* ---------- ตารางของมินิเกมจับปลา ---------- */
  .fg-sub{width:0;min-width:100%;margin:0.9rem 0 0;font-size:0.85rem;color:#9aa7bd;}
  .fg-fish, .fg-pick{border-collapse:collapse;font-size:0.85rem;}
  .fg-fish th, .fg-fish td, .fg-pick th, .fg-pick td{
    border:1px solid #2a3350;padding:0.24rem 0.6rem;text-align:center;color:#cdd6ea;
  }
  .fg-fish th, .fg-pick th{color:#9aa7bd;font-weight:600;white-space:nowrap;}
  .fg-fish tr.reach td{background:#131c2c;}
  .fg-fish tr.caught td{background:#14351f;color:#4ade80;}
  .cpg-btn.picked{background:var(--dl-emerald-bright);border-color:var(--dl-emerald-bright);color:#0b1220;font-weight:700;}
  .fg-step{
    font:inherit;font-size:0.8rem;cursor:pointer;
    width:1.4rem;height:1.4rem;line-height:1;
    margin:0 0.3rem;
    border:1px solid #2a3350;border-radius:5px;background:#101827;color:#cdd6ea;
  }
  .fg-step:hover{border-color:var(--dl-emerald);}
  .fg-pick b{font-family:var(--dl-mono,monospace);color:#e6edfb;}
</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type FgFish = { len: number; type: number };
  type FgReach = { type: number; cap: number; hi: number[] };
  type FgPuzzle = {
    id: string;
    label: string;
    tease: string;
    fish: FgFish[];
    k: number;
    reach: FgReach[];
    all: string[];
    total: number;
  };

  function initFishGame(): void {
    const maybeUi = cpGameUi('[data-fishgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as FgPuzzle[];
    if (puzzles.length === 0) return;

    const fishEl = ui.root.querySelector<HTMLElement>('[data-fg-fish]');
    const typesEl = ui.root.querySelector<HTMLElement>('[data-fg-types]');
    const pickEl = ui.root.querySelector<HTMLElement>('[data-fg-pick]');
    const foundEl = ui.root.querySelector<HTMLElement>('[data-fg-found]');
    const totalEl = ui.root.querySelector<HTMLElement>('[data-fg-total]');
    const listEl = ui.root.querySelector<HTMLElement>('[data-fg-list]');
    if (!fishEl || !typesEl || !pickEl || !foundEl || !totalEl || !listEl) return;
    const fishTable: HTMLElement = fishEl;
    const typeBar: HTMLElement = typesEl;
    const pickTable: HTMLElement = pickEl;
    const foundOut: HTMLElement = foundEl;
    const totalOut: HTMLElement = totalEl;
    const listOut: HTMLElement = listEl;

    let pi = 0;
    let chosenType = 0;
    let counts: number[] = [];
    let found = new Set<string>();

    const pz = (): FgPuzzle => puzzles[pi];
    const reachFor = (t: number): FgReach | undefined => pz().reach.find((r) => r.type === t);

    function show(key: string): string {
      const v = key.split(',').map(Number);
      const out: number[] = [];
      v.forEach((n, i) => {
        for (let j = 0; j < n; j++) out.push(i + 1);
      });
      return `[${out.join(',')}]`;
    }

    function buildFish(): void {
      const p = pz();
      fishTable.textContent = '';
      const head = document.createElement('tr');
      for (const label of ['ปลา', 'ความยาว', 'ชนิดอัญมณี']) {
        const th = document.createElement('th');
        th.textContent = label;
        head.appendChild(th);
      }
      fishTable.appendChild(head);
      p.fish.forEach((f, i) => {
        const tr = document.createElement('tr');
        tr.dataset.fish = String(i);
        for (const text of [`ตัวที่ ${i + 1}`, String(f.len), String(f.type)]) {
          const td = document.createElement('td');
          td.textContent = text;
          tr.appendChild(td);
        }
        fishTable.appendChild(tr);
      });

      typeBar.textContent = '';
      for (const r of p.reach) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cpg-btn';
        b.dataset.type = String(r.type);
        b.textContent = `จับชนิด ${r.type} (เพดาน ${r.cap})`;
        typeBar.appendChild(b);
      }
    }

    function buildPick(): void {
      const p = pz();
      pickTable.textContent = '';
      if (chosenType === 0) return;
      const r = reachFor(chosenType);
      if (!r) return;
      const head = document.createElement('tr');
      const c0 = document.createElement('th');
      c0.textContent = 'ชนิด';
      head.appendChild(c0);
      for (let t = 1; t <= p.k; t++) {
        const th = document.createElement('th');
        th.textContent = String(t);
        head.appendChild(th);
      }
      pickTable.appendChild(head);

      const rowMax = document.createElement('tr');
      const m0 = document.createElement('th');
      m0.textContent = 'หยิบได้ถึง';
      rowMax.appendChild(m0);
      for (let t = 1; t <= p.k; t++) {
        const td = document.createElement('td');
        td.textContent = String(r.hi[t - 1]);
        rowMax.appendChild(td);
      }
      pickTable.appendChild(rowMax);

      const rowNow = document.createElement('tr');
      const n0 = document.createElement('th');
      n0.textContent = 'จะเก็บ';
      rowNow.appendChild(n0);
      for (let t = 1; t <= p.k; t++) {
        const td = document.createElement('td');
        const minus = document.createElement('button');
        minus.type = 'button';
        minus.className = 'fg-step';
        minus.dataset.d = '-1';
        minus.dataset.t = String(t);
        minus.textContent = '-';
        const val = document.createElement('b');
        val.dataset.val = String(t);
        val.textContent = '0';
        const plus = document.createElement('button');
        plus.type = 'button';
        plus.className = 'fg-step';
        plus.dataset.d = '1';
        plus.dataset.t = String(t);
        plus.textContent = '+';
        td.append(minus, val, plus);
        rowNow.appendChild(td);
      }
      pickTable.appendChild(rowNow);
    }

    function render(): void {
      const p = pz();
      for (const b of Array.from(typeBar.querySelectorAll<HTMLElement>('[data-type]'))) {
        b.classList.toggle('picked', Number(b.dataset.type) === chosenType);
      }
      const r = reachFor(chosenType);
      for (const rowFish of Array.from(fishTable.querySelectorAll<HTMLElement>('[data-fish]'))) {
        const f = p.fish[Number(rowFish.dataset.fish)];
        rowFish.classList.toggle('caught', r !== undefined && f.type === chosenType && f.len === r.cap);
        rowFish.classList.toggle('reach', r !== undefined && 2 * f.len <= r.cap);
      }
      for (const v of Array.from(pickTable.querySelectorAll<HTMLElement>('[data-val]'))) {
        v.textContent = String(counts[Number(v.dataset.val) - 1] ?? 0);
      }
      foundOut.textContent = String(found.size);
      totalOut.textContent = String(p.total);
      listOut.textContent =
        found.size === 0
          ? 'ยังไม่ได้เก็บชุดไหนเลย'
          : `เก็บแล้ว ${[...found].sort().map(show).join(' ')}`;
    }

    function pickType(t: number): void {
      const p = pz();
      chosenType = t;
      counts = new Array<number>(p.k).fill(0);
      counts[t - 1] = 1;
      buildPick();
      ui.setStatus(`จับชนิด ${t} แล้ว ปรับจำนวนที่จะเก็บ แล้วกดเก็บชุดนี้`);
      render();
    }

    function step(t: number, d: number): void {
      const r = reachFor(chosenType);
      if (!r) return;
      const lo = t === chosenType ? 1 : 0;
      counts[t - 1] = Math.max(lo, Math.min(r.hi[t - 1], counts[t - 1] + d));
      render();
    }

    function take(): void {
      const p = pz();
      if (chosenType === 0) {
        ui.setStatus('เลือกชนิดที่จะจับก่อนครับ', 'bad');
        return;
      }
      const key = counts.join(',');
      if (!p.all.includes(key)) {
        ui.setStatus('ชุดนี้ไปถึงไม่ได้ด้วยกติกาของโจทย์', 'bad');
        return;
      }
      if (found.has(key)) {
        ui.setStatus(`${show(key)} เก็บไปแล้ว ชุดเดียวกันไปถึงได้จากหลายทาง จึงนับแค่ครั้งเดียว`, 'bad');
        return;
      }
      found.add(key);
      ui.setStatus(
        found.size === p.total
          ? `ครบทุกชุดแล้วครับ ${p.total} ชุด`
          : `เก็บ ${show(key)} แล้ว เหลืออีก ${p.total - found.size} ชุด`,
        'good',
      );
      render();
    }

    function selectPuzzle(k: number): void {
      pi = k;
      chosenType = 0;
      counts = new Array<number>(pz().k).fill(0);
      found = new Set<string>();
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildFish();
      buildPick();
      ui.setStatus('เลือกชนิดที่จะจับก่อน แล้วค่อยปรับจำนวนอัญมณีแต่ละชนิดที่จะเก็บ');
      render();
    }

    typeBar.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('[data-type]');
      if (!(b instanceof HTMLElement)) return;
      pickType(Number(b.dataset.type));
    });
    pickTable.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('.fg-step');
      if (!(b instanceof HTMLElement)) return;
      step(Number(b.dataset.t), Number(b.dataset.d));
    });

    ui.onClick('data-fg-reset', () => selectPuzzle(pi));
    ui.onClick('data-fg-take', take);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initFishGame);
</script>
