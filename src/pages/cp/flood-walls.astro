        <polyline points="52,258 268,258 268,162 148,162 148,138 268,138 268,42 52,42 52,258" fill="none" stroke="#6ee7a8" stroke-width="2" stroke-dasharray="6 4" />
        <polyline points="294,284 26,284 26,16 294,16 294,284" fill="none" stroke="#d4af37" stroke-width="2" stroke-dasharray="6 4" />
