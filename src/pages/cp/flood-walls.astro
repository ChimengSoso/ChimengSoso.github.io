/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Pt = { x: number; y: number };
const PTS: Pt[] = [
  { x: 1, y: 1 }, { x: 8, y: 1 }, { x: 4, y: 2 }, { x: 7, y: 2 }, { x: 2, y: 3 },
  { x: 4, y: 3 }, { x: 6, y: 3 }, { x: 2, y: 5 }, { x: 4, y: 5 }, { x: 6, y: 5 },
  { x: 4, y: 6 }, { x: 7, y: 6 }, { x: 1, y: 8 }, { x: 4, y: 8 }, { x: 8, y: 8 },
];
const WALLS: [number, number][] = [
  [1, 2], [2, 15], [15, 14], [14, 13], [13, 1], [14, 11], [11, 12], [12, 4], [4, 3],
  [3, 6], [6, 5], [5, 8], [8, 9], [9, 11], [9, 10], [10, 7], [7, 6],
];

/* เดินน้ำท่วมบนตารางช่องละหนึ่งหน่วย ค่าที่ได้คือชั่วโมงที่น้ำถึงแต่ละช่อง */
const SH = 1; // เลื่อนพิกัดขึ้นหนึ่ง เพื่อให้มีวงแหวนช่องว่างรอบนอกไว้เป็นทะเล
const G = Math.max(...PTS.flatMap((p) => [p.x, p.y])) + SH + 2;
const cid = (i: number, j: number): number => i * G + j;
const blkH = new Array<boolean>(G * G).fill(false); // กำแพงระหว่างช่อง (i, j-1) กับ (i, j)
const blkV = new Array<boolean>(G * G).fill(false); // กำแพงระหว่างช่อง (i-1, j) กับ (i, j)
for (const [a, b] of WALLS) {
  const p = PTS[a - 1];
  const q = PTS[b - 1];
  if (p.y === q.y) {
    const y = p.y + SH;
    for (let i = Math.min(p.x, q.x) + SH; i < Math.max(p.x, q.x) + SH; i++) blkH[cid(i, y)] = true;
  } else {
    const x = p.x + SH;
    for (let j = Math.min(p.y, q.y) + SH; j < Math.max(p.y, q.y) + SH; j++) blkV[cid(x, j)] = true;
  }
}
const INF = Number.MAX_SAFE_INTEGER;
const dist = new Array<number>(G * G).fill(INF);
{
  const dq: number[] = [cid(0, 0)];
  dist[cid(0, 0)] = 0;
  let head = 0;
  const push = (v: number, d: number, cost: number): void => {
    if (d + cost < dist[v]) {
      dist[v] = d + cost;
      if (cost === 0) dq.splice(head, 0, v);
      else dq.push(v);
    }
  };
  while (head < dq.length) {
    const u = dq[head++];
    const i = Math.floor(u / G);
    const j = u % G;
    const d = dist[u];
    if (j + 1 < G) push(cid(i, j + 1), d, blkH[cid(i, j + 1)] ? 1 : 0);
    if (j - 1 >= 0) push(cid(i, j - 1), d, blkH[cid(i, j)] ? 1 : 0);
    if (i + 1 < G) push(cid(i + 1, j), d, blkV[cid(i + 1, j)] ? 1 : 0);
    if (i - 1 >= 0) push(cid(i - 1, j), d, blkV[cid(i, j)] ? 1 : 0);
  }
}
type WallInfo = { id: number; a: number; b: number; d1: number; d2: number; alive: boolean };
const wallInfo: WallInfo[] = WALLS.map(([a, b], k) => {
  const p = PTS[a - 1];
  const q = PTS[b - 1];
  let d1: number;
  let d2: number;
  if (p.y === q.y) {
    const y = p.y + SH;
    const x = Math.min(p.x, q.x) + SH;
    d1 = dist[cid(x, y - 1)];
    d2 = dist[cid(x, y)];
  } else {
    const x = p.x + SH;
    const y = Math.min(p.y, q.y) + SH;
    d1 = dist[cid(x - 1, y)];
    d2 = dist[cid(x, y)];
  }
  return { id: k + 1, a, b, d1, d2, alive: d1 === d2 };
});
const survivors = wallInfo.filter((w) => w.alive);
const maxHour = Math.max(...wallInfo.map((w) => Math.max(w.d1, w.d2)));

/* ---------- มินิเกม ทายว่ากำแพงไหนรอด ----------
   ตัวคิดข้างล่างเป็นเวอร์ชันทั่วไปของการท่วมบนตารางที่บทความใช้อยู่แล้ว
   และถูกตรวจว่าให้ผลตรงกับ wallInfo ของผังตัวอย่างเป๊ะ ๆ ตอนบิลด์ */
type FwLayout = { id: string; label: string; tease: string; pts: Pt[]; walls: [number, number][] };

type FwWall = { id: number; a: number; b: number; alive: boolean };

function floodAnalyse(pts: Pt[], walls: [number, number][]): FwWall[] {
  const sh = 1;
  const g = Math.max(...pts.flatMap((p) => [p.x, p.y])) + sh + 2;
  const id2 = (i: number, j: number): number => i * g + j;
  const bh = new Array<boolean>(g * g).fill(false);
  const bv = new Array<boolean>(g * g).fill(false);
  for (const [a, b] of walls) {
    const p = pts[a - 1];
    const q = pts[b - 1];
    if (p.y === q.y) {
      const y = p.y + sh;
      for (let i = Math.min(p.x, q.x) + sh; i < Math.max(p.x, q.x) + sh; i++) bh[id2(i, y)] = true;
    } else {
      const x = p.x + sh;
      for (let j = Math.min(p.y, q.y) + sh; j < Math.max(p.y, q.y) + sh; j++) bv[id2(x, j)] = true;
    }
  }
  const inf = Number.MAX_SAFE_INTEGER;
  const d = new Array<number>(g * g).fill(inf);
  const dq: number[] = [id2(0, 0)];
  d[id2(0, 0)] = 0;
  let head = 0;
  const push = (v: number, base: number, cost: number): void => {
    if (base + cost < d[v]) {
      d[v] = base + cost;
      if (cost === 0) dq.splice(head, 0, v);
      else dq.push(v);
    }
  };
  while (head < dq.length) {
    const u = dq[head++];
    const i = Math.floor(u / g);
    const j = u % g;
    const base = d[u];
    if (j + 1 < g) push(id2(i, j + 1), base, bh[id2(i, j + 1)] ? 1 : 0);
    if (j - 1 >= 0) push(id2(i, j - 1), base, bh[id2(i, j)] ? 1 : 0);
    if (i + 1 < g) push(id2(i + 1, j), base, bv[id2(i + 1, j)] ? 1 : 0);
    if (i - 1 >= 0) push(id2(i - 1, j), base, bv[id2(i, j)] ? 1 : 0);
  }
  return walls.map(([a, b], k) => {
    const p = pts[a - 1];
    const q = pts[b - 1];
    let d1: number;
    let d2: number;
    if (p.y === q.y) {
      const y = p.y + sh;
      const x = Math.min(p.x, q.x) + sh;
      d1 = d[id2(x, y - 1)];
      d2 = d[id2(x, y)];
    } else {
      const x = p.x + sh;
      const y = Math.min(p.y, q.y) + sh;
      d1 = d[id2(x - 1, y)];
      d2 = d[id2(x, y)];
    }
    return { id: k + 1, a, b, alive: d1 === d2 };
  });
}

