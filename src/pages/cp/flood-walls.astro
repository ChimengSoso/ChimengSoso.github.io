<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type FwWall = { id: number; a: number; b: number; alive: boolean };
  type FwPuzzle = { id: string; label: string; tease: string; walls: FwWall[]; aliveCount: number };

  function initFloodGame(): void {
    const maybeUi = cpGameUi('[data-fwgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as FwPuzzle[];
    if (puzzles.length === 0) return;

    const listEl = ui.root.querySelector<HTMLElement>('[data-fw-list]');
    const pickedEl = ui.root.querySelector<HTMLElement>('[data-fw-picked]');
    const totalEl = ui.root.querySelector<HTMLElement>('[data-fw-total]');
    if (!listEl || !pickedEl || !totalEl) return;
    const list: HTMLElement = listEl;
    const pickedOut: HTMLElement = pickedEl;
    const totalOut: HTMLElement = totalEl;

    let pi = 0;
    let guess = new Set<number>();
    let revealed = false;

    const pz = (): FwPuzzle => puzzles[pi];

    function buildList(): void {
      const p = pz();
      list.textContent = '';
      for (const w of p.walls) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cpg-btn fw-wall';
        b.dataset.wall = String(w.id);
        b.textContent = `กำแพง ${w.id} (${w.a} ถึง ${w.b})`;
        list.appendChild(b);
      }
    }

    function render(): void {
      const p = pz();
      for (const b of Array.from(list.querySelectorAll<HTMLElement>('[data-wall]'))) {
        const id = Number(b.dataset.wall);
        const w = p.walls.find((x) => x.id === id);
        b.classList.toggle('picked', guess.has(id));
        b.classList.toggle('right', revealed && w !== undefined && guess.has(id) === w.alive);
        b.classList.toggle('wrong', revealed && w !== undefined && guess.has(id) !== w.alive);
      }
      pickedOut.textContent = String(guess.size);
      totalOut.textContent = String(p.walls.length);
    }

    function check(): void {
      const p = pz();
      let right = 0;
      for (const w of p.walls) if (guess.has(w.id) === w.alive) right++;
      revealed = true;
      render();
      if (right === p.walls.length) {
        ui.setStatus(`ถูกทั้ง ${p.walls.length} เส้นครับ กำแพงที่รอดมี ${p.aliveCount} เส้น`, 'good');
      } else {
        ui.setStatus(
          `ถูก ${right} จาก ${p.walls.length} เส้น เส้นที่ทายพลาดถูกทำเป็นสีแดงไว้แล้ว ลองดูว่าน้ำสองข้างของมันมาถึงพร้อมกันไหม`,
          'bad',
        );
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      guess = new Set<number>();
      revealed = false;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildList();
      ui.setStatus('กดเลือกกำแพงที่คิดว่าจะรอด แล้วกดตรวจ กำแพงที่ไม่ได้เลือกคือกำแพงที่คิดว่าจะพัง');
      render();
    }

    list.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('[data-wall]');
      if (!(b instanceof HTMLElement)) return;
      const id = Number(b.dataset.wall);
      if (guess.has(id)) guess.delete(id);
      else guess.add(id);
      revealed = false;
      ui.setStatus('กดเลือกกำแพงที่คิดว่าจะรอด แล้วกดตรวจ กำแพงที่ไม่ได้เลือกคือกำแพงที่คิดว่าจะพัง');
      render();
    });

    ui.onClick('data-fw-clear', () => selectPuzzle(pi));
    ui.onClick('data-fw-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initFloodGame);
</script>

