---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

const href = 'flood-walls/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Pt = { x: number; y: number };
type Seg = [number, number];

const PTS: Pt[] = [
  { x: 1, y: 1 }, { x: 8, y: 1 }, { x: 4, y: 2 }, { x: 7, y: 2 }, { x: 2, y: 3 },
  { x: 4, y: 3 }, { x: 6, y: 3 }, { x: 2, y: 5 }, { x: 4, y: 5 }, { x: 6, y: 5 },
  { x: 4, y: 6 }, { x: 7, y: 6 }, { x: 1, y: 8 }, { x: 4, y: 8 }, { x: 8, y: 8 },
];
const WALLS: Seg[] = [
  [1, 2], [2, 15], [15, 14], [14, 13], [13, 1], [14, 11], [11, 12], [12, 4], [4, 3],
  [3, 6], [6, 5], [5, 8], [8, 9], [9, 11], [9, 10], [10, 7], [7, 6],
];

/* ผังถูกมองเป็นตารางช่องละหนึ่งหน่วย พิกัดเลื่อนขึ้นหนึ่งเพื่อให้มีวงช่องรอบนอกไว้เป็นทะเล
   ฟังก์ชันนี้คิดสองแบบที่ไม่พึ่งกัน แล้ว throw ถ้าไม่ตรงกัน
   (ก) ปล่อยน้ำตามกติกาในโจทย์ทีละชั่วโมงจริง ๆ
   (ข) BFS แบบ 0-1 บนช่อง แล้วใช้กฎ "ชั่วโมงสองฝั่งเท่ากัน" */
type Flood = {
  wX: number; // จำนวนช่องที่วาดตามแนวนอน (รวมวงทะเล)
  wY: number;
  g: number; // ความกว้างของตารางที่คิดจริง ช่อง (i, j) อยู่ที่ดัชนี i * g + j
  face: number[]; // ผืนของแต่ละช่อง ผืน 0 คือทะเล
  F: number;
  faceHour: number[]; // ชั่วโมงที่น้ำถึงผืน จาก (ข)
  side: Seg[]; // ผืนสองฝั่งของกำแพงแต่ละเส้น
  alive: boolean[]; // จาก (ข)
  fallAt: number[]; // จาก (ก) กำแพงพังตอนชั่วโมงไหน -1 คือยืนอยู่ตลอด
  wetAt: number[]; // จาก (ก) ผืนเปียกตอนชั่วโมงไหน
  lastHour: number;
};

function floodModel(pts: Pt[], walls: Seg[], name: string): Flood {
  const sh = 1;
  const maxX = Math.max(...pts.map((p) => p.x));
  const maxY = Math.max(...pts.map((p) => p.y));
  const g = Math.max(maxX, maxY) + sh + 2;
  const id = (i: number, j: number): number => i * g + j;
  const bh = new Array<number>(g * g).fill(-1); // กำแพงที่คั่นช่อง (i, j-1) กับ (i, j)
  const bv = new Array<number>(g * g).fill(-1); // กำแพงที่คั่นช่อง (i-1, j) กับ (i, j)
  walls.forEach(([a, b], k) => {
    const p = pts[a - 1];
    const q = pts[b - 1];
    if (p.y === q.y) {
      for (let i = Math.min(p.x, q.x) + sh; i < Math.max(p.x, q.x) + sh; i++) bh[id(i, p.y + sh)] = k;
    } else {
      for (let j = Math.min(p.y, q.y) + sh; j < Math.max(p.y, q.y) + sh; j++) bv[id(p.x + sh, j)] = k;
    }
  });
  const nbrs = (u: number): Seg[] => {
    const i = Math.floor(u / g);
    const j = u % g;
    const r: Seg[] = [];
    if (j + 1 < g) r.push([id(i, j + 1), bh[id(i, j + 1)]]);
    if (j > 0) r.push([id(i, j - 1), bh[id(i, j)]]);
    if (i + 1 < g) r.push([id(i + 1, j), bv[id(i + 1, j)]]);
    if (i > 0) r.push([id(i - 1, j), bv[id(i, j)]]);
    return r;
  };

  /* ผืน: ช่องที่เดินถึงกันได้โดยไม่ข้ามกำแพงเลย */
  const face = new Array<number>(g * g).fill(-1);
  let F = 0;
  for (let s = 0; s < g * g; s++) {
    if (face[s] >= 0) continue;
    const st = [s];
    face[s] = F;
    while (st.length > 0) {
      const u = st.pop() as number;
      for (const [v, w] of nbrs(u)) {
        if (w < 0 && face[v] < 0) {
          face[v] = F;
          st.push(v);
        }
      }
    }
    F++;
  }

  /* (ข) BFS แบบ 0-1 บนช่อง */
  const INF = Number.MAX_SAFE_INTEGER;
  const dist = new Array<number>(g * g).fill(INF);
  const dq: number[] = [0];
  dist[0] = 0;
  let head = 0;
  while (head < dq.length) {
    const u = dq[head++];
    for (const [v, w] of nbrs(u)) {
      const c = w >= 0 ? 1 : 0;
      if (dist[u] + c < dist[v]) {
        dist[v] = dist[u] + c;
        if (c === 0) dq.splice(head, 0, v);
        else dq.push(v);
      }
    }
  }
  /* ข้ออ้างของตอนที่ 2: ทุกช่องในผืนเดียวกันได้ชั่วโมงเท่ากัน */
  const faceHour = new Array<number>(F).fill(-1);
  for (let c = 0; c < g * g; c++) {
    if (faceHour[face[c]] < 0) faceHour[face[c]] = dist[c];
    else if (faceHour[face[c]] !== dist[c]) throw new Error(`${name}: ช่องในผืนเดียวกันได้ชั่วโมงไม่เท่ากัน`);
  }
  const side: Seg[] = walls.map(([a, b]) => {
    const p = pts[a - 1];
    const q = pts[b - 1];
    if (p.y === q.y) {
      const x = Math.min(p.x, q.x) + sh;
      return [face[id(x, p.y + sh - 1)], face[id(x, p.y + sh)]];
    }
    const y = Math.min(p.y, q.y) + sh;
    return [face[id(p.x + sh - 1, y)], face[id(p.x + sh, y)]];
  });
  const alive = side.map(([fa, fb]) => faceHour[fa] === faceHour[fb]);

  /* (ก) ปล่อยน้ำทีละชั่วโมงตามโจทย์ ไม่ใช้กฎชั่วโมงเท่ากันเลย */
  const fallAt = new Array<number>(walls.length).fill(-1);
  const wetAt = new Array<number>(F).fill(-1);
  let hour = 0;
  for (;;) {
    const wet = new Array<boolean>(g * g).fill(false);
    const st = [0];
    wet[0] = true;
    while (st.length > 0) {
      const u = st.pop() as number;
      for (const [v, w] of nbrs(u)) {
        if ((w < 0 || fallAt[w] >= 0) && !wet[v]) {
          wet[v] = true;
          st.push(v);
        }
      }
    }
    for (let c = 0; c < g * g; c++) if (wet[c] && wetAt[face[c]] < 0) wetAt[face[c]] = hour;
    const fall = new Set<number>();
    for (let c = 0; c < g * g; c++) {
      for (const [v, w] of nbrs(c)) if (w >= 0 && fallAt[w] < 0 && wet[c] !== wet[v]) fall.add(w);
    }
    if (fall.size === 0) break;
    hour++;
    for (const w of fall) fallAt[w] = hour;
  }
  walls.forEach((_, k) => {
    if (alive[k] !== (fallAt[k] < 0)) throw new Error(`${name}: กำแพง ${k + 1} กฎชั่วโมงเท่ากันไม่ตรงกับการปล่อยน้ำจริง`);
  });
  faceHour.forEach((h, f) => {
    if (wetAt[f] !== h) throw new Error(`${name}: ผืน ${f} ชั่วโมงจาก BFS ไม่ตรงกับการปล่อยน้ำจริง`);
  });
  return { wX: maxX + 2, wY: maxY + 2, g, face, F, faceHour, side, alive, fallAt, wetAt, lastHour: hour };
}

const EX = floodModel(PTS, WALLS, 'ตัวอย่างในโจทย์');
const L = (f: number): string => String.fromCharCode(65 + f);
const ids = (xs: number[]): string => xs.join(', ');
const survivors = WALLS.map((_, k) => k + 1).filter((k) => EX.alive[k - 1]);
const WALL_COUNT = WALLS.length;
const faceNames = Array.from({ length: EX.F }, (_, f) => L(f));

/* กำแพงจับกลุ่มตามคู่ผืนสองฝั่ง กลุ่มเดียวกันได้ผลเหมือนกันเสมอ */
type Group = { fa: number; fb: number; walls: number[]; alive: boolean };
const groups: Group[] = [];
EX.side.forEach(([s0, s1], k) => {
  const fa = Math.min(s0, s1);
  const fb = Math.max(s0, s1);
  const hit = groups.find((x) => x.fa === fa && x.fb === fb);
  if (hit) hit.walls.push(k + 1);
  else groups.push({ fa, fb, walls: [k + 1], alive: EX.alive[k] });
});
groups.sort((a, b) => a.fa - b.fa || a.fb - b.fb);
const sameFaceGroups = groups.filter((x) => x.fa === x.fb);
const tieGroups = groups.filter((x) => x.fa !== x.fb && x.alive);
const fallGroups = groups.filter((x) => !x.alive);
/* ตัวอย่างต้องมีกำแพงครบสามแบบ: รอดเพราะผืนเดียวกัน รอดเพราะชั่วโมงเท่ากัน และพัง */
if (sameFaceGroups.length === 0 || tieGroups.length === 0 || fallGroups.length === 0) {
  throw new Error('ตัวอย่างของ flood-walls ไม่มีกำแพงครบทั้งสามแบบ');
}
const sameG = sameFaceGroups[0];
const tieG = tieGroups[0];
const groupRows = groups.map((gr) => ({
  pair: gr.fa === gr.fb ? `${L(gr.fa)} ทั้งสองฝั่ง` : `${L(gr.fa)} กับ ${L(gr.fb)}`,
  hours: `${EX.faceHour[gr.fa]} กับ ${EX.faceHour[gr.fb]}`,
  walls: ids(gr.walls),
  verdict: gr.alive ? 'รอด' : 'พัง',
}));

/* สเต็ปของเครื่องเดิน: หนึ่งก้าวคือหนึ่งชั่วโมง สร้างจากการปล่อยน้ำจริง (ก) */
type FwStep = { note: string; t: number };
const fwSteps: FwStep[] = [];
for (let t = 0; t <= EX.lastHour; t++) {
  const wet = faceNames.filter((_, f) => EX.wetAt[f] <= t);
  const parts: string[] = [`<b>ชั่วโมง ${t}</b> · เปียกแล้ว: ${wet.join(', ')}`];
  const falling = new Map<string, number[]>();
  EX.fallAt.forEach((h, k) => {
    if (h !== t + 1) return;
    const [s0, s1] = EX.side[k];
    const wf = EX.wetAt[s0] <= t ? s0 : s1;
    const df = wf === s0 ? s1 : s0;
    const key = `${wf}|${df}`;
    falling.set(key, [...(falling.get(key) ?? []), k + 1]);
  });
  for (const [key, ws] of falling) {
    const [wf, df] = key.split('|').map(Number);
    parts.push(`กำแพง ${ids(ws)} มีน้ำฝั่ง ${L(wf)} แต่ฝั่ง ${L(df)} ยังแห้ง พังตอนชั่วโมง ${t + 1}`);
  }
  for (const gr of groups) {
    if (!gr.alive || EX.faceHour[gr.fa] !== t) continue;
    parts.push(
      gr.fa === gr.fb
        ? `กำแพง ${ids(gr.walls)} มี ${L(gr.fa)} ทั้งสองฝั่ง เปียกพร้อมกัน ไม่พัง`
        : `กำแพง ${ids(gr.walls)} คั่น ${L(gr.fa)} กับ ${L(gr.fb)} ซึ่งเปียกพร้อมกันที่ชั่วโมง ${t} ไม่พัง`,
    );
  }
  if (t === EX.lastHour) {
    parts.push(`ไม่มีกำแพงไหนมีน้ำฝั่งเดียวแล้ว น้ำหยุด ยืนอยู่ ${survivors.length} เส้น คือ ${ids(survivors)}`);
  }
  fwSteps.push({ note: parts.join(' · '), t });
}

/* ---------- รูปผังบนตาราง ใช้ทั้งเครื่องเดินและมินิเกม ---------- */
const U = 40;
const MG = 12;
type MapWall = { id: number; x1: number; y1: number; x2: number; y2: number; mx: number; my: number; fall: number };
type MapGeo = { vbW: number; vbH: number; walls: MapWall[]; dots: { x: number; y: number }[] };
function mapGeo(pts: Pt[], walls: Seg[], m: Flood): MapGeo {
  const px = (x: number): number => MG + (x + 1) * U;
  const py = (y: number): number => MG + (m.wY - (y + 1)) * U;
  return {
    vbW: MG + m.wX * U + 12,
    vbH: MG + m.wY * U + 12,
    walls: walls.map(([a, b], k) => {
      const x1 = px(pts[a - 1].x);
      const y1 = py(pts[a - 1].y);
      const x2 = px(pts[b - 1].x);
      const y2 = py(pts[b - 1].y);
      return { id: k + 1, x1, y1, x2, y2, mx: (x1 + x2) / 2, my: (y1 + y2) / 2, fall: m.fallAt[k] };
    }),
    dots: pts.map((p) => ({ x: px(p.x), y: py(p.y) })),
  };
}
const exGeo = mapGeo(PTS, WALLS, EX);
const exCells: { x: number; y: number; h: number }[] = [];
for (let i = 0; i < EX.wX; i++) {
  for (let j = 0; j < EX.wY; j++) {
    exCells.push({ x: MG + i * U, y: MG + (EX.wY - 1 - j) * U, h: EX.faceHour[EX.face[i * EX.g + j]] });
  }
}
const exFaceLabels = faceLabelsOf(EX, exGeo);

/* ---------- มินิเกม ทายว่ากำแพงไหนรอด เฉลยของเกมมาจาก floodModel ที่ตรวจกับการปล่อยน้ำจริงแล้ว ---------- */
type FwLayout = { id: string; label: string; tease: string; pts: Pt[]; walls: Seg[] };
const FW_LAYOUTS: FwLayout[] = [
  {
    id: 'w1',
    label: 'ชุดที่ 1 · ผังเล็ก',
    tease: 'ผังนี้มีห้องปิดหนึ่งห้อง กับกำแพงเดี่ยว ๆ ที่ไม่ได้ล้อมอะไรเลย',
    pts: [
      { x: 1, y: 1 }, { x: 4, y: 1 }, { x: 4, y: 4 }, { x: 1, y: 4 },
      { x: 6, y: 2 }, { x: 9, y: 2 },
    ],
    walls: [[1, 2], [2, 3], [3, 4], [4, 1], [5, 6]],
  },
  { id: 'w2', label: 'ชุดที่ 2 · ผังในโจทย์', tease: 'ผังเดียวกับตัวอย่างในโจทย์ ซึ่งเฉลยจะใช้ทั้งบท', pts: PTS, walls: WALLS },
  {
    id: 'w3',
    label: 'ชุดที่ 3 · ห้องซ้อนห้อง',
    tease: 'ชุดนี้มีห้องเล็กลอยอยู่ในห้องใหญ่ และมีกำแพงเดี่ยวอยู่นอกห้องด้วย',
    pts: [
      { x: 1, y: 1 }, { x: 6, y: 1 }, { x: 6, y: 6 }, { x: 1, y: 6 },
      { x: 3, y: 3 }, { x: 4, y: 3 }, { x: 4, y: 4 }, { x: 3, y: 4 },
      { x: 8, y: 3 }, { x: 11, y: 3 },
    ],
    walls: [[1, 2], [2, 3], [3, 4], [4, 1], [5, 6], [6, 7], [7, 8], [8, 5], [9, 10]],
  },
];
const fwModels = FW_LAYOUTS.map((l) => floodModel(l.pts, l.walls, l.label));
type FwPuzzleData = { id: string; label: string; tease: string; walls: { id: number; alive: boolean }[]; aliveCount: number };
const fwPuzzles: FwPuzzleData[] = FW_LAYOUTS.map((l, k) => ({
  id: l.id,
  label: l.label,
  tease: l.tease,
  walls: l.walls.map((_, w) => ({ id: w + 1, alive: fwModels[k].alive[w] })),
  aliveCount: fwModels[k].alive.filter(Boolean).length,
}));
const fwBoards = FW_LAYOUTS.map((l, k) => mapGeo(l.pts, l.walls, fwModels[k]));
const fwJson = JSON.stringify(fwPuzzles);

/* ---------- ตอนที่ 3: บีบพิกัดของตัวอย่าง แล้วตรวจว่ากำแพงที่รอดเป็นชุดเดิม ---------- */
const rankOf = (vals: number[]): { s: number[]; r: (v: number) => number } => {
  const s = [...new Set(vals)].sort((a, b) => a - b);
  return { s, r: (v: number): number => s.indexOf(v) + 1 };
};
const sqX = rankOf(PTS.map((p) => p.x));
const sqY = rankOf(PTS.map((p) => p.y));
const SQ = floodModel(PTS.map((p) => ({ x: sqX.r(p.x), y: sqY.r(p.y) })), WALLS, 'ตัวอย่างหลังบีบพิกัด');
if (SQ.alive.join(',') !== EX.alive.join(',')) throw new Error('บีบพิกัดแล้วกำแพงที่รอดเปลี่ยน');
/* ขนาดตารางตามสูตรในโค้ดตอนที่ 2/3: พิกัดดิบใช้ (พิกัดสูงสุด + 3)² ช่อง บีบแล้วใช้ (จำนวนค่าที่ต่างกัน + 2)² ช่อง */
const rawG = Math.max(...PTS.flatMap((p) => [p.x, p.y])) + 3;
const sqG = Math.max(sqX.s.length, sqY.s.length) + 2;
if (sqG >= rawG) throw new Error('ตัวอย่างบีบแล้วต้องเล็กลง');

/* ---------- ตอนที่ 5: ก้อนที่ลอยอยู่ในห้อง ----------
   ก้อนนอกคือห้องใหญ่ (กำแพง 1 ถึง 4) ก้อนในคือโดมิโนสองห้อง (กำแพง 5 ถึง 11) ลอยอยู่ในห้องใหญ่
   กำแพงกลางโดมิโนต้องรอด เพื่อให้ตัวอย่างโชว์ว่าการเลื่อนชั่วโมงไม่ทำให้กำแพงที่รอดกลายเป็นพัง */
const NEST_PTS: Pt[] = [
  { x: 1, y: 1 }, { x: 8, y: 1 }, { x: 8, y: 6 }, { x: 1, y: 6 },
  { x: 3, y: 3 }, { x: 5, y: 3 }, { x: 7, y: 3 }, { x: 7, y: 5 }, { x: 5, y: 5 }, { x: 3, y: 5 },
];
const NEST_WALLS: Seg[] = [
  [1, 2], [2, 3], [3, 4], [4, 1],
  [5, 6], [6, 7], [7, 8], [8, 9], [9, 10], [10, 5], [6, 9],
];
const NEST_INNER_FROM = 4; // กำแพงที่ 5 เป็นต้นไปและจุดที่ 5 เป็นต้นไปคือก้อนใน
const NM = floodModel(NEST_PTS, NEST_WALLS, 'ผังก้อนลอย');
const nestInnerWalls: Seg[] = NEST_WALLS.slice(NEST_INNER_FROM).map(([a, b]) => [a - NEST_INNER_FROM, b - NEST_INNER_FROM]);
const NI = floodModel(NEST_PTS.slice(NEST_INNER_FROM), nestInnerWalls, 'ก้อนในคิดแยก');
const nestRows = nestInnerWalls.map((_, k) => {
  const real = NM.side[NEST_INNER_FROM + k].map((f) => NM.faceHour[f]);
  const alone = NI.side[k].map((f) => NI.faceHour[f]);
  return { id: NEST_INNER_FROM + k + 1, real, alone, alive: NM.alive[NEST_INNER_FROM + k] };
});
const nestShift = nestRows[0].real[0] - nestRows[0].alone[0];
for (const r of nestRows) {
  if (r.real[0] - r.alone[0] !== nestShift || r.real[1] - r.alone[1] !== nestShift) throw new Error('ก้อนใน: ชั่วโมงไม่ได้เลื่อนเท่ากันทั้งก้อน');
  if ((r.alone[0] === r.alone[1]) !== r.alive) throw new Error('ก้อนใน: คิดแยกแล้วผลรอดหรือพังเปลี่ยน');
}
const nestRoom = NM.side[0].find((f) => f !== 0) ?? 0; // ห้องใหญ่ คือผืนอีกฝั่งของกำแพง 1
