    vector<int> ans; for(int e=1;e<=w;e++) if(!down[e]) ans.push_back(e);
    printf("%d\\n",(int)ans.size());
    for(int e:ans) printf("%d\\n",e);
}`;

/* ---------- รูปผังนิ่ง (ใช้ใน ZoomableDiagram จึงต้องใส่สีเป็น attribute ทั้งหมด) ---------- */
const FACE_FILL = ['#0e2033', '#1d2b45', '#2a2442', '#1e3a3c', '#3a2f22', '#22303f'];
type LabelPos = { name: string; x: number; y: number };
function faceLabelsOf(m: Flood, geo: MapGeo): LabelPos[] {
  return Array.from({ length: m.F }, (_, f) => {
    let best = { x: 0, y: 0, key: [-1, -1, -1] };
    for (let i = 0; i < m.wX; i++) {
      for (let j = 0; j < m.wY; j++) {
        if (m.face[i * m.g + j] !== f) continue;
        const cx = MG + i * U + U / 2;
        const cy = MG + (m.wY - 1 - j) * U + U / 2;
        const clear = Math.min(...geo.walls.map((w) => Math.hypot(w.mx - cx, w.my - cy)));
        let depth = 1e9;
        for (let a = 0; a < m.wX; a++) {
          for (let b = 0; b < m.wY; b++) {
            if (m.face[a * m.g + b] !== f) depth = Math.min(depth, Math.max(Math.abs(a - i), Math.abs(b - j)));
          }
        }
        const key = [clear >= U * 0.8 ? 1 : 0, depth, clear];
        const d = key[0] - best.key[0] || key[1] - best.key[1] || key[2] - best.key[2];
        if (d > 0) best = { x: cx, y: cy, key };
      }
    }
    return { name: L(f), x: best.x, y: best.y + 5 };
  });
}
type StaticMap = {
  geo: MapGeo;
  cells: { x: number; y: number; fill: string }[];
  labels: LabelPos[];
  ptLabels: { x: number; y: number; t: string }[];
};
function staticMap(pts: Pt[], walls: Seg[], m: Flood, withPointNumbers: boolean): StaticMap {
  const geo = mapGeo(pts, walls, m);
  const cells: StaticMap['cells'] = [];
  for (let i = 0; i < m.wX; i++) {
    for (let j = 0; j < m.wY; j++) {
      cells.push({ x: MG + i * U, y: MG + (m.wY - 1 - j) * U, fill: FACE_FILL[m.face[i * m.g + j] % FACE_FILL.length] });
    }
  }
  const labels = faceLabelsOf(m, geo);
  /* เลขจุด: เลือกมุมเฉียงที่ไกลป้ายเลขกำแพงกับป้ายผืนที่สุด */
  const ptLabels = withPointNumbers
    ? geo.dots.map((d, k) => {
        const opts = [[1, -1], [-1, -1], [1, 1], [-1, 1]].map(([sx, sy]) => {
          const x = d.x + sx * 11;
          const y = d.y + sy * 11;
          const clear = Math.min(
            ...geo.walls.map((w) => Math.hypot(w.mx - x, w.my - y)),
            ...labels.map((l) => Math.hypot(l.x - x, l.y - 5 - y)),
          );
          return { x, y: y + 4, clear };
        });
        opts.sort((a, b) => b.clear - a.clear);
        return { x: opts[0].x, y: opts[0].y, t: String(k + 1) };
      })
    : [];
  return { geo, cells, labels, ptLabels };
}
const exMap = staticMap(PTS, WALLS, EX, true);
const nestMap = staticMap(NEST_PTS, NEST_WALLS, NM, false);
const nestFaceNames = Array.from({ length: NM.F }, (_, f) => L(f));
const nestInnerRooms = nestFaceNames.filter((_, f) => f !== 0 && f !== nestRoom);

/* ---------- ตอนที่ 4: เดินรอบหน้าด้วยครึ่งเส้น แบบเดียวกับโค้ดเต็ม ---------- */
const DIR = ['ตะวันออก', 'เหนือ', 'ตะวันตก', 'ใต้'];
const TURN = ['ย้อนกลับ', 'เลี้ยวขวา', 'ไปตรง', 'เลี้ยวซ้าย']; // ดัชนี k ของลูป k = 3..0 ในโค้ด
type WalkStep = { u: number; v: number; head: string; turn: string; term: number; a: number; b: number };
type Walk = { steps: WalkStep[]; area2: number };
function faceWalks(pts: Pt[], walls: Seg[]): Walk[] {
  const out = Array.from({ length: pts.length + 1 }, () => [-1, -1, -1, -1]);
  const heTo: number[] = [];
  const heDir: number[] = [];
  walls.forEach(([a, b], e) => {
    const p = pts[a - 1];
    const q = pts[b - 1];
    const d = p.y === q.y ? (q.x > p.x ? 0 : 2) : q.y > p.y ? 1 : 3;
    heTo[2 * e] = b;
    heDir[2 * e] = d;
    out[a][d] = 2 * e;
    heTo[2 * e + 1] = a;
    heDir[2 * e + 1] = d ^ 2;
    out[b][d ^ 2] = 2 * e + 1;
  });
  const seen = new Array<boolean>(2 * walls.length).fill(false);
  const res: Walk[] = [];
  for (let s = 0; s < 2 * walls.length; s++) {
    if (seen[s]) continue;
    const steps: WalkStep[] = [];
    let h = s;
    do {
      seen[h] = true;
      const u = heTo[h ^ 1];
      const v = heTo[h];
      const a = pts[u - 1].x * pts[v - 1].y;
      const b = pts[v - 1].x * pts[u - 1].y;
      const back = heDir[h] ^ 2;
      let nxt = -1;
      let turn = '';
      for (let k = 3; k >= 0; k--) {
        const dd = (back + k) % 4;
        if (out[v][dd] >= 0) {
          nxt = out[v][dd];
          turn = TURN[k];
          break;
        }
      }
      steps.push({ u, v, head: DIR[heDir[h]], turn, term: a - b, a, b });
      h = nxt;
    } while (h !== s);
    res.push({ steps, area2: steps.reduce((t, x) => t + x.term, 0) });
  }
  return res;
}
const exWalks = faceWalks(PTS, WALLS);
const exRooms = exWalks.filter((w) => w.area2 > 0);
const exOuters = exWalks.filter((w) => w.area2 <= 0);
/* ตัวอย่างเป็นก้อนเดียว จำนวนห้องจากการเดินต้องเท่ากับจำนวนผืนในตารางลบทะเล */
if (exRooms.length !== EX.F - 1 || exOuters.length !== 1) throw new Error('การเดินรอบหน้าของตัวอย่างไม่ตรงกับผืนในตาราง');
/* เดินห้องที่เล็กที่สุดให้ดูเป็นตัวอย่าง แล้วหาว่ามันคือผืนไหนในตอนที่ 1 */
const walkShow = [...exRooms].sort((a, b) => a.steps.length - b.steps.length || a.area2 - b.area2)[0];
const wallIdOf = (u: number, v: number): number => WALLS.findIndex(([a, b]) => (a === u && b === v) || (a === v && b === u)) + 1;
const walkWalls = walkShow.steps.map((st) => wallIdOf(st.u, st.v));
const walkFaceCands = Array.from({ length: EX.F }, (_, f) => f).filter((f) => walkWalls.every((w) => EX.side[w - 1].includes(f)) && f !== 0);
if (walkFaceCands.length !== 1) throw new Error('หาผืนของห้องที่เดินโชว์ไม่ได้');
const walkFace = L(walkFaceCands[0]);
if (walkShow.steps.length < 4) throw new Error('ห้องที่โชว์ต้องมีอย่างน้อยสี่ก้าว');
const exOuterArea2 = exOuters[0].area2;
const walkFaceCells = EX.face.filter((f, c) => f === walkFaceCands[0] && Math.floor(c / EX.g) < EX.wX && c % EX.g < EX.wY).length;
if (walkFaceCells * 2 !== walkShow.area2) throw new Error('ผลรวมของห้องที่เดินโชว์ต้องเป็นสองเท่าของจำนวนช่องในผืนนั้น');
/* สูตรเชือกผูกรองเท้าบนห้องเล็กที่สุดที่คิดในหัวได้: ห้องสี่เหลี่ยมของชุดที่ 1 */
const sqWalks = faceWalks(FW_LAYOUTS[0].pts.slice(0, 4), FW_LAYOUTS[0].walls.slice(0, 4));
const sqRoom = sqWalks.find((w) => w.area2 > 0);
const sqOuter = sqWalks.find((w) => w.area2 < 0);
if (!sqRoom || !sqOuter || sqRoom.area2 !== -sqOuter.area2) throw new Error('ห้องสี่เหลี่ยม: ห้องกับขอบนอกต้องได้ค่าตรงข้ามกัน');
const sqSide = FW_LAYOUTS[0].pts[1].x - FW_LAYOUTS[0].pts[0].x;
if (sqRoom.area2 !== 2 * sqSide * sqSide) throw new Error('ห้องสี่เหลี่ยม: สูตรไม่ได้สองเท่าของพื้นที่');
const wallLone = faceWalks(FW_LAYOUTS[0].pts.slice(4), [[1, 2]]);
if (wallLone.length !== 1 || wallLone[0].area2 !== 0) throw new Error('กำแพงเส้นเดียวต้องได้ศูนย์');

/* แผนที่ของโค้ดเต็ม: ส่วนไหนอธิบายอยู่ตอนไหน */
