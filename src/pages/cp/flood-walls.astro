  svg.fwboard .fww.wrong circle{stroke:#e07a7a;stroke-width:3;}

  @media (max-width:640px){
    svg.fwmap, svg.fwboard{min-width:420px;}
  }

  /* ---------- ปุ่มกำแพงของมินิเกม (สร้างด้วย JS จึงต้อง :global) ---------- */
  .cpg-controls :global(.fw-wall.picked){background:var(--dl-emerald-bright);border-color:var(--dl-emerald-bright);color:#0b1220;font-weight:700;}
  .cpg-controls :global(.fw-wall.right){outline:2px solid #2f9e5c;outline-offset:2px;}
  .cpg-controls :global(.fw-wall.wrong){outline:2px solid #8a3b3b;outline-offset:2px;}
</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type FwWall = { id: number; alive: boolean };
  type FwPuzzle = { id: string; label: string; tease: string; walls: FwWall[]; aliveCount: number };

  const IDLE = 'กดเลือกกำแพงที่คิดว่าจะรอด (ที่เส้นในรูปหรือที่ปุ่ม) แล้วกดตรวจ กำแพงที่ไม่ได้เลือกคือกำแพงที่คิดว่าจะพัง';

  function initFloodGame(): void {
    const maybeUi = cpGameUi('[data-fwgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as FwPuzzle[];
    if (puzzles.length === 0) return;

    const listEl = ui.root.querySelector<HTMLElement>('[data-fw-list]');
    const pickedEl = ui.root.querySelector<HTMLElement>('[data-fw-picked]');
    const totalEl = ui.root.querySelector<HTMLElement>('[data-fw-total]');
    if (!listEl || !pickedEl || !totalEl) return;
    const list: HTMLElement = listEl;
    const pickedOut: HTMLElement = pickedEl;
    const totalOut: HTMLElement = totalEl;
    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-fw-board]'));

    let pi = 0;
    let guess = new Set<number>();
    let revealed = false;

    const pz = (): FwPuzzle => puzzles[pi];

    function buildList(): void {
      list.textContent = '';
      for (const w of pz().walls) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cpg-btn fw-wall';
        b.dataset.wall = String(w.id);
        b.textContent = `กำแพง ${w.id}`;
        list.appendChild(b);
      }
    }

    /* ปุ่มในรายการกับเส้นบนกระดานที่กำลังเปิดอยู่ ถูกระบายจากสถานะชุดเดียวกัน */
    function wallNodes(): Element[] {
      const board = boards[pi];
      return [
        ...Array.from(list.querySelectorAll('[data-wall]')),
        ...(board ? Array.from(board.querySelectorAll('[data-wall]')) : []),
      ];
    }

    function render(): void {
      const p = pz();
      for (const el of wallNodes()) {
        const id = Number(el.getAttribute('data-wall'));
        const w = p.walls.find((x) => x.id === id);
        el.classList.toggle('picked', guess.has(id));
        el.classList.toggle('right', revealed && w !== undefined && guess.has(id) === w.alive);
        el.classList.toggle('wrong', revealed && w !== undefined && guess.has(id) !== w.alive);
      }
      pickedOut.textContent = String(guess.size);
      totalOut.textContent = String(p.walls.length);
    }

    function check(): void {
      const p = pz();
      let right = 0;
      for (const w of p.walls) if (guess.has(w.id) === w.alive) right++;
      revealed = true;
      render();
      if (right === p.walls.length) {
        ui.setStatus(`ถูกทั้ง ${p.walls.length} เส้นครับ กำแพงที่รอดมี ${p.aliveCount} เส้น`, 'good');
      } else {
        ui.setStatus(
          `ถูก ${right} จาก ${p.walls.length} เส้น เส้นที่ทายพลาดถูกวงสีแดงไว้แล้ว ลองดูว่าน้ำสองข้างของมันมาถึงพร้อมกันไหม`,
          'bad',
        );
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      guess = new Set<number>();
      revealed = false;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      boards.forEach((b, i) => {
        b.hidden = i !== k;
      });
      buildList();
      ui.setStatus(IDLE);
      render();
    }

    ui.root.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const b = e.target.closest('[data-wall]');
      if (!b || !ui.root.contains(b)) return;
      const id = Number(b.getAttribute('data-wall'));
      if (guess.has(id)) guess.delete(id);
      else guess.add(id);
      revealed = false;
      ui.setStatus(IDLE);
      render();
    });

    ui.onClick('data-fw-clear', () => selectPuzzle(pi));
    ui.onClick('data-fw-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initFloodGame);
</script>

<script>
  import { initCpPlayers } from '../../lib/cpPlayer';

  type FwStep = { note: string; t: number };
  function isStep(x: unknown): x is FwStep {
    if (typeof x !== 'object' || x === null) return false;
    const r = x as Record<string, unknown>;
    return typeof r.note === 'string' && typeof r.t === 'number';
  }

  document.addEventListener('astro:page-load', () => {
    initCpPlayers<FwStep>('[data-fwsim]', {
      narrow: (raw) => {
        const ok = raw.filter(isStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      countWord: 'ชั่วโมง',
      zeroBased: true,
      draw: (st, ctx) => {
        const root = ctx.parts.root;
        const last = ctx.at === ctx.total - 1;
        root.querySelectorAll('[data-h]').forEach((c) => {
          c.classList.toggle('wet', Number(c.getAttribute('data-h')) <= st.t);
        });
        root.querySelectorAll('[data-fall]').forEach((g) => {
          const f = Number(g.getAttribute('data-fall'));
          g.classList.toggle('down', f >= 1 && f <= st.t);
          g.classList.toggle('next', f === st.t + 1);
          g.classList.toggle('keep', last && f < 0);
        });
      },
    });
  });
</script>
