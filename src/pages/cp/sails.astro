---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const href = 'sails/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Mast = { h: number; k: number };
const MASTS: Mast[] = [
  { h: 3, k: 2 },
  { h: 5, k: 3 },
  { h: 4, k: 1 },
  { h: 2, k: 1 },
  { h: 4, k: 3 },
  { h: 3, k: 2 },
];
const MAXH = Math.max(...MASTS.map((m) => m.h));

const cost = (cnt: number[]): number => cnt.reduce((a, c) => a + (c * (c - 1)) / 2, 0);

/** เดินตามท่าโลภ: ใส่ใบเรือลงระดับที่ตอนนี้ว่างที่สุด โดยไล่จากเสาเตี้ยไปเสาสูง */
type GreedyStep = { i: number; mast: Mast; picked: number[]; after: number[]; cost: number };
/** sortFirst = false คือไล่ตามลำดับที่ให้มา ใช้โชว์ว่าลำดับเตี้ยไปสูงจำเป็นจริง */
function greedy(masts: Mast[], sortFirst = true): GreedyStep[] {
  const sorted = sortFirst ? [...masts].sort((a, b) => a.h - b.h) : [...masts];
  const cnt = new Array<number>(Math.max(...masts.map((m) => m.h))).fill(0);
  const steps: GreedyStep[] = [];
  sorted.forEach((m, i) => {
    const idx = Array.from({ length: m.h }, (_, j) => j);
    // เรียงตามค่าน้อยไปมาก ค่าเท่ากันเอาระดับล่างก่อน (นี่คือกฎเสมอที่สำคัญมาก)
    idx.sort((a, b) => cnt[a] - cnt[b] || a - b);
    const picked = idx.slice(0, m.k).sort((a, b) => a - b);
    for (const p of picked) cnt[p]++;
    steps.push({ i: i + 1, mast: m, picked: picked.map((p) => p + 1), after: [...cnt], cost: cost(cnt) });
  });
  return steps;
}
const steps = greedy(MASTS);
const answer = steps[steps.length - 1].cost;

/* ---------- สเต็ปของเครื่องเดินทีละขั้น ----------
   หนึ่งขั้นคือใส่ใบเรือของเสาหนึ่งต้น ทุกค่าที่ขั้นนั้นแสดงมาจาก greedy() ตัวเดียวกับที่หน้านี้ใช้
   คำอธิบายก็ประกอบจากค่าจริงของขั้นนั้น จึงไม่มีทางเล่าไม่ตรงกับตัวเลขที่เห็น */
interface SailStep {
  i: number;
  h: number;
  k: number;
  picked: number[];
  after: number[];
  cost: number;
  gain: number;
  note: string;
}
const sailSteps: SailStep[] = steps.map((st, idx) => {
  const before = idx === 0 ? new Array<number>(MAXH).fill(0) : steps[idx - 1].after;
  const gain = st.cost - (idx === 0 ? 0 : steps[idx - 1].cost);
  const lowest = Math.min(...before.slice(0, st.mast.h));
  return {
    i: st.i,
    h: st.mast.h,
    k: st.mast.k,
    picked: st.picked,
    after: [...st.after],
    cost: st.cost,
    gain,
    note:
      `เสาต้นที่ <b>${st.i}</b> สูง <b>${st.mast.h}</b> ต้องใส่ใบ <b>${st.mast.k}</b> ใบ ` +
      `ระดับที่มันเอื้อมถึงคือ 1 ถึง <b>${st.mast.h}</b> และตอนนี้ระดับที่มีใบน้อยที่สุดในนั้นมีอยู่ <b>${lowest}</b> ใบ ` +
      `จึงหย่อนลงระดับ <b>${st.picked.join(', ')}</b> ` +
      (gain === 0
        ? 'รอบนี้ไม่มีใบไหนไปเจอเพื่อนร่วมระดับ จึงยังไม่เสียแต้มเพิ่ม'
        : `ทำให้เกิดคู่ใหม่ เสียแต้มเพิ่ม <em>${gain}</em> รวมเป็น <em>${st.cost}</em>`),
  };
});

/* ---------- ภาพผลลัพธ์ของท่าโลภ ----------
   จำนวนใบเรือของแต่ละระดับมาจาก steps ตัวสุดท้าย คือสภาพหลังวางครบทุกเสา
   แต้มที่เสียของแต่ละระดับคิดด้วย c(c-1)/2 สูตรเดียวกับ cost() ที่หน้านี้ใช้ */
const finalCnt = steps[steps.length - 1].after;
const pairCost = (c: number): number => (c * (c - 1)) / 2;
const maxCnt = Math.max(...finalCnt, 1);
const SQ = 26;
const SQGAP = 5;
const ROW_H = 34;
const LEFT = 86;
const sqX = (j: number): number => LEFT + j * (SQ + SQGAP);
const rowY = (level: number): number => 44 + (MAXH - level) * ROW_H;
const COSTX = sqX(maxCnt) + 16;
const sailsVB = `0 0 ${COSTX + 69} ${rowY(1) + ROW_H + 59}`;
/** เสาที่เตี้ยที่สุดกับสูงที่สุด ใช้บอกว่าระดับล่างถูกทุกเสาแย่งกัน */
const sortedMasts = [...MASTS].sort((a, b) => a.h - b.h);


/* ---------- มินิเกม วางใบเรือเอง ----------
   ชุดโจทย์เลือกมาให้กดดันคนละจุด และคำตอบที่ดีที่สุดของทุกชุด
   คำนวณด้วยการไล่ทุกวิธีจัดจริง ๆ ตอนบิลด์ แล้วเทียบกับท่าโลภ
   ถ้าสองอย่างไม่ตรงกันเมื่อไร บิลด์จะพังทันที ไม่ปล่อยให้เกมสอนเลขผิด */
type GamePuzzle = { id: string; label: string; tease: string; masts: Mast[] };
const GAME_PUZZLES: GamePuzzle[] = [
  {
    id: 'g1',
    label: 'ชุดที่ 1 · อุ่นเครื่อง',
    tease: 'สามเสาเตี้ย ๆ พอให้จับทางว่าอะไรทำให้เสียแต้ม',
    masts: [
      { h: 2, k: 1 },
      { h: 3, k: 2 },
      { h: 3, k: 1 },
    ],
  },
  {
    id: 'g2',
    label: 'ชุดที่ 2 · ตัวอย่างในโจทย์',
    tease: 'ชุดเดียวกับที่บทความใช้เดินให้ดูทีละเสา',
    masts: MASTS,
  },
  {
    id: 'g3',
    label: 'ชุดที่ 3 · กับดักเสาสูง',
    tease: 'ชุดนี้ลงโทษคนที่รีบวางเสาสูงก่อน ลองวางตามใจดูแล้วเทียบแต้ม',
    masts: [
      { h: 5, k: 4 },
      { h: 2, k: 2 },
      { h: 2, k: 2 },
      { h: 5, k: 1 },
    ],
  },
];

/** ไล่ทุกวิธีจัดจริง ๆ เพื่อหาแต้มที่ดีที่สุด ใช้ได้เฉพาะชุดเล็กในเกม */
function bestByBrute(masts: Mast[]): number {
  const maxh = Math.max(...masts.map((m) => m.h));
  let best = Number.POSITIVE_INFINITY;
  const cnt = new Array<number>(maxh).fill(0);
  const combos = (h: number, k: number): number[][] => {
    const out: number[][] = [];
    const pick = (start: number, acc: number[]): void => {
      if (acc.length === k) {
        out.push([...acc]);
        return;
      }
      for (let j = start; j < h; j++) {
        acc.push(j);
        pick(j + 1, acc);
        acc.pop();
      }
    };
    pick(0, []);
    return out;
  };
  const choices = masts.map((m) => combos(m.h, m.k));
  const walk = (i: number): void => {
    if (i === masts.length) {
      best = Math.min(best, cost(cnt));
      return;
    }
    for (const c of choices[i]) {
      for (const p of c) cnt[p]++;
      walk(i + 1);
      for (const p of c) cnt[p]--;
    }
  };
  walk(0);
  return best;
}

type GamePuzzleData = {
  id: string;
  label: string;
  tease: string;
  masts: Mast[];
  maxh: number;
  best: number;
};
const gamePuzzles: GamePuzzleData[] = GAME_PUZZLES.map((p) => {
  const brute = bestByBrute(p.masts);
  const viaGreedy = greedy(p.masts)[p.masts.length - 1].cost;
  if (brute !== viaGreedy) {
    throw new Error(
      `มินิเกมของ sails: ชุด ${p.id} ท่าโลภได้ ${viaGreedy} แต่การไล่ทุกวิธีได้ ${brute}`,
    );
  }
  return {
    id: p.id,
    label: p.label,
    tease: p.tease,
    masts: p.masts,
    maxh: Math.max(...p.masts.map((m) => m.h)),
    best: brute,
  };
});
const gameJson = JSON.stringify(gamePuzzles);

/* ---------- ลำดับเตี้ยไปสูงจำเป็นจริง ----------
   ชุดที่ 3 ของเกมคือเคสที่ถ้าไล่เสาตามลำดับที่ให้มา (เสาสูงก่อน) จะเสียแต้มมากกว่า */
const G3 = GAME_PUZZLES[2].masts;
const g3Sorted = greedy(G3)[G3.length - 1].cost;
const g3TallFirst = greedy(G3, false)[G3.length - 1].cost;
if (g3TallFirst <= g3Sorted || g3Sorted !== bestByBrute(G3)) {
  throw new Error(`sails: ชุดที่ 3 ควรลงโทษการไล่เสาสูงก่อน แต่ได้ ${g3TallFirst} เทียบ ${g3Sorted}`);
}

/**
 * จำลองโค้ด C++ แบบ "เติมเป็นช่วง" ทีละบรรทัด รวมการค้นแบบไบนารีสองรอบด้วย
 * headRule = true คือหยิบหัวบล็อกที่ค่าเสมอกัน (โค้ดจริง) ส่วน false คือหยิบท้ายบล็อก (โค้ดรอบแรกที่ผิด)
 * เรียงเสาแบบเดียวกับ sort ของ pair ใน C++ คือสูงก่อนแล้วค่อย K
 * ตรวจแล้วว่าตอบตรงกับ sails_wrong.cpp ที่คอมไพล์จริงทุกชุดที่ไล่ครบ
 */
type RangeTrace = { v: number; l: number; r: number };
function rangeRun(
  masts: Mast[],
  headRule: boolean,
): { cost: number; after: number[][]; trace: RangeTrace[]; placed: number } {
  const maxh = Math.max(...masts.map((m) => m.h));
  const a = new Array<number>(maxh + 2).fill(0);
  const after: number[][] = [];
  const trace: RangeTrace[] = [];
  for (const m of [...masts].sort((x, y) => x.h - y.h || x.k - y.k)) {
    const v = a[m.h - m.k + 1];
    let lo = 1;
    let hi = m.h;
    let l = m.h + 1;
    while (lo <= hi) {
      const md = (lo + hi) >> 1;
      if (a[md] <= v) {
        l = md;
        hi = md - 1;
      } else lo = md + 1;
    }
    lo = 1;
    hi = m.h;
    let r = 0;
    while (lo <= hi) {
      const md = (lo + hi) >> 1;
      if (a[md] >= v) {
        r = md;
        lo = md + 1;
      } else hi = md - 1;
    }
    for (let i = r + 1; i <= m.h; i++) a[i]++;
    const k2 = m.k - (m.h - r);
    if (k2 > 0) {
      const from = headRule ? l : r - k2 + 1;
      if (from < 1) throw new Error('sails: rangeRun เติมช่วงที่เริ่มก่อนระดับ 1');
      for (let i = from; i <= from + k2 - 1; i++) a[i]++;
    }
    trace.push({ v, l, r });
    after.push(a.slice(1, maxh + 1));
  }
  const fin = after[after.length - 1];
  return { cost: cost(fin), after, trace, placed: fin.reduce((s, c) => s + c, 0) };
}
const good = rangeRun(MASTS, true);
const bad = rangeRun(MASTS, false);
const isSorted = (row: number[]): boolean => row.every((v, i) => i === 0 || row[i - 1] >= v);
if (good.cost !== answer || good.after.some((row, i) => row.join() !== steps[i].after.join())) {
  throw new Error('sails: โค้ดเติมเป็นช่วงไม่ตรงกับท่าโลภแบบนับตรงบนตัวอย่าง');
}
const badFirstBreak = bad.after.findIndex((row) => !isSorted(row));
if (badFirstBreak < 0) throw new Error('sails: กฎหยิบท้ายบล็อกควรทำให้อาเรย์เลิกเรียงบนตัวอย่าง');
const badFirstRow = bad.after[badFirstBreak].join(' ');
const brokenSnippet = `int below = H - r;                     // ระดับที่ค่าน้อยกว่า v อยู่ท้ายสุด ใส่ก่อนทั้งหมด
range(r + 1, H, 1);
int k2 = K - below;
if (k2 > 0) range(r - k2 + 1, r, 1);   // <-- บรรทัดที่ผิด หยิบจากท้ายบล็อก
                                       // ของจริงคือ range(l, l + k2 - 1, 1)`;
const BROKEN_MASTS: Mast[] = [
  { h: 2, k: 1 },
  { h: 2, k: 1 },
];
const brokenInput =
  BROKEN_MASTS.length + '\n' + BROKEN_MASTS.map((m) => m.h + ' ' + m.k).join('\n');
const brokenTrue = bestByBrute(BROKEN_MASTS);
const brokenRun = rangeRun(BROKEN_MASTS, false);
const brokenWrong = brokenRun.cost;
const brokenAfterFirst = brokenRun.after[0].join(' ');
const brokenAfterLast = brokenRun.after[brokenRun.after.length - 1].join(' ');
const brokenSecond = brokenRun.trace[1];
const brokenNeed = BROKEN_MASTS.reduce((s, m) => s + m.k, 0);
const goodAfterFirst = rangeRun(BROKEN_MASTS, true).after[0].join(' ');
/* เรื่องที่หน้าเล่า: ก้าวที่สองค้นไม่เจอระดับที่มีค่า v (r = 0) จึงแขวนทุกระดับ ได้ใบเกินจำนวนจริง */
if (brokenWrong === brokenTrue || brokenSecond.r !== 0 || brokenRun.placed <= brokenNeed) {
  throw new Error('sails: เคสตัวอย่างของบักกฎเสมอไม่ได้พังแบบที่หน้าเล่าแล้ว ต้องแก้คำอธิบาย');
}

const NMAX = 100000;
const HMAX = 100000;
const fmt = (n: number): string => n.toLocaleString('en-US');

/* ---------- ตัวเลขที่วัดจากโค้ดที่หน้านี้ส่งจริง (WSL, g++ 11.4 -O2) ----------
   วัดนอกหน้าเว็บ จึงพิมพ์ไว้เป็นค่าคงที่ ส่วนจำนวนก้าวข้างล่างคิดจากโค้ด */
const T_BIT_MS = 80; // N = 100,000 H สุ่มถึง 100,000 สามรอบ 70 ถึง 80 ms
const MEM_BIT_MB = 5; // สูงสุดราว 4.9 MB
const PQ_SUMK = 25032928; // N = 100,000 H สุ่มถึง 1,000 ผลรวม K
const T_PQ_S = '1.62';
const SUB_WAYS = 762048; // เสา 10/5, 10/5, 4/2, 2/1
const T_SUB_S = '0.02';
const STRESS_ROUNDS = 500; // สุ่มเสา 2 ถึง 5 ต้น สูงไม่เกิน 5
const EXH_CASES = 3860; // ทุกชุดเสา 2 ถึง 4 ต้น สูงไม่เกิน 5 (ไม่สนลำดับเสา)
const EXH_WRONG = 2299;
/* log2 ของความสูง ปัดขึ้น: จำนวนชั้นที่ BIT กับคิวต้องเดิน */
const LOG_H = Math.ceil(Math.log2(HMAX + 1));
/* นับตามที่ sails.cpp ทำ แต่ละ at()/upd เดินไม่เกิน LOG_H ชั้น
   ต่อเสา: ค้นไบนารี 2 รอบ รอบละ LOG_H ครั้ง ครั้งละ at() 1 ครั้ง = 2 LOG_H^2
           + at() หา v 1 ครั้ง + range() 2 ครั้ง ครั้งละ upd 2 ครั้ง = 5 LOG_H
   บวกการเรียงเสา N log N และลูปรวมแต้มท้าย at() ทุกระดับ = H log H
   ใช้ log2 ของ N กับ H แยกกัน (ที่ขอบเขตเต็มทั้งคู่คือ 17) */
const LOG_N = Math.ceil(Math.log2(NMAX + 1));
const BIT_STEPS =
  NMAX * (2 * LOG_H * LOG_H + 5 * LOG_H) + NMAX * LOG_N + HMAX * LOG_H;
/* คิว: ใบละ pop หนึ่งครั้ง push หนึ่งครั้ง ครั้งละ LOG_H ชั้น ผลรวม K มากสุดคือ N x H */
const PQ_STEPS = 2 * NMAX * HMAX * LOG_H;
const millions = (n: number): string => fmt(Math.round(n / 1e6));

/* ---------- ทดสอบตัวเอง ข้อ 1 ---------- */
const QUIZ1: Mast[] = [
  { h: 3, k: 2 },
  { h: 3, k: 2 },
  { h: 3, k: 2 },
];
const quiz1Cnt = greedy(QUIZ1)[QUIZ1.length - 1].after;
const quiz1 = cost(quiz1Cnt);
if (quiz1 !== bestByBrute(QUIZ1) || quiz1Cnt.some((c) => pairCost(c) !== 1)) throw new Error('sails: ข้อทดสอบตัวเอง 1 ไม่ตรงกับการไล่ทุกแบบ');

/* ---------- ตัวอย่างของคำว่า "บล็อก" กับข้อทดสอบตัวเอง 2 ----------
   ใช้สภาพหลังเสาต้นที่ 5 ของตัวอย่าง (เรียงแล้ว) แล้วสมมติเสาต้นถัดไปสูง 5 ต้องการ 2 ใบ */
const BLOCK_STEP = 5;
const blockRow = good.after[BLOCK_STEP - 1];
const blockV = 2;
const blockLo = blockRow.indexOf(blockV) + 1;
const blockHi = blockRow.lastIndexOf(blockV) + 1;
if (blockRow.join(' ') !== '3 2 2 2 0' || blockLo !== 2 || blockHi !== 4) {
  throw new Error('sails: ตัวอย่างบล็อก 3 2 2 2 0 ไม่ตรงกับตัวอย่างแล้ว ต้องแก้ข้อความ');
}
const QUIZ2_MAST: Mast = { h: 5, k: 2 };
const quiz2Prefix = [...MASTS].sort((x, y) => x.h - y.h || x.k - y.k).slice(0, BLOCK_STEP);
const quiz2Run = rangeRun([...quiz2Prefix, QUIZ2_MAST], true);
const quiz2 = quiz2Run.trace[BLOCK_STEP];
const quiz2After = quiz2Run.after[BLOCK_STEP];
const quiz2Greedy = greedy([...quiz2Prefix, QUIZ2_MAST])[BLOCK_STEP].after;
if (
  quiz2Run.after[BLOCK_STEP - 1].join() !== blockRow.join() ||
  quiz2After.join() !== quiz2Greedy.join() ||
  quiz2.r === QUIZ2_MAST.h ||
  QUIZ2_MAST.k - (QUIZ2_MAST.h - quiz2.r) < 1
) {
  throw new Error('sails: ข้อทดสอบตัวเอง 2 ต้องมีทั้งช่วงท้ายและหัวบล็อก และต้องตรงกับท่าโลภแบบนับตรง');
}
const quiz2Below = QUIZ2_MAST.h - quiz2.r;
const quiz2K2 = QUIZ2_MAST.k - quiz2Below;

const solution = `#include <bits/stdc++.h>
using namespace std;
int MX; vector<long long> bit;                 // BIT แบบ range-update / point-query
void upd(int i,long long v){ for(;i<=MX;i+=i&-i) bit[i]+=v; }
void range(int l,int r,long long v){ if(l>r) return; upd(l,v); upd(r+1,-v); }
long long at(int i){ long long s=0; for(;i>0;i-=i&-i) s+=bit[i]; return s; }
int main(){
    int n; if(scanf("%d",&n)!=1) return 0;
    vector<pair<int,int>> m(n);
    for(auto&p:m) scanf("%d %d",&p.first,&p.second);
    sort(m.begin(),m.end());
    MX=m.back().first; bit.assign(MX+2,0);
    for(auto&[H,K]:m){
        long long v=at(H-K+1);
        // [l,r] = ช่วงใน [1..H] ที่ค่าเท่ากับ v พอดี (อาเรย์ไม่เพิ่ม จึงค้นแบบไบนารีได้)
        int l=1,r=H,lo,hi;
        lo=1; hi=H; int first=H+1;
        while(lo<=hi){ int md=(lo+hi)/2; if(at(md)<=v){ first=md; hi=md-1; } else lo=md+1; }
        l=first;
        lo=1; hi=H; int last=0;
        while(lo<=hi){ int md=(lo+hi)/2; if(at(md)>=v){ last=md; lo=md+1; } else hi=md-1; }
        r=last;
        int below=H-r;                 // ช่องที่ค่าน้อยกว่า v อยู่ท้ายสุด เติมก่อนทั้งหมด
        range(r+1,H,1);
        int k2=K-below;                // ที่เหลือหยิบจาก "หัว" ของบล็อกค่าเท่ากับ v
        if(k2>0) range(l,l+k2-1,1);
    }
    long long ans=0;
    for(int i=1;i<=MX;i++){ long long c=at(i); ans+=c*(c-1)/2; }
    printf("%lld\\n",ans);
}`;
const subCode = `// เฉลยชุดทดสอบย่อย จำนวนวิธีจัดใบเรือทั้งหมดไม่เกินหนึ่งล้านแบบ (25 คะแนน)
// ไล่ทุกวิธีจัดจริง ๆ แล้วเก็บค่าที่น้อยที่สุด ไม่ต้องรู้อะไรเรื่องความโลภเลย
#include <bits/stdc++.h>
using namespace std;
int n, MX;
vector<int> H, K, cnt;
long long best = LLONG_MAX;

void rec(int i) {
    if (i == n) {
        long long v = 0;
        for (int c : cnt) v += 1LL * c * (c - 1) / 2;      // คู่ที่อยู่ระดับเดียวกัน
        best = min(best, v);
        return;
    }
    vector<int> pick(H[i], 0);
    fill(pick.begin(), pick.begin() + K[i], 1);
    sort(pick.begin(), pick.end());                        // เริ่มจากรูปแบบที่เล็กที่สุดของ next_permutation
    do {
        for (int h = 0; h < H[i]; h++) if (pick[h]) cnt[h]++;
        rec(i + 1);
        for (int h = 0; h < H[i]; h++) if (pick[h]) cnt[h]--;
    } while (next_permutation(pick.begin(), pick.end()));
}

int main() {
    scanf("%d", &n);
    H.resize(n); K.resize(n); MX = 0;
    for (int i = 0; i < n; i++) { scanf("%d %d", &H[i], &K[i]); MX = max(MX, H[i]); }
    cnt.assign(MX, 0);
    rec(0);
    printf("%lld\\n", best);
}`;
const coreSnippet = `long long v = at(H - K + 1);            // ค่าที่ระดับตัวที่ K นับจากท้ายช่วง [1..H]
