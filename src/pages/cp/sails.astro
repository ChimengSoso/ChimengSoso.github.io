<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type SgMast = { h: number; k: number };
  type SgPuzzle = {
    id: string;
    label: string;
    tease: string;
    masts: SgMast[];
    maxh: number;
    best: number;
  };

  function initSailGame(): void {
    const maybeUi = cpGameUi('[data-sailgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as SgPuzzle[];
    if (puzzles.length === 0) return;

    const boardEl = ui.root.querySelector<HTMLElement>('[data-sg-board]');
    const costEl = ui.root.querySelector<HTMLElement>('[data-sg-cost]');
    const placedEl = ui.root.querySelector<HTMLElement>('[data-sg-placed]');
    const needEl = ui.root.querySelector<HTMLElement>('[data-sg-need]');
    if (!boardEl || !costEl || !placedEl || !needEl) return;
    const board: HTMLElement = boardEl;
    const costOut: HTMLElement = costEl;
    const placedOut: HTMLElement = placedEl;
    const needOut: HTMLElement = needEl;

    let pi = 0;
    let grid: boolean[][] = [];

    const pz = (): SgPuzzle => puzzles[pi];
    const needTotal = (): number => pz().masts.reduce((a, m) => a + m.k, 0);

    function levelCounts(): number[] {
      const p = pz();
      const cnt = new Array<number>(p.maxh).fill(0);
      for (let c = 0; c < p.masts.length; c++) {
        for (let r = 0; r < p.maxh; r++) if (grid[c][r]) cnt[r]++;
      }
      return cnt;
    }

    const scoreOf = (cnt: number[]): number => cnt.reduce((a, v) => a + (v * (v - 1)) / 2, 0);

    function buildBoard(): void {
      const p = pz();
      board.textContent = '';
      const head = document.createElement('tr');
      const corner = document.createElement('th');
      corner.textContent = 'ระดับ';
      head.appendChild(corner);
      p.masts.forEach((m, c) => {
        const th = document.createElement('th');
        th.textContent = `เสา ${c + 1}`;
        const sub = document.createElement('span');
        sub.className = 'sg-sub';
        sub.dataset.mast = String(c);
        sub.textContent = `0/${m.k}`;
        th.appendChild(sub);
        head.appendChild(th);
      });
      const tally = document.createElement('th');
      tally.textContent = 'คู่ที่ชนกัน';
      head.appendChild(tally);
      board.appendChild(head);

      for (let r = 0; r < p.maxh; r++) {
        const tr = document.createElement('tr');
        const th = document.createElement('th');
        th.textContent = String(r + 1);
        tr.appendChild(th);
        for (let c = 0; c < p.masts.length; c++) {
          const td = document.createElement('td');
          if (r < p.masts[c].h) {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'sg-cell';
            b.dataset.c = String(c);
            b.dataset.r = String(r);
            b.setAttribute('aria-label', `เสา ${c + 1} ระดับ ${r + 1}`);
            b.setAttribute('aria-pressed', 'false');
            td.appendChild(b);
          } else {
            td.className = 'sg-none';
          }
          tr.appendChild(td);
        }
        const pen = document.createElement('td');
        pen.className = 'sg-pen';
        pen.dataset.level = String(r);
        pen.textContent = '0';
        tr.appendChild(pen);
        board.appendChild(tr);
      }
    }

    function render(): void {
      const p = pz();
      const cnt = levelCounts();
      const score = scoreOf(cnt);
      for (const b of Array.from(board.querySelectorAll<HTMLElement>('.sg-cell'))) {
        const c = Number(b.dataset.c);
        const r = Number(b.dataset.r);
        const on = grid[c][r];
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        b.classList.toggle('clash', on && cnt[r] > 1);
      }
      for (const td of Array.from(board.querySelectorAll<HTMLElement>('.sg-pen'))) {
        const r = Number(td.dataset.level);
        const v = (cnt[r] * (cnt[r] - 1)) / 2;
        td.textContent = String(v);
        td.classList.toggle('hot', v > 0);
      }
      for (const sp of Array.from(board.querySelectorAll<HTMLElement>('.sg-sub'))) {
        const c = Number(sp.dataset.mast);
        const used = grid[c].filter(Boolean).length;
        sp.textContent = `${used}/${p.masts[c].k}`;
        sp.classList.toggle('done', used === p.masts[c].k);
        sp.classList.toggle('over', used > p.masts[c].k);
      }
      const placed = grid.reduce((a, col) => a + col.filter(Boolean).length, 0);
      costOut.textContent = String(score);
      placedOut.textContent = String(placed);
      needOut.textContent = String(needTotal());
    }

    function check(): void {
      const p = pz();
      for (let c = 0; c < p.masts.length; c++) {
        const used = grid[c].filter(Boolean).length;
        if (used !== p.masts[c].k) {
          ui.setStatus(
            `เสา ${c + 1} ยังแขวนไม่ครบ ต้องได้ ${p.masts[c].k} ใบ ตอนนี้ ${used} ใบ`,
            'bad',
          );
          return;
        }
      }
      const score = scoreOf(levelCounts());
      if (score === p.best) {
        ui.setStatus(`ดีที่สุดแล้วครับ ${score} แต้ม ไม่มีวิธีจัดไหนทำได้ต่ำกว่านี้`, 'good');
      } else {
        ui.setStatus(
          `ได้ ${score} แต้ม ยังมีวิธีที่ทำได้ ${p.best} แต้ม ลองดูระดับที่มีคู่ชนกันเยอะที่สุดก่อน`,
          'bad',
        );
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      const p = pz();
      grid = p.masts.map(() => new Array<boolean>(p.maxh).fill(false));
      ui.selectTab(k);
      ui.setTease(p.tease);
      buildBoard();
      ui.setStatus('คลิกช่องบนเสาเพื่อแขวนใบเรือ แต่ละเสาต้องแขวนให้ครบตามจำนวนที่โจทย์กำหนด');
      render();
    }

    board.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const cell = e.target.closest('.sg-cell');
      if (!(cell instanceof HTMLElement)) return;
      const c = Number(cell.dataset.c);
      const r = Number(cell.dataset.r);
      grid[c][r] = !grid[c][r];
      ui.setStatus('คลิกช่องบนเสาเพื่อแขวนใบเรือ แต่ละเสาต้องแขวนให้ครบตามจำนวนที่โจทย์กำหนด');
      render();
    });

    ui.onClick('data-sg-clear', () => selectPuzzle(pi));
    ui.onClick('data-sg-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initSailGame);
</script>

<script>
  import { initCpPlayers } from '../../lib/cpPlayer';

  interface SailStepClient {
    i: number;
    h: number;
    k: number;
    picked: number[];
    after: number[];
    cost: number;
    gain: number;
    note: string;
  }

  /** ตรวจว่าค่าที่อ่านมาจาก data-steps ครบตามที่กระดานต้องใช้ */
  function isSailStep(v: unknown): v is SailStepClient {
    if (typeof v !== 'object' || v === null) return false;
    const o = v as Record<string, unknown>;
    return (
      typeof o.i === 'number' &&
      typeof o.h === 'number' &&
      typeof o.k === 'number' &&
      Array.isArray(o.picked) &&
      Array.isArray(o.after) &&
      typeof o.cost === 'number' &&
      typeof o.gain === 'number' &&
      typeof o.note === 'string'
    );
  }

  document.addEventListener('astro:page-load', () => {
    initCpPlayers<SailStepClient>('[data-sailsim]', {
      narrow: (raw) => {
        const ok = raw.filter(isSailStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      draw: (st, ctx) => {
        const cells = Array.from(ctx.parts.root.querySelectorAll<HTMLTableCellElement>('td.cnt'));
        cells.forEach((td, lv) => {
          const n = st.after[lv] ?? 0;
          td.className = 'num cnt';
          td.textContent = n === 0 ? '·' : String(n);
          if (n > 0) td.classList.add('is-filled');
          // ระดับที่เพิ่งรับใบของเสาต้นนี้ ต้องเห็นชัดว่าขั้นนี้ทำอะไร
          if (st.picked.indexOf(lv + 1) !== -1) {
            td.classList.add('is-touched');
            ctx.keepInView(td);
          }
        });
        const total = ctx.parts.root.querySelector<HTMLElement>('td.total');
        if (total) total.textContent = String(st.cost);
      },
    });
  });
</script>
