              <td><code>{row.join(' ')}</code></td>
              <td>{isSorted(row) ? 'ใช่' : 'ไม่'}</td>
              <td><code>{bad.snaps[i].join(' ')}</code></td>
              <td>{isSorted(bad.snaps[i]) ? 'ใช่' : 'ไม่'}</td>
            </tr>
          ))}
          <tr>
            <td class="num">ค่ารวม</td>
            <td class="num"><strong>{good.cost}</strong></td><td></td>
