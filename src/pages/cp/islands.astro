/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Bridge = { to: number; len: number };
const EX: Bridge[] = [
  { to: 3, len: 8 },
  { to: 7, len: 2 },
  { to: 4, len: 2 },
  { to: 1, len: 4 },
  { to: 1, len: 9 },
  { to: 3, len: 4 },
  { to: 2, len: 3 },
];
const N = EX.length;

/** หนึ่งกลุ่มของแผนที่: วงหนึ่งวง ค่าบนวงที่คลี่เป็นสองรอบ และคำตอบของสองทรง */
type Comp = {
  /** เกาะบนวง เรียงตามลูกศร */
  cyc: number[];
  /** ความลึกของต้นไม้ที่ห้อยจากเกาะบนวงแต่ละเกาะ */
  d: number[];
  /** สะพานจากเกาะบนวงไปเกาะถัดไปบนวง */
  w: number[];
  /** ระยะสะสม P บนวงที่คลี่เป็นสองรอบ ยาว 2c */
  pref: number[];
  /** ทรงข้ามวงที่ดีที่สุด และคู่ตำแหน่ง (บนวงที่คลี่) ที่ให้ค่านั้น */
  cycBest: number;
  bestI: number;
  bestJ: number;
  /** ทรงจมในต้นไม้ที่ดีที่สุด และเกาะที่เป็นยอดของทางนั้น */
  treeBest: number;
  treeAt: number;
  local: number;
};
type Solved = { t1: number[]; t2: number[]; onCycle: boolean[]; order: number[]; comps: Comp[] };

/** เฉลยแบบตรง ๆ สำหรับตัวอย่างเล็กในหน้านี้
 *  ฝั่งทรงข้ามวงไล่ทุกคู่ (i, j) บนวงที่คลี่ ไม่ได้ใช้หน้าต่างเลื่อน
 *  เครื่องเดินของตอนที่ 4 ใช้หน้าต่างเลื่อน แล้วถูกเทียบกับค่านี้ตอนบิลด์ */
function solve(br: Bridge[]): Solved {
  const n = br.length;
  const f = (v: number): number => br[v - 1].to;
  const L = (v: number): number => br[v - 1].len;
  // ปอกใบทิ้งทีละชั้นจนเหลือแต่เกาะบนวง พร้อมเก็บสองกิ่งที่ลึกที่สุดของแต่ละเกาะ
  const indeg = new Array<number>(n + 1).fill(0);
  for (let i = 1; i <= n; i++) indeg[f(i)]++;
  const t1 = new Array<number>(n + 1).fill(0);
  const t2 = new Array<number>(n + 1).fill(0);
  const q: number[] = [];
  for (let i = 1; i <= n; i++) if (indeg[i] === 0) q.push(i);
  for (let h = 0; h < q.length; h++) {
    const u = q[h];
    const p = f(u);
    const v = t1[u] + L(u);
    if (v > t1[p]) {
      t2[p] = t1[p];
      t1[p] = v;
    } else if (v > t2[p]) t2[p] = v;
    if (--indeg[p] === 0) q.push(p);
  }
  const onCycle = new Array<boolean>(n + 1).fill(false);
  for (let i = 1; i <= n; i++) onCycle[i] = indeg[i] > 0;

  // แยกวงทีละวง แล้วไล่ทุกคู่บนวงที่คลี่
  const done = new Array<boolean>(n + 1).fill(false);
  const compOf = new Array<number>(n + 1).fill(-1);
  const comps: Comp[] = [];
  for (let s = 1; s <= n; s++) {
    if (!onCycle[s] || done[s]) continue;
    const cyc: number[] = [];
    for (let u = s; !done[u]; u = f(u)) {
      done[u] = true;
      cyc.push(u);
      compOf[u] = comps.length;
    }
    const c = cyc.length;
    const d = cyc.map((v) => t1[v]);
    const w = cyc.map((v) => L(v));
    const pref = new Array<number>(2 * c).fill(0);
    for (let i = 1; i < 2 * c; i++) pref[i] = pref[i - 1] + w[(i - 1) % c];
    let cycBest = 0;
    let bestI = 0;
    let bestJ = 0;
    for (let j = 0; j < 2 * c; j++)
      for (let i = Math.max(0, j - (c - 1)); i < j; i++) {
        const v = d[j % c] + pref[j] + d[i % c] - pref[i];
        if (v > cycBest) {
          cycBest = v;
          bestI = i;
          bestJ = j;
        }
      }
    comps.push({ cyc, d, w, pref, cycBest, bestI, bestJ, treeBest: 0, treeAt: cyc[0], local: 0 });
  }
  // แจกหมายเลขกลุ่มลงต้นไม้ห้อย: ไล่ลำดับปอกย้อนกลับ พ่อจึงได้หมายเลขก่อนลูกเสมอ
  for (let h = q.length - 1; h >= 0; h--) compOf[q[h]] = compOf[f(q[h])];
  for (let v = 1; v <= n; v++) {
    const cp = comps[compOf[v]];
    if (t1[v] + t2[v] > cp.treeBest) {
      cp.treeBest = t1[v] + t2[v];
      cp.treeAt = v;
    }
  }
  for (const cp of comps) cp.local = Math.max(cp.cycBest, cp.treeBest);
  return { t1, t2, onCycle, order: q, comps };
}
const EXS = solve(EX);
const { t1, t2, onCycle, comps } = EXS;
const peeled = EXS.order;
const answer = comps.reduce((a, c) => a + c.local, 0);

/* เคสที่จับบักของเฉลยเต็มรอบแรก (ตอนที่ 5) และเคสที่เล็กที่สุดที่บักเดียวกันพังได้
   ทั้งสองแผนที่ ทางที่ยาวที่สุดเป็นทรงจมในต้นไม้ ไม่แตะสะพานบนวงเลย */
const BROKEN6: Bridge[] = [
  { to: 3, len: 3 },
  { to: 6, len: 3 },
  { to: 6, len: 3 },
  { to: 6, len: 10 },
  { to: 4, len: 5 },
  { to: 2, len: 1 },
];
const SMALL4: Bridge[] = [
