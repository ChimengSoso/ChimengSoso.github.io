  let best = 0;
  for (let k = 0; k < 2 * cl; k++) {
    const lo = Math.max(0, k - (cl - 1));
    const expired: number[] = [];
    while (dq.length > 0 && dq[0] < lo) expired.push(dq.shift() as number);
    let from = -1;
    let cand = 0;
    if (dq.length > 0) {
      from = dq[0];
      cand = dP(k) + dM(from);
      if (cand > best) best = cand;
    }
    const popped: number[] = [];
    while (dq.length > 0 && dM(dq[dq.length - 1]) <= dM(k)) popped.push(dq.pop() as number);
    dq.push(k);
    const isle = isleAt(c, k);
    const parts: string[] = [`ตำแหน่ง ${k} (เกาะ ${isle})`];
    if (k === lo) parts.push('ยังไม่มีตำแหน่งไหนอยู่ในหน้าต่าง จึงยังไม่มีคู่ให้คิด');
    else {
      parts.push(`หน้าต่างคือตำแหน่ง ${lo} ถึง ${k - 1}`);
      if (expired.length > 0) parts.push(`ทิ้งตำแหน่ง ${expired.join(', ')} ที่หัวคิว เพราะห่างจาก ${k} เกิน c − 1 = ${cl - 1}`);
      parts.push(
        `หัวคิวคือตำแหน่ง ${from} (เกาะ ${isleAt(c, from)}) ค่าของคู่ = ${dP(k)} + (${sgn(dM(from))}) = <b>${cand}</b>`,
      );
    }
    const mine = sgn(dM(k));
    if (popped.length > 0)
      parts.push(
        `ก่อนใส่ ${k} (d − P = ${mine}) ไล่${popped.map((x) => `ตำแหน่ง ${x} (${sgn(dM(x))})`).join(', ')} ออกจากท้ายคิว เพราะไม่มากกว่า ${mine}`,
      );
    else if (dq.length === 1) parts.push(`ใส่ ${k} (d − P = ${mine}) ลงคิวที่ว่างอยู่`);
    else {
      const back = dq[dq.length - 2];
      parts.push(`ใส่ ${k} (d − P = ${mine}) ต่อท้ายโดยไม่ไล่ใคร เพราะท้ายคิวคือตำแหน่ง ${back} (${sgn(dM(back))}) มากกว่า`);
    }
    parts.push(`คิว [${dq.join(', ')}]`, `ดีที่สุดตอนนี้ <b>${best}</b>`);
    const note = parts.join(' · ');
    steps.push({ note, k, lo, dq: [...dq], from, cand, best });
    rows.push({
      pair: from < 0 ? 'ยังไม่มีคู่' : `เกาะ ${isleAt(c, from)} ไป ${isle}`,
      cand: from < 0 ? '·' : String(cand),
