/* ---------- มินิเกม เดินหาเส้นทางที่ยาวที่สุดเอง ----------
   คำตอบของแต่ละกลุ่มมาจากการไล่ทุกเส้นทางอย่างง่ายจริง ๆ ตอนบิลด์
   ไม่ได้มาจากสูตรของเฉลย เกมจึงเถียงกับเฉลยได้ถ้าเฉลยผิด
   และผลรวมของชุดตัวอย่างถูกเทียบกับคำตอบของบทความ ถ้าไม่ตรงบิลด์จะพัง */
type IslPuzzle = { id: string; label: string; tease: string; bridges: Bridge[] };

type IslEdge = { a: number; b: number; len: number };

function edgesOf(br: Bridge[]): IslEdge[] {
  return br.map((b, i) => ({ a: i + 1, b: b.to, len: b.len }));
}

/** ความยาวที่ดีที่สุดของสะพานที่เชื่อมเกาะคู่นี้ หรือศูนย์ถ้าไม่มีสะพาน */
function linkLen(edges: IslEdge[], u: number, v: number): number {
  let best = 0;
  for (const e of edges) {
    if ((e.a === u && e.b === v) || (e.a === v && e.b === u)) best = Math.max(best, e.len);
  }
  return best;
}

/** กลุ่มของเกาะ แบ่งด้วยการเดินตามสะพานโดยไม่สนทิศ */
function componentsOf(br: Bridge[]): number[] {
  const n = br.length;
  const comp = new Array<number>(n + 1).fill(0);
  const adj = new Map<number, number[]>();
  for (const e of edgesOf(br)) {
    adj.set(e.a, [...(adj.get(e.a) ?? []), e.b]);
    adj.set(e.b, [...(adj.get(e.b) ?? []), e.a]);
  }
  let c = 0;
  for (let i = 1; i <= n; i++) {
    if (comp[i] !== 0) continue;
    c++;
    const st = [i];
    comp[i] = c;
    while (st.length) {
      const u = st.pop() as number;
      for (const v of adj.get(u) ?? []) if (comp[v] === 0) { comp[v] = c; st.push(v); }
    }
  }
  return comp;
}

/** เส้นทางอย่างง่ายที่ยาวที่สุดของแต่ละกลุ่ม ไล่ทุกเส้นทางจริง ใช้กับกราฟเล็กเท่านั้น */
function bestPerComponent(br: Bridge[]): number[] {
  const n = br.length;
  const edges = edgesOf(br);
  const comp = componentsOf(br);
  const nc = Math.max(...comp.slice(1));
  const best = new Array<number>(nc + 1).fill(0);
  const seen = new Array<boolean>(n + 1).fill(false);
  const walk = (u: number, acc: number): void => {
    if (acc > best[comp[u]]) best[comp[u]] = acc;
    for (let v = 1; v <= n; v++) {
      if (seen[v]) continue;
      const w = linkLen(edges, u, v);
      if (w === 0) continue;
      seen[v] = true;
      walk(v, acc + w);
      seen[v] = false;
    }
  };
  for (let s = 1; s <= n; s++) {
    seen[s] = true;
    walk(s, 0);
    seen[s] = false;
  }
  return best;
}

const ISL_PUZZLES: IslPuzzle[] = [
  {
    id: 'i1',
    label: 'ชุดที่ 1 · อุ่นเครื่อง',
    tease: 'สี่เกาะกลุ่มเดียว พอให้ชินกับการเดินไม่ซ้ำเกาะ',
    bridges: [
      { to: 2, len: 3 },
      { to: 3, len: 5 },
      { to: 4, len: 2 },
      { to: 2, len: 6 },
    ],
  },
  { id: 'i2', label: 'ชุดที่ 2 · ตัวอย่างในโจทย์', tease: 'แผนที่เดียวกับที่บทความแกะให้ดู', bridges: EX },
  {
    id: 'i3',
    label: 'ชุดที่ 3 · สองกลุ่ม',
    tease: 'ชุดนี้แผนที่ขาดออกเป็นสองกลุ่ม ต้องหาให้ครบทั้งสองกลุ่ม',
    bridges: [
      { to: 2, len: 4 },
      { to: 1, len: 7 },
      { to: 4, len: 5 },
      { to: 5, len: 2 },
      { to: 3, len: 6 },
    ],
  },
  {
    id: 'i4',
    label: 'ชุดที่ 4 · เกาะ 6 รับหลายสะพาน',
    tease: 'หกเกาะกลุ่มเดียว มีหลายสะพานพุ่งเข้าเกาะ 6 ลองหลายเส้นทางก่อนบันทึก',
    bridges: BROKEN6,
  },
];

type IslPuzzleData = {
  id: string;
  label: string;
  tease: string;
  n: number;
  edges: IslEdge[];
  comp: number[];
  best: number[];
  total: number;
};
const islPuzzles: IslPuzzleData[] = ISL_PUZZLES.map((p) => {
  const comp = componentsOf(p.bridges);
  const best = bestPerComponent(p.bridges);
  return {
    id: p.id,
    label: p.label,
    tease: p.tease,
    n: p.bridges.length,
    edges: edgesOf(p.bridges),
    comp,
    best,
    total: best.reduce((a, b) => a + b, 0),
  };
});
{
  // ชุดที่สองคือตัวอย่างของบทความ ผลรวมต้องเท่ากับคำตอบที่บทความประกาศไว้
  const sample = islPuzzles[1];
  if (sample.total !== answer) {
    throw new Error(`มินิเกมของ islands: ไล่ทุกเส้นทางได้ ${sample.total} แต่บทความตอบ ${answer}`);
  }
}
const islJson = JSON.stringify(islPuzzles);

const NMAX = 1000000;
const LMAX = 100000000;
const fmt = (n: number): string => n.toLocaleString('en-US');

/* ---------- ตัวเลขของเฉลยตอนที่ 1 ถึง 5 ---------- */

/** ความยาวของทางที่ระบุเป็นลำดับเกาะ ถ้าเกาะคู่ไหนไม่มีสะพานถึงกัน บิลด์จะพัง */
function pathLenOf(br: Bridge[], path: number[]): number {
  const es = edgesOf(br);
  let s = 0;
  for (let i = 0; i + 1 < path.length; i++) {
    const w = linkLen(es, path[i], path[i + 1]);
    if (w === 0) throw new Error(`islands: ไม่มีสะพานระหว่างเกาะ ${path[i]} กับ ${path[i + 1]}`);
    s += w;
  }
  return s;
}
const totalOf = (br: Bridge[]): number => bestPerComponent(br).reduce((a, b) => a + b, 0);
const sgn = (v: number): string => (v < 0 ? `−${-v}` : String(v));
const isleAt = (c: Comp, k: number): number => c.cyc[k % c.cyc.length];

/* ตอนที่ 1: รูปของตัวอย่าง เส้นหนาคือทางยาวสุดของแต่ละกลุ่ม ต้องยาวเท่าคำตอบของกลุ่ม */
const EX_PATHS: number[][] = [
  [5, 1, 3, 6],
  [2, 7],
];
EX_PATHS.forEach((p, k) => {
  if (pathLenOf(EX, p) !== comps[k].local) throw new Error(`islands: ทางหนาของกลุ่ม ${k + 1} ยาวไม่เท่าคำตอบของกลุ่ม`);
});
const MAP_R = 15;
const MAP_XY: Record<number, [number, number]> = {
  5: [27, 72],
  1: [117, 150],
  3: [267, 150],
  4: [192, 240],
  6: [357, 72],
  2: [467, 150],
  7: [597, 150],
};
const MAP_CENTER: [number, number] = [192, 180];
const onPath = (u: number, v: number): boolean =>
  EX_PATHS.some((p) => p.some((x, i) => i + 1 < p.length && ((x === u && p[i + 1] === v) || (x === v && p[i + 1] === u))));
/* สะพานตรงของกลุ่มที่ 1 (กลุ่มที่ 2 มีสะพานคู่ วาดเป็นเส้นโค้งแยก) ป้ายความยาววางตามแนวตั้งฉากกับเส้น
   ฝั่งที่ห่างจากกลางวง เพื่อไม่ให้ตัวเลขทับเส้นหรือหล่นเข้าไปในวง */
const MAP_LINES = EX.map((b, i) => ({ u: i + 1, v: b.to, len: b.len }))
  .filter((e) => comps[0].cyc.includes(e.v))
  .map((e) => {
    const [x1, y1] = MAP_XY[e.u];
    const [x2, y2] = MAP_XY[e.v];
    const dx = x2 - x1;
    const dy = y2 - y1;
    const len = Math.hypot(dx, dy);
    const ux = dx / len;
    const uy = dy / len;
    let nx = dy / len;
    let ny = -dx / len;
    const mx = (x1 + x2) / 2;
    const my = (y1 + y2) / 2;
    const away = (mx + nx - MAP_CENTER[0]) ** 2 + (my + ny - MAP_CENTER[1]) ** 2 > (mx - MAP_CENTER[0]) ** 2 + (my - MAP_CENTER[1]) ** 2;
    if (!away) {
      nx = -nx;
      ny = -ny;
    }
    return {
      ...e,
      x1: x1 + ux * MAP_R,
      y1: y1 + uy * MAP_R,
      x2: x2 - ux * (MAP_R + 2),
      y2: y2 - uy * (MAP_R + 2),
      lx: Math.round(mx + nx * 13),
      ly: Math.round(my + ny * 13),
      hot: onPath(e.u, e.v),
    };
  });
const MAP_BRIDGE2 = EX.map((b, i) => ({ u: i + 1, v: b.to, len: b.len })).filter((e) => comps[1].cyc.includes(e.u));
const MAP_PAIR_HOT = Math.max(...MAP_BRIDGE2.map((e) => e.len));

/* ตอนที่ 2: ต้นทุนของท่าตัดสะพานบนวงทีละเส้น เทียบงบเวลา
   ความเร็วเครื่องเป็นค่าสมมติแบบหยาบที่เขียนบอกไว้ในหน้า ไม่ใช่ค่าที่วัด */
const SUB_N = 4000;
const TIME_LIMIT = 2.2;
const OPS_PER_SEC = 1e8;
const BUDGET_OPS = TIME_LIMIT * OPS_PER_SEC;
const CUT_SUB = SUB_N * SUB_N;
const CUT_FULL = NMAX * NMAX;
/* เฉลยเต็ม นับตามขั้นของโค้ด: ปอกใบ N + เดินวงที่คลี่รวมไม่เกิน 2N
   + เข้าออกคิวสองหัวตำแหน่งละไม่เกินสองครั้งบนแถว 2N + แจกหมายเลขกลุ่ม N = 8N */
const FULL_STEPS = [
  { what: 'ปอกใบ', k: 1 },
  { what: 'เดินวงที่คลี่', k: 2 },
  { what: 'เข้าออกคิวสองหัว', k: 4 },
  { what: 'แจกหมายเลขกลุ่ม', k: 1 },
];
const FULL_K = FULL_STEPS.reduce((a, b) => a + b.k, 0);
const FULL_OPS = FULL_K * NMAX;
const CUT_OVER = Math.round(CUT_FULL / BUDGET_OPS / 100) * 100;
if (CUT_SUB > BUDGET_OPS || CUT_FULL < BUDGET_OPS || FULL_OPS > BUDGET_OPS) throw new Error('islands: กราฟงบเวลาไม่ตรงกับเรื่องที่หน้าเล่า');
const CH_LO = 6;
const CH_HI = 13;
const CH_X0 = 228;
const CH_W = 330;
const CH_Y0 = 46;
const CH_ROW = 46;
const chX = (v: number): number => CH_X0 + ((Math.log10(v) - CH_LO) / (CH_HI - CH_LO)) * CH_W;
const sci = (v: number): { m: string; e: number } => {
  const e = Math.floor(Math.log10(v));
  return { m: (v / 10 ** e).toFixed(1).replace(/\.0$/, ''), e };
};
const CH_BARS = [
  { name: `ตัดสะพานบนวง · N = ${fmt(SUB_N)}`, v: CUT_SUB },
  { name: `ตัดสะพานบนวง · N = ${fmt(NMAX)}`, v: CUT_FULL },
  { name: `เฉลยเต็ม · N = ${fmt(NMAX)}`, v: FULL_OPS },
].map((b, k) => ({ ...b, y: CH_Y0 + k * CH_ROW, ok: b.v < BUDGET_OPS, s: sci(b.v), over: Math.round(b.v / BUDGET_OPS / 100) * 100 }));
const CH_BOTTOM = CH_Y0 + CH_BARS.length * CH_ROW;
const CH_TICKS = Array.from({ length: CH_HI - CH_LO + 1 }, (_, k) => CH_LO + k);

/* ตอนที่ 3: ตารางหลังปอกใบของตัวอย่าง */
const PEEL_ROWS = Array.from({ length: N }, (_, k) => k + 1).map((v) => ({
  v,
  cyc: onCycle[v],
  t1: t1[v],
  t2: t2[v],
}));
const cycIsles = comps.map((c) => c.cyc.join(', ')).join(' และ ');
/** เดินการปอกใบทีละเกาะ เป็นบรรทัดสั้น ๆ ค่าสุดท้ายต้องตรงกับ solve() */
function peelWalk(br: Bridge[]): string[] {
  const n = br.length;
  const indeg = new Array<number>(n + 1).fill(0);
  for (const b of br) indeg[b.to]++;
  const a1 = new Array<number>(n + 1).fill(0);
  const a2 = new Array<number>(n + 1).fill(0);
  const q: number[] = [];
  for (let i = 1; i <= n; i++) if (indeg[i] === 0) q.push(i);
  const lines: string[] = [];
  for (let h = 0; h < q.length; h++) {
    const u = q[h];
    const p = br[u - 1].to;
    const len = br[u - 1].len;
    const v = a1[u] + len;
    let what: string;
    if (v > a1[p]) {
      what = a1[p] > 0 ? `ยาวกว่า t1 เดิม (${a1[p]}) จึงขึ้นเป็น t1 = ${v} และ ${a1[p]} ถอยไปเป็น t2` : `t1 ของเกาะ ${p} จึงเป็น ${v}`;
      a2[p] = a1[p];
      a1[p] = v;
    } else if (v > a2[p]) {
      what = `ไม่ยาวกว่า t1 (${a1[p]}) แต่ยาวกว่า t2 จึงเป็น t2 = ${v}`;
      a2[p] = v;
