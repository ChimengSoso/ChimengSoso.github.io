<style>

  .dim{color:#7b8397;}

  /* ---------- แผงของมินิเกมเกาะกับสะพาน ---------- */
  .is-bridges{border-collapse:collapse;font-size:0.85rem;}
  .is-bridges :global(th), .is-bridges :global(td){
    border:1px solid #2a3350;padding:0.24rem 0.7rem;text-align:center;color:#cdd6ea;
  }
  .is-bridges :global(th){color:#9aa7bd;font-weight:600;white-space:nowrap;}
  .cpg-controls :global(.is-isle){display:inline-flex;flex-direction:column;align-items:center;gap:0.1rem;line-height:1.2;}
  .cpg-controls :global(.is-group){font-size:0.68rem;color:#7b8397;}
  .cpg-controls :global(.is-isle.used){background:var(--dl-emerald-bright);border-color:var(--dl-emerald-bright);color:#0b1220;font-weight:700;}
  .cpg-controls :global(.is-isle.used .is-group){color:#0b1220;}
  .cpg-controls :global(.is-isle.reach){border-color:var(--dl-emerald);}

  /* ---------- เครื่องเดินหน้าต่างเลื่อน (ตอนที่ 4) ---------- */
  .isw-board{display:block;margin:0.6rem auto 0.4rem;max-width:none;}
</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type IsEdge = { a: number; b: number; len: number };
  type IsPuzzle = {
    id: string;
    label: string;
    tease: string;
    n: number;
    edges: IsEdge[];
    comp: number[];
    best: number[];
    total: number;
  };

  function initIslandGame(): void {
    const maybeUi = cpGameUi('[data-islgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as IsPuzzle[];
    if (puzzles.length === 0) return;

    const islesEl = ui.root.querySelector<HTMLElement>('[data-is-isles]');
    const pathEl = ui.root.querySelector<HTMLElement>('[data-is-path]');
    const lenEl = ui.root.querySelector<HTMLElement>('[data-is-len]');
    const sumEl = ui.root.querySelector<HTMLElement>('[data-is-sum]');
    const totalEl = ui.root.querySelector<HTMLElement>('[data-is-total]');
    const bridgeEl = ui.root.querySelector<HTMLElement>('[data-is-bridges]');
    if (!islesEl || !pathEl || !lenEl || !sumEl || !totalEl || !bridgeEl) return;
    const isles: HTMLElement = islesEl;
    const pathOut: HTMLElement = pathEl;
    const lenOut: HTMLElement = lenEl;
    const sumOut: HTMLElement = sumEl;
    const totalOut: HTMLElement = totalEl;
    const bridgeTable: HTMLElement = bridgeEl;

    let pi = 0;
    let path: number[] = [];
    let claimed = new Map<number, number>();

    const pz = (): IsPuzzle => puzzles[pi];

    function linkLen(u: number, v: number): number {
      let best = 0;
      for (const e of pz().edges) {
        if ((e.a === u && e.b === v) || (e.a === v && e.b === u)) best = Math.max(best, e.len);
      }
      return best;
    }

    function pathLen(): number {
      let s = 0;
      for (let i = 0; i + 1 < path.length; i++) s += linkLen(path[i], path[i + 1]);
      return s;
    }

    function buildBoard(): void {
      const p = pz();
      isles.textContent = '';
      for (let i = 1; i <= p.n; i++) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cpg-btn is-isle';
        b.dataset.isle = String(i);
        b.textContent = `เกาะ ${i}`;
        const g = document.createElement('span');
        g.className = 'is-group';
        g.textContent = `กลุ่ม ${p.comp[i]}`;
        b.appendChild(g);
        isles.appendChild(b);
      }
      bridgeTable.textContent = '';
      const head = document.createElement('tr');
      for (const t of ['สะพาน', 'เชื่อม', 'ยาว']) {
        const th = document.createElement('th');
        th.textContent = t;
        head.appendChild(th);
      }
      bridgeTable.appendChild(head);
      p.edges.forEach((e, i) => {
        const tr = document.createElement('tr');
        for (const t of [`เส้นที่ ${i + 1}`, `${e.a} กับ ${e.b}`, String(e.len)]) {
          const td = document.createElement('td');
          td.textContent = t;
          tr.appendChild(td);
        }
        bridgeTable.appendChild(tr);
      });
    }

    function render(): void {
      const p = pz();
      const last = path.length ? path[path.length - 1] : 0;
      for (const b of Array.from(isles.querySelectorAll<HTMLElement>('[data-isle]'))) {
        const i = Number(b.dataset.isle);
        b.classList.toggle('used', path.includes(i));
        b.classList.toggle('reach', last !== 0 && !path.includes(i) && linkLen(last, i) > 0);
      }
      pathOut.textContent = path.length === 0 ? 'ยังไม่ได้เริ่มเดิน' : path.join(' - ');
      lenOut.textContent = String(pathLen());
      let sum = 0;
      for (const v of claimed.values()) sum += v;
      sumOut.textContent = String(sum);
      totalOut.textContent = String(p.total);
    }

    function step(i: number): void {
      if (path.length === 0) {
        path = [i];
        ui.setStatus(`เริ่มที่เกาะ ${i} แล้ว เดินต่อไปเกาะที่มีสะพานถึงกัน`);
        render();
        return;
      }
      if (path.includes(i)) {
        ui.setStatus(`เกาะ ${i} เคยเหยียบไปแล้ว โจทย์ห้ามเดินซ้ำเกาะ`, 'bad');
        return;
      }
      const last = path[path.length - 1];
      const w = linkLen(last, i);
      if (w === 0) {
        ui.setStatus(`ไม่มีสะพานจากเกาะ ${last} ไปเกาะ ${i}`, 'bad');
        return;
      }
      path.push(i);
      ui.setStatus(`ข้ามสะพานยาว ${w} มาที่เกาะ ${i} รวมแล้ว ${pathLen()}`);
      render();
    }

    function claim(): void {
      const p = pz();
      if (path.length < 2) {
        ui.setStatus('เดินอย่างน้อยหนึ่งสะพานก่อนครับ', 'bad');
        return;
      }
      const c = p.comp[path[0]];
      const len = pathLen();
      const prev = claimed.get(c) ?? 0;
      if (len <= prev) {
        ui.setStatus(`กลุ่ม ${c} เคยได้ ${prev} ไปแล้ว เส้นทางนี้ยาว ${len} จึงยังไม่ดีขึ้น`, 'bad');
        return;
      }
      claimed.set(c, len);
      const done = len === p.best[c];
      ui.setStatus(
        done
          ? `กลุ่ม ${c} ได้ ${len} ซึ่งยาวที่สุดของกลุ่มนี้แล้ว`
          : `กลุ่ม ${c} บันทึกไว้ที่ ${len} แต่ยังมีเส้นทางที่ยาวกว่านี้ในกลุ่มเดียวกัน`,
        done ? 'good' : 'bad',
      );
      render();
      let sum = 0;
      for (const v of claimed.values()) sum += v;
      if (sum === p.total) ui.setStatus(`ครบทุกกลุ่มแล้วครับ รวมได้ ${sum} ซึ่งคือคำตอบของแผนที่นี้`, 'good');
    }

    function selectPuzzle(k: number): void {
      pi = k;
      path = [];
      claimed = new Map<number, number>();
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildBoard();
      ui.setStatus('กดเกาะเพื่อเริ่มเดิน แล้วกดเกาะถัดไปที่มีสะพานถึงกัน ห้ามเหยียบเกาะซ้ำ');
      render();
    }

    isles.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('[data-isle]');
      if (!(b instanceof HTMLElement)) return;
      step(Number(b.dataset.isle));
    });

    ui.onClick('data-is-clear', () => {
      path = [];
      ui.setStatus('ล้างเส้นทางแล้ว เริ่มเดินใหม่ได้');
      render();
    });
    ui.onClick('data-is-claim', claim);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initIslandGame);
</script>

<script>
  import { initCpPlayers } from '../../lib/cpPlayer';

  /* เครื่องเดินหน้าต่างเลื่อนของตอนที่ 4 ทุกตัวเลขคำนวณไว้ตอนบิลด์ในแต่ละขั้น ฝั่งนี้แค่ระบายสีและวางเส้น
     ตั้งสีผ่าน attribute ตรง ๆ เพราะสไตล์ scoped ของหน้าลอดผ่านกล่องของ CpStepPlayer ไม่ได้ */
  type IswStep = { note: string; k: number; lo: number; dq: number[]; from: number; cand: number; best: number };
  const isNumArr = (x: unknown): x is number[] => Array.isArray(x) && x.every((v) => typeof v === 'number');
  function isIswStep(x: unknown): x is IswStep {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return (
      typeof o.note === 'string' && typeof o.k === 'number' && typeof o.lo === 'number' && isNumArr(o.dq) &&
      typeof o.from === 'number' && typeof o.cand === 'number' && typeof o.best === 'number'
    );
  }

  document.addEventListener('astro:page-load', () => {
    initCpPlayers<IswStep>('[data-islwin]', {
      narrow: (raw) => {
        const ok = raw.filter(isIswStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      zeroBased: true,
      draw: (st, ctx) => {
        const root = ctx.parts.root;
        const boxOf = (k: number): SVGRectElement | null => root.querySelector<SVGRectElement>(`[data-isw-box="${k}"]`);
        const edge = (k: number): { x: number; w: number } => {
          const b = boxOf(k);
          return { x: Number(b?.getAttribute('x') ?? 0), w: Number(b?.getAttribute('width') ?? 0) };
        };
        root.querySelectorAll<SVGRectElement>('[data-isw-box]').forEach((box) => {
          const k = Number(box.dataset.iswBox);
          const now = k === st.k;
          const inQ = st.dq.includes(k);
          box.setAttribute('fill', now ? '#2a2410' : inQ ? '#16302a' : '#141c2c');
          box.setAttribute('stroke', now ? '#d4af37' : inQ ? '#6ee7a8' : '#3a4459');
          box.setAttribute('stroke-width', now ? '2.5' : '1.5');
        });
        const win = root.querySelector<SVGRectElement>('[data-isw-win]');
        if (win) {
          if (st.k > st.lo) {
            const a = edge(st.lo);
            const b = edge(st.k - 1);
            win.setAttribute('x', String(a.x - 5));
            win.setAttribute('width', String(b.x + b.w - a.x + 10));
            win.removeAttribute('display');
          } else win.setAttribute('display', 'none');
        }
        const arc = root.querySelector<SVGPathElement>('[data-isw-arc]');
        const txt = root.querySelector<SVGTextElement>('[data-isw-arctxt]');
        if (arc && txt) {
          if (st.from >= 0) {
            const a = edge(st.from);
            const b = edge(st.k);
            const x1 = a.x + a.w / 2;
            const x2 = b.x + b.w / 2;
            arc.setAttribute('d', `M${x1} 76 C${x1} 36, ${x2} 36, ${x2} 76`);
            arc.removeAttribute('display');
            txt.setAttribute('x', String((x1 + x2) / 2));
            txt.setAttribute('y', '36');
            txt.textContent = `คู่นี้ได้ ${st.cand}`;
            txt.removeAttribute('display');
          } else {
            arc.setAttribute('display', 'none');
            txt.setAttribute('display', 'none');
          }
        }
        const rows = Array.from(root.querySelectorAll<HTMLTableRowElement>('tbody tr'));
        rows.forEach((tr, i) => {
          tr.classList.toggle('is-later', i > ctx.at);
          tr.classList.toggle('is-now', i === ctx.at);
        });
        const now = rows[ctx.at];
        if (now) ctx.keepInView(now.cells[0] ?? now);
      },
    });
  });
</script>
