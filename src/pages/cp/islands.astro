---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

const href = 'islands/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Bridge = { to: number; len: number };
const EX: Bridge[] = [
  { to: 3, len: 8 },
  { to: 7, len: 2 },
  { to: 4, len: 2 },
  { to: 1, len: 4 },
  { to: 1, len: 9 },
  { to: 3, len: 4 },
  { to: 2, len: 3 },
];
const N = EX.length;
const f = (v: number): number => EX[v - 1].to;
const L = (v: number): number => EX[v - 1].len;

/** ปอกใบทิ้งทีละชั้นจนเหลือแต่ปมบนวง พร้อมเก็บสองกิ่งที่ลึกที่สุดของแต่ละปม */
function peel(): { t1: number[]; t2: number[]; onCycle: boolean[]; order: number[] } {
  const indeg = new Array<number>(N + 1).fill(0);
  for (let i = 1; i <= N; i++) indeg[f(i)]++;
  const t1 = new Array<number>(N + 1).fill(0);
  const t2 = new Array<number>(N + 1).fill(0);
  const q: number[] = [];
  for (let i = 1; i <= N; i++) if (indeg[i] === 0) q.push(i);
  for (let h = 0; h < q.length; h++) {
    const u = q[h];
    const p = f(u);
    const v = t1[u] + L(u);
    if (v > t1[p]) {
      t2[p] = t1[p];
      t1[p] = v;
    } else if (v > t2[p]) t2[p] = v;
    if (--indeg[p] === 0) q.push(p);
  }
  const onCycle = new Array<boolean>(N + 1).fill(false);
  for (let i = 1; i <= N; i++) onCycle[i] = indeg[i] > 0;
  return { t1, t2, onCycle, order: q };
}
const { t1, t2, onCycle } = peel();

/** แยกกลุ่มออกเป็นวง ๆ แล้วคิดคำตอบของแต่ละกลุ่ม */
type Comp = { cyc: number[]; d: number[]; w: number[]; pref: number[]; bestPair: string; local: number; treeBest: number };
function components(): Comp[] {
  const done = new Array<boolean>(N + 1).fill(false);
  const out: Comp[] = [];
  const compOf = new Array<number>(N + 1).fill(-1);
  for (let s = 1; s <= N; s++) {
    if (!onCycle[s] || done[s]) continue;
    const cyc: number[] = [];
    for (let u = s; !done[u]; u = f(u)) {
      done[u] = true;
      cyc.push(u);
      compOf[u] = out.length;
    }
    const c = cyc.length;
    const d = cyc.map((v) => t1[v]);
    const w = cyc.map((v) => L(v));
    const pref = new Array<number>(2 * c).fill(0);
    for (let i = 1; i < 2 * c; i++) pref[i] = pref[i - 1] + w[(i - 1) % c];
    let local = 0;
    let bestPair = '';
    for (let j = 0; j < 2 * c; j++)
      for (let i = Math.max(0, j - (c - 1)); i < j; i++) {
        const v = d[j % c] + pref[j] + d[i % c] - pref[i];
        if (v > local) {
          local = v;
          bestPair = `${cyc[i % c]} ไป ${cyc[j % c]}`;
        }
      }
    out.push({ cyc, d, w, pref, bestPair, local, treeBest: 0 });
  }
  // เส้นทางที่อยู่ในต้นไม้ห้อยล้วน ๆ ก็เป็นคำตอบของกลุ่มได้ ต้องแจกหมายเลขกลุ่มลงไปก่อน
  const stack = [...Array(N).keys()].map((i) => i + 1);
  const assign = (v: number): number => {
    if (compOf[v] >= 0) return compOf[v];
    const c = assign(f(v));
    compOf[v] = c;
    return c;
  };
  for (const v of stack) assign(v);
  for (let v = 1; v <= N; v++) {
    const c = compOf[v];
    out[c].treeBest = Math.max(out[c].treeBest, t1[v] + t2[v]);
  }
  for (const c of out) c.local = Math.max(c.local, c.treeBest);
  return out;
}
const comps = components();
const answer = comps.reduce((a, c) => a + c.local, 0);

/* ---------- มินิเกม เดินหาเส้นทางที่ยาวที่สุดเอง ----------
   คำตอบของแต่ละกลุ่มมาจากการไล่ทุกเส้นทางอย่างง่ายจริง ๆ ตอนบิลด์
   ไม่ได้มาจากสูตรของเฉลย เกมจึงเถียงกับเฉลยได้ถ้าเฉลยผิด
   และผลรวมของชุดตัวอย่างถูกเทียบกับคำตอบของบทความ ถ้าไม่ตรงบิลด์จะพัง */
type IslPuzzle = { id: string; label: string; tease: string; bridges: Bridge[] };

type IslEdge = { a: number; b: number; len: number };

function edgesOf(br: Bridge[]): IslEdge[] {
  return br.map((b, i) => ({ a: i + 1, b: b.to, len: b.len }));
}

/** ความยาวที่ดีที่สุดของสะพานที่เชื่อมเกาะคู่นี้ หรือศูนย์ถ้าไม่มีสะพาน */
function linkLen(edges: IslEdge[], u: number, v: number): number {
  let best = 0;
  for (const e of edges) {
    if ((e.a === u && e.b === v) || (e.a === v && e.b === u)) best = Math.max(best, e.len);
  }
  return best;
}

/** กลุ่มของเกาะ แบ่งด้วยการเดินตามสะพานโดยไม่สนทิศ */
function componentsOf(br: Bridge[]): number[] {
  const n = br.length;
  const comp = new Array<number>(n + 1).fill(0);
  const adj = new Map<number, number[]>();
  for (const e of edgesOf(br)) {
    adj.set(e.a, [...(adj.get(e.a) ?? []), e.b]);
    adj.set(e.b, [...(adj.get(e.b) ?? []), e.a]);
  }
  let c = 0;
  for (let i = 1; i <= n; i++) {
    if (comp[i] !== 0) continue;
    c++;
    const st = [i];
    comp[i] = c;
    while (st.length) {
      const u = st.pop() as number;
      for (const v of adj.get(u) ?? []) if (comp[v] === 0) { comp[v] = c; st.push(v); }
    }
  }
  return comp;
}

/** เส้นทางอย่างง่ายที่ยาวที่สุดของแต่ละกลุ่ม ไล่ทุกเส้นทางจริง ใช้กับกราฟเล็กเท่านั้น */
function bestPerComponent(br: Bridge[]): number[] {
  const n = br.length;
  const edges = edgesOf(br);
  const comp = componentsOf(br);
  const nc = Math.max(...comp.slice(1));
  const best = new Array<number>(nc + 1).fill(0);
  const seen = new Array<boolean>(n + 1).fill(false);
  const walk = (u: number, acc: number): void => {
    if (acc > best[comp[u]]) best[comp[u]] = acc;
    for (let v = 1; v <= n; v++) {
      if (seen[v]) continue;
      const w = linkLen(edges, u, v);
      if (w === 0) continue;
      seen[v] = true;
      walk(v, acc + w);
      seen[v] = false;
    }
  };
  for (let s = 1; s <= n; s++) {
    seen[s] = true;
    walk(s, 0);
    seen[s] = false;
  }
  return best;
}

const ISL_PUZZLES: IslPuzzle[] = [
  {
    id: 'i1',
    label: 'ชุดที่ 1 · อุ่นเครื่อง',
    tease: 'สี่เกาะกลุ่มเดียว พอให้ชินกับการเดินไม่ซ้ำเกาะ',
    bridges: [
      { to: 2, len: 3 },
      { to: 3, len: 5 },
      { to: 4, len: 2 },
      { to: 2, len: 6 },
    ],
  },
  { id: 'i2', label: 'ชุดที่ 2 · ตัวอย่างในโจทย์', tease: 'แผนที่เดียวกับที่บทความแกะให้ดู', bridges: EX },
  {
    id: 'i3',
    label: 'ชุดที่ 3 · สองกลุ่ม',
    tease: 'ชุดนี้แผนที่ขาดออกเป็นสองกลุ่ม ต้องหาให้ครบทั้งสองกลุ่ม',
    bridges: [
      { to: 2, len: 4 },
      { to: 1, len: 7 },
      { to: 4, len: 5 },
      { to: 5, len: 2 },
      { to: 3, len: 6 },
    ],
  },
];

type IslPuzzleData = {
  id: string;
  label: string;
  tease: string;
  n: number;
  edges: IslEdge[];
  comp: number[];
  best: number[];
  total: number;
};
const islPuzzles: IslPuzzleData[] = ISL_PUZZLES.map((p) => {
  const comp = componentsOf(p.bridges);
  const best = bestPerComponent(p.bridges);
  return {
    id: p.id,
    label: p.label,
    tease: p.tease,
    n: p.bridges.length,
    edges: edgesOf(p.bridges),
    comp,
    best,
    total: best.reduce((a, b) => a + b, 0),
  };
});
{
  // ชุดที่สองคือตัวอย่างของบทความ ผลรวมต้องเท่ากับคำตอบที่บทความประกาศไว้
  const sample = islPuzzles[1];
  if (sample.total !== answer) {
    throw new Error(`มินิเกมของ islands: ไล่ทุกเส้นทางได้ ${sample.total} แต่บทความตอบ ${answer}`);
  }
}
const islJson = JSON.stringify(islPuzzles);

const NMAX = 1000000;
const LMAX = 100000000;
const fmt = (n: number): string => n.toLocaleString('en-US');

const solution = `#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
int main(){
    int n; if(scanf("%d",&n)!=1) return 0;
    vector<int> f(n+1),L(n+1),indeg(n+1,0);
    for(int i=1;i<=n;i++){ scanf("%d %d",&f[i],&L[i]); indeg[f[i]]++; }
    vector<ll> t1(n+1,0),t2(n+1,0);                  // สองกิ่งที่ลึกที่สุดของแต่ละปม
    vector<int> q; q.reserve(n);
    for(int i=1;i<=n;i++) if(!indeg[i]) q.push_back(i);
    for(size_t h=0;h<q.size();h++){                  // ปอกใบทิ้งทีละชั้น เหลือไว้แต่ปมบนวง
        int u=q[h],p=f[u]; ll v=t1[u]+L[u];
        if(v>t1[p]){ t2[p]=t1[p]; t1[p]=v; } else if(v>t2[p]) t2[p]=v;
        if(--indeg[p]==0) q.push_back(p);
    }
    vector<int> comp(n+1,-1); vector<ll> res;
    vector<char> done(n+1,0);
    vector<int> cyc; vector<ll> d,P; vector<int> W;
    for(int s=1;s<=n;s++){
        if(indeg[s]==0||done[s]) continue;
        int id=(int)res.size(); cyc.clear();
        for(int u=s; !done[u]; u=f[u]){ done[u]=1; cyc.push_back(u); comp[u]=id; }
        int c=(int)cyc.size();
        d.assign(c,0); W.assign(c,0);
        for(int i=0;i<c;i++){ d[i]=t1[cyc[i]]; W[i]=L[cyc[i]]; }
        P.assign(2*c,0);
        for(int i=1;i<2*c;i++) P[i]=P[i-1]+W[(i-1)%c];
        ll local=0; deque<int> dq;                   // หน้าต่างเลื่อน หาค่ามากสุดของ d[i]-P[i]
        for(int j=0;j<2*c;j++){
            while(!dq.empty() && dq.front()<j-(c-1)) dq.pop_front();
            if(!dq.empty()) local=max(local, d[j%c]+P[j] + d[dq.front()%c]-P[dq.front()]);
            ll cur=d[j%c]-P[j];
            while(!dq.empty() && d[dq.back()%c]-P[dq.back()]<=cur) dq.pop_back();
            dq.push_back(j);
        }
        res.push_back(local);
    }
    for(int h=(int)q.size()-1;h>=0;h--) comp[q[h]]=comp[f[q[h]]];   // แจกหมายเลขกลุ่มลงต้นไม้ที่ห้อยอยู่
    for(int u=1;u<=n;u++) res[comp[u]]=max(res[comp[u]],t1[u]+t2[u]);
    ll ans=0; for(ll v:res) ans+=v;
    printf("%lld\\n",ans);
}`;
const subCode = `// เฉลยชุดทดสอบย่อย N ไม่เกิน 4,000 (40 คะแนน)
// ความคิดหลัก: ตัดเส้นบนวงออกทีละเส้น กลุ่มนั้นจะกลายเป็นต้นไม้ทันที
// แล้วเส้นทางยาวสุดในต้นไม้ก็คือเส้นผ่านศูนย์กลาง ซึ่งหาได้ด้วยการค้นสองรอบ
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
int n;
struct E { int to, w, id; };
vector<vector<E>> g;                                // กราฟไม่มีทิศ สะพานสองเส้นระหว่างเกาะคู่เดียวกันเป็นคนละเส้น จึงต้องมีหมายเลขกำกับ

pair<int,ll> farthest(int s, const vector<char>& alive, int banId) {
    vector<ll> d(n + 1, -1);
    d[s] = 0;
    vector<int> st{s};
    int bi = s; ll bd = 0;
    while (!st.empty()) {
        int u = st.back(); st.pop_back();
        for (auto& e : g[u]) {
            int v = e.to;
            if (!alive[v] || d[v] >= 0 || e.id == banId) continue;   // ข้ามสะพานเส้นที่ตัดทิ้ง
            d[v] = d[u] + e.w;
            if (d[v] > bd) { bd = d[v]; bi = v; }
            st.push_back(v);
        }
    }
    return {bi, bd};
}

int main() {
    scanf("%d", &n);
    vector<int> f(n + 1), L(n + 1);
    g.assign(n + 1, {});
    for (int i = 1; i <= n; i++) {
        scanf("%d %d", &f[i], &L[i]);
        g[i].push_back({f[i], L[i], i});
        g[f[i]].push_back({i, L[i], i});
    }
    vector<char> seen(n + 1, 0);
    ll ans = 0;
    for (int s = 1; s <= n; s++) {
        if (seen[s]) continue;
        // เก็บสมาชิกของกลุ่มนี้
        vector<int> comp; vector<char> alive(n + 1, 0);
        vector<int> st{s}; seen[s] = 1;
        while (!st.empty()) {
            int u = st.back(); st.pop_back(); comp.push_back(u); alive[u] = 1;
            for (auto& e : g[u]) if (!seen[e.to]) { seen[e.to] = 1; st.push_back(e.to); }
        }
        // หาวงด้วยการเดินตามลูกศรจนวนกลับมาที่เดิม
        vector<int> mark(n + 1, 0);
        int u = s; while (!mark[u]) { mark[u] = 1; u = f[u]; }
        vector<int> cyc; int v = u;
        do { cyc.push_back(v); v = f[v]; } while (v != u);
        ll best = 0;
        for (size_t i = 0; i < cyc.size(); i++) {
            int a = cyc[i];                           // สะพานหมายเลข a คือเส้นที่ออกจากเกาะ a
            auto p1 = farthest(a, alive, a);          // ตัดสะพานนั้นแล้วหาเส้นผ่านศูนย์กลางของต้นไม้
            auto p2 = farthest(p1.first, alive, a);
            best = max(best, p2.second);
        }
        ans += best;
    }
    printf("%lld\\n", ans);
}`;
const coreSnippet = `// ค่าของเส้นทางที่ลงต้นไม้ที่ i ไต่วงไปทางเดียวจนถึง j แล้วลงต้นไม้ที่ j คือ
//     d[i] + d[j] + (P[j] - P[i])   =   (d[j] + P[j]) + (d[i] - P[i])
// ก้อนหลังไม่ขึ้นกับ j เลย จึงใช้หน้าต่างเลื่อนเก็บค่ามากสุดของมันได้
deque<int> dq;
for (int j = 0; j < 2 * c; j++) {
    while (!dq.empty() && dq.front() < j - (c - 1)) dq.pop_front();   // ไต่วงเกินรอบไม่ได้
    if (!dq.empty())
        local = max(local, d[j % c] + P[j] + d[dq.front() % c] - P[dq.front()]);
    ll cur = d[j % c] - P[j];
    while (!dq.empty() && d[dq.back() % c] - P[dq.back()] <= cur) dq.pop_back();
    dq.push_back(j);
}`;
