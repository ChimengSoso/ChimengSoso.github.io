<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type GrAction = { kind: 'arr' | 'dep' | 'seat'; car: number; need: number; who: number[]; q: number[]; fee: number; income: number };
  type GrPuzzle = { id: string; label: string; tease: string; n: number; rate: number[]; w: number[]; ev: number[]; actions: GrAction[]; answer: number };

  function initGarageGame(): void {
    const maybeUi = cpGameUi('[data-grgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as GrPuzzle[];
    const maybeLot = ui.root.querySelector<HTMLElement>('[data-gr-lot]');
    const maybeQueue = ui.root.querySelector<HTMLElement>('[data-gr-queue]');
    const maybeEvent = ui.root.querySelector<HTMLElement>('[data-gr-event]');
    if (puzzles.length === 0 || !maybeLot || !maybeQueue || !maybeEvent) return;
    const lot: HTMLElement = maybeLot;
    const queueEl: HTMLElement = maybeQueue;
    const eventEl: HTMLElement = maybeEvent;

    let pi = 0;
    let at = 0;
    let slips = 0;
    const fmt = (v: number): string => v.toLocaleString('en-US');
    const pz = (): GrPuzzle => puzzles[pi];

    /* สถานะก่อนการกระทำที่ at คือผลหลังการกระทำก่อนหน้า */
    function before(): { who: number[]; q: number[]; income: number } {
      if (at === 0) return { who: new Array<number>(pz().n).fill(0), q: [], income: 0 };
      const a = pz().actions[at - 1];
      return { who: a.who, q: a.q, income: a.income };
    }

    function render(): void {
      const p = pz();
      const st = before();
      lot.textContent = '';
      st.who.forEach((c, s) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = c > 0 ? 'gr-spot busy' : 'gr-spot';
        b.dataset.grSpot = String(s + 1);
        const no = document.createElement('span');
        no.className = 'gr-no';
        no.textContent = `ช่อง ${s + 1}`;
        const rate = document.createElement('span');
        rate.className = 'gr-rate';
        rate.textContent = `ราคา ${p.rate[s]}`;
        const car = document.createElement('span');
        car.className = 'gr-car';
        car.textContent = c > 0 ? `คัน ${c}` : 'ว่าง';
        b.append(no, rate, car);
        lot.append(b);
      });
      queueEl.textContent = st.q.length > 0 ? `คิวหน้าทางเข้า: ${st.q.map((c) => `คัน ${c}`).join(', ')}` : 'ไม่มีรถรอหน้าทางเข้า';
      if (at >= p.actions.length) {
        eventEl.textContent = 'หมดวันแล้ว ไม่มีรถเหลือในโรงจอด';
      } else {
        const a = p.actions[at];
        if (a.kind === 'arr') eventEl.textContent = `รถคัน ${a.car} หนัก ${fmt(p.w[a.car - 1])} กิโลกรัม มาถึงหน้าทางเข้า`;
        else if (a.kind === 'dep') eventEl.textContent = `รถคัน ${a.car} กำลังจะขับออก`;
        else eventEl.textContent = `ช่องเพิ่งว่าง และมีรถรออยู่ รถหัวคิวคือคัน ${a.car} หนัก ${fmt(p.w[a.car - 1])} กิโลกรัม ให้มันจอดช่องไหน`;
      }
      ui.setScore(`รายได้ ${fmt(st.income)} ดอลลาร์ · พลาด ${slips} ครั้ง`);
    }

    function flash(s: number): void {
      lot.querySelector(`[data-gr-spot="${s}"]`)?.classList.add('flash');
    }

    /* choice: เลขช่อง, 0 = ให้รอ, -1 = ปล่อยรถออก */
    function act(choice: number): void {
      const p = pz();
      if (at >= p.actions.length) return;
      const a = p.actions[at];
      const st = before();
      if (choice === a.need) {
        at++;
        render();
        if (a.fee > 0) ui.setStatus(`ถูกครับ คัน ${a.car} จอดช่อง ${a.need} ได้ค่าจอด ${fmt(p.w[a.car - 1])} คูณ ${p.rate[a.need - 1]} เท่ากับ ${fmt(a.fee)}`, 'good');
        else if (a.need === 0) ui.setStatus(`ถูกครับ เต็มทุกช่อง คัน ${a.car} ต่อท้ายคิว`, 'good');
        else ui.setStatus(`คัน ${a.car} ออกไปแล้ว`, 'good');
        if (at >= p.actions.length) {
          const tail = slips === 0 ? 'ไม่พลาดเลยสักครั้ง' : `ระหว่างทางพลาดไป ${slips} ครั้ง`;
          ui.setStatus(`จบวัน รายได้ ${fmt(p.answer)} ดอลลาร์ ตรงกับคำตอบ ${tail}`, 'good');
        }
        return;
      }
      slips++;
      render();
      if (a.kind === 'dep') {
        ui.setStatus(`รถคัน ${a.car} กำลังจะออก ยังไม่ต้องจัดที่ให้ใคร กดปล่อยรถออกก่อน`, 'bad');
      } else if (choice === -1) {
        ui.setStatus(`ตอนนี้ไม่มีรถจะออก มีรถคัน ${a.car} รอให้คุณจัดที่อยู่`, 'bad');
      } else if (choice === 0) {
        ui.setStatus(a.kind === 'seat' ? `คัน ${a.car} รออยู่แล้ว และตอนนี้มีช่องว่าง ให้มันเข้าได้เลย` : 'ยังมีช่องว่างอยู่ ไม่ต้องให้รอ', 'bad');
      } else if (st.who[choice - 1] > 0) {
        flash(choice);
        ui.setStatus(`ช่อง ${choice} มีคัน ${st.who[choice - 1]} จอดอยู่`, 'bad');
      } else if (a.need === 0) {
        ui.setStatus('ช่องนี้ว่างไม่ได้', 'bad');
      } else {
        flash(choice);
        ui.setStatus(`ช่อง ${choice} ว่างก็จริง แต่ยังมีช่องว่างที่เลขน้อยกว่า กติกาบอกให้เลือกเลขน้อยสุด`, 'bad');
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      at = 0;
      slips = 0;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ui.setStatus('กดช่องที่รถคันนี้ควรได้จอด หรือกดปุ่มด้านล่างถ้ามันต้องรอหรือกำลังจะออก');
      render();
    }

    lot.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest('[data-gr-spot]');
      if (!(btn instanceof HTMLElement)) return;
      act(Number(btn.dataset.grSpot));
    });
    ui.onClick('data-gr-wait', () => act(0));
    ui.onClick('data-gr-release', () => act(-1));
    ui.onClick('data-gr-reset', () => selectPuzzle(pi));
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initGarageGame);
</script>

