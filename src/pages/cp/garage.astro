const href = 'garage/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

/** หนึ่งวันของโรงจอดรถ อาเรย์เริ่มที่ 0 แต่ช่อง s ของโจทย์คือ rate[s-1] และรถคัน k คือ w[k-1] */
type Inst = { n: number; rate: number[]; w: number[]; ev: number[] };

/** หนึ่งการกระทำของคนเฝ้าโรงจอด arr = รถมาถึง, dep = รถออก, seat = เรียกหัวคิวเข้าช่องที่เพิ่งว่าง
 *  need คือคำตอบที่ถูก: เลขช่องที่ต้องให้จอด, 0 = ให้รอที่ทางเข้า, -1 = ปล่อยรถออกเฉย ๆ */
type Action = { kind: 'arr' | 'dep' | 'seat'; car: number; need: number; who: number[]; q: number[]; fee: number; income: number };

/** หนึ่งแถวต่อหนึ่งเหตุการณ์ในอินพุต ใช้กับตัวเดินทีละขั้นและแผนภาพ */
type Row = { x: number; who: number[]; q: number[]; fee: number; run: number; seatCar: number; seatSpot: number };

/** ท่าที่หน้านี้สอน: คิวหนึ่งอัน ตอนรถออกและมีคนรอ ให้หัวคิวเข้าช่องที่เพิ่งว่างทันที */
function simulate(inst: Inst): { income: number; actions: Action[]; rows: Row[] } {
  const who = new Array<number>(inst.n).fill(0);
  const at = new Array<number>(inst.w.length + 1).fill(-1);
  const q: number[] = [];
  const actions: Action[] = [];
  const rows: Row[] = [];
  let income = 0;
  const snap = (kind: Action['kind'], car: number, need: number, fee: number): void => {
    actions.push({ kind, car, need, who: [...who], q: [...q], fee, income });
  };
  for (const x of inst.ev) {
    let fee = 0;
    let seatCar = 0;
    let seatSpot = 0;
    if (x > 0) {
      const s = who.indexOf(0);
      if (s >= 0) {
        who[s] = x;
        at[x] = s;
        fee = inst.w[x - 1] * inst.rate[s];
        income += fee;
        seatCar = x;
        seatSpot = s + 1;
        snap('arr', x, s + 1, fee);
      } else {
        q.push(x);
        snap('arr', x, 0, 0);
      }
    } else {
      const s = at[-x];
      who[s] = 0;
      if (q.length > 0) {
        /* ข้ออ้างของหน้านี้: มีคนรออยู่แปลว่าเมื่อกี้เต็มทุกช่อง ช่องที่เพิ่งว่างจึงเป็นช่องว่างช่องเดียว */
        if (who.filter((c) => c === 0).length !== 1) throw new Error('garage: มีคนรอแต่ช่องว่างไม่ใช่ช่องเดียว');
        snap('dep', -x, -1, 0);
        const c = q.shift() as number;
        who[s] = c;
        at[c] = s;
        fee = inst.w[c - 1] * inst.rate[s];
        income += fee;
        seatCar = c;
        seatSpot = s + 1;
        snap('seat', c, s + 1, fee);
      } else {
        snap('dep', -x, -1, 0);
      }
    }
    rows.push({ x, who: [...who], q: [...q], fee, run: income, seatCar, seatSpot });
  }
  return { income, actions, rows };
}

/** ตัวตรวจ ไม่มีคิวและไม่เชื่อข้ออ้างเรื่องช่องที่เพิ่งว่าง
 *  หลังทุกเหตุการณ์ ไล่จับคู่ซ้ำจนนิ่ง รถที่รออยู่และมาถึงเร็วสุดได้ช่องว่างเลขน้อยสุด */
function bruteIncome(inst: Inst): number {
  const m = inst.w.length;
  const state = new Array<number>(m + 1).fill(-1);
  const came = new Array<number>(m + 1).fill(0);
  let income = 0;
  inst.ev.forEach((x, e) => {
    if (x > 0) {
      state[x] = 0;
      came[x] = e;
    } else state[-x] = -2;
    for (;;) {
      let best = -1;
      for (let k = 1; k <= m; k++) if (state[k] === 0 && (best < 0 || came[k] < came[best])) best = k;
      let freeS = -1;
      for (let s = 1; s <= inst.n && freeS < 0; s++) if (!state.includes(s)) freeS = s;
      if (best < 0 || freeS < 0) break;
      state[best] = freeS;
      income += inst.w[best - 1] * inst.rate[freeS - 1];
    }
  });
  return income;
}

/* ด่านตรวจตอนบิลด์ สุ่มวันทำงานเล็ก ๆ ถ้าท่าคิวไม่ตรงกับตัวตรวจ หน้านี้ไม่ขึ้น */
const SWEEP_CASES = 500;
let sweepWaits = 0;
{
  let seed = 20352009;
  const rnd = (m: number): number => {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed % m;
  };
  for (let t = 0; t < SWEEP_CASES; t++) {
    const n = 1 + rnd(4);
    const m = 1 + rnd(8);
    const rate = Array.from({ length: n }, () => 1 + rnd(t % 2 ? 3 : 100));
    const w = Array.from({ length: m }, () => 1 + rnd(t % 2 ? 5 : 10000));
    const ev: number[] = [];
    const parked: number[] = [];
    const waiting: number[] = [];
    let next = 1;
    let waited = false;
    while (ev.length < 2 * m) {
      if (next <= m && (parked.length === 0 || rnd(10) < 6)) {
        ev.push(next);
        if (parked.length < n) parked.push(next);
        else {
          waiting.push(next);
          waited = true;
        }
        next++;
      } else {
        const c = parked.splice(rnd(parked.length), 1)[0];
        ev.push(-c);
        const h = waiting.shift();
        if (h !== undefined) parked.push(h);
      }
    }
    if (waited) sweepWaits++;
    const inst: Inst = { n, rate, w, ev };
    if (simulate(inst).income !== bruteIncome(inst))
      throw new Error(`garage: ท่าคิวไม่ตรงกับตัวตรวจที่ ${JSON.stringify(inst)}`);
  }
}

/* ---------- ตัวอย่างในโจทย์ กับตัวอย่างที่มีคิวซึ่งผมแต่งเพิ่ม ---------- */
const SAMPLE: Inst = { n: 3, rate: [2, 3, 5], w: [200, 100, 300, 800], ev: [3, 2, -3, 1, 4, -4, -2, -1] };
const QUEUE: Inst = { n: 2, rate: [5, 2], w: [100, 500, 1000, 2000], ev: [3, 1, 2, 4, -1, -3, -2, -4] };
const SAMPLE_RUN = simulate(SAMPLE);
const QUEUE_RUN = simulate(QUEUE);
if (SAMPLE_RUN.income !== 5300) throw new Error('garage: ตัวอย่างในโจทย์ต้องได้ 5300');
if (QUEUE_RUN.income !== bruteIncome(QUEUE)) throw new Error('garage: ตัวอย่างที่มีคิวไม่ตรงกับตัวตรวจ');

const fmt = (v: number): string => v.toLocaleString('en-US');
const evLabel = (x: number): string => (x > 0 ? `คัน ${x} มา` : `คัน ${-x} ออก`);
const sampleFees = SAMPLE_RUN.rows.filter((r) => r.seatCar > 0);
const queueWaiters = QUEUE.ev.filter((x, i) => x > 0 && QUEUE_RUN.rows[i].seatCar !== x);
const queueFees = QUEUE_RUN.rows.filter((r) => r.seatCar > 0);

const QUEUE_CAR4 = QUEUE_RUN.rows.find((r) => r.seatCar === 4);
if (!QUEUE_CAR4 || QUEUE_CAR4.seatSpot !== 1) throw new Error('garage: รูปบอกว่าคัน 4 ได้ช่อง 1');
if (QUEUE_RUN.rows.find((r) => r.seatCar === 2)?.seatSpot !== 2) throw new Error('garage: รูปบอกว่าคัน 2 ได้ช่อง 2');
/* ถ้าสลับให้คัน 3 ออกก่อนคัน 1 ตัวเลขทั้งวันจะเปลี่ยน */
const QUEUE_SWAP: Inst = { ...QUEUE, ev: [3, 1, 2, 4, -3, -1, -2, -4] };
const QUEUE_SWAP_RUN = simulate(QUEUE_SWAP);
const SWAP_CAR4 = QUEUE_SWAP_RUN.rows.find((r) => r.seatCar === 4);
if (!SWAP_CAR4 || QUEUE_SWAP_RUN.income !== bruteIncome(QUEUE_SWAP)) throw new Error('garage: ตัวอย่างสลับลำดับผิด');

/* ---------- ตัวเดินทีละขั้น บนตัวอย่างที่มีคิว ---------- */
const qSteps = QUEUE_RUN.rows.map((r) => {
  const x = r.x;
  let note: string;
  if (x > 0 && r.seatCar === x)
    note = `รถคัน <b>${x}</b> หนัก <b>${fmt(QUEUE.w[x - 1])}</b> กิโลกรัมมาถึง ช่องว่างเลขน้อยสุดคือช่อง <b>${r.seatSpot}</b> ราคา ${QUEUE.rate[r.seatSpot - 1]} ต่อกิโลกรัม ค่าจอดจึงเป็น <b>${fmt(r.fee)}</b> รวมเป็น <b>${fmt(r.run)}</b>`;
  else if (x > 0)
    note = `รถคัน <b>${x}</b> มาถึงแต่ทั้ง ${QUEUE.n} ช่องมีรถจอดเต็ม จึงต่อท้ายคิว ตอนนี้คิวคือ <b>${r.q.join(', ')}</b> ยังไม่ได้เงินเพิ่ม`;
  else if (r.seatCar > 0)
    note = `รถคัน <b>${-x}</b> ออก ช่อง <b>${r.seatSpot}</b> ว่างขึ้นมาเป็นช่องว่างช่องเดียว หัวคิวคือคัน <b>${r.seatCar}</b> เข้าจอดทันที ค่าจอด ${fmt(QUEUE.w[r.seatCar - 1])} คูณ ${QUEUE.rate[r.seatSpot - 1]} เท่ากับ <b>${fmt(r.fee)}</b> รวมเป็น <b>${fmt(r.run)}</b>`;
  else note = `รถคัน <b>${-x}</b> ออก ไม่มีใครรออยู่ ช่องนั้นจึงว่างทิ้งไว้ ยอดรวมยังเป็น <b>${fmt(r.run)}</b> เพราะเงินเก็บตอนเข้าจอด ไม่ใช่ตอนออก`;
  return { note };
});

/* ---------- แผนภาพเส้นเวลา ช่องละหนึ่งแถว ---------- */
type Bar = { row: number; x1: number; x2: number; top: string; bottom: string; wait: boolean };
type Gantt = { w: number; h: number; rows: string[]; bars: Bar[]; heads: { x: number; text: string }[]; grid: number[]; rowY: number[] };
const G_X0 = 118;
const G_COL = 78;
const G_TOP = 40;
const G_PITCH = 50;
const G_BAR = 38;
function gantt(inst: Inst): Gantt {
  const run = simulate(inst);
  const T = inst.ev.length;
  const mid = (e: number): number => G_X0 + e * G_COL + G_COL / 2;
  const seatAt = new Map<number, { e: number; spot: number; fee: number }>();
  run.rows.forEach((r, e) => {
    if (r.seatCar > 0) seatAt.set(r.seatCar, { e, spot: r.seatSpot, fee: r.fee });
  });
  const hasWait = run.rows.some((r) => r.q.length > 0);
  const rows = inst.rate.map((r, s) => `ช่อง ${s + 1} · ราคา ${r}`);
  if (hasWait) rows.push('คิวหน้าทางเข้า');
  const bars: Bar[] = [];
  inst.ev.forEach((x, e) => {
    if (x > 0) {
      const st = seatAt.get(x);
      if (!st) throw new Error('garage: มีรถที่ไม่เคยได้จอด');
      if (st.e > e) bars.push({ row: inst.n, x1: mid(e) + 2, x2: mid(st.e) - 2, top: `คัน ${x}`, bottom: 'รอ', wait: true });
    } else {
      const st = seatAt.get(-x);
      if (!st) throw new Error('garage: มีรถที่ไม่เคยได้จอด');
      bars.push({ row: st.spot - 1, x1: mid(st.e) + 2, x2: mid(e) - 2, top: `คัน ${-x}`, bottom: fmt(st.fee), wait: false });
    }
  });
  const rowY = rows.map((_, i) => G_TOP + i * G_PITCH);
  const right = G_X0 + T * G_COL;
  const bottom = rowY[rowY.length - 1] + G_BAR;
  return {
    w: right + 12,
    h: bottom + 34,
    rows,
    bars,
    heads: inst.ev.map((x, e) => ({ x: mid(e), text: evLabel(x) })),
    grid: Array.from({ length: T + 1 }, (_, e) => G_X0 + e * G_COL),
    rowY,
  };
}
const G_SAMPLE = gantt(SAMPLE);
const G_QUEUE = gantt(QUEUE);

/* ---------- มินิเกม เป็นคนเฝ้าโรงจอดเอง ---------- */
type GamePuzzle = { id: string; label: string; tease: string; n: number; rate: number[]; w: number[]; ev: number[]; actions: Action[]; answer: number };
function makePuzzle(id: string, label: string, tease: string, inst: Inst): GamePuzzle {
  const run = simulate(inst);
  const answer = bruteIncome(inst);
  if (run.income !== answer) throw new Error(`garage: เฉลยเกม ${id} สองท่าไม่ตรงกัน`);
  return { id, label, tease, ...inst, actions: run.actions, answer };
}
const PUZZLE_C: Inst = { n: 3, rate: [4, 1, 6], w: [300, 900, 200, 700, 500], ev: [1, 2, 3, 4, 5, -2, -1, -3, -5, -4] };
const puzzles: GamePuzzle[] = [
  makePuzzle('a', 'ตัวอย่างในโจทย์', `วันนี้ไม่มีใครต้องรอเลย ลองจัดให้ถูกทุกคันก่อน แล้วดูว่ารายได้ออกมา ${fmt(SAMPLE_RUN.income)} ไหม`, SAMPLE),
  makePuzzle('b', 'วันที่รถล้น', 'สองช่อง สี่คัน รถสองคันหลังต้องรอหน้าทางเข้า ลองดูว่าพอมีรถออก คุณจะเรียกใครเข้าช่องไหน', QUEUE),
  makePuzzle('c', 'ราคาไม่เรียง', 'ช่องราคาถูกอยู่ตรงกลาง รถหนักที่รอคิวอาจได้ช่องที่ไม่อยากให้ได้ กติกาไม่สนว่าใครหนัก', PUZZLE_C),
];
const puzzlesJson = JSON.stringify(puzzles);

/* ---------- ขอบเขตกับบิลค่าใช้จ่าย ---------- */
const N_MAX = 100;
const M_MAX = 2000;
const R_MAX = 100;
const W_MAX = 10000;
const INCOME_MAX = M_MAX * R_MAX * W_MAX;
const INT_MAX = 2147483647;
const bill = [
  { name: 'ตัวตรวจ ไล่จับคู่ซ้ำหลังทุกเหตุการณ์', work: `ไม่เกินราว ${fmt(2 * M_MAX * N_MAX * M_MAX)} ครั้ง`, time: '0.24 วินาที' },
  { name: 'คิวหนึ่งอัน สแกนหาช่องว่างตอนรถมาถึง', work: `ไม่เกิน ${fmt(M_MAX * N_MAX)} ครั้ง`, time: '0.007 วินาที' },
];

const solution = `#include <bits/stdc++.h>
using namespace std;
int main(){
    int n, m; scanf("%d %d", &n, &m);
    vector<long long> rate(n + 1), w(m + 1);
    for(int s = 1; s <= n; s++) scanf("%lld", &rate[s]);
    for(int k = 1; k <= m; k++) scanf("%lld", &w[k]);
    vector<int> who(n + 1, 0);      // who[s] = รถที่จอดช่อง s อยู่ (0 = ว่าง)
    vector<int> at(m + 1, 0);       // at[k] = ช่องที่รถคัน k จอด
    queue<int> wait;                // รถที่รอหน้าทางเข้า เรียงตามลำดับที่มาถึง
    long long income = 0;
    auto park = [&](int car, int s){ who[s] = car; at[car] = s; income += w[car] * rate[s]; };
    for(int e = 0; e < 2 * m; e++){
        int x; scanf("%d", &x);
        if(x > 0){
            int s = 1; while(s <= n && who[s] != 0) s++;   // ช่องว่างเลขน้อยสุด
            if(s <= n) park(x, s);
            else wait.push(x);                             // เต็ม ต่อท้ายคิว
        } else {
            int s = at[-x]; who[s] = 0;
            // มีคนรอแปลว่าก่อนหน้านี้เต็มทุกช่อง ช่องที่เพิ่งว่างจึงเป็นช่องว่างช่องเดียว
            if(!wait.empty()){ park(wait.front(), s); wait.pop(); }
        }
    }
    printf("%lld\\n", income);
}`;

const subCode = `// ชุดทดสอบ 40 คะแนน: รับประกันว่าไม่มีรถคันไหนต้องรอ จึงไม่ต้องมีคิวเลย
#include <bits/stdc++.h>
using namespace std;
int main(){
    int n, m; scanf("%d %d", &n, &m);
    vector<long long> rate(n + 1), w(m + 1);
    for(int s = 1; s <= n; s++) scanf("%lld", &rate[s]);
    for(int k = 1; k <= m; k++) scanf("%lld", &w[k]);
    vector<int> who(n + 1, 0), at(m + 1, 0);
    long long income = 0;
    for(int e = 0; e < 2 * m; e++){
        int x; scanf("%d", &x);
        if(x > 0){
            int s = 1; while(who[s] != 0) s++;   // ชุดนี้รับประกันว่าเจอช่องว่างก่อนเลย n เสมอ
            who[s] = x; at[x] = s; income += w[x] * rate[s];
        } else who[at[-x]] = 0;
    }
    printf("%lld\\n", income);
}`;

const bruteCode = `// ตัวตรวจ ไม่มีคิว และไม่ใช้ข้อสังเกตเรื่องช่องที่เพิ่งว่าง
// เก็บสถานะของรถทุกคันไว้เป็นตัวเลข แล้วหลังทุกเหตุการณ์ ไล่จับคู่ซ้ำจนนิ่ง
// คือรถที่รออยู่และมาถึงเร็วที่สุด ได้ช่องว่างที่เลขน้อยที่สุด
#include <bits/stdc++.h>
using namespace std;
int main(){
    int n, m; scanf("%d %d", &n, &m);
    vector<long long> rate(n + 1), w(m + 1);
    for(int s = 1; s <= n; s++) scanf("%lld", &rate[s]);
    for(int k = 1; k <= m; k++) scanf("%lld", &w[k]);
    vector<int> state(m + 1, -1);   // -1 ยังไม่มา, 0 รออยู่, s > 0 จอดช่อง s, -2 ออกไปแล้ว
    vector<int> came(m + 1, 0);     // ลำดับเหตุการณ์ที่รถคันนั้นมาถึง
    long long income = 0;
    for(int e = 0; e < 2 * m; e++){
        int x; scanf("%d", &x);
        if(x > 0){ state[x] = 0; came[x] = e; }
        else state[-x] = -2;
        while(true){
            int best = -1;
            for(int k = 1; k <= m; k++)
                if(state[k] == 0 && (best < 0 || came[k] < came[best])) best = k;
            int freeS = -1;
            for(int s = 1; s <= n && freeS < 0; s++){
                bool used = false;
                for(int k = 1; k <= m; k++) if(state[k] == s) used = true;
                if(!used) freeS = s;
            }
            if(best < 0 || freeS < 0) break;
            state[best] = freeS; income += w[best] * rate[freeS];
        }
    }
    printf("%lld\\n", income);
}`;

