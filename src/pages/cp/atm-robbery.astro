/** ย่นปลายเส้นให้หยุดที่ขอบวงกลม ไม่ให้หัวลูกศรมุดเข้าไปในวง */
function shrink(a: Pos, b: Pos, r: number): { x1: number; y1: number; x2: number; y2: number } {
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const len = Math.hypot(dx, dy) || 1;
  return { x1: a.x + (dx / len) * r, y1: a.y + (dy / len) * r, x2: b.x - (dx / len) * r, y2: b.y - (dy / len) * r };
}
const SCC_OF = new Map<number, number>();
SAMPLE_RUN.comps.forEach((c) => c.nodes.forEach((v) => SCC_OF.set(v, c.id)));
const CYCLE_COMP = SAMPLE_RUN.comps.find((c) => c.nodes.length > 1);
