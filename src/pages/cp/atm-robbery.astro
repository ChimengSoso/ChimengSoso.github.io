/* เผื่อแถบว่างล่างขวาไว้ให้ปุ่มขยายของ ZoomableDiagram ไม่ทับปมไหน */
const GY = Math.max(...SPOS.map((p) => p.y)) + 22 + 62;

/* ---------- มินิเกม เดินเส้นทางปล้นเอง ---------- */
type GamePuzzle = { id: string; label: string; tease: string; g: Graph; pos: Pos[]; best: number };
function makePuzzle(id: string, label: string, tease: string, g: Graph, pos: Pos[]): GamePuzzle {
  const want = bruteBest(g);
  if (byScc(g).answer !== want) throw new Error(`atm-robbery: เฉลยเกม ${id} สองท่าไม่ตรงกัน`);
  return { id, label, tease, g, pos, best: want };
}
const P1: Graph = {
