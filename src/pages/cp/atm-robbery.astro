/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Graph = { n: number; edges: [number, number][]; cash: number[]; start: number; pubs: number[] };

/** ตัวตรวจ ค้นทุกสถานะ (จุดที่ยืน, เซตของตู้ที่ปล้นแล้ว) ไม่มีทฤษฎีองค์ประกอบเชื่อมโยงใด ๆ */
function bruteBest(g: Graph): number {
  const adj: number[][] = Array.from({ length: g.n + 1 }, () => []);
  for (const [a, b] of g.edges) adj[a].push(b);
  const best = new Map<string, number>();
  const key = (u: number, m: number): string => `${u}:${m}`;
  const startMask = 1 << (g.start - 1);
  best.set(key(g.start, startMask), g.cash[g.start - 1]);
  const queue: [number, number][] = [[g.start, startMask]];
  for (let i = 0; i < queue.length; i++) {
    const [u, mask] = queue[i];
    const cur = best.get(key(u, mask)) ?? 0;
    for (const v of adj[u]) {
      const nm = mask | (1 << (v - 1));
      const nv = cur + ((mask >> (v - 1)) & 1 ? 0 : g.cash[v - 1]);
      if (nv > (best.get(key(v, nm)) ?? -1)) {
        best.set(key(v, nm), nv);
        queue.push([v, nm]);
      }
    }
  }
  let ans = -1;
  for (const [k, v] of best) {
    const u = Number(k.split(':')[0]);
    if (g.pubs.includes(u)) ans = Math.max(ans, v);
  }
  return ans;
}

type Comp = { id: number; nodes: number[]; sum: number; hasPub: boolean; dp: number };

/** ท่าที่บทความสอน ยุบองค์ประกอบเชื่อมโยงเข้ม แล้วหาทางที่ได้เงินมากสุดบนกราฟไร้วงจร */
function byScc(g: Graph): { comps: Comp[]; order: number[]; answer: number } {
  const adj: number[][] = Array.from({ length: g.n + 1 }, () => []);
  for (const [a, b] of g.edges) adj[a].push(b);
  /* ทาร์ยานแบบวนลูป ไม่ใช้สแต็กของระบบ */
  const num = new Array<number>(g.n + 1).fill(0);
  const low = new Array<number>(g.n + 1).fill(0);
  const comp = new Array<number>(g.n + 1).fill(-1);
  const onstk = new Array<boolean>(g.n + 1).fill(false);
  const it = new Array<number>(g.n + 1).fill(0);
  const stk: number[] = [];
  const groups: number[][] = [];
  let timer = 0;
  for (let s = 1; s <= g.n; s++) {
    if (num[s]) continue;
    const call: number[] = [s];
    num[s] = low[s] = ++timer;
    stk.push(s);
    onstk[s] = true;
    it[s] = 0;
    while (call.length) {
      const u = call[call.length - 1];
      if (it[u] < adj[u].length) {
        const v = adj[u][it[u]++];
        if (!num[v]) {
          num[v] = low[v] = ++timer;
          stk.push(v);
          onstk[v] = true;
          it[v] = 0;
          call.push(v);
        } else if (onstk[v]) low[u] = Math.min(low[u], num[v]);
      } else {
        call.pop();
        if (call.length) low[call[call.length - 1]] = Math.min(low[call[call.length - 1]], low[u]);
        if (low[u] === num[u]) {
          const grp: number[] = [];
          for (;;) {
            const w = stk.pop() ?? 0;
            onstk[w] = false;
            comp[w] = groups.length;
            grp.push(w);
            if (w === u) break;
          }
          groups.push(grp.sort((a, b) => a - b));
        }
      }
    }
  }
  const comps: Comp[] = groups.map((nodes, id) => ({
    id,
    nodes,
    sum: nodes.reduce((acc, v) => acc + g.cash[v - 1], 0),
    hasPub: nodes.some((v) => g.pubs.includes(v)),
    dp: -1,
  }));
  const cadj: number[][] = comps.map(() => []);
  for (const [a, b] of g.edges) if (comp[a] !== comp[b]) cadj[comp[a]].push(comp[b]);
  /* ทาร์ยานปิดองค์ประกอบตามลำดับทอพอโลยีกลับหัวอยู่แล้ว ไล่จากหมายเลขมากลงไปน้อยจึงถูกลำดับ */
  const order = comps.map((_, i) => comps.length - 1 - i);
  comps[comp[g.start]].dp = comps[comp[g.start]].sum;
  for (const c of order) {
    if (comps[c].dp < 0) continue;
    for (const d of cadj[c]) if (comps[c].dp + comps[d].sum > comps[d].dp) comps[d].dp = comps[c].dp + comps[d].sum;
  }
  let answer = 0;
  for (const c of comps) if (c.hasPub && c.dp > answer) answer = c.dp;
  return { comps, order, answer };
}

/* ---------- ตัวอย่างในโจทย์ ---------- */
const SAMPLE: Graph = {
  n: 6,
  edges: [[1, 2], [2, 3], [3, 5], [2, 4], [4, 1], [2, 6], [6, 5]],
  cash: [10, 12, 8, 16, 1, 5],
  start: 1,
  pubs: [4, 3, 5, 6],
};
const SAMPLE_RUN = byScc(SAMPLE);

/* ด่านตรวจตอนบิลด์ ท่าที่สอนต้องตรงกับการค้นทุกสถานะ ไม่งั้นหน้านี้ไม่ขึ้น */
const SWEEP_CASES = 260;
{
  let seed = 20290909;
  const rnd = (m: number): number => {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed % m;
  };
  let done = 0;
  while (done < SWEEP_CASES) {
    const n = 1 + rnd(7);
    const m = 1 + rnd(Math.min(14, n * n));
    const edges: [number, number][] = Array.from({ length: m }, () => [1 + rnd(n), 1 + rnd(n)] as [number, number]);
    const cash = Array.from({ length: n }, () => rnd(21));
    const start = 1 + rnd(n);
    const pubs = [...new Set(Array.from({ length: 1 + rnd(n) }, () => 1 + rnd(n)))];
    const g: Graph = { n, edges, cash, start, pubs };
    const want = bruteBest(g);
    if (want < 0) continue; // ไปไม่ถึงผับเลย โจทย์รับประกันว่าไม่เกิด
    if (byScc(g).answer !== want) throw new Error(`atm-robbery: ท่ายุบองค์ประกอบได้ ${byScc(g).answer} แต่ควรได้ ${want}`);
    done++;
  }
  if (SAMPLE_RUN.answer !== 47) throw new Error('atm-robbery: ตัวอย่างในโจทย์ไม่ได้ 47');
}

/* ---------- ตัวเล่นทีละขั้น เดินองค์ประกอบตามลำดับทอพอโลยี ---------- */
const sampleRows = SAMPLE_RUN.order
