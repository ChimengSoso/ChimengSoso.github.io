<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type AtmGraph = { n: number; edges: [number, number][]; cash: number[]; start: number; pubs: number[] };
  type AtmPuzzle = { id: string; label: string; tease: string; g: AtmGraph; best: number };

  function initAtmGame(): void {
    const maybeUi = cpGameUi('[data-atmgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as AtmPuzzle[];
    if (puzzles.length === 0) return;

    let pi = 0;
    let here = 1;
    let robbed = new Set<number>();

    const pz = (): AtmPuzzle => puzzles[pi];
    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-atm-board]'));
    const canGo = (p: AtmPuzzle, from: number, to: number): boolean => p.g.edges.some((e) => e[0] === from && e[1] === to);
    const money = (p: AtmPuzzle): number => [...robbed].reduce((acc, v) => acc + p.g.cash[v - 1], 0);

    function render(): void {
      const p = pz();
      boards.forEach((b, k) => {
        b.hidden = k !== pi;
      });
      for (const nd of Array.from(boards[pi].querySelectorAll<SVGCircleElement>('[data-atm-node]'))) {
        const id = Number((nd.dataset.atmNode ?? '').split(':')[1]);
        nd.classList.toggle('robbed', robbed.has(id));
        nd.classList.toggle('here', id === here);
        nd.classList.toggle('reach', id !== here && canGo(p, here, id));
      }
      ui.setScore(`ปล้นไปแล้ว ${money(p)} จากตู้ ${robbed.size} ตู้ ตอนนี้อยู่ที่แยก ${here}`);
    }

    function go(id: number): void {
      const p = pz();
      if (!canGo(p, here, id)) {
        ui.setStatus(`จากแยก ${here} ไม่มีถนนทางเดียวที่วิ่งไปแยก ${id}`, 'bad');
        return;
      }
      here = id;
      const isNew = !robbed.has(id);
      robbed.add(id);
      ui.setStatus(
        isNew
          ? `ถึงแยก ${id} และปล้นตู้ได้ ${p.g.cash[id - 1]}`
          : `ถึงแยก ${id} แต่ตู้นี้ปล้นไปแล้ว จึงไม่ได้เงินเพิ่ม`,
        'plain',
      );
      render();
    }

    function check(): void {
      const p = pz();
      if (!p.g.pubs.includes(here)) {
        ui.setStatus(`แยก ${here} ไม่มีผับ ต้องไปจบที่แยกที่มีวงกลมสองชั้น`, 'bad');
        return;
      }
      const got = money(p);
      if (got === p.best) ui.setStatus(`มากที่สุดแล้วครับ ผังนี้ปล้นได้ ${p.best} พอดี`, 'good');
      else ui.setStatus(`เส้นทางนี้ได้ ${got} แต่ผังนี้ปล้นได้ถึง ${p.best} ลองหาวงที่วิ่งกลับมาที่เดิมได้ดู`, 'bad');
    }

    function selectPuzzle(k: number): void {
      pi = k;
      here = puzzles[k].g.start;
      robbed = new Set<number>([here]);
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ui.setStatus(`เริ่มที่ใจกลางเมือง คือแยก ${here} และปล้นตู้แรกไปแล้ว`);
      render();
    }

    ui.root.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const nd = e.target.closest('[data-atm-node]');
      if (!(nd instanceof SVGElement)) return;
      go(Number((nd.dataset.atmNode ?? '').split(':')[1]));
    });

    ui.onClick('data-atm-clear', () => selectPuzzle(pi));
    ui.onClick('data-atm-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initAtmGame);
</script>

