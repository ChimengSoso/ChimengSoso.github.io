---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';

const href = 'pyramid-base/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Obstacle = { x1: number; y1: number; x2: number; y2: number; c: number };
type Case = { M: number; N: number; B: number; obs: Obstacle[] };

const EX1: Case = {
  M: 6,
  N: 9,
  B: 42,
  obs: [
    { x1: 4, y1: 1, x2: 6, y2: 3, c: 12 },
    { x1: 3, y1: 6, x2: 5, y2: 6, c: 9 },
    { x1: 1, y1: 3, x2: 3, y2: 8, c: 24 },
    { x1: 3, y1: 8, x2: 6, y2: 9, c: 21 },
    { x1: 5, y1: 1, x2: 6, y2: 2, c: 20 },
  ],
};
const EX2: Case = {
  M: 13,
  N: 5,
  B: 0,
  obs: [
    { x1: 8, y1: 4, x2: 10, y2: 4, c: 1 },
    { x1: 4, y1: 3, x2: 4, y2: 4, c: 1 },
    { x1: 10, y1: 2, x2: 12, y2: 2, c: 2 },
    { x1: 8, y1: 2, x2: 8, y2: 4, c: 3 },
    { x1: 2, y1: 4, x2: 6, y2: 4, c: 5 },
    { x1: 10, y1: 3, x2: 10, y2: 4, c: 8 },
    { x1: 12, y1: 3, x2: 12, y2: 4, c: 13 },
    { x1: 2, y1: 2, x2: 4, y2: 2, c: 21 },
  ],
};

/** ค่ารื้อของฐานด้าน s ที่มุมล่างซ้าย (x, y) นับตรงตามนิยาม ก้อนที่ทับคิดเงินครั้งเดียว
 *  นี่คือตัวตรวจของทั้งหน้า ทุกวิธีที่ตามมาต้องตรงกับมัน */
const costAt = (cs: Case, s: number, x: number, y: number): number =>
  cs.obs.reduce(
    (t, o) => (x <= o.x2 && x + s - 1 >= o.x1 && y <= o.y2 && y + s - 1 >= o.y1 ? t + o.c : t),
    0,
  );

/** ค่าใช้จ่ายต่ำสุดของฐานด้าน s ทุกตำแหน่ง คืน null ถ้าวางไม่ได้เลย */
function cheapest(cs: Case, s: number): { cost: number; x: number; y: number } | null {
  if (cs.M - s + 1 < 1 || cs.N - s + 1 < 1) return null;
  let best: { cost: number; x: number; y: number } | null = null;
  for (let x = 1; x <= cs.M - s + 1; x++)
    for (let y = 1; y <= cs.N - s + 1; y++) {
      const c = costAt(cs, s, x, y);
      if (best === null || c < best.cost) best = { cost: c, x, y };
    }
  return best;
}
const fitsAt = (cs: Case, s: number): boolean => {
  const r = cheapest(cs, s);
  return r !== null && r.cost <= cs.B;
};

/** คำตอบแบบไล่ทุกขนาด ไม่พึ่งข้อสังเกตว่าขนาดเล็กกว่าต้องวางได้ */
function answerOf(cs: Case): number {
  let best = 0;
  for (let s = 1; s <= Math.min(cs.M, cs.N); s++) if (fitsAt(cs, s)) best = s;
  return best;
}
const ans1 = answerOf(EX1);
const ans2 = answerOf(EX2);

const PMAX = 400000;
const PSUB2 = 30000;
const PSUB1 = 1000;
const GRIDMAX = 1000000;
const fmt = (n: number): string => n.toLocaleString('en-US');
const SUP = '⁰¹²³⁴⁵⁶⁷⁸⁹';
/** เขียนเลขใหญ่แบบ 4 × 10²³ */
function sci(v: number): string {
  const e = Math.floor(Math.log10(v));
  const m = (v / 10 ** e).toFixed(1).replace(/\.0$/, '');
  const pow = `10${String(e)
    .split('')
    .map((d) => SUP[Number(d)])
    .join('')}`;
  return m === '1' ? pow : `${m} × ${pow}`;
}

/* ---------- ตัวอย่างเล็กที่เฉลยใช้ตั้งแต่ตอนที่ 3 ---------- */
const EXS: Case = {
  M: 9,
  N: 5,
  B: 3,
  obs: [
    { x1: 1, y1: 1, x2: 2, y2: 5, c: 5 },
    { x1: 4, y1: 1, x2: 4, y2: 2, c: 3 },
    { x1: 5, y1: 4, x2: 6, y2: 5, c: 4 },
    { x1: 8, y1: 1, x2: 9, y2: 3, c: 6 },
  ],
};
const NAMES = ['A', 'B', 'C', 'D'];
const OB_COL = ['#e0b400', '#60a5fa', '#f472b6', '#a78bfa'];
const SS = answerOf(EXS);
const EXS0: Case = { ...EXS, B: 0 };
const SS0 = answerOf(EXS0);
const SXH = EXS.M - SS + 1;
const SYH = EXS.N - SS + 1;
const exsList = EXS.obs.map(
  (o, i) => `ก้อน ${NAMES[i]}: คอลัมน์ ${o.x1} ถึง ${o.x2} แถว ${o.y1} ถึง ${o.y2} ค่ารื้อ ${o.c}`,
);

/* ---------- มุมที่ฐานทับก้อน คือสี่เหลี่ยมผืนเดียว ---------- */
type Rect = { xl: number; xr: number; yl: number; yh: number };
function cornerRect(cs: Case, s: number, o: Obstacle): Rect | null {
  const XH = cs.M - s + 1;
  const YH = cs.N - s + 1;
  const xl = Math.max(1, o.x1 - s + 1);
  const xr = Math.min(XH, o.x2);
  const yl = Math.max(1, o.y1 - s + 1);
  const yh = Math.min(YH, o.y2);
  return xl <= xr && yl <= yh ? { xl, xr, yl, yh } : null;
}
/* ตรวจตอนบิลด์: ทุกตัวอย่าง ทุกขนาด ทุกมุม ผลรวมของสี่เหลี่ยมที่คลุมมุมนั้นต้องเท่ากับการนับตรง ๆ */
for (const cs of [EX1, EX2, EXS]) {
  for (let s = 1; s <= Math.min(cs.M, cs.N); s++)
    for (let x = 1; x <= cs.M - s + 1; x++)
      for (let y = 1; y <= cs.N - s + 1; y++) {
        const viaRect = cs.obs.reduce((t, o) => {
          const r = cornerRect(cs, s, o);
          return r && x >= r.xl && x <= r.xr && y >= r.yl && y <= r.yh ? t + o.c : t;
        }, 0);
        if (viaRect !== costAt(cs, s, x, y)) throw new Error(`สูตรมุมห้ามไม่ตรงที่ s=${s} (${x}, ${y})`);
      }
}

/* ตัวอย่างคำนวณด้วยมือ: ก้อน C ที่ด้าน SS ต้องใช้ทุกพจน์ของสูตรจริง ๆ */
const WI = 2;
const wo = EXS.obs[WI];
const wRawXl = wo.x1 - SS + 1;
const wRawYl = wo.y1 - SS + 1;
const wRectMaybe = cornerRect(EXS, SS, wo);
if (wRectMaybe === null) throw new Error('ก้อน C ต้องห้ามมุมอย่างน้อยหนึ่งมุม');
const wRect: Rect = wRectMaybe;
if (!(wRawXl > 1 && wRawYl > 1 && wo.y2 > SYH && wo.x2 <= SXH))
  throw new Error('ตัวอย่างก้อน C ต้องเลื่อน s − 1 จริงทั้งสองแกน และถูกตัดที่ขอบบน');
const wDirect: string[] = [];
for (let x = 1; x <= SXH; x++)
  for (let y = 1; y <= SYH; y++)
    if (x <= wo.x2 && x + SS - 1 >= wo.x1 && y <= wo.y2 && y + SS - 1 >= wo.y1) wDirect.push(`${x},${y}`);
const wCount = (wRect.xr - wRect.xl + 1) * (wRect.yh - wRect.yl + 1);
const wInside = wDirect.every((k) => {
  const [x, y] = k.split(',').map(Number);
  return x >= wRect.xl && x <= wRect.xr && y >= wRect.yl && y <= wRect.yh;
});
if (wDirect.length !== wCount || !wInside) throw new Error('สี่เหลี่ยมของก้อน C ไม่ตรงกับการนับตรง ๆ');

/* ---------- กวาดเส้นตามแกน x จำลองตามโค้ดจริงทุกบรรทัด ---------- */
type SwStep = { note: string; x: number; col: number[]; ev: number; ask: boolean; okNow: boolean; what: string; min: number };
type SwRun = { steps: SwStep[]; ok: boolean; minSeen: number; stopX: number; stopY: number; asks: number; dels: number };
function sweepRun(cs: Case, s: number): SwRun {
  const XH = cs.M - s + 1;
  const YH = cs.N - s + 1;
  const col = new Array<number>(YH).fill(0);
  type Ev = { x: number; add: boolean; i: number; r: Rect };
  const evs: Ev[] = [];
  cs.obs.forEach((o, i) => {
    const r = cornerRect(cs, s, o);
    if (!r) return;
    evs.push({ x: r.xl, add: true, i, r });
    if (r.xr + 1 <= XH) evs.push({ x: r.xr + 1, add: false, i, r });
  });
  /* ตำแหน่งเท่ากัน โค้ดหยิบเหตุการณ์เข้าก่อนเหตุการณ์ออก */
  evs.sort((a, b) => a.x - b.x || (a.add === b.add ? a.i - b.i : a.add ? -1 : 1));
  const steps: SwStep[] = [];
  let e = 0;
  let cur = 1;
  let minSeen = Infinity;
  let asks = 0;
  let dels = 0;
  while (cur <= XH) {
    while (e < evs.length && evs[e].x <= cur) {
      const v = evs[e];
      const c = cs.obs[v.i].c;
      for (let y = v.r.yl; y <= v.r.yh; y++) col[y - 1] += v.add ? c : -c;
      if (!v.add) dels++;
      const nm = NAMES[v.i];
      steps.push({
        note: v.add
          ? `x = ${cur} · ${nm} เข้า บวก ${c} ที่ y ${v.r.yl} ถึง ${v.r.yh} · คอลัมน์เป็น [${col.join(', ')}]`
          : `x = ${cur} · ${nm} ออก (ช่วงของมันจบที่ x = ${v.r.xr}) ลบ ${c} ที่ y ${v.r.yl} ถึง ${v.r.yh} · คอลัมน์เป็น [${col.join(', ')}]`,
        x: cur,
        col: [...col],
        ev: v.i,
        ask: false,
        okNow: false,
        what: v.add ? `${nm} เข้า +${c}` : `${nm} ออก −${c}`,
        min: -1,
      });
      e++;
    }
    for (let y = 1; y <= YH; y++)
      if (col[y - 1] !== costAt(cs, s, cur, y)) throw new Error(`กวาดเส้นไม่ตรงการนับตรง ๆ ที่ (${cur}, ${y})`);
    const m = Math.min(...col);
    const my = col.indexOf(m) + 1;
    asks++;
    minSeen = Math.min(minSeen, m);
    const ok = m <= cs.B;
    const nextX = e < evs.length ? evs[e].x : XH + 1;
    steps.push({
      note: ok
        ? `x = ${cur} · ถามราก ได้ค่าน้อยสุด ${m} ที่ y = ${my} ไม่เกินงบ ${cs.B} · ด้าน ${s} วางได้ หยุดกวาด`
        : `x = ${cur} · ถามราก ได้ค่าน้อยสุด ${m} เกินงบ ${cs.B} · ${nextX <= XH ? `ข้ามไป x = ${nextX} ซึ่งมีเหตุการณ์ถัดไป` : 'ไม่มีเหตุการณ์เหลือ ด้านนี้วางไม่ได้'}`,
      x: cur,
      col: [...col],
      ev: -1,
      ask: true,
      okNow: ok,
      what: 'ถามค่าน้อยสุด',
      min: m,
    });
    if (ok) return { steps, ok: true, minSeen, stopX: cur, stopY: my, asks, dels };
    cur = nextX;
  }
  return { steps, ok: false, minSeen, stopX: -1, stopY: -1, asks, dels };
}
const sw = sweepRun(EXS, SS);
const swNext = sweepRun(EXS, SS + 1);
const swNextBest = cheapest(EXS, SS + 1);
if (!sw.ok || sw.asks < 2 || sw.dels < 1) throw new Error('ตัวอย่างกวาดเส้นต้องถามอย่างน้อยสองครั้งและมีก้อนออก');
if (swNext.ok || swNextBest === null || swNext.minSeen !== swNextBest.cost)
  throw new Error('ด้านถัดไปต้องวางไม่ได้ และค่าต่ำสุดที่กวาดเจอต้องเท่ากับการไล่ทุกมุม');
const swLast = sw.steps[sw.steps.length - 1];

/** ผู้สมัครแกน y ตามโค้ด: 1, จุดเริ่มของทุกช่วง และจุดถัดจากปลายช่วง */
function candYs(cs: Case, s: number): number[] {
  const YH = cs.N - s + 1;
  const set = new Set<number>([1]);
  for (const o of cs.obs) {
    const lo = Math.max(1, o.y1 - s + 1);
    const hi = Math.min(YH, o.y2);
    if (lo > hi) continue;
    set.add(lo);
    if (hi + 1 <= YH) set.add(hi + 1);
  }
  return [...set].sort((a, b) => a - b);
}
const exsCand = candYs(EXS, SS);
if (exsCand.length !== SYH) throw new Error('ตัวอย่างนี้ควรมีผู้สมัครครบทุกแถว');

/* ---------- บักใบส่วนเกิน จำลองโค้ดที่ผิดแล้วเทียบ ----------
   ใบส่วนเกินมีเมื่อจำนวนผู้สมัครไม่ใช่กำลังสอง ใบพวกนั้นไม่เคยถูกบวกอะไรเลย รากจึงเห็นศูนย์ตลอด */
const isPow2 = (k: number): boolean => (k & (k - 1)) === 0;
const brokenOk = (cs: Case, s: number): boolean =>
  cs.M - s + 1 >= 1 && cs.N - s + 1 >= 1 && (!isPow2(candYs(cs, s).length) || fitsAt(cs, s));
type Asked = { s: number; real: boolean; broken: boolean };
function bsearch(cs: Case, ok: (cs: Case, s: number) => boolean): { ans: number; asked: Asked[] } {
  let lo = 0;
  let hi = Math.min(cs.M, cs.N);
  const asked: Asked[] = [];
  while (lo < hi) {
    const md = Math.floor((lo + hi + 1) / 2);
    const r = ok(cs, md);
    asked.push({ s: md, real: fitsAt(cs, md), broken: brokenOk(cs, md) });
    if (r) lo = md;
    else hi = md - 1;
  }
  return { ans: lo, asked };
}
const BAD: Case = {
  M: 9,
  N: 6,
  B: 10,
  obs: [
    { x1: 2, y1: 5, x2: 4, y2: 5, c: 8 },
    { x1: 4, y1: 4, x2: 7, y2: 5, c: 3 },
    { x1: 6, y1: 2, x2: 9, y2: 6, c: 8 },
    { x1: 4, y1: 4, x2: 4, y2: 6, c: 9 },
    { x1: 7, y1: 6, x2: 7, y2: 6, c: 5 },
    { x1: 4, y1: 6, x2: 7, y2: 6, c: 4 },
  ],
};
const badReal = answerOf(BAD);
const badBroken = bsearch(BAD, brokenOk).ans;
const badCostAt = cheapest(BAD, badBroken);
if (badReal === badBroken || badCostAt === null || badCostAt.cost <= BAD.B)
  throw new Error('เคสที่จับบักได้ต้องทำให้โค้ดผิดตอบเกินจริง');
for (const [cs, a] of [
  [EX1, ans1],
  [EX2, ans2],
] as const) {
  const b = bsearch(cs, brokenOk);
  if (b.ans !== a || b.asked.some((q) => q.broken !== q.real))
    throw new Error('โค้ดที่ผิดควรตอบตัวอย่างของโจทย์ถูก โดยทุกรอบที่ถามตรงกับของจริง');
}
const brokenInput = [`${BAD.M} ${BAD.N}`, String(BAD.B), String(BAD.obs.length), ...BAD.obs.map((o) => [o.x1, o.y1, o.x2, o.y2, o.c].join(' '))].join('\n');

/* ---------- สองตัวชี้บนตัวอย่างเดิมที่ตั้งงบเป็นศูนย์ ---------- */
type TpRow = {
  r: number;
  added: string;
  removed: string;
  l: number;
  run: number;
  width: number;
  best: number;
  up: boolean;
  line: string;
  active: number[];
};
function longestFree(cover: number[]): number {
  let best = 0;
  let run = 0;
  for (const c of cover) {
    run = c === 0 ? run + 1 : 0;
    best = Math.max(best, run);
  }
  return best;
}
function twoPointer(cs: Case): { rows: TpRow[]; best: number } {
  const cover = new Array<number>(cs.N).fill(0);
  const active = new Set<number>();
  const touch = (o: Obstacle, d: number): void => {
    for (let y = o.y1; y <= o.y2; y++) cover[y - 1] += d;
  };
  let l = 1;
  let best = 0;
  const rows: TpRow[] = [];
  for (let r = 1; r <= cs.M; r++) {
    const added: string[] = [];
    const removed: string[] = [];
    cs.obs.forEach((o, i) => {
      if (o.x1 === r) {
        touch(o, 1);
        active.add(i);
        added.push(NAMES[i] ?? String(i + 1));
      }
    });
    const lBefore = l;
    const runBefore = longestFree(cover);
    while (longestFree(cover) < r - l + 1) {
      cs.obs.forEach((o, i) => {
        if (o.x2 === l) {
          touch(o, -1);
          active.delete(i);
          removed.push(NAMES[i] ?? String(i + 1));
        }
      });
      l++;
    }
    const width = r - l + 1;
    const up = width > best;
    best = Math.max(best, width);
    const run = longestFree(cover);
    const head = `r = ${r}${added.length ? ` · ${added.join(', ')} เข้า` : ''}`;
    const mid =
      l !== lBefore
        ? `แถวว่าง ${runBefore} สั้นกว่ากว้าง ${r - lBefore + 1} ขยับ l จาก ${lBefore} เป็น ${l}${removed.length ? ` (${removed.join(', ')} หลุด)` : ''}`
        : `แถวว่าง ${run} พอสำหรับกว้าง ${width}`;
    rows.push({
      r,
      added: added.join(', '),
      removed: removed.join(', '),
      l,
      run,
      width,
      best,
      up,
      line: `${head} · ${mid} · ดีที่สุด ${best}`,
      active: [...active],
    });
  }
  return { rows, best };
}
const tp = twoPointer(EXS0);
if (tp.best !== SS0 || twoPointer(EX2).best !== ans2) throw new Error('สองตัวชี้ไม่ตรงกับการไล่ทุกขนาด');
if (!tp.rows.some((r) => r.removed !== '')) throw new Error('ตัวอย่างสองตัวชี้ต้องมีก้อนหลุดออก');

/* ---------- ต่อค่าของต้นไม้แถวว่าง จำลองตาม zpull ของโค้ด ---------- */
type ZNode = { l: number; r: number; pre: number; suf: number; bst: number };
function zNode(cover: number[], l: number, r: number): ZNode {
  /* ไม่ใช้ longestFree เพื่อให้เป็นการคิดคนละทางกับตัวตรวจ */
  if (l === r) {
    const v = cover[l - 1] === 0 ? 1 : 0;
    return { l, r, pre: v, suf: v, bst: v };
  }
  const m = Math.floor((l + r) / 2);
  const a = zNode(cover, l, m);
  const b = zNode(cover, m + 1, r);
  const la = m - l + 1;
  const lb = r - m;
  return {
    l,
    r,
    pre: a.pre === la ? la + b.pre : a.pre,
    suf: b.suf === lb ? lb + a.suf : b.suf,
    bst: Math.max(a.bst, b.bst, a.suf + b.pre),
  };
}
const mergeRowMaybe = tp.rows.find((row) => row.added !== '' && row.run > 0 && row.run < EXS.N);
if (!mergeRowMaybe) throw new Error('ต้องมีแถวที่มีก้อนเข้าแล้วยังเหลือแถวว่าง');
const mergeRow = mergeRowMaybe;
const mergeCover = new Array<number>(EXS.N).fill(0);
for (const i of mergeRow.active) for (let y = EXS.obs[i].y1; y <= EXS.obs[i].y2; y++) mergeCover[y - 1]++;
const zMid = Math.floor((1 + EXS.N) / 2);
const zA = zNode(mergeCover, 1, zMid);
const zB = zNode(mergeCover, zMid + 1, EXS.N);
const zRoot = zNode(mergeCover, 1, EXS.N);
if (zRoot.bst !== mergeRow.run) throw new Error('การต่อค่าของต้นไม้แถวว่างไม่ตรงกับการนับตรง ๆ');
if (zA.suf + zB.pre <= Math.max(zA.bst, zB.bst)) throw new Error('ตัวอย่างการต่อค่าควรได้คำตอบจากรอยต่อ');
const mergeFree = mergeCover.map((c, i) => (c === 0 ? i + 1 : 0)).filter((y) => y > 0);

