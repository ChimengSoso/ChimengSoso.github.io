<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type PbObstacle = { x1: number; y1: number; x2: number; y2: number; c: number };
  type PbPuzzle = {
    id: string;
    label: string;
    tease: string;
    m: number;
    n: number;
    b: number;
    obs: PbObstacle[];
    answer: number;
  };

  function initPyramidGame(): void {
    const maybeUi = cpGameUi('[data-pbgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as PbPuzzle[];
    if (puzzles.length === 0) return;

    const boardEl = ui.root.querySelector<HTMLElement>('[data-pb-board]');
    const sideEl = ui.root.querySelector<HTMLElement>('[data-pb-side]');
    const costEl = ui.root.querySelector<HTMLElement>('[data-pb-cost]');
    const budgetEl = ui.root.querySelector<HTMLElement>('[data-pb-budget]');
    const bestEl = ui.root.querySelector<HTMLElement>('[data-pb-best]');
    const minusEl = ui.root.querySelector<HTMLElement>('[data-pb-minus]');
    const plusEl = ui.root.querySelector<HTMLElement>('[data-pb-plus]');
    if (!boardEl || !sideEl || !costEl || !budgetEl || !bestEl || !minusEl || !plusEl) return;
    const board: HTMLElement = boardEl;
    const sideOut: HTMLElement = sideEl;
    const costOut: HTMLElement = costEl;
    const budgetOut: HTMLElement = budgetEl;
    const bestOut: HTMLElement = bestEl;

    let pi = 0;
    let x = 1;
    let y = 1;
    let s = 1;
    let bestFound = 0;

    const pz = (): PbPuzzle => puzzles[pi];

    function hitObstacles(): PbObstacle[] {
      const p = pz();
      return p.obs.filter((o) => x <= o.x2 && x + s - 1 >= o.x1 && y <= o.y2 && y + s - 1 >= o.y1);
    }
    const costNow = (): number => hitObstacles().reduce((t, o) => t + o.c, 0);

    function clamp(): void {
      const p = pz();
      s = Math.max(1, Math.min(Math.min(p.m, p.n), s));
      x = Math.max(1, Math.min(p.m - s + 1, x));
      y = Math.max(1, Math.min(p.n - s + 1, y));
    }

    function buildBoard(): void {
      const p = pz();
      board.textContent = '';
      /* วาดจากแถวบนลงล่าง แต่พิกัด y ของโจทย์นับจากล่างขึ้นบน จึงกลับลำดับตอนวาด */
      for (let row = p.n; row >= 1; row--) {
        const tr = document.createElement('div');
        tr.className = 'pb-row';
        for (let col = 1; col <= p.m; col++) {
          const cell = document.createElement('button');
          cell.type = 'button';
          cell.className = 'pb-cell';
          cell.dataset.x = String(col);
          cell.dataset.y = String(row);
          const on = p.obs.filter((o) => col >= o.x1 && col <= o.x2 && row >= o.y1 && row <= o.y2);
          if (on.length > 0) {
            cell.classList.add('rock');
            cell.textContent = String(on.reduce((t, o) => t + o.c, 0));
          }
          cell.setAttribute('aria-label', `ช่อง ${col} ${row}`);
          tr.appendChild(cell);
        }
        board.appendChild(tr);
      }
    }

    function render(): void {
      clamp();
      const p = pz();
      const cost = costNow();
      const over = cost > p.b;
      for (const cell of Array.from(board.querySelectorAll<HTMLElement>('.pb-cell'))) {
        const cx = Number(cell.dataset.x);
        const cy = Number(cell.dataset.y);
        const inside = cx >= x && cx < x + s && cy >= y && cy < y + s;
        cell.classList.toggle('in', inside && !over);
        cell.classList.toggle('over', inside && over);
      }
      sideOut.textContent = String(s);
      costOut.textContent = String(cost);
      budgetOut.textContent = String(p.b);
      bestOut.textContent = String(bestFound);
    }

    function check(): void {
      const p = pz();
      const cost = costNow();
      if (cost > p.b) {
        ui.setStatus(`ด้าน ${s} ตรงนี้ต้องจ่าย ${cost} ซึ่งเกินงบ ${p.b}`, 'bad');
        return;
      }
      if (s > bestFound) bestFound = s;
      if (s === p.answer) {
        ui.setStatus(`ใช่ครับ ด้าน ${s} คือฐานที่ใหญ่ที่สุดที่งบนี้วางได้`, 'good');
      } else {
        ui.setStatus(`ด้าน ${s} วางได้จริงในงบ แต่ยังมีที่ที่วางได้ใหญ่กว่านี้`, 'good');
      }
      render();
    }

    function selectPuzzle(k: number): void {
      pi = k;
      x = 1;
      y = 1;
      s = 1;
      bestFound = 0;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildBoard();
      ui.setStatus('คลิกช่องเพื่อวางมุมล่างซ้ายของฐาน แล้วปรับด้านยาว ตัวเลขในช่องคือค่ารื้อของก้อนนั้น');
      render();
    }

    board.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const cell = e.target.closest('.pb-cell');
      if (!(cell instanceof HTMLElement)) return;
      x = Number(cell.dataset.x);
      y = Number(cell.dataset.y);
      ui.setStatus('คลิกช่องเพื่อวางมุมล่างซ้ายของฐาน แล้วปรับด้านยาว ตัวเลขในช่องคือค่ารื้อของก้อนนั้น');
      render();
    });
    minusEl.addEventListener('click', () => {
      s -= 1;
      render();
    });
    plusEl.addEventListener('click', () => {
      s += 1;
      render();
    });

    ui.onClick('data-pb-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initPyramidGame);
</script>
