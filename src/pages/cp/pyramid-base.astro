      continue;
    }
    const o = cs.obs[st.ev];
    const rr = cornerRect(cs, s, o);
    if (!rr) continue;
    const add = st.what.includes('เข้า');
    const v = add ? o.c : -o.c;
    let L = leafOf(rr.yl) + sz;
    let R = leafOf(rr.yh) + sz + 1;
    const l0 = L;
    const r0 = R - 1;
    const touched: number[] = [];
    while (L < R) {
      if (L & 1) {
        mn[L] += v;
        lz[L] += v;
        touched.push(L);
        L++;
      }
      if (R & 1) {
        --R;
        mn[R] += v;
        lz[R] += v;
        touched.push(R);
      }
      L >>= 1;
      R >>= 1;
    }
    for (let i = l0 >> 1; i >= 1; i >>= 1) mn[i] = Math.min(mn[2 * i], mn[2 * i + 1]) + lz[i];
    for (let i = r0 >> 1; i >= 1; i >>= 1) mn[i] = Math.min(mn[2 * i], mn[2 * i + 1]) + lz[i];
    evs.push({ what: `${st.what} ที่ y ${rr.yl} ถึง ${rr.yh}`, touched });
  }
  return { sz, k, mn, lz, evs };
