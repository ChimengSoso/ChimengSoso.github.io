---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const href = 'pyramid-base/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Obstacle = { x1: number; y1: number; x2: number; y2: number; c: number };
type Case = { M: number; N: number; B: number; obs: Obstacle[] };

const EX1: Case = {
  M: 6,
  N: 9,
  B: 42,
  obs: [
    { x1: 4, y1: 1, x2: 6, y2: 3, c: 12 },
    { x1: 3, y1: 6, x2: 5, y2: 6, c: 9 },
    { x1: 1, y1: 3, x2: 3, y2: 8, c: 24 },
    { x1: 3, y1: 8, x2: 6, y2: 9, c: 21 },
    { x1: 5, y1: 1, x2: 6, y2: 2, c: 20 },
  ],
};
const EX2: Case = {
  M: 13,
  N: 5,
  B: 0,
  obs: [
    { x1: 8, y1: 4, x2: 10, y2: 4, c: 1 },
    { x1: 4, y1: 3, x2: 4, y2: 4, c: 1 },
    { x1: 10, y1: 2, x2: 12, y2: 2, c: 2 },
    { x1: 8, y1: 2, x2: 8, y2: 4, c: 3 },
    { x1: 2, y1: 4, x2: 6, y2: 4, c: 5 },
    { x1: 10, y1: 3, x2: 10, y2: 4, c: 8 },
    { x1: 12, y1: 3, x2: 12, y2: 4, c: 13 },
    { x1: 2, y1: 2, x2: 4, y2: 2, c: 21 },
  ],
};

/** ค่าใช้จ่ายของจัตุรัสด้าน s ที่มุมล่างซ้ายอยู่ที่ (x, y) */
const costAt = (cs: Case, s: number, x: number, y: number): number =>
  cs.obs.reduce(
    (t, o) => (x <= o.x2 && x + s - 1 >= o.x1 && y <= o.y2 && y + s - 1 >= o.y1 ? t + o.c : t),
    0,
  );

/** ค่าใช้จ่ายต่ำสุดของจัตุรัสด้าน s ทุกตำแหน่ง คืน null ถ้าวางไม่ได้เลย */
function cheapest(cs: Case, s: number): { cost: number; x: number; y: number } | null {
  if (cs.M - s + 1 < 1 || cs.N - s + 1 < 1) return null;
  let best: { cost: number; x: number; y: number } | null = null;
  for (let x = 1; x <= cs.M - s + 1; x++)
    for (let y = 1; y <= cs.N - s + 1; y++) {
      const c = costAt(cs, s, x, y);
      if (best === null || c < best.cost) best = { cost: c, x, y };
    }
  return best;
}

/* ---------- มินิเกม เลื่อนฐานปิรามิดเอง ----------
   ค่าใช้จ่ายของทุกตำแหน่งคิดด้วย costAt ตัวเดียวกับที่บทความใช้
   ส่วนคำตอบของแต่ละชุดหาโดยไล่ทุกขนาดทุกตำแหน่งตรง ๆ ตอนบิลด์ */
type PbPuzzle = { id: string; label: string; tease: string; cs: Case };

/** ด้านที่ใหญ่ที่สุดที่วางได้ในงบ ไล่ทุกขนาดทุกตำแหน่ง */
function biggestSide(cs: Case): number {
  let best = 0;
  const lim = Math.min(cs.M, cs.N);
  for (let s = 1; s <= lim; s++) {
    const c = cheapest(cs, s);
    if (c && c.cost <= cs.B) best = s;
  }
  return best;
}

const PB_PUZZLES: PbPuzzle[] = [
  { id: 'b1', label: 'ชุดที่ 1 · ตัวอย่างแรก', tease: 'ตารางเดียวกับตัวอย่างแรกของโจทย์ งบ 42', cs: EX1 },
  { id: 'b2', label: 'ชุดที่ 2 · ตัวอย่างที่สอง', tease: 'ชุดนี้งบเป็นศูนย์ ต้องหาที่โล่งล้วน ๆ', cs: EX2 },
  {
    id: 'b3',
    label: 'ชุดที่ 3 · งบพอดีเป๊ะ',
    tease: 'ชุดนี้ถ้าเลือกตำแหน่งพลาดนิดเดียวก็เกินงบทันที',
    cs: {
      M: 6,
      N: 6,
      B: 5,
      obs: [
        { x1: 1, y1: 1, x2: 2, y2: 6, c: 6 },
        { x1: 4, y1: 4, x2: 4, y2: 4, c: 5 },
        { x1: 6, y1: 1, x2: 6, y2: 6, c: 4 },
      ],
    },
  },
];

type PbPuzzleData = {
  id: string;
  label: string;
  tease: string;
  m: number;
  n: number;
  b: number;
  obs: Obstacle[];
  answer: number;
};
const pbPuzzles: PbPuzzleData[] = PB_PUZZLES.map((p) => ({
  id: p.id,
  label: p.label,
  tease: p.tease,
  m: p.cs.M,
  n: p.cs.N,
  b: p.cs.B,
  obs: p.cs.obs,
  answer: biggestSide(p.cs),
}));
const pbJson = JSON.stringify(pbPuzzles);

function answerOf(cs: Case): number {
  let best = 0;
  for (let s = 1; s <= Math.min(cs.M, cs.N); s++) {
    const r = cheapest(cs, s);
    if (r !== null && r.cost <= cs.B) best = s;
  }
  return best;
}
const ans1 = answerOf(EX1);

/* ---------- ภาพผังของตัวอย่างที่ 1 ----------
   ตำแหน่งฐานที่วาดมาจาก cheapest() ตัวเดียวกับที่หน้านี้ใช้หาคำตอบ
   จึงเป็นจุดที่ถูกที่สุดจริงสำหรับด้านยาว ans1 ไม่ใช่จุดที่เลือกด้วยตา */
const bestSpot = cheapest(EX1, ans1);
const CELL = 32;
const GX = 44;
const GY = 34;
const gx = (x: number): number => GX + (x - 1) * CELL;
const gy = (y: number): number => GY + (y - 1) * CELL;
const pbVB = `0 0 ${gx(EX1.M + 1) + 112} ${gy(EX1.N + 1) + 46}`;
const obsInBase = (o: Obstacle): boolean =>
  bestSpot !== null &&
  o.x2 >= bestSpot.x &&
  o.x1 <= bestSpot.x + ans1 - 1 &&
  o.y2 >= bestSpot.y &&
  o.y1 <= bestSpot.y + ans1 - 1;

const ans2 = answerOf(EX2);

/** ตารางที่แสดงว่าค่าใช้จ่ายต่ำสุดเพิ่มขึ้นตาม s ซึ่งเป็นเหตุผลที่ค้นหาแบบไบนารีได้ */
const ladder = Array.from({ length: Math.min(EX1.M, EX1.N) }, (_, i) => i + 1).map((s) => {
  const r = cheapest(EX1, s);
  return { s, cost: r === null ? null : r.cost, pos: r === null ? '' : `(${r.x}, ${r.y})` };
});

const PMAX = 400000;
const GRIDMAX = 1000000;
const fmt = (n: number): string => n.toLocaleString('en-US');

const solution = `#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
int P; ll M,N,B;
vector<ll> X1,Y1,X2,Y2,C;
vector<int> byX1,byX2,byY1,byY2;
int SZ; vector<ll> mn,lz;
const ll INF=(ll)4e18;
void build(int k){
    SZ=1; while(SZ<k) SZ<<=1;
    mn.assign(2*SZ,0); lz.assign(2*SZ,0);
    for(int i=k;i<SZ;i++) mn[SZ+i]=INF;             // ใบส่วนเกินต้องเป็นอนันต์ ไม่ใช่ศูนย์
    for(int i=SZ-1;i>=1;i--) mn[i]=min(mn[2*i],mn[2*i+1]);
}
// บวกทั้งช่วงแบบไล่จากใบขึ้นราก ไม่ใช้การเรียกซ้ำ เพราะรอบนี้ถูกเรียกหลายสิบล้านครั้ง
void add(int l,int r,ll v){
    int L=l+SZ, R=r+SZ+1, l0=L, r0=R-1;
    while(L<R){
        if(L&1){ mn[L]+=v; lz[L]+=v; L++; }
        if(R&1){ --R; mn[R]+=v; lz[R]+=v; }
        L>>=1; R>>=1;
    }
    for(int i=l0>>1;i>=1;i>>=1) mn[i]=min(mn[2*i],mn[2*i+1])+lz[i];
    for(int i=r0>>1;i>=1;i>>=1) mn[i]=min(mn[2*i],mn[2*i+1])+lz[i];
}
vector<ll> cand; vector<int> klOf,krOf;
vector<ll> evX; vector<int> evI; vector<char> evAdd;
bool ok(ll s){
    if(M-s+1<1||N-s+1<1) return false;
    const ll YH=N-s+1, XH=M-s+1;
    // ผู้สมัครแกน y  รวมสองสายที่เรียงอยู่แล้ว จึงไม่ต้องเรียงใหม่ทุกรอบ
    cand.clear(); cand.push_back(1);
    { size_t a=0,b=0; ll va,vb;
      auto nextA=[&](){ while(a<(size_t)P){ int i=byY1[a]; ll lo=max(1LL,Y1[i]-s+1), hi=min(YH,Y2[i]); a++; if(lo<=hi){ va=lo; return true; } } return false; };
      auto nextB=[&](){ while(b<(size_t)P){ int i=byY2[b]; ll lo=max(1LL,Y1[i]-s+1), hi=min(YH,Y2[i]); b++; if(lo<=hi&&hi+1<=YH){ vb=hi+1; return true; } } return false; };
      bool ha=nextA(), hb=nextB();
      while(ha||hb){ ll v; if(!hb||(ha&&va<=vb)){ v=va; ha=nextA(); } else { v=vb; hb=nextB(); }
        if(cand.back()!=v) cand.push_back(v); } }
    int K=(int)cand.size(); build(K);
    // ดัชนีขอบล่าง/ขอบบนของแต่ละก้อน หาแบบสองตัวชี้ เพราะทั้งสองสายเรียงมาแล้ว
    { size_t p=0; for(int t=0;t<P;t++){ int i=byY1[t]; ll lo=max(1LL,Y1[i]-s+1), hi=min(YH,Y2[i]); if(lo>hi){ klOf[i]=-1; continue; }
        while(p+1<cand.size()&&cand[p+1]<=lo) p++; while(cand[p]>lo&&p>0) p--; klOf[i]=(int)p; } }
    { size_t p=0; for(int t=0;t<P;t++){ int i=byY2[t]; ll lo=max(1LL,Y1[i]-s+1), hi=min(YH,Y2[i]); if(lo>hi){ krOf[i]=-1; continue; }
        while(p+1<cand.size()&&cand[p+1]<=hi) p++; krOf[i]=(int)p; } }
    // เหตุการณ์แกน x  สองสายเรียงอยู่แล้วเช่นกัน จึงแค่ผสาน
    evX.clear(); evI.clear(); evAdd.clear();
    { size_t a=0,b=0;
      auto valA=[&](size_t t){ int i=byX1[t]; return max(1LL,X1[i]-s+1); };
      auto valB=[&](size_t t){ int i=byX2[t]; return min(XH,X2[i])+1; };
      auto usable=[&](int i){ ll xl=max(1LL,X1[i]-s+1), xr=min(XH,X2[i]); return klOf[i]>=0 && xl<=xr; };
      while(a<(size_t)P||b<(size_t)P){
        bool takeA;
        if(a>=(size_t)P) takeA=false; else if(b>=(size_t)P) takeA=true; else takeA = valA(a)<=valB(b);
        if(takeA){ int i=byX1[a]; if(usable(i)){ evX.push_back(valA(a)); evI.push_back(i); evAdd.push_back(1);} a++; }
        else { int i=byX2[b]; ll v=valB(b); if(usable(i)&&v<=XH){ evX.push_back(v); evI.push_back(i); evAdd.push_back(0);} b++; }
      } }
    size_t e=0; ll cur=1;
    while(cur<=XH){
        while(e<evX.size()&&evX[e]<=cur){ int i=evI[e]; add(klOf[i],krOf[i], evAdd[e]?C[i]:-C[i]); e++; }
        if(mn[1]<=B) return true;
        cur = (e<evX.size()) ? evX[e] : XH+1;
    }
    return false;
}
int main(){
    if(scanf("%lld %lld",&M,&N)!=2) return 0;
    scanf("%lld",&B); scanf("%d",&P);
    X1.resize(P);Y1.resize(P);X2.resize(P);Y2.resize(P);C.resize(P);
    klOf.assign(P,-1); krOf.assign(P,-1);
    for(int i=0;i<P;i++) scanf("%lld %lld %lld %lld %lld",&X1[i],&Y1[i],&X2[i],&Y2[i],&C[i]);
    byX1.resize(P);byX2.resize(P);byY1.resize(P);byY2.resize(P);
    for(int i=0;i<P;i++) byX1[i]=byX2[i]=byY1[i]=byY2[i]=i;
    sort(byX1.begin(),byX1.end(),[](int a,int b){return X1[a]<X1[b];});
    sort(byX2.begin(),byX2.end(),[](int a,int b){return X2[a]<X2[b];});
    sort(byY1.begin(),byY1.end(),[](int a,int b){return Y1[a]<Y1[b];});
    sort(byY2.begin(),byY2.end(),[](int a,int b){return Y2[a]<Y2[b];});
    ll lo=0,hi=min(M,N);
    while(lo<hi){ ll md=(lo+hi+1)/2; if(ok(md)) lo=md; else hi=md-1; }
    printf("%lld\\n",lo);
}`;
const subCode = `// เฉลยชุดทดสอบย่อยชุดแรก งบเป็นศูนย์ และสิ่งกีดขวางไม่เกิน 1,000 ก้อน (35 คะแนน)
// งบเป็นศูนย์แปลว่าห้ามชนก้อนไหนเลย คำถามจึงเหลือแค่ "มีที่ว่างขนาดนี้ไหม"
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
int P; ll M, N;
vector<ll> x1_, y1_, x2_, y2_;

bool ok(ll s) {
    if (M - s + 1 < 1 || N - s + 1 < 1) return false;
    const ll XH = M - s + 1, YH = N - s + 1;
    // มุมล่างซ้ายที่น่าลองมีแค่ 1 กับขอบซ้ายของแต่ละก้อนที่เลื่อนมา s-1 ช่อง
    vector<ll> xs{1};
    for (int i = 0; i < P; i++) { ll v = x2_[i] + 1; if (v <= XH) xs.push_back(v); }
    sort(xs.begin(), xs.end()); xs.erase(unique(xs.begin(), xs.end()), xs.end());

    vector<pair<ll,ll>> bad;
    for (ll x : xs) {
        bad.clear();
        for (int i = 0; i < P; i++) {
            if (x + s - 1 < x1_[i] || x > x2_[i]) continue;          // ก้อนนี้ไม่ขวางที่คอลัมน์นี้
            ll lo = max(1LL, y1_[i] - s + 1), hi = min(YH, y2_[i]);
            if (lo <= hi) bad.push_back({lo, hi});
        }
        sort(bad.begin(), bad.end());
        ll cur = 1;                                                  // ไล่หาช่องว่างแรกที่ไม่มีใครทับ
        for (auto& [lo, hi] : bad) {
            if (lo > cur) break;
            cur = max(cur, hi + 1);
        }
        if (cur <= YH) return true;
    }
    return false;
}

int main() {
    ll B;
    scanf("%lld %lld %lld %d", &M, &N, &B, &P);
    x1_.resize(P); y1_.resize(P); x2_.resize(P); y2_.resize(P);
    for (int i = 0; i < P; i++) { ll c; scanf("%lld %lld %lld %lld %lld", &x1_[i], &y1_[i], &x2_[i], &y2_[i], &c); }
    ll lo = 0, hi = min(M, N);
    while (lo < hi) { ll md = (lo + hi + 1) / 2; if (ok(md)) lo = md; else hi = md - 1; }
    printf("%lld\\n", lo);
}`;
const coreSnippet = `// s ใหญ่ขึ้น ค่าใช้จ่ายก็ไม่มีทางถูกลง เพราะจัตุรัสเล็กที่ซ้อนอยู่ข้างในย่อมชนก้อนไม่มากกว่า
// เงื่อนไข "มีที่วางได้" จึงเป็นจริงเรียงติดกันแล้วเท็จตลอด ค้นหาแบบไบนารีได้
ll lo = 0, hi = min(M, N);
while (lo < hi) {
    ll md = (lo + hi + 1) / 2;
    if (ok(md)) lo = md; else hi = md - 1;
}`;
---
<CpProblemLayout href={href}>
  <h2>โจทย์ · หาที่วางฐานปิรามิดให้ใหญ่ที่สุดในงบที่มี</h2>
  <p>
    พื้นที่สำรวจเป็นตารางขนาด <code>M × N</code> ช่อง ฐานปิรามิดต้องเป็น<strong>จัตุรัส</strong>ที่ด้านขนานกับเส้นตาราง
    บนพื้นที่มีสิ่งกีดขวาง <code>P</code> ก้อน แต่ละก้อนเป็นสี่เหลี่ยมในตาราง (ทับซ้อนกันได้)
    การทำลายก้อนที่ <code>i</code> เสียค่าใช้จ่าย <code>C</code> และต้องทำลาย<strong>ทั้งก้อน</strong>
    จะทุบแค่ส่วนที่ขวางไม่ได้
  </p>
  <p>
    เรามีงบ <code>B</code> งานคือหา<strong>ด้านที่ยาวที่สุด</strong>ของฐานปิรามิดที่วางได้
    โดยค่าทำลายสิ่งกีดขวางที่ทับพื้นที่ฐานรวมแล้วไม่เกินงบ ถ้าวางไม่ได้เลยให้ตอบ 0
  </p>

  <div class="callout callout-note spec">
    <p class="callout-label">อินพุต / ขอบเขต / เอาต์พุต</p>
    <ul>
      <li>
        <strong>อินพุต:</strong> บรรทัดที่ 1 คือ <code>M</code> และ <code>N</code> บรรทัดที่ 2 คือ <code>B</code>
        บรรทัดที่ 3 คือ <code>P</code> จากนั้น <code>P</code> บรรทัด แต่ละบรรทัดคือพิกัดมุมล่างซ้าย มุมบนขวา
        และค่าทำลายของก้อนนั้น
      </li>
      <li>
        <strong>ขอบเขต:</strong> <code>M, N ≤ {fmt(GRIDMAX)}</code>, <code>C ≤ 7,000</code>
        เวลา 5 วินาที หน่วยความจำ 256 เมกะไบต์
      </li>
      <li><strong>เอาต์พุต:</strong> ความยาวด้านของฐานที่ยาวที่สุด หรือ 0</li>
      <li>
        <strong>ให้คะแนน:</strong> แบ่งเป็นสามชุด ชุดแรก 35 คะแนน <code>B = 0</code> และ <code>P ≤ 1,000</code>
        ชุดที่สอง 35 คะแนน <code>B ≤ 2,000,000,000</code> และ <code>P ≤ 30,000</code>
        ชุดที่สาม 30 คะแนน <code>B = 0</code> และ <code>P ≤ {fmt(PMAX)}</code>
      </li>
    </ul>
  </div>

  <table class="io">
    <caption>EXAMPLE</caption>
    <thead><tr><th>Input</th><th>Output</th></tr></thead>
    <tbody>
      <tr>
        <td>
          {EX1.M} {EX1.N}<br />{EX1.B}<br />{EX1.obs.length}<br />
          {EX1.obs.map((o) => <>{o.x1} {o.y1} {o.x2} {o.y2} {o.c}<br /></>)}
        </td>
        <td>{ans1}</td>
      </tr>
      <tr>
        <td>
          {EX2.M} {EX2.N}<br />{EX2.B}<br />{EX2.obs.length}<br />
          {EX2.obs.map((o) => <>{o.x1} {o.y1} {o.x2} {o.y2} {o.c}<br /></>)}
        </td>
        <td>{ans2}</td>
      </tr>
    </tbody>
  </table>

  <div class="callout callout-tip">
    <p class="callout-label">ใบ้</p>
    <p>
      ตารางใหญ่ได้ถึงล้านคูณล้าน แปลว่าเราจะไม่มีวันแตะทุกช่องได้ แต่สิ่งกีดขวางมีแค่ไม่กี่แสนก้อน
      ข้อมูลจริงที่มีอยู่จึงน้อยกว่าตารางมหาศาล
