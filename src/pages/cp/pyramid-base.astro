    for (int i = SZ - 1; i >= 1; i--) mn[i] = min(mn[2 * i], mn[2 * i + 1]);
}

// ปลายทางที่บักโผล่ อยู่ในลูปกวาดเส้นของ ok()
if (mn[1] <= B) return true;   // ถ้าต้นไม้มีใบส่วนเกิน mn[1] เป็นศูนย์เสมอ บรรทัดนี้จึงตอบ true`;
