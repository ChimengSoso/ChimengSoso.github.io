function treeTrace(cs: Case, s: number): { sz: number; k: number; mn: number[]; lz: number[]; evs: TreeEv[] } {
  const cand = candYs(cs, s);
  const k = cand.length;
  let sz = 1;
  while (sz < k) sz <<= 1;
  const mn = new Array<number>(2 * sz).fill(0);
  const lz = new Array<number>(2 * sz).fill(0);
  for (let i = k; i < sz; i++) mn[sz + i] = Infinity;
  for (let i = sz - 1; i >= 1; i--) mn[i] = Math.min(mn[2 * i], mn[2 * i + 1]);
  const leafOf = (y: number): number => {
    let p = 0;
    while (p + 1 < cand.length && cand[p + 1] <= y) p++;
    return p;
  };
  const evs: TreeEv[] = [];
  /* เล่นเหตุการณ์ตามลำดับเดียวกับเครื่องเดินของตอนที่ 5 */
