    .mt-board{min-width:420px;}
  }
  .mt-edge{stroke:#3d4a6b;stroke-width:3;}
  .mt-edge.cut{stroke:#b23b3b;stroke-width:3;stroke-dasharray:7 5;}
  .mt-edge.added{stroke:#2f9e5c;stroke-width:3;}
  .mt-hit{stroke:transparent;stroke-width:16;cursor:pointer;}
  .mt-node{fill:#121a2b;stroke:#2a3350;cursor:pointer;}
  .mt-node.sideA{fill:#12233a;stroke:#3d6ea5;}
  .mt-node.sideB{fill:#1c2536;stroke:#7a6a3a;}
  .mt-node.pick{stroke:var(--dl-emerald-bright);stroke-width:3;}
  .mt-lbl{fill:#cdd6ea;font-size:12px;font-family:"Fira Code","Fira Mono",monospace;pointer-events:none;}
