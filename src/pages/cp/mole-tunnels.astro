<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type MtPuzzle = { id: string; label: string; tease: string; n: number; edges: [number, number][]; best: number; before: number };

  function initMoleGame(): void {
    const maybeUi = cpGameUi('[data-mtgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as MtPuzzle[];
    if (puzzles.length === 0) return;

    let pi = 0;
    let cut = -1;
    let picks: number[] = [];

    const pz = (): MtPuzzle => puzzles[pi];
    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-mt-board]'));

    /** ฝั่งของทุกห้อง เมื่อปิดเส้น cut แล้ว 0 คือฝั่งเดียวกับปลายแรก */
    function sides(p: MtPuzzle, cutIdx: number): number[] {
      const side = new Array<number>(p.n + 1).fill(-1);
      if (cutIdx < 0) return side;
      const adj: number[][] = Array.from({ length: p.n + 1 }, () => []);
      p.edges.forEach((e, i) => {
        if (i === cutIdx) return;
        adj[e[0]].push(e[1]);
        adj[e[1]].push(e[0]);
      });
      for (const [start, tag] of [[p.edges[cutIdx][0], 0], [p.edges[cutIdx][1], 1]] as [number, number][]) {
        const q = [start];
        side[start] = tag;
        for (let i = 0; i < q.length; i++) for (const v of adj[q[i]]) if (side[v] < 0) { side[v] = tag; q.push(v); }
      }
      return side;
    }

    /** ระยะไกลสุดของผังหลังปิดหนึ่งเส้นและเปิดเส้นใหม่ */
    function diameterAfter(p: MtPuzzle, cutIdx: number, x: number, y: number): number {
      const adj: number[][] = Array.from({ length: p.n + 1 }, () => []);
      p.edges.forEach((e, i) => {
        if (i === cutIdx) return;
        adj[e[0]].push(e[1]);
        adj[e[1]].push(e[0]);
      });
      adj[x].push(y);
      adj[y].push(x);
      let best = 0;
      for (let s = 1; s <= p.n; s++) {
        const d = new Array<number>(p.n + 1).fill(-1);
        const q = [s];
        d[s] = 0;
        for (let i = 0; i < q.length; i++) for (const v of adj[q[i]]) if (d[v] < 0) { d[v] = d[q[i]] + 1; q.push(v); }
        for (let v = 1; v <= p.n; v++) best = Math.max(best, d[v]);
      }
      return best;
    }

    function render(): void {
      const p = pz();
      boards.forEach((b, k) => {
        b.hidden = k !== pi;
      });
      const side = sides(p, cut);
      const board = boards[pi];
      for (const ln of Array.from(board.querySelectorAll<SVGLineElement>('.mt-edge'))) {
        const idx = Number((ln.dataset.mtEdge ?? '').split(':')[1]);
        ln.classList.toggle('cut', idx === cut);
      }
      for (const nd of Array.from(board.querySelectorAll<SVGCircleElement>('.mt-node'))) {
        const id = Number((nd.dataset.mtNode ?? '').split(':')[1]);
        nd.classList.toggle('sideA', cut >= 0 && side[id] === 0);
        nd.classList.toggle('sideB', cut >= 0 && side[id] === 1);
        nd.classList.toggle('pick', picks.includes(id));
      }
      if (cut < 0) ui.setScore('ยังไม่ได้เลือกอะไร');
      else if (picks.length < 2) ui.setScore(`ปิดอุโมงค์ ${p.edges[cut][0]} ถึง ${p.edges[cut][1]} แล้ว เลือกห้องอีก ${2 - picks.length} ห้อง`);
      else ui.setScore(`แผนนี้ได้ระยะไกลสุด ${diameterAfter(p, cut, picks[0], picks[1])} ห้อง ส่วนค่าที่ดีที่สุดของผังนี้คือ ${p.best}`);
    }

    function onEdge(idx: number): void {
      cut = idx;
      picks = [];
      const p = pz();
      ui.setStatus(`ปิดอุโมงค์ ${p.edges[idx][0]} ถึง ${p.edges[idx][1]} แล้ว ตอนนี้ผังแตกเป็นสองก้อน สีฟ้ากับสีน้ำตาล กดหนึ่งห้องในแต่ละก้อน`, 'plain');
      render();
    }

    function onNode(id: number): void {
      const p = pz();
      if (cut < 0) {
        ui.setStatus('ต้องเลือกอุโมงค์ที่จะปิดก่อน กดที่เส้นระหว่างห้อง', 'bad');
        return;
      }
      const side = sides(p, cut);
      if (picks.length === 1 && side[picks[0]] === side[id]) {
        ui.setStatus('สองห้องนี้อยู่ก้อนเดียวกัน อุโมงค์ใหม่ต้องเชื่อมคนละก้อน ไม่งั้นจะมีห้องที่เดินไปไม่ถึง', 'bad');
        return;
      }
      if (picks.includes(id)) return;
      if (picks.length >= 2) picks = [];
      picks.push(id);
      if (picks.length === 2) ui.setStatus('ได้แผนครบแล้ว กดตรวจแผนนี้ หรือจะลองเปลี่ยนก็ได้', 'plain');
      render();
    }

    function check(): void {
      const p = pz();
      if (cut < 0 || picks.length < 2) {
        ui.setStatus('ยังเลือกไม่ครบ ต้องมีทั้งเส้นที่ปิดและห้องสองห้องที่จะต่อ', 'bad');
        return;
      }
      const got = diameterAfter(p, cut, picks[0], picks[1]);
      if (got === p.best) ui.setStatus(`ดีที่สุดแล้วครับ ผังนี้ลดจาก ${p.before} เหลือ ${p.best} ห้อง`, 'good');
      else ui.setStatus(`แผนนี้ได้ ${got} ห้อง แต่ผังนี้ทำได้ถึง ${p.best} ห้อง ลองดูว่าสองก้อนที่ได้ยาวพอ ๆ กันหรือยัง`, 'bad');
    }

    function selectPuzzle(k: number): void {
      pi = k;
      cut = -1;
      picks = [];
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ui.setStatus('กดที่เส้นเพื่อเลือกอุโมงค์ที่จะปิดก่อน');
      render();
    }

    ui.root.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const edge = e.target.closest('[data-mt-edge]');
      if (edge instanceof SVGElement) {
        onEdge(Number((edge.dataset.mtEdge ?? '').split(':')[1]));
        return;
      }
      const node = e.target.closest('[data-mt-node]');
      if (node instanceof SVGElement) onNode(Number((node.dataset.mtNode ?? '').split(':')[1]));
    });

    ui.onClick('data-mt-clear', () => selectPuzzle(pi));
    ui.onClick('data-mt-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initMoleGame);
</script>

