  table.rec.mtrec th, table.rec.mtrec td{white-space:normal;overflow-wrap:anywhere;}
  table.rec.mtrec td.num.mt-win{color:#4ade80;font-weight:700;}

  /* ---------- ผังของมินิเกม ---------- */
