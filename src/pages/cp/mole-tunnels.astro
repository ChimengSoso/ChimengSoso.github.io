void bfs(int s, int ba, int bb){
    for(int v : seen) d[v] = -1;              // ล้างเฉพาะห้องของรอบก่อน
    seen.clear(); seen.push_back(s); d[s] = 0; pa[s] = 0;
    for(size_t i = 0; i < seen.size(); i++){ int u = seen[i];
        for(int v : g[u]){
            if((u == ba && v == bb) || (u == bb && v == ba)) continue;
            if(d[v] < 0){ d[v] = d[u] + 1; pa[v] = u; seen.push_back(v); } } }
}

// เดินกว้างสองรอบ ได้ความยาวของก้อนที่ s อยู่ กับห้องกึ่งกลางของมัน
pair<int,int> diamCenter(int s, int ba, int bb){
    bfs(s, ba, bb);
    int u = s; for(int x : seen) if(d[x] > d[u]) u = x;
    bfs(u, ba, bb);
    int w = u; for(int x : seen) if(d[x] > d[w]) w = x;
    int len = d[w], cur = w;
    for(int k = 0; k < len / 2; k++) cur = pa[cur];   // ถอยกลับครึ่งทาง
    return {len, cur};
}

int main(){
    if(scanf("%d", &N) != 1) return 0;
    g.assign(N + 1, {}); d.assign(N + 1, -1); pa.assign(N + 1, 0);
    vector<pair<int,int>> E(N - 1);
    for(auto &e : E){ if(scanf("%d %d", &e.first, &e.second) != 2) return 0;
        g[e.first].push_back(e.second); g[e.second].push_back(e.first); }
    if(N == 1){ printf("0\\n"); return 0; }

    int best = INT_MAX; int bi = 0, bx = 0, by = 0;
    for(int i = 0; i < N - 1; i++){
        auto [a, b] = E[i];
        auto [d1, c1] = diamCenter(a, a, b);
        auto [d2, c2] = diamCenter(b, a, b);
        int s = max(max(d1, d2), (d1 + 1) / 2 + (d2 + 1) / 2 + 1);
        if(s < best){ best = s; bi = i; bx = c1; by = c2; } }
    printf("%d\\n%d %d\\n%d %d\\n", best, E[bi].first, E[bi].second, bx, by);
}`;

const bruteCode = `// ตัวตรวจ ปิดทุกเส้น ต่อทุกคู่ห้อง แล้ววัดระยะไกลสุดจริงทุกครั้ง
// ไม่มีคำว่ารัศมีหรือจุดกึ่งกลางอยู่ในนี้เลย
#include <bits/stdc++.h>
using namespace std;
int N; vector<pair<int,int>> E;
int diamOf(vector<vector<int>>&g, vector<int>&comp){
    int best = 0;
    for(int s : comp){ vector<int> d(N + 1, -1); queue<int> q; q.push(s); d[s] = 0;
        while(!q.empty()){ int u = q.front(); q.pop();
            for(int v : g[u]) if(d[v] < 0){ d[v] = d[u] + 1; q.push(v); } }
        for(int v : comp) best = max(best, d[v]); }
    return best; }
int main(){
    scanf("%d", &N); E.resize(N - 1);
    for(auto &e : E) scanf("%d %d", &e.first, &e.second);
    int ans = INT_MAX;
    for(int rm = 0; rm < N - 1; rm++){
        vector<vector<int>> g(N + 1);
        for(int i = 0; i < N - 1; i++) if(i != rm){
            g[E[i].first].push_back(E[i].second); g[E[i].second].push_back(E[i].first); }
        vector<int> col(N + 1, 0), A, B;
        { queue<int> q; q.push(E[rm].first); col[E[rm].first] = 1;
          while(!q.empty()){ int u = q.front(); q.pop(); A.push_back(u);
            for(int v : g[u]) if(!col[v]){ col[v] = 1; q.push(v); } } }
        for(int v = 1; v <= N; v++) if(!col[v]) B.push_back(v);
        for(int x : A) for(int y : B){
            g[x].push_back(y); g[y].push_back(x);
            vector<int> all; for(int v = 1; v <= N; v++) all.push_back(v);
            ans = min(ans, diamOf(g, all));
            g[x].pop_back(); g[y].pop_back(); } }
    printf("%d\\n", ans);
}`;

const coreSnippet = `// ปิดเส้นหนึ่งแล้วได้สองก้อน ยาว d1 กับ d2
// ต่อที่จุดกึ่งกลางของทั้งสองก้อน ทางข้ามอุโมงค์ใหม่ยาว รัศมี + 1 + รัศมี
// ค่าของเส้นนี้คือตัวที่มากที่สุดในสามตัว
int s = max(max(d1, d2), (d1 + 1) / 2 + (d2 + 1) / 2 + 1);`;

const codeMap = [
  { code: 'bfs (เดินกว้างโดยข้ามเส้นที่ปิด)', part: 'เดินกว้างสองรอบ ในตอนที่ 3' },
  { code: 'เรียงแบบกว้างก่อนแล้วไล่ย้อน (ord_)', part: 'ตอนที่ 5 (กล่องเรื่องความลึกของต้นไม้)' },
  { code: 'ขาลง h, dd', part: 'ตอนที่ 4 ขาลง' },
  { code: 'ขาขึ้น uh, ud (ทางลงสามอันดับ a1..a3 พร้อมเจ้าของ i1, i2 และ dd สองอันดับ d1, d2 พร้อมเจ้าของ j1)', part: 'ตอนที่ 4 ขาขึ้น' },
  { code: 'for v = 2..N เลือกเส้นด้วยสูตร', part: 'ตอนที่ 2 (สูตรของหนึ่งเส้น)' },
  { code: 'centerOf (หาจุดกึ่งกลางของเส้นที่ชนะ)', part: 'ตอนที่ 5' },
];
