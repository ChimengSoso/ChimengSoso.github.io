  /* บนจอแคบ ถ้าปล่อยให้ผังย่อตามการ์ด เลขห้องจะเหลือไม่กี่พิกเซล
     บังคับความกว้างขั้นต่ำแล้วให้ .cpg-scroll เลื่อนเอง หน้าเว็บจึงไม่เลื่อนตาม */
