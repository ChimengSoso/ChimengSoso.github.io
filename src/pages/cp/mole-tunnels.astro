---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

const href = 'mole-tunnels/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Edge = [number, number];

/** ระยะทางจากปมเริ่ม ไปทุกปมที่ยังเชื่อมถึงกัน หลังตัดเส้น cut ออกแล้ว */
function bfs(n: number, edges: Edge[], src: number, cut: number): { dist: number[]; par: number[]; seen: number[] } {
  const adj: number[][] = Array.from({ length: n + 1 }, () => []);
  edges.forEach(([a, b], i) => {
    if (i === cut) return;
    adj[a].push(b);
    adj[b].push(a);
  });
  const dist = new Array<number>(n + 1).fill(-1);
  const par = new Array<number>(n + 1).fill(0);
  const seen: number[] = [src];
  dist[src] = 0;
  for (let i = 0; i < seen.length; i++) {
    const u = seen[i];
    for (const v of adj[u])
      if (dist[v] < 0) {
        dist[v] = dist[u] + 1;
        par[v] = u;
        seen.push(v);
      }
  }
  return { dist, par, seen };
}

/** เส้นผ่านศูนย์กลางกับจุดกึ่งกลางของก้อนที่ src อยู่ หาโดยเดินกว้างสองรอบ */
function diamAndCenter(n: number, edges: Edge[], src: number, cut: number): { diam: number; center: number; nodes: number[] } {
  const first = bfs(n, edges, src, cut);
  let u = src;
  for (const x of first.seen) if (first.dist[x] > first.dist[u]) u = x;
  const second = bfs(n, edges, u, cut);
  let w = u;
  for (const x of second.seen) if (second.dist[x] > second.dist[w]) w = x;
  let cur = w;
  for (let s = 0; s < Math.floor(second.dist[w] / 2); s++) cur = second.par[cur];
  return { diam: second.dist[w], center: cur, nodes: first.seen };
}

/** เส้นผ่านศูนย์กลางของทั้งต้นไม้ ตามรูปที่เป็นอยู่ */
function wholeDiam(n: number, edges: Edge[]): number {
  return diamAndCenter(n, edges, 1, -1).diam;
}

/** ห้องเรียงตามทางของคู่ที่ไกลที่สุด หาด้วยการเดินกว้างสองรอบ ใช้ระบายเส้นในรูป */
function farPath(n: number, edges: Edge[]): number[] {
  const first = bfs(n, edges, 1, -1);
  let u = 1;
  for (const x of first.seen) if (first.dist[x] > first.dist[u]) u = x;
  const second = bfs(n, edges, u, -1);
  let w = u;
  for (const x of second.seen) if (second.dist[x] > second.dist[w]) w = x;
  const path = [w];
  while (path[path.length - 1] !== u) path.push(second.par[path[path.length - 1]]);
  return path;
}

type Plan = { cut: number; score: number; d1: number; d2: number; c1: number; c2: number };

/** ประเมินทุกเส้นที่ปิดได้ ด้วยสูตร แล้วคืนแผนที่ดีที่สุด (เส้นแรกที่ได้ค่าน้อยสุด เหมือนโค้ด) */
function planAll(n: number, edges: Edge[]): { rows: Plan[]; best: Plan } {
  const rows: Plan[] = edges.map(([a, b], i) => {
    const A = diamAndCenter(n, edges, a, i);
    const B = diamAndCenter(n, edges, b, i);
    const score = Math.max(A.diam, B.diam, Math.ceil(A.diam / 2) + Math.ceil(B.diam / 2) + 1);
    return { cut: i, score, d1: A.diam, d2: B.diam, c1: A.center, c2: B.center };
  });
  let best = rows[0];
  for (const r of rows) if (r.score < best.score) best = r;
  return { rows, best };
}

/** ระยะไกลสุดหลังปิดเส้น cut แล้วต่อ x กับ y วัดด้วยการเดินกว้างจากทุกห้อง ไม่ใช้สูตรใด ๆ */
function measureAfter(n: number, edges: Edge[], cut: number, x: number, y: number): number {
  const rebuilt: Edge[] = edges.filter((_, i) => i !== cut).concat([[x, y]]);
  let d = 0;
  for (let s = 1; s <= n; s++) {
    const r = bfs(n, rebuilt, s, -1);
    if (r.seen.length !== n) return Infinity;
    for (const t of r.seen) d = Math.max(d, r.dist[t]);
  }
  return d;
}

/** ตัวตรวจของเส้นเดียว ลองต่อทุกคู่ห้อง คืนค่าที่ดีที่สุด จำนวนคู่ที่ได้ค่านั้น และจำนวนคู่ทั้งหมด */
function bruteCut(n: number, edges: Edge[], cut: number): { best: number; ties: number; pairs: number } {
  const A = bfs(n, edges, edges[cut][0], cut).seen;
  const B = bfs(n, edges, edges[cut][1], cut).seen;
  let best = Infinity;
  let ties = 0;
  for (const x of A)
    for (const y of B) {
      const d = measureAfter(n, edges, cut, x, y);
      if (d < best) {
        best = d;
        ties = 1;
      } else if (d === best) ties++;
    }
  return { best, ties, pairs: A.length * B.length };
}

/** ตัวตรวจ ลองปิดทุกเส้นและลองต่อทุกคู่ห้อง วัดระยะไกลสุดจริงทุกครั้ง ไม่ใช้สูตรใด ๆ */
function bruteBest(n: number, edges: Edge[]): number {
  let best = Infinity;
  for (let cut = 0; cut < edges.length; cut++) best = Math.min(best, bruteCut(n, edges, cut).best);
  return best;
}

/* ---------- ไล่ค่าขาลงกับขาขึ้น เลียนโค้ดเต็มบรรทัดต่อบรรทัด และเก็บทุกขั้นไว้เล่า ---------- */
type DownRow = { v: number; kids: number[]; a1: number; a2: number; ddKids: number; h: number; dd: number };
type UpRow = {
  p: number; c: number; rank: number; a1: number; a2: number; a3: number;
  b1: number; b2: number; bd: number; uhp: number; udp: number; s1: number; s2: number; uh: number; ud: number;
};
type Reroot = { order: number[]; par: number[]; kids: number[][]; h: number[]; dd: number[]; uh: number[]; ud: number[]; down: DownRow[]; up: UpRow[] };

function reroot(n: number, edges: Edge[], root: number): Reroot {
  const { seen: order, par } = bfs(n, edges, root, -1);
  const kids: number[][] = Array.from({ length: n + 1 }, () => []);
  for (const v of order) if (v !== root) kids[par[v]].push(v);
  const h = new Array<number>(n + 1).fill(0);
  const dd = new Array<number>(n + 1).fill(0);
  const uh = new Array<number>(n + 1).fill(0);
  const ud = new Array<number>(n + 1).fill(0);
  const down: DownRow[] = [];
  for (let i = order.length - 1; i >= 0; i--) {
    const v = order[i];
    let a1 = 0;
    let a2 = 0;
    let ddKids = 0;
    for (const c of kids[v]) {
      const a = h[c] + 1;
      if (a > a1) {
        a2 = a1;
        a1 = a;
      } else if (a > a2) a2 = a;
      ddKids = Math.max(ddKids, dd[c]);
    }
    h[v] = a1;
    dd[v] = Math.max(ddKids, a1 + a2);
    down.push({ v, kids: kids[v], a1, a2, ddKids, h: h[v], dd: dd[v] });
  }
  const up: UpRow[] = [];
  for (const p of order) {
    let a1 = 0, a2 = 0, a3 = 0, i1 = -1, i2 = -1;
    let d1 = 0, d2 = 0, j1 = -1;
    for (const c of kids[p]) {
      const a = h[c] + 1;
      if (a > a1) {
        a3 = a2; a2 = a1; i2 = i1; a1 = a; i1 = c;
      } else if (a > a2) {
        a3 = a2; a2 = a; i2 = c;
      } else if (a > a3) a3 = a;
      if (dd[c] > d1) {
        d2 = d1; d1 = dd[c]; j1 = c;
      } else if (dd[c] > d2) d2 = dd[c];
    }
    for (const c of kids[p]) {
      const b1 = i1 === c ? a2 : a1;
      const b2 = i1 === c ? a3 : i2 === c ? a3 : a2;
      const bd = j1 === c ? d2 : d1;
      let s1 = uh[p];
      let s2: number;
      if (b1 > s1) {
        s2 = s1;
        s1 = b1;
      } else s2 = b1;
      if (b2 > s2) s2 = b2;
      ud[c] = Math.max(ud[p], bd, s1 + s2);
      uh[c] = 1 + Math.max(uh[p], b1);
      const rank = i1 === c ? 1 : i2 === c ? 2 : 3;
      up.push({ p, c, rank, a1, a2, a3, b1, b2, bd, uhp: uh[p], udp: ud[p], s1, s2, uh: uh[c], ud: ud[c] });
    }
  }
  return { order, par, kids, h, dd, uh, ud, down, up };
}

/** ค่าขาลงขาขึ้นต้องเท่ากับความยาวของสองก้อนที่เดินกว้างวัดจริง ทุกเส้น ไม่งั้นหน้านี้ไม่ขึ้น */
function assertReroot(n: number, edges: Edge[], R: Reroot, tag: string): void {
  const { rows } = planAll(n, edges);
  for (const r of rows) {
    const [a, b] = edges[r.cut];
    const v = R.par[b] === a ? b : a;
    const inner = v === a ? r.d1 : r.d2;
    const outer = v === a ? r.d2 : r.d1;
    if (R.dd[v] !== inner || R.ud[v] !== outer)
      throw new Error(`mole-tunnels ${tag}: ปิด ${a}-${b} ขาลงขาขึ้นได้ ${R.dd[v]}/${R.ud[v]} แต่วัดจริงได้ ${inner}/${outer}`);
  }
}

/* ---------- ตัวอย่างในโจทย์ คำตอบในตารางคือคำตอบของโจทย์เอง ---------- */
type Sample = { n: number; edges: Edge[]; out: { score: number; cut: Edge; add: Edge } };
const SAMPLES: Sample[] = [
  { n: 4, edges: [[1, 2], [2, 3], [3, 4]], out: { score: 2, cut: [3, 4], add: [4, 2] } },
  { n: 7, edges: [[1, 3], [2, 3], [2, 7], [4, 3], [7, 5], [3, 6]], out: { score: 3, cut: [2, 3], add: [7, 3] } },
];
const samples = SAMPLES.map((s) => {
  const { best } = planAll(s.n, s.edges);
  const cutIdx = s.edges.findIndex((e) => (e[0] === s.out.cut[0] && e[1] === s.out.cut[1]) || (e[0] === s.out.cut[1] && e[1] === s.out.cut[0]));
  if (cutIdx < 0) throw new Error('mole-tunnels: อุโมงค์ที่โจทย์ปิดไม่มีอยู่จริง');
  const theirs = measureAfter(s.n, s.edges, cutIdx, s.out.add[0], s.out.add[1]);
  if (theirs !== s.out.score || best.score !== s.out.score || bruteBest(s.n, s.edges) !== s.out.score)
    throw new Error(`mole-tunnels: ตัวอย่าง ${s.n} ห้อง สูตร/ตัวตรวจ/แผนของโจทย์ไม่ตรงกัน`);
  return { ...s, best, cutIdx, before: wholeDiam(s.n, s.edges) };
});
const [SA, SB] = samples;
const SA_OURS = `ปิด ${SA.edges[SA.best.cut].join('-')} แล้วต่อ ${SA.best.c1} กับ ${SA.best.c2}`;

/* รูปของตัวอย่างที่สอง ก่อนรื้อกับหลังรื้อ วางตำแหน่งเอง เส้นทองคือทางของคู่ที่ไกลที่สุด */
const SB_POS: Record<number, [number, number]> = { 5: [27, 110], 7: [87, 110], 2: [147, 110], 3: [207, 110], 1: [267, 60], 4: [267, 110], 6: [267, 160] };
for (let v = 1; v <= SB.n; v++) if (!SB_POS[v]) throw new Error(`mole-tunnels: รูปตัวอย่างขาดห้อง ${v}`);
const SB_DX = 320;
const SB_AFTER: Edge[] = SB.edges.filter((_, i) => i !== SB.cutIdx).concat([SB.out.add]);
const onPath = (path: number[], e: Edge): boolean =>
  path.some((v, i) => i + 1 < path.length && ((v === e[0] && path[i + 1] === e[1]) || (v === e[1] && path[i + 1] === e[0])));
const SB_PATH_BEFORE = farPath(SB.n, SB.edges);
const SB_PATH_AFTER = farPath(SB.n, SB_AFTER);
const SB_AFTER_DIAM = wholeDiam(SB.n, SB_AFTER);
if (SB_AFTER_DIAM !== SB.out.score) throw new Error('mole-tunnels: รูปหลังรื้อไม่ได้ค่าตามโจทย์');
const sbEdgesBefore = SB.edges.map((e) => ({ e, gold: onPath(SB_PATH_BEFORE, e) }));
const sbEdgesAfter = SB_AFTER.map((e, i) => ({ e, gold: onPath(SB_PATH_AFTER, e), added: i === SB_AFTER.length - 1 }));
const SB_CUT = SB.edges[SB.cutIdx];
/* เส้นใหม่วาดเป็นโค้งข้ามห้องที่อยู่ระหว่างกลาง */
const sbCurve = (a: number, b: number): string => {
  const [x1, y1] = SB_POS[a];
  const [x2, y2] = SB_POS[b];
  return `M${x1 + SB_DX} ${y1} Q${(x1 + x2) / 2 + SB_DX} ${Math.min(y1, y2) - 50} ${x2 + SB_DX} ${y2}`;
};

/* ---------- ด่านตรวจตอนบิลด์ สูตรต้องตรงกับการลองทุกคู่จริง ขาลงขาขึ้นต้องตรงกับการวัดจริง ---------- */
const SWEEP_CASES = 120;
{
  let seed = 992025;
  const rnd = (m: number): number => {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed % m;
  };
  for (let t = 0; t < SWEEP_CASES; t++) {
    const n = 2 + rnd(7);
    const edges: Edge[] = [];
    for (let i = 2; i <= n; i++) edges.push([1 + rnd(i - 1), i]);
    const byFormula = planAll(n, edges).best.score;
    const byBrute = bruteBest(n, edges);
    if (byFormula !== byBrute)
      throw new Error(`mole-tunnels: สูตรได้ ${byFormula} แต่การลองทุกคู่ได้ ${byBrute} ที่ต้นไม้ ${JSON.stringify(edges)}`);
    assertReroot(n, edges, reroot(n, edges, 1), `สุ่มชุดที่ ${t}`);
  }
}

/* ---------- ต้นไม้สาธิต ใช้ตั้งแต่เกมจนถึงตอนที่ 4 ---------- */
const DEMO: { n: number; edges: Edge[] } = {
  n: 9,
  edges: [[1, 2], [1, 3], [2, 4], [1, 5], [4, 6], [5, 7], [6, 8], [1, 9]],
};
const DEMO_ROOT = 1;
const demoPlan = planAll(DEMO.n, DEMO.edges);
const DEMO_BEFORE = wholeDiam(DEMO.n, DEMO.edges);
const DEMO_BEST = demoPlan.best;
const DEMO_WIN_EDGES = demoPlan.rows.filter((r) => r.score === DEMO_BEST.score).map((r) => DEMO.edges[r.cut].join('-'));
const DEMO_CUT = DEMO.edges[DEMO_BEST.cut];
if (bruteBest(DEMO.n, DEMO.edges) !== DEMO_BEST.score) throw new Error('mole-tunnels: ต้นสาธิต สูตรไม่ตรงกับตัวตรวจ');

/* ตัวอย่างใช้สูตร ทุกพจน์ต้องไม่เป็นศูนย์ และทางข้ามต้องชนะจริง ๆ ไม่งั้นตัวอย่างไม่ได้ใช้ทุกส่วนของสูตร */
const WX = (() => {
  const r = DEMO_BEST;
  const r1 = Math.ceil(r.d1 / 2);
  const r2 = Math.ceil(r.d2 / 2);
  const cross = r1 + 1 + r2;
  if ([r.d1, r.d2, r1, r2].some((x) => x === 0)) throw new Error('mole-tunnels: ตัวอย่างสูตรมีพจน์เป็นศูนย์');
  if (!(cross > Math.max(r.d1, r.d2))) throw new Error('mole-tunnels: ตัวอย่างสูตรควรให้ทางข้ามชนะ');
  const brute = bruteCut(DEMO.n, DEMO.edges, r.cut);
  if (brute.best !== r.score) throw new Error('mole-tunnels: ตัวอย่างสูตรไม่ตรงกับการลองทุกคู่');
  return { ...r, a: DEMO_CUT[0], b: DEMO_CUT[1], r1, r2, cross, ties: brute.ties, pairs: brute.pairs };
})();
if (!demoPlan.rows.some((r) => Math.max(r.d1, r.d2) > Math.ceil(r.d1 / 2) + Math.ceil(r.d2 / 2) + 1))
  throw new Error('mole-tunnels: ต้นสาธิตควรมีเส้นที่ก้อนยาวชนะทางข้ามด้วย');

/* ---------- วางต้นสาธิตแบบปักราก ลูกอยู่ใต้พ่อ ---------- */
type Pos = { id: number; x: number; y: number };
function treeLayout(n: number, edges: Edge[], root: number, x0: number, y0: number, sx: number, sy: number): Pos[] {
  const { dist, par, seen } = bfs(n, edges, root, -1);
  const kids: number[][] = Array.from({ length: n + 1 }, () => []);
  for (const v of seen) if (v !== root) kids[par[v]].push(v);
  const xs = new Array<number>(n + 1).fill(0);
  let slot = 0;
  const place = (v: number): void => {
    if (kids[v].length === 0) {
      xs[v] = slot++;
      return;
    }
    kids[v].forEach(place);
    xs[v] = (xs[kids[v][0]] + xs[kids[v][kids[v].length - 1]]) / 2;
  };
  place(root);
  return seen.map((v) => ({ id: v, x: x0 + xs[v] * sx, y: y0 + dist[v] * sy }));
}
const TP = treeLayout(DEMO.n, DEMO.edges, DEMO_ROOT, 27, 27, 88, 58);
const tpOf = (id: number): Pos => TP.find((p) => p.id === id) ?? { id, x: 0, y: 0 };
const TP_W = Math.max(...TP.map((p) => p.x)) + 15 + 12;
const TP_BOTTOM = Math.max(...TP.map((p) => p.y)) + 15;
const demoLines = DEMO.edges.map((e, i) => ({ i, a: tpOf(e[0]), b: tpOf(e[1]) }));

/* ---------- เครื่องเดินทีละขั้น ใช้ร่วมกันสามตัว ---------- */
type MtpStep = { note: string; node: string[]; edge: string[] };
const blankNodes = (): string[] => new Array<string>(DEMO.n + 1).fill('');
const blankEdges = (): string[] => new Array<string>(DEMO.edges.length).fill('');
const edgeIndex = (a: number, b: number): number =>
  DEMO.edges.findIndex((e) => (e[0] === a && e[1] === b) || (e[0] === b && e[1] === a));

/* ตัวที่ 1: ปิดทีละเส้น ทุกบรรทัดบอกค่าของเส้นนี้ เทียบกับค่าดีสุดที่ถืออยู่ แล้วบอกว่าเก็บหรือทิ้ง */
let runBest = Infinity;
const cutSteps: MtpStep[] = demoPlan.rows.map((r) => {
  const [a, b] = DEMO.edges[r.cut];
  const r1 = Math.ceil(r.d1 / 2);
  const r2 = Math.ceil(r.d2 / 2);
  const cross = r1 + 1 + r2;
  const verdict =
    runBest === Infinity
      ? 'เส้นแรก ถือไว้ก่อน'
      : r.score < runBest
        ? `น้อยกว่า ${runBest} ที่ถืออยู่ เก็บเส้นนี้แทน`
        : r.score === runBest
          ? `เท่ากับ ${runBest} ที่ถืออยู่ ไม่ได้ดีขึ้น ถือเส้นเดิม`
          : `มากกว่า ${runBest} ที่ถืออยู่ ทิ้ง`;
  if (r.score < runBest) runBest = r.score;
  const node = blankNodes();
  const sideA = new Set(bfs(DEMO.n, DEMO.edges, a, r.cut).seen);
  for (let v = 1; v <= DEMO.n; v++) node[v] = sideA.has(v) ? 'a' : 'b';
  const edge = blankEdges();
  edge[r.cut] = 'cut';
  return {
    note:
      `ปิด ${a}-${b} ได้ ${r.score} · ${verdict} · ` +
      `${r.score} มาจากมากสุดของ ก้อนของ ${a} ยาว ${r.d1}, ก้อนของ ${b} ยาว ${r.d2}, ทางข้าม ${r1} + 1 + ${r2} = ${cross}`,
    node,
    edge,
  };
});
if (runBest !== DEMO_BEST.score) throw new Error('mole-tunnels: เครื่องเดินปิดทีละเส้นจบไม่ตรงกับคำตอบ');

/* ตัวที่ 2 กับ 3: ขาลงและขาขึ้นบนต้นเดียวกัน */
const RR = reroot(DEMO.n, DEMO.edges, DEMO_ROOT);
assertReroot(DEMO.n, DEMO.edges, RR, 'ต้นสาธิต');
