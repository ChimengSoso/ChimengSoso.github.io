/* ---------- มินิเกม เลือกเส้นที่จะปิดและจุดที่จะต่อ ---------- */
function layout(n: number, edges: Edge[], root: number, x0: number, y0: number, dx: number, dy: number): Pos[] {
  const { dist, seen } = bfs(n, edges, root, -1);
  const byLevel = new Map<number, number[]>();
  for (const v of seen) {
    const lv = dist[v];
    if (!byLevel.has(lv)) byLevel.set(lv, []);
    (byLevel.get(lv) ?? []).push(v);
  }
  const out: Pos[] = [];
  for (const [lv, list] of [...byLevel.entries()].sort((a, b) => a[0] - b[0]))
    list.forEach((v, i) => out.push({ id: v, x: x0 + lv * dx, y: y0 + (i - (list.length - 1) / 2) * dy }));
  return out;
}
type GamePuzzle = { id: string; label: string; tease: string; n: number; edges: Edge[]; pos: Pos[]; best: number; before: number };
function makePuzzle(id: string, label: string, tease: string, n: number, edges: Edge[], root: number): GamePuzzle {
  const byFormula = planAll(n, edges).best.score;
  const byBrute = bruteBest(n, edges);
  if (byFormula !== byBrute) throw new Error(`mole-tunnels: เฉลยเกม ${id} ไม่ตรงกับการลองทุกคู่`);
  return { id, label, tease, n, edges, pos: layout(n, edges, root, 44, 96, 74, 52), best: byFormula, before: wholeDiam(n, edges) };
}
