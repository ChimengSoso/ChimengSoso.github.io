/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Edge = [number, number];

/** ระยะทางจากปมเริ่ม ไปทุกปมที่ยังเชื่อมถึงกัน หลังตัดเส้น cut ออกแล้ว */
function bfs(n: number, edges: Edge[], src: number, cut: number): { dist: number[]; par: number[]; seen: number[] } {
  const adj: number[][] = Array.from({ length: n + 1 }, () => []);
  edges.forEach(([a, b], i) => {
    if (i === cut) return;
    adj[a].push(b);
    adj[b].push(a);
  });
  const dist = new Array<number>(n + 1).fill(-1);
  const par = new Array<number>(n + 1).fill(0);
  const seen: number[] = [src];
  dist[src] = 0;
  for (let i = 0; i < seen.length; i++) {
    const u = seen[i];
    for (const v of adj[u])
      if (dist[v] < 0) {
        dist[v] = dist[u] + 1;
        par[v] = u;
        seen.push(v);
      }
  }
  return { dist, par, seen };
}

/** เส้นผ่านศูนย์กลางกับจุดกึ่งกลางของก้อนที่ src อยู่ หาโดยเดินกว้างสองรอบ */
function diamAndCenter(n: number, edges: Edge[], src: number, cut: number): { diam: number; center: number; nodes: number[] } {
  const first = bfs(n, edges, src, cut);
  let u = src;
  for (const x of first.seen) if (first.dist[x] > first.dist[u]) u = x;
  const second = bfs(n, edges, u, cut);
  let w = u;
  for (const x of second.seen) if (second.dist[x] > second.dist[w]) w = x;
  let cur = w;
  for (let s = 0; s < Math.floor(second.dist[w] / 2); s++) cur = second.par[cur];
  return { diam: second.dist[w], center: cur, nodes: first.seen };
}

/** เส้นผ่านศูนย์กลางของทั้งต้นไม้ ตามรูปที่เป็นอยู่ */
function wholeDiam(n: number, edges: Edge[]): number {
  return diamAndCenter(n, edges, 1, -1).diam;
}

type Plan = { cut: number; score: number; d1: number; d2: number; c1: number; c2: number };

/** ประเมินทุกเส้นที่ปิดได้ ด้วยสูตร แล้วคืนแผนที่ดีที่สุด */
function planAll(n: number, edges: Edge[]): { rows: Plan[]; best: Plan } {
  const rows: Plan[] = edges.map(([a, b], i) => {
    const A = diamAndCenter(n, edges, a, i);
    const B = diamAndCenter(n, edges, b, i);
    const score = Math.max(A.diam, B.diam, Math.ceil(A.diam / 2) + Math.ceil(B.diam / 2) + 1);
    return { cut: i, score, d1: A.diam, d2: B.diam, c1: A.center, c2: B.center };
  });
  let best = rows[0];
  for (const r of rows) if (r.score < best.score) best = r;
  return { rows, best };
}

/** ตัวตรวจ ลองปิดทุกเส้นและลองต่อทุกคู่ห้อง วัดระยะไกลสุดจริงทุกครั้ง ไม่ใช้สูตรใด ๆ */
function bruteBest(n: number, edges: Edge[]): number {
  let best = Infinity;
  for (let cut = 0; cut < edges.length; cut++) {
    const A = bfs(n, edges, edges[cut][0], cut);
    const B = bfs(n, edges, edges[cut][1], cut);
    for (const x of A.seen)
      for (const y of B.seen) {
        const rebuilt: Edge[] = edges.filter((_, i) => i !== cut).concat([[x, y]]);
        let d = 0;
        for (let s = 1; s <= n; s++) {
          const r = bfs(n, rebuilt, s, -1);
          if (r.seen.length !== n) {
            d = Infinity;
            break;
          }
          for (const t of r.seen) d = Math.max(d, r.dist[t]);
        }
        best = Math.min(best, d);
      }
  }
  return best;
}

/* ---------- ตัวอย่างในโจทย์ ---------- */
const SAMPLE_A: { n: number; edges: Edge[] } = { n: 4, edges: [[1, 2], [2, 3], [3, 4]] };
const SAMPLE_B: { n: number; edges: Edge[] } = {
  n: 7,
  edges: [[1, 3], [2, 3], [2, 7], [4, 3], [7, 5], [3, 6]],
};
const samples = [SAMPLE_A, SAMPLE_B].map((s) => {
  const { best } = planAll(s.n, s.edges);
  return { ...s, best, before: wholeDiam(s.n, s.edges) };
});

/* ด่านตรวจตอนบิลด์ สูตรต้องตรงกับการลองทุกคู่จริง ไม่งั้นหน้านี้ไม่ขึ้น */
const SWEEP_CASES = 120;
{
  let seed = 992025;
  const rnd = (m: number): number => {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed % m;
  };
  for (let t = 0; t < SWEEP_CASES; t++) {
    const n = 2 + rnd(7);
    const edges: Edge[] = [];
    for (let i = 2; i <= n; i++) edges.push([1 + rnd(i - 1), i]);
    const byFormula = planAll(n, edges).best.score;
    const byBrute = bruteBest(n, edges);
    if (byFormula !== byBrute)
      throw new Error(`mole-tunnels: สูตรได้ ${byFormula} แต่การลองทุกคู่ได้ ${byBrute} ที่ต้นไม้ ${JSON.stringify(edges)}`);
  }
}

/* ---------- ต้นไม้สาธิตสำหรับตัวเล่นทีละขั้น ---------- */
