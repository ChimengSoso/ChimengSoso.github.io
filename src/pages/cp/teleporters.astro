<style>

  .dim{color:#7b8397;}

  /* ---------- กระดานของมินิเกม แต่ละปุ่มคือหนึ่งช่วงบนเส้น ปุ่มสร้างใหม่ด้วย JS จึงใช้ :global ---------- */
