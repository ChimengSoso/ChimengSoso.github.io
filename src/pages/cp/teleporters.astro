const href = 'teleporters/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Pair = [number, number];

/** วิเคราะห์ชุดเครื่องเคลื่อนย้าย คืนความยาวเส้นทางหลักกับขนาดของวงที่เหลือ */
function analyse(ps: Pair[]): { base: number; cycles: number[] } {
  const pts = ps.flat().sort((a, b) => a - b);
  const idx = new Map<number, number>();
  pts.forEach((p, i) => idx.set(p, i + 1));
  const partner = new Map<number, number>();
  for (const [a, b] of ps) {
    partner.set(a, b);
    partner.set(b, a);
  }
  const P = pts.length;
  const nxt: number[] = new Array<number>(P + 1).fill(-1);
  for (let j = 0; j < P; j++) nxt[j] = idx.get(partner.get(pts[j]) as number) as number;

  const vis = new Array<boolean>(P + 1).fill(false);
  let cur = 0;
  let base = 0;
  while (cur !== P) {
    vis[cur] = true;
    cur = nxt[cur];
    base++;
  }
  vis[P] = true;
  const cycles: number[] = [];
  for (let j = 0; j < P; j++)
    if (!vis[j]) {
      let len = 0;
      let u = j;
      while (!vis[u]) {
        vis[u] = true;
        u = nxt[u];
        len++;
      }
      cycles.push(len);
    }
  cycles.sort((a, b) => b - a);
  return { base, cycles };
}

/** คะแนนสูงสุดตามท่าโลภ */
function best(base: number, cycles: number[], m: number): number {
  let ans = base;
  let used = 0;
  for (const c of cycles) {
    if (used >= m) break;
    ans += c + 2;
    used++;
  }
  const r = m - used;
  return ans + Math.floor(r / 2) * 4 + (r % 2);
}

const EX1: Pair[] = [
  [10, 11],
  [1, 4],
  [2, 3],
];
const EX1M = 1;
const a1 = analyse(EX1);
const ans1 = best(a1.base, a1.cycles, EX1M);

const EX2: Pair[] = [
  [5, 7],
  [6, 10],
  [1999999, 2000000],
];
const EX2M = 3;
const a2 = analyse(EX2);
const ans2 = best(a2.base, a2.cycles, EX2M);

/* ---------- โครงของกราฟฟังก์ชัน ใช้วาดภาพข้างล่าง ----------
   คืนทั้งเส้นทางหลักและวงที่เหลือเป็นรายชื่อช่วงจริง ไม่ใช่แค่ขนาด
   ภาพจึงวาดจากลูกศรชุดเดียวกับที่ analyse() เดิน ไม่มีเลขไหนพิมพ์มือ */
interface TpShape {
  intervals: number;
  pts: number[];
  path: number[];
  loops: number[][];
}
function shape(ps: Pair[]): TpShape {
  const pts = ps.flat().sort((a, b) => a - b);
  const idx = new Map<number, number>();
  pts.forEach((p, i) => idx.set(p, i + 1));
  const partner = new Map<number, number>();
  for (const [a, b] of ps) {
    partner.set(a, b);
    partner.set(b, a);
  }
  const P2 = pts.length;
  const nxt: number[] = new Array<number>(P2).fill(-1);
  for (let j = 0; j < P2; j++) nxt[j] = idx.get(partner.get(pts[j]) as number) as number;

  const seen = new Array<boolean>(P2 + 1).fill(false);
  const path: number[] = [];
  let cur = 0;
  while (cur !== P2) {
    seen[cur] = true;
    path.push(cur);
    cur = nxt[cur];
  }
  seen[P2] = true;
  path.push(P2);
  const loops: number[][] = [];
  for (let j = 0; j < P2; j++)
    if (!seen[j]) {
      const one: number[] = [];
      let u = j;
      while (!seen[u]) {
        seen[u] = true;
        one.push(u);
        u = nxt[u];
      }
      loops.push(one);
    }
  return { intervals: P2 + 1, pts, path, loops };
}
const sh1 = shape(EX1);

/* ตัวอย่างที่ 1 หลังวางเครื่องใหม่ที่ 0.5 กับ 1.5 ตามรูปในโจทย์ ภาพที่สองวาดจากลูกศรชุดนี้ */
const ADD1: Pair = [0.5, 1.5];
const sh1b = shape([...EX1, ADD1]);
const a1b = analyse([...EX1, ADD1]);
/* ภาพต้องเล่าเรื่องเดียวกับสูตร: วงขนาด 2 ถูกดูดเข้ามา เส้นทางได้ช่วงเพิ่ม 2 + 2 คะแนนกลายเป็นคำตอบของตัวอย่าง */
if (a1b.base !== ans1 || a1b.base - a1.base !== a1.cycles[0] + 2 || sh1b.path.length - sh1.path.length !== a1.cycles[0] + 2)
  throw new Error(`teleporters: ภาพหลังเพิ่มเครื่องควรได้ ${ans1} คะแนน แต่ได้ ${a1b.base}`);

/* พิกัดของภาพ กว้างเท่าเนื้อภาพพอดี บวกที่ว่างให้ปุ่มขยายที่มุมล่างขวา */
const IW = 66;
const IGAP = 10;
const ix = (i: number): number => 12 + i * (IW + IGAP);
const icx = (i: number): number => ix(i) + IW / 2;
/** โค้งเชื่อมช่วงสองช่วง ขึ้นด้านบนเมื่ออยู่บนเส้นทางหลัก ลงด้านล่างเมื่อเป็นวง */
const arc = (a: number, b: number, up: boolean): string => {
  const x1 = icx(a);
  const x2 = icx(b);
  const y = up ? 70 : 114;
  const bend = Math.min(36, 14 + Math.abs(x2 - x1) / 7);
  const lift = up ? y - bend : y + bend;
  return `M${x1} ${y} C ${x1} ${lift}, ${x2} ${lift}, ${x2} ${y}`;
};
/** ห่วงของช่วงที่ชี้กลับตัวเอง ต้องมีความกว้าง ไม่งั้นเส้นโค้งยุบเป็นขีดตรง */
const selfArc = (i: number): string => {
  const c = icx(i);
  return `M${c - 13} 114 C ${c - 20} 152, ${c + 20} 152, ${c + 13} 114`;
};
/** หัวลูกศรวาดเป็นสามเหลี่ยม ไม่ใช้ marker เพื่อให้ก็อปไปวางในกล่องขยายได้ครบ */
const head = (x: number, up: boolean): string => {
  const y = up ? 70 : 114;
  const d = up ? 8 : -8;
  return `${x - 4.5},${y - d} ${x + 4.5},${y - d} ${x},${y}`;
};
const posLabel = (p: number): string => String(p);
interface ShapeDraw {
  named: boolean;
  vb: string;
  maxW: number;
  arcs: { d: string; up: boolean }[];
  heads: { points: string; up: boolean }[];
  boxes: { x: number; cx: number; on: boolean; name: string; span: string }[];
}
/** แปลงโครงของกราฟเป็นชิ้นที่ต้องวาด ทุกพิกัดมาจากตรงนี้ */
function drawShape(sh: TpShape, named: boolean, loopLabel = false): ShapeDraw {
  const on = (i: number): boolean => sh.path.indexOf(i) !== -1;
  const arcs: ShapeDraw['arcs'] = [];
  const heads: ShapeDraw['heads'] = [];
  sh.path.slice(0, -1).forEach((from, k) => {
    arcs.push({ d: arc(from, sh.path[k + 1], true), up: true });
    heads.push({ points: head(icx(sh.path[k + 1]), true), up: true });
  });
  for (const loop of sh.loops) {
    if (loop.length === 1) {
      arcs.push({ d: selfArc(loop[0]), up: false });
      heads.push({ points: head(icx(loop[0]) + 13, false), up: false });
    } else {
      loop.forEach((from, k) => {
        const to = loop[(k + 1) % loop.length];
        arcs.push({ d: arc(from, to, false), up: false });
        heads.push({ points: head(icx(to), false), up: false });
      });
    }
  }
  const P = sh.pts.length;
  const boxes = Array.from({ length: sh.intervals }, (_, i) => ({
    x: ix(i),
    cx: icx(i),
    on: on(i),
    name: `I${i}`,
    span: `${i === 0 ? '0' : posLabel(sh.pts[i - 1])}–${i === P ? 'ชัย' : posLabel(sh.pts[i])}`,
  }));
  const w = ix(sh.intervals - 1) + IW + 12;
  /* ความสูงตามของที่อยู่ใต้แถวช่วง: ไม่มีวงก็จบที่ขอบกล่อง (114) ห่วงตัวเองลงไปถึงราว 143
     วงหลายช่วงหรือป้าย "วงที่ลอยอยู่" (y 196) ลงไปถึงราว 200 แล้วเผื่อ 34 ไว้ให้ปุ่ม "ขยาย" */
  const bottom = loopLabel || sh.loops.some((l) => l.length > 1) ? 200 : sh.loops.length > 0 ? 143 : 114;
  return { named, vb: `0 0 ${w} ${bottom + 34}`, maxW: Math.round(w * 1.25), arcs, heads, boxes };
}
const dr1 = drawShape(sh1, true, true);
const dr1b = drawShape(sh1b, false, true);
/* วงที่ใหญ่ที่สุดของตัวอย่างที่ 1 ซึ่งเครื่องใหม่ดูดเข้ามา บอกเป็นตำแหน่งให้เทียบกับภาพที่สองได้ */
const bigLoop = sh1.loops.find((l) => l.length === a1.cycles[0]) ?? [];
const bigLoopSpans = bigLoop.map((i) => dr1.boxes[i].span).join(' กับ ');
const loopCells = (sh: TpShape): number => sh.loops.reduce((t, l) => t + l.length, 0);

/* ---------- มินิเกม วางเครื่องเพิ่มให้ได้แต้มมากที่สุด ----------
   ผู้เล่นแตะช่วงบนเส้นเพื่อวางจุดปลาย แต้มในหน้าเว็บคิดด้วยการเดินตามกฎของโจทย์ตรง ๆ ไม่ใช้สูตร
   แต้มเป้าหมายของแต่ละชุดมาจากตัวไล่ทุกแบบ (bruteExact ข้างล่าง) และต้องตรงกับสูตร ไม่งั้นบิลด์พัง */
type TpPuzzle = { id: string; label: string; tease: string; pairs: Pair[]; m: number };

const TP_PUZZLES: TpPuzzle[] = [
  {
    id: 't1',
    label: 'ชุดที่ 1 · ตัวอย่างในโจทย์',
    tease: 'ชุดแรกของโจทย์ เพิ่มได้หนึ่งเครื่อง',
