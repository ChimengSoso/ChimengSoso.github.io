---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const href = 'teleporters/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Pair = [number, number];

/** วิเคราะห์ชุดเครื่องเคลื่อนย้าย คืนความยาวเส้นทางหลักกับขนาดของวงที่เหลือ */
function analyse(ps: Pair[]): { base: number; cycles: number[] } {
  const pts = ps.flat().sort((a, b) => a - b);
  const idx = new Map<number, number>();
  pts.forEach((p, i) => idx.set(p, i + 1));
  const partner = new Map<number, number>();
  for (const [a, b] of ps) {
    partner.set(a, b);
    partner.set(b, a);
  }
  const P = pts.length;
  const nxt: number[] = new Array<number>(P + 1).fill(-1);
  for (let j = 0; j < P; j++) nxt[j] = idx.get(partner.get(pts[j]) as number) as number;

  const vis = new Array<boolean>(P + 1).fill(false);
  let cur = 0;
  let base = 0;
  while (cur !== P) {
    vis[cur] = true;
    cur = nxt[cur];
    base++;
  }
  vis[P] = true;
  const cycles: number[] = [];
  for (let j = 0; j < P; j++)
    if (!vis[j]) {
      let len = 0;
      let u = j;
      while (!vis[u]) {
        vis[u] = true;
        u = nxt[u];
        len++;
      }
      cycles.push(len);
    }
  cycles.sort((a, b) => b - a);
  return { base, cycles };
}

/** คะแนนสูงสุดตามท่าโลภ */
function best(base: number, cycles: number[], m: number): number {
  let ans = base;
  let used = 0;
  for (const c of cycles) {
    if (used >= m) break;
    ans += c + 2;
    used++;
  }
  const r = m - used;
  return ans + Math.floor(r / 2) * 4 + (r % 2);
}

const EX1: Pair[] = [
  [10, 11],
  [1, 4],
  [2, 3],
];
const EX1M = 1;
const a1 = analyse(EX1);
const ans1 = best(a1.base, a1.cycles, EX1M);

const EX2: Pair[] = [
  [5, 7],
  [6, 10],
  [1999999, 2000000],
];
const EX2M = 3;
const a2 = analyse(EX2);
const ans2 = best(a2.base, a2.cycles, EX2M);

/* ---------- มินิเกม แจกเครื่องเคลื่อนย้าย M ตัวให้ได้แต้มมากที่สุด ----------
   แต้มของทุกการกระทำมาจากฟังก์ชันเดียวกับที่บทความใช้ และแต้มที่ดีที่สุดของแต่ละชุด
   ถูกตรวจซ้ำด้วยการไล่ทุกวิธีแจกตอนบิลด์ ถ้าท่าโลภกับการไล่ทุกวิธีไม่ตรงกัน บิลด์จะพัง */
type TpPuzzle = { id: string; label: string; tease: string; pairs: Pair[]; m: number };

/** ไล่ทุกวิธีแจกเครื่อง เพื่อยืนยันว่าท่าโลภได้แต้มสูงสุดจริง ใช้กับชุดเล็กในเกมเท่านั้น */
function bestByBruteTp(base: number, cycles: number[], m: number): number {
  let top = 0;
  const walk = (i: number, left: number, score: number): void => {
    if (i === cycles.length) {
      top = Math.max(top, score + Math.floor(left / 2) * 4 + (left % 2));
      return;
    }
    walk(i + 1, left, score);
    if (left >= 1) walk(i + 1, left - 1, score + cycles[i] + 2);
  };
  walk(0, m, base);
  return top;
}

const TP_PUZZLES: TpPuzzle[] = [
  {
    id: 't1',
    label: 'ชุดที่ 1 · ตัวอย่างในโจทย์',
    tease: 'ชุดแรกของโจทย์ มีเครื่องให้เพิ่มตัวเดียว',
    pairs: EX1,
    m: EX1M,
  },
  {
    id: 't2',
    label: 'ชุดที่ 2 · ตัวอย่างที่สอง',
    tease: 'สามเครื่อง และมีวงให้เลือกต่อมากกว่าหนึ่งวง',
    pairs: EX2,
    m: EX2M,
  },
  {
    id: 't3',
    label: 'ชุดที่ 3 · เครื่องเหลือ',
    tease: 'ชุดนี้มีเครื่องเหลือหลังต่อวงหมดแล้ว ลองดูว่าเครื่องที่เหลือควรใช้ยังไง',
    pairs: [
      [10, 11],
      [1, 4],
      [2, 3],
      [20, 23],
      [21, 22],
    ],
    m: 5,
  },
];

type TpPuzzleData = {
  id: string;
  label: string;
  tease: string;
  m: number;
  base: number;
  cycles: number[];
  best: number;
};
const tpPuzzles: TpPuzzleData[] = TP_PUZZLES.map((p) => {
  const a = analyse(p.pairs);
  const greedyBest = best(a.base, a.cycles, p.m);
  const bruteBest = bestByBruteTp(a.base, a.cycles, p.m);
  if (greedyBest !== bruteBest) {
    throw new Error(
      `มินิเกมของ teleporters: ชุด ${p.id} ท่าโลภได้ ${greedyBest} แต่การไล่ทุกวิธีได้ ${bruteBest}`,
    );
  }
  return {
    id: p.id,
    label: p.label,
    tease: p.tease,
    m: p.m,
    base: a.base,
    cycles: a.cycles,
    best: greedyBest,
  };
});
const tpJson = JSON.stringify(tpPuzzles);

/* ตารางแสดงว่าเครื่องแต่ละตัวถูกใช้ทำอะไร ในตัวอย่างที่สอง */
type Spend = { i: number; act: string; gain: number; total: number };
function spendTable(base: number, cycles: number[], m: number): Spend[] {
  const rows: Spend[] = [];
  let total = base;
  let ci = 0;
  let pend = false;
  for (let i = 1; i <= m; i++) {
    if (ci < cycles.length) {
      const g = cycles[ci] + 2;
      total += g;
      rows.push({ i, act: `ดูดวงขนาด ${cycles[ci]} เข้ามาต่อ`, gain: g, total });
      ci++;
    } else if (!pend) {
      total += 1;
      rows.push({ i, act: 'ไม่มีวงเหลือแล้ว จึงต้องแตกวงขนาด 1 ออกมาก่อน', gain: 1, total });
      pend = true;
    } else {
      total += 3;
      rows.push({ i, act: 'ดูดวงขนาด 1 ที่เพิ่งแตกไว้กลับเข้ามา', gain: 3, total });
      pend = false;
    }
  }
  return rows;
}
const spend2 = spendTable(a2.base, a2.cycles, EX2M);

const NMAX = 1000000;
const fmt = (n: number): string => n.toLocaleString('en-US');

const solution = `#include <bits/stdc++.h>
using namespace std;
// อ่านเลขเองทีละไบต์ อินพุตมีสองล้านตัวเลข scanf ช้าเกินไปสำหรับลิมิตหนึ่งวินาที
static char ibuf[1<<25]; static size_t ipos=0, ilen=0;
static inline int rd(){
    while(ipos<ilen && (ibuf[ipos]<'0'||ibuf[ipos]>'9')) ipos++;
    int v=0; while(ipos<ilen && ibuf[ipos]>='0' && ibuf[ipos]<='9') v=v*10+(ibuf[ipos++]-'0');
    return v;
}
int main(){
    ilen=fread(ibuf,1,sizeof(ibuf),stdin);
    int n=rd(), m=rd();
    vector<int> W(n),E(n); int hi=0;
    for(int i=0;i<n;i++){ W[i]=rd(); E[i]=rd(); hi=max(hi,E[i]); }
    const int LIM=hi+2;                            // ใช้แค่ถึงปลายที่ไกลสุด ตำแหน่งจุดจบไม่มีผลกับคำตอบ
    vector<int> partnerAt(LIM,-1);                 // partnerAt[p] = ตำแหน่งปลายอีกข้าง
    for(int i=0;i<n;i++){ partnerAt[W[i]]=E[i]; partnerAt[E[i]]=W[i]; }
    // เรียงตำแหน่งปลายทั้งหมด แล้วให้เลข 1..2n  ช่วง I_j อยู่ทางตะวันออกของปลายที่ j (I_0 คือจากจุดเริ่ม)
    vector<int> pts; pts.reserve(2*n);
    for(int i=0;i<n;i++){ pts.push_back(W[i]); pts.push_back(E[i]); }
    sort(pts.begin(),pts.end());
    int P=(int)pts.size();
    vector<int> id(LIM,0);
    for(int i=0;i<P;i++) id[pts[i]]=i+1;           // ปลายตัวที่ i+1
    // nxt[j] = ช่วงถัดไปหลังจากเดินจบช่วง j   (j = 0..P-1)
    vector<int> nxt(P+1,-1);
    for(int j=0;j<P;j++) nxt[j]=id[ partnerAt[ pts[j] ] ];
    // เดินจาก I_0 ไปจนถึง I_P นับจำนวนช่วง
    vector<char> vis(P+1,0);
    long long base=0; int cur=0;
    while(cur!=P){ vis[cur]=1; cur=nxt[cur]; base++; }
    vis[P]=1;
    // วงที่เหลือ
    vector<long long> cyc;
    for(int j=0;j<P;j++) if(!vis[j]){ long long len=0; int u=j; while(!vis[u]){ vis[u]=1; u=nxt[u]; len++; } cyc.push_back(len); }
    sort(cyc.rbegin(),cyc.rend());
    long long ans=base;                            // base = จำนวนครั้งที่ถูกย้ายก่อนเพิ่มเครื่อง
    int used=0;
    for(size_t i=0;i<cyc.size() && used<m; i++,used++) ans+=cyc[i]+2;   // ดูดวงเข้ามาต่อในเส้นทาง
    long long r=m-used;                            // เครื่องที่เหลือเมื่อไม่มีวงให้ดูดแล้ว
    ans += (r/2)*4 + (r%2)*1;                      // ต้องเสียหนึ่งเครื่องแตกวงก่อน อีกเครื่องค่อยดูดกลับ
    printf("%lld\\n",ans);
}`;
const checkCode = `#include <bits/stdc++.h>
using namespace std;
int LIM;
int simulate(vector<pair<int,int>>& ps){
    static int par[400]; for(int i=0;i<=LIM;i++) par[i]=-1;
    for(auto&[a,b]:ps){ par[a]=b; par[b]=a; }
    int pos=0,sc=0;
    while(true){
        int nx=-1; for(int p=pos+1;p<=LIM;p++) if(par[p]>=0){ nx=p; break; }
        if(nx<0) return sc;
        pos=par[nx]; sc++; if(sc>3000) return -1;
    }
}
int main(int argc,char**argv){
    int n,m; scanf("%d %d %d",&n,&m,&LIM);
    vector<pair<int,int>> base(n);
    set<int> used;
    for(auto&p:base){ scanf("%d %d",&p.first,&p.second); used.insert(p.first); used.insert(p.second); }
    vector<int> freeP; for(int i=1;i<=LIM;i++) if(!used.count(i)) freeP.push_back(i);
    int F=(int)freeP.size(), need=2*m, best=0;
    vector<int> idx(need);
    function<void(int,int)> choose=[&](int start,int k){
        if(k==need){
            vector<int> sel; for(int i=0;i<need;i++) sel.push_back(freeP[idx[i]]);
            sort(sel.begin(),sel.end());
            do{
                vector<pair<int,int>> ps=base;
                bool ok=true;
                for(int i=0;i<m;i++){ int a=sel[2*i],b=sel[2*i+1]; if(a>b) swap(a,b); ps.push_back({a,b}); }
                if(ok) best=max(best,simulate(ps));
            } while(next_permutation(sel.begin(),sel.end()));
            return;
        }
        for(int i=start;i<F;i++){ idx[k]=i; choose(i+1,k+1); }
    };
    if(m==0) best=simulate(base); else choose(0,0);
    printf("%d\\n",best);
}`;
const coreSnippet = `long long ans = base;                    // คะแนนก่อนเพิ่มเครื่อง
int used = 0;
for (size_t i = 0; i < cyc.size() && used < m; i++, used++)
    ans += cyc[i] + 2;                   // ดูดวงขนาด s เข้ามาต่อ ได้เพิ่ม s + 2

long long r = m - used;                  // เครื่องที่เหลือ ตอนไม่มีวงให้ดูดแล้ว
ans += (r / 2) * 4 + (r % 2) * 1;        // ต้องเสียเครื่องหนึ่งแตกวงก่อน อีกเครื่องค่อยดูดกลับ`;
---
<CpProblemLayout href={href}>
  <h2>โจทย์ · เดินไปทางตะวันออกเสมอ แต่โดนโยนกลับได้</h2>
  <p>
    เราเดินอยู่บนเส้นตรงจากตะวันตกไปตะวันออก เริ่มที่ตำแหน่ง 0 และต้องไปให้ถึงปลายทางที่ตำแหน่ง 2,000,001
    กฎเดียวคือ<strong>เดินไปทางตะวันออกเสมอ</strong>
  </p>
  <p>
    บนเส้นนี้มี<strong>เครื่องเคลื่อนย้ายมวลสาร</strong> (teleporter) อยู่ <code>N</code> เครื่อง
    เครื่องหนึ่งมีจุดปลายสองจุด พอเราเดินไปเหยียบจุดปลายข้างหนึ่ง เราจะถูกโยนไปโผล่ที่จุดปลายอีกข้างทันที
    แล้วเดินต่อไปทางตะวันออกจากจุดที่โผล่ เราหลบจุดปลายที่ขวางอยู่ไม่ได้ และทุกครั้งที่ถูกโยน<strong>ได้หนึ่งคะแนน</strong>
  </p>
  <div class="callout callout-note">
    <p class="callout-label">แกะคำศัพท์</p>
    <p>
      <i>teleporter</i> อ่านว่า <strong>"เทเลพอร์เตอร์"</strong> แปลว่า<strong>เครื่องย้ายตัวข้ามที่</strong>
      ประกอบจาก <i>tele-</i> ที่แปลว่าไกล (ตัวเดียวกับใน <i>telephone</i> และ <i>television</i>) กับ
      <i>portare</i> ในภาษาละตินที่แปลว่าขนหรือแบก
    </p>
  </div>
  <p>
    ก่อนออกเดินทาง เราวางเครื่องเพิ่มได้อีกไม่เกิน <code>M</code> เครื่อง จะวางจุดปลายไว้ที่ไหนก็ได้
    (ตำแหน่งไม่ต้องเป็นจำนวนเต็มก็ได้) ขอแค่ไม่ซ้ำกับจุดปลายที่มีอยู่แล้ว งานของเราคือ<strong>ทำคะแนนให้ได้มากที่สุด</strong>
  </p>

  <div class="callout callout-note spec">
    <p class="callout-label">อินพุต / ขอบเขต / เอาต์พุต</p>
    <ul>
      <li>
        <strong>อินพุต:</strong> บรรทัดที่ 1 คือ <code>N</code> บรรทัดที่ 2 คือ <code>M</code> จากนั้น
        <code>N</code> บรรทัด แต่ละบรรทัดคือตำแหน่งปลายด้านตะวันตกและด้านตะวันออกของเครื่องนั้น
      </li>
      <li>
        <strong>ขอบเขต:</strong> <code>N, M ≤ {fmt(NMAX)}</code> และทุกตำแหน่งอยู่ระหว่าง 1 ถึง 2,000,000
        โดยไม่มีจุดปลายไหนซ้ำกัน เวลา 1 วินาที หน่วยความจำ 64 เมกะไบต์
      </li>
      <li><strong>เอาต์พุต:</strong> คะแนนมากที่สุดที่ทำได้</li>
      <li><strong>ให้คะแนน:</strong> มี 30 คะแนนสำหรับชุดทดสอบที่ <code>N ≤ 500</code> และ <code>M ≤ 500</code></li>
    </ul>
  </div>

  <table class="io">
    <caption>EXAMPLE</caption>
    <thead><tr><th>Input</th><th>Output</th></tr></thead>
    <tbody>
      <tr><td>{EX1.length}<br />{EX1M}<br />{EX1.map((p) => <>{p[0]} {p[1]}<br /></>)}</td><td>{ans1}</td></tr>
      <tr><td>{EX2.length}<br />{EX2M}<br />{EX2.map((p) => <>{p[0]} {p[1]}<br /></>)}</td><td>{ans2}</td></tr>
    </tbody>
  </table>

  <div class="callout callout-tip">
    <p class="callout-label">ใบ้</p>
    <p>
      จุดปลายทั้งหมด <code>2N</code> จุดตัดเส้นตรงออกเป็น<strong>ช่วง</strong> <code>2N + 1</code> ช่วง
      พอเดินจบช่วงหนึ่ง เราจะไปโผล่ที่ต้นของช่วงใดช่วงหนึ่งเสมอ และช่วงปลายทางนั้นถูกกำหนดไว้แน่นอนแล้ว
      ไม่ขึ้นกับว่าเรามาจากไหน
    </p>
    <p>
      แปลว่าเรากำลังเดินอยู่บน<strong>ฟังก์ชันที่แต่ละช่วงชี้ไปช่วงเดียว</strong> ลองวาดลูกศรจากช่วงไปช่วงดู
      แล้วถามว่ารูปที่ได้หน้าตาเป็นยังไง และ "ช่วงที่เราไม่เคยเหยียบเลย" ไปอยู่ตรงไหนของรูปนั้น
    </p>
  </div>

  <h2>ลองเอง · แจกเครื่องที่เพิ่มได้ให้คุ้มที่สุด</h2>
  <div class="cpgame tpgame" data-tpgame data-puzzles={tpJson}>
    <div class="cpg-tabs" role="tablist" aria-label="เลือกชุดโจทย์">
      {tpPuzzles.map((p, k) => (
        <button type="button" class="cpg-tab" role="tab" data-cpg-tab={String(k)} aria-selected={k === 0 ? 'true' : 'false'}>
          {p.label}
        </button>
      ))}
    </div>

    <p class="cpg-tease" data-cpg-tease>{tpPuzzles[0].tease}</p>

    <p class="gg2-goal">
      เส้นทางหลักตอนนี้ยาว <b data-tp-base>{tpPuzzles[0].base}</b> ก้าว และคุณเพิ่มเครื่องได้อีก
      <b data-tp-m>{tpPuzzles[0].m}</b> ตัว
    </p>

    <div class="cpg-scroll">
      <table class="tp-acts" data-tp-acts></table>
    </div>

    <div class="cpg-controls">
      <button type="button" class="cpg-btn" data-tp-reset>เริ่มใหม่</button>
      <button type="button" class="cpg-btn main" data-tp-check>ตรวจแต้ม</button>
    </div>

    <p class="cpg-status" data-cpg-status>เลือกว่าจะเอาเครื่องไปต่อวงไหน หรือเอาไปสร้างวงใหม่ จนกว่าเครื่องจะหมด</p>
    <p class="cpg-score" data-cpg-score>แต้มตอนนี้ <b data-tp-score>0</b> · เครื่องเหลือ <b data-tp-left>0</b> ตัว</p>
    <p class="cpg-hint">ต่อวงที่ยาว c ใช้เครื่องหนึ่งตัวแล้วได้เพิ่ม c บวกสอง ส่วนการสร้างวงใหม่ใช้สองตัวได้เพิ่มสี่ และเครื่องเดี่ยว ๆ ได้เพิ่มหนึ่ง</p>
  </div>
  <p class="io-note">
    ถ้ามีวงให้เลือกหลายวง ลองคิดก่อนว่าเรียงลำดับยังไงถึงจะคุ้มที่สุด แล้วเครื่องที่เหลือหลังต่อวงหมดแล้วควรทำอะไร
  </p>

  <h2>เฉลย · เส้นทางหลักหนึ่งเส้น กับวงที่ลอยอยู่เฉย ๆ</h2>
  <Spoiler>
    <div class="callout callout-note">
      <p class="callout-label">ที่มาของแนวคิดนี้</p>
      <p>
        คำถามที่ทำให้ทุกอย่างคลี่ออกมีข้อเดียว คือ <strong>พอเดินจบช่วงหนึ่ง เราไปโผล่ที่ช่วงไหน
        และคำตอบขึ้นกับว่าเรามาจากไหนไหม</strong> พอคิดสักพักก็เห็นว่าไม่ขึ้นเลย มันขึ้นกับจุดปลายที่เราไปเหยียบอย่างเดียว
      </p>
      <p>
        พอปลายทางถูกกำหนดไว้แน่นอนแล้ว สิ่งที่เรามีอยู่ในมือคือฟังก์ชันจากช่วงไปช่วง และเพราะการจับคู่จุดปลาย
        เป็นแบบหนึ่งต่อหนึ่ง ฟังก์ชันนั้นจึงเป็นการสลับที่ ซึ่งมีรูปร่างที่รู้กันอยู่แล้วว่าต้องเป็น
        <strong>เส้นทางกับวงปิด</strong> ไม่มีอย่างอื่น ที่เหลือคือนับ
      </p>
      <p>
        คำถามแบบเดียวกันนี้ใช้ซ้ำได้กับ <a href="../islands/">โจทย์เกาะกับสะพาน</a> ด้วย
        ถ้าปลายทางของแต่ละก้าวถูกกำหนดตายตัวเมื่อไร รูปของกราฟก็ถูกล็อกเมื่อนั้น
      </p>
    </div>
    <p>
      เรียงจุดปลายทั้ง <code>2N</code> จุดตามตำแหน่ง แล้วตั้งชื่อช่วงว่า <code>I₀</code> ถึง <code>I₂ₙ</code>
      โดย <code>I₀</code> คือช่วงจากจุดเริ่มถึงจุดปลายตัวแรก และ <code>I₂ₙ</code> คือช่วงจากจุดปลายตัวสุดท้ายถึงเส้นชัย
    </p>
    <p>
      เดินจบช่วง <code>Iⱼ</code> แปลว่าไปเหยียบจุดปลายตัวที่ <code>j+1</code> แล้วถูกโยนไปที่คู่ของมัน
      จากนั้นเดินต่อในช่วงที่อยู่<strong>ทางตะวันออกของคู่นั้นทันที</strong> การจับคู่จุดปลายเป็นการสลับที่แบบหนึ่งต่อหนึ่ง
      ลูกศรที่ได้จึงเป็น<strong>การสลับที่</strong>ของช่วง ซึ่งแตกออกเป็น<strong>เส้นทางเดียวจาก <code>I₀</code> ไป
      <code>I₂ₙ</code> บวกกับวงปิดอีกจำนวนหนึ่ง</strong>
    </p>
    <p>
      คะแนนก่อนเพิ่มเครื่องคือ<strong>จำนวนช่วงบนเส้นทางหลัก ลบหนึ่ง</strong> ส่วนวงปิดที่เหลือคือช่วงที่เราไม่มีวันไปถึง
      เพราะไม่มีลูกศรจากเส้นทางหลักชี้เข้าไปเลย
    </p>

    <figure class="tbl">
      <table class="rec">
        <caption>ทั้งสองตัวอย่าง · แยกช่วงออกเป็นเส้นทางกับวง</caption>
        <thead>
          <tr><th>ตัวอย่าง</th><th class="num">ช่วงบนเส้นทางหลัก</th><th class="num">คะแนนตั้งต้น</th><th>ขนาดของวงที่เหลือ</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>ที่ 1</td>
            <td class="num">{a1.base + 1}</td>
            <td class="num">{a1.base}</td>
            <td><code>{a1.cycles.join(', ')}</code></td>
          </tr>
          <tr>
            <td>ที่ 2</td>
            <td class="num">{a2.base + 1}</td>
            <td class="num">{a2.base}</td>
            <td><code>{a2.cycles.join(', ')}</code></td>
          </tr>
        </tbody>
      </table>
      <figcaption>
        ตัวเลขทุกตัวมาจากการสร้างการสลับที่จริงแล้วเดินตามลูกศร ไม่ได้พิมพ์มือ
        ตัวอย่างที่ 1 ยังไม่เพิ่มเครื่องเลยก็ได้ {a1.base} คะแนน แต่โจทย์ตอบ {ans1} เพราะเพิ่มได้อีกหนึ่งเครื่อง
      </figcaption>
    </figure>

    <h3>เพิ่มเครื่องหนึ่งตัวแล้วเกิดอะไรขึ้น</h3>
    <p>
      วางจุดปลายใหม่สองจุด จุดหนึ่งอยู่ในช่วง <code>A</code> อีกจุดอยู่ในช่วง <code>B</code>
      ช่วงทั้งสองถูกผ่าออกเป็นสองท่อน และลูกศรถูกต่อใหม่ให้ท่อนหน้าของ <code>A</code> พาไปท่อนหลังของ <code>B</code>
      และท่อนหน้าของ <code>B</code> พาไปท่อนหลังของ <code>A</code>
    </p>
    <p>
      กรณีที่คุ้มที่สุดคือวางจุดหนึ่งไว้บน<strong>เส้นทางหลัก</strong> อีกจุดไว้ใน<strong>วงที่ลอยอยู่</strong>
      เมื่อนั้นวงทั้งวงจะถูกดูดเข้ามาต่อในเส้นทางหลัก เส้นทางได้ช่วงเพิ่ม 1 ช่อง (จากการผ่า <code>A</code>)
      บวกกับ <code>s + 1</code> ช่อง (จากวงขนาด <code>s</code> ที่ถูกผ่าอีกที) รวมเป็น <code>s + 2</code> คะแนน
    </p>
    <div class="callout callout-warn">
      <p class="callout-label">ระวัง</p>
      <p>
        พอวงหมดแล้วยังเหลือเครื่องอยู่ อย่าเผลอคิดว่าเครื่องละ 2 คะแนน ถ้าวางจุดปลายทั้งสองไว้บนเส้นทางหลักทั้งคู่
        เส้นทางจะ<strong>ขาดตรงกลาง</strong> ท่อนที่ขาดกลายเป็นวงใหม่ที่เข้าไม่ถึง ท่าที่ดีที่สุดคือยอมให้ขาดน้อยที่สุด
        คือแตกวงขนาด 1 ออกมา ได้แค่ <strong>+1</strong> แล้วเครื่องถัดไปค่อยดูดวงขนาด 1 นั้นกลับเข้ามา ได้ <strong>+3</strong>
      </p>
      <p>
        สรุปคือสองเครื่องได้ 4 คะแนน แต่เครื่องเดี่ยว ๆ ที่เหลือค้างได้แค่ 1 คะแนน
        ตรงนี้คือจุดที่โค้ดผมพลาดรอบแรก แล้วตัวตรวจสอบจับได้
      </p>
    </div>
    <CodeBlock code={coreSnippet} lang="cpp" title="หัวใจของทั้งข้อ" />
    <p>
      และเพราะการดูดวงให้ <code>s + 2</code> ซึ่งอย่างน้อยคือ 3 ต่อหนึ่งเครื่อง ในขณะที่การแตกแล้วดูดกลับให้เฉลี่ย 2
      ต่อหนึ่งเครื่อง จึงต้อง<strong>ดูดวงให้หมดก่อนเสมอ</strong> และดูดวงใหญ่ก่อนวงเล็ก
    </p>
  </Spoiler>

  <h2>ตัวอย่างที่ 2 · เครื่องสามตัวถูกใช้ต่างกัน</h2>
  <Spoiler>
    <figure class="tbl">
      <table class="rec">
        <caption>เริ่มที่ {a2.base} คะแนน แล้วใช้เครื่องทีละตัว</caption>
        <thead>
          <tr><th class="num">เครื่องที่</th><th>เอาไปทำอะไร</th><th class="num">ได้เพิ่ม</th><th class="num">รวม</th></tr>
        </thead>
        <tbody>
          {spend2.map((r) => (
            <tr>
              <td class="num">{r.i}</td>
              <td>{r.act}</td>
              <td class="num">{r.gain}</td>
              <td class="num">{r.total}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <figcaption>
        สังเกตเครื่องที่ 2 ที่ได้แค่ 1 คะแนน มันดูเหมือนขาดทุน แต่มันคือค่าเปิดทางให้เครื่องที่ 3 ได้ 3 คะแนน
        ถ้ามีเครื่องแค่สองตัว คำตอบจะเป็น {best(a2.base, a2.cycles, 2)} ไม่ใช่ {best(a2.base, a2.cycles, 3)}
      </figcaption>
    </figure>
  </Spoiler>

  <h2>ตัวตรวจสอบที่ทำให้รู้ว่าคิดผิด</h2>
  <Spoiler>
    <div class="callout callout-warn">
      <p class="callout-label">เรื่องจริงที่เกิดขึ้นตามลำดับ</p>
      <p>
        ผมนับได้ว่าการดูดวงขนาด <code>s</code> ให้ <code>s + 2</code> โดยนับช่วงตรง ๆ ตรงนั้นมั่นใจ
        แต่กรณีที่ไม่มีวงเหลือแล้ว ผมไม่ได้นับ ผม<strong>เดาว่าน่าจะ 2 ต่อเครื่อง</strong>ด้วยความสมมาตร
        มันตอบตัวอย่างทั้งสองชุดถูก ผมเลยเดินหน้าต่อ
      </p>
      <p>
        ตัวตรวจสอบตัวแรกที่ผมเขียนเป็นสคริปต์สั้น ๆ และมัน<strong>โกหกผม</strong> เพราะผมตั้งพื้นที่ค้นหาไว้แคบเกินไป
        มันวางเครื่องได้ไม่ครบทุกความเป็นไปได้ ตัวเลขที่ได้จึงมั่วเป็นบางเคส ผมเสียเวลาไล่หาสาเหตุจากตัวเลขที่ผิดอยู่พักหนึ่ง
        ก่อนจะยอมเขียนตัวไล่วางทุกแบบใหม่เป็น C++ ซึ่งช้ากว่ามากแต่ครบจริง
      </p>
      <p>
        พอได้ตัวเลขที่เชื่อได้ ผมถึงกล้าไล่ตารางทดลอง คือตรึงชุดเครื่องตั้งต้นไว้แล้วเพิ่มเครื่องทีละตัว
        ดูว่าคะแนนขยับเท่าไร ตัวเลขที่โผล่มาคือ 1 แล้ว 3 ไม่ใช่ 2 แล้ว 2 จากตรงนั้นค่อยย้อนกลับไปหาเหตุผลว่า
        ทำไมเครื่องที่ไม่มีวงให้ดูดถึงต้องเสียตัวหนึ่งไปกับการแตกวงก่อน
      </p>
      <p>
        ลำดับที่ถูกคือ<strong>วัดให้ได้ก่อน แล้วค่อยอธิบาย</strong> รอบนี้ผมทำสลับ คือเดาแล้วเชื่อ
        เพราะตัวอย่างในโจทย์ผ่าน
      </p>
    </div>
    <p>
      รอบแรกผมเขียนว่าเครื่องที่เหลือได้ตัวละ 2 คะแนน ซึ่งฟังดูสมเหตุสมผลมาก และมัน<strong>ตอบตัวอย่างในโจทย์ถูกทั้งสองชุด</strong>
      สิ่งที่จับได้คือโปรแกรมที่<strong>ไล่วางเครื่องทุกความเป็นไปได้แล้วจำลองการเดินจริง</strong>
    </p>
    <p>
      มันช้ามาก ใช้ได้แค่กับเครื่องไม่กี่ตัวและเส้นตรงสั้น ๆ แต่มันไม่เชื่อทฤษฎีอะไรของผมเลย
      พอสุ่มเทียบ 200 ชุด มันชี้ทันทีว่าเคสที่มีวงเดียวแล้วเหลือเครื่องอีกตัว ผมตอบเกินจริงไปหนึ่ง
    </p>
    <details class="expander">
      <summary>ดูโค้ดตัวตรวจสอบ (ไล่วางทุกแบบแล้วจำลอง)</summary>
      <div class="expander-body">
        <CodeBlock code={checkCode} lang="cpp" title="brute_tele.cpp" />
      </div>
    </details>
    <p>
      ข้อคิดที่อยากฝากไว้คือ <strong>การตอบตัวอย่างในโจทย์ถูกไม่ใช่หลักฐานอะไรเลย</strong>
      โดยเฉพาะกับข้อที่คำตอบเป็นสูตรโลภสั้น ๆ เพราะตัวอย่างในโจทย์มักถูกออกแบบมาให้เห็นภาพ ไม่ได้ออกแบบมาให้จับบัก
    </p>
  </Spoiler>

  <h2>โค้ด C++</h2>
  <Spoiler>
    <p>
      อินพุตมีเลขได้ถึงสี่ล้านตัว การอ่านด้วย <code>scanf</code> ทีละตัวช้าเกินลิมิตหนึ่งวินาที
      โค้ดนี้จึงอ่านทั้งไฟล์เข้ามาก้อนเดียวแล้วแยกเลขเอง เวลาที่วัดได้ลดจาก 744 มิลลิวินาทีเหลือ
      <strong>258 มิลลิวินาที</strong>
    </p>
    <p>
      ส่วนการแปลงตำแหน่งเป็นหมายเลขจุดปลาย ใช้อาเรย์ขนาดเท่าตำแหน่งที่ไกลที่สุด เพราะพิกัดไม่เกินสองล้าน
      ตำแหน่งจุดจบจริง ๆ ที่โจทย์บอกว่าเป็น 2,000,001 ไม่มีผลกับคำตอบเลย มีผลแค่ว่าช่วงสุดท้ายชื่ออะไร
    </p>
    <details class="expander">
      <summary>ดูโค้ดเต็ม</summary>
      <div class="expander-body">
        <CodeBlock code={solution} lang="cpp" title="tele.cpp" />
      </div>
    </details>
    <p>
      โครงสร้าง "แต่ละปมชี้ไปปมเดียว" ที่ข้อนี้ใช้มีชื่อเรียกและมีท่าประจำของมัน อ่านได้ที่บทปูพื้นฐาน
      <a href="../functional-graph/">กราฟที่ทุกปมมีทางออกทางเดียว</a>
    </p>
  </Spoiler>

  <h2>สรุปบรรทัดเดียว</h2>
  <p>
    เมื่อการเดินถูกบังคับให้ไปทางเดียว ช่วงระหว่างจุดปลายจะกลายเป็นการสลับที่ คำตอบตั้งต้นคือความยาวของวงที่มีจุดเริ่ม
    และการเพิ่มเครื่องคือการดูดวงอื่นเข้ามาต่อ ยกเว้นตอนไม่มีวงเหลือ ที่เราต้องยอมจ่ายหนึ่งเครื่องแตกวงขึ้นมาเอง
  </p>

