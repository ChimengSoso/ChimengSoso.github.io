<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type TpPuzzle = {
    id: string;
    label: string;
    tease: string;
    m: number;
    pts: number[];
    oldPartner: number[];
    start: number;
    best: number;
  };
  /** จุดปลายใหม่หนึ่งจุด: อยู่ในช่วงที่ iv และ seq บอกลำดับการแตะ (แตะทีหลังอยู่ทางตะวันออก) */
  type Placed = { iv: number; seq: number };

  const START_MSG = 'แตะช่วงบนเส้นเพื่อวางจุดปลาย สองแตะเป็นหนึ่งเครื่อง จะแตะช่วงเดิมซ้ำก็ได้';

  /** เดินตามกฎของโจทย์ตรง ๆ แล้วนับจำนวนครั้งที่ถูกโยน ใช้เฉพาะเครื่องที่วางครบสองปลายแล้ว */
  function walkScore(p: TpPuzzle, placed: Placed[]): number {
    const used = placed.length - (placed.length % 2);
    type Key = { iv: number; ord: number; who: number };
    const keys: Key[] = [];
    /* จุดปลายเดิมตัวที่ j เป็นขอบตะวันออกของช่วง j จึงมาหลังจุดใหม่ทุกจุดในช่วงนั้น */
    p.pts.forEach((_, j) => keys.push({ iv: j, ord: Infinity, who: j }));
    for (let t = 0; t < used; t++) keys.push({ iv: placed[t].iv, ord: placed[t].seq, who: p.pts.length + t });
    keys.sort((a, b) => a.iv - b.iv || a.ord - b.ord);
    const at = new Array<number>(keys.length).fill(-1);
    keys.forEach((k, i) => {
      at[k.who] = i;
    });
    const partner = new Array<number>(keys.length).fill(-1);
    p.pts.forEach((_, j) => {
      partner[at[j]] = at[p.oldPartner[j]];
    });
    for (let t = 0; t < used; t++) partner[at[p.pts.length + t]] = at[p.pts.length + (t ^ 1)];
    let pos = -1;
    let score = 0;
    while (pos + 1 < keys.length) {
      pos = partner[pos + 1];
      score++;
      if (score > 4 * keys.length + 4) break;
    }
    return score;
  }

  function initTpGame(): void {
    const maybeUi = cpGameUi('[data-tpgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as TpPuzzle[];
    if (puzzles.length === 0) return;

    const lineEl = ui.root.querySelector<HTMLElement>('[data-tp-line]');
    const scoreEl = ui.root.querySelector<HTMLElement>('[data-tp-score]');
    const usedEl = ui.root.querySelector<HTMLElement>('[data-tp-used]');
    const mEl = ui.root.querySelector<HTMLElement>('[data-tp-m]');
    const targetEl = ui.root.querySelector<HTMLElement>('[data-tp-target]');
    const bestEl = ui.root.querySelector<HTMLElement>('[data-tp-best]');
    if (!lineEl || !scoreEl || !usedEl || !mEl || !targetEl || !bestEl) return;
    const line: HTMLElement = lineEl;
    const scoreOut: HTMLElement = scoreEl;
    const usedOut: HTMLElement = usedEl;
    const mOut: HTMLElement = mEl;
    const target: HTMLElement = targetEl;
    const bestOut: HTMLElement = bestEl;

    let pi = 0;
    let placed: Placed[] = [];
    let seq = 0;
    let tried = false;

    const pz = (): TpPuzzle => puzzles[pi];
    const span = (i: number): string => {
      const pts = pz().pts;
      return `${i === 0 ? '0' : pts[i - 1]}–${i === pts.length ? 'ชัย' : pts[i]}`;
    };

    function buildLine(): void {
      line.textContent = '';
      for (let i = 0; i <= pz().pts.length; i++) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'tp-iv';
        b.dataset.iv = String(i);
        const s = document.createElement('span');
        s.className = 'tp-span';
        s.textContent = span(i);
        const marks = document.createElement('span');
        marks.className = 'tp-marks';
        b.append(s, marks);
        line.appendChild(b);
      }
    }

    function render(): void {
      const p = pz();
      for (const b of Array.from(line.querySelectorAll<HTMLElement>('[data-iv]'))) {
        const iv = Number(b.dataset.iv);
        const marks = b.querySelector<HTMLElement>('.tp-marks');
        if (!marks) continue;
        /* แสดงเลขเครื่องของแต่ละจุดในช่วงนี้ เรียงจากตะวันตกไปตะวันออก */
        marks.textContent = placed
          .map((q, t) => ({ q, t }))
          .filter((x) => x.q.iv === iv)
          .sort((x, y) => x.q.seq - y.q.seq)
          .map((x) => String(Math.floor(x.t / 2) + 1))
          .join(' ');
      }
      scoreOut.textContent = String(walkScore(p, placed));
      usedOut.textContent = String(Math.floor(placed.length / 2));
      mOut.textContent = String(p.m);
      bestOut.textContent = String(p.best);
      target.hidden = !tried;
    }

    function place(iv: number): void {
      if (placed.length >= 2 * pz().m) {
        ui.setStatus(`วางครบ ${pz().m} เครื่องแล้ว กดตรวจแต้ม หรือย้อนเพื่อลองแบบอื่น`, 'bad');
        return;
      }
      placed.push({ iv, seq: seq++ });
      ui.setStatus(
        placed.length % 2 === 1
          ? `วางปลายแรกของเครื่องที่ ${Math.floor(placed.length / 2) + 1} แล้ว แตะอีกช่วงเพื่อวางปลายที่สอง`
          : START_MSG,
      );
      render();
    }

    function check(): void {
      const p = pz();
      if (placed.length % 2 === 1) {
        ui.setStatus('เครื่องสุดท้ายยังมีปลายเดียว วางปลายที่สองก่อนครับ', 'bad');
        return;
      }
      tried = true;
      const s = walkScore(p, placed);
      if (s === p.best) ui.setStatus(`ได้ ${s} แต้ม เท่ากับแต้มสูงสุดของชุดนี้แล้วครับ`, 'good');
      else ui.setStatus(`ได้ ${s} แต้ม ชุดนี้ทำได้ถึง ${p.best} ลองวางแบบอื่นดู`, 'bad');
      render();
    }

    function selectPuzzle(k: number): void {
      pi = k;
      placed = [];
      seq = 0;
      tried = false;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildLine();
      ui.setStatus(START_MSG);
      render();
    }

    line.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const b = e.target.closest('[data-iv]');
      if (!(b instanceof HTMLElement)) return;
      place(Number(b.dataset.iv ?? '0'));
    });

    ui.onClick('data-tp-reset', () => selectPuzzle(pi));
    ui.onClick('data-tp-undo', () => {
      placed.pop();
      ui.setStatus(START_MSG);
      render();
    });
    ui.onClick('data-tp-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initTpGame);
</script>

