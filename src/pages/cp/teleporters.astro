  .tp-line :global(.tp-marks){min-height:1.2em;color:#ffe58a;font-weight:700;font-family:monospace;}

  /* ตารางของตัวเล่นตัวอย่างที่ 2 แถวโผล่ทีละแถว ห้ามให้ข้อความไทยในแถวมากำหนดความกว้างของการ์ด
     !important เพราะต้องชนะ body .panel .dpsim table.rec{width:100%} ของ CpProblemLayout */
