    flex:0 0 auto;min-width:4.2rem;display:flex;flex-direction:column;align-items:center;gap:0.25rem;
    padding:0.45rem 0.6rem;border:1px solid #2a3350;border-radius:7px;background:#111a2e;
    color:#cdd6ea;font:inherit;font-size:0.82rem;cursor:pointer;
  }
  .tp-line :global(.tp-iv:hover){border-color:#4ade80;}
