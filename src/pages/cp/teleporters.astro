type TpPuzzleData = {
  id: string;
  label: string;
  tease: string;
  m: number;
  pts: number[];
  oldPartner: number[];
  start: number;
  best: number;
};
const tpPuzzles: TpPuzzleData[] = TP_PUZZLES.map((p) => {
  const pts = p.pairs.flat().sort((x, y) => x - y);
  const oldPartner: number[] = new Array<number>(pts.length).fill(-1);
  for (const [x, y] of p.pairs) {
    oldPartner[pts.indexOf(x)] = pts.indexOf(y);
    oldPartner[pts.indexOf(y)] = pts.indexOf(x);
  }
  const start = bruteExact(p.pairs, 0);
  const top = bruteExact(p.pairs, p.m);
  const a = analyse(p.pairs);
  if (start !== a.base || top !== best(a.base, a.cycles, p.m)) {
    throw new Error(`มินิเกมของ teleporters: ชุด ${p.id} ตัวไล่ทุกแบบได้ ${start}/${top} ไม่ตรงกับสูตร`);
  }
  return { id: p.id, label: p.label, tease: p.tease, m: p.m, pts, oldPartner, start, best: top };
});
const tpJson = JSON.stringify(tpPuzzles);
/** ป้ายของช่วงที่ i บนกระดาน (ตำแหน่งต้นถึงปลาย) */
const tpSpan = (pts: number[], i: number): string =>
  `${i === 0 ? '0' : pts[i - 1]}–${i === pts.length ? 'ชัย' : pts[i]}`;
const tpFirstSpans = Array.from({ length: tpPuzzles[0].pts.length + 1 }, (_, i) => tpSpan(tpPuzzles[0].pts, i));

/* ตารางแสดงว่าเครื่องแต่ละตัวถูกใช้ทำอะไร ในตัวอย่างที่สอง */
type Spend = { i: number; act: string; gain: number; total: number };
function spendTable(base: number, cycles: number[], m: number): Spend[] {
  const rows: Spend[] = [];
  let total = base;
  let ci = 0;
  let pend = false;
  for (let i = 1; i <= m; i++) {
    if (ci < cycles.length) {
      const g = cycles[ci] + 2;
      total += g;
      rows.push({ i, act: `ดูดวงขนาด ${cycles[ci]} เข้ามาต่อ`, gain: g, total });
      ci++;
    } else if (!pend) {
      total += 1;
      rows.push({ i, act: 'ไม่มีวงเหลือแล้ว จึงต้องแตกวงขนาด 1 ออกมาก่อน', gain: 1, total });
      pend = true;
    } else {
      total += 3;
      rows.push({ i, act: 'ดูดวงขนาด 1 ที่เพิ่งแตกไว้กลับเข้ามา', gain: 3, total });
      pend = false;
    }
  }
  return rows;
}
const spend2 = spendTable(a2.base, a2.cycles, EX2M);

const NMAX = 1000000;
const fmt = (n: number): string => n.toLocaleString('en-US');

const solution = `#include <bits/stdc++.h>
using namespace std;
// อ่านเลขเองจากบัฟเฟอร์ก้อนละ 64 KB อินพุตมีราวสองล้านตัวเลข scanf ทีละตัวกินเวลาไปเปล่า ๆ
static char ibuf[1<<16]; static size_t ipos=0, ilen=0;
static inline int gc(){
    if(ipos==ilen){ ilen=fread(ibuf,1,sizeof(ibuf),stdin); ipos=0; if(ilen==0) return -1; }
    return ibuf[ipos++];
}
static inline int rd(){
    int c=gc(); while(c!=-1 && (c<'0'||c>'9')) c=gc();
    int v=0; while(c>='0' && c<='9'){ v=v*10+(c-'0'); c=gc(); }
    return v;
}
int main(){
    int n=rd(), m=rd();
    const int MAXPOS=2000000;
    vector<int> partnerAt(MAXPOS+1,0);             // partnerAt[p] = ตำแหน่งปลายอีกข้าง (0 = ไม่มีปลายที่ p)
    int hi=0;
    for(int i=0;i<n;i++){ int w=rd(), e=rd(); partnerAt[w]=e; partnerAt[e]=w; hi=max(hi,e); }
    // ไล่ตำแหน่งจากตะวันตกไปตะวันออก ให้เลขปลาย 1..2n ตามลำดับที่เจอ (ไม่ต้องเรียง)
    // ช่วง I_j อยู่ทางตะวันออกของปลายที่ j (I_0 คือช่วงจากจุดเริ่ม)
    vector<int> id(hi+1,0);
    int P=0;
    for(int p=1;p<=hi;p++) if(partnerAt[p]) id[p]=++P;
    // nxt[j] = ช่วงถัดไปหลังจากเดินจบช่วง j  (j = 0..P-1)  เดินจบ I_j คือเหยียบปลายที่ j+1
    vector<int> nxt(P+1,-1);
    for(int p=1;p<=hi;p++) if(partnerAt[p]) nxt[id[p]-1]=id[partnerAt[p]];
    // เดินจาก I_0 ไปจนถึง I_P นับจำนวนครั้งที่ถูกย้าย
    vector<char> vis(P+1,0);
    long long base=0; int cur=0;
    while(cur!=P){ vis[cur]=1; cur=nxt[cur]; base++; }
    vis[P]=1;
    // วงที่เหลือ เก็บแค่ขนาด
    vector<int> cyc;
    for(int j=0;j<P;j++) if(!vis[j]){ int len=0, u=j; while(!vis[u]){ vis[u]=1; u=nxt[u]; len++; } cyc.push_back(len); }
    sort(cyc.rbegin(),cyc.rend());                 // วงใหญ่ก่อน
    long long ans=base;                            // base = จำนวนครั้งที่ถูกย้ายก่อนเพิ่มเครื่อง
    int used=0;
    for(size_t i=0;i<cyc.size() && used<m; i++,used++) ans+=cyc[i]+2;   // ดูดวงเข้ามาต่อในเส้นทาง
    long long r=m-used;                            // เครื่องที่เหลือเมื่อไม่มีวงให้ดูดแล้ว
    ans += (r/2)*4 + (r%2)*1;                      // ต้องเสียหนึ่งเครื่องแตกวงก่อน อีกเครื่องค่อยดูดกลับ
    printf("%lld\\n",ans);
}`;
const checkCode = `#include <bits/stdc++.h>
using namespace std;
int LIM;
int simulate(vector<pair<int,int>>& ps){
    static int par[400]; for(int i=0;i<=LIM;i++) par[i]=-1;
    for(auto&[a,b]:ps){ par[a]=b; par[b]=a; }
    int pos=0,sc=0;
    while(true){
        int nx=-1; for(int p=pos+1;p<=LIM;p++) if(par[p]>=0){ nx=p; break; }
        if(nx<0) return sc;
        pos=par[nx]; sc++; if(sc>3000) return -1;
    }
}
int main(int argc,char**argv){
    int n,m; scanf("%d %d %d",&n,&m,&LIM);
    vector<pair<int,int>> base(n);
    set<int> used;
    for(auto&p:base){ scanf("%d %d",&p.first,&p.second); used.insert(p.first); used.insert(p.second); }
    vector<int> freeP; for(int i=1;i<=LIM;i++) if(!used.count(i)) freeP.push_back(i);
    int F=(int)freeP.size(), need=2*m, best=0;
    vector<int> idx(need);
    function<void(int,int)> choose=[&](int start,int k){
        if(k==need){
            vector<int> sel; for(int i=0;i<need;i++) sel.push_back(freeP[idx[i]]);
            sort(sel.begin(),sel.end());
            do{
                vector<pair<int,int>> ps=base;
                for(int i=0;i<m;i++){ int a=sel[2*i],b=sel[2*i+1]; if(a>b) swap(a,b); ps.push_back({a,b}); }
                best=max(best,simulate(ps));
            } while(next_permutation(sel.begin(),sel.end()));
            return;
        }
        for(int i=start;i<F;i++){ idx[k]=i; choose(i+1,k+1); }
    };
    if(m==0) best=simulate(base); else choose(0,0);
    printf("%d\\n",best);
}`;
const coreSnippet = `long long ans = base;                    // คะแนนก่อนเพิ่มเครื่อง
int used = 0;
for (size_t i = 0; i < cyc.size() && used < m; i++, used++)
    ans += cyc[i] + 2;                   // ดูดวงขนาด s เข้ามาต่อ ได้เพิ่ม s + 2

long long r = m - used;                  // เครื่องที่เหลือ ตอนไม่มีวงให้ดูดแล้ว
ans += (r / 2) * 4 + (r % 2) * 1;        // ต้องเสียเครื่องหนึ่งแตกวงก่อน อีกเครื่องค่อยดูดกลับ`;
/* ---------- โค้ดที่ผิดรอบแรก กับเคสเล็กที่สุดที่จับมันได้ ----------
   คิดแต้มของเครื่องที่เหลือเป็นตัวละ 2 คะแนน ต่างจากของจริงเมื่อเครื่องที่เหลือเป็นจำนวนคี่ */
const brokenSnippet = `long long r = m - used;                  // เครื่องที่เหลือ ตอนไม่มีวงให้ดูดแล้ว
ans += r * 2;                            // <-- บรรทัดที่ผิด เดาว่าเครื่องละ 2 ด้วยความสมมาตร
                                         // ของจริงคือ (r / 2) * 4 + (r % 2) * 1`;
/** สูตรที่ผิด ใช้คิดว่าเลขที่โค้ดรอบแรกพ่นออกมาคือเท่าไร */
function bestWrong(base: number, cycles: number[], m: number): number {
  let ans = base;
  let used = 0;
  for (const c of cycles) {
    if (used >= m) break;
    ans += c + 2;
    used++;
  }
  return ans + (m - used) * 2;
}
const BROKEN: Pair[] = [[1, 2]];
const BROKEN_M = 2;
const aBroken = analyse(BROKEN);
const brokenTrue = best(aBroken.base, aBroken.cycles, BROKEN_M);
const brokenWrong = bestWrong(aBroken.base, aBroken.cycles, BROKEN_M);
/* สร้างบรรทัดของเครื่องแยกไว้ก่อน template literal ซ้อนใน ${} ทำให้ตัวแปลง frontmatter พัง */
const brokenLines = BROKEN.map((p) => p[0] + ' ' + p[1]).join('\n');
const brokenInput = BROKEN.length + '\n' + BROKEN_M + '\n' + brokenLines;

/* คำอธิบายรายเครื่องของตัวอย่างที่ 2 สร้างจาก spend2 ตัวเดียวกับตาราง */
const teleNotes = spend2.map((r) => ({
  note: `เครื่องที่ <b>${r.i}</b> ${r.act} ได้เพิ่ม <em>${r.gain}</em> คะแนน รวมเป็น <b>${r.total}</b>`,
}));


/* ---------- ตัวไล่ทุกแบบ เขียนแยกจากสูตร ----------
   จุดปลายใหม่วางตรงไหนก็ได้ (ไม่ต้องเป็นจำนวนเต็ม) สิ่งเดียวที่มีผลจึงเป็นลำดับของมันเทียบกับจุดปลายเดิม
   ตัวนี้ไล่ทุกจำนวนเครื่อง k = 0..m ทุกลำดับของจุดปลายใหม่ 2k จุด และทุกวิธีจับคู่ แล้วเดินตามกฎของโจทย์ตรง ๆ
   ไม่ใช้เรื่องช่วง วง หรือสูตรคะแนนเลย */
function matchings(pts: number[]): Pair[][] {
  if (pts.length === 0) return [[]];
  const [a, ...rest] = pts;
  const out: Pair[][] = [];
  rest.forEach((b, i) => {
    for (const mt of matchings(rest.filter((_, k) => k !== i))) out.push([[a, b], ...mt]);
  });
  return out;
}
function bruteExact(pairs: Pair[], m: number): number {
  const n = pairs.length;
  const rank = new Map<number, number>();
  pairs
    .flat()
    .sort((x, y) => x - y)
    .forEach((p, i) => rank.set(p, i));
  const oldPartner: number[] = new Array<number>(2 * n).fill(-1);
  for (const [x, y] of pairs) {
    const rx = rank.get(x) as number;
    const ry = rank.get(y) as number;
    oldPartner[rx] = ry;
    oldPartner[ry] = rx;
  }
  let top = 0;
  for (let k = 0; k <= m; k++) {
    const T = 2 * n + 2 * k;
    const newPairings = matchings(Array.from({ length: 2 * k }, (_, i) => i));
    const chosen: number[] = [];
    const walkAll = (): void => {
      const isNew = new Array<boolean>(T).fill(false);
      for (const c of chosen) isNew[c] = true;
      const oldAt: number[] = [];
      const newAt: number[] = [];
      for (let s = 0; s < T; s++) (isNew[s] ? newAt : oldAt).push(s);
      for (const mt of newPairings) {
        const partner = new Array<number>(T).fill(-1);
        for (let r = 0; r < 2 * n; r++) partner[oldAt[r]] = oldAt[oldPartner[r]];
        for (const [x, y] of mt) {
          partner[newAt[x]] = newAt[y];
          partner[newAt[y]] = newAt[x];
        }
        /* pos คือจุดปลายที่เพิ่งโผล่ เดินไปทางตะวันออกก็เหยียบจุดปลายถัดไปเสมอ */
        let pos = -1;
        let score = 0;
        while (pos + 1 < T) {
          pos = partner[pos + 1];
          score++;
          if (score > 4 * T) throw new Error('teleporters: ตัวไล่ทุกแบบเดินวนไม่จบ');
        }
        top = Math.max(top, score);
      }
    };
    const pick = (start: number, left: number): void => {
      if (left === 0) {
        walkAll();
        return;
      }
      for (let s = start; s + left <= T; s++) {
        chosen.push(s);
        pick(s + 1, left - 1);
        chosen.pop();
      }
    };
    pick(0, 2 * k);
  }
  return top;
}

/* ---------- ไล่ครบทุกกรณีเล็กตอนบิลด์ เทียบสูตรกับตัวไล่ทุกแบบ ---------- */
const SWEEP_MAX = 3;
type SweepHit = { n: number; m: number; pairs: Pair[]; good: number; bad: number; base: number; cycles: number[] };
let sweepCases = 0;
const sweepHits: SweepHit[] = [];
for (let n = 1; n <= SWEEP_MAX; n++)
  for (const pairs of matchings(Array.from({ length: 2 * n }, (_, i) => i + 1)))
    for (let m = 1; m <= SWEEP_MAX; m++) {
      sweepCases++;
      const a = analyse(pairs);
      const good = best(a.base, a.cycles, m);
      const truth = bruteExact(pairs, m);
      if (good !== truth)
        throw new Error(`teleporters: กรณี N=${n} M=${m} ${JSON.stringify(pairs)} สูตรได้ ${good} แต่ตัวไล่ทุกแบบได้ ${truth}`);
      const bad = bestWrong(a.base, a.cycles, m);
      if (bad !== truth) sweepHits.push({ n, m, pairs, good, bad, base: a.base, cycles: a.cycles });
    }
/* ตัวอย่างในโจทย์ทั้งสองชุด ทุก M ตั้งแต่ 1 ถึง 3 (รวมขั้นที่ 2 ของตัวเล่น และคำถามข้อ 3) เทียบกับตัวไล่ทุกแบบด้วย */
const QUIZ3: Pair[] = [[1, 2]];
let directChecks = 0;
for (const ps of [EX1, EX2, QUIZ3])
  for (let m = 1; m <= SWEEP_MAX; m++) {
    const a = analyse(ps);
    if (best(a.base, a.cycles, m) !== bruteExact(ps, m))
      throw new Error(`teleporters: ${JSON.stringify(ps)} M=${m} สูตรไม่ตรงกับตัวไล่ทุกแบบ`);
    directChecks++;
  }
const sweepMinSize = Math.min(...sweepHits.map((h) => h.n + h.m));
const sweepSmallest = sweepHits.filter((h) => h.n + h.m === sweepMinSize);
const isBroken = (h: SweepHit): boolean =>
  h.m === BROKEN_M && JSON.stringify(h.pairs) === JSON.stringify(BROKEN);
const sweepOther = sweepSmallest.find((h) => !isBroken(h));
if (sweepSmallest.length !== 2 || !sweepSmallest.some(isBroken) || !sweepOther)
  throw new Error('teleporters: กรณีเล็กที่สุดที่สูตรผิดพังควรมีสองกรณี และหนึ่งในนั้นคือกรณีที่หน้านี้แสดง');
const sweepOtherPairs = sweepOther.pairs.map((p) => `(${p[0]}, ${p[1]})`).join(' กับ ');
/* เครื่องที่เหลือในตัวอย่างของโจทย์ ทั้งสองชุดเป็นจำนวนคู่ สูตรที่ผิดจึงตอบตรง */
const left1 = EX1M - Math.min(EX1M, a1.cycles.length);
const left2 = EX2M - Math.min(EX2M, a2.cycles.length);
if (left1 % 2 !== 0 || left2 % 2 !== 0 || bestWrong(a1.base, a1.cycles, EX1M) !== ans1 || bestWrong(a2.base, a2.cycles, EX2M) !== ans2)
  throw new Error('teleporters: ข้ออ้างว่าสูตรที่ผิดตอบตัวอย่างในโจทย์ถูกทั้งสองชุดไม่จริงแล้ว');

/* ---------- การให้เลขช่วงของตัวอย่างที่ 1 พร้อมตัวเลขจริงหนึ่งก้าว ---------- */
const ex1Pts = sh1.pts;
const ex1Partner = new Map<number, number>();
for (const [x, y] of EX1) {
  ex1Partner.set(x, y);
  ex1Partner.set(y, x);
}
const ex1HitPos = ex1Pts[0];
const ex1LandPos = ex1Partner.get(ex1HitPos) as number;
const ex1LandK = ex1Pts.indexOf(ex1LandPos) + 1;
if (ex1LandK !== sh1.path[1]) throw new Error('teleporters: ตัวอย่างก้าวแรกไม่ตรงกับเส้นทางในภาพ');

/* ---------- เครื่องที่เหลือ: แตกวงขนาด 1 แล้วดูดกลับ วาดจากโมเดลทีละเครื่อง ----------
   เริ่มจากชุดที่เส้นทางหลักผ่านครบทุกช่วงแล้ว ไม่มีวงให้ดูด */
const LEFT0: Pair[] = [
  [1, 3],
  [2, 4],
];
const LEFT_M1: Pair = [3.2, 3.6];
const LEFT_M2: Pair = [0.5, 3.4];
const aL0 = analyse(LEFT0);
const aL1 = analyse([...LEFT0, LEFT_M1]);
const aL2 = analyse([...LEFT0, LEFT_M1, LEFT_M2]);
const shL0 = shape(LEFT0);
const shL1 = shape([...LEFT0, LEFT_M1]);
const shL2 = shape([...LEFT0, LEFT_M1, LEFT_M2]);
if (
  aL0.cycles.length !== 0 ||
  aL1.base !== aL0.base + 1 ||
  aL1.cycles.length !== 1 ||
  aL1.cycles[0] !== 1 ||
  aL2.cycles.length !== 0 ||
  aL2.base !== aL1.base + 3 ||
  aL2.base !== best(aL0.base, aL0.cycles, 2)
)
  throw new Error('teleporters: ภาพเครื่องที่เหลือไม่ได้ +1 แล้ว +3 ตามที่หน้าเล่า');
const leftLoopSpan = (() => {
  const i = shL1.loops[0][0];
  return `${shL1.pts[i - 1]}–${shL1.pts[i]}`;
})();
const leftDraws = [
  {
    dr: drawShape(shL1, false),
    title: 'หลังเครื่องที่ 1',
    cap: `เริ่มจากเครื่อง (1, 3) กับ (2, 4) ที่เส้นทางหลักผ่านครบทั้ง ${shL0.intervals} ช่วง ได้ ${aL0.base} คะแนน เครื่องที่ 1 วางจุดปลายที่ ${LEFT_M1[0]} กับ ${LEFT_M1[1]} ในช่วง 3–4 ช่วงเดียวกัน ท่อน ${leftLoopSpan} ตรงกลางชี้กลับหาตัวเอง กลายเป็นวงขนาด 1 ส่วนเส้นทางได้เพิ่มหนึ่งช่วง เป็น ${aL1.base} คะแนน (วาดประกอบโดยผู้เขียน)`,
  },
  {
    dr: drawShape(shL2, false),
    title: 'หลังเครื่องที่ 2',
    cap: `เครื่องที่ 2 วางจุดหนึ่งที่ ${LEFT_M2[0]} บนเส้นทางหลัก อีกจุดที่ ${LEFT_M2[1]} ในวงขนาด 1 นั้น วงถูกดูดเข้ามาได้ 1 + 2 = 3 คะแนน รวมเป็น ${aL2.base} สองเครื่องได้ ${aL2.base - aL0.base} คะแนน (วาดประกอบโดยผู้เขียน)`,
  },
];

/* ---------- เทียบสามวิธี นับเป็น "ก้าว" หน่วยเดียวกันหมด ----------
   หนึ่งก้าว = อ่านหนึ่งตำแหน่ง เดินตามลูกศรหนึ่งเส้น หรือเทียบหนึ่งครั้งตอนเรียง
   วิธีที่ 1 คือตัวตรวจ: นับแค่จำนวนรอบจำลอง รอบละอย่างน้อยหนึ่งก้าว จึงเป็นค่าต่ำสุดของงานจริง
   วิธีที่ 2 ตัดสินใจทีละเครื่องแบบเดียวกับท่าโลภ แต่ทุกรอบให้เลขจุดปลายใหม่ด้วยการเรียง แล้วเดินทุกช่วงใหม่
   วิธีเต็ม ไล่ตำแหน่งสองรอบ เดินทุกช่วงครั้งเดียว แล้วเรียงขนาดวง ซึ่งมีไม่เกิน N วง */
const POS_MAX = 2000000;
const OPS_PER_SEC = 1e8;
const SUB_N = 500;
const nCr = (n: number, r: number): number => {
  let v = 1;
  for (let i = 1; i <= r; i++) v = (v * (n - r + i)) / i;
  return Math.round(v);
};
const factorial = (k: number): number => (k <= 1 ? 1 : k * factorial(k - 1));
const clog2 = (x: number): number => Math.ceil(Math.log2(x));
const STRESS_N = 3;
const STRESS_M = 2;
/* ตอนทดสอบ จุดปลายเดิมวางที่ตำแหน่ง g, 2g, ..., 2N·g โดย g = 2M + 1 และ LIM = (2N + 1)g
   ทุกช่องว่าง รวมช่องก่อนจุดแรกและหลังจุดสุดท้าย จึงมีที่ว่างอย่างน้อย 2M ตำแหน่ง */
const STRESS_GAP = 2 * STRESS_M + 1;
const stressLim = (2 * STRESS_N + 1) * STRESS_GAP;
const stressFree = stressLim - 2 * STRESS_N;
if (STRESS_GAP - 1 < 2 * STRESS_M || stressLim - 2 * STRESS_N * STRESS_GAP < 2 * STRESS_M)
  throw new Error('teleporters: ระยะห่างในการทดสอบไม่พอให้ตัวตรวจไล่ครบทุกลำดับ');
const bruteWalks = nCr(stressFree, 2 * STRESS_M) * factorial(2 * STRESS_M);
/* แต่ละการวางถูกนับซ้ำ 2^M · M! ครั้ง (สลับปลายในเครื่อง และสลับลำดับเครื่อง) */
const bruteDup = 2 ** STRESS_M * factorial(STRESS_M);
const bruteDistinct = bruteWalks / bruteDup;
let bruteSubLog10 = 0;
for (let k = 2; k <= 2 * SUB_N; k++) bruteSubLog10 += Math.log10(k);
const bruteSubExp = Math.floor(bruteSubLog10);
const roundsCost = (n: number, m: number): number => {
  const e = 2 * (n + m);
  return m * (e * clog2(e) + e + 1);
};
const fullCost = (n: number): number => 2 * POS_MAX + (2 * n + 1) + n * clog2(n);
type LadderCell = { text: string; ok: boolean; exp?: number };
const cell = (v: number): LadderCell => ({ text: fmt(v), ok: v <= OPS_PER_SEC });
const ladderRows: { name: string; sub: LadderCell; full: LadderCell }[] = [
  { name: 'วิธีที่ 1 ไล่วางทุกแบบ', sub: { text: 'มากกว่า 10', exp: bruteSubExp, ok: false }, full: { text: 'มากกว่านั้นอีก', ok: false } },
  { name: 'วิธีที่ 2 นับใหม่ทุกเครื่อง', sub: cell(roundsCost(SUB_N, SUB_N)), full: cell(roundsCost(NMAX, NMAX)) },
  { name: 'วิธีเต็ม แยกเส้นทางกับวงครั้งเดียว', sub: cell(fullCost(SUB_N)), full: cell(fullCost(NMAX)) },
];
if (!ladderRows[1].sub.ok || ladderRows[1].full.ok || !ladderRows[2].full.ok)
  throw new Error('teleporters: ตารางเทียบวิธีไม่ตรงกับคำบรรยายในการ์ด');

/* ---------- ตัวเลขที่วัดจากไบนารีจริง (WSL, g++ 11.4 -O2, วัดสามรอบต่ออินพุต) ---------- */
const MEASURED = {
  fullMax: '0.44',
  scanfMax: '0.63',
  peakKB: 33032,
  oldPeakKB: 67236,
  limitKB: 64 * 1024,
};
const STRESS = { small: 300, smallWrong: 90, medium: 200, mediumN: 2000, mediumM: 3000 };

/* ---------- ทดสอบตัวเอง ---------- */
const quiz1 = best(a1.base, a1.cycles, 2);
const aQ3 = analyse(QUIZ3);
const quiz3 = best(aQ3.base, aQ3.cycles, 3);
if (quiz1 !== a1.base + a1.cycles[0] + 2 + a1.cycles[1] + 2 || quiz3 !== aQ3.base + aQ3.cycles[0] + 2 + 4)
  throw new Error('teleporters: คำเฉลยของคำถามทดสอบตัวเองไม่ตรงกับสูตร');

