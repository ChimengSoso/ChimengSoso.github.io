---
import DivineLoreLayout from '../../layouts/DivineLoreLayout.astro';
import { cpProblemsBySet, publishedCpProblems } from '../../data/cp';
import { formatThaiDateShort } from '../../lib/dates';

const groups = cpProblemsBySet();
const total = publishedCpProblems.length;
---
<DivineLoreLayout
  title="หมวดโจทย์แข่ง | ChimengSoso"
  description="คลังโจทย์ competitive programming ที่ผมนั่งแกะเอง พร้อมเฉลยแบบเล่าให้เข้าใจ"
>
  <nav class="dl-nav">
    <a href="/divine-lore/">
      <svg class="dl-nav-arrow" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
      กลับบันทึกศาสตร์แห่งเทพ
    </a>
  </nav>

  <p class="tag">หมวดโจทย์แข่ง</p>
  <h1>คลังโจทย์ที่ผมนั่งแกะเอง</h1>
  <p class="subtitle">
    ที่นี่คือสมุดโจทย์ competitive programming ของผมเอง หนึ่งข้อหนึ่งหน้า เล่าตั้งแต่โจทย์ว่าอะไร
    ใบ้ให้ก่อน แล้วค่อยเปิดเฉลยเมื่อคุณอยากดู ไม่มีลิงก์จากหน้าไหนในเว็บ นอกจากประตูที่คุณเพิ่งเดินผ่านมา
    และจะทยอยเพิ่มข้อไปเรื่อย ๆ
  </p>

  {total === 0 ? (
    <p class="cp-empty">ยังไม่มีข้อในคลัง กำลังทยอยแกะอยู่ครับ</p>
  ) : (
    groups.map((g) => (
      <section class="cp-group">
        <h2>{g.set.title} <span class="cp-count">{g.problems.length} ข้อ</span></h2>
        {g.set.desc && <p class="cp-group-desc">{g.set.desc}</p>}
        <div class="list">
          {g.problems.map((p) => (
            <a class="item" href={p.href}>
              {p.label && <span class="item-label">ข้อ {p.label}</span>}
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
              <div class="meta">
                <span class="cp-diff">{'★'.repeat(p.difficulty)}{'☆'.repeat(5 - p.difficulty)}</span>
                {p.topics.map((t) => <span class="cp-topic">{t}</span>)}
                <span class="rt">อ่าน {p.readingMinutes} นาที</span>
                <span class="date">{formatThaiDateShort(p.dateISO)}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  )}
</DivineLoreLayout>

<style>
  .cp-empty{color:var(--dl-muted);font-size:0.92rem;}
  .cp-group{margin-top:2.25rem;}
  .cp-count{
    font-family:"JetBrains Mono", monospace;
    font-size:0.62rem;
    color:var(--dl-muted);
    letter-spacing:.4px;
  }
  .cp-group-desc{color:var(--dl-muted);font-size:0.86rem;margin:0.35rem 0 0.9rem;}
  .list{display:flex;flex-direction:column;gap:0.75rem;}
  .item{
    display:block;
    border:1px solid var(--dl-border);
    border-radius:14px;
    padding:1rem 1.15rem;
    text-decoration:none;
    color:var(--dl-ink);
    background:rgba(255,255,255,0.015);
    transition:border-color .18s ease, background .18s ease, transform .18s ease;
  }
  .item:hover{
    border-color:var(--dl-emerald);
    background:rgba(47,158,92,0.08);
    transform:translateY(-2px);
  }
  .item-label{
    display:inline-block;
    font-family:"JetBrains Mono", monospace;
    font-size:0.62rem;
    color:var(--dl-gold);
    text-transform:uppercase;
    letter-spacing:.5px;
    margin-bottom:0.35rem;
  }
  .item h3{font-size:1.02rem;color:#fff;margin-bottom:0.3rem;line-height:1.5;}
  .item p{font-size:0.9rem;color:var(--dl-muted);line-height:1.6;margin:0 0 0.6rem;}
  .meta{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:0.5rem;
    font-size:0.74rem;
    color:var(--dl-muted);
  }
  .meta .cp-diff{color:var(--dl-gold);letter-spacing:0.1em;}
  .meta .cp-topic{
    font-family:"JetBrains Mono", monospace;
    font-size:0.64rem;
    border:1px solid var(--dl-border);
    border-radius:999px;
    padding:0.1rem 0.5rem;
    color:var(--dl-emerald-bright);
  }
  .meta .date{margin-left:auto;}
  @media (prefers-reduced-motion: reduce){
    .item:hover{transform:none;}
  }
</style>
