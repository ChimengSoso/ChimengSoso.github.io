import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

const href = 'grasshopper-field/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Cell = { r: number; c: number };

/** กระโดดได้เมื่อแกนหนึ่งขยับหนึ่งช่องพอดี และอีกแกนขยับมากกว่าหนึ่งช่อง */
const canJump = (a: Cell, b: Cell): boolean => {
  const dr = Math.abs(a.r - b.r);
  const dc = Math.abs(a.c - b.c);
  return (dr === 1 && dc > 1) || (dc === 1 && dr > 1);
};

/** ท่าตรงไปตรงมา ไล่ดูทุกช่องที่กระโดดไปได้ ใช้เป็นตัวเทียบ ไม่ใช่ตัวที่บทความสอน */
function slowDp(g: number[][]): number[][] {
  const n = g.length;
  const memo: number[][] = Array.from({ length: n }, () => new Array<number>(n).fill(0));
  const order: Cell[] = [];
  for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) order.push({ r, c });
  order.sort((a, b) => g[b.r][b.c] - g[a.r][a.c]);
  for (const p of order) {
    let best = 0;
    for (let r = 0; r < n; r++)
      for (let c = 0; c < n; c++)
        if (g[r][c] > g[p.r][p.c] && canJump(p, { r, c })) best = Math.max(best, memo[r][c]);
    memo[p.r][p.c] = best + 1;
  }
  return memo;
}

/** ท่าที่บทความสอน เก็บสี่อันดับแรกของแต่ละแถวและแต่ละคอลัมน์ โดยดัชนีห้ามซ้ำ */
class Top4 {
  v: number[] = [];
  k: number[] = [];
  add(nv: number, nk: number): void {
    const at = this.k.indexOf(nk);
    if (at >= 0) {
      if (nv > this.v[at]) this.v[at] = nv;
    } else {
      this.v.push(nv);
      this.k.push(nk);
    }
    const pack = this.v.map((v, i) => ({ v, k: this.k[i] })).sort((a, b) => b.v - a.v).slice(0, 4);
    this.v = pack.map((p) => p.v);
    this.k = pack.map((p) => p.k);
  }
  /** ค่าที่ดีที่สุดที่ดัชนีไม่ชนสามค่าต้องห้าม สี่อันดับพอเสมอ เพราะห้ามได้มากสุดสามดัชนี */
  best(b1: number, b2: number, b3: number): number {
    for (let i = 0; i < this.v.length; i++) if (this.k[i] !== b1 && this.k[i] !== b2 && this.k[i] !== b3) return this.v[i];
    return 0;
  }
}

function fastDp(g: number[][]): number[][] {
  const n = g.length;
  const dp: number[][] = Array.from({ length: n }, () => new Array<number>(n).fill(0));
  const order: Cell[] = [];
  for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) order.push({ r, c });
  order.sort((a, b) => g[b.r][b.c] - g[a.r][a.c]);
  const row = Array.from({ length: n }, () => new Top4());
  const col = Array.from({ length: n }, () => new Top4());
  let i = 0;
  while (i < order.length) {
    let j = i;
    while (j < order.length && g[order[j].r][order[j].c] === g[order[i].r][order[i].c]) j++;
    for (let t = i; t < j; t++) {
      const { r, c } = order[t];
      let best = 0;
      if (r > 0) best = Math.max(best, row[r - 1].best(c - 1, c, c + 1));
      if (r + 1 < n) best = Math.max(best, row[r + 1].best(c - 1, c, c + 1));
      if (c > 0) best = Math.max(best, col[c - 1].best(r - 1, r, r + 1));
      if (c + 1 < n) best = Math.max(best, col[c + 1].best(r - 1, r, r + 1));
      dp[r][c] = best + 1;
    }
    /* ดอกที่กลีบเท่ากันมองไม่เห็นกัน จึงต้องคิดทั้งกลุ่มให้จบก่อนค่อยใส่เข้าตาราง */
    for (let t = i; t < j; t++) {
      const { r, c } = order[t];
      row[r].add(dp[r][c], c);
      col[c].add(dp[r][c], r);
    }
    i = j;
  }
  return dp;
}

/* ด่านตรวจตอนบิลด์ ท่าที่สอนต้องตรงกับท่าตรงไปตรงมาทุกทุ่งเล็ก ไม่งั้นหน้านี้ไม่ขึ้น */
const SWEEP_CASES = 400;
{
  let seed = 20260909;
  const rnd = (m: number): number => {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed % m;
  };
  for (let t = 0; t < SWEEP_CASES; t++) {
    const n = 2 + rnd(6);
    const cap = [2, 4, 30][rnd(3)];
    const g: number[][] = Array.from({ length: n }, () => Array.from({ length: n }, () => 1 + rnd(cap)));
    const a = slowDp(g);
    const b = fastDp(g);
    for (let r = 0; r < n; r++)
      for (let c = 0; c < n; c++)
        if (a[r][c] !== b[r][c]) throw new Error(`grasshopper-field: สองท่าตอบไม่ตรงกันที่ทุ่งขนาด ${n}`);
  }
}

/* ---------- ตัวอย่างในโจทย์ ---------- */
const SAMPLE_A = { g: [[1, 2, 3, 4], [2, 3, 4, 5], [3, 4, 5, 6], [4, 5, 6, 7]], r: 1, c: 1 };
const SAMPLE_B = {
  g: [[20, 16, 25, 17, 12], [11, 13, 13, 30, 17], [15, 29, 10, 26, 11], [27, 19, 14, 24, 22], [23, 21, 28, 18, 13]],
  r: 3,
  c: 3,
};
const ansOf = (s: { g: number[][]; r: number; c: number }): number => fastDp(s.g)[s.r - 1][s.c - 1];
const SAMPLES = [SAMPLE_A, SAMPLE_B].map((s) => ({ ...s, out: ansOf(s) }));

/* ---------- ทุ่งสาธิตสำหรับตัวเล่นทีละขั้น ---------- */
const DEMO = [
  [2, 8, 15, 12],
  [13, 4, 10, 1],
  [7, 3, 6, 14],
  [9, 11, 5, 16],
];
const DEMO_START = { r: 0, c: 0 };
const demoDp = fastDp(DEMO);
const DEMO_ANS = demoDp[DEMO_START.r][DEMO_START.c];

/* ลำดับการคิด คือเรียงจากดอกกลีบมากไปน้อย */
const demoOrder: Cell[] = [];
for (let r = 0; r < 4; r++) for (let c = 0; c < 4; c++) demoOrder.push({ r, c });
demoOrder.sort((a, b) => DEMO[b.r][b.c] - DEMO[a.r][a.c]);

type DemoRow = { ord: number; at: string; petals: number; nextAt: string; dp: number; note: string };
const demoRows: DemoRow[] = demoOrder.map((p, i) => {
  let bestCell: Cell | null = null;
  for (let r = 0; r < 4; r++)
    for (let c = 0; c < 4; c++)
      if (DEMO[r][c] > DEMO[p.r][p.c] && canJump(p, { r, c }))
        if (bestCell === null || demoDp[r][c] > demoDp[bestCell.r][bestCell.c]) bestCell = { r, c };
  const nm = (x: Cell): string => `(${x.r + 1}, ${x.c + 1})`;
  return {
    ord: i + 1,
    at: nm(p),
    petals: DEMO[p.r][p.c],
    nextAt: bestCell ? nm(bestCell) : 'ไม่มี',
    dp: demoDp[p.r][p.c],
    note: bestCell
      ? `ดอก <b>${DEMO[p.r][p.c]}</b> กลีบที่ช่อง <b>${nm(p)}</b> กระโดดต่อได้ดีที่สุดไปที่ช่อง <b>${nm(bestCell)}</b> ` +
        `ซึ่งคิดไว้แล้วว่าไปต่อได้อีก <b>${demoDp[bestCell.r][bestCell.c]}</b> ดอก จึงได้ <b>${demoDp[p.r][p.c]}</b> ดอก`
      : `ดอก <b>${DEMO[p.r][p.c]}</b> กลีบที่ช่อง <b>${nm(p)}</b> ไม่มีดอกไหนที่ทั้งกลีบมากกว่าและกระโดดถึง จึงจบที่ตัวมันเอง คือ <b>1</b> ดอก`,
  };
});
const demoSteps = demoRows.map((r) => ({ note: `ลำดับที่ ${r.ord} &middot; ${r.note}` }));

/* ---------- แผนภาพกฎการกระโดด ---------- */
const MOVE_N = 7;
const MOVE_MID = 3;
const MCELL = 30;
const moveCells: { r: number; c: number; ok: boolean; self: boolean }[] = [];
for (let r = 0; r < MOVE_N; r++)
  for (let c = 0; c < MOVE_N; c++)
    moveCells.push({
      r,
      c,
      ok: canJump({ r: MOVE_MID, c: MOVE_MID }, { r, c }),
      self: r === MOVE_MID && c === MOVE_MID,
    });
const MOVE_W = MOVE_N * MCELL + 10 + 12;
const MOVE_H = MOVE_N * MCELL + 10 + 34;
const MOVE_OK = moveCells.filter((m) => m.ok).length;

/* ---------- แผนภาพสี่อันดับแรก ---------- */
const T4 = [
  { col: 1, dp: 9 },
  { col: 4, dp: 8 },
  { col: 5, dp: 6 },
  { col: 8, dp: 5 },
];
const T4_BAN = [4, 5, 6];
const T4_PICK = T4.find((x) => !T4_BAN.includes(x.col));

/* ---------- มินิเกม สร้างเส้นทางกระโดดเอง ---------- */
type GamePuzzle = {
  id: string;
  label: string;
  tease: string;
  n: number;
  g: number[][];
  start: Cell;
  best: number;
};
function makePuzzle(id: string, label: string, tease: string, g: number[][], sr: number, sc: number): GamePuzzle {
  const fast = fastDp(g);
  const slow = slowDp(g);
  if (fast[sr][sc] !== slow[sr][sc]) throw new Error(`grasshopper-field: เฉลยเกม ${id} สองท่าไม่ตรงกัน`);
  return { id, label, tease, n: g.length, g, start: { r: sr, c: sc }, best: fast[sr][sc] };
}
const puzzles: GamePuzzle[] = [
  makePuzzle('a', 'ทุ่ง 4 x 4 ของโจทย์', 'ทุ่งนี้กลีบเพิ่มขึ้นเป็นระเบียบ จึงเหมาะกับการทำความคุ้นเคยกับกฎการกระโดดก่อน', SAMPLE_A.g, 0, 0),
  makePuzzle('b', 'ทุ่ง 4 x 4 กลีบสลับ', 'คราวนี้กลีบไม่เรียงให้แล้ว ดอกที่อยู่ใกล้ที่สุดมักไม่ใช่ดอกที่ควรไป', DEMO, 0, 0),
  makePuzzle('c', 'ทุ่ง 5 x 5 ของโจทย์', 'ทุ่งนี้เส้นทางที่ดีที่สุดยาวมาก ถ้าได้ไม่ถึงครึ่งก็ยังถือว่าเข้าใจกฎแล้ว', SAMPLE_B.g, 2, 2),
];
const puzzlesJson = JSON.stringify(puzzles);

/* ---------- บิลค่าใช้จ่าย ---------- */
const N_MAX = 1500;
const bill = [
  { name: 'ไล่ดูทุกช่องที่กระโดดถึง', limit: 'N ไม่เกินราวร้อย', work: `${(N_MAX * N_MAX * 4 * N_MAX / 1e9).toFixed(1)} หมื่นล้านครั้งที่ N = ${N_MAX}` },
  { name: 'ต้นไม้ช่วงประจำแถวและคอลัมน์', limit: 'N ถึงหลักพัน', work: 'ราว 100 ล้านครั้ง บวกโครงสร้าง 3,000 ต้น' },
  { name: 'เก็บสี่อันดับแรกของแถวและคอลัมน์', limit: `N ถึง ${N_MAX}`, work: '9 ล้านครั้ง' },
];
const fmt = (n: number): string => n.toLocaleString('en-US');

const solution = `#include <bits/stdc++.h>
using namespace std;
int N;
vector<int> val, dp;

// สี่อันดับแรกของแต่ละแถวและแต่ละคอลัมน์ โดยดัชนีห้ามซ้ำกัน
struct Top4 {
    int v[4], k[4]; int n = 0;
    void add(int nv, int nk){
        for(int i = 0; i < n; i++) if(k[i] == nk){ if(nv > v[i]){ v[i] = nv; sortit(); } return; }
        if(n < 4){ v[n] = nv; k[n] = nk; n++; sortit(); return; }
        if(nv > v[3]){ v[3] = nv; k[3] = nk; sortit(); }
    }
    void sortit(){
        for(int i = 1; i < n; i++){ int a = v[i], b = k[i], j = i - 1;
            while(j >= 0 && v[j] < a){ v[j+1] = v[j]; k[j+1] = k[j]; j--; }
            v[j+1] = a; k[j+1] = b; }
    }
    // ห้ามได้มากสุดสามดัชนี สี่อันดับจึงเหลือรอดอย่างน้อยหนึ่งเสมอ
    int best(int b1, int b2, int b3) const {
        for(int i = 0; i < n; i++) if(k[i] != b1 && k[i] != b2 && k[i] != b3) return v[i];
        return 0;
    }
};

int main(){
    int R, C;
    if(scanf("%d %d %d", &N, &R, &C) != 3) return 0;
    R--; C--;
    val.resize((size_t)N * N); dp.assign((size_t)N * N, 0);
    for(auto &x : val) scanf("%d", &x);
    vector<int> ord((size_t)N * N);
    for(size_t i = 0; i < ord.size(); i++) ord[i] = (int)i;
    sort(ord.begin(), ord.end(), [](int a, int b){ return val[a] > val[b]; });

    vector<Top4> row(N), col(N);
    size_t i = 0;
    while(i < ord.size()){
        size_t j = i;
        while(j < ord.size() && val[ord[j]] == val[ord[i]]) j++;   // กลุ่มที่กลีบเท่ากัน
        for(size_t t = i; t < j; t++){
            int id = ord[t], r = id / N, c = id % N, best = 0;
            if(r > 0)     best = max(best, row[r-1].best(c-1, c, c+1));
            if(r + 1 < N) best = max(best, row[r+1].best(c-1, c, c+1));
            if(c > 0)     best = max(best, col[c-1].best(r-1, r, r+1));
            if(c + 1 < N) best = max(best, col[c+1].best(r-1, r, r+1));
            dp[id] = best + 1;
        }
        // ใส่เข้าตารางหลังคิดทั้งกลุ่มจบ ไม่งั้นดอกกลีบเท่ากันจะมองเห็นกันเอง
        for(size_t t = i; t < j; t++){ int id = ord[t], r = id / N, c = id % N;
            row[r].add(dp[id], c); col[c].add(dp[id], r); }
        i = j;
    }
    printf("%d\\n", dp[(size_t)R * N + C]);
}`;

const bruteCode = `// ตัวตรวจ ไล่ดูทุกช่องบนกระดานว่ากระโดดถึงไหม ไม่มีโครงสร้างเร่งความเร็วใด ๆ
#include <bits/stdc++.h>
using namespace std;
int N, R, C; vector<vector<int>> a, memo;
int f(int r, int c){
    int &m = memo[r][c]; if(m) return m; int best = 1;
    for(int nr = 0; nr < N; nr++) for(int nc = 0; nc < N; nc++){
        if(a[nr][nc] <= a[r][c]) continue;
        int dr = abs(nr - r), dc = abs(nc - c);
        if(!((dr == 1 && dc > 1) || (dc == 1 && dr > 1))) continue;
        best = max(best, 1 + f(nr, nc));
    }
    return m = best;
}
int main(){
    scanf("%d %d %d", &N, &R, &C);
    a.assign(N, vector<int>(N)); memo.assign(N, vector<int>(N, 0));
    for(auto &row : a) for(auto &x : row) scanf("%d", &x);
    printf("%d\\n", f(R - 1, C - 1));
}`;

const wrongCode = `// รุ่นที่ผิด ใส่ค่าเข้าตารางทันทีทีละดอก ไม่รอให้กลุ่มที่กลีบเท่ากันคิดจบก่อน
for(size_t t = i; t < j; t++){
    int id = ord[t], r = id / N, c = id % N, best = 0;
    if(r > 0)     best = max(best, row[r-1].best(c-1, c, c+1));
    if(r + 1 < N) best = max(best, row[r+1].best(c-1, c, c+1));
    if(c > 0)     best = max(best, col[c-1].best(r-1, r, r+1));
    if(c + 1 < N) best = max(best, col[c+1].best(r-1, r, r+1));
    dp[id] = best + 1;
    row[r].add(dp[id], c); col[c].add(dp[id], r);   // บรรทัดที่พัง ใส่เร็วไปหนึ่งจังหวะ
}`;

const coreSnippet = `// ห้ามได้มากสุดสามดัชนี คือ c-1, c และ c+1
// เก็บสี่อันดับแรกที่ดัชนีไม่ซ้ำกัน จึงเหลือตัวที่ใช้ได้อย่างน้อยหนึ่งตัวเสมอ
int best(int b1, int b2, int b3) const {
    for(int i = 0; i < n; i++) if(k[i] != b1 && k[i] != b2 && k[i] != b3) return v[i];
    return 0;
}`;
