<style>

  /* ตารางของตัวเล่นเผยแถวทีละขั้น จึงต้องไม่เอาความกว้างของตัวเองไปถ่างการ์ด
     ต้องใช้ !important เพราะกฎ body .panel .dpsim table.rec ในเลย์เอาต์ตั้ง width:100% ไว้ */
  table.rec.ghrec{width:0 !important;min-width:100%;table-layout:fixed;}
  table.rec.ghrec th:nth-child(1), table.rec.ghrec td:nth-child(1){width:5rem;}
  table.rec.ghrec th:nth-child(2), table.rec.ghrec td:nth-child(2){width:6.5rem;}
  table.rec.ghrec th:nth-child(3), table.rec.ghrec td:nth-child(3){width:5rem;}
  table.rec.ghrec th:nth-child(4), table.rec.ghrec td:nth-child(4){width:9rem;}
  table.rec.ghrec th:nth-child(5), table.rec.ghrec td:nth-child(5){width:8rem;}
  /* ป้ายไทยในเซลล์ต้องไม่เอาความยาวไปถ่างตาราง */
  .gh-lbl{display:block;width:0;min-width:100%;}
  table.rec.ghrec tbody tr.is-later td{color:#4a5468;}
  table.rec.ghrec tbody tr.is-now td{background:#163a2a;}
  table.rec.ghrec tbody tr.is-now td.num{color:#eaf2ff;font-weight:700;}

  table.rec.gh-ladder td.ok{color:#a7f3c4;}
  table.rec.gh-ladder td.over{color:#f0a6a6;}

  /* ---------- กระดานของมินิเกม ---------- */
  .gh-board{display:grid;gap:0.3rem;justify-content:center;margin:0.2rem auto 0.6rem;}
  .gh-cell{
    position:relative;
    width:3rem;height:3rem;
    display:flex;align-items:center;justify-content:center;
    font-family:"Fira Code","Fira Mono",monospace;
    font-size:0.8rem;
    border-radius:6px;
    border:1px solid #2a3350;
    background:#121a2b;
    color:#cdd6ea;
    cursor:pointer;
    padding:0;
  }
  .gh-cell.start{border-color:var(--dl-gold);}
  .gh-cell.visited{background:#163a2a;border-color:var(--dl-emerald-bright);color:#eaf2ff;font-weight:700;}
  .gh-cell.here{outline:2px solid var(--dl-gold);outline-offset:1px;}
  .gh-cell.reach{border-color:#3d6ea5;}
  .gh-ord{
    position:absolute;top:2px;right:4px;
    font-size:0.6rem;color:var(--dl-gold);
  }
  @media (prefers-reduced-motion: reduce){
    .gh-cell{transition:none;}
  }
</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type GhPuzzle = { id: string; label: string; tease: string; n: number; g: number[][]; start: { r: number; c: number }; best: number };

  function initGrasshopperGame(): void {
    const maybeUi = cpGameUi('[data-ghgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as GhPuzzle[];
    if (puzzles.length === 0) return;

    let pi = 0;
    let path: { r: number; c: number }[] = [];

    const pz = (): GhPuzzle => puzzles[pi];
    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-gh-board]'));

    const canJump = (a: { r: number; c: number }, b: { r: number; c: number }): boolean => {
      const dr = Math.abs(a.r - b.r);
      const dc = Math.abs(a.c - b.c);
      return (dr === 1 && dc > 1) || (dc === 1 && dr > 1);
    };

    function render(): void {
      const p = pz();
      boards.forEach((b, k) => {
        b.hidden = k !== pi;
      });
      const here = path[path.length - 1];
      for (const btn of Array.from(boards[pi].querySelectorAll<HTMLElement>('[data-gh-cell]'))) {
        const parts = (btn.dataset.ghCell ?? '').split(':');
        const r = Number(parts[1]);
        const c = Number(parts[2]);
        const at = path.findIndex((x) => x.r === r && x.c === c);
        btn.classList.toggle('start', r === p.start.r && c === p.start.c);
        btn.classList.toggle('visited', at >= 0);
        btn.classList.toggle('here', at === path.length - 1);
        btn.classList.toggle('reach', at < 0 && canJump(here, { r, c }) && p.g[r][c] > p.g[here.r][here.c]);
        const ord = btn.querySelector<HTMLElement>('[data-gh-ord]');
        if (ord) ord.textContent = at >= 0 ? String(at + 1) : '';
      }
      ui.setScore(`ตอนนี้แวะไปแล้ว ${path.length} ดอก`);
    }

    function tryMove(r: number, c: number): void {
      const p = pz();
      const here = path[path.length - 1];
      if (!canJump(here, { r, c })) {
        ui.setStatus('ท่านั้นกระโดดไม่ได้ ต้องขยับแกนหนึ่งหนึ่งช่องพอดี และอีกแกนอย่างน้อยสองช่อง', 'bad');
        return;
      }
      if (p.g[r][c] <= p.g[here.r][here.c]) {
        ui.setStatus(`ดอกนั้นมี ${p.g[r][c]} กลีบ ซึ่งไม่มากกว่า ${p.g[here.r][here.c]} กลีบที่ยืนอยู่ตอนนี้`, 'bad');
        return;
      }
      path.push({ r, c });
      ui.setStatus(`กระโดดไปดอก ${p.g[r][c]} กลีบแล้ว ช่องที่ยังไปต่อได้ถูกทำขอบสีฟ้าไว้`, 'plain');
      render();
    }

    function check(): void {
      const p = pz();
      if (path.length === p.best) {
        ui.setStatus(`ยาวที่สุดแล้วครับ ทุ่งนี้ไปได้มากที่สุด ${p.best} ดอกพอดี`, 'good');
      } else {
        ui.setStatus(`ตอนนี้ได้ ${path.length} ดอก แต่ทุ่งนี้ไปได้ถึง ${p.best} ดอก ลองถอยกลับไปเปลี่ยนก้าวแรก ๆ ดู`, 'bad');
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      path = [{ r: puzzles[k].start.r, c: puzzles[k].start.c }];
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ui.setStatus('ตั๊กแตนยืนอยู่ที่ช่องสีทอง กดดอกถัดไปที่อยากกระโดดไป กลีบต้องมากขึ้นทุกก้าว');
      render();
    }

    ui.root.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const btn = e.target.closest('[data-gh-cell]');
      if (!(btn instanceof HTMLElement)) return;
      const parts = (btn.dataset.ghCell ?? '').split(':');
      tryMove(Number(parts[1]), Number(parts[2]));
    });

    ui.onClick('data-gh-undo', () => {
      if (path.length > 1) path.pop();
      ui.setStatus('ถอยกลับมาหนึ่งก้าวแล้ว', 'plain');
      render();
    });
    ui.onClick('data-gh-clear', () => selectPuzzle(pi));
    ui.onClick('data-gh-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initGrasshopperGame);
</script>

