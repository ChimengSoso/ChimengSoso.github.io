int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    vector<array<int, 3>> p(n);
    for (int i = 0; i < n; i++) scanf("%d %d %d", &p[i][0], &p[i][1], &p[i][2]);
    long long c = 0;
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            if (i != j && p[i][0] < p[j][0] && p[i][1] < p[j][1] && p[i][2] < p[j][2]) c++;
    printf("%lld\\n", c);
    return 0;
}`;
const CDQ_N = 200000;

