<script>
  // ตัวเล่นสองตัวชี้ของกระดานหนึ่งมิติ ขั้นถูกสร้างไว้ตอน build
  // ตัวคุมปุ่มและแถบเลื่อนอยู่ที่ src/lib/cpPlayer.ts หน้านี้ส่งมาแค่วิธีวาดกระดาน
  import { initCpPlayers } from '../../lib/cpPlayer';

  type SweepStep = { i: number; j: number; gained: number; total: number; note: string };

  function isStep(v: unknown): v is SweepStep {
    if (typeof v !== 'object' || v === null) return false;
    const o = v as Record<string, unknown>;
    return typeof o.i === 'number' && typeof o.j === 'number' && typeof o.note === 'string';
  }

  document.addEventListener('astro:page-load', () => {
    initCpPlayers<SweepStep>('[data-sweepsim]', {
      playMs: 1300,
      narrow: (raw) => {
        const ok = raw.filter(isStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      draw: (st, ctx) => {
        const marks = Array.from(ctx.parts.root.querySelectorAll<HTMLTableCellElement>('td.mark'));
        marks.forEach((td, k) => {
          td.className = 'num mark';
          td.textContent = '\u00b7';
          if (k === st.i) {
            td.classList.add('is-i');
            td.textContent = 'i';
          } else if (k >= st.j && k < st.i) {
            td.classList.add('is-win');
            td.textContent = '+';
          }
          if (k === st.j && k !== st.i) td.classList.add('is-j');
        });
        const totalCell = ctx.parts.root.querySelector<HTMLElement>('td.total');
        if (totalCell) totalCell.textContent = String(st.total);
        ctx.keepInView(marks[st.i] ?? null);
      },
    });
  });
</script>

<script>
  // ตัวสาธิตหมุนกระดาน: วาดตะแกรง จุด และขอบเขตการได้ยินของตัวที่ถูกเลือก
  type Pt = { x: number; y: number };
  type Game = { points: Pt[]; m: number; d: number };

  const NS = 'http://www.w3.org/2000/svg';
  const PAD = 20;

  function isGame(v: unknown): v is Game {
    if (typeof v !== 'object' || v === null) return false;
    const o = v as Record<string, unknown>;
    return Array.isArray(o.points) && typeof o.m === 'number' && typeof o.d === 'number';
  }

  function initRot(root: HTMLElement) {
    if (root.dataset.wired === '1') return;
    root.dataset.wired = '1';

    const parsed: unknown = JSON.parse(root.dataset.game ?? 'null');
    if (!isGame(parsed)) return;
    const game: Game = parsed;

    const svg = root.querySelector<SVGSVGElement>('.rg-svg');
    const gridG = root.querySelector<SVGGElement>('.rg-grid');
    const dotsG = root.querySelector<SVGGElement>('.rg-dots');
    const linksG = root.querySelector<SVGGElement>('.rg-links');
    const zone = root.querySelector<SVGPolygonElement>('.rg-zone');
    const rotBtn = root.querySelector<HTMLButtonElement>('.rg-rot');
    const range = root.querySelector<HTMLInputElement>('.rg-range');
    const dLabel = root.querySelector<HTMLElement>('.rg-dlabel');
    const say = root.querySelector<HTMLElement>('.rg-say');
    if (!svg || !gridG || !dotsG || !linksG || !zone || !rotBtn || !range || !dLabel || !say) return;

    const M = game.m;
    const step = (320 - PAD * 2) / (M - 1);
    const px = (x: number) => PAD + (x - 1) * step;
    const py = (y: number) => 320 - PAD - (y - 1) * step;

    for (let x = 1; x <= M; x++)
      for (let y = 1; y <= M; y++) {
        const c = document.createElementNS(NS, 'circle');
        c.setAttribute('cx', String(px(x)));
        c.setAttribute('cy', String(py(y)));
        c.setAttribute('r', '1.6');
        c.setAttribute('class', 'lat');
        gridG.appendChild(c);
      }

    const dots: SVGCircleElement[] = game.points.map((p, i) => {
      const c = document.createElementNS(NS, 'circle');
      c.setAttribute('cx', String(px(p.x)));
      c.setAttribute('cy', String(py(p.y)));
      c.setAttribute('r', '6');
      c.setAttribute('class', 'dot');
      c.addEventListener('click', () => { sel = i; render(); });
      dotsG.appendChild(c);
      return c;
    });

    // เริ่มที่ตัวที่อยู่กลางกระดานที่สุด ขอบเขตของมันจะได้ไม่โดนขอบ svg ตัดตั้งแต่ภาพแรก
    let sel = 0;
    let bestScore = Infinity;
    game.points.forEach((p, i) => {
      const c = (M + 1) / 2;
      const score = Math.abs(p.x - c) + Math.abs(p.y - c);
      if (score < bestScore) { bestScore = score; sel = i; }
    });
    let d = game.d;

    const dist = (a: Pt, b: Pt) => Math.abs(a.x - b.x) + Math.abs(a.y - b.y);

    const render = () => {
      const p = game.points[sel];
      // ขอบเขตการได้ยินคือสี่เหลี่ยมข้าวหลามตัดรอบตัวที่เลือก
      zone.setAttribute(
        'points',
        [
          `${px(p.x)},${py(p.y + d)}`,
          `${px(p.x + d)},${py(p.y)}`,
          `${px(p.x)},${py(p.y - d)}`,
          `${px(p.x - d)},${py(p.y)}`,
        ].join(' '),
      );

      linksG.textContent = '';
      let heard = 0;
      game.points.forEach((q, i) => {
        const near = i !== sel && dist(p, q) <= d;
        if (near) heard++;
        dots[i].setAttribute('class', 'dot' + (i === sel ? ' sel' : near ? ' hear' : ''));
        if (near) {
          const l = document.createElementNS(NS, 'line');
          l.setAttribute('x1', String(px(p.x)));
          l.setAttribute('y1', String(py(p.y)));
          l.setAttribute('x2', String(px(q.x)));
          l.setAttribute('y2', String(py(q.y)));
          l.setAttribute('class', 'link');
          linksG.appendChild(l);
        }
      });

      let total = 0;
      for (let i = 0; i < game.points.length; i++)
        for (let j = i + 1; j < game.points.length; j++)
          if (dist(game.points[i], game.points[j]) <= d) total++;

      dLabel.textContent = `D = ${d}`;
      const rotated = root.dataset.rot === '1';
      say.innerHTML =
        `ตัวที่เลือกอยู่ช่อง <b>(${p.x}, ${p.y})</b> ได้ยินอีก <b>${heard}</b> ตัว ทั้งกระดานมี <b>${total}</b> คู่ที่ได้ยินกัน` +
        (rotated
          ? ' ตอนนี้มองในมุมที่หมุนแล้ว ขอบเขตกลายเป็นสี่เหลี่ยมจัตุรัสที่ขนานกับแกน'
          : ' ขอบเขตตอนนี้เป็นสี่เหลี่ยมข้าวหลามตัด ลองกดปุ่มหมุนดู');
    };

    rotBtn.addEventListener('click', () => {
      const on = root.dataset.rot === '1';
      root.dataset.rot = on ? '0' : '1';
      rotBtn.setAttribute('aria-pressed', on ? 'false' : 'true');
      render();
    });
    range.addEventListener('input', () => {
      d = Number(range.value);
      render();
    });

    root.dataset.rot = '0';
    render();
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-rotgame]').forEach(initRot);
  });
</script>
