import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { mc, texCode } from '../../lib/math';

const href = 'hearing-pairs/';

/* ---------- โมเดล: ตัวเลขทุกตัวในหน้านี้คำนวณจากตรงนี้ ไม่มีตัวไหนพิมพ์ด้วยมือ ---------- */

type Pt2 = { x: number; y: number };

const manhattan2 = (a: Pt2, b: Pt2): number => Math.abs(a.x - b.x) + Math.abs(a.y - b.y);

/** นับคู่ที่ห่างกันไม่เกิน d แบบไล่ทุกคู่ (ใช้กับตัวอย่างเล็ก ๆ ในบทความเท่านั้น) */
function countPairs2(pts: Pt2[], d: number): number {
  let n = 0;
  for (let i = 0; i < pts.length; i++)
    for (let j = i + 1; j < pts.length; j++) if (manhattan2(pts[i], pts[j]) <= d) n++;
  return n;
}

/* ตัวอย่างที่ 1 ในโจทย์ ใช้เป็นกองเดินให้ดูของกระดานหนึ่งมิติ */
const ONE_D = [25, 50, 50, 10, 20, 23];
const ONE_D_D = 5;
const oneSorted = [...ONE_D].sort((a, b) => a - b);

/** เดินสองตัวชี้บนแถวที่เรียงแล้ว เก็บภาพทุกจังหวะไว้ให้ตัวเล่น */
type SweepStep = { i: number; j: number; gained: number; total: number; note: string };

function sweep1D(xs: number[], d: number): SweepStep[] {
  const steps: SweepStep[] = [];
  let total = 0;
  let j = 0;
  for (let i = 0; i < xs.length; i++) {
    while (xs[i] - xs[j] > d) j++;
    const gained = i - j;
    total += gained;
    const note =
      gained === 0
        ? `ตัวที่ ${i + 1} อยู่ที่ช่อง ${xs[i]} ตัวซ้ายสุดที่ยังได้ยินคือตัวที่ ${j + 1} ซึ่งคือตัวมันเอง จึงยังไม่มีคู่ใหม่`
        : gained === 1
          ? `ตัวที่ ${i + 1} อยู่ที่ช่อง ${xs[i]} มีตัวที่ ${j + 1} (ช่อง ${xs[j]}) ตัวเดียวที่ได้ยินมัน นับเพิ่ม i − j = ${i + 1} − ${j + 1} = <b>${gained}</b> คู่`
          : `ตัวที่ ${i + 1} อยู่ที่ช่อง ${xs[i]} ทุกตัวตั้งแต่ตัวที่ ${j + 1} (ช่อง ${xs[j]}) ถึงตัวที่ ${i} ได้ยินมันหมด นับเพิ่ม i − j = ${i + 1} − ${j + 1} = <b>${gained}</b> คู่`;
    steps.push({ i, j, gained, total, note });
  }
  return steps;
}

const oneSteps = sweep1D(oneSorted, ONE_D_D);
const oneAnswer = oneSteps[oneSteps.length - 1].total;

/* ตัวอย่างที่ 2 ในโจทย์ ใช้เป็นกระดานของตัวลองหมุน */
const TWO_D: Pt2[] = [
  { x: 5, y: 2 },
  { x: 7, y: 2 },
  { x: 8, y: 4 },
  { x: 6, y: 5 },
  { x: 4, y: 4 },
];
const TWO_M = 10;
const TWO_D_D = 4;
const twoAnswer = countPairs2(TWO_D, TWO_D_D);

/* ตัวอย่างที่ 3 ในโจทย์ คือแปดมุมของลูกบาศก์ */
const THREE_D = [
  [10, 10, 10], [10, 10, 20], [10, 20, 10], [10, 20, 20],
  [20, 10, 10], [20, 10, 20], [20, 20, 10], [20, 20, 20],
];
const THREE_D_D = 10;
const threeAnswer = (() => {
  let n = 0;
  for (let i = 0; i < THREE_D.length; i++)
    for (let j = i + 1; j < THREE_D.length; j++) {
      let d = 0;
      for (let k = 0; k < 3; k++) d += Math.abs(THREE_D[i][k] - THREE_D[j][k]);
      if (d <= THREE_D_D) n++;
    }
  return n;
})();

/** ตารางคู่ทั้งหมดของตัวอย่างที่ 2 เอาไว้ยืนยันว่าเลข 8 มาจากไหน */
const twoPairRows = (() => {
  const rows: { a: string; b: string; dx: number; dy: number; dist: number; ok: boolean }[] = [];
  for (let i = 0; i < TWO_D.length; i++)
    for (let j = i + 1; j < TWO_D.length; j++) {
      const p = TWO_D[i];
      const q = TWO_D[j];
      rows.push({
        a: `(${p.x}, ${p.y})`,
        b: `(${q.x}, ${q.y})`,
        dx: Math.abs(p.x - q.x),
        dy: Math.abs(p.y - q.y),
        dist: manhattan2(p, q),
        ok: manhattan2(p, q) <= TWO_D_D,
      });
    }
  return rows;
})();

/* คู่ตัวอย่างที่ใช้อธิบายระยะแมนฮัตตันและการหมุน: ตัวที่ 1 กับตัวที่ 3 ของตัวอย่างที่ 2 */
const EX_A = TWO_D[0];
const EX_B = TWO_D[2];
const exDx = Math.abs(EX_A.x - EX_B.x);
const exDy = Math.abs(EX_A.y - EX_B.y);
const exDist = exDx + exDy;
const exUA = EX_A.x + EX_A.y;
const exUB = EX_B.x + EX_B.y;
const exVA = EX_A.x - EX_A.y;
const exVB = EX_B.x - EX_B.y;
const exDu = Math.abs(exUA - exUB);
const exDv = Math.abs(exVA - exVB);
if ([exDx, exDy, exDu, exDv].some((t) => t === 0)) throw new Error('คู่ตัวอย่างต้องให้ทุกพจน์ไม่เป็นศูนย์');
if (Math.max(exDu, exDv) !== exDist) throw new Error('ระยะหลังหมุนไม่เท่าระยะแมนฮัตตัน');

/* กรณีคนละเครื่องหมายของเอกลักษณ์: a = Δx, b = −Δy ของคู่ตัวอย่าง */
const sgA = exDx;
const sgB = -exDy;
const sgSum = Math.abs(sgA + sgB);
const sgDiff = Math.abs(sgA - sgB);
if (sgDiff !== exDist || sgSum >= sgDiff || sgSum === 0) throw new Error('ตัวอย่างกรณีคนละเครื่องหมายไม่ตรง');

/* คำถามทดสอบตัวเองข้อ 2: อีกคู่จากตัวอย่างที่ 2 ซึ่งเครื่องหมายของ Δx กับ Δy ต่างกัน */
const QP_A = TWO_D[1];
const QP_B = TWO_D[3];
const qpDx = Math.abs(QP_A.x - QP_B.x);
const qpDy = Math.abs(QP_A.y - QP_B.y);
const qpDu = Math.abs(QP_A.x + QP_A.y - (QP_B.x + QP_B.y));
const qpDv = Math.abs(QP_A.x - QP_A.y - (QP_B.x - QP_B.y));
if ([qpDx, qpDy, qpDu, qpDv].some((t) => t === 0)) throw new Error('คู่ในคำถามข้อ 2 ต้องให้ทุกพจน์ไม่เป็นศูนย์');
if (Math.max(qpDu, qpDv) !== qpDx + qpDy) throw new Error('คู่ในคำถามข้อ 2 คำนวณไม่ตรง');
const qpHeard = Math.max(qpDu, qpDv) <= TWO_D_D;
if (qpDv <= qpDu) throw new Error('คำถามข้อ 2 อ้างว่าฝั่ง v มากกว่า');

/* การกวาดของกระดานสองมิติบนตัวอย่างที่ 2 (v ไม่บวก M เพื่อให้อ่านง่าย) */
type Sweep2Row = { pt: string; u: number; v: number; removed: string; inBit: string; lo: number; hi: number; got: number; total: number };
const sweep2Rows: Sweep2Row[] = (() => {
  const q = TWO_D.map((p) => ({ p, u: p.x + p.y, v: p.x - p.y })).sort((a, b) => a.u - b.u || a.v - b.v);
  const rows: Sweep2Row[] = [];
  const bit: number[] = [];
  let j = 0;
  let total = 0;
  for (let i = 0; i < q.length; i++) {
    const removed: number[] = [];
    while (q[i].u - q[j].u > TWO_D_D) {
      bit.splice(bit.indexOf(q[j].v), 1);
      removed.push(q[j].v);
      j++;
    }
    const lo = q[i].v - TWO_D_D;
    const hi = q[i].v + TWO_D_D;
    const got = bit.filter((v) => v >= lo && v <= hi).length;
    total += got;
    rows.push({
      pt: `(${q[i].p.x}, ${q[i].p.y})`,
      u: q[i].u,
      v: q[i].v,
      removed: removed.length ? removed.map((v) => `v = ${v}`).join(', ') : '·',
      inBit: bit.length ? `{${[...bit].sort((a, b) => a - b).join(', ')}}` : '{ }',
      lo,
      hi,
      got,
      total,
    });
    bit.push(q[i].v);
  }
  return rows;
})();
if (sweep2Rows[sweep2Rows.length - 1].total !== twoAnswer) throw new Error('การกวาดสองมิติไม่ได้คำตอบเท่าตัวอย่าง');
if (!sweep2Rows.some((r) => r.removed !== '·')) throw new Error('ตัวอย่างการกวาดควรมีการถอนออกอย่างน้อยหนึ่งครั้ง');

/* ผลรวมสะสมสองมิติบนตารางเล็ก 3 × 3 */
const PS_G = [
  [1, 0, 2],
  [0, 3, 1],
  [2, 1, 1],
];
const PS_P = PS_G.map((row, r) =>
  row.map((_, c) => {
    let s = 0;
    for (let rr = 0; rr <= r; rr++) for (let cc = 0; cc <= c; cc++) s += PS_G[rr][cc];
    return s;
  }),
);
/* ถามกรอบแถว 2..3 คอลัมน์ 2..3 (นับจาก 1) */
const PS_Q = { r1: 2, r2: 3, c1: 2, c2: 3 };
const psTerms = {
  big: PS_P[PS_Q.r2 - 1][PS_Q.c2 - 1],
  top: PS_P[PS_Q.r1 - 2][PS_Q.c2 - 1],
  left: PS_P[PS_Q.r2 - 1][PS_Q.c1 - 2],
  corner: PS_P[PS_Q.r1 - 2][PS_Q.c1 - 2],
};
const psAnswer = psTerms.big - psTerms.top - psTerms.left + psTerms.corner;
const psDirect = PS_G.slice(PS_Q.r1 - 1, PS_Q.r2).reduce((s, row) => s + row.slice(PS_Q.c1 - 1, PS_Q.c2).reduce((a, b) => a + b, 0), 0);
if (psAnswer !== psDirect) throw new Error('สูตรบวกลบสี่ครั้งไม่ตรงกับการนับตรง ๆ');
if (Object.values(psTerms).some((t) => t === 0)) throw new Error('ทุกพจน์ของตัวอย่างผลรวมสะสมต้องไม่เป็นศูนย์');

/* ขนาดของปัญหา คำนวณจากขอบเขตในโจทย์ */
const N_MAX = 100000;
const ALL_PAIRS = (N_MAX * (N_MAX - 1)) / 2;
const M_LIMIT = { 1: 75000000, 2: 75000, 3: 75 } as const;
const BOARD_ROWS = ([1, 2, 3] as const).map((b) => ({ b, m: M_LIMIT[b], cells: M_LIMIT[b] ** b }));
const CELLS_3D = M_LIMIT[3] ** 3;
const CELLS_RATIO_3D = Math.round(CELLS_3D / N_MAX);
const BOX_QUERIES_3D = N_MAX * M_LIMIT[3];
/* ตาราง pre ของ solve3 คือ (M+1) ชั้น ชั้นละ (U+2)(V+2) ช่อง ช่องละ int 4 ไบต์ */
const PRE_SIDE = 2 * M_LIMIT[3] + 3;
const PRE_BYTES = (M_LIMIT[3] + 1) * PRE_SIDE * PRE_SIDE * 4;
/* หน่วยเมกะไบต์ทั้งหน้านับ 1 MB = 2^20 ไบต์ ให้ตรงกับที่ /usr/bin/time รายงานเป็น KB หาร 1024 */
const MEM_3D = (PRE_BYTES / 2 ** 20).toFixed(1);

/* คำถามทดสอบตัวเองข้อ 3: ชั้นที่ต้องดูเมื่อ D เล็ก */
const QZ_D = 3;
const QZ_GAP = 2;
const QZ_LAYERS = 2 * QZ_D + 1;
const QZ_R = QZ_D - QZ_GAP;
if (QZ_R <= 0) throw new Error('งบของชั้นในคำถามต้องเป็นบวก');

/* วัดบน WSL Ubuntu 22.04, g++ 11.4 -O2 ด้วย /usr/bin/time (ทั้งโปรเซส รวมการอ่านอินพุต) วันที่ 20 ต.ค. 2026 */
const TIMING = [
  { name: 'กระดาน 1 มิติ', args: 'N = 100 000, M = 75 000 000, D = 100 000', s: '0.02', mb: '3.8' },
  { name: 'กระดาน 2 มิติ', args: 'N = 100 000, M = 75 000, D = 500', s: '0.03', mb: '5.3' },
  { name: 'กระดาน 3 มิติ', args: 'N = 100 000, M = 75, D = 100', s: '0.13', mb: '11.5' },
  { name: 'กระดาน 2 มิติ ทุกคู่ได้ยินกัน', args: 'N = 100 000, M = 75 000, D = 100 000 000', s: '0.02', mb: '5.3' },
  { name: 'กระดาน 3 มิติ ทุกคู่ได้ยินกัน', args: 'N = 100 000, M = 75, D = 225', s: '0.06', mb: '11.5' },
];
/* สองแถวล่างตอบ ALL_PAIRS พอดี (วัดได้ 4999950000 ทั้งคู่) */
const STRESS_CASES = 400;
const CDQ_STRESS = 300;
const CDQ_SECONDS = '0.25';

/* ---------- สูตร ---------- */
const TEX_IDENT = `|a| ${mc.op('+')} |b| ${mc.op('=')} ${mc.max} \\big( |a ${mc.op('+')} b|,\\; |a ${mc.op('-')} b| \\big)`;
const TEX_ROT = [
  `${mc.fn('u')} ${mc.op('=')} x ${mc.op('+')} y`,
  `${mc.fn('v')} ${mc.op('=')} x ${mc.op('-')} y`,
].join(' \\\\[4pt] ');
const TEX_DIST = `|\\Delta x| ${mc.op('+')} |\\Delta y| ${mc.op('=')} ${mc.max}\\big( |\\Delta ${mc.fn('u')}|,\\; |\\Delta ${mc.fn('v')}| \\big)`;
const texIdent = texCode(TEX_IDENT);
const texRot = texCode(`\\begin{aligned} ${TEX_ROT} \\end{aligned}`);
const texDist = texCode(TEX_DIST);

/* ---------- โค้ด ---------- */

const code1D = `// กระดานหนึ่งมิติ: เรียงแล้วเดินสองตัวชี้
sort(x.begin(), x.end());
ll ans = 0;
int j = 0;
for (int i = 0; i < N; i++) {
    while ((ll)x[i] - x[j] > D) j++;   // j เดินหน้าอย่างเดียว ไม่เคยถอยกลับ
    ans += i - j;                      // ทุกตัวตั้งแต่ j ถึง i-1 อยู่ในระยะได้ยิน
}`;

const code2D = `// กระดานสองมิติ: หมุนพิกัดก่อน แล้วกวาดตาม u พร้อมนับ v ด้วย BIT
vector<pair<int,int>> q(N);
for (int i = 0; i < N; i++)
    q[i] = {p[i].first + p[i].second, p[i].first - p[i].second + M};   // (u, v)
sort(q.begin(), q.end());

BIT bit;
bit.init(2 * M + 2);
ll ans = 0;
int j = 0;
for (int i = 0; i < N; i++) {
    while ((ll)q[i].first - q[j].first > D) { bit.add(q[j].second, -1); j++; }
    ans += bit.range((int)max<ll>(1, q[i].second - D),
                     (int)min<ll>(2 * M + 1, q[i].second + D));
    bit.add(q[i].second, 1);
}`;

const code3D = `// กระดานสามมิติ: M เล็กมาก ทำผลรวมสะสมสองมิติเก็บไว้ทุกชั้น z
for (auto& a : p) {
    int u = a[0] + a[1], v = a[0] - a[1] + M;
    pre[a[2]][at(u, v)]++;                       // นับตัวลงชั้นของมันก่อน
}
for (int z = 1; z <= M; z++) {                   // แล้วค่อยทำผลรวมสะสมทีละชั้น
    auto& g = pre[z];
    for (int u = 1; u <= U + 1; u++)
        for (int v = 1; v <= V + 1; v++)
            g[at(u, v)] += g[at(u - 1, v)] + g[at(u, v - 1)] - g[at(u - 1, v - 1)];
}

ll ans = 0;
for (auto& a : p) {
    int u = a[0] + a[1], v = a[0] - a[1] + M, z = a[2];
    for (int zz = max(1LL, z - D); zz <= min<ll>(M, z + D); zz++) {
        ll r = D - abs(zz - z);                  // ระยะที่เหลือให้ใช้บนระนาบ xy
        if (r > 2 * M) r = 2 * M;
        ans += box(zz, u - (int)r, v - (int)r, u + (int)r, v + (int)r);
    }
}
ans = (ans - N) / 2;                             // ตัวเองถูกนับด้วย และทุกคู่ถูกนับสองครั้ง`;

const solution = `#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

int B, N, M;
ll D;

/* ---------- กระดานหนึ่งมิติ: เรียงแล้วเดินสองตัวชี้ ---------- */
ll solve1(vector<int>& x) {
    sort(x.begin(), x.end());
    ll ans = 0;
    int j = 0;
    for (int i = 0; i < N; i++) {
        while ((ll)x[i] - x[j] > D) j++;
        ans += i - j;
    }
    return ans;
}

/* ---------- กระดานสองมิติ: หมุน 45 องศา แล้วกวาดด้วย BIT ---------- */
struct BIT {
    vector<int> t;
    int n;
    void init(int n_) { n = n_; t.assign(n + 1, 0); }
    void add(int i, int v) { for (; i <= n; i += i & -i) t[i] += v; }
    int sum(int i) { int s = 0; for (; i > 0; i -= i & -i) s += t[i]; return s; }
    int range(int a, int b) {
        a = max(a, 1); b = min(b, n);
        return b < a ? 0 : sum(b) - sum(a - 1);
    }
};

ll solve2(vector<pair<int,int>>& p) {
    vector<pair<int,int>> q(N);
    for (int i = 0; i < N; i++)
        q[i] = {p[i].first + p[i].second, p[i].first - p[i].second + M};
    sort(q.begin(), q.end());

    BIT bit;
    bit.init(2 * M + 2);
    ll ans = 0;
    int j = 0;
    for (int i = 0; i < N; i++) {
        while ((ll)q[i].first - q[j].first > D) { bit.add(q[j].second, -1); j++; }
        int lo = (int)max<ll>(1, q[i].second - D);
        int hi = (int)min<ll>(2 * M + 1, q[i].second + D);
        ans += bit.range(lo, hi);
        bit.add(q[i].second, 1);
    }
    return ans;
}

/* ---------- กระดานสามมิติ: ผลรวมสะสมสองมิติ เก็บไว้ทุกชั้น ---------- */
ll solve3(vector<array<int,3>>& p) {
    const int U = 2 * M + 1;                 // u = x + y อยู่ในช่วง 2..2M
    const int V = 2 * M + 1;                 // v = x - y + M อยู่ในช่วง 1..2M-1
    vector<vector<int>> pre((size_t)M + 1, vector<int>((size_t)(U + 2) * (V + 2), 0));
    auto at = [&](int u, int v) { return u * (V + 2) + v; };

    for (auto& a : p) {
        int u = a[0] + a[1], v = a[0] - a[1] + M;
        pre[a[2]][at(u, v)]++;
    }
    for (int z = 1; z <= M; z++) {
        auto& g = pre[z];
        for (int u = 1; u <= U + 1; u++)
            for (int v = 1; v <= V + 1; v++)
                g[at(u, v)] += g[at(u - 1, v)] + g[at(u, v - 1)] - g[at(u - 1, v - 1)];
    }
    auto box = [&](int z, int u1, int v1, int u2, int v2) {
        u1 = max(u1, 1); v1 = max(v1, 1);
        u2 = min(u2, U + 1); v2 = min(v2, V + 1);
        if (u1 > u2 || v1 > v2) return 0;
        auto& g = pre[z];
        return g[at(u2, v2)] - g[at(u1 - 1, v2)] - g[at(u2, v1 - 1)] + g[at(u1 - 1, v1 - 1)];
    };

    ll ans = 0;
    for (auto& a : p) {
        int u = a[0] + a[1], v = a[0] - a[1] + M, z = a[2];
        int zlo = (int)max<ll>(1, z - D), zhi = (int)min<ll>(M, z + D);
        for (int zz = zlo; zz <= zhi; zz++) {
            ll r = D - abs(zz - z);
            if (r < 0) continue;
            if (r > 2 * M) r = 2 * M;
            ans += box(zz, u - (int)r, v - (int)r, u + (int)r, v + (int)r);
        }
    }
    return (ans - N) / 2;
}

int main() {
    if (scanf("%d %d %lld %d", &B, &N, &D, &M) != 4) return 0;
    if (B == 1) {
        vector<int> x(N);
        for (int i = 0; i < N; i++) scanf("%d", &x[i]);
        printf("%lld\\n", solve1(x));
    } else if (B == 2) {
        vector<pair<int,int>> p(N);
        for (int i = 0; i < N; i++) scanf("%d %d", &p[i].first, &p[i].second);
        printf("%lld\\n", solve2(p));
    } else {
        vector<array<int,3>> p(N);
        for (int i = 0; i < N; i++) scanf("%d %d %d", &p[i][0], &p[i][1], &p[i][2]);
        printf("%lld\\n", solve3(p));
    }
    return 0;
}`;

const bruteCode = `// ตัวตรวจแบบซื่อ ๆ ไล่ทุกคู่ ใช้ได้แค่ N หลักพัน
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

int main() {
    int B, N, M;
    ll D;
    if (scanf("%d %d %lld %d", &B, &N, &D, &M) != 4) return 0;
    vector<array<int,3>> p(N, {0, 0, 0});
    for (int i = 0; i < N; i++)
        for (int k = 0; k < B; k++) scanf("%d", &p[i][k]);
    ll ans = 0;
    for (int i = 0; i < N; i++)
        for (int j = i + 1; j < N; j++) {
            ll d = 0;
            for (int k = 0; k < B; k++) d += abs(p[i][k] - p[j][k]);
            if (d <= D) ans++;
        }
    printf("%lld\\n", ans);
    return 0;
}`;

