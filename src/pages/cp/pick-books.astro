  }
  .bg-body{display:flex;flex-wrap:wrap;gap:1.2rem;align-items:flex-start;}
  .bg-stack{
    list-style:none;
    padding:0;
    margin:0;
    display:flex;
    flex-direction:column;
    gap:4px;
    min-width:13rem;
