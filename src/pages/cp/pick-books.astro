  .dps-say :global(.dps-cands li.no){color:#7b8397;border-style:dashed;background:transparent;}
  .dps-say :global(.dps-cands li.win){border-color:var(--dl-emerald);}
  .dps-say :global(.dps-cands li b){color:#e7ecf6;}
  .dps-say :global(.dps-a){margin:0.55rem 0 0;color:var(--dl-emerald-bright);font-weight:700;}
  .dps-say :global(.dps-a b){font-family:"Fira Code","Fira Mono",monospace;}
  .dps-say :global(.dps-a.bad){color:#8a93a8;font-weight:600;}

  @media (prefers-reduced-motion: reduce){
