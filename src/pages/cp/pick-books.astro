  .dps-range{flex:1 1 auto;min-width:6rem;accent-color:var(--dl-emerald-bright);cursor:pointer;}
  .dps-scroll{overflow-x:auto;}
  .dpsim table.rec{margin:0;}
  .dpsim table.rec caption{border-radius:0;}

  /* ช่องที่ยังไม่ถูกเติม ให้ว่างไว้ก่อน แต่ยังกินที่เท่าเดิม ตารางจะได้ไม่กระตุก */
  .dpsim td.num{transition:background .15s ease, color .15s ease;}
  /* ทุกกฎไฮไลต์ต้องมี .num ต่อท้าย ไม่ใช่แค่ .is-xxx เพราะ table.rec td.num
     ตั้ง color ไว้ด้วยความเจาะจง (0,4,2) ซึ่งชนะ .dpsim td.is-target (0,4,1)
     ผลคือพื้นสีมาแต่ตัวอักษรยังเป็นเทาอ่อน อ่านแทบไม่ออก การเติม .num ดันเป็น (0,5,1) จึงชนะ */
  table.rec td.num.is-neg{color:#7b8397;}
  .dpsim td.num.is-src-plus{background:rgba(56,140,255,0.22);color:#9cc6ff;font-weight:700;}
