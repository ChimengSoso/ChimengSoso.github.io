    .bg-stack :global(.bg-book.is-target){transform:none;}
    .bg-stack :global(.bg-book.is-going){opacity:1;transform:none;}
  }
</style>

<script>
  // กองหนังสือจำลอง: คลิกเล่มบนสุดของสามเล่มที่อยากหยิบ
  // ค่า best ของแต่ละกองคือคำตอบจริง ใส่ไว้ตรง ๆ เพื่อไม่ให้โค้ดเฉลยหลุดมาอยู่ในหน้าเว็บ
  interface Pile {
    books: number[];
    best: number;
  }

  const PILES: Pile[] = [
    { books: [9, 2, 9, 2, 9, 1], best: 26 },
    { books: [1, 2, 3, 4, 5, 6, 7], best: 5 },
    { books: [5, 5, 5, 5, 5, 5, 5, 5, 100], best: 10 },
    { books: [7, 3, 1, 2, 9, 9, 7], best: 20 },
  ];

  function initOne(fig: HTMLElement): void {
    if (fig.dataset.wired === '1') return;
    const stackEl = fig.querySelector<HTMLOListElement>('[data-stack]');
    const scoreEl = fig.querySelector<HTMLElement>('[data-score]');
    const bestEl = fig.querySelector<HTMLElement>('[data-best]');
    const movesEl = fig.querySelector<HTMLElement>('[data-moves]');
    const logEl = fig.querySelector<HTMLElement>('[data-log]');
    const resetBtn = fig.querySelector<HTMLButtonElement>('[data-reset]');
    if (!stackEl || !scoreEl || !bestEl || !movesEl || !logEl || !resetBtn) return;
    fig.dataset.wired = '1';

    const calmer = window.matchMedia('(prefers-reduced-motion: reduce)');
    let pileIndex = 0;
    let books: number[] = [];
    let score = 0;
    let moves = 0;
    let busy = false;

    function draw(): void {
      if (!stackEl) return;
      stackEl.replaceChildren();
      books.forEach((value, i) => {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bg-book';
        btn.dataset.i = String(i);
        btn.disabled = i + 2 >= books.length;
        const idx = document.createElement('span');
        idx.className = 'bg-idx';
        idx.textContent = `เล่ม ${i + 1}`;
        const val = document.createElement('span');
        val.className = 'bg-val';
        val.textContent = String(value);
        btn.append(idx, val);
        btn.setAttribute(
          'aria-label',
          btn.disabled
            ? `เล่มที่ ${i + 1} เลข ${value} หยิบไม่ได้ เพราะใต้มันเหลือไม่ถึงสองเล่ม`
            : `หยิบเล่มที่ ${i + 1} ถึง ${i + 3} ได้ ${books[i]} บวก ${books[i + 1]} ลบ ${books[i + 2]}`,
        );
        li.append(btn);
        stackEl.append(li);
      });
    }

    function refreshHud(): void {
      if (!scoreEl || !movesEl || !bestEl) return;
      scoreEl.textContent = String(score);
      movesEl.textContent = `${moves} ครั้ง`;
      bestEl.textContent = String(PILES[pileIndex].best);
    }

    function say(text: string, win: boolean): void {
      if (!logEl) return;
      logEl.textContent = text;
      logEl.classList.toggle('is-win', win);
    }

    function load(index: number): void {
      pileIndex = index;
      books = PILES[index].books.slice();
      score = 0;
      moves = 0;
      busy = false;
      draw();
      refreshHud();
      say('คลิกเล่มบนสุดของสามเล่มที่อยากหยิบ', false);
    }

    function highlight(i: number, on: boolean): void {
      if (!stackEl) return;
      const rows = stackEl.querySelectorAll<HTMLButtonElement>('.bg-book');
      for (let k = i; k < i + 3 && k < rows.length; k++) {
        rows[k].classList.toggle('is-target', on);
        rows[k].classList.toggle('is-minus', on && k === i + 2);
      }
    }

    function pick(i: number): void {
      if (busy || i + 2 >= books.length) return;
      const gain = books[i] + books[i + 1] - books[i + 2];
      const detail = `${books[i]} + ${books[i + 1]} − ${books[i + 2]} = ${gain >= 0 ? '+' : ''}${gain}`;
      const finish = (): void => {
        books.splice(i, 3);
        score += gain;
        moves += 1;
        busy = false;
        draw();
        refreshHud();
        const best = PILES[pileIndex].best;
        if (score === best) {
          say(`${detail} · แต้มสะสม ${score} ตรงกับคำตอบที่ดีที่สุดของกองนี้แล้ว`, true);
        } else if (books.length < 3) {
          say(`${detail} · แต้มสะสม ${score} หยิบต่อไม่ได้แล้ว ดีที่สุดคือ ${best}`, false);
        } else {
          say(`${detail} · แต้มสะสม ${score}`, false);
        }
      };
      if (calmer.matches) {
        finish();
        return;
      }
      busy = true;
      if (stackEl) {
        const rows = stackEl.querySelectorAll<HTMLButtonElement>('.bg-book');
        for (let k = i; k < i + 3 && k < rows.length; k++) rows[k].classList.add('is-going');
      }
      window.setTimeout(finish, 180);
    }

    stackEl.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest<HTMLButtonElement>('.bg-book');
      if (!btn || btn.disabled || !btn.dataset.i) return;
      pick(Number(btn.dataset.i));
    });

    const hoverOn = (e: Event): void => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest<HTMLButtonElement>('.bg-book');
      if (!btn || btn.disabled || !btn.dataset.i) return;
      highlight(Number(btn.dataset.i), true);
    };
    const hoverOff = (e: Event): void => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest<HTMLButtonElement>('.bg-book');
      if (!btn || !btn.dataset.i) return;
      highlight(Number(btn.dataset.i), false);
    };
    stackEl.addEventListener('mouseover', hoverOn);
    stackEl.addEventListener('mouseout', hoverOff);
    stackEl.addEventListener('focusin', hoverOn);
    stackEl.addEventListener('focusout', hoverOff);

    resetBtn.addEventListener('click', () => load(pileIndex));

    fig.querySelectorAll<HTMLButtonElement>('.bg-pile').forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = Number(btn.dataset.pile ?? '0');
        if (Number.isNaN(index) || !PILES[index]) return;
        fig.querySelectorAll<HTMLButtonElement>('.bg-pile').forEach((b) => b.classList.remove('is-on'));
        btn.classList.add('is-on');
        load(index);
      });
    });

    load(0);
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-bookgame]').forEach(initOne);
  });
</script>

<script>
  // ตัวเล่นเดินตาราง DP ทีละขั้น สคริปต์ขั้นตอนถูกสร้างไว้ตอน build แล้วส่งมาทาง data-steps
  type Src = { i: number; p: number; kind: 'plus' | 'minus' | 'skip'; ok: boolean };
  type SimStep = { i: number; p: number; val: number | null; html: string; srcs: Src[]; path: boolean; base: boolean };

  const PLAY_MS = 1400;

  function isSimStep(v: unknown): v is SimStep {
    if (typeof v !== 'object' || v === null) return false;
    const o = v as Record<string, unknown>;
    return (
      typeof o.i === 'number' && typeof o.p === 'number' && typeof o.html === 'string' && Array.isArray(o.srcs)
    );
  }

  function isSrc(v: unknown): v is Src {
    if (typeof v !== 'object' || v === null) return false;
    const o = v as Record<string, unknown>;
    return typeof o.i === 'number' && typeof o.p === 'number' && typeof o.kind === 'string';
  }

  function initDpSim(root: HTMLElement) {
    if (root.dataset.wired === '1') return;
    root.dataset.wired = '1';

    const parsed: unknown = JSON.parse(root.dataset.steps ?? '[]');
    const steps: SimStep[] = Array.isArray(parsed) ? parsed.filter(isSimStep) : [];
    if (steps.length === 0) return;

    const cells = Array.from(root.querySelectorAll<HTMLTableCellElement>('td.num'));
    const say = root.querySelector<HTMLElement>('.dps-say');
    const range = root.querySelector<HTMLInputElement>('.dps-range');
    const count = root.querySelector<HTMLElement>('.dps-count');
    const playBtn = root.querySelector<HTMLButtonElement>('.dps-play');
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('.dps-b'));
    if (!say || !range || !count || !playBtn) return;

    const key = (i: number, p: number) => `${i}:${p}`;
    const pathKeys = new Set((root.dataset.path ?? '').split(',').filter(Boolean));

    // ช่องไหนถูกเติมที่ขั้นไหน ใช้ตัดสินว่าขั้นปัจจุบันควรเห็นเลขในช่องนั้นหรือยัง
    // ช่องที่ยังไม่ถึงคิวจะแสดงเป็นจุด (NEG) ไม่ใช่ค่าจริง คนดูจะได้เห็นมันเปลี่ยนจาก NEG เป็นตัวเลข
    const baseAt = steps.findIndex((st) => st.base);
    const filledBy = new Map<string, number>();
    if (baseAt >= 0) {
      cells.forEach((c) => {
        if (c.dataset.i === '0' && c.dataset.p === '0') filledBy.set(key(0, 0), baseAt);
      });
    }
    steps.forEach((st, idx) => {
      if (st.i >= 0 && !st.path && !st.base) filledBy.set(key(st.i, st.p), idx);
    });

    // เลื่อนกรอบตารางตามช่องที่กำลังทำงาน บนจอแคบตารางกว้างเกินกรอบหลายเท่า
    // ถ้าไม่เลื่อนให้ คนอ่านกดเดินทั้งเกมโดยไม่เห็นอะไรขยับเลย
    // ขยับ scrollLeft เองแทน scrollIntoView เพราะตัวหลังจะดึงหน้าเว็บกระโดดตามแนวตั้งด้วย
    const scroller = root.querySelector<HTMLElement>('.dps-scroll');
    const keepInView = (cell: HTMLElement | null) => {
      if (!cell || !scroller) return;
      if (scroller.scrollWidth <= scroller.clientWidth) return;
      const box = scroller.getBoundingClientRect();
      const c = cell.getBoundingClientRect();
      const pad = 16;
      let delta = 0;
      if (c.left < box.left + pad) delta = c.left - box.left - pad;
      else if (c.right > box.right - pad) delta = c.right - box.right + pad;
      // เลื่อนแบบทันที ไม่ใช้ behavior:'smooth' เพราะการกดเดินทีละขั้นเป็นการกระโดดอยู่แล้ว
      // และการเลื่อนลื่นจะซ้อนคิวกันเองเวลากดรัวหรือกดเล่นอัตโนมัติ
      if (delta !== 0) scroller.scrollLeft += delta;
    };

    range.max = String(steps.length - 1);
    let at = 0;
    let timer: number | null = null;

    const render = () => {
      const st = steps[at];
      let focus: HTMLElement | null = null;
      for (const c of cells) {
        const ci = Number(c.dataset.i);
        const cp = Number(c.dataset.p);
        const when = filledBy.get(key(ci, cp));
        const shown = when !== undefined && when <= at;
        c.className = 'num';
        c.textContent = shown ? (c.dataset.v ?? '·') : '·';
        if (!shown) c.classList.add('is-neg');
        if (st.path) {
          if (pathKeys.has(key(ci, cp))) c.classList.add('is-path');
          continue;
        }
        if (st.i === ci && st.p === cp) {
          c.classList.add('is-target');
          focus = c;
        }
        for (const sr of st.srcs) {
          if (isSrc(sr) && sr.ok && sr.i === ci && sr.p === cp) c.classList.add(`is-src-${sr.kind}`);
        }
      }
      say.innerHTML = st.html;
      range.value = String(at);
      count.textContent = `ขั้น ${at} / ${steps.length - 1}`;
      for (const b of btns) {
        const act = b.dataset.act;
        if (act === 'prev' || act === 'first') b.disabled = at === 0;
        if (act === 'next' || act === 'last') b.disabled = at === steps.length - 1;
      }
      // ขั้นสุดท้ายไฮไลต์ทั้งเส้นทาง ไม่มีช่องเป้าหมายเดี่ยว ๆ ให้ยึดช่องคำตอบแทน
      // ซึ่งคือช่องบนเส้นทางที่อยู่ท้ายสุดตามลำดับ DOM (แถวล่างสุด คอลัมน์ p = 0)
      const pathCells = st.path ? Array.from(root.querySelectorAll<HTMLElement>('td.is-path')) : [];
      keepInView(focus ?? pathCells[pathCells.length - 1] ?? null);
    };

    const stop = () => {
      if (timer !== null) window.clearInterval(timer);
      timer = null;
      playBtn.textContent = 'เล่น';
    };

    const go = (to: number) => {
      at = Math.max(0, Math.min(steps.length - 1, to));
      if (at === steps.length - 1) stop();
      render();
    };

    for (const b of btns) {
      b.addEventListener('click', () => {
        const act = b.dataset.act;
        if (act === 'play') {
          if (timer !== null) {
            stop();
            return;
          }
          if (at === steps.length - 1) at = 0;
          playBtn.textContent = 'หยุด';
          timer = window.setInterval(() => go(at + 1), PLAY_MS);
          go(at + 1);
          return;
        }
        stop();
        if (act === 'first') go(0);
        else if (act === 'prev') go(at - 1);
        else if (act === 'next') go(at + 1);
        else if (act === 'last') go(steps.length - 1);
      });
    }

    range.addEventListener('input', () => {
      stop();
      go(Number(range.value));
    });

    root.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') {
        stop();
        go(at + 1);
        e.preventDefault();
      } else if (e.key === 'ArrowLeft') {
        stop();
        go(at - 1);
        e.preventDefault();
      }
    });

    // ออกจากหน้าไปแล้วต้องไม่มี interval ค้าง
    document.addEventListener('astro:before-swap', stop, { once: true });
    render();
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-dpsim]').forEach(initDpSim);
  });
</script>

<script>
  // ตัวเล่นชุดสองแถว cur / nxt แต่ละขั้นเก็บภาพนิ่งของทั้งสองแถวไว้แล้วตอน build
  type Hit = { p: number; ok: boolean };
  type RollStep = {
    kind: 'start' | 'clear' | 'push' | 'swap' | 'done';
    cur: string[];
    nxt: string[];
    curLabel: string;
    nxtLabel: string;
    src: number;
    hits: Hit[];
    html: string;
  };

  const ROLL_MS = 1500;

  function isRollStep(v: unknown): v is RollStep {
    if (typeof v !== 'object' || v === null) return false;
    const o = v as Record<string, unknown>;
    return Array.isArray(o.cur) && Array.isArray(o.nxt) && typeof o.html === 'string' && typeof o.kind === 'string';
  }

  function initRollSim(root: HTMLElement) {
    if (root.dataset.wired === '1') return;
    root.dataset.wired = '1';

    const parsed: unknown = JSON.parse(root.dataset.steps ?? '[]');
    const steps: RollStep[] = Array.isArray(parsed) ? parsed.filter(isRollStep) : [];
    if (steps.length === 0) return;

    const curRow = root.querySelector<HTMLTableRowElement>('tr[data-row="cur"]');
    const nxtRow = root.querySelector<HTMLTableRowElement>('tr[data-row="nxt"]');
    const say = root.querySelector<HTMLElement>('.dps-say');
    const range = root.querySelector<HTMLInputElement>('.dps-range');
    const count = root.querySelector<HTMLElement>('.dps-count');
    const playBtn = root.querySelector<HTMLButtonElement>('.dps-play');
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('.dps-b'));
    if (!curRow || !nxtRow || !say || !range || !count || !playBtn) return;

    const curCells = Array.from(curRow.querySelectorAll<HTMLTableCellElement>('td.num'));
    const nxtCells = Array.from(nxtRow.querySelectorAll<HTMLTableCellElement>('td.num'));
    const curLab = curRow.querySelector<HTMLTableCellElement>('td.rowlab');
    const nxtLab = nxtRow.querySelector<HTMLTableCellElement>('td.rowlab');

    // เลื่อนกรอบตารางตามช่องที่กำลังทำงาน บนจอแคบตารางกว้างเกินกรอบหลายเท่า
    // ถ้าไม่เลื่อนให้ คนอ่านกดเดินทั้งเกมโดยไม่เห็นอะไรขยับเลย
    // ขยับ scrollLeft เองแทน scrollIntoView เพราะตัวหลังจะดึงหน้าเว็บกระโดดตามแนวตั้งด้วย
    const scroller = root.querySelector<HTMLElement>('.dps-scroll');
    const keepInView = (cell: HTMLElement | null) => {
      if (!cell || !scroller) return;
      if (scroller.scrollWidth <= scroller.clientWidth) return;
      const box = scroller.getBoundingClientRect();
      const c = cell.getBoundingClientRect();
      const pad = 16;
      let delta = 0;
      if (c.left < box.left + pad) delta = c.left - box.left - pad;
      else if (c.right > box.right - pad) delta = c.right - box.right + pad;
      // เลื่อนแบบทันที ไม่ใช้ behavior:'smooth' เพราะการกดเดินทีละขั้นเป็นการกระโดดอยู่แล้ว
      // และการเลื่อนลื่นจะซ้อนคิวกันเองเวลากดรัวหรือกดเล่นอัตโนมัติ
      if (delta !== 0) scroller.scrollLeft += delta;
    };

    range.max = String(steps.length - 1);
    let at = 0;
    let timer: number | null = null;

    const render = () => {
      const st = steps[at];
      let focus: HTMLElement | null = null;
      const written = new Map<number, boolean>();
      for (const h of st.hits) written.set(h.p, h.ok);

      curCells.forEach((c, p) => {
        c.className = 'num';
        c.textContent = st.cur[p] ?? '\u00b7';
        if (st.kind === 'push' && st.src === p) {
          c.classList.add('is-cursor');
          focus = c;
        }
        if (st.kind === 'done' && p === 0) {
          c.classList.add('is-answer');
          focus = c;
        }
      });
      nxtCells.forEach((c, p) => {
        c.className = 'num';
        c.textContent = st.nxt[p] ?? '\u00b7';
        if (st.kind !== 'push') return;
        const ok = written.get(p);
        if (ok === true) c.classList.add('is-written');
        else if (ok === false) c.classList.add('is-rejected');
      });

      if (curLab) curLab.textContent = st.curLabel;
      if (nxtLab) nxtLab.textContent = st.nxtLabel;
      curRow.classList.toggle('is-idle', false);
      nxtRow.classList.toggle('is-idle', st.kind === 'start' || st.kind === 'swap' || st.kind === 'done');

      say.innerHTML = st.html;
      range.value = String(at);
      count.textContent = `ขั้น ${at} / ${steps.length - 1}`;
      for (const b of btns) {
        const act = b.dataset.act;
        if (act === 'prev' || act === 'first') b.disabled = at === 0;
        if (act === 'next' || act === 'last') b.disabled = at === steps.length - 1;
      }
      keepInView(focus);
    };

    const stop = () => {
      if (timer !== null) window.clearInterval(timer);
      timer = null;
      playBtn.textContent = 'เล่น';
    };

    const go = (to: number) => {
      at = Math.max(0, Math.min(steps.length - 1, to));
      if (at === steps.length - 1) stop();
      render();
    };

    for (const b of btns) {
      b.addEventListener('click', () => {
        const act = b.dataset.act;
        if (act === 'play') {
          if (timer !== null) {
            stop();
            return;
          }
          if (at === steps.length - 1) at = 0;
          playBtn.textContent = 'หยุด';
          timer = window.setInterval(() => go(at + 1), ROLL_MS);
          go(at + 1);
          return;
        }
        stop();
        if (act === 'first') go(0);
        else if (act === 'prev') go(at - 1);
        else if (act === 'next') go(at + 1);
        else if (act === 'last') go(steps.length - 1);
      });
    }

    range.addEventListener('input', () => {
      stop();
      go(Number(range.value));
    });

    root.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') {
        stop();
        go(at + 1);
        e.preventDefault();
      } else if (e.key === 'ArrowLeft') {
        stop();
        go(at - 1);
        e.preventDefault();
      }
    });

    document.addEventListener('astro:before-swap', stop, { once: true });
    render();
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-rollsim]').forEach(initRollSim);
  });
</script>
