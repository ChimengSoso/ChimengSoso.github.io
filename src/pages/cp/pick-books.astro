---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { texBlock } from '../../lib/math';

const href = 'pick-books/';

const solution = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    vector<int> a(n);
    for (int i = 0; i < n; i++) scanf("%d", &a[i]);

    // cur[p] = แต้มมากสุด เมื่อดูหนังสือไปแล้ว i เล่ม และยังมี "บวกค้าง" อยู่ p เล่ม
    // NEG = สถานะที่ไปไม่ถึง (ใช้ 0 ไม่ได้ เพราะ 0 เป็นแต้มที่ถูกต้องได้)
    const long long NEG = LLONG_MIN / 4;
    vector<long long> cur(n + 1, NEG), nxt(n + 1, NEG);
    cur[0] = 0;

    for (int i = 0; i < n; i++) {
        fill(nxt.begin(), nxt.end(), NEG);
        // ดูหนังสือมาแล้ว i เล่ม จะมีบวกค้างเกิน i เล่มไม่ได้ ช่องที่เลยไปเป็น NEG อยู่แล้ว
        for (int p = 0; p <= i; p++) {
            long long v = cur[p];
            if (v == NEG) continue;
            // ไม่หยิบเล่มนี้เลย ทำได้เฉพาะตอนไม่มีบวกค้าง
            if (p == 0) nxt[0] = max(nxt[0], v);
            // ให้เล่มนี้เป็นบวก รอคู่ต่อไป
            nxt[p + 1] = max(nxt[p + 1], v + a[i]);
            // ให้เล่มนี้เป็นลบ ปิดจ๊อบกับบวกที่ค้างอยู่ 2 เล่ม
            if (p >= 2) nxt[p - 2] = max(nxt[p - 2], v - a[i]);
        }
        swap(cur, nxt);
    }

    printf("%lld\\n", cur[0]);            // จบแบบไม่มีบวกค้าง = ทุกครั้งที่หยิบสมบูรณ์
    return 0;
}`;

const bruteCode = `// ตัวตรวจสอบแบบซื่อ ๆ ลองหยิบทุกวิธีที่เป็นไปได้ ใช้ได้แค่กองเล็ก ๆ
// เอาไว้สุ่มเทียบกับโค้ดจริงก่อนส่ง ไม่ใช่โค้ดที่ส่งเข้าระบบตัดสิน
#include <bits/stdc++.h>
using namespace std;

long long best(vector<int> a) {
    long long r = 0;                     // 0 = เลือกที่จะหยุดหยิบตรงนี้
    for (size_t i = 0; i + 2 < a.size(); i++) {
        vector<int> b = a;
        long long gain = (long long)b[i] + b[i + 1] - b[i + 2];
        b.erase(b.begin() + i, b.begin() + i + 3);
        r = max(r, gain + best(b));
    }
    return r;
}`;

const dpLine = `// cur[p] คือ dp[i][p] ของแถวที่กำลังยืนอยู่  ส่วน nxt[p] คือ dp[i+1][p] แถวถัดไป
// v = cur[p] คือแต้มที่สะสมมาแล้ว ก่อนจะตัดสินใจเรื่องหนังสือเล่ม a[i]
if (p == 0)  nxt[0]    = max(nxt[0],     v);          // ไม่หยิบเล่มนี้เลย
nxt[p + 1]             = max(nxt[p + 1], v + a[i]);   // ให้เป็นบวก
if (p >= 2)  nxt[p - 2] = max(nxt[p - 2], v - a[i]);  // ให้เป็นลบ`;

/* ตัวอย่างเดินตาราง คำนวณสดจากโมเดลเดียวกับเฉลย ไม่มีเลขไหนพิมพ์ด้วยมือ */
const demo = [7, 3, 1, 2, 9, 9, 7];
const DEMO_COLS = demo.length + 1; // p = 0..n ครบทุกคอลัมน์ที่ไปถึงได้ ช่องต้นทางจะได้ไม่หลุดตาราง
const NEG = Number.NEGATIVE_INFINITY;

function dpRows(a: number[]): number[][] {
  const n = a.length;
  const rows: number[][] = [];
  let cur: number[] = new Array<number>(n + 3).fill(NEG);
  cur[0] = 0;
  rows.push([...cur]);
  for (let i = 0; i < n; i++) {
    const nxt: number[] = new Array<number>(n + 3).fill(NEG);
    for (let p = 0; p <= i; p++) {
      const v = cur[p];
      if (v === NEG) continue;
      if (p === 0) nxt[0] = Math.max(nxt[0], v);
      nxt[p + 1] = Math.max(nxt[p + 1], v + a[i]);
      if (p >= 2) nxt[p - 2] = Math.max(nxt[p - 2], v - a[i]);
    }
    cur = nxt;
    rows.push([...cur]);
  }
  return rows;
}

type Step = { p: number; move: string };

/* ย้อนรอยจากช่องคำตอบ dp[n][0] กลับขึ้นไปหาต้นทาง เพื่อไฮไลต์เส้นทางในตาราง */
function tracePath(a: number[], rows: number[][]): Step[] {
  const steps: Step[] = [];
  let p = 0;
  for (let i = a.length; i >= 1; i--) {
    const v = rows[i][p];
    const prev = rows[i - 1];
    if (p >= 1 && prev[p - 1] !== NEG && prev[p - 1] + a[i - 1] === v) {
      steps.push({ p, move: 'บวก' });
      p = p - 1;
    } else if (prev[p + 2] !== NEG && prev[p + 2] - a[i - 1] === v) {
      steps.push({ p, move: 'ลบ' });
      p = p + 2;
    } else {
      steps.push({ p, move: 'ข้าม' });
      p = 0;
    }
  }
  steps.push({ p: 0, move: 'เริ่ม' });
  return steps.reverse();
}

const recurrenceTex = texBlock(
  String.raw`\mathrm{dp}[i][p] \;=\; \max \begin{cases} \mathrm{dp}[i-1][p-1] + a_i & (p \ge 1) \\ \mathrm{dp}[i-1][p+2] - a_i & \\ \mathrm{dp}[i-1][0] & (p = 0) \end{cases}`,
);

const demoRows = dpRows(demo);
const demoPath = tracePath(demo, demoRows);
const demoTrace = demoPath.map((s, i) => demoRows[i][s.p]).join(' → ');
/* ---- ตัวเล่นทีละขั้น: สร้างสคริปต์การเติมตารางไว้ตอน build ---- */
type Src = { i: number; p: number; kind: 'plus' | 'minus' | 'skip'; ok: boolean };
type SimStep = { i: number; p: number; val: number | null; html: string; srcs: Src[]; path: boolean; base: boolean };

function buildSteps(a: number[], rows: number[][]): SimStep[] {
  const n = a.length;
  const out: SimStep[] = [];
  out.push({
    i: -1,
    p: -1,
    val: null,
    html:
      '<p class="dps-q">ตอนเริ่ม ตารางว่างทั้งใบ</p>' +
      '<ul class="dps-cands"><li class="no">ทุกช่องตั้งต้นเป็น <b>NEG</b> ซึ่งในโค้ดคือค่าติดลบมหาศาล แปลว่า "สถานะนี้ยังไปไม่ถึง" ในตารางนี้วาดเป็นจุด <b>·</b></li>' +
      '<li class="no">ที่ต้องใช้ NEG ไม่ใช่ 0 เพราะ 0 เป็นแต้มที่ถูกต้องได้ (แปลว่าไม่หยิบอะไรเลย) ถ้าตั้ง 0 ไว้ทุกช่อง โปรแกรมจะเชื่อว่าตัวเองยืนอยู่ในสถานะที่ไปไม่ได้จริง</li></ul>' +
      '<p class="dps-a">กดถัดไปเพื่อปักหมุดจุดเริ่มต้น</p>',
    srcs: [],
    path: false,
    base: false,
  });

  out.push({
    i: 0,
    p: 0,
    val: 0,
    html:
      '<p class="dps-q">ปักหมุดจุดเริ่มต้นที่แถว <b>i = 0</b> คือยังไม่ดูหนังสือสักเล่ม</p>' +
      '<ul class="dps-cands"><li class="ok win">ยังไม่ค้างอะไรเลย แต้มเป็นศูนย์ จึงเปลี่ยน <b>dp[0][0]</b> จาก NEG เป็น <b>0</b></li>' +
      '<li class="no">ช่องอื่นในแถวนี้แปลว่า "ยังไม่ดูอะไรเลย แต่ค้างบวกไว้แล้ว" ซึ่งเป็นไปไม่ได้ จึงยังเป็น NEG ต่อไป</li></ul>' +
      '<p class="dps-a">ทั้งตารางจะงอกออกมาจากช่องเดียวนี้</p>',
    srcs: [],
    path: false,
    base: true,
  });

  for (let i = 1; i <= n; i++) {
    const v = a[i - 1];
    for (let p = 0; p <= Math.min(i, DEMO_COLS - 1); p++) {
      const prev = rows[i - 1];
      const srcs: Src[] = [];
      const lines: string[] = [];

      const plusOk = p >= 1 && prev[p - 1] !== NEG;
      if (p >= 1) {
        srcs.push({ i: i - 1, p: p - 1, kind: 'plus', ok: plusOk });
        if (plusOk) {
          const got = prev[p - 1] + v;
          lines.push(
            `<li class="ok" data-val="${got}">ให้ <b>a[${i}] = ${v}</b> เป็น<b>บวก</b> เปิดคู่ใหม่ ค้างเพิ่มหนึ่ง: มาจาก dp[${i - 1}][${p - 1}] = ${prev[p - 1]} แล้วบวก ${v} ได้ <b>${got}</b></li>`,
          );
        } else {
          lines.push(
            `<li class="no">ให้ a[${i}] เป็นบวก: ต้องมาจาก dp[${i - 1}][${p - 1}] ซึ่งไปไม่ถึง ใช้ไม่ได้</li>`,
          );
        }
      }

      const minusOk = prev[p + 2] !== NEG;
      srcs.push({ i: i - 1, p: p + 2, kind: 'minus', ok: minusOk && p + 2 < DEMO_COLS });
      if (minusOk) {
        const got = prev[p + 2] - v;
        lines.push(
          `<li class="ok" data-val="${got}">ให้ <b>a[${i}] = ${v}</b> เป็น<b>ลบ</b> ปิดจ๊อบ กินบวกค้างไปสอง: มาจาก dp[${i - 1}][${p + 2}] = ${prev[p + 2]} แล้วลบ ${v} ได้ <b>${got}</b></li>`,
        );
      } else if (p + 2 >= DEMO_COLS) {
        // ช่องต้นทางอยู่เลยคอลัมน์สุดท้ายของตาราง ห้ามอ้างชื่อช่องที่คนอ่านหาไม่เจอ
        lines.push(
          `<li class="no">ให้ a[${i}] เป็นลบ: ต้องมาจากช่องที่ค้างบวกไว้ ${p + 2} เล่ม ซึ่งมากกว่าจำนวนหนังสือทั้งกอง จึงอยู่นอกตารางและเป็นไปไม่ได้</li>`,
        );
      } else {
        lines.push(
          `<li class="no">ให้ a[${i}] เป็นลบ: ต้องมาจาก dp[${i - 1}][${p + 2}] ซึ่งไปไม่ถึง ใช้ไม่ได้</li>`,
        );
      }

      if (p === 0) {
        const skipOk = prev[0] !== NEG;
        srcs.push({ i: i - 1, p: 0, kind: 'skip', ok: skipOk });
        if (skipOk) {
          lines.push(
            `<li class="ok" data-val="${prev[0]}">ไม่หยิบเล่มนี้เลย: ยกค่า dp[${i - 1}][0] = ${prev[0]} มาทั้งดุ้น <b>${prev[0]}</b></li>`,
          );
        }
      }

      const got = rows[i][p];
      // ไฮไลต์ทางที่ชนะ คนดูจะได้เห็นทันทีว่าทำไมช่องนี้เลือกค่านี้
      if (got !== NEG) {
        const win = lines.findIndex((l) => l.includes(`data-val="${got}"`));
        if (win >= 0) lines[win] = lines[win].replace('class="ok"', 'class="ok win"');
      }
      const verdict =
        got === NEG
          ? '<p class="dps-a bad">ไม่เหลือทางไหนที่ใช้ได้เลย ช่องนี้จึงยังเป็น NEG คือ<b>ไปไม่ถึง</b></p>'
          : `<p class="dps-a">หยิบค่าที่มากที่สุดในบรรดาทางที่ใช้ได้ ช่องนี้จึงเปลี่ยนจาก NEG เป็น <b>dp[${i}][${p}] = ${got}</b></p>`;

      out.push({
        i,
        p,
        val: got === NEG ? null : got,
        html:
          `<p class="dps-q">กำลังเติมช่อง <b>dp[${i}][${p}]</b> คือดูหนังสือมาแล้ว ${i} เล่ม (เล่มล่าสุดคือ a[${i}] = ${v}) และค้างบวกอยู่ ${p} เล่ม</p>` +
          `<ul class="dps-cands">${lines.join('')}</ul>` +
          verdict,
        srcs,
        path: false,
        base: false,
      });
    }
  }

  out.push({
    i: n,
    p: 0,
    val: rows[n][0],
    html:
      `<p class="dps-q">ตารางเต็มแล้ว คำตอบอยู่ที่ช่อง <b>dp[${n}][0]</b></p>` +
      `<ul class="dps-cands"><li class="ok win">ย้อนรอยกลับขึ้นไปได้เส้นทาง ${demoTrace} ซึ่งก็คือหยิบสองครั้ง และมีหนึ่งเล่มที่เลือกจะไม่หยิบ</li>` +
      `<li class="ok">ช่วงที่ค่าไม่ขยับเลย (${demoRows[3][0]} ค้างอยู่สองแถวติด) คือจังหวะที่โปรแกรมตัดสินใจ<b>ข้าม</b>หนังสือเล่มนั้น ปล่อยคาไว้ในกอง</li>` +
      `<li class="no">ช่องอื่นในแถวสุดท้ายอย่าง dp[${n}][3] = ${rows[n][3]} ดูเยอะกว่า แต่ยังค้างบวกสามเล่มที่ไม่มีลบมาปิด อ่านเป็นคำตอบไม่ได้</li></ul>` +
      `<p class="dps-a">คำตอบของกองนี้คือ <b>${rows[n][0]}</b> แต้ม</p>`,
    srcs: [],
    path: true,
    base: false,
  });

  return out;
}

const simSteps = buildSteps(demo, demoRows);

/* ---- ตัวเล่นชุดที่สอง: สองแถว cur / nxt แบบที่โค้ดจริงเห็น รวมจังหวะ swap ---- */
type RollKind = 'start' | 'clear' | 'push' | 'swap' | 'done';
type Hit = { p: number; ok: boolean };
type RollStep = {
  kind: RollKind;
  cur: string[];
  nxt: string[];
  curLabel: string;
  nxtLabel: string;
  src: number;
  hits: Hit[];
  html: string;
};

const show = (v: number) => (v === NEG ? '\u00b7' : String(v));
const snap = (arr: number[]) => arr.slice(0, DEMO_COLS).map(show);

function buildRoll(a: number[]): RollStep[] {
  const n = a.length;
  const out: RollStep[] = [];
  let cur: number[] = new Array<number>(n + 3).fill(NEG);
  const blank: number[] = new Array<number>(n + 3).fill(NEG);
  cur[0] = 0;

  out.push({
    kind: 'start',
    cur: snap(cur),
    nxt: snap(blank),
    curLabel: 'cur = dp[0]',
    nxtLabel: 'nxt (ยังไม่เปิด)',
    src: -1,
    hits: [],
    html:
      '<p class="dps-q">โค้ดจริงถือแถวไว้แค่สองแถว</p>' +
      '<ul class="dps-cands"><li class="ok win"><b>cur</b> คือแถวที่ยืนอยู่ ตอนนี้เป็นแถว <b>dp[0]</b> มีแค่ <b>cur[0] = 0</b> ช่องอื่นเป็น NEG</li>' +
      '<li class="no"><b>nxt</b> คือแถวถัดไปที่กำลังจะสร้าง ยังไม่เปิดใช้</li></ul>' +
      '<p class="dps-a">ทั้งเรื่องคือวนสามจังหวะ: เปิดแถวใหม่ ผลักค่าไปข้างหน้า แล้ว swap</p>',
  });

  for (let i = 0; i < n; i++) {
    const v = a[i];
    const nxt: number[] = new Array<number>(n + 3).fill(NEG);

    out.push({
      kind: 'clear',
      cur: snap(cur),
      nxt: snap(nxt),
      curLabel: `cur = dp[${i}]`,
      nxtLabel: `nxt = dp[${i + 1}] (เพิ่งล้าง)`,
      src: -1,
      hits: [],
      html:
        `<p class="dps-q">จังหวะที่ 1 ของหนังสือเล่มที่ ${i + 1} (a[${i + 1}] = ${v}): เปิดแถวใหม่</p>` +
        '<ul class="dps-cands"><li class="ok"><code>fill(nxt.begin(), nxt.end(), NEG)</code> ล้างแถว <b>nxt</b> ให้เป็น NEG ทั้งแถว</li>' +
        '<li class="no">ถ้าลืมล้าง ค่าเก่าจากแถวก่อน ๆ จะค้างอยู่แล้วปนกับแถวใหม่ นี่เป็นบั๊กคลาสสิกของการใช้สองแถวสลับกัน</li></ul>' +
        '<p class="dps-a">ตอนนี้ nxt ว่างเปล่า พร้อมรับค่าที่ถูกผลักมา</p>',
    });

    for (let q = 0; q <= i; q++) {
      if (cur[q] === NEG) continue;
      const base = cur[q];
      const lines: string[] = [];
      const hits: Hit[] = [];

      if (q === 0) {
        const got = base;
        const win = got > nxt[0];
        if (win) nxt[0] = got;
        hits.push({ p: 0, ok: win });
        lines.push(
          `<li class="${win ? 'ok win' : 'ok'}">ไม่หยิบเล่มนี้: ผลักไป <code>nxt[0]</code> ด้วยค่า <b>${got}</b>${win ? ' ดีกว่าที่มีอยู่ จึงเขียนทับ' : ' ไม่ดีกว่าค่าที่มีอยู่แล้ว จึงไม่เขียน'}</li>`,
        );
      }

      const plusTo = q + 1;
      if (plusTo < DEMO_COLS) {
        const got = base + v;
        const win = got > nxt[plusTo];
        if (win) nxt[plusTo] = got;
        hits.push({ p: plusTo, ok: win });
        lines.push(
          `<li class="${win ? 'ok win' : 'ok'}">ให้เป็น<b>บวก</b>: ผลักไป <code>nxt[${plusTo}]</code> ด้วยค่า ${base} + ${v} = <b>${got}</b>${win ? ' ดีกว่าที่มีอยู่ จึงเขียนทับ' : ' ไม่ดีกว่าค่าที่มีอยู่แล้ว จึงไม่เขียน'}</li>`,
        );
      }

      if (q >= 2) {
        const minusTo = q - 2;
        const got = base - v;
        const win = got > nxt[minusTo];
        if (win) nxt[minusTo] = got;
        hits.push({ p: minusTo, ok: win });
        lines.push(
          `<li class="${win ? 'ok win' : 'ok'}">ให้เป็น<b>ลบ</b>: ผลักไป <code>nxt[${minusTo}]</code> ด้วยค่า ${base} − ${v} = <b>${got}</b>${win ? ' ดีกว่าที่มีอยู่ จึงเขียนทับ' : ' ไม่ดีกว่าค่าที่มีอยู่แล้ว จึงไม่เขียน'}</li>`,
        );
      } else {
        lines.push('<li class="no">ให้เป็นลบยังทำไม่ได้ เพราะบวกค้างไม่ถึงสองเล่ม</li>');
      }

      out.push({
        kind: 'push',
        cur: snap(cur),
        nxt: snap(nxt),
        curLabel: `cur = dp[${i}]`,
        nxtLabel: `nxt = dp[${i + 1}]`,
        src: q,
        hits,
        html:
          `<p class="dps-q">จังหวะที่ 2: ยืนที่ <b>cur[${q}] = ${base}</b> แล้วถามว่าค่านี้<b>ส่งต่อไปช่องไหนของ nxt ได้บ้าง</b></p>` +
          `<ul class="dps-cands">${lines.join('')}</ul>` +
          '<p class="dps-a">ผลักครบทุกทางแล้ว ขยับไปยืนช่องถัดไปของ cur</p>',
      });
    }

    cur = nxt;
    out.push({
      kind: 'swap',
      cur: snap(cur),
      nxt: snap(blank),
      curLabel: `cur = dp[${i + 1}] (หลัง swap)`,
      nxtLabel: 'nxt (รอเปิดใหม่)',
      src: -1,
      hits: [],
      html:
        `<p class="dps-q">จังหวะที่ 3: <code>swap(cur, nxt)</code></p>` +
        `<ul class="dps-cands"><li class="ok win">แถวที่เพิ่งสร้างเสร็จเลื่อนขึ้นมาเป็น <b>cur</b> ตอนนี้ cur คือแถว <b>dp[${i + 1}]</b> แล้ว</li>` +
        '<li class="ok">แถวเก่ากลายเป็นที่ว่างสำหรับรอบถัดไป จึงไม่ต้องจองหน่วยความจำใหม่เลยตลอดทั้งโปรแกรม</li>' +
        `<li class="no"><code>swap</code> ของ <code>vector</code> คือการสลับตัวชี้ ไม่ได้ก็อปข้อมูล ${i + 1 === n ? 'และรอบนี้เป็นรอบสุดท้าย' : 'จึงเร็วคงที่'}</li></ul>` +
        '<p class="dps-a">แถวก่อนหน้าถูกทิ้งไปเลย ไม่มีใครกลับไปดูมันอีก</p>',
    });
  }

  out.push({
    kind: 'done',
    cur: snap(cur),
    nxt: snap(blank),
    curLabel: `cur = dp[${n}]`,
    nxtLabel: 'nxt (ไม่ใช้แล้ว)',
    src: 0,
    hits: [{ p: 0, ok: true }],
    html:
      '<p class="dps-q">หนังสือหมดกองแล้ว อ่านคำตอบจากช่องเดียว</p>' +
      `<ul class="dps-cands"><li class="ok win">คำตอบคือ <b>cur[0] = ${cur[0]}</b> คือจบแบบไม่มีบวกค้าง ทุกการหยิบสมบูรณ์</li>` +
      '<li class="no">ตลอดทั้งโปรแกรมเราเก็บแค่สองแถวนี้ ตารางทั้งใบไม่เคยมีอยู่จริงในหน่วยความจำ</li></ul>' +
      `<p class="dps-a">ตารางเต็มใบที่เดินให้ดูข้างบนคือ "ภาพในหัว" ส่วนอันนี้คือของจริงที่เครื่องถือไว้</p>`,
  });

  return out;
}

