  }
  /* ปุ่มหนังสือถูกสร้างด้วย JS จึงไม่มี data-astro-cid ต้องห่อ :global ไม่งั้นสไตล์ไม่ติด */
  .bg-stack :global(li){margin:0;}
  .bg-stack :global(.bg-book){
    width:100%;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:0.6rem;
    font:inherit;
    font-size:0.9rem;
    text-align:left;
    padding:0.42rem 0.75rem;
    border-radius:7px;
    border:1px solid var(--dl-border);
    background:#1c2536;
    color:var(--dl-ink);
    cursor:pointer;
    transition:border-color .15s ease, background .15s ease, transform .15s ease, opacity .18s ease;
  }
  .bg-stack :global(.bg-book:disabled){cursor:default;opacity:0.75;}
  .bg-stack :global(.bg-idx){font-size:0.66rem;color:#6b7690;font-family:"JetBrains Mono", monospace;}
  .bg-stack :global(.bg-val){font-weight:700;font-family:"Fira Code","Fira Mono",monospace;}
  .bg-stack :global(.bg-book.is-target){
    border-color:var(--dl-emerald-bright);
    background:rgba(47,158,92,0.2);
    transform:translateX(3px);
  }
  .bg-stack :global(.bg-book.is-target.is-minus){
    border-color:var(--dl-red);
    background:rgba(214,69,69,0.18);
