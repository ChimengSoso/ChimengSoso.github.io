<script>
  // กองหนังสือจำลอง: คลิกเล่มบนสุดของสามเล่มที่อยากหยิบ
  // ค่า best ของแต่ละกองคือคำตอบจริง ใส่ไว้ตรง ๆ เพื่อไม่ให้โค้ดเฉลยหลุดมาอยู่ในหน้าเว็บ
  interface Pile {
    books: number[];
    best: number;
  }

  const PILES: Pile[] = [
    { books: [9, 2, 9, 2, 9, 1], best: 26 },
    { books: [1, 2, 3, 4, 5, 6, 7], best: 5 },
    { books: [5, 5, 5, 5, 5, 5, 5, 5, 100], best: 10 },
  ];

  function initOne(fig: HTMLElement): void {
    if (fig.dataset.wired === '1') return;
    const stackEl = fig.querySelector<HTMLOListElement>('[data-stack]');
    const scoreEl = fig.querySelector<HTMLElement>('[data-score]');
    const bestEl = fig.querySelector<HTMLElement>('[data-best]');
    const movesEl = fig.querySelector<HTMLElement>('[data-moves]');
    const logEl = fig.querySelector<HTMLElement>('[data-log]');
    const resetBtn = fig.querySelector<HTMLButtonElement>('[data-reset]');
    if (!stackEl || !scoreEl || !bestEl || !movesEl || !logEl || !resetBtn) return;
    fig.dataset.wired = '1';

    const calmer = window.matchMedia('(prefers-reduced-motion: reduce)');
    let pileIndex = 0;
    let books: number[] = [];
    let score = 0;
    let moves = 0;
    let busy = false;

    function draw(): void {
      if (!stackEl) return;
      stackEl.replaceChildren();
      books.forEach((value, i) => {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bg-book';
        btn.dataset.i = String(i);
        btn.disabled = i + 2 >= books.length;
        const idx = document.createElement('span');
        idx.className = 'bg-idx';
        idx.textContent = `เล่ม ${i + 1}`;
        const val = document.createElement('span');
        val.className = 'bg-val';
        val.textContent = String(value);
        btn.append(idx, val);
        btn.setAttribute(
          'aria-label',
          btn.disabled
            ? `เล่มที่ ${i + 1} เลข ${value} หยิบไม่ได้ เพราะใต้มันเหลือไม่ถึงสองเล่ม`
            : `หยิบเล่มที่ ${i + 1} ถึง ${i + 3} ได้ ${books[i]} บวก ${books[i + 1]} ลบ ${books[i + 2]}`,
        );
        li.append(btn);
        stackEl.append(li);
      });
    }

    function refreshHud(): void {
      if (!scoreEl || !movesEl || !bestEl) return;
      scoreEl.textContent = String(score);
      movesEl.textContent = `${moves} ครั้ง`;
      bestEl.textContent = String(PILES[pileIndex].best);
    }

    function say(text: string, win: boolean): void {
      if (!logEl) return;
      logEl.textContent = text;
      logEl.classList.toggle('is-win', win);
    }

    function load(index: number): void {
      pileIndex = index;
      books = PILES[index].books.slice();
      score = 0;
      moves = 0;
      busy = false;
      draw();
      refreshHud();
      say('คลิกเล่มบนสุดของสามเล่มที่อยากหยิบ', false);
    }

    function highlight(i: number, on: boolean): void {
      if (!stackEl) return;
      const rows = stackEl.querySelectorAll<HTMLButtonElement>('.bg-book');
      for (let k = i; k < i + 3 && k < rows.length; k++) {
        rows[k].classList.toggle('is-target', on);
        rows[k].classList.toggle('is-minus', on && k === i + 2);
      }
    }

    function pick(i: number): void {
      if (busy || i + 2 >= books.length) return;
      const gain = books[i] + books[i + 1] - books[i + 2];
      const detail = `${books[i]} + ${books[i + 1]} − ${books[i + 2]} = ${gain >= 0 ? '+' : ''}${gain}`;
      const finish = (): void => {
        books.splice(i, 3);
        score += gain;
        moves += 1;
        busy = false;
        draw();
        refreshHud();
        const best = PILES[pileIndex].best;
        if (score === best) {
          say(`${detail} · แต้มสะสม ${score} ตรงกับคำตอบที่ดีที่สุดของกองนี้แล้ว`, true);
        } else if (books.length < 3) {
          say(`${detail} · แต้มสะสม ${score} หยิบต่อไม่ได้แล้ว ดีที่สุดคือ ${best}`, false);
        } else {
          say(`${detail} · แต้มสะสม ${score}`, false);
        }
      };
      if (calmer.matches) {
        finish();
        return;
      }
      busy = true;
      if (stackEl) {
        const rows = stackEl.querySelectorAll<HTMLButtonElement>('.bg-book');
        for (let k = i; k < i + 3 && k < rows.length; k++) rows[k].classList.add('is-going');
      }
      window.setTimeout(finish, 180);
    }

    stackEl.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest<HTMLButtonElement>('.bg-book');
      if (!btn || btn.disabled || !btn.dataset.i) return;
      pick(Number(btn.dataset.i));
    });

    const hoverOn = (e: Event): void => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest<HTMLButtonElement>('.bg-book');
      if (!btn || btn.disabled || !btn.dataset.i) return;
      highlight(Number(btn.dataset.i), true);
    };
    const hoverOff = (e: Event): void => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest<HTMLButtonElement>('.bg-book');
      if (!btn || !btn.dataset.i) return;
      highlight(Number(btn.dataset.i), false);
    };
    stackEl.addEventListener('mouseover', hoverOn);
    stackEl.addEventListener('mouseout', hoverOff);
    stackEl.addEventListener('focusin', hoverOn);
    stackEl.addEventListener('focusout', hoverOff);

    resetBtn.addEventListener('click', () => load(pileIndex));

    fig.querySelectorAll<HTMLButtonElement>('.bg-pile').forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = Number(btn.dataset.pile ?? '0');
        if (Number.isNaN(index) || !PILES[index]) return;
        fig.querySelectorAll<HTMLButtonElement>('.bg-pile').forEach((b) => b.classList.remove('is-on'));
        btn.classList.add('is-on');
        load(index);
      });
    });

    load(0);
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-bookgame]').forEach(initOne);
  });
</script>
