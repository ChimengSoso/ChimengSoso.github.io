    color:var(--dl-emerald-bright);
    letter-spacing:.2px;
    margin:1.6rem 0 0.5rem;     /* ชิด h2 มากกว่าเดิม เพื่อให้อ่านเป็นหัวข้อย่อยของกันจริง */
  }

  /* กองหนังสือจำลอง (mini game) */
  .bookgame{
    margin:1.5rem 0 0.5rem;
