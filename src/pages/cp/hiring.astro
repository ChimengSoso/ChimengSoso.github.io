import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

const href = 'hiring/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

/** ผู้สมัครหนึ่งคน s = เงินเดือนขั้นต่ำที่ขอ, q = ระดับคุณวุฒิ */
type Cand = { s: number; q: number };

/** อัตราของ a สูงกว่าของ b ไหม เทียบ s/q ด้วยการคูณไขว้ ไม่ต้องหาร */
const rateAbove = (a: Cand, b: Cand): boolean => a.s * b.q > b.s * a.q;

/** ทีมนี้จ่ายไหวไหม อัตราคือ s/q ที่สูงสุดในทีม ค่าจ้างรวมคืออัตราคูณผลรวมคุณวุฒิ */
function teamFits(team: Cand[], w: number): boolean {
  if (team.length === 0) return true;
  let top = team[0];
  let sumQ = 0;
  for (const c of team) {
    sumQ += c.q;
    if (rateAbove(c, top)) top = c;
  }
  return sumQ * top.s <= w * top.q;
}

/** ตัวตรวจ ลองทุกเซตย่อยของผู้สมัคร ไม่มีการเรียงหรือฮีปใด ๆ */
function bruteBest(w: number, cs: Cand[]): { best: number; ties: number } {
  let best = 0;
  let ties = 1;
  for (let m = 1; m < 1 << cs.length; m++) {
    const team = cs.filter((_, i) => (m >> i) & 1);
    if (!teamFits(team, w)) continue;
    if (team.length > best) {
      best = team.length;
      ties = 1;
    } else if (team.length === best) ties++;
  }
  return { best, ties };
}

/** ดัชนีเรียงตามอัตราจากถูกไปแพง อัตราเท่ากันให้คนหมายเลขน้อยมาก่อน */
const byRate = (cs: Cand[]): number[] =>
  cs.map((_, i) => i).sort((a, b) => cs[a].s * cs[b].q - cs[b].s * cs[a].q || a - b);

/** ท่ากลาง ตรึงคนตั้งราคาทีละคน แล้วหยิบคุณวุฒิน้อยก่อนจากคนที่อัตราไม่เกินเขา */
function pivotSmallest(w: number, cs: Cand[]): number {
  let best = 0;
  for (const p of cs) {
    const qs = cs.filter((c) => !rateAbove(c, p)).map((c) => c.q).sort((x, y) => x - y);
    let sumQ = 0;
    let cnt = 0;
    for (const q of qs) {
      if ((sumQ + q) * p.s > w * p.q) break;
      sumQ += q;
      cnt++;
    }
    best = Math.max(best, cnt);
  }
  return best;
}

type HeapStep = {
  who: number;
  s: number;
  q: number;
  hand: number[];
  dropped: number[];
  sumQ: number;
  pay: number;
  size: number;
  best: number;
};

/** ท่าเต็ม เดินอัตราจากถูกไปแพง ในมือเก็บคุณวุฒิ งบเกินเมื่อไรทิ้งคนคุณวุฒิสูงสุด */
function heapWalk(w: number, cs: Cand[]): { best: number; steps: HeapStep[] } {
  const hand: number[] = [];
  let sumQ = 0;
  let best = 0;
  const steps: HeapStep[] = [];
  for (const k of byRate(cs)) {
    const c = cs[k];
    hand.push(c.q);
    sumQ += c.q;
    const dropped: number[] = [];
    while (hand.length > 0 && sumQ * c.s > w * c.q) {
      let at = 0;
      for (let i = 1; i < hand.length; i++) if (hand[i] > hand[at]) at = i;
      dropped.push(hand[at]);
      sumQ -= hand[at];
      hand.splice(at, 1);
    }
    best = Math.max(best, hand.length);
    steps.push({
      who: k + 1,
      s: c.s,
      q: c.q,
      hand: [...hand].sort((x, y) => x - y),
      dropped,
      sumQ,
      pay: (sumQ * c.s) / c.q,
      size: hand.length,
      best,
    });
  }
  return { best, steps };
}

/** สองท่าที่ดูเข้าท่าแต่ผิด ใช้ในกล่องกับดักและเป็นด่านตรวจของเกม */
function greedyCheapS(w: number, cs: Cand[]): number {
  const team: Cand[] = [];
  const order = cs.map((_, i) => i).sort((a, b) => cs[a].s - cs[b].s || cs[a].q - cs[b].q);
  for (const i of order) if (teamFits([...team, cs[i]], w)) team.push(cs[i]);
  return team.length;
}
function greedyRatePrefix(w: number, cs: Cand[]): number {
  let sumQ = 0;
  let best = 0;
  byRate(cs).forEach((k, i) => {
    sumQ += cs[k].q;
    if (sumQ * cs[k].s <= w * cs[k].q) best = i + 1;
  });
  return best;
}

/* ด่านตรวจตอนบิลด์ ทั้งท่ากลางและท่าเต็มต้องตรงกับการลองทุกเซตย่อย ไม่งั้นหน้านี้ไม่ขึ้น */
const SWEEP_CASES = 500;
{
  let seed = 20310911;
  const rnd = (m: number): number => {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed % m;
  };
  for (let t = 0; t < SWEEP_CASES; t++) {
    const n = 1 + rnd(9);
    const V = [3, 10, 50][rnd(3)];
    const cs = Array.from({ length: n }, () => ({ s: 1 + rnd(V), q: 1 + rnd(V) }));
    const w = 1 + rnd(V * n * 3);
    const b = bruteBest(w, cs).best;
    if (heapWalk(w, cs).best !== b || pivotSmallest(w, cs) !== b)
      throw new Error(`hiring: ท่าที่สอนไม่ตรงกับการลองทุกเซตย่อย ที่ W=${w} ${JSON.stringify(cs)}`);
  }
}

/* ---------- ตัวอย่างในโจทย์ ---------- */
type Sample = { w: number; cs: Cand[] };
const SAMPLES: Sample[] = [
  { w: 100, cs: [{ s: 5, q: 1000 }, { s: 10, q: 100 }, { s: 8, q: 10 }, { s: 20, q: 1 }] },
  { w: 4, cs: [{ s: 1, q: 2 }, { s: 1, q: 3 }, { s: 1, q: 3 }] },
  { w: 40, cs: [{ s: 10, q: 1 }, { s: 10, q: 2 }, { s: 10, q: 3 }] },
];
const SAMPLE_OUT = [2, 3, 2];
SAMPLES.forEach((sm, i) => {
  if (heapWalk(sm.w, sm.cs).best !== SAMPLE_OUT[i]) throw new Error(`hiring: ตัวอย่างที่ ${i + 1} ไม่ตรงกับโจทย์`);
});

const fmt = (n: number): string => n.toLocaleString('en-US');
/** ตัวเลขทศนิยมแบบสั้น ตัดศูนย์ท้ายทิ้ง */
const dec = (x: number, d = 3): string => String(Number(x.toFixed(d)));

/* ตัวอย่างที่ 3 ใช้อธิบายกฎการจ่ายเงิน ทีมคนที่ 2 กับ 3 */
const EX3 = SAMPLES[2];
const EX3_TEAM = [1, 2];
const EX3_TOP = EX3_TEAM.reduce((a, b) => (rateAbove(EX3.cs[b], EX3.cs[a]) ? b : a));
const ex3Rate = EX3.cs[EX3_TOP].s / EX3.cs[EX3_TOP].q;
const ex3Pays = EX3_TEAM.map((i) => ({ who: i + 1, q: EX3.cs[i].q, s: EX3.cs[i].s, pay: EX3.cs[i].q * ex3Rate }));
const ex3Total = ex3Pays.reduce((t, p) => t + p.pay, 0);
const ex3AllRate = Math.max(...EX3.cs.map((c) => c.s / c.q));
const ex3AllTotal = ex3AllRate * EX3.cs.reduce((t, c) => t + c.q, 0);

/* แผนภาพเส้นอัตราของตัวอย่างที่ 3 */
const RX0 = 40;
const RUNIT = 60;
const rx = (r: number): number => RX0 + r * RUNIT;
const R_MAX = Math.ceil(ex3AllRate) + 1;
const ratePts = EX3.cs.map((c, i) => ({ who: i + 1, s: c.s, q: c.q, r: c.s / c.q, inTeam: EX3_TEAM.includes(i) }));
const teamRates = ratePts.filter((p) => p.inTeam).map((p) => p.r);
const BR_L = rx(Math.min(...teamRates));
const BR_R = rx(Math.max(...teamRates));
const RL_W = rx(R_MAX) + 19;
const RL_H = 229;

/* ---------- ตัวเล่นทีละขั้น ตัวอย่างที่ 1 ---------- */
const EX1 = SAMPLES[0];
const EX1_WALK = heapWalk(EX1.w, EX1.cs);
const walkSteps = EX1_WALK.steps.map((st) => {
  const rate = dec(st.s / st.q);
  const head =
    `คนที่ <b>${st.who}</b> ขอ ${st.s} ดอลลาร์ คุณวุฒิ ${st.q} อัตราจึงเป็น <b>${rate}</b> ต่อหนึ่งหน่วยคุณวุฒิ ` +
    `ถือว่าเขาเป็นคนตั้งราคา แล้วรับคุณวุฒิ ${st.q} เข้ามือ `;
  const drop =
    st.dropped.length === 0
      ? `ผลรวมคุณวุฒิในมือเป็น ${fmt(st.sumQ)} คูณอัตรา ${rate} ได้ <b>${dec(st.pay, 2)}</b> ไม่เกินงบ ${EX1.w} จึงไม่ต้องทิ้งใคร `
      : `งบไม่พอ จึงทิ้งคนคุณวุฒิสูงสุดออกทีละคน คือ <b>${st.dropped.join(' แล้ว ')}</b> ` +
        `จนผลรวมเหลือ ${fmt(st.sumQ)} คูณอัตราได้ <b>${dec(st.pay, 2)}</b> ซึ่งไม่เกินงบ `;
  return { note: head + drop + `ในมือเหลือ <b>${st.size}</b> คน จำนวนที่ดีที่สุดจนถึงตอนนี้คือ <b>${st.best}</b>` };
});

/* ---------- กับดักสองท่า หากรณีที่เล็กที่สุดตอนบิลด์ด้วยการไล่ทุกกรณีเล็ก ๆ ---------- */
function smallestFail(f: (w: number, cs: Cand[]) => number): { w: number; cs: Cand[]; got: number; best: number } {
  const pool: Cand[] = [];
  for (let s = 1; s <= 4; s++) for (let q = 1; q <= 4; q++) pool.push({ s, q });
  for (let n = 1; n <= 3; n++) {
    const idx = Array(n).fill(0);
    for (;;) {
      const cs = idx.map((i) => pool[i]);
      for (let w = 1; w <= 24; w++) {
        const b = bruteBest(w, cs).best;
        const got = f(w, cs);
        if (got !== b) return { w, cs, got, best: b };
      }
      let d = n - 1;
      while (d >= 0 && idx[d] === pool.length - 1) d--;
      if (d < 0) break;
      idx[d]++;
      for (let e = d + 1; e < n; e++) idx[e] = idx[d];
    }
  }
  throw new Error('hiring: หากรณีที่กับดักพังไม่เจอ แปลว่าข้ออ้างในกล่องกับดักผิด');
}
const TRAP_S = smallestFail(greedyCheapS);
const TRAP_P = smallestFail(greedyRatePrefix);
const csList = (cs: Cand[]): string => cs.map((c) => `(${c.s}, ${c.q})`).join(' ');

/* ---------- มินิเกม เลือกทีมให้คนเยอะที่สุดภายใต้งบ ---------- */
type GamePuzzle = { id: string; label: string; tease: string; w: number; cs: Cand[]; best: number; ties: number };
function makePuzzle(id: string, label: string, tease: string, w: number, cs: Cand[], trap: boolean): GamePuzzle {
  const b = bruteBest(w, cs);
  if (heapWalk(w, cs).best !== b.best) throw new Error(`hiring: เฉลยเกม ${id} สองท่าไม่ตรงกัน`);
  if (trap && (greedyCheapS(w, cs) >= b.best || greedyRatePrefix(w, cs) >= b.best))
    throw new Error(`hiring: ชุด ${id} ควรทำให้ท่าโลภทั้งสองแพ้ แต่ไม่แพ้`);
  return { id, label, tease, w, cs, best: b.best, ties: b.ties };
}
const PZ_C: Cand[] = [{ s: 30, q: 1 }, { s: 45, q: 2 }, { s: 45, q: 3 }, { s: 35, q: 2 }, { s: 55, q: 5 }, { s: 10, q: 1 }];
const PZ_D: Cand[] = [{ s: 20, q: 7 }, { s: 50, q: 4 }, { s: 45, q: 2 }, { s: 80, q: 1 }, { s: 25, q: 1 }, { s: 85, q: 4 }];
const puzzles: GamePuzzle[] = [
  makePuzzle('a', 'ตัวอย่างที่ 1 งบ 100', 'สี่คนนี้มาจากตัวอย่างในโจทย์ ลองกดเลือกดู แล้วสังเกตว่าตัวเลขค่าจ้างของทุกคนเปลี่ยนตามใคร', EX1.w, EX1.cs, false),
  makePuzzle('b', 'ตัวอย่างที่ 3 งบ 40', 'ทุกคนขอเงินเท่ากันหมด แต่ราคาของทีมไม่เท่ากันเลย', EX3.w, EX3.cs, false),
  makePuzzle('c', 'หกคน งบ 110', 'ชุดนี้คนที่ขอเงินน้อยที่สุดไม่ใช่ตัวเลือกที่ดีเสมอไป ลองจ้างเขาก่อนแล้วดูว่าเกิดอะไรขึ้น', 110, PZ_C, true),
  makePuzzle('d', 'หกคน งบ 330', 'ชุดสุดท้าย ลองหาทีมที่ใหญ่ที่สุดให้ได้ก่อนเปิดเฉลย', 330, PZ_D, true),
];
const puzzlesJson = JSON.stringify(puzzles);
const pzC = puzzles[2];

/* ---------- บิลค่าใช้จ่าย ---------- */
const N_MAX = 500000;
const bill = [
  { name: 'ลองทุกทีม', limit: 'N ราว 20', work: `2 ยกกำลัง N ทีม ที่ N เท่ากับ ${fmt(N_MAX)} เกินจะนับ` },
  { name: 'ตรึงคนตั้งราคาทีละคน แล้วเรียงคุณวุฒิใหม่ทุกครั้ง', limit: 'N หลักพัน', work: `ราว ${fmt(N_MAX)} ยกกำลังสอง คือสองแสนห้าหมื่นล้าน` },
  { name: 'เดินอัตราจากถูกไปแพงรอบเดียว พร้อมฮีป', limit: `N ถึง ${fmt(N_MAX)}`, work: `ราว ${fmt(N_MAX * 19)} ครั้ง (N คูณ log N)` },
];

const solution = `#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
int main(){
    int n; ll W;
    if(scanf("%d %lld", &n, &W) != 2) return 0;
    vector<ll> S(n), Q(n);
    for(int i = 0; i < n; i++) scanf("%lld %lld", &S[i], &Q[i]);
    // เรียงตามอัตราค่าจ้างต่อหนึ่งหน่วยคุณวุฒิ S/Q จากน้อยไปมาก (เทียบด้วยการคูณไขว้ ไม่ต้องหาร)
    vector<int> id(n);
    iota(id.begin(), id.end(), 0);
    sort(id.begin(), id.end(), [&](int a, int b){ return S[a] * Q[b] < S[b] * Q[a]; });
    priority_queue<ll> heap;   // คุณวุฒิของคนที่ถืออยู่ ตัวใหญ่สุดอยู่บนหัว
    ll sumQ = 0;
    size_t best = 0;
    for(int k : id){
        heap.push(Q[k]); sumQ += Q[k];
        // อัตราตอนนี้คือ S[k]/Q[k] ค่าจ้างรวมคือ sumQ * S[k] / Q[k] ต้องไม่เกิน W
        while(!heap.empty() && sumQ * S[k] > W * Q[k]){
            sumQ -= heap.top(); heap.pop();   // ทิ้งคนที่คุณวุฒิสูงสุด เพราะเขาแพงสุดที่อัตรานี้
        }
        best = max(best, heap.size());
    }
    printf("%zu\\n", best);
}`;

const midCode = `#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
int main(){
    int n; ll W;
    if(scanf("%d %lld", &n, &W) != 2) return 0;
    vector<ll> S(n), Q(n);
    for(int i = 0; i < n; i++) scanf("%lld %lld", &S[i], &Q[i]);
    int best = 0;
    // ลองให้แต่ละคนเป็นคนที่อัตราสูงสุดในทีม
    for(int j = 0; j < n; j++){
        vector<ll> cand;   // คนที่อัตราไม่เกินคนที่ j
        for(int i = 0; i < n; i++)
            if(S[i] * Q[j] <= S[j] * Q[i]) cand.push_back(Q[i]);
        sort(cand.begin(), cand.end());
        ll sumQ = 0; int cnt = 0;
        for(ll q : cand){   // หยิบคุณวุฒิน้อยก่อน จนงบไม่พอ
            if((sumQ + q) * S[j] > W * Q[j]) break;
            sumQ += q; cnt++;
        }
        best = max(best, cnt);
    }
    printf("%d\\n", best);
}`;

const bruteCode = `// ตัวตรวจ ลองทุกเซตย่อยของผู้สมัคร ไม่มีการเรียงหรือฮีปใด ๆ
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
int main(){
    int n; ll W; scanf("%d %lld", &n, &W);
    vector<ll> S(n), Q(n);
    for(int i = 0; i < n; i++) scanf("%lld %lld", &S[i], &Q[i]);
    int best = 0;
    for(int m = 1; m < (1 << n); m++){
        // หาอัตราสูงสุดในเซต (เก็บเป็นเศษส่วน S/Q) แล้วคิดค่าจ้างรวม = อัตรา * ผลรวมคุณวุฒิ
        int top = -1; ll sumQ = 0;
        for(int i = 0; i < n; i++) if(m >> i & 1){
            sumQ += Q[i];
            if(top < 0 || S[i] * Q[top] > S[top] * Q[i]) top = i;
        }
        if(sumQ * S[top] <= W * Q[top]) best = max(best, __builtin_popcount(m));
    }
    printf("%d\\n", best);
}`;

const coreSnippet = `// ค่าจ้างรวมของทีม = (อัตราสูงสุดในทีม) x (ผลรวมคุณวุฒิของทีม)
// เทียบกับงบโดยไม่ต้องหาร:  sumQ * S[top] <= W * Q[top]
bool fits = sumQ * S[top] <= W * Q[top];`;
