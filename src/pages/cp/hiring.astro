<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type HrCand = { s: number; q: number };
  type HrPuzzle = { id: string; label: string; tease: string; w: number; cs: HrCand[]; best: number; ties: number };

  function isPuzzle(x: unknown): x is HrPuzzle {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return typeof o.w === 'number' && typeof o.best === 'number' && Array.isArray(o.cs) && typeof o.tease === 'string';
  }

  const show = (x: number): string => String(Number(x.toFixed(2)));

  function initHiringGame(): void {
    const maybeUi = cpGameUi('[data-hrgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root).filter(isPuzzle);
    if (puzzles.length === 0) return;

    let pi = 0;
    let team = new Set<number>();
    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-hr-board]'));

    /** คนตั้งราคาของทีม คือคนที่ s/q สูงสุด (-1 ถ้ายังไม่มีใคร) */
    function topOf(p: HrPuzzle): number {
      let top = -1;
      for (const i of team) if (top < 0 || p.cs[i].s * p.cs[top].q > p.cs[top].s * p.cs[i].q) top = i;
      return top;
    }
    const sumQ = (p: HrPuzzle): number => [...team].reduce((t, i) => t + p.cs[i].q, 0);
    const fits = (p: HrPuzzle, top: number): boolean => top < 0 || sumQ(p) * p.cs[top].s <= p.w * p.cs[top].q;

    function render(): void {
      const p = puzzles[pi];
      boards.forEach((b, k) => {
        b.hidden = k !== pi;
      });
      const top = topOf(p);
      const rate = top < 0 ? 0 : p.cs[top].s / p.cs[top].q;
      for (const btn of Array.from(boards[pi].querySelectorAll<HTMLElement>('[data-hr-cell]'))) {
        const i = Number((btn.dataset.hrCell ?? '').split(':')[1]);
        const on = team.has(i);
        btn.classList.toggle('on', on);
        btn.classList.toggle('top', i === top);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        const pay = btn.querySelector<HTMLElement>('[data-hr-pay]');
        if (pay) pay.textContent = on ? `ได้ ${show(p.cs[i].q * rate)}` : '';
      }
      if (top < 0) {
        ui.setScore(`ยังไม่ได้เลือกใคร งบ ${p.w}`);
        return;
      }
      const total = sumQ(p) * rate;
      ui.setScore(
        `ทีม ${team.size} คน อัตราตั้งโดยคนที่ ${top + 1} คือ ${show(rate)} ต่อหนึ่งหน่วยคุณวุฒิ ` +
          `จ่ายรวม ${show(total)} จากงบ ${p.w}${fits(p, top) ? '' : ' (เกินงบ)'}`,
      );
    }

    function toggle(i: number): void {
      if (team.has(i)) team.delete(i);
      else team.add(i);
      const p = puzzles[pi];
      ui.setStatus(fits(p, topOf(p)) ? 'ทีมนี้ยังอยู่ในงบ' : 'ทีมนี้เกินงบแล้ว ลองดูว่าใครเป็นคนดันอัตราขึ้น', fits(p, topOf(p)) ? 'plain' : 'bad');
      render();
    }

    function check(): void {
      const p = puzzles[pi];
      const top = topOf(p);
      if (team.size === 0) ui.setStatus('ยังไม่ได้เลือกใครเลยครับ', 'plain');
      else if (!fits(p, top)) ui.setStatus('ทีมนี้จ่ายไม่ไหว ค่าจ้างรวมเกินงบ', 'bad');
      else if (team.size === p.best)
        ui.setStatus(
          p.ties > 1
            ? `ได้ ${p.best} คน เต็มเพดานของชุดนี้แล้วครับ ชุดนี้มีทีมขนาดนี้ที่จ่ายไหวอยู่ ${p.ties} แบบ โจทย์ถามแค่จำนวน`
            : `ได้ ${p.best} คน เต็มเพดานของชุดนี้แล้วครับ และมีทีมขนาดนี้ที่จ่ายไหวอยู่แบบเดียว`,
          'good',
        );
      else ui.setStatus(`จ่ายไหว ได้ ${team.size} คน แต่ชุดนี้จ้างได้มากกว่านั้น`, 'plain');
    }

    function selectPuzzle(k: number): void {
      pi = k;
      team = new Set<number>();
      ui.selectTab(k);
      ui.setTease(puzzles[pi].tease);
      ui.setStatus('กดการ์ดเพื่อจ้างหรือปลดคนนั้น ตัวเลข "ได้" คือเงินที่เขาได้จริงตามกฎสัดส่วน');
      render();
    }

    ui.root.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest('[data-hr-cell]');
      if (!(btn instanceof HTMLElement)) return;
      toggle(Number((btn.dataset.hrCell ?? '').split(':')[1]));
    });

    ui.onClick('data-hr-clear', () => selectPuzzle(pi));
    ui.onClick('data-hr-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initHiringGame);
</script>

<script>
  import { initCpRowPlayers } from '../../lib/cpPlayer';

  document.addEventListener('astro:page-load', () => {
    initCpRowPlayers('[data-hrsim]');
  });
</script>
