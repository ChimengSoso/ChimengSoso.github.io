<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type RsPuzzle = { id: string; label: string; tease: string; a: number[]; p: number; q: number; pairs: [number, number][] };

  function initRangeGame(): void {
    const maybeUi = cpGameUi('[data-rsgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as RsPuzzle[];
    if (puzzles.length === 0) return;

    let pi = 0;
    let anchor = -1;
    let found = new Set<string>();

    const pz = (): RsPuzzle => puzzles[pi];
    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-rs-board]'));

    const spreadOf = (a: number[], l: number, r: number): number => {
      let mx = a[l];
      let mn = a[l];
      for (let i = l; i <= r; i++) {
        mx = Math.max(mx, a[i]);
        mn = Math.min(mn, a[i]);
      }
      return mx - mn;
    };

    function render(): void {
      const p = pz();
      boards.forEach((b, k) => {
        b.hidden = k !== pi;
      });
      for (const btn of Array.from(boards[pi].querySelectorAll<HTMLElement>('[data-rs-cell]'))) {
        const i = Number((btn.dataset.rsCell ?? '').split(':')[1]);
        btn.classList.toggle('anchor', i === anchor);
        btn.classList.remove('inrange', 'found');
      }
      ui.setScore(`หาได้แล้ว ${found.size} ช่วง จากทั้งหมด ${p.pairs.length} ช่วง`);
    }

    function highlight(l: number, r: number, cls: string): void {
      for (const btn of Array.from(boards[pi].querySelectorAll<HTMLElement>('[data-rs-cell]'))) {
        const i = Number((btn.dataset.rsCell ?? '').split(':')[1]);
        if (i >= l && i <= r) btn.classList.add(cls);
      }
    }

    function pick(i: number): void {
      const p = pz();
      if (anchor < 0) {
        anchor = i;
        ui.setStatus(`เลือกตัวที่ ${i + 1} เป็นขอบซ้ายแล้ว กดตัวขวาสุดของช่วง`, 'plain');
        render();
        return;
      }
      const l = Math.min(anchor, i);
      const r = Math.max(anchor, i);
      anchor = -1;
      const s = spreadOf(p.a, l, r);
      const key = `${l}:${r}`;
      render();
      if (s >= p.p && s <= p.q) {
        const already = found.has(key);
        found.add(key);
        highlight(l, r, 'inrange');
        ui.setScore(`หาได้แล้ว ${found.size} ช่วง จากทั้งหมด ${p.pairs.length} ช่วง`);
        ui.setStatus(
          already
            ? `ช่วงตัวที่ ${l + 1} ถึง ${r + 1} พิสัยเท่ากับ ${s} ผ่านเงื่อนไข แต่ช่วงนี้เคยหาเจอแล้ว`
            : `ช่วงตัวที่ ${l + 1} ถึง ${r + 1} พิสัยเท่ากับ ${s} ผ่านเงื่อนไข`,
          'good',
        );
      } else {
        highlight(l, r, 'found');
        ui.setStatus(`ช่วงตัวที่ ${l + 1} ถึง ${r + 1} พิสัยเท่ากับ ${s} ซึ่งอยู่นอกช่วง ${p.p} ถึง ${p.q}`, 'bad');
      }
    }

    function check(): void {
      const p = pz();
      if (found.size === p.pairs.length) ui.setStatus(`ครบแล้วครับ ชุดนี้มี ${p.pairs.length} ช่วงพอดี`, 'good');
      else ui.setStatus(`ตอนนี้ได้ ${found.size} จาก ${p.pairs.length} ช่วง ที่คนมักตกคือช่วงยาว ๆ ที่บังเอิญพิสัยยังไม่เกิน ${p.q}`, 'bad');
    }

    function selectPuzzle(k: number): void {
      pi = k;
      anchor = -1;
      found = new Set<string>();
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ui.setStatus(`ชุดนี้หาช่วงที่พิสัยอยู่ระหว่าง ${pz().p} ถึง ${pz().q} กดตัวซ้ายสุดของช่วงก่อน`);
      render();
    }

    ui.root.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const btn = e.target.closest('[data-rs-cell]');
      if (!(btn instanceof HTMLElement)) return;
      pick(Number((btn.dataset.rsCell ?? '').split(':')[1]));
    });

    ui.onClick('data-rs-clear', () => selectPuzzle(pi));
    ui.onClick('data-rs-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initRangeGame);
</script>

<script>
  import { initCpRowPlayers } from '../../lib/cpPlayer';

  document.addEventListener('astro:page-load', () => {
    initCpRowPlayers('[data-rssim]');
  });
</script>
