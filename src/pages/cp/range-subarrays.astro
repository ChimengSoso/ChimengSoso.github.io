---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

const href = 'range-subarrays/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

/** พิสัยของลำดับย่อย คือค่ามากสุดลบค่าน้อยสุด */
function spread(a: number[], l: number, r: number): number {
  let mx = a[l];
  let mn = a[l];
  for (let i = l; i <= r; i++) {
    mx = Math.max(mx, a[i]);
    mn = Math.min(mn, a[i]);
  }
  return mx - mn;
}

/** ตัวตรวจ ไล่ทุกช่วงตรง ๆ ไม่มีเทคนิคใด ๆ */
function bruteCount(a: number[], p: number, q: number): { total: number; pairs: [number, number][] } {
  const pairs: [number, number][] = [];
  for (let l = 0; l < a.length; l++)
    for (let r = l; r < a.length; r++) {
      const s = spread(a, l, r);
      if (s >= p && s <= q) pairs.push([l, r]);
    }
  return { total: pairs.length, pairs };
}

type WinStep = { r: number; l: number; mx: number; mn: number; add: number; run: number };

/** จำนวนช่วงย่อยที่พิสัยไม่เกิน x หน้าต่างเลื่อนพร้อมคิวสองอันที่เก็บค่าสูงสุดกับต่ำสุด */
function countAtMost(a: number[], x: number): { total: number; steps: WinStep[] } {
  if (x < 0) return { total: 0, steps: [] };
  const qmax: number[] = [];
  const qmin: number[] = [];
  let l = 0;
  let run = 0;
  const steps: WinStep[] = [];
  for (let r = 0; r < a.length; r++) {
    while (qmax.length && a[qmax[qmax.length - 1]] <= a[r]) qmax.pop();
    qmax.push(r);
    while (qmin.length && a[qmin[qmin.length - 1]] >= a[r]) qmin.pop();
    qmin.push(r);
    while (a[qmax[0]] - a[qmin[0]] > x) {
      if (qmax[0] === l) qmax.shift();
      if (qmin[0] === l) qmin.shift();
      l++;
    }
    const add = r - l + 1;
    run += add;
    steps.push({ r, l, mx: a[qmax[0]], mn: a[qmin[0]], add, run });
  }
  return { total: run, steps };
}

const solve = (a: number[], p: number, q: number): number => countAtMost(a, q).total - countAtMost(a, p - 1).total;

/* ด่านตรวจตอนบิลด์ ท่าที่สอนต้องตรงกับการไล่ทุกช่วง ไม่งั้นหน้านี้ไม่ขึ้น */
const SWEEP_CASES = 600;
{
  let seed = 20300909;
  const rnd = (m: number): number => {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed % m;
  };
  for (let t = 0; t < SWEEP_CASES; t++) {
    const n = 1 + rnd(11);
    const V = [2, 5, 30][rnd(3)];
    const a = Array.from({ length: n }, () => rnd(V + 1));
    const p = rnd(V + 1);
    const q = p + rnd(V + 2 - p);
    if (solve(a, p, q) !== bruteCount(a, p, q).total)
      throw new Error(`range-subarrays: ท่าหน้าต่างเลื่อนไม่ตรงกับการไล่ทุกช่วง ที่ ${JSON.stringify(a)} p=${p} q=${q}`);
  }
}

/* ---------- ตัวอย่างในโจทย์ ---------- */
const SAMPLE = [1, 7, 4, 3, 9, 6, 8];
const SAMPLE_P = 4;
const SAMPLE_Q = 6;
const SAMPLE_ANS = solve(SAMPLE, SAMPLE_P, SAMPLE_Q);
const SAMPLE_HI = countAtMost(SAMPLE, SAMPLE_Q);
const SAMPLE_LO = countAtMost(SAMPLE, SAMPLE_P - 1);
const SAMPLE_PAIRS = bruteCount(SAMPLE, SAMPLE_P, SAMPLE_Q).pairs;

/* ตัวเล่นทีละขั้น เดินขอบขวาทีละตำแหน่ง ตอนนับช่วงที่พิสัยไม่เกิน q */
const winSteps = SAMPLE_HI.steps.map((st) => ({
  note:
    `ขอบขวาอยู่ที่ตัวที่ <b>${st.r + 1}</b> ซึ่งมีค่า <b>${SAMPLE[st.r]}</b> ` +
    `หน้าต่างที่กว้างที่สุดที่ยังพิสัยไม่เกิน ${SAMPLE_Q} คือตัวที่ <b>${st.l + 1}</b> ถึง <b>${st.r + 1}</b> ` +
    `ซึ่งมีค่ามากสุด <b>${st.mx}</b> และน้อยสุด <b>${st.mn}</b> พิสัยจึงเป็น <b>${st.mx - st.mn}</b> ` +
    `ช่วงที่จบตรงนี้และใช้ได้จึงมี <b>${st.add}</b> ช่วง รวมสะสมเป็น <b>${st.run}</b>`,
}));

/* ---------- แผนภาพ สองคำถามด้านเดียวลบกัน ---------- */
type Band = { label: string; from: number; to: number; fill: string; stroke: string };
const spreads = (() => {
  const out = new Map<number, number>();
  for (let l = 0; l < SAMPLE.length; l++)
    for (let r = l; r < SAMPLE.length; r++) {
      const s = spread(SAMPLE, l, r);
      out.set(s, (out.get(s) ?? 0) + 1);
    }
  return [...out.entries()].sort((x, y) => x[0] - y[0]);
})();
const SP_MAX = spreads[spreads.length - 1][0];
const SP_X = 46;
const SP_UNIT = 62;
const SP_W = SP_X + (SP_MAX + 1) * SP_UNIT + 12;
const SP_H = 236;
const bands: Band[] = [
  { label: `พิสัยไม่เกิน ${SAMPLE_Q} มี ${SAMPLE_HI.total} ช่วง`, from: 0, to: SAMPLE_Q, fill: '#12233a', stroke: '#3d6ea5' },
  { label: `พิสัยไม่เกิน ${SAMPLE_P - 1} มี ${SAMPLE_LO.total} ช่วง`, from: 0, to: SAMPLE_P - 1, fill: '#2a1a1a', stroke: '#b23b3b' },
];

/* ---------- มินิเกม หาช่วงที่ผ่านเงื่อนไขให้ครบ ---------- */
type GamePuzzle = { id: string; label: string; tease: string; a: number[]; p: number; q: number; pairs: [number, number][] };
function makePuzzle(id: string, label: string, tease: string, a: number[], p: number, q: number): GamePuzzle {
  const brute = bruteCount(a, p, q);
  if (solve(a, p, q) !== brute.total) throw new Error(`range-subarrays: เฉลยเกม ${id} สองท่าไม่ตรงกัน`);
  return { id, label, tease, a, p, q, pairs: brute.pairs };
}
const puzzles: GamePuzzle[] = [
  makePuzzle('a', 'ลำดับ 5 ตัว พิสัย 2 ถึง 3', 'เริ่มจากชุดเล็กก่อน ให้ชินกับการนับช่วงหนึ่งช่วงว่าพิสัยเท่าไร', [4, 6, 5, 8, 7], 2, 3),
  makePuzzle('b', 'ตัวอย่างในโจทย์ พิสัย 4 ถึง 6', 'ชุดนี้มี 13 ช่วงตามที่โจทย์บอก ลองหาให้ครบก่อนไปดูเฉลย', SAMPLE, SAMPLE_P, SAMPLE_Q),
  makePuzzle('c', 'ลำดับ 8 ตัว พิสัย 0 ถึง 2', 'ขอบล่างเป็นศูนย์ แปลว่าช่วงยาวหนึ่งตัวก็นับด้วย ระวังตกไปหลายช่วง', [3, 3, 5, 4, 9, 9, 8, 2], 0, 2),
];
const puzzlesJson = JSON.stringify(puzzles);

/* ---------- บิลค่าใช้จ่าย ---------- */
const N_MAX = 1000000;
const fmt = (n: number): string => n.toLocaleString('en-US');
const bill = [
  { name: 'ไล่ทุกช่วงแล้ววัดพิสัยตรง ๆ', limit: 'N ไม่เกินราวหนึ่งพัน', work: `${fmt(N_MAX)} ยกกำลังสองหารสอง คือห้าแสนล้าน` },
  { name: 'สองคำถามด้านเดียว แต่ละคำถามใช้หน้าต่างเลื่อน', limit: `N ถึง ${fmt(N_MAX)}`, work: `ราว ${fmt(N_MAX * 4)} ครั้ง` },
];

const solution = `#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
static char buf[1 << 16]; static size_t bl = 0, bp = 0;
static inline int gc(){ if(bp == bl){ bl = fread(buf, 1, sizeof buf, stdin); bp = 0; if(!bl) return -1; } return buf[bp++]; }
static inline ll readInt(){
    int c = gc(); while(c != -1 && (c < '0' || c > '9') && c != '-') c = gc();
    int sg = 1; if(c == '-'){ sg = -1; c = gc(); }
    ll x = 0; while(c >= '0' && c <= '9'){ x = x * 10 + (c - '0'); c = gc(); }
    return x * sg;
}
int n; vector<int> a; vector<int> qmax, qmin;

// จำนวนช่วงย่อยที่พิสัยไม่เกิน x  หน้าต่างเลื่อนพร้อมคิวสองอันที่เก็บค่าสูงสุดกับต่ำสุด
ll countAtMost(ll x){
    if(x < 0) return 0;
    int hMax = 0, tMax = 0, hMin = 0, tMin = 0, l = 0; ll res = 0;
    for(int r = 0; r < n; r++){
        while(tMax > hMax && a[qmax[tMax-1]] <= a[r]) tMax--;   // คิวค่าสูงสุด ลดหลั่นลง
        qmax[tMax++] = r;
        while(tMin > hMin && a[qmin[tMin-1]] >= a[r]) tMin--;   // คิวค่าต่ำสุด ไล่ขึ้น
        qmin[tMin++] = r;
        while(a[qmax[hMax]] - a[qmin[hMin]] > x){               // กว้างเกินไป ดันขอบซ้าย
            if(qmax[hMax] == l) hMax++;
            if(qmin[hMin] == l) hMin++;
            l++;
        }
        res += r - l + 1;                                       // ช่วงที่จบที่ r และเริ่มได้ตั้งแต่ l
    }
    return res;
}

int main(){
    n = (int)readInt(); ll p = readInt(), q = readInt();
    a.resize(n); for(int i = 0; i < n; i++) a[i] = (int)readInt();
    qmax.resize(n); qmin.resize(n);
    printf("%lld\\n", countAtMost(q) - countAtMost(p - 1));
}`;

const bruteCode = `// ตัวตรวจ ไล่ทุกช่วง วัดพิสัยตรง ๆ ไม่มีเทคนิคใด ๆ
#include <bits/stdc++.h>
using namespace std;
int main(){
    long long n, p, q; scanf("%lld %lld %lld", &n, &p, &q);
    vector<long long> a(n); for(auto &x : a) scanf("%lld", &x);
    long long c = 0;
    for(int i = 0; i < n; i++){
        long long mx = a[i], mn = a[i];
        for(int j = i; j < n; j++){
            mx = max(mx, a[j]); mn = min(mn, a[j]);
            long long r = mx - mn; if(r >= p && r <= q) c++;
        }
    }
    printf("%lld\\n", c);
}`;

const coreSnippet = `// เงื่อนไขสองด้าน แปลงเป็นสองคำถามด้านเดียวที่ลบกันได้
// เพราะเซตของช่วงที่พิสัยไม่เกิน p-1 เป็นสับเซตของช่วงที่พิสัยไม่เกิน q เสมอ
printf("%lld\\n", countAtMost(q) - countAtMost(p - 1));`;
---
<CpProblemLayout href={href}>
  <h2>โจทย์ &middot; นับลำดับย่อยที่พิสัยตกอยู่ในช่วงที่กำหนด</h2>
  <p>
    ให้ลำดับจำนวนเต็ม <code>N</code> ตัว <strong>พิสัย</strong>ของลำดับย่อยคือ<strong>ค่ามากสุดลบค่าน้อยสุด</strong>
    ของลำดับย่อยนั้น งานของเราคือนับว่ามีลำดับย่อยที่<strong>ต่อเนื่องกัน</strong>กี่ชุด
    ที่พิสัยของมันอยู่ระหว่าง <code>p</code> ถึง <code>q</code>
  </p>
  <p>
    ตัวอย่างในโจทย์ใช้ลำดับ {SAMPLE.join(', ')} แล้วถามช่วงพิสัย {SAMPLE_P} ถึง {SAMPLE_Q}
    คำตอบคือ {SAMPLE_ANS} ชุด
  </p>

  <div class="callout callout-note spec">
    <p class="callout-label">อินพุต / ขอบเขต / เอาต์พุต</p>
    <ul>
      <li>
        <strong>อินพุต:</strong> บรรทัดแรกคือ <code>N</code>, <code>p</code> และ <code>q</code>
        จากนั้นอีก <code>N</code> บรรทัด บรรทัดละหนึ่งจำนวนคือสมาชิกของลำดับ
      </li>
      <li>
        <strong>ขอบเขต:</strong> <code>1 &le; N &le; {fmt(N_MAX)}</code>,
        <code>0 &le; p &le; q &le; {fmt(10000000)}</code> และสมาชิกแต่ละตัวอยู่ระหว่าง 0 ถึง {fmt(10000000)}
        เวลา 0.4 วินาที หน่วยความจำ 64 เมกะไบต์
      </li>
      <li><strong>เอาต์พุต:</strong> จำนวนลำดับย่อยที่พิสัยอยู่ในช่วง <code>[p, q]</code></li>
      <li>
        <strong>ให้คะแนน:</strong> ชุดทดสอบมูลค่าไม่เกิน 40 คะแนนมี <code>N</code> ไม่เกิน 1,000
        และมูลค่าไม่เกิน 70 คะแนนมี <code>N</code> ไม่เกิน 100,000
      </li>
    </ul>
  </div>

  <table class="io">
    <caption>EXAMPLE</caption>
    <thead><tr><th>Input</th><th>Output</th></tr></thead>
    <tbody>
      <tr>
        <td>{SAMPLE.length} {SAMPLE_P} {SAMPLE_Q}<br />{SAMPLE.map((v) => <>{v}<br /></>)}</td>
        <td>{SAMPLE_ANS}</td>
      </tr>
    </tbody>
  </table>

  <div class="callout callout-tip">
    <p class="callout-label">ใบ้</p>
    <p>
      ที่ <code>N</code> เท่ากับหนึ่งล้าน จำนวนช่วงย่อยทั้งหมดคือราว<strong>ห้าแสนล้านช่วง</strong>
      แค่ไล่ดูทีละช่วงก็ไม่ไหวแล้ว เราจึงต้องนับเป็นก้อน ไม่ใช่นับทีละอัน
    </p>
    <p>
      ลองสังเกตอย่างหนึ่ง ถ้าเราขยายช่วงให้กว้างขึ้น พิสัยของมันจะ<strong>ไม่มีวันลดลง</strong>
      คุณสมบัตินี้ใช้ได้กับเงื่อนไขแบบไหน และใช้ไม่ได้กับเงื่อนไขแบบไหน
    </p>
  </div>

  <h2>ลองเอง &middot; หาช่วงที่ผ่านเงื่อนไขให้ครบ</h2>
  <div class="cpgame rsgame" data-rsgame data-puzzles={puzzlesJson}>
    <div class="cpg-tabs" role="tablist" aria-label="เลือกชุดลำดับ">
      {puzzles.map((p, k) => (
        <button type="button" class="cpg-tab" role="tab" data-cpg-tab={String(k)} aria-selected={k === 0 ? 'true' : 'false'}>
          {p.label}
        </button>
      ))}
    </div>

    <p class="cpg-tease" data-cpg-tease>{puzzles[0].tease}</p>

    <div class="cpg-scroll">
      {puzzles.map((p, k) => (
        <div class="rs-board" data-rs-board={String(k)} hidden={k !== 0}>
          {p.a.map((v, i) => (
            <button type="button" class="rs-cell" data-rs-cell={`${k}:${i}`}>
              <span class="rs-v">{v}</span>
              <span class="rs-i">{i + 1}</span>
            </button>
          ))}
        </div>
      ))}
    </div>

    <div class="cpg-controls">
      <button type="button" class="cpg-btn" data-rs-clear>ล้างที่หาไว้</button>
      <button type="button" class="cpg-btn main" data-rs-check>ผมหาครบแล้ว</button>
    </div>

    <p class="cpg-status" data-cpg-status>กดตัวซ้ายสุดของช่วง แล้วกดตัวขวาสุด ระบบจะบอกว่าช่วงนั้นผ่านเงื่อนไขไหม</p>
    <p class="cpg-score" data-cpg-score>หาได้แล้ว 0 ช่วง</p>
    <p class="cpg-hint">ช่วงยาวหนึ่งตัวก็นับ ถ้าขอบล่างของพิสัยเป็นศูนย์ เพราะค่ามากสุดกับน้อยสุดของมันคือตัวเดียวกัน</p>
  </div>
  <p class="io-note">
    เล่นไปสักพักจะเริ่มรู้สึกว่า พอตรึงขอบขวาไว้แล้วเลื่อนขอบซ้ายออกไปทางซ้ายเรื่อย ๆ
    พิสัยจะโตขึ้นอย่างเดียว ไม่มีเล็กลง ความรู้สึกนั้นคือสิ่งที่ทั้งเฉลยยืนอยู่บนมัน
  </p>

  <h2>เฉลย ตอนที่ 1 &middot; เงื่อนไขสองด้าน แปลงเป็นสองคำถามด้านเดียว</h2>
  <Spoiler>
    <div class="callout callout-note">
      <p class="callout-label">ที่มาของแนวคิดนี้</p>
      <p>
        ผมเริ่มจากท่ามาตรฐานที่ควรลองก่อนเสมอ คือ<strong>ตรึงขอบขวาแล้วถามว่าขอบซ้ายอยู่ได้ถึงไหน</strong>
        และมันก็สะดุดทันทีตรงเงื่อนไข <code>p</code> เพราะสองด้านนี้ไม่ได้ทำงานทางเดียวกัน
        การขยายช่วงทำให้พิสัย<strong>โตขึ้นอย่างเดียว</strong> ดังนั้นเงื่อนไข "พิสัยไม่เกิน q"
        เป็นจริงบนช่วงที่แคบและพังเมื่อกว้างพอ ซึ่งใช้หน้าต่างเลื่อนได้ตรง ๆ
        แต่เงื่อนไข "พิสัยอย่างน้อย p" กลับกัน คือเป็นจริงเมื่อกว้างพอ
      </p>
      <p>
        พอสองด้านสวนทางกัน ช่วงของขอบซ้ายที่ใช้ได้จึงเป็น<strong>ช่วงตรงกลาง</strong> ซึ่งเดินตัวชี้ตัวเดียวไม่พอ
        ตรงนี้ผมมีสองทางให้เลือก คือเดินตัวชี้สองตัวพร้อมกัน หรือ<strong>แยกโจทย์ออกเป็นสองโจทย์</strong>
        แล้วลบกัน ผมเลือกทางหลังเพราะมันทำให้ผมเขียนโค้ดชุดเดียวแล้วเรียกสองครั้ง
        ซึ่งแปลว่าโอกาสพลาดลดลงครึ่งหนึ่งไปด้วย
      </p>
      <p>
        บทเรียนที่ยกไปข้ออื่นได้คือ เวลาเจอเงื่อนไขแบบ<strong>อยู่ระหว่าง</strong>
        ให้ถามทันทีว่าฟังก์ชันที่วัดอยู่มันโตทางเดียวหรือเปล่า ถ้าใช่
