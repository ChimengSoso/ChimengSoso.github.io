/* ------------------------------------------------------------------
   โมเดลกลาง ตัวเลขทุกตัวในหน้านี้งอกจากตรงนี้ ไม่มีที่ไหนพิมพ์มือ
   ------------------------------------------------------------------ */
const demo = [1, 2, 3, 1, 3];
const N = demo.length;

/** กติกาของบทนี้: จานสองใบซ้อนกันได้ถ้าขนาดต่างกันไม่เกิน 1 */
function canPair(x: number, y: number): boolean {
  return Math.abs(x - y) <= 1;
}

/** keep[i][j] = ยกออกได้มากที่สุดกี่ใบ ถ้ามองเฉพาะช่วง [i..j] */
function keepTable(a: number[]): number[][] {
  const n = a.length;
  const keep: number[][] = Array.from({ length: n }, () => new Array<number>(n).fill(0));
  const K = (i: number, j: number): number => (i > j ? 0 : keep[i][j]);
  const cleared = (i: number, j: number): boolean => i > j || keep[i][j] === j - i + 1;
  for (let len = 2; len <= n; len++) {
    for (let i = 0; i + len - 1 < n; i++) {
      const j = i + len - 1;
      let best = K(i + 1, j);
      for (let k = i + 1; k <= j; k++) {
        if (!canPair(a[i], a[k])) continue;
        if (!cleared(i + 1, k - 1)) continue;
        best = Math.max(best, k - i + 1 + K(k + 1, j));
      }
      keep[i][j] = best;
    }
  }
  return keep;
}

/** ท่าโลภที่ทุกคนลองก่อน: กวาดซ้ายไปขวา เจอคู่ที่ซ้อนได้ก็ซ้อนทันที */
function greedyLeft(a: number[]): number[] {
  const st: number[] = [];
  for (const x of a) {
    if (st.length > 0 && canPair(st[st.length - 1], x)) st.pop();
    else st.push(x);
  }
  return st;
}

const keep = keepTable(demo);
const bestRemoved = keep[0][N - 1];
const bestLeft = N - bestRemoved;
const greedyLeftover = greedyLeft(demo);
const greedyLeft2 = greedyLeftover.length;

/* ------------------------------------------------------------------
   ขั้นตอนของตัวเล่นตาราง หนึ่งขั้นต่อหนึ่งช่อง เรียงตามความยาวช่วง
   ------------------------------------------------------------------ */
type Src = { i: number; j: number; ok: boolean };
type SimStep = {
  cells: (string | null)[][];
  ti: number;
  tj: number;
  srcs: Src[];
  html: string;
};

function buildSteps(a: number[]): SimStep[] {
  const n = a.length;
  const keepLocal: number[][] = Array.from({ length: n }, () => new Array<number>(n).fill(0));
  const shown: (string | null)[][] = Array.from({ length: n }, () => new Array<string | null>(n).fill(null));
  const K = (i: number, j: number): number => (i > j ? 0 : keepLocal[i][j]);
  const cleared = (i: number, j: number): boolean => i > j || keepLocal[i][j] === j - i + 1;
  const snap = (): (string | null)[][] => shown.map((r) => [...r]);
  const out: SimStep[] = [];

  for (let i = 0; i < n; i++) shown[i][i] = '0';
  out.push({
    cells: snap(),
    ti: -1,
    tj: -1,
    srcs: [],
    html:
      '<p class="dps-q">เริ่มจากช่วงสั้นที่สุด</p>' +
      '<ul class="dps-cands"><li class="ok win">ช่วงยาว 1 ใบ ยกออกไม่ได้เลยเพราะไม่มีคู่ ทุกช่องบนเส้นทแยงมุมจึงเป็น <b>0</b></li>' +
      '<li class="no">ช่องใต้เส้นทแยงมุมไม่มีความหมาย เพราะ <code>i</code> ต้องไม่เกิน <code>j</code></li></ul>' +
      '<p class="dps-a">จากนี้ไปเติมช่วงยาว 2 ใบ แล้วยาว 3 ใบ ไล่ขึ้นไปเรื่อย ๆ</p>',
  });

  for (let len = 2; len <= n; len++) {
    for (let i = 0; i + len - 1 < n; i++) {
      const j = i + len - 1;
      const lines: string[] = [];
      const srcs: Src[] = [];

      const skipVal = K(i + 1, j);
      type Cand = { val: number; srcs: Src[]; text: string };
      const cands: Cand[] = [
        {
          val: skipVal,
          srcs: i + 1 <= j ? [{ i: i + 1, j, ok: false }] : [],
          text: `ทิ้งจานใบที่ ${i + 1} ไว้บนโต๊ะ แล้วรับค่าจากช่วง [${i + 1}..${j}] มาทั้งดุ้น ได้ <b>${skipVal}</b>`,
        },
      ];

      for (let k = i + 1; k <= j; k++) {
        if (!canPair(a[i], a[k])) {
          lines.push(
            `<li class="no">จับคู่กับใบที่ ${k + 1} (ขนาด ${a[k]}) ไม่ได้ ขนาดต่างกัน ${Math.abs(a[i] - a[k])}</li>`,
          );
          continue;
        }
        if (!cleared(i + 1, k - 1)) {
          lines.push(
            `<li class="no">จับคู่กับใบที่ ${k + 1} ได้ตามขนาด แต่ของที่ขวางอยู่ตรงกลาง คือช่วง [${i + 1}..${k - 1}] ยกออกไม่เกลี้ยง สองใบนี้จึงไม่มีวันได้มาชนกัน</li>`,
          );
          continue;
        }
        const val = k - i + 1 + K(k + 1, j);
        const s: Src[] = [];
        if (i + 1 <= k - 1) s.push({ i: i + 1, j: k - 1, ok: false });
        if (k + 1 <= j) s.push({ i: k + 1, j, ok: false });
        cands.push({
          val,
          srcs: s,
          text:
            `จับคู่ใบที่ ${i + 1} กับใบที่ ${k + 1} (ขนาด ${a[i]} กับ ${a[k]}) ` +
            (i + 1 <= k - 1 ? `ของตรงกลางช่วง [${i + 1}..${k - 1}] เกลี้ยงพอดี ` : 'ไม่มีอะไรขวางตรงกลาง ') +
            `ได้ ${k - i + 1} ใบ บวกกับช่วงที่เหลือ [${k + 1}..${j}] อีก ${K(k + 1, j)} ใบ รวม <b>${val}</b>`,
        });
      }

      let best = -1;
      for (const c of cands) best = Math.max(best, c.val);
      let taken = false;
      const ordered: string[] = [];
      for (const c of cands) {
        const win = !taken && c.val === best;
        if (win) taken = true;
        for (const s of c.srcs) srcs.push({ ...s, ok: win });
        ordered.push(`<li class="${win ? 'ok win' : 'ok'}">${c.text}${win ? ' ทางนี้ดีที่สุด' : ''}</li>`);
      }

      keepLocal[i][j] = best;
      shown[i][j] = String(best);

      out.push({
        cells: snap(),
        ti: i,
        tj: j,
        srcs,
        html:
          `<p class="dps-q">ช่วงยาว ${len} ใบ · เติมช่อง <b>keep[${i}][${j}]</b> คือช่วง [${i}..${j}] ซึ่งก็คือจาน ${a
            .slice(i, j + 1)
            .join(' ')}</p>` +
          `<ul class="dps-cands">${ordered.join('')}${lines.join('')}</ul>` +
          `<p class="dps-a">ค่าของช่องนี้คือ <b>${best}</b> ใบ</p>`,
      });
    }
  }

  out.push({
    cells: snap(),
    ti: 0,
    tj: n - 1,
    srcs: [],
    html:
      `<p class="dps-q">ตารางเต็มแล้ว คำตอบอยู่ที่ช่องมุมขวาบน</p>` +
      `<ul class="dps-cands"><li class="ok win"><b>keep[0][${n - 1}] = ${keepLocal[0][n - 1]}</b> คือยกออกได้ ${keepLocal[0][n - 1]} ใบจากทั้งหมด ${n} ใบ</li>` +
      `<li class="ok">เหลือบนโต๊ะ ${n} − ${keepLocal[0][n - 1]} = <b>${n - keepLocal[0][n - 1]}</b> ใบ</li>` +
      `<li class="no">ช่องอื่นในตารางไม่ใช่คำตอบของทั้งแถว มันคือคำตอบของช่วงย่อยที่เราต้องใช้ระหว่างทางเท่านั้น</li></ul>` +
      `<p class="dps-a">ทุกช่องถูกเติมครั้งเดียว และไม่มีใครกลับไปแก้มันอีก</p>`,
  });

  return out;
}

const simSteps = buildSteps(demo);

/* ------------------------------------------------------------------
   แถวของมินิเกม เลขคำตอบเป็นค่าคงที่ ไม่ได้ส่งตัวแก้ไปหน้าเว็บ
   (ตรวจแล้วด้วยตัวไล่ทุกความเป็นไปได้ ตอนเตรียมบทความ)
