            int j = i + len - 1;
            dp[i][j] = INF;
            for (int k = i; k < j; k++)
                dp[i][j] = min(dp[i][j], dp[i][k] + dp[k + 1][j] + sum(i, j));
        }
    printf("%lld\\n", n == 0 ? 0 : dp[1][n]);
    return 0;
}`;
