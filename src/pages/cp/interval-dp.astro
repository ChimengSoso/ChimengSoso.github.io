    border-top:1px solid var(--dl-border);
  }

  /* .ns-cue อยู่ที่ CpProblemLayout แล้ว หน้านี้ตั้งใจใช้สีเขียว จึงติดคลาสเสริมในมาร์กอัปแทน */
  /* margin ย่อที่มี 0 สองข้างจะทับ margin-left/right:auto ของกฎจัดกลาง 46rem ในเลย์เอาต์
     เคยทำให้ก้อนนี้เยื้องซ้ายจากย่อหน้าข้างบน 98px */
  p.pull{
    margin:1.4rem auto;
    padding:0.85rem 1.1rem;
    border-left:3px solid var(--dl-emerald);
    background:rgba(47,158,92,0.07);
    border-radius:0 10px 10px 0;
    font-size:0.95rem;
    line-height:1.75;
  }

  @media (prefers-reduced-motion: reduce){
    .dpsim td.num,
    .pg-table :global(.pg-plate){transition:none;}
    .pg-table :global(.pg-plate.is-gone){opacity:0;transform:none;}
  }
</style>

<script>
  /* ---------------- ตัวเล่นตาราง keep[i][j] ---------------- */
  type Src = { i: number; j: number; ok: boolean };
  type SimStep = {
    cells: (string | null)[][];
    ti: number;
    tj: number;
    srcs: Src[];
    html: string;
  };

  const STEP_MS = 1500;

  function initIvSim(root: HTMLElement): void {
    if (root.dataset.wired === '1') return;
    root.dataset.wired = '1';

    const raw: unknown = JSON.parse(root.dataset.steps ?? '[]');
    if (!Array.isArray(raw) || raw.length === 0) return;
    const steps = raw as SimStep[];

    const say = root.querySelector<HTMLElement>('.dps-say');
    const range = root.querySelector<HTMLInputElement>('.dps-range');
    const count = root.querySelector<HTMLElement>('.dps-count');
    const scroller = root.querySelector<HTMLElement>('.dps-scroll');
    const playBtn = root.querySelector<HTMLButtonElement>('.dps-play');
    if (!say || !range || !count || !playBtn) return;

    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('.dps-b'));
    const cells = Array.from(root.querySelectorAll<HTMLTableCellElement>('td.num[data-i]'));
    range.max = String(steps.length - 1);

    let at = 0;
    let timer: number | null = null;

    const keepInView = (cell: HTMLElement | null): void => {
      if (!cell || !scroller) return;
      if (scroller.scrollWidth <= scroller.clientWidth) return;
      const box = scroller.getBoundingClientRect();
      const c = cell.getBoundingClientRect();
      const pad = 16;
      let delta = 0;
      if (c.left < box.left + pad) delta = c.left - box.left - pad;
      else if (c.right > box.right - pad) delta = c.right - box.right + pad;
      if (delta !== 0) scroller.scrollLeft += delta;
    };

    const render = (): void => {
      const st = steps[at];
      const last = at === steps.length - 1;
      let focus: HTMLElement | null = null;
      const srcMap = new Map<string, boolean>();
      for (const s of st.srcs) srcMap.set(`${s.i},${s.j}`, s.ok);

      for (const cell of cells) {
        const i = Number(cell.dataset.i);
        const j = Number(cell.dataset.j);
        if (j < i) {
          cell.className = 'num ivdead';
          cell.textContent = '';
          continue;
        }
        cell.className = 'num';
        cell.textContent = st.cells[i]?.[j] ?? '';
        const src = srcMap.get(`${i},${j}`);
        if (src === true) cell.classList.add('is-src');
        else if (src === false) cell.classList.add('is-weak');
        if (i === st.ti && j === st.tj) {
          cell.classList.add(last ? 'is-answer' : 'is-target');
          focus = cell;
        }
      }

      say.innerHTML = st.html;
      range.value = String(at);
      count.textContent = `ขั้น ${at} / ${steps.length - 1}`;
      for (const b of btns) {
        const act = b.dataset.act;
        if (act === 'prev' || act === 'first') b.disabled = at === 0;
        if (act === 'next' || act === 'last') b.disabled = last;
      }
      keepInView(focus);
    };

    const stop = (): void => {
      if (timer !== null) window.clearInterval(timer);
      timer = null;
      playBtn.textContent = 'เล่น';
    };

    const go = (to: number): void => {
      at = Math.max(0, Math.min(steps.length - 1, to));
      if (at === steps.length - 1) stop();
      render();
    };

    for (const b of btns) {
      b.addEventListener('click', () => {
        const act = b.dataset.act;
        if (act === 'play') {
          if (timer !== null) {
            stop();
            return;
          }
          if (at === steps.length - 1) at = 0;
          playBtn.textContent = 'หยุด';
          timer = window.setInterval(() => go(at + 1), STEP_MS);
          go(at + 1);
          return;
        }
        stop();
        if (act === 'first') go(0);
        else if (act === 'prev') go(at - 1);
        else if (act === 'next') go(at + 1);
        else if (act === 'last') go(steps.length - 1);
      });
    }

    range.addEventListener('input', () => {
      stop();
      go(Number(range.value));
    });

    root.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') {
        stop();
        go(at + 1);
        e.preventDefault();
      } else if (e.key === 'ArrowLeft') {
        stop();
        go(at - 1);
        e.preventDefault();
      }
    });

    document.addEventListener('astro:before-swap', stop, { once: true });
    render();
  }

  /* ---------------- มินิเกมโต๊ะจาน ---------------- */
  type GameRow = { name: string; plates: number[]; bestLeft: number; greedyLeft: number };

  const ROWS: GameRow[] = [
    { name: 'แถว A', plates: [3, 1, 4, 4, 1, 3], bestLeft: 0, greedyLeft: 0 },
    { name: 'แถว B', plates: [1, 2, 3, 1], bestLeft: 0, greedyLeft: 2 },
    { name: 'แถว C', plates: [1, 6, 2, 3, 3, 1, 6, 1], bestLeft: 0, greedyLeft: 6 },
    { name: 'แถว D', plates: [2, 5, 3, 3, 6, 5, 2], bestLeft: 3, greedyLeft: 3 },
  ];

  function initPlateGame(root: HTMLElement): void {
    if (root.dataset.wired === '1') return;
    root.dataset.wired = '1';

    const table = root.querySelector<HTMLElement>('[data-table]');
    const leftOut = root.querySelector<HTMLElement>('[data-left]');
    const bestOut = root.querySelector<HTMLElement>('[data-best]');
    const movesOut = root.querySelector<HTMLElement>('[data-moves]');
    const log = root.querySelector<HTMLElement>('[data-log]');
    const undoBtn = root.querySelector<HTMLButtonElement>('[data-undo]');
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]');
    if (!table || !leftOut || !bestOut || !movesOut || !log || !undoBtn || !resetBtn) return;

    const rowBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.pg-row'));

    let rowAt = 0;
    let plates: { size: number; id: number }[] = [];
    let history: { size: number; id: number }[][] = [];
    let picked: number | null = null;
    let moves = 0;

    const say = (html: string): void => {
      log.innerHTML = html;
    };

    const paint = (): void => {
      table.replaceChildren();
      plates.forEach((p, idx) => {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'pg-plate';
        if (picked === idx) btn.classList.add('is-picked');
        else if (picked !== null && Math.abs(idx - picked) === 1 && Math.abs(plates[idx].size - plates[picked].size) <= 1) {
          btn.classList.add('is-ready');
        }
        btn.setAttribute('aria-label', `จานใบที่ ${idx + 1} ขนาด ${p.size} นิ้ว`);
        const size = document.createElement('span');
        size.className = 'pg-size';
        size.textContent = String(p.size);
        const num = document.createElement('span');
        num.className = 'pg-idx';
        num.textContent = String(idx + 1);
        btn.append(size, num);
        btn.addEventListener('click', () => tap(idx));
        li.append(btn);
        table.append(li);
      });
      leftOut.textContent = String(plates.length);
      movesOut.textContent = String(moves);
      undoBtn.disabled = history.length === 0;
    };

    const finishCheck = (): void => {
      const goal = ROWS[rowAt].bestLeft;
      const anyLeft = plates.some((_, i) => i + 1 < plates.length && Math.abs(plates[i].size - plates[i + 1].size) <= 1);
      if (plates.length === goal) {
        say('<span class="pg-win">ถึงคำตอบที่ดีที่สุดแล้วครับ</span> ลองแถวอื่นต่อได้เลย');
      } else if (!anyLeft) {
        say(
          `ตันแล้ว เหลือ <b>${plates.length}</b> ใบ แต่ที่ดีที่สุดคือ <b>${goal}</b> ใบ ` +
            '<span class="pg-no">ลองย้อนกลับไปดูว่าคู่ไหนที่ไม่ควรรีบยก</span>',
        );
      }
    };

    const tap = (idx: number): void => {
      if (picked === null) {
        picked = idx;
        say(`เลือกจานใบที่ ${idx + 1} (ขนาด ${plates[idx].size}) แล้ว กดใบที่อยู่ติดกันเพื่อยกทั้งคู่`);
        paint();
        return;
      }
      if (picked === idx) {
        picked = null;
        say('ยกเลิกการเลือกแล้ว');
        paint();
        return;
      }
      if (Math.abs(idx - picked) !== 1) {
        picked = idx;
        say(`สองใบนั้นไม่ได้อยู่ติดกัน เปลี่ยนไปเลือกใบที่ ${idx + 1} แทน`);
        paint();
        return;
      }
      const a = plates[Math.min(idx, picked)];
      const b = plates[Math.max(idx, picked)];
      if (Math.abs(a.size - b.size) > 1) {
        say(`<span class="pg-no">ขนาด ${a.size} กับ ${b.size} ต่างกัน ${Math.abs(a.size - b.size)} นิ้ว ซ้อนกันไม่ได้</span>`);
        picked = idx;
        paint();
        return;
      }
      const lo = Math.min(idx, picked);
      history.push(plates.map((p) => ({ ...p })));
      plates.splice(lo, 2);
      picked = null;
      moves += 1;
      say(`ยกจานขนาด ${a.size} กับ ${b.size} เข้าตู้แล้ว`);
      paint();
      finishCheck();
    };

    const load = (i: number): void => {
      rowAt = i;
      plates = ROWS[i].plates.map((size, id) => ({ size, id }));
      history = [];
      picked = null;
      moves = 0;
      bestOut.textContent = String(ROWS[i].bestLeft);
      say('กดจานใบหนึ่งเพื่อเลือก แล้วกดใบที่อยู่ติดกันเพื่อยกทั้งคู่');
      rowBtns.forEach((b, k) => b.classList.toggle('is-on', k === i));
      paint();
    };

    rowBtns.forEach((b, i) => b.addEventListener('click', () => load(i)));
    resetBtn.addEventListener('click', () => load(rowAt));
    undoBtn.addEventListener('click', () => {
      const prev = history.pop();
      if (!prev) return;
      plates = prev;
      picked = null;
      moves = Math.max(0, moves - 1);
      say('ย้อนกลับมาหนึ่งตาแล้ว');
      paint();
    });

    load(0);
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-ivsim]').forEach(initIvSim);
    document.querySelectorAll<HTMLElement>('[data-plategame]').forEach(initPlateGame);
  });
</script>
