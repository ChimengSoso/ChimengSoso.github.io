/* ---------- ข้อ 1: ยกคู่ที่ค่าเท่ากันเป๊ะออก แล้วช่องปิด ---------- */
const exA = [4, 1, 1, 2, 3, 3, 2, 5];
/** ท่าสแต็ก: เจอตัวที่เท่ากับตัวบนสุดก็ยกออกทั้งคู่ */
function exaStack(a: number[]): number[] {
  const st: number[] = [];
  for (const x of a) {
    if (st.length > 0 && st[st.length - 1] === x) st.pop();
    else st.push(x);
  }
  return st;
}
/** ตัวตรวจอิสระ: ไล่ทุกลำดับการยกที่เป็นไปได้ ไม่ได้ใช้สแต็กเลย */
function exaBrute(a: number[]): number {
  const seen = new Set<string>();
  let best = a.length;
  const rec = (cur: number[]): void => {
    const key = cur.join(',');
    if (seen.has(key)) return;
    seen.add(key);
    best = Math.min(best, cur.length);
    for (let i = 0; i + 1 < cur.length; i++)
      if (cur[i] === cur[i + 1]) rec([...cur.slice(0, i), ...cur.slice(i + 2)]);
  };
  rec(a);
  return best;
}
/** ลำดับการยกทีละคู่ ใช้วาดภาพลูกโซ่ */
type ExaStep = { before: number[]; at: number; value: number };
const exaSteps: ExaStep[] = (() => {
  const out: ExaStep[] = [];
  let cur = [...exA];
  for (;;) {
    const at = cur.findIndex((v, i) => i + 1 < cur.length && cur[i + 1] === v);
    if (at === -1) break;
    out.push({ before: [...cur], at, value: cur[at] });
    cur = [...cur.slice(0, at), ...cur.slice(at + 2)];
  }
  return out;
})();
const exaFinal = exaStack(exA);
const exaAnswer = exaFinal.length;
if (exaAnswer !== exaBrute(exA)) throw new Error('interval-dp: ตัวอย่างข้อ 1 ท่าสแต็กไม่ตรงกับตัวไล่ทุกทาง');

/* ---------- ข้อ 2: เติมวงเล็บให้ครบ ---------- */
const exB = '())(';
/** เดินซ้ายไปขวา นับตัวเปิดที่ยังไม่มีคู่ ตัวปิดที่หาคู่ไม่ได้ต้องเติมตัวเปิดให้ */
type ExbStep = { ch: string; open: number; needOpen: boolean };
const exbSteps: ExbStep[] = (() => {
  const out: ExbStep[] = [];
  let open = 0;
  for (const ch of exB) {
    if (ch === '(') open++;
    else if (open > 0) open--;
    else {
      out.push({ ch, open, needOpen: true });
