function exbBrute(src: string, cap: number): number {
  const ok = (t: string): boolean => {
    let d = 0;
    for (const c of t) {
      d += c === '(' ? 1 : -1;
      if (d < 0) return false;
    }
    return d === 0;
  };
  for (let k = 0; k <= cap; k++) {
    const rec = (t: string, left: number): boolean => {
      if (left === 0) return ok(t);
      for (let pos = 0; pos <= t.length; pos++)
        for (const c of ['(', ')'])
          if (rec(t.slice(0, pos) + c + t.slice(pos), left - 1)) return true;
      return false;
    };
    if (rec(src, k)) return k;
  }
  return cap + 1;
