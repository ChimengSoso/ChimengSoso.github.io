/* ------------------------------------------------------------------
   สูตร
   ------------------------------------------------------------------ */
const KEEP = mc.fn('keep');
const recurrenceTex = texCode(
  KEEP + '[i][j] \\;' + mc.op('=') + '\\; ' + mc.max + '_{k} \\begin{cases} ' +
