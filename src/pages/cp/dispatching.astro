    caption-side:top;
    text-align:left;
    font-family:"Fira Code","Fira Mono",monospace;
    font-weight:700;
    letter-spacing:0.18em;
    font-size:0.68rem;
    color:var(--dl-gold);
    background:#070c17;
    padding:0.5rem 0.85rem;
    border-bottom:1px solid var(--dl-border);
    white-space:nowrap;
  }
  table.rec th, table.rec td{
    padding:0.5rem 0.8rem;
    text-align:left;
    vertical-align:middle;
    border-bottom:1px solid var(--dl-border);
  }
  table.rec th + th, table.rec td + td{border-left:1px solid var(--dl-border);}
  table.rec tbody tr:last-child td{border-bottom:none;}
  table.rec th{
    background:#141b2b;
    color:var(--dl-muted);
    font-weight:600;
    font-size:0.68rem;
    letter-spacing:0.1em;
    text-transform:uppercase;
    white-space:nowrap;
  }
  table.rec td{color:var(--dl-ink);line-height:1.55;white-space:nowrap;}
  table.rec td.num{
    text-align:right;
    font-family:"Fira Code","Fira Mono",monospace;
    font-variant-numeric:tabular-nums;
    white-space:nowrap;
    color:#cdd6ea;
  }
  table.rec th.num{text-align:right;}
  /* ต้องมี .num ในตัวเลือกด้วย ไม่งั้นแพ้ table.rec td.num ที่ตั้งสีไว้แล้ว */
  table.rec tbody tr.hit td{background:#163a2a;}
  table.rec tbody tr.hit td.num{color:#eaf2ff;font-weight:700;}

  /* ตารางบิลมีสี่คอลัมน์ที่ข้อความไทยยาว ถ้าปล่อย nowrap ไว้ทุกช่อง ตารางจะกว้างจนชนเพดาน 66rem
     แล้วการ์ด (body .panel{width:fit-content}) โตตามไปจนสุดจอ อ่านได้เป็น "บทความกว้างเกินไป"
     จึงยอมให้คอลัมน์ข้อความตัดบรรทัด ส่วนคอลัมน์ตัวเลขยังคง nowrap เพื่อไม่ให้เลขแตกกลางตัว */
  table.rec.dsp-bill{table-layout:fixed;}
  table.rec.dsp-bill th, table.rec.dsp-bill td{white-space:normal;}
  table.rec.dsp-bill th.num, table.rec.dsp-bill td.num{white-space:normal;}
  table.rec.dsp-bill th:first-child, table.rec.dsp-bill td:first-child{width:15rem;}
  table.rec.dsp-bill th:nth-child(2), table.rec.dsp-bill td:nth-child(2),
  table.rec.dsp-bill th:nth-child(3), table.rec.dsp-bill td:nth-child(3){width:8.5rem;}
  table.rec.dsp-bill th:last-child, table.rec.dsp-bill td:last-child{width:11rem;}

  /* ---------- กระดานของมินิเกม เป็น SVG ที่เขียนไว้ในเทมเพลต สไตล์แบบสโคปจึงใช้ได้ตรง ๆ ---------- */
  .dsp-slot{display:block;}
  .dsp-board{display:block;margin:0 auto;width:100%;height:auto;}
  /* จอแคบห้ามให้กระดานหดจนตัวอักษรเล็กจนอ่านไม่ออก ปล่อยให้ล้นแล้ว .cpg-scroll เลื่อนแทน
     ตัวห่อต้องกว้างตามกระดานด้วย ไม่งั้นความกว้างที่ล้นไม่ไปถึงกล่องที่เลื่อนได้ */
  @media (max-width:640px){
    .dsp-slot{min-width:500px;}
    .dsp-board{min-width:500px;}
  }
  .dsp-edge{stroke:#2a3350;stroke-width:1.5;}
  .dsp-node{cursor:pointer;}
  .dsp-node rect{fill:#121a2b;stroke:#2a3350;stroke-width:1;transition:fill 0.15s ease, stroke 0.15s ease;}
  .dsp-node .dsp-t1{fill:#eaf2ff;font-size:12px;}
  .dsp-node .dsp-t2{fill:#cdd6ea;font-size:11px;font-family:"Fira Code","Fira Mono",monospace;}
  .dsp-node .dsp-t3{fill:#9aa7bd;font-size:11px;font-family:"Fira Code","Fira Mono",monospace;}
  .dsp-node:focus{outline:none;}
  .dsp-node:focus-visible rect{stroke:#7fd1a6;stroke-width:2;}
  .dsp-node.is-out rect{fill:#0d121d;stroke:#1b2233;}
  .dsp-node.is-out .dsp-t1{fill:#5b6580;}
  .dsp-node.is-out .dsp-t2, .dsp-node.is-out .dsp-t3{fill:#4a5468;}
  .dsp-node.is-sent rect{fill:#163a2a;stroke:#2f9e5c;}
  .dsp-node.is-mgr rect{stroke:#d4a73c;stroke-width:2;}
  .dsp-node.is-over rect{stroke:#b23b3b;stroke-width:2;}
  @media (prefers-reduced-motion: reduce){
    .dsp-node rect{transition:none;}
  }
</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type DspPuzzle = {
    id: string;
    label: string;
    tease: string;
    n: number;
    M: number;
    par: number[];
    cost: number[];
    lead: number[];
    answer: number;
  };

  function initDispatchingGame(): void {
    const maybeUi = cpGameUi('[data-dspgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่ เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as DspPuzzle[];
    /* ตัวห่อเป็น div เพราะ svg ไม่มีแอตทริบิวต์ hidden ทั้งฝั่งชนิดของ Astro และฝั่ง DOM */
    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-dsp-board]'));
    if (puzzles.length === 0 || boards.length !== puzzles.length) return;

    let pi = 0;
    let mgr = 0;
    let pickingMgr = true;
    let sends = 0;
    const sent = new Set<number>();

    const pz = (): DspPuzzle => puzzles[pi];
    const board = (): HTMLElement => boards[pi];

    /** v อยู่ใต้บังคับบัญชาของ m ไหม เดินขึ้นไปตามสายหัวหน้า */
    function under(p: DspPuzzle, v: number, m: number): boolean {
      let u = v;
      while (u !== 0 && u !== m) u = p.par[u];
      return u === m;
    }

    function spend(): number {
      const p = pz();
      let s = 0;
      sent.forEach((v) => {
        s += p.cost[v];
      });
      return s;
    }

    function render(): void {
      const p = pz();
      const over = spend() > p.M;
      boards.forEach((b, k) => {
        b.hidden = k !== pi;
      });
      board().querySelectorAll<SVGGElement>('[data-dsp-id]').forEach((g) => {
        const id = Number(g.dataset.dspId);
        const cls = ['dsp-node'];
        if (mgr !== 0 && !under(p, id, mgr)) cls.push('is-out');
        if (sent.has(id)) cls.push(over ? 'is-over' : 'is-sent');
        if (id === mgr) cls.push('is-mgr');
        g.setAttribute('class', cls.join(' '));
      });
      if (mgr === 0) {
        ui.setScore('ยังไม่ได้เลือกผู้จัดการ');
        return;
      }
      const score = sent.size * p.lead[mgr];
      ui.setScore(
        `ผู้จัดการ นินจา ${mgr} (ผู้นำ ${p.lead[mgr]}) · ค่าจ้างรวม ${spend()} จากงบ ${p.M} · ส่งไป ${sent.size} คน · คะแนน ${sent.size} x ${p.lead[mgr]} = ${score}`,
      );
    }

    function tapNode(id: number): void {
      const p = pz();
      if (pickingMgr) {
        mgr = id;
        pickingMgr = false;
        sent.clear();
        render();
        ui.setStatus(`ผู้จัดการคือนินจา ${id} ความเป็นผู้นำ ${p.lead[id]} ทีนี้แตะคนที่จะส่งไป เลือกได้เฉพาะคนที่เขาสั่งถึง`, 'good');
        return;
      }
      if (mgr === 0) return;
      if (!under(p, id, mgr)) {
        ui.setStatus(`นินจา ${id} ไม่ได้อยู่ใต้บังคับบัญชาของนินจา ${mgr} คำสั่งส่งไปไม่ถึง`, 'bad');
        return;
      }
      if (sent.has(id)) {
        sent.delete(id);
        render();
        ui.setStatus(`ถอนนินจา ${id} ออกจากทีมแล้ว เหลือค่าจ้างรวม ${spend()}`);
        return;
      }
      sent.add(id);
      render();
      if (spend() > p.M) {
        ui.setStatus(`ใส่นินจา ${id} แล้วค่าจ้างรวมเป็น ${spend()} ซึ่งเกินงบ ${p.M} ต้องถอนใครสักคนออก`, 'bad');
        return;
      }
      ui.setStatus(`ส่งนินจา ${id} ค่าจ้าง ${p.cost[id]} รวมจ่ายไป ${spend()} จาก ${p.M}`);
    }

    function check(): void {
      const p = pz();
      if (mgr === 0) {
        ui.setStatus('ยังไม่ได้เลือกผู้จัดการเลย แตะนินจาสักคนก่อน', 'bad');
        return;
      }
      sends++;
      const cost = spend();
      if (cost > p.M) {
        ui.setStatus(`ส่งไม่ได้ ค่าจ้างรวม ${cost} เกินงบ ${p.M} อยู่ ${cost - p.M}`, 'bad');
        return;
      }
      const score = sent.size * p.lead[mgr];
      if (score === p.answer) {
        ui.setStatus(`ตรงคำตอบครับ ${sent.size} คน คูณผู้นำ ${p.lead[mgr]} เท่ากับ ${score} ซึ่งเป็นค่ามากที่สุดของชุดนี้ (ส่งไปแล้ว ${sends} ครั้ง)`, 'good');
        return;
      }
      ui.setStatus(`ชุดนี้ได้ ${score} ซึ่งยังไม่ใช่ค่ามากที่สุด ยังมีวิธีที่ได้ ${p.answer} ลองเปลี่ยนผู้จัดการหรือเปลี่ยนคนที่ส่งดู`, 'bad');
    }

    function resetPuzzle(k: number): void {
      pi = k;
      mgr = 0;
      pickingMgr = true;
      sends = 0;
      sent.clear();
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ui.setStatus('แตะนินจาที่จะให้เป็นผู้จัดการก่อน');
      render();
    }

    function nodeFrom(target: EventTarget | null): number {
      if (!(target instanceof Element)) return 0;
      const g = target.closest('[data-dsp-id]');
      if (!(g instanceof SVGGElement)) return 0;
      return Number(g.dataset.dspId);
    }

    boards.forEach((b) => {
      b.addEventListener('click', (e: MouseEvent) => {
        const id = nodeFrom(e.target);
        if (id > 0) tapNode(id);
      });
      b.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const id = nodeFrom(e.target);
        if (id === 0) return;
        e.preventDefault();
        tapNode(id);
      });
    });

    ui.onClick('data-dsp-mgr', () => {
      pickingMgr = true;
      mgr = 0;
      sent.clear();
      render();
      ui.setStatus('แตะนินจาที่จะให้เป็นผู้จัดการ');
    });
    ui.onClick('data-dsp-check', check);
    ui.onClick('data-dsp-clear', () => {
      sent.clear();
      render();
      ui.setStatus(mgr === 0 ? 'แตะนินจาที่จะให้เป็นผู้จัดการก่อน' : 'ล้างทีมแล้ว ผู้จัดการยังเป็นคนเดิม');
    });
    ui.onTab(resetPuzzle);
    resetPuzzle(0);
  }

  document.addEventListener('astro:page-load', initDispatchingGame);
</script>
