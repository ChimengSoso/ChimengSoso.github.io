import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

const href = 'dispatching/';

/* ---------- โมเดลของโจทย์ ตัวเลขทุกตัวในหน้านี้งอกจากตรงนี้ ---------- */

/** หนึ่งกรณีทดสอบ อาเรย์ทุกตัวใช้ดัชนี 1..n ช่อง 0 เป็นตัวหลอก */
type Inst = { n: number; M: number; par: number[]; cost: number[]; lead: number[] };

/** รายชื่อนินจาที่อยู่ใต้บังคับบัญชาของ m รวมตัว m เอง เดินขึ้นไปตามสายหัวหน้า ไม่ใช้ Euler tour */
function subtreeOf(inst: Inst, m: number): number[] {
  const out: number[] = [];
  for (let v = 1; v <= inst.n; v++) {
    let u = v;
    while (u !== 0 && u !== m) u = inst.par[u];
    if (u === m) out.push(v);
  }
  return out;
}

/** ตัวตรวจที่ 1 อ่านนิยามในโจทย์ตรง ๆ ลองผู้จัดการทุกคน ลองทุกเซตย่อยของคนใต้เขา */
function bestEnum(inst: Inst): { best: number; mgr: number; set: number[] } {
  let best = 0;
  let mgr = 0;
  let set: number[] = [];
  for (let m = 1; m <= inst.n; m++) {
    const items = subtreeOf(inst, m);
    for (let mask = 0; mask < 1 << items.length; mask++) {
      let s = 0;
      const pick: number[] = [];
      for (let j = 0; j < items.length; j++) {
        if ((mask >> j) & 1) {
          s += inst.cost[items[j]];
          pick.push(items[j]);
        }
      }
      const score = pick.length * inst.lead[m];
      if (s <= inst.M && score > best) {
        best = score;
        mgr = m;
        set = pick;
      }
    }
  }
  return { best, mgr, set };
}

/** จำนวนคนมากที่สุดที่งบซื้อไหวในสายของ m หาแบบไล่ทุกเซตย่อย
 *  force = บังคับว่าต้องมี m อยู่ในชุดด้วย คืน -1 ถ้าเป็นไปไม่ได้ */
function maxCountEnum(inst: Inst, m: number, force = false): number {
  const items = subtreeOf(inst, m);
  let best = -1;
  for (let mask = 0; mask < 1 << items.length; mask++) {
    let s = 0;
    let c = 0;
    let has = false;
    for (let j = 0; j < items.length; j++) {
      if ((mask >> j) & 1) {
        s += inst.cost[items[j]];
        c++;
        if (items[j] === m) has = true;
      }
    }
    if (s <= inst.M && (!force || has) && c > best) best = c;
  }
  return best;
}

/** ตัวตรวจที่ 2 ไม่มีการเรียงและไม่มีฮีป ทำ knapsack เต็มรูปแบบว่างบ M ซื้อคนได้มากสุดกี่คน */
function bestKnapsack(inst: Inst): number {
  let best = 0;
  for (let m = 1; m <= inst.n; m++) {
    const dp = new Array<number>(inst.M + 1).fill(0);
    for (const v of subtreeOf(inst, m)) {
      const w = inst.cost[v];
      for (let j = inst.M; j >= w; j--) dp[j] = Math.max(dp[j], dp[j - w] + 1);
    }
    best = Math.max(best, dp[inst.M] * inst.lead[m]);
  }
  return best;
}

/** ท่าที่หน้านี้สอน เดิน i จาก n ลงมา 1 แต่ละปมถือชุดคนที่ซื้อไหว แล้วยกชุดนั้นขึ้นไปให้หัวหน้า */
type WalkRow = { i: number; kept: number[]; sum: number; cnt: number; drop: number[]; score: number };
function heapWalk(inst: Inst): { ans: number; mgr: number; rows: WalkRow[] } {
  const held: number[][] = Array.from({ length: inst.n + 1 }, () => []);
  const rows: WalkRow[] = [];
  let ans = 0;
  let mgr = 0;
  for (let i = inst.n; i >= 1; i--) {
    held[i].push(inst.cost[i]);
    held[i].sort((a, b) => a - b);
    let sum = held[i].reduce((a, b) => a + b, 0);
    const drop: number[] = [];
    while (held[i].length > 0 && sum > inst.M) {
      const gone = held[i].pop();
      if (gone === undefined) break;
      sum -= gone;
      drop.push(gone);
    }
    const score = held[i].length * inst.lead[i];
    if (score > ans) {
      ans = score;
      mgr = i;
    }
    rows.push({ i, kept: [...held[i]], sum, cnt: held[i].length, drop, score });
    const p = inst.par[i];
    if (p !== 0) held[p] = held[p].concat(held[i]);
  }
  return { ans, mgr, rows };
}

/** ซื้อคนถูกก่อนในสายของ m คืนรายชื่อที่ซื้อ พร้อมยอดที่จ่ายและคะแนน */
function cheapestFirst(inst: Inst, m: number): { buy: number[]; spend: number; cnt: number; score: number } {
  const items = subtreeOf(inst, m).slice().sort((a, b) => inst.cost[a] - inst.cost[b] || a - b);
  let left = inst.M;
  const buy: number[] = [];
  for (const v of items) {
    if (inst.cost[v] > left) break;
    left -= inst.cost[v];
    buy.push(v);
  }
  return { buy, spend: inst.M - left, cnt: buy.length, score: buy.length * inst.lead[m] };
}

/** ท่าผิดที่ 1 ตั้งคนที่ความเป็นผู้นำสูงสุดเป็นผู้จัดการ แล้วเล่นในสายของเขาให้ดีที่สุด */
function topLeaderOf(inst: Inst): number {
  let m = 1;
  for (let v = 2; v <= inst.n; v++) if (inst.lead[v] > inst.lead[m]) m = v;
  return m;
}

/** ท่าผิดที่ 2 ผู้จัดการถูกแล้ว แต่ไล่ส่งคนที่ความเป็นผู้นำสูงก่อน */
function leadFirstScore(inst: Inst, m: number): number {
  const items = subtreeOf(inst, m).slice().sort((a, b) => inst.lead[b] - inst.lead[a] || a - b);
  let left = inst.M;
  let cnt = 0;
  for (const v of items) {
    if (inst.cost[v] <= left) {
      left -= inst.cost[v];
      cnt++;
    }
  }
  return cnt * inst.lead[m];
}

/* ---------- ตัวอย่างในโจทย์ กับชุดของมินิเกม ---------- */
const SAMPLE: Inst = { n: 5, M: 4, par: [0, 0, 1, 2, 1, 2], cost: [0, 3, 3, 2, 2, 3], lead: [0, 3, 5, 2, 4, 1] };
/* ผู้นำสูงสุดคือนินจา 4 แต่สายของเขาสั้น รากที่ผู้นำต่ำกว่าหนึ่งขั้นชนะ */
const P_LEADER: Inst = { n: 8, M: 12, par: [0, 0, 1, 1, 1, 1, 4, 3, 3], cost: [0, 2, 5, 4, 7, 6, 1, 8, 3], lead: [0, 8, 3, 6, 9, 3, 8, 7, 1] };
/* ผู้จัดการเดาถูกได้ไม่ยาก ที่ยากคือเลือกว่าจะส่งใคร งบ 12 เต็มมือพอดี */
const P_CHEAP: Inst = { n: 7, M: 12, par: [0, 0, 1, 2, 1, 2, 4, 2], cost: [0, 7, 6, 1, 8, 3, 2, 5], lead: [0, 9, 1, 1, 8, 6, 9, 7] };
/* ต้นไม้สายลึก ผู้จัดการที่ดีที่สุดอยู่กลางสาย และเขาต้องอยู่บ้าน */
const P_DEEP: Inst = { n: 7, M: 11, par: [0, 0, 1, 2, 3, 2, 3, 6], cost: [0, 7, 6, 1, 8, 3, 2, 5], lead: [0, 4, 6, 5, 3, 8, 1, 5] };

const SAMPLE_OUT = 6;
const SAMPLE_ANS = bestEnum(SAMPLE);
const SAMPLE_WALK = heapWalk(SAMPLE);
if (SAMPLE_ANS.best !== SAMPLE_OUT) throw new Error('dispatching: ตัวอย่างในโจทย์ต้องได้ 6');
if (SAMPLE_WALK.ans !== SAMPLE_OUT) throw new Error('dispatching: ท่าที่หน้านี้สอนตอบตัวอย่างไม่ตรง');
if (bestKnapsack(SAMPLE) !== SAMPLE_OUT) throw new Error('dispatching: ตัวตรวจ knapsack ตอบตัวอย่างไม่ตรง');

/* ด่านตรวจตอนบิลด์ สุ่มต้นไม้เล็ก ๆ แล้วเทียบท่าที่สอนกับตัวตรวจสองตัวที่ไม่รู้จักท่านั้นเลย */
const SWEEP_CASES = 400;
let sweepDrops = 0;
{
  let seed = 20390911;
  const rnd = (m: number): number => {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed % m;
  };
  for (let t = 0; t < SWEEP_CASES; t++) {
    const n = 2 + rnd(8);
    const M = 4 + rnd(12);
    const par = [0, 0];
    const cost = [0, 1 + rnd(Math.min(9, M))];
    const lead = [0, 1 + rnd(9)];
    for (let i = 2; i <= n; i++) {
      par.push(1 + rnd(i - 1));
      cost.push(1 + rnd(Math.min(9, M)));
      lead.push(1 + rnd(9));
    }
    const inst: Inst = { n, M, par, cost, lead };
    const walk = heapWalk(inst);
    if (walk.ans !== bestEnum(inst).best) throw new Error(`dispatching: ท่าที่สอนไม่ตรงกับตัวตรวจเซตย่อย ${JSON.stringify(inst)}`);
    if (walk.ans !== bestKnapsack(inst)) throw new Error(`dispatching: ท่าที่สอนไม่ตรงกับตัวตรวจ knapsack ${JSON.stringify(inst)}`);
    if (walk.rows.some((r) => r.drop.length > 0)) sweepDrops++;
  }
}

/* ---------- ชุดปริศนาของมินิเกม เฉลยคิดด้วยการไล่ทุกเซตย่อย ---------- */
type Puzzle = {
  id: string;
  label: string;
  tease: string;
  n: number;
  M: number;
  par: number[];
  cost: number[];
  lead: number[];
  answer: number;
};

/** trap = ชื่อท่าผิดที่ชุดนี้ต้องลงโทษให้ได้ ถ้าท่าผิดดันชนะหรือเสมอ หน้านี้จะไม่ขึ้น */
function makePuzzle(id: string, label: string, tease: string, inst: Inst, expect: number, trap: 'leader' | 'leadfirst' | 'stayhome' | 'none'): Puzzle {
  const oracle = bestEnum(inst);
  if (oracle.best !== expect) throw new Error(`dispatching: ชุด ${id} ตัวตรวจตอบ ${oracle.best} ไม่ใช่ ${expect}`);
  if (bestKnapsack(inst) !== expect) throw new Error(`dispatching: ชุด ${id} ตัวตรวจ knapsack ไม่ตรง`);
  if (heapWalk(inst).ans !== expect) throw new Error(`dispatching: ชุด ${id} ท่าที่สอนไม่ตรงกับตัวตรวจ`);
  if (Math.max(...inst.cost.slice(1)) > inst.M) throw new Error(`dispatching: ชุด ${id} มีค่าจ้างเกินงบ ผิดเงื่อนไข Ci <= M`);
  if (trap === 'leader') {
    const tl = topLeaderOf(inst);
    if (tl === oracle.mgr) throw new Error(`dispatching: ชุด ${id} ผู้นำสูงสุดดันเป็นผู้จัดการที่ถูกอยู่แล้ว`);
    if (maxCountEnum(inst, tl) * inst.lead[tl] >= expect) throw new Error(`dispatching: ชุด ${id} ท่าผิด "เลือกผู้นำสูงสุด" ไม่ได้แพ้จริง`);
  }
  if (trap === 'leadfirst' && leadFirstScore(inst, oracle.mgr) >= expect)
    throw new Error(`dispatching: ชุด ${id} ท่าผิด "ส่งคนผู้นำสูงก่อน" ไม่ได้แพ้จริง`);
  if (trap === 'stayhome') {
    if (maxCountEnum(inst, oracle.mgr, true) >= maxCountEnum(inst, oracle.mgr))
      throw new Error(`dispatching: ชุด ${id} ผู้จัดการไปเองแล้วยังได้เท่าเดิม`);
    if (maxCountEnum(inst, 1) * inst.lead[1] >= expect) throw new Error(`dispatching: ชุด ${id} หัวหน้าใหญ่ไม่ได้แพ้จริง`);
  }
  return { id, label, tease, ...inst, answer: expect };
}

const PUZZLES: Puzzle[] = [
  makePuzzle('a', 'ตัวอย่างในโจทย์', 'ห้าคน งบ 4 โจทย์เฉลยไว้แล้วว่าได้ 6 ลองไล่ให้เจอเองว่าใครเป็นผู้จัดการ แล้วส่งใครไปบ้าง', SAMPLE, SAMPLE_OUT, 'none'),
  makePuzzle('b', 'ผู้นำสูงสุด', 'แปดคน งบ 12 คนที่ความเป็นผู้นำสูงที่สุดเห็นชัดตั้งแต่แรก ลองตั้งเขาเป็นผู้จัดการก่อน แล้วค่อยลองคนอื่นเทียบ', P_LEADER, 32, 'leader'),
  makePuzzle('c', 'งบ 12 เต็มมือ', 'ผู้จัดการชุดนี้เดาถูกได้ไม่ยาก ที่เหลือคือเลือกว่าจะส่งใครไปบ้างให้คุ้มงบที่สุด', P_CHEAP, 36, 'leadfirst'),
  makePuzzle('d', 'ต้นไม้สายลึก', 'เจ็ดคนเรียงกันเป็นสายยาว งบ 11 ชุดที่ดีที่สุดใช้งบหมดพอดี ลองดูว่าผู้จัดการควรยืนอยู่ชั้นไหน', P_DEEP, 24, 'stayhome'),
];
const puzzlesJson = JSON.stringify(PUZZLES);

/* ---------- ตัวเลขของตัวอย่าง สำหรับกล่องอ่านตัวอย่างและรูป ---------- */
const fmt = (v: number): string => v.toLocaleString('en-US');
const SAMPLE_IDS = Array.from({ length: SAMPLE.n }, (_, k) => k + 1);
const SAMPLE_LINES = [`${SAMPLE.n} ${SAMPLE.M}`, ...SAMPLE_IDS.map((i) => `${SAMPLE.par[i]} ${SAMPLE.cost[i]} ${SAMPLE.lead[i]}`)];
const SAMPLE_MGR = SAMPLE_IDS.map((m) => ({ m, ...cheapestFirst(SAMPLE, m), sub: subtreeOf(SAMPLE, m) }));
const SAMPLE_BEST_ROW = SAMPLE_MGR.reduce((a, b) => (b.score > a.score ? b : a));
const SAMPLE_TOP_LEAD = topLeaderOf(SAMPLE);
const SAMPLE_TOP_ROW = SAMPLE_MGR[SAMPLE_TOP_LEAD - 1];
const SAMPLE_LEADFIRST = leadFirstScore(SAMPLE, SAMPLE_BEST_ROW.m);
/* ตัวอย่างในโจทย์ลงโทษท่าผิดทั้งสองแบบอยู่แล้ว ถ้าวันหนึ่งมันไม่ลงโทษ ประโยคในหน้าจะกลายเป็นเท็จ */
if (SAMPLE_TOP_ROW.score >= SAMPLE_ANS.best) throw new Error('dispatching: ตัวอย่างไม่ได้ลงโทษการเลือกผู้นำสูงสุด');
if (SAMPLE_LEADFIRST >= SAMPLE_ANS.best) throw new Error('dispatching: ตัวอย่างไม่ได้ลงโทษการส่งคนผู้นำสูงก่อน');
/* คำตอบของตัวอย่างไม่ส่งผู้จัดการไปเอง ประโยคในกล่องอ่านตัวอย่างพูดถึงข้อนี้ */
const SAMPLE_MGR_STAYS = !SAMPLE_ANS.set.includes(SAMPLE_ANS.mgr);
if (!SAMPLE_MGR_STAYS) throw new Error('dispatching: คำตอบของตัวอย่างควรเป็นชุดที่ผู้จัดการอยู่บ้าน');

const sampleClauses = SAMPLE_MGR.map(
  (r) =>
    `ผู้จัดการ ${r.m} คุมคนได้ ${r.sub.length} คน คือนินจา ${r.sub.join(' ')} งบ ${SAMPLE.M} ซื้อคนถูกที่สุดได้ ${r.cnt} คน คูณความเป็นผู้นำ ${SAMPLE.lead[r.m]} เท่ากับ ${r.score}`,
);

/* ---------- รูปที่ 1 ต้นไม้ของตัวอย่าง กับคะแนนของผู้จัดการแต่ละคน ---------- */
type Box = { id: number; x: number; y: number };
type Seg = { x1: number; y1: number; x2: number; y2: number };
type Tree = { boxes: Box[]; edges: Seg[]; w: number; h: number; bw: number; bh: number };

/** วางต้นไม้แบบเรียบง่าย ใบไล่จากซ้ายไปขวาตามลำดับ DFS ปมในเป็นค่าเฉลี่ยของลูก */
function treeLayout(inst: Inst, bw: number, bh: number, gapX: number, gapY: number, x0: number, y0: number): Tree {
  const kids: number[][] = Array.from({ length: inst.n + 1 }, () => []);
  for (let i = 1; i <= inst.n; i++) if (inst.par[i] !== 0) kids[inst.par[i]].push(i);
  const col = new Array<number>(inst.n + 1).fill(0);
  const dep = new Array<number>(inst.n + 1).fill(0);
  let leaf = 0;
  const walk = (v: number, d: number): number => {
    dep[v] = d;
    if (kids[v].length === 0) {
      col[v] = leaf;
      leaf += 1;
      return col[v];
    }
    const cs = kids[v].map((c) => walk(c, d + 1));
    col[v] = (Math.min(...cs) + Math.max(...cs)) / 2;
    return col[v];
  };
  walk(1, 0);
  const boxes: Box[] = [];
  for (let i = 1; i <= inst.n; i++) boxes.push({ id: i, x: x0 + col[i] * gapX, y: y0 + dep[i] * gapY });
  const edges: Seg[] = [];
  for (let i = 1; i <= inst.n; i++) {
    const p = inst.par[i];
    if (p === 0) continue;
    const a = boxes[p - 1];
    const b = boxes[i - 1];
    edges.push({ x1: a.x + bw / 2, y1: a.y + bh, x2: b.x + bw / 2, y2: b.y });
  }
  const w = Math.max(...boxes.map((b) => b.x)) + bw;
  const h = Math.max(...boxes.map((b) => b.y)) + bh;
  return { boxes, edges, w, h, bw, bh };
}

const D1 = treeLayout(SAMPLE, 86, 56, 104, 82, 6, 34);
const D1_PANEL_X = 340;
const D1_PANEL_W = 300;
const D1_ROW_H = 30;
const D1_ROW_PITCH = 38;
const D1_ROWS = SAMPLE_MGR.map((r, k) => ({ ...r, y: 34 + k * D1_ROW_PITCH }));
const D1_W = D1_PANEL_X + D1_PANEL_W + 12;
const D1_H = Math.max(D1.h, 34 + (D1_ROWS.length - 1) * D1_ROW_PITCH + D1_ROW_H) + 34;

/* ---------- รูปที่ 2 คนแพงที่ลูกทิ้ง ไม่เคยถูกเรียกกลับ ---------- */
const EV_INST = P_LEADER;
const EV_CHILD = 3;
const EV_WALK = heapWalk(EV_INST);
const EV_ROW = EV_WALK.rows.find((r) => r.i === EV_CHILD);
if (!EV_ROW) throw new Error('dispatching: ไม่พบแถวของปมที่ใช้ในรูปที่สอง');
if (EV_ROW.drop.length === 0) throw new Error('dispatching: ปมในรูปที่สองต้องมีการปลดคนแพงออกจริง');
const EV_TOP = bestEnum(EV_INST);
const EV_BRANCH = subtreeOf(EV_INST, EV_CHILD);
const EV_TAKEN = EV_TOP.set.filter((v) => EV_BRANCH.includes(v)).map((v) => EV_INST.cost[v]);
if (EV_TAKEN.length > EV_ROW.cnt) throw new Error('dispatching: คำตอบหยิบจากกิ่งนี้มากกว่าที่ลูกเก็บไว้ ข้ออ้างของหน้าพัง');
const EV_KEPT_IDS = EV_BRANCH.slice().sort((a, b) => EV_INST.cost[a] - EV_INST.cost[b] || a - b);
const EV_CHIPS = EV_KEPT_IDS.map((v, k) => ({ id: v, cost: EV_INST.cost[v], kept: k < EV_ROW.cnt }));
const EV_FINAL = EV_TOP.set.slice().sort((a, b) => EV_INST.cost[a] - EV_INST.cost[b] || a - b).map((v) => ({ id: v, cost: EV_INST.cost[v], fromBranch: EV_BRANCH.includes(v) }));
const CHIP_W = 54;
const CHIP_H = 44;
const CHIP_GAP = 10;
const EV_LEFT_X = 6;
const EV_RIGHT_X = 262;
const EV_CHIP_Y = 32;
const EV_LABEL_Y = 90;
const EV_W = EV_RIGHT_X + EV_FINAL.length * (CHIP_W + CHIP_GAP) - CHIP_GAP + 12;
const EV_H = EV_LABEL_Y + 34;

/* ---------- ขอบเขต และบิลค่าใช้จ่าย ---------- */
const N_MAX = 100000;
