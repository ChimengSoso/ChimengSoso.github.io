import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { mc, texCode } from '../../lib/math';

const href = 'hermes/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Pt = { x: number; y: number };
const ORIGIN: Pt = { x: 0, y: 0 };

/** ตัวตรวจ เดินทีละก้าวบนตารางจริง สถานะคือ (ส่งไปแล้วกี่ฉบับ, x, y)
 *  ส่งได้ฟรีเมื่อยืนแนวเดียวกับฉบับถัดไป ไม่ได้ใช้ข้ออ้างเรื่องถนนสองเส้นเลย */
function bruteBfs(ps: Pt[]): number {
  const n = ps.length;
  let lo = 0;
  let hi = 0;
  for (const p of ps) {
    lo = Math.min(lo, p.x, p.y);
    hi = Math.max(hi, p.x, p.y);
  }
  lo -= 2;
  hi += 2;
  const S = hi - lo + 1;
  const id = (k: number, x: number, y: number): number => (k * S + (x - lo)) * S + (y - lo);
  const dist: number[] = new Array<number>((n + 1) * S * S).fill(Infinity);
  const dq: [number, number, number][] = [[0, 0, 0]];
  dist[id(0, 0, 0)] = 0;
  const moves: [number, number][] = [[1, 0], [-1, 0], [0, 1], [0, -1]];
  while (dq.length > 0) {
    const head = dq.shift();
    if (!head) break;
    const [k, x, y] = head;
    const d = dist[id(k, x, y)];
    if (k === n) return d;
    if (x === ps[k].x || y === ps[k].y) {
      const t = id(k + 1, x, y);
      if (dist[t] > d) {
        dist[t] = d;
        dq.unshift([k + 1, x, y]);
      }
    }
    for (const [ax, ay] of moves) {
      const nx = x + ax;
      const ny = y + ay;
      if (nx < lo || nx > hi || ny < lo || ny > hi) continue;
      const t = id(k, nx, ny);
      if (dist[t] > d + 1) {
        dist[t] = d + 1;
        dq.push([k, nx, ny]);
      }
    }
  }
  return Infinity;
}

type Side = 'row' | 'col';
type Cell = { cost: number; from: { side: Side; c: number } | null; turn: boolean };
type Layer = { at: Pt; row: Map<number, Cell>; col: Map<number, Cell> };

/** ท่าเต็ม หลังส่งฉบับที่ i จำแค่ยืนบนเส้นไหนของฉบับนั้น กับพิกัดอีกแกน
 *  row คือยืนบนถนนแนวนอน y = Y_i ที่ x = c, col คือยืนบนถนนแนวตั้ง x = X_i ที่ y = c */
function lineLayers(ps: Pt[]): Layer[] {
  const layers: Layer[] = [
    {
      at: ORIGIN,
      row: new Map([[0, { cost: 0, from: null, turn: false }]]),
      col: new Map([[0, { cost: 0, from: null, turn: false }]]),
    },
  ];
  for (const p of ps) {
    const prev = layers[layers.length - 1];
    const { x: px, y: py } = prev.at;
    const row = new Map<number, Cell>();
    const col = new Map<number, Cell>();
    for (const [c, cell] of prev.row) row.set(c, { cost: cell.cost + Math.abs(py - p.y), from: { side: 'row', c }, turn: false });
    for (const [c, cell] of prev.col) col.set(c, { cost: cell.cost + Math.abs(px - p.x), from: { side: 'col', c }, turn: false });
    let toRow: Cell | null = null;
    for (const [c, cell] of prev.col) {
      const v = cell.cost + Math.abs(c - p.y);
      if (!toRow || v < toRow.cost) toRow = { cost: v, from: { side: 'col', c }, turn: true };
    }
    let toCol: Cell | null = null;
    for (const [c, cell] of prev.row) {
      const v = cell.cost + Math.abs(c - p.x);
      if (!toCol || v < toCol.cost) toCol = { cost: v, from: { side: 'row', c }, turn: true };
    }
    const oldR = row.get(px);
    if (toRow && (!oldR || toRow.cost < oldR.cost)) row.set(px, toRow);
    const oldC = col.get(py);
    if (toCol && (!oldC || toCol.cost < oldC.cost)) col.set(py, toCol);
    layers.push({ at: p, row, col });
  }
  return layers;
}

function bestOf(layer: Layer): { side: Side; c: number; cost: number } {
  let best = { side: 'row' as Side, c: 0, cost: Infinity };
  for (const side of ['row', 'col'] as Side[])
    for (const [c, cell] of layer[side]) if (cell.cost < best.cost) best = { side, c, cost: cell.cost };
  return best;
}
const lineDp = (ps: Pt[]): number => bestOf(lineLayers(ps)[ps.length]).cost;
const posOf = (layer: Layer, side: Side, c: number): Pt => (side === 'row' ? { x: c, y: layer.at.y } : { x: layer.at.x, y: c });

/** ชุดย่อย ลองไปยืนทุกจุดบนสองเส้นของฉบับถัดไป (จำกัดกรอบไว้ที่ขอบของข้อมูลบวกสอง) */
function allPointsDp(ps: Pt[]): number {
  let lo = 0;
  let hi = 0;
  for (const p of ps) {
    lo = Math.min(lo, p.x, p.y);
    hi = Math.max(hi, p.x, p.y);
  }
  lo -= 2;
  hi += 2;
  let cur: { at: Pt; cost: number }[] = [{ at: ORIGIN, cost: 0 }];
  for (const p of ps) {
    const nxt = new Map<string, { at: Pt; cost: number }>();
    for (const s of cur)
      for (let z = lo; z < hi + 1; z++)
        for (const q of [{ x: z, y: p.y }, { x: p.x, y: z }]) {
          const v = s.cost + Math.abs(s.at.x - q.x) + Math.abs(s.at.y - q.y);
          const key = `${q.x},${q.y}`;
          const old = nxt.get(key);
          if (!old || v < old.cost) nxt.set(key, { at: q, cost: v });
        }
    cur = [...nxt.values()];
  }
  return Math.min(...cur.map((s) => s.cost));
}

/** ท่าโลภ เดินไปเส้นที่ใกล้กว่าของฉบับถัดไปเสมอ ใช้ในกล่องกับดักและเป็นด่านตรวจของเกม */
function greedyNearest(ps: Pt[]): number {
  let cx = 0;
  let cy = 0;
  let tot = 0;
  for (const { x, y } of ps) {
    if (cx === x || cy === y) continue;
    if (Math.abs(cx - x) <= Math.abs(cy - y)) {
      tot += Math.abs(cx - x);
      cx = x;
    } else {
      tot += Math.abs(cy - y);
      cy = y;
    }
  }
  return tot;
}

/* ด่านตรวจตอนบิลด์ ท่าทั้งสองที่หน้านี้สอนต้องตรงกับการเดินทีละก้าว ไม่งั้นหน้านี้ไม่ขึ้น */
const SWEEP_CASES = 300;
{
  let seed = 20370911;
  const rnd = (m: number): number => {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed % m;
  };
  for (let t = 0; t < SWEEP_CASES; t++) {
    const n = 1 + rnd(6);
    const v = [1, 2, 3, 4][rnd(4)];
    const ps = Array.from({ length: n }, () => ({ x: rnd(2 * v + 1) - v, y: rnd(2 * v + 1) - v }));
    const b = bruteBfs(ps);
    if (lineDp(ps) !== b || allPointsDp(ps) !== b)
      throw new Error(`hermes: ท่าที่สอนไม่ตรงกับการเดินทีละก้าว ที่ ${JSON.stringify(ps)}`);
  }
}

/* ---------- ตัวอย่างในโจทย์ ---------- */
const SAMPLE: Pt[] = [{ x: 8, y: 3 }, { x: 7, y: -7 }, { x: 8, y: 1 }, { x: -2, y: 1 }, { x: 6, y: -5 }];
const SAMPLE_OUT = 11;
if (lineDp(SAMPLE) !== SAMPLE_OUT || bruteBfs(SAMPLE) !== SAMPLE_OUT) throw new Error('hermes: ตัวอย่างไม่ตรงกับโจทย์');
const sampleGreedy = greedyNearest(SAMPLE);
if (sampleGreedy <= SAMPLE_OUT) throw new Error('hermes: ข้ออ้างว่าท่าโลภแพ้ตัวอย่างในโจทย์ผิด');

const fmt = (n: number): string => n.toLocaleString('en-US');
const ptStr = (p: Pt): string => `(${p.x}, ${p.y})`;

/* ---------- เส้นทางที่ดีที่สุดของตัวอย่าง ย้อนจากช่องที่ดีที่สุดกลับไปหาจุดเริ่ม ---------- */
const SL = lineLayers(SAMPLE);
const route: { at: Pt; layer: number }[] = [];
{
  let cur: { side: Side; c: number } | null = bestOf(SL[SAMPLE.length]);
  for (let i = SAMPLE.length; i >= 0 && cur; i--) {
    route.unshift({ at: posOf(SL[i], cur.side, cur.c), layer: i });
    const cell: Cell | undefined = SL[i][cur.side].get(cur.c);
    cur = cell ? cell.from : null;
  }
}
const routeLen = route.slice(1).reduce((t, r, i) => t + Math.abs(r.at.x - route[i].at.x) + Math.abs(r.at.y - route[i].at.y), 0);
if (routeLen !== SAMPLE_OUT) throw new Error('hermes: เส้นทางที่ย้อนได้ยาวไม่เท่าคำตอบ');
/* จุดส่งที่ตรงกัน รวมป้ายเป็นป้ายเดียว */
const dropMap = new Map<string, { at: Pt; ks: number[] }>();
route.slice(1).forEach((r) => {
  const key = ptStr(r.at);
  const e = dropMap.get(key) ?? { at: r.at, ks: [] };
  e.ks.push(r.layer);
  dropMap.set(key, e);
});
const drops = [...dropMap.values()];
const zeroMoves = route.slice(1).filter((r, i) => r.at.x === route[i].at.x && r.at.y === route[i].at.y).map((r) => r.layer);

/* พิกัดของแผนภาพเส้นทาง */
const RX0 = -3;
const RX1 = 9;
const RY0 = -8;
const RY1 = 4;
const RU = 40;
const RL = 40;
const RT = 24;
const rsx = (x: number): number => RL + (x - RX0) * RU;
const rsy = (y: number): number => RT + (RY1 - y) * RU;
const rGridX = Array.from({ length: RX1 - RX0 + 1 }, (_, i) => RX0 + i);
const rGridY = Array.from({ length: RY1 - RY0 + 1 }, (_, i) => RY0 + i);
const routeSegs = route
  .slice(1)
  .map((r, i) => ({ a: route[i].at, b: r.at }))
  .filter((s) => s.a.x !== s.b.x || s.a.y !== s.b.y);
const cafeLabels = (() => {
  const m = new Map<string, { at: Pt; ks: number[] }>();
  SAMPLE.forEach((p, i) => {
    const e = m.get(ptStr(p)) ?? { at: p, ks: [] };
    e.ks.push(i + 1);
    m.set(ptStr(p), e);
  });
  return [...m.values()];
})();
const RW = rsx(RX1) + 12;
const RH = rsy(RY0) + 18 + 34;
const zeroNote =
  zeroMoves.length > 0
    ? `ฉบับที่ ${zeroMoves.join(' กับ ')} ส่งได้โดยไม่ต้องขยับ เพราะจุดที่ยืนอยู่แนวเดียวกับร้านถัดไปอยู่แล้ว`
    : 'ทุกฉบับต้องเดินก่อนส่ง';
const routeCaption = `เส้นทางที่ย้อนได้จากช่องที่ดีที่สุด ยาว ${routeLen} พอดีกับคำตอบ ทุกช่วงเป็นเส้นตรงเส้นเดียวตามที่ตอนที่ 3 บอก จุดวงแหวนคือจุดที่ยืนส่ง ${zeroNote}`;

/* ---------- แผนภาพจุดใกล้ที่สุด ---------- */
const NU = 52;
const NL = 36;
const NT = 30;
const nsx = (x: number): number => NL + x * NU;
const nsy = (y: number): number => NT + (5 - y) * NU;
const NP: Pt = { x: 1, y: 1 };
const NQ: Pt = { x: 6, y: 4 };
const NZ: Pt = { x: 6, y: 3 };
const NW = nsx(7) + 12;
const NH = nsy(0) + 34;

/* ---------- ตัวเล่นทีละขั้น ตัวอย่างในโจทย์ ---------- */
const cellList = (m: Map<number, Cell>, axis: 'x' | 'y'): string =>
  [...m.entries()]
    .sort((a, b) => a[0] - b[0])
    .map(([c, cell]) => `${axis}=${c} · ${cell.cost}`)
    .join(', ');
const stepRows = SL.map((L, i) => {
  const b = bestOf(L);
  return { i, at: L.at, rowList: cellList(L.row, 'x'), colList: cellList(L.col, 'y'), best: b.cost };
});
const walkSteps = SL.map((L, i) => {
  if (i === 0)
    return {
      note:
        'เริ่มที่ (0, 0) นับเป็นฉบับที่ 0 ซึ่งยืนอยู่บนทั้งสองเส้นของมันพร้อมกัน ' +
        'บนถนนแนวนอน y = 0 ที่ x = 0 และบนถนนแนวตั้ง x = 0 ที่ y = 0 ระยะ 0 ทั้งคู่',
    };
  const prev = SL[i - 1];
  const dy = Math.abs(prev.at.y - L.at.y);
  const dx = Math.abs(prev.at.x - L.at.x);
  const tr = L.row.get(prev.at.x);
  const tc = L.col.get(prev.at.y);
  const turnRow =
    tr && tr.turn && tr.from
      ? `ทางเลี้ยวลงถนนแนวนอนใหม่ได้ช่อง x = ${prev.at.x} ระยะ <b>${tr.cost}</b> (มาจากจุดบนถนนแนวตั้งเก่าที่ y = ${tr.from.c}) `
      : `ทางเลี้ยวลงถนนแนวนอนใหม่ที่ x = ${prev.at.x} ไม่ชนะช่องเดิม `;
  const turnCol =
    tc && tc.turn && tc.from
      ? `ทางเลี้ยวลงถนนแนวตั้งใหม่ได้ช่อง y = ${prev.at.y} ระยะ <b>${tc.cost}</b> (มาจากจุดบนถนนแนวนอนเก่าที่ x = ${tc.from.c}) `
      : `ทางเลี้ยวลงถนนแนวตั้งใหม่ที่ y = ${prev.at.y} ไม่ชนะช่องเดิม `;
  return {
    note:
      `ฉบับที่ <b>${i}</b> อยู่ที่ ${ptStr(L.at)} ` +
      `ทางตรง: ทุกช่องฝั่งแนวนอนบวก ${dy} (ระยะขึ้นลงจาก y = ${prev.at.y} ถึง y = ${L.at.y}) ` +
      `ทุกช่องฝั่งแนวตั้งบวก ${dx} (ระยะซ้ายขวาจาก x = ${prev.at.x} ถึง x = ${L.at.x}) ` +
      turnRow +
      turnCol +
      `ดีที่สุดตอนนี้คือ <b>${bestOf(L).cost}</b>`,
  };
});
const layerSizes = SL.map((L) => L.row.size + L.col.size);
const sizeBoundOk = SL.every((L, i) => L.row.size <= i + 1 && L.col.size <= i + 1);
if (!sizeBoundOk) throw new Error('hermes: ข้ออ้างว่าแต่ละฝั่งมีไม่เกิน i + 1 ช่องผิด');

/* ---------- สูตร ---------- */
const ROW = mc.fn('row');
const COL = mc.fn('col');
const MIN = '\\mathop{\\textcolor{#50FA7B}{\\min}}\\limits';
const ABS = (s: string): string => '\\lvert ' + s + ' \\rvert';
const I1 = 'i' + mc.op('-') + mc.num('1');
const recurrenceTex = texCode(
  ROW + '[i][c] \\;' + mc.op('=') + '\\; ' + MIN + ' \\begin{cases} ' +
    ROW + '[' + I1 + '][c] ' + mc.op('+') + ' ' + ABS('Y_{' + I1 + '} ' + mc.op('-') + ' Y_i') + ' & \\\\ ' +
    MIN + '_{c\'} \\big( ' + COL + '[' + I1 + '][c\'] ' + mc.op('+') + ' ' + ABS('c\' ' + mc.op('-') + ' Y_i') + ' \\big) & (c ' + mc.op('=') + ' X_{' + I1 + '}) \\end{cases}',
);

/* ---------- มินิเกม ---------- */
type GamePuzzle = {
  id: string;
  label: string;
  tease: string;
  pts: Pt[];
  best: number;
  x0: number;
  x1: number;
  y0: number;
  y1: number;
};
function makePuzzle(id: string, label: string, tease: string, pts: Pt[], trap: boolean): GamePuzzle {
  const best = bruteBfs(pts);
  if (lineDp(pts) !== best) throw new Error(`hermes: เฉลยเกม ${id} สองท่าไม่ตรงกัน`);
  if (trap && greedyNearest(pts) <= best) throw new Error(`hermes: ชุด ${id} ควรทำให้ท่าโลภแพ้ แต่ไม่แพ้`);
  const xs = [0, ...pts.map((p) => p.x)];
  const ys = [0, ...pts.map((p) => p.y)];
  return { id, label, tease, pts, best, x0: Math.min(...xs) - 1, x1: Math.max(...xs) + 1, y0: Math.min(...ys) - 1, y1: Math.max(...ys) + 1 };
}
const PZ_A: Pt[] = [{ x: 2, y: 3 }, { x: -2, y: 1 }, { x: 1, y: -2 }];
const PZ_C: Pt[] = [{ x: 3, y: -3 }, { x: -1, y: 2 }, { x: -3, y: -3 }, { x: -3, y: 3 }];
const PZ_D: Pt[] = [{ x: 4, y: -1 }, { x: -3, y: 2 }, { x: 1, y: 4 }, { x: -2, y: -4 }, { x: 3, y: 3 }, { x: -4, y: 0 }];
const puzzles: GamePuzzle[] = [
  makePuzzle('a', 'อุ่นเครื่อง สามฉบับ', 'สามฉบับแรก ลองคลิกจุดที่อยากไปยืน แล้วดูว่าต้องไปถึงร้านจริง ๆ ไหม', PZ_A, false),
  makePuzzle('b', 'ตัวอย่างในโจทย์', 'ห้าฉบับจากตัวอย่างในโจทย์ คำตอบของโจทย์คือระยะรวมที่ต่ำที่สุดของชุดนี้', SAMPLE, true),
  makePuzzle('c', 'สี่ฉบับ ห้ามใจร้อน', 'ชุดนี้ถ้าเดินไปเส้นที่ใกล้ที่สุดทุกครั้ง จะเสียระยะเยอะมาก ลองหาทางที่ใจเย็นกว่านั้น', PZ_C, true),
  makePuzzle('d', 'หกฉบับ', 'ชุดสุดท้าย ลองทำให้ได้ระยะต่ำสุดก่อนเปิดเฉลย', PZ_D, true),
];
const puzzlesJson = JSON.stringify(puzzles);
const pzC = puzzles[2];
const pzCGreedy = greedyNearest(PZ_C);

/* ตารางปุ่มของแต่ละกระดาน เรียงจากแถวบนลงล่าง (y มากไปน้อย) */
const boardCells = puzzles.map((p) => {
  const cells: { x: number; y: number; tag: string }[] = [];
  for (let y = p.y1; y > p.y0 - 1; y--)
    for (let x = p.x0; x < p.x1 + 1; x++) {
      const ks = p.pts.map((q, i) => (q.x === x && q.y === y ? String(i + 1) : '')).filter((s) => s !== '');
      cells.push({ x, y, tag: ks.join(',') });
    }
  return { cols: p.x1 - p.x0 + 1, cells };
});

/* ---------- บิลค่าใช้จ่าย ---------- */
const N_MAX = 20000;
const WID = 2001;
const bill = [
  { name: 'เดินทีละก้าวบนตารางทั้งแผ่น (ตัวตรวจ)', limit: 'พิกัดแคบ ๆ', work: `N × ${fmt(WID)}² ช่อง คือราว ${fmt(N_MAX * WID * WID)} ช่อง` },
  { name: 'สองเส้น ลองทุกจุดบนเส้นใหม่ (ชุดย่อย)', limit: 'N ต่ำกว่า 80', work: `N × 2 × ${fmt(WID)} × 2 × ${fmt(WID)} คือราว ${fmt(N_MAX * 4 * WID * WID)} ครั้ง` },
  { name: 'สองเส้น เดินไปจุดที่ใกล้ที่สุด (ท่าเต็ม)', limit: `N ถึง ${fmt(N_MAX)}`, work: `N × 2 × ${fmt(WID)} × 2 คือราว ${fmt(N_MAX * 4 * WID)} ครั้ง` },
];

/* ---------- เวลาที่วัดจากไบนารีที่คอมไพล์จากโค้ดในหน้านี้ ---------- */
const T_FULL_BIG = '0.05';
const T_SUB_79 = '0.37';
const T_SUB_800 = '3.8';

const solution = `#include <bits/stdc++.h>
using namespace std;
const int OFF = 1000, W = 2001, INF = 1e9;
// row[c] = ระยะน้อยสุด ถ้าตอนนี้ยืนบนถนนแนวนอนของฉบับล่าสุด ที่ x = c - OFF
// col[c] = ระยะน้อยสุด ถ้าตอนนี้ยืนบนถนนแนวตั้งของฉบับล่าสุด ที่ y = c - OFF
int row[W], col[W];
int main(){
    int n;
    if(scanf("%d", &n) != 1) return 0;
    fill(row, row + W, INF); fill(col, col + W, INF);
    row[OFF] = col[OFF] = 0;    // จุดเริ่ม (0,0) นับเป็นฉบับที่ 0 ยืนอยู่บนทั้งสองเส้นของมัน
    int px = 0, py = 0;           // พิกัดของฉบับก่อนหน้า
    for(int i = 0; i < n; i++){
        int x, y; scanf("%d %d", &x, &y);
        // ทางเลี้ยว หาไว้ก่อนจากแถวเก่า
        // toRow: จากถนนแนวตั้งเก่า เดินขึ้นลงไปชนถนนแนวนอนใหม่ y
        // toCol: จากถนนแนวนอนเก่า เดินซ้ายขวาไปชนถนนแนวตั้งใหม่ x
        int toRow = INF, toCol = INF;
        for(int c = 0; c < W; c++){
            if(col[c] < INF) toRow = min(toRow, col[c] + abs(c - OFF - y));
            if(row[c] < INF) toCol = min(toCol, row[c] + abs(c - OFF - x));
        }
        // ทางตรง อยู่ฝั่งเดิม เดินขนานไปเส้นใหม่ พิกัดอีกแกนไม่เปลี่ยน ช่องจึงเป็นช่องเดิม
        int dy = abs(py - y), dx = abs(px - x);
        for(int c = 0; c < W; c++){
            if(row[c] < INF) row[c] += dy;
            if(col[c] < INF) col[c] += dx;
        }
        // ทางเลี้ยวลงได้ช่องเดียวต่อฝั่ง: ถนนแนวนอนใหม่ที่ x = px กับถนนแนวตั้งใหม่ที่ y = py
        row[px + OFF] = min(row[px + OFF], toRow);
        col[py + OFF] = min(col[py + OFF], toCol);
        px = x; py = y;
    }
    int ans = INF;
    for(int c = 0; c < W; c++) ans = min({ans, row[c], col[c]});
    printf("%d\\n", ans);
}`;

const subCode = `#include <bits/stdc++.h>
using namespace std;
const int OFF = 1000, W = 2001, INF = 1e9;
// ชุดย่อย N < 80: ยังไม่เชื่อว่าเดินไปจุดที่ใกล้ที่สุดพอ
// จากทุกสถานะ ลองไปยืนทุกจุดบนสองเส้นของฉบับถัดไป
int row[W], col[W], nrow[W], ncol[W];
int main(){
    int n;
    if(scanf("%d", &n) != 1) return 0;
    fill(row, row + W, INF); fill(col, col + W, INF);
    row[OFF] = col[OFF] = 0;
    int px = 0, py = 0;
    for(int i = 0; i < n; i++){
        int x, y; scanf("%d %d", &x, &y);
        fill(nrow, nrow + W, INF); fill(ncol, ncol + W, INF);
        for(int c = 0; c < W; c++){
            for(int s = 0; s < 2; s++){
                int d = s == 0 ? row[c] : col[c];
                if(d >= INF) continue;
                int cx = s == 0 ? c - OFF : px;   // ตำแหน่งจริงของสถานะนี้
                int cy = s == 0 ? py : c - OFF;
                for(int z = 0; z < W; z++){
                    nrow[z] = min(nrow[z], d + abs(cx - (z - OFF)) + abs(cy - y));   // ไปยืน (z, y)
                    ncol[z] = min(ncol[z], d + abs(cx - x) + abs(cy - (z - OFF)));   // ไปยืน (x, z)
                }
            }
        }
        copy(nrow, nrow + W, row); copy(ncol, ncol + W, col);
        px = x; py = y;
    }
    int ans = INF;
    for(int c = 0; c < W; c++) ans = min({ans, row[c], col[c]});
    printf("%d\\n", ans);
}`;

const bruteCode = `// ตัวตรวจ เดินทีละก้าวบนตารางจริง ส่งจดหมายได้ฟรีเมื่อยืนแนวเดียวกับฉบับถัดไป
// ไม่ได้ใช้ข้ออ้างเรื่องถนนสองเส้นเลย สถานะคือ (ส่งไปแล้วกี่ฉบับ, x, y)
#include <bits/stdc++.h>
using namespace std;
int main(){
    int n; scanf("%d", &n);
    vector<int> X(n), Y(n);
    int lo = 0, hi = 0;
    for(int i = 0; i < n; i++){
        scanf("%d %d", &X[i], &Y[i]);
        lo = min({lo, X[i], Y[i]}); hi = max({hi, X[i], Y[i]});
    }
    lo -= 2; hi += 2;                       // เผื่อขอบให้เดินอ้อมนอกกรอบได้
    int S = hi - lo + 1;
    auto id = [&](int k, int x, int y){ return (k * S + (x - lo)) * S + (y - lo); };
    vector<int> dist((n + 1) * S * S, INT_MAX);
    deque<array<int, 3>> dq;                // BFS แบบน้ำหนัก 0 กับ 1
    dist[id(0, 0, 0)] = 0; dq.push_back({0, 0, 0});
    int dx[4] = {1, -1, 0, 0}, dy[4] = {0, 0, 1, -1};
    while(!dq.empty()){
        auto [k, x, y] = dq.front(); dq.pop_front();
        int d = dist[id(k, x, y)];
        if(k == n){ printf("%d\\n", d); return 0; }
        if(x == X[k] || y == Y[k]){         // ส่งฉบับที่ k ตรงนี้ ไม่เสียระยะ
            int t = id(k + 1, x, y);
            if(dist[t] > d){ dist[t] = d; dq.push_front({k + 1, x, y}); }
        }
        for(int r = 0; r < 4; r++){
            int nx = x + dx[r], ny = y + dy[r];
            if(nx < lo || nx > hi || ny < lo || ny > hi) continue;
            int t = id(k, nx, ny);
            if(dist[t] > d + 1){ dist[t] = d + 1; dq.push_back({k, nx, ny}); }
        }
    }
}`;
