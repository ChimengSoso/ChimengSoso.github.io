<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type HmPt = { x: number; y: number };
  type HmPuzzle = { id: string; label: string; tease: string; pts: HmPt[]; best: number };

  function isPuzzle(x: unknown): x is HmPuzzle {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return typeof o.best === 'number' && Array.isArray(o.pts) && typeof o.tease === 'string';
  }

  function initHermesGame(): void {
    const maybeUi = cpGameUi('[data-hmgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่ เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root).filter(isPuzzle);
    if (puzzles.length === 0) return;
    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-hm-board]'));

    let pi = 0;
    /* ประวัติการยืน ตัวแรกคือจุดเริ่ม ตัวละ { จุด, ส่งแล้วกี่ฉบับ, ระยะรวม } */
    let hist: { at: HmPt; sent: number; total: number }[] = [];

    const cur = (): { at: HmPt; sent: number; total: number } => hist[hist.length - 1];
    const parse = (s: string): HmPt => {
      const [x, y] = s.split(':').map(Number);
      return { x, y };
    };

    /** ส่งทุกฉบับที่ส่งได้ ณ จุดที่ยืน ต่อกันไปจนเจอฉบับที่ยังไม่อยู่แนวเดียวกัน */
    function deliver(p: HmPuzzle, at: HmPt, sent: number): number {
      let k = sent;
      while (k < p.pts.length && (p.pts[k].x === at.x || p.pts[k].y === at.y)) k++;
      return k;
    }

    function render(): void {
      const p = puzzles[pi];
      boards.forEach((b, k) => {
        b.hidden = k !== pi;
      });
      const now = cur();
      const nxt = now.sent < p.pts.length ? p.pts[now.sent] : null;
      const trail = new Set(hist.map((h) => `${h.at.x}:${h.at.y}`));
      for (const btn of Array.from(boards[pi].querySelectorAll<HTMLElement>('[data-hm-cell]'))) {
        const key = btn.dataset.hmCell ?? '';
        const q = parse(key);
        const ks = p.pts.map((r, i) => (r.x === q.x && r.y === q.y ? i : -1)).filter((i) => i >= 0);
        btn.classList.toggle('cafe', ks.length > 0 && ks.some((i) => i >= now.sent));
        btn.classList.toggle('done', ks.length > 0 && ks.every((i) => i < now.sent));
        btn.classList.toggle('next', nxt !== null && q.x === nxt.x && q.y === nxt.y);
        btn.classList.toggle('line', nxt !== null && (q.x === nxt.x || q.y === nxt.y));
        btn.classList.toggle('origin', q.x === 0 && q.y === 0);
        btn.classList.toggle('me', q.x === now.at.x && q.y === now.at.y);
        btn.classList.toggle('trail', trail.has(key));
      }
      ui.setScore(`ยืนที่ (${now.at.x}, ${now.at.y}) ส่งแล้ว ${now.sent} จาก ${p.pts.length} ฉบับ เดินรวม ${now.total}`);
    }

    function move(q: HmPt): void {
      const p = puzzles[pi];
      const now = cur();
      if (now.sent >= p.pts.length) {
        ui.setStatus('ส่งครบแล้วครับ กดเริ่มใหม่หรือย้อนหนึ่งก้าวเพื่อลองทางอื่น', 'plain');
        return;
      }
      if (q.x === now.at.x && q.y === now.at.y) return;
      const total = now.total + Math.abs(q.x - now.at.x) + Math.abs(q.y - now.at.y);
      const sent = deliver(p, q, now.sent);
      hist.push({ at: q, sent, total });
      if (sent >= p.pts.length) {
        if (total === p.best) ui.setStatus(`ส่งครบด้วยระยะ ${total} ต่ำสุดของชุดนี้แล้วครับ`, 'good');
        else if (total > p.best) ui.setStatus(`ส่งครบแล้ว เดินรวม ${total} แต่ชุดนี้ทำได้ ${p.best} ลองย้อนดูว่าก้าวไหนเสียเปรียบ`, 'bad');
      } else if (sent > now.sent) ui.setStatus(`ส่งได้ ${sent - now.sent} ฉบับตรงจุดนี้`, 'plain');
      else ui.setStatus('จุดนี้ยังไม่อยู่แนวเดียวกับร้านถัดไป ยังส่งไม่ได้', 'plain');
      render();
    }

    function selectPuzzle(k: number): void {
      pi = k;
      const p = puzzles[pi];
      const start: HmPt = { x: 0, y: 0 };
      hist = [{ at: start, sent: deliver(p, start, 0), total: 0 }];
      ui.selectTab(k);
      ui.setTease(p.tease);
      ui.setStatus(
        hist[0].sent > 0 ? `จุดเริ่มอยู่แนวเดียวกับร้านแรกพอดี ส่งไปได้ ${hist[0].sent} ฉบับโดยไม่ต้องเดิน` : 'คลิกจุดบนตารางเพื่อเดินไปยืนตรงนั้น',
      );
      render();
    }

    ui.root.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest('[data-hm-cell]');
      if (!(btn instanceof HTMLElement)) return;
      move(parse(btn.dataset.hmCell ?? '0:0'));
    });
    ui.onClick('data-hm-undo', () => {
      if (hist.length > 1) hist.pop();
      ui.setStatus('ย้อนกลับไปหนึ่งก้าว');
      render();
    });
    ui.onClick('data-hm-reset', () => selectPuzzle(pi));
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initHermesGame);
</script>

