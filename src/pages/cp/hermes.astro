        </thead>
        <tbody>
          <tr><td><code>row[i][c]</code></td><td><code>row[i-1][c]</code></td><td><code>|Y[i-1] - Y[i]|</code></td><td>ทุก c</td></tr>
          <tr><td><code>row[i][c]</code></td><td><code>col[i-1][c']</code> ทุก c'</td><td><code>|c' - Y[i]|</code></td><td>เฉพาะ c = X[i-1]</td></tr>
          <tr><td><code>col[i][c]</code></td><td><code>col[i-1][c]</code></td><td><code>|X[i-1] - X[i]|</code></td><td>ทุก c</td></tr>
          <tr><td><code>col[i][c]</code></td><td><code>row[i-1][c']</code> ทุก c'</td><td><code>|c' - X[i]|</code></td><td>เฉพาะ c = Y[i-1]</td></tr>
        </tbody>
