/** ตัวตรวจอิสระ: ระบายสองสีด้วย BFS บนเส้นที่มีอยู่ ณ ตอนนั้น */
function twoColorable(n: number, edges: [number, number][]): boolean {
  const col = Array<number>(n + 1).fill(-1);
  for (let s = 1; s <= n; s++) {
    if (col[s] !== -1) continue;
    col[s] = 0;
    const qu = [s];
    while (qu.length > 0) {
      const u = qu.shift() ?? s;
      for (const [a, b] of edges) {
        const v = a === u ? b : b === u ? a : 0;
        if (!v) continue;
        if (col[v] === -1) {
          col[v] = 1 - col[u];
          qu.push(v);
        }
        else if (col[v] === col[u]) return false;
      }
    }
  }
  return true;
}
