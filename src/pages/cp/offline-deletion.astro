using namespace std;

int n, m, q;
vector<vector<char>> a;       // a[i][j] ก่อนกลับด้าน: มีหนังสือจริงเมื่อ a[i][j] != inv[i]
vector<int> inv, cnt;         // inv[i] = ชั้น i ถูกกลับด้านอยู่ไหม, cnt[i] = จำนวนหนังสือบนชั้น i
