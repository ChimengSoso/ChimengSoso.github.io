const href = 'offline-deletion/';
const R = 15;
const range = (a: number, b: number): number[] => Array.from({ length: Math.max(0, b - a + 1) }, (_, i) => a + i);

/* ================================================================
 * ตัวอย่างเดียวที่ใช้ทั้งบท: 4 จุด เส้นตั้งต้น 1-2, 1-4, 2-3 แล้วเพิ่ม 1-3 และลบ 1-2
 * ช่วงอายุ ต้นไม้ ตัวเดิน และเวอร์ชันที่บีบทางเดิน ทุกชิ้นคำนวณจากตัวจำลองข้างล่าง
 * ================================================================ */
type Ev = [1 | 2, number, number];
const EX_N = 4;
const EX_INIT: [number, number][] = [[1, 2], [1, 4], [2, 3]];
const EX_EVENTS: Ev[] = [[1, 1, 3], [2, 1, 2]];
const EX_Q = EX_EVENTS.length + 1; // จุดเวลา 0 คือก่อนเหตุการณ์แรก
const key = (a: number, b: number): string => `${Math.min(a, b)}-${Math.max(a, b)}`;

type Life = { e: string; a: number; b: number; l: number; r: number };
/** แปลงเหตุการณ์เป็นช่วงอายุ ลำดับเดียวกับโค้ด C++: เส้นที่ถูกลบออกก่อน แล้วค่อยเส้นที่เหลือเรียงตามคู่จุด */
function lifetimes(init: [number, number][], events: Ev[], q: number): Life[] {
  const born = new Map<string, number>();
  const out: Life[] = [];
  for (const [a, b] of init) born.set(key(a, b), 0);
  events.forEach(([t, a, b], i) => {
    const k = key(a, b);
    if (t === 1) born.set(k, i + 1);
    else {
      out.push({ e: k, a: Math.min(a, b), b: Math.max(a, b), l: born.get(k) ?? 0, r: i });
      born.delete(k);
    }
  });
  [...born.entries()]
    .sort((p, s) => (p[0] < s[0] ? -1 : 1))
    .forEach(([k, l]) => {
      const [a, b] = k.split('-').map(Number);
      out.push({ e: k, a, b, l, r: q - 1 });
    });
  return out;
}
const exLives = lifetimes(EX_INIT, EX_EVENTS, EX_Q);

/** ตัวตรวจอิสระ: นับก๊วนใหม่ด้วยการเดินกราฟทุกจุดเวลา ไม่มี DSU ไม่มีต้นไม้ */
function compsAt(n: number, edges: [number, number][]): number {
  const adj = Array.from({ length: n + 1 }, () => [] as number[]);
  for (const [a, b] of edges) {
    adj[a].push(b);
    adj[b].push(a);
  }
  const seen = new Set<number>();
  let c = 0;
  for (let s = 1; s <= n; s++) {
    if (seen.has(s)) continue;
    c++;
    const st = [s];
    seen.add(s);
    while (st.length > 0) {
      const u = st.pop() ?? s;
      for (const v of adj[u]) {
        if (seen.has(v)) continue;
        seen.add(v);
        st.push(v);
      }
    }
  }
  return c;
}
const exTruth = range(0, EX_Q - 1).map((t) =>
  compsAt(EX_N, exLives.filter((L) => L.l <= t && t <= L.r).map((L) => [L.a, L.b] as [number, number])),
);

/* ---------- ต้นไม้ช่วงบนแกนเวลา + DSU ย้อนกลับได้ ในแบบที่สร้างขั้นให้ตัวเดิน ---------- */
type TNode = { id: number; l: number; r: number; items: Life[] };
function buildTree(q: number, lives: Life[]): Map<number, TNode> {
  const tree = new Map<number, TNode>();
  const make = (v: number, l: number, r: number): void => {
    tree.set(v, { id: v, l, r, items: [] });
    if (l === r) return;
    const m = Math.floor((l + r) / 2);
    make(2 * v, l, m);
    make(2 * v + 1, m + 1, r);
  };
  make(1, 0, q - 1);
  const add = (v: number, l: number, r: number, L: Life): void => {
    if (L.r < l || r < L.l) return;
    if (L.l <= l && r <= L.r) {
      tree.get(v)?.items.push(L);
      return;
    }
    const m = Math.floor((l + r) / 2);
    add(2 * v, l, m, L);
    add(2 * v + 1, m + 1, r, L);
  };
  for (const L of lives) add(1, 0, q - 1, L);
  return tree;
}
const exTree = buildTree(EX_Q, exLives);
const exNodes = [...exTree.values()].sort((a, b) => a.id - b.id);

type DStep = {
  note: string;
  at: number; // ปมที่กำลังอยู่
  path: number[]; // ปมจากรากถึงปมปัจจุบัน
  par: number[];
  sz: number[];
  stk: number[];
  comps: number;
  answers: (number | null)[];
  hot: number; // ช่อง par ที่เพิ่งเปลี่ยน (0 = ไม่มี)
};
/** เดิน dfs(v, l, r) แบบเดียวกับ C++ แล้วจดทุกจังหวะ ถ้า compress เป็นจริงจะบีบทางเดินใน find ด้วย (รุ่นที่ผิด) */
function simulate(n: number, q: number, tree: Map<number, TNode>, compress: boolean): { steps: DStep[]; answers: number[] } {
  const par = range(0, n);
  const sz = Array<number>(n + 1).fill(1);
  const stk: number[] = [];
  let comps = n;
  const answers: (number | null)[] = Array<number | null>(q).fill(null);
  const steps: DStep[] = [];
  const snap = (note: string, at: number, path: number[], hot = 0): void => {
    steps.push({ note, at, path: [...path], par: [...par], sz: [...sz], stk: [...stk], comps, answers: [...answers], hot });
  };
  const find = (x: number): number => {
    let r = x;
    while (par[r] !== r) r = par[r];
    if (compress)
      for (let y = x; par[y] !== r && y !== r; ) {
        const nx = par[y];
        par[y] = r;
        y = nx;
      }
    return r;
  };
  const dfs = (v: number, path: number[]): void => {
    const node = tree.get(v);
    if (!node) return;
    const here = [...path, v];
    const keep = stk.length;
    const span = node.l === node.r ? `ใบ t=${node.l}` : `ช่วง [${node.l},${node.r}]`;
    snap(
      `เข้าปม ${v} (${span}) จด keep = ${keep} ${node.items.length === 0 ? 'ปมนี้ไม่มีเส้นให้ใส่' : `ปมนี้มีเส้น ${node.items.map((L) => L.e).join(', ')}`}`,
      v,
      here,
    );
    for (const L of node.items) {
      const before = [...par];
      let a = find(L.a);
      let b = find(L.b);
      const silent = before.some((p, i) => p !== par[i]);
      if (a === b) {
        snap(
          `unite(${L.a}, ${L.b}): หัวของทั้งคู่คือ ${a} อยู่ก๊วนเดียวกันแล้ว ไม่รวม ไม่มีอะไรลงสแต็ก${silent ? ` <b>แต่ find เพิ่งบีบทางเดิน แก้ par ไปโดยไม่จดลงสแต็ก</b>` : ''}`,
          v,
          here,
          silent ? before.findIndex((p, i) => p !== par[i]) : 0,
        );
        continue;
      }
      if (sz[a] < sz[b]) [a, b] = [b, a];
      par[b] = a;
      sz[a] += sz[b];
      stk.push(b);
      comps--;
      snap(`unite(${L.a}, ${L.b}): ${b} ไปขึ้นกับ ${a} ผลักลูก ${b} ลงสแต็ก เหลือ ${comps} ก๊วน`, v, here, b);
    }
    if (node.l === node.r) {
      answers[node.l] = comps;
      snap(`ถึงใบ t=${node.l} เส้นที่มีชีวิตตอนนี้คือทุกเส้นบนทางจากรากถึงใบนี้พอดี ตอบ <b>${comps}</b> ก๊วน`, v, here);
    } else {
      dfs(2 * v, here);
      dfs(2 * v + 1, here);
    }
    if (stk.length === keep) {
      snap(`ออกจากปม ${v} สแต็กยาว ${keep} เท่า keep อยู่แล้ว ไม่ต้องย้อนอะไร`, v, here);
      return;
    }
    while (stk.length > keep) {
      const b = stk.pop() ?? 0;
      const a = par[b];
      sz[a] -= sz[b];
      par[b] = b;
      comps++;
      snap(`ออกจากปม ${v}: rollback ถอด ${b} ออกจากใต้ ${a} คืน sz[${a}] เป็น ${sz[a]} กลับเป็น ${comps} ก๊วน`, v, here, b);
    }
  };
  snap(`เริ่ม ทุกคนเป็นหัวก๊วนของตัวเอง ${n} ก๊วน สแต็กว่าง`, 0, []);
  dfs(1, []);
  return { steps, answers: answers.map((x) => x ?? -1) };
}
const exGood = simulate(EX_N, EX_Q, exTree, false);
const exBad = simulate(EX_N, EX_Q, exTree, true);
if (exGood.answers.join(' ') !== exTruth.join(' ')) throw new Error('offline-deletion: ตัวเดินตอบไม่ตรงกับการเดินกราฟใหม่ทุกจุดเวลา');
if (exBad.answers.join(' ') === exTruth.join(' ')) throw new Error('offline-deletion: ตัวอย่างนี้ไม่ได้ทำให้รุ่นบีบทางเดินผิดแล้ว');
const exBadLeaf = exBad.answers.findIndex((x, i) => x !== exTruth[i]);
const exSilent = exBad.steps.find((s) => s.note.includes('แก้ par ไปโดยไม่จดลงสแต็ก'));
const exSilentNode = exSilent ? exSilent.hot : 0;

/* ---------- ภาพที่ 1: ช่วงอายุบนแกนเวลาของตัวอย่าง ---------- */
const L_X0 = 150;
const L_CELL = 170;
const L_Y0 = 58;
const L_ROW = 40;
const lx = (t: number): number => L_X0 + t * L_CELL;
const lifeVB = `0 0 ${lx(EX_Q) + 12} ${L_Y0 + exLives.length * L_ROW + 34 + 30}`;

/* ---------- ภาพที่ 2 + เกม: หั่นช่วงลงต้นไม้บนแกนเวลา 16 ใบ ---------- */
const G_LEAVES = 16;
const G_DEPTH = Math.log2(G_LEAVES);
type Block = { d: number; k: number; l: number; r: number };
const blocks: Block[] = [];
for (let d = 0; d <= G_DEPTH; d++) {
  const w = G_LEAVES >> d;
  for (let k = 0; k < 1 << d; k++) blocks.push({ d, k, l: k * w, r: k * w + w - 1 });
}
/** จำนวนปมน้อยสุดที่คลุม [l, r] พอดี หาด้วยทางลัดบนตำแหน่ง (ขั้นละหนึ่งบล็อกที่เริ่มตรงนั้น)
 *  ไม่ได้ใช้การแตกช่วงแบบ segment tree ที่บทสอน */
function minCover(l: number, r: number): number {
  const dist = Array<number>(G_LEAVES + 1).fill(Infinity);
  dist[l] = 0;
  for (let p = l; p <= r; p++)
    for (const b of blocks) if (b.l === p && b.r <= r) dist[b.r + 1] = Math.min(dist[b.r + 1], dist[p] + 1);
  return dist[r + 1];
}
/** การแตกช่วงแบบที่บทสอน ใช้วาดภาพที่ 2 */
function decompose(l: number, r: number): Block[] {
  const out: Block[] = [];
  const go = (d: number, k: number): void => {
    const w = G_LEAVES >> d;
    const bl = k * w;
    const br = bl + w - 1;
    if (r < bl || br < l) return;
    if (l <= bl && br <= r) {
      out.push({ d, k, l: bl, r: br });
      return;
    }
    go(d + 1, 2 * k);
    go(d + 1, 2 * k + 1);
  };
  go(0, 0);
  return out;
}
const D2 = { l: 3, r: 12 };
const d2Blocks = decompose(D2.l, D2.r);
if (d2Blocks.length !== minCover(D2.l, D2.r)) throw new Error('offline-deletion: การแตกช่วงไม่ได้จำนวนปมน้อยสุด');
let worstCover = 0;
for (let l = 0; l < G_LEAVES; l++) for (let r = l; r < G_LEAVES; r++) worstCover = Math.max(worstCover, minCover(l, r));
for (let l = 0; l < G_LEAVES; l++)
  for (let r = l; r < G_LEAVES; r++)
    if (decompose(l, r).length !== minCover(l, r)) throw new Error(`offline-deletion: การแตกช่วง [${l},${r}] ไม่น้อยสุด`);
const T_X0 = 40;
const T_CELL = 40;
const T_Y0 = 40;
const T_ROW = 40;
const tx = (p: number): number => T_X0 + p * T_CELL;
const treeVB = `0 0 ${tx(G_LEAVES) + 12} ${T_Y0 + (G_DEPTH + 1) * T_ROW + 26 + 34}`;
const inD2 = (b: Block): boolean => d2Blocks.some((x) => x.d === b.d && x.k === b.k);

type CutPuzzle = { id: string; label: string; tease: string; l: number; r: number; best: number };
const cutRaw: Omit<CutPuzzle, 'best'>[] = [
  { id: 'a', label: 'ชุด ก', tease: 'ช่วงอายุยาวแปดจุดเวลา', l: 8, r: 15 },
  { id: 'b', label: 'ชุด ข', tease: 'ช่วงอายุยาวแค่สองจุดเวลา', l: 7, r: 8 },
  { id: 'c', label: 'ชุด ค', tease: 'ช่วงอายุยาวเกือบทั้งแกน', l: 1, r: 14 },
  { id: 'd', label: 'ชุด ง', tease: 'ช่วงอายุยาวหกจุดเวลา', l: 5, r: 10 },
];
const cutPuzzles: CutPuzzle[] = cutRaw.map((p) => ({ ...p, best: minCover(p.l, p.r) }));
const cutJson = JSON.stringify(cutPuzzles);

/* ---------- ตัวเดินหลัก ---------- */
const exStepsGood = exGood.steps;
const walkRows = exNodes.map((n) => ({ id: n.id, span: n.l === n.r ? `t=${n.l}` : `[${n.l},${n.r}]`, items: n.items.map((L) => L.e) }));

/* ---------- โค้ด ---------- */
const codeCore = `#include <bits/stdc++.h>
using namespace std;

const int MAXN = 100005, MAXQ = 100005;   // จุดเวลามี k+1 จุด
int n, m, k, Q, comps;
int par[MAXN], sz[MAXN];
vector<int> stk;                  // ลูกที่ถูกย้ายไปขึ้นกับแม่ เรียงตามลำดับที่รวม
vector<pair<int,int>> node[4 * MAXQ];
int ans[MAXQ];

// ไม่บีบทางเดิน เพราะการบีบแก้ par หลายช่องที่สแต็กไม่ได้จดไว้ ย้อนกลับไม่ได้
int find(int x) {
    while (par[x] != x) x = par[x];
    return x;
}

// รวมตามขนาดอย่างเดียว ความลึกจึงไม่เกิน log2(n) และ find เป็น O(log n) จริงทุกครั้ง
bool unite(int a, int b) {
    a = find(a), b = find(b);
    if (a == b) return false;
    if (sz[a] < sz[b]) swap(a, b);
    par[b] = a;
    sz[a] += sz[b];
    stk.push_back(b);
    comps--;
    return true;
}

// การรวมหนึ่งครั้งแก้แค่ par[b] กับ sz[a] และ a ยังเป็น par[b] อยู่ จึงถอดคืนได้จากลูกตัวเดียว
void rollback(int keep) {
    while ((int)stk.size() > keep) {
        int b = stk.back(); stk.pop_back();
        sz[par[b]] -= sz[b];
        par[b] = b;
        comps++;
    }
}

// แตกช่วงอายุ [ql, qr] ลงปมที่คลุมพอดี แบบเดียวกับการอัปเดตช่วงของ segment tree
void addRange(int v, int l, int r, int ql, int qr, pair<int,int> item) {
    if (qr < l || r < ql) return;
    if (ql <= l && r <= qr) { node[v].push_back(item); return; }
    int mid = (l + r) / 2;
    addRange(2 * v, l, mid, ql, qr, item);
    addRange(2 * v + 1, mid + 1, r, ql, qr, item);
}

// เส้นบนปม v มีชีวิตตลอดช่วง [l, r] จึงใส่ครั้งเดียวแล้วใช้ได้กับทุกใบข้างใต้
void dfs(int v, int l, int r) {
    int keep = stk.size();
    for (auto [a, b] : node[v]) unite(a, b);
    if (l == r) ans[l] = comps;
    else {
        int mid = (l + r) / 2;
        dfs(2 * v, l, mid);
        dfs(2 * v + 1, mid + 1, r);
    }
    rollback(keep);
}

int main() {
    ios::sync_with_stdio(false); cin.tie(nullptr);
    cin >> n >> m >> k;
    Q = k + 1;                    // จุดเวลา 0 คือก่อนเหตุการณ์แรก จุด i คือหลังเหตุการณ์ที่ i
    map<pair<int,int>, int> born; // เส้นที่ยังอยู่ -> จุดเวลาที่เกิด
    for (int i = 0; i < m; i++) {
        int a, b; cin >> a >> b;
        born[{min(a, b), max(a, b)}] = 0;
    }
    for (int i = 1; i <= k; i++) {
        int t, a, b; cin >> t >> a >> b;
        pair<int,int> e = {min(a, b), max(a, b)};   // ลบอาจเขียนสลับข้างกับตอนเพิ่ม
        if (t == 1) born[e] = i;
        else {
            addRange(1, 0, Q - 1, born[e], i - 1, e); // ถูกลบที่ i จึงอยู่ถึง i-1
            born.erase(e);
        }
    }
    for (auto [e, s] : born) addRange(1, 0, Q - 1, s, Q - 1, e);

    for (int i = 1; i <= n; i++) par[i] = i, sz[i] = 1;
    comps = n;
    dfs(1, 0, Q - 1);
    for (int i = 0; i < Q; i++) cout << ans[i] << (i + 1 < Q ? ' ' : '\\n');
    return 0;
}`;
