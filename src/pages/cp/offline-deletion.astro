    // จึงไม่เกิน y ค่าสูงสุดของอาร์เรย์เลยเท่ากับ y พอดี
    vector<int> out;
    for (int y = 1; y <= n; y++)
        if (ans[y]) out.push_back(y);
    cout << out.size() << "\\n";
    for (int y : out) cout << y << " ";
    cout << "\\n";
}`;

