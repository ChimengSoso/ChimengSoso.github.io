vector<vector<int>> child;    // child[v] = คำสั่งที่ต่อจากเวอร์ชัน v

// กลับด้านชั้น i ทำซ้ำอีกครั้งก็คือการย้อน
void flipShelf(int i) {
    inv[i] ^= 1;
    total += m - 2 * cnt[i];
    cnt[i] = m - cnt[i];
}

// ทำคำสั่ง v คืนว่าตู้เปลี่ยนจริงไหม วางบนช่องที่มีหนังสือหรือหยิบจากช่องว่างไม่เปลี่ยนอะไร
bool apply(int v) {
    if (t[v] == 3) { flipShelf(x[v]); return true; }
    if (t[v] != 1 && t[v] != 2) return false;   // เวอร์ชัน 0 กับคำสั่งแบบ 4 ไม่แตะตู้
    int i = x[v], j = y[v], d = t[v] == 1 ? 1 : -1;
    bool has = a[i][j] != inv[i];
    if (has == (t[v] == 1)) return false;
    a[i][j] ^= 1, cnt[i] += d, total += d;
    return true;
}

// rollback คำสั่ง v ที่เปลี่ยนตู้จริง
void undo(int v) {
    if (t[v] == 3) { flipShelf(x[v]); return; }
    int i = x[v], j = y[v], d = t[v] == 1 ? 1 : -1;
    a[i][j] ^= 1, cnt[i] -= d, total -= d;
}

