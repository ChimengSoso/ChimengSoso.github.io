 * ================================================================ */
type Pt = { x: number; y: number };
const seg = (a: Pt, b: Pt, pad = R) => {
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const len = Math.hypot(dx, dy);
  return { x1: a.x + (dx / len) * pad, y1: a.y + (dy / len) * pad, x2: b.x - (dx / len) * pad, y2: b.y - (dy / len) * pad };
};
/** ป้ายน้ำหนักเยื้องตามเส้นตั้งฉาก ให้อยู่ด้านบนของเส้นเสมอ
 *  เส้นที่เกือบตั้งจะดันป้ายออกด้านข้าง จึงต้องเยื้องเพิ่มอีกครึ่งความกว้างของป้าย (halfW) ไม่งั้นเส้นลากทับตัวหนังสือ */
const edgeLabel = (a: Pt, b: Pt, off = 13, halfW = 0): Pt => {
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const len = Math.hypot(dx, dy);
  let nx = dy / len;
  let ny = -dx / len;
  if (ny > 0 || (ny === 0 && nx < 0)) [nx, ny] = [-nx, -ny];
  const k = off + halfW * Math.abs(nx);
  return { x: (a.x + b.x) / 2 + nx * k, y: (a.y + b.y) / 2 + ny * k + 4 };
};
