<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type CutPuzzle = { id: string; label: string; tease: string; l: number; r: number; best: number };
  const LEAVES = 16;

  function isCut(x: unknown): x is CutPuzzle {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return typeof o.l === 'number' && typeof o.r === 'number' && typeof o.best === 'number' && typeof o.tease === 'string';
  }

  function initCutGame(): void {
    const maybeUi = cpGameUi('[data-cutgame]');
    if (!maybeUi) return;
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root).filter(isCut);
    const boardEl = ui.root.querySelector<HTMLElement>('[data-cut-board]');
    const rangeEl = ui.root.querySelector<HTMLElement>('[data-cut-range]');
    if (puzzles.length === 0 || !boardEl || !rangeEl) return;
    const board: HTMLElement = boardEl;
    const rangeOut: HTMLElement = rangeEl;

    let pi = 0;
    let picked = new Set<string>();
    const depth = Math.log2(LEAVES);

    const span = (id: string): [number, number] => {
      const [d, k] = id.split('.').map(Number);
      const w = LEAVES >> d;
      return [k * w, k * w + w - 1];
    };
    const cover = (): number[] => {
      const c = Array<number>(LEAVES).fill(0);
      for (const id of picked) {
        const [l, r] = span(id);
        for (let p = l; p <= r; p++) c[p]++;
      }
      return c;
    };

    function build(): void {
      board.textContent = '';
      for (let d = 0; d <= depth; d++) {
        const w = LEAVES >> d;
        for (let k = 0; k < 1 << d; k++) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'cut-n';
          b.dataset.id = `${d}.${k}`;
          b.style.gridColumn = `${k * w + 1} / span ${w}`;
          b.textContent = w === 1 ? String(k) : `${k * w}-${k * w + w - 1}`;
          b.setAttribute('aria-label', `ปมที่คลุมจุดเวลา ${k * w} ถึง ${k * w + w - 1}`);
          board.appendChild(b);
        }
      }
      for (let p = 0; p < LEAVES; p++) {
        const bar = document.createElement('span');
        bar.className = 'cut-bar';
        bar.dataset.p = String(p);
        board.appendChild(bar);
      }
    }

    function render(): void {
      const p = puzzles[pi];
      const c = cover();
      for (const b of Array.from(board.querySelectorAll<HTMLElement>('.cut-n'))) b.classList.toggle('on', picked.has(b.dataset.id ?? ''));
      for (const bar of Array.from(board.querySelectorAll<HTMLElement>('.cut-bar'))) {
        const q = Number(bar.dataset.p);
        const want = q >= p.l && q <= p.r;
        bar.classList.toggle('want', want && c[q] === 0);
        bar.classList.toggle('got', want && c[q] === 1);
        bar.classList.toggle('over', c[q] > 1 || (!want && c[q] > 0));
      }
      rangeOut.textContent = `[${p.l}, ${p.r}]`;
      ui.setScore(picked.size === 0 ? 'ยังไม่ได้เลือกปม' : `เลือกไปแล้ว ${picked.size} ปม`);
    }

    function check(): void {
      const p = puzzles[pi];
      const c = cover();
      const extra = c.some((x, q) => x > 0 && (q < p.l || q > p.r));
      const twice = c.some((x) => x > 1);
      const gap = range().some((q) => c[q] === 0);
      if (twice) return ui.setStatus('มีจุดเวลาที่ถูกคลุมสองครั้ง (แถบแดง) เส้นจะถูกใส่ซ้ำ ลองเอาปมที่ซ้อนออก', 'bad');
      if (extra) return ui.setStatus('มีปมที่คลุมเลยช่วงอายุออกไป (แถบแดง) เส้นจะไปมีชีวิตในจุดเวลาที่มันตายแล้ว', 'bad');
      if (gap) return ui.setStatus('ยังมีจุดเวลาในช่วงที่ไม่มีปมไหนคลุม (แถบทอง) เส้นจะหายไปตรงนั้น', 'bad');
      if (picked.size === p.best) return ui.setStatus(`คลุมพอดีด้วย ${picked.size} ปม ซึ่งน้อยที่สุดที่ช่วงนี้ทำได้แล้ว`, 'good');
      ui.setStatus(`คลุมพอดีแล้ว แต่ใช้ ${picked.size} ปม ช่วงนี้ทำได้ด้วย ${p.best} ปม ลองรวมปมพี่น้องที่เลือกทั้งคู่ขึ้นไปเป็นแม่`, 'bad');
    }
    const range = (): number[] => {
      const p = puzzles[pi];
      return Array.from({ length: p.r - p.l + 1 }, (_, i) => p.l + i);
    };

    function selectPuzzle(t: number): void {
      pi = t;
      picked = new Set<string>();
      ui.selectTab(t);
      ui.setTease(puzzles[t].tease);
      ui.setStatus('เลือกปมที่คลุมช่วงสีทองให้พอดี');
      render();
    }

    board.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const b = e.target.closest('.cut-n');
      if (!(b instanceof HTMLElement)) return;
      const id = b.dataset.id ?? '';
      if (picked.has(id)) picked.delete(id);
      else picked.add(id);
      ui.setStatus('เลือกต่อ แล้วกดตรวจคำตอบเมื่อพร้อม');
      render();
    });

    build();
    ui.onClick('data-cut-reset', () => selectPuzzle(pi));
    ui.onClick('data-cut-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initCutGame);
</script>

<script>
  import { initCpPlayers } from '../../lib/cpPlayer';

  type DStep = { note: string; at: number; path: number[]; par: number[]; sz: number[]; stk: number[]; comps: number; answers: (number | null)[]; hot: number };

  function isDStep(x: unknown): x is DStep {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return typeof o.note === 'string' && Array.isArray(o.par) && Array.isArray(o.sz) && Array.isArray(o.stk) && Array.isArray(o.answers) && typeof o.hot === 'number';
  }

  document.addEventListener('astro:page-load', () => {
    initCpPlayers<DStep>('[data-odsim]', {
      narrow: (raw) => {
        const ok = raw.filter(isDStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      draw: (st, ctx) => {
        const root = ctx.parts.root;
        let live: HTMLTableCellElement | null = null;
        for (const td of Array.from(root.querySelectorAll<HTMLTableCellElement>('td[data-od-par]'))) {
          const v = Number(td.dataset.odPar);
          td.textContent = String(st.par[v]);
          td.classList.toggle('is-hot', v === st.hot);
          td.classList.toggle('is-root', st.par[v] === v);
          if (v === st.hot) live = td;
        }
        for (const td of Array.from(root.querySelectorAll<HTMLTableCellElement>('td[data-od-sz]'))) {
          td.textContent = String(st.sz[Number(td.dataset.odSz)]);
        }
        const stk = root.querySelector<HTMLElement>('[data-od-stk]');
        if (stk) stk.textContent = `[${st.stk.join(', ')}]  ·  ${st.comps} ก๊วน`;
        const path = root.querySelector<HTMLElement>('[data-od-path]');
        if (path) path.textContent = st.path.length ? st.path.map((v) => `ปม ${v}`).join(' → ') : 'ยังไม่เข้า';
        const ans = root.querySelector<HTMLElement>('[data-od-ans]');
        if (ans) ans.textContent = st.answers.map((a, t) => `t${t}: ${a === null ? '·' : a}`).join('   ');
        ctx.keepInView(live);
      },
    });
  });
</script>
