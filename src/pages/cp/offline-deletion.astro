function extend(pts: [number, number][]): Set<string> {
  const S = new Set(pts.map(([x, y]) => `${x},${y}`));
  let grew = true;
  while (grew) {
    grew = false;
    const arr = [...S].map((s) => s.split(',').map(Number));
    for (const [x1, y1] of arr)
      for (const [, y2] of arr.filter(([x]) => x === x1))
        for (const [x2] of arr.filter(([, y]) => y === y1))
          if (!S.has(`${x2},${y2}`)) {
            S.add(`${x2},${y2}`);
            grew = true;
          }
  }
  return S;
}
