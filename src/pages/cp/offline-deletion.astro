int find(int x) {  // ไม่บีบทางเดิน เพราะต้อง rollback ได้
    while (par[x] != x) x = par[x];
    return x;
}

void unite(int a, int b) {
    a = find(a), b = find(b);
    if (a == b) return;
    if (sz[a] < sz[b]) swap(a, b);
    par[b] = a, sz[a] += sz[b];
    stk.push_back(b);
}

void rollback(int keep) {
    while ((int)stk.size() > keep) {
        int b = stk.back();
        stk.pop_back();
        sz[par[b]] -= sz[b];
        par[b] = b;
    }
}

int Q;
vector<vector<pair<int,int>>> node;   // node[v] = การพบกันที่ยังนับอยู่ตลอดช่วงของปม v

