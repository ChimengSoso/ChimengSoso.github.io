          <circle cx={P10_POS[v].x} cy={P10_POS[v].y} r={R} fill="#1b2436" stroke="#4a5a7d" stroke-width="1.6" />
          <text x={P10_POS[v].x} y={P10_POS[v].y + 4} fill="#cdd6ea" font-size="12" text-anchor="middle" font-family="monospace">{v}</text>
        </>
      ))}
