function xorShortest(edges: [number, number, number][], s: number, t: number): number {
  const seen = new Set<string>([`${s},0`]);
  const qu: [number, number][] = [[s, 0]];
  let best = Infinity;
  while (qu.length > 0) {
    const [u, x] = qu.shift() ?? [s, 0];
    if (u === t) best = Math.min(best, x);
    for (const [a, b, w] of edges) {
      const v = a === u ? b : b === u ? a : 0;
      if (!v) continue;
      const k2 = `${v},${x ^ w}`;
      if (seen.has(k2)) continue;
      seen.add(k2);
      qu.push([v, x ^ w]);
    }
  }
  return best;
}
