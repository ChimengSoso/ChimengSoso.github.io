  .mg-slots :global(.mg-slot.fresh){border-color:var(--dl-emerald);color:var(--dl-emerald-bright);}
  .mg-send{
    margin-top:0.6rem;
    width:100%;
    font:inherit;
    font-size:0.76rem;
    cursor:pointer;
    border-radius:9px;
    padding:0.4rem 0.6rem;
