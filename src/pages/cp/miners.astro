  .dps-say :global(.dps-q b){color:var(--dl-gold);font-family:"Fira Code","Fira Mono",monospace;}
  .dps-say :global(.dps-a){margin:0.4rem 0 0;color:var(--dl-emerald-bright);font-weight:700;font-size:0.8rem;}
  .dps-say :global(.dps-a b){font-family:"Fira Code","Fira Mono",monospace;}

  /* ---- เกมแจกของ ---- */
  .minegame{
    margin:1.5rem 0 0.5rem;
    border:1px solid var(--dl-border);
