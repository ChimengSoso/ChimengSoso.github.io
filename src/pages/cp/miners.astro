const href = 'miners/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ไม่มีเลขไหนพิมพ์ด้วยมือ ---------- */

/** 0 = ช่องว่าง (ยังไม่เคยมีของมาถึง), 1 = M, 2 = F, 3 = B */
type Food = 0 | 1 | 2 | 3;
const NAME: Record<Food, string> = { 0: '·', 1: 'M', 2: 'F', 3: 'B' };
const CODE: Record<string, Food> = { M: 1, F: 2, B: 3 };

const parse = (s: string): Food[] => [...s].map((c) => CODE[c]);

/** ถ่านที่ได้จากชิ้นล่าสุดสามชิ้น = จำนวนชนิดอาหารที่ไม่ซ้ำกัน (ช่องว่างไม่นับ) */
function coal(a: Food, b: Food, c: Food): number {
  const seen = new Set<Food>([a, b, c]);
  seen.delete(0);
  return seen.size;
}

/** สถานะ = คู่ล่าสุดของแต่ละเหมือง เขียนเป็น "x1,y1,x2,y2" (y คือชิ้นล่าสุด) */
type Key = string;
const keyOf = (x1: Food, y1: Food, x2: Food, y2: Food): Key => `${x1},${y1},${x2},${y2}`;
const partsOf = (k: Key): Food[] => k.split(',').map(Number) as Food[];

/** ตารางสถานะหลังส่งของครบ i ชิ้น (คืนมาทีละแถว ตั้งแต่แถว i = 0) */
function layers(seq: Food[]): Map<Key, number>[] {
  const out: Map<Key, number>[] = [new Map([[keyOf(0, 0, 0, 0), 0]])];
  for (const f of seq) {
    const cur = out[out.length - 1];
    const nxt = new Map<Key, number>();
    const put = (k: Key, v: number) => {
      const old = nxt.get(k);
      if (old === undefined || v > old) nxt.set(k, v);
    };
    for (const [k, v] of cur) {
      const [x1, y1, x2, y2] = partsOf(k);
      put(keyOf(y1, f, x2, y2), v + coal(x1, y1, f));
      put(keyOf(x1, y1, y2, f), v + coal(x2, y2, f));
    }
    out.push(nxt);
  }
  return out;
}

const bestOf = (seq: Food[]): number => Math.max(...layers(seq)[seq.length].values());

/** วิธีโลภ: ส่งเข้าเหมืองที่ได้ถ่านตอนนี้มากกว่า เสมอกันเลือกเหมือง 1 */
function greedy(seq: Food[]): { total: number; picks: number[] } {
  const m: [Food, Food][] = [
    [0, 0],
    [0, 0],
  ];
  let total = 0;
  const picks: number[] = [];
  for (const f of seq) {
    const g0 = coal(m[0][0], m[0][1], f);
    const g1 = coal(m[1][0], m[1][1], f);
    const k = g1 > g0 ? 1 : 0;
    total += Math.max(g0, g1);
    m[k] = [m[k][1], f];
    picks.push(k + 1);
  }
  return { total, picks };
}

/** แผนที่ดีที่สุด (ลองทุกการแบ่ง ใช้ได้เฉพาะกองสั้น ๆ ที่เอามาเล่า) */
function bestPlan(seq: Food[]): { total: number; picks: number[] } {
  const n = seq.length;
  let best = { total: -1, picks: [] as number[] };
  for (let mask = 0; mask < 1 << n; mask++) {
    const m: [Food, Food][] = [
      [0, 0],
      [0, 0],
    ];
    let total = 0;
    const picks: number[] = [];
    for (let i = 0; i < n; i++) {
      const k = (mask >> i) & 1;
      total += coal(m[k][0], m[k][1], seq[i]);
      m[k] = [m[k][1], seq[i]];
      picks.push(k + 1);
    }
    if (total > best.total) best = { total, picks };
  }
  return best;
}

/* กองที่เอามาเล่าทั้งหน้า */
const SAMPLE1 = 'MBMFFB';
const SAMPLE2 = 'MMBMBBBBMMMMMBMB';
const TRAP = 'MMFFF';

const sample1Best = bestOf(parse(SAMPLE1));
const sample2Best = bestOf(parse(SAMPLE2));
const trapGreedy = greedy(parse(TRAP));
const trapBest = bestPlan(parse(TRAP));
const sample1Plan = bestPlan(parse(SAMPLE1));

/** เดินกองตามแผนที่กำหนด เพื่อเอาไปทำตารางเล่าทีละชิ้น */
type Row = { i: number; food: string; mine: number; before: string; gain: number; total: number };
function walk(seq: Food[], picks: number[]): Row[] {
  const m: [Food, Food][] = [
    [0, 0],
    [0, 0],
  ];
  let total = 0;
  return seq.map((f, i) => {
    const k = picks[i] - 1;
    const before = `${NAME[m[k][0]]} ${NAME[m[k][1]]}`;
    const g = coal(m[k][0], m[k][1], f);
    total += g;
    m[k] = [m[k][1], f];
    return { i: i + 1, food: NAME[f], mine: k + 1, before, gain: g, total };
  });
}

const trapGreedyRows = walk(parse(TRAP), trapGreedy.picks);
const trapBestRows = walk(parse(TRAP), trapBest.picks);
const sample1Rows = walk(parse(SAMPLE1), sample1Plan.picks);

/* ---------- ตัวเล่น: ตารางสถานะทีละชิ้น ---------- */

const DEMO = TRAP;
const demoSeq = parse(DEMO);
const demoLayers = layers(demoSeq);
const DEMO_ROWS = Math.max(...demoLayers.map((l) => l.size)); // ล็อกจำนวนแถวไว้ ตารางจะได้ไม่ยืดหด

/** สถานะที่อยู่บนเส้นทางของคำตอบ ไล่ย้อนจากแผนที่ดีที่สุดกลับไปหาจุดเริ่ม */
function pathKeys(seq: Food[], picks: number[]): Key[] {
  const m: [Food, Food][] = [
    [0, 0],
    [0, 0],
  ];
  const out: Key[] = [keyOf(0, 0, 0, 0)];
  seq.forEach((f, i) => {
    const k = picks[i] - 1;
    m[k] = [m[k][1], f];
    out.push(keyOf(m[0][0], m[0][1], m[1][0], m[1][1]));
  });
  return out;
}
const demoPath = pathKeys(demoSeq, trapBest.picks);

type Cell = { m1: string; m2: string; val: string; path: boolean; top: boolean };
type SimStep = { title: string; html: string; cells: Cell[] };

const fmtPair = (a: Food, b: Food): string => `${NAME[a]} ${NAME[b]}`;

function buildSteps(): SimStep[] {
  const steps: SimStep[] = [];
  for (let i = 0; i < demoLayers.length; i++) {
    const layer = demoLayers[i];
    const top = Math.max(...layer.values());
    const rows = [...layer.entries()].sort((p, q) => q[1] - p[1] || (p[0] < q[0] ? -1 : 1));
    const cells: Cell[] = rows.map(([k, v]) => {
      const [x1, y1, x2, y2] = partsOf(k);
      return {
        m1: fmtPair(x1, y1),
        m2: fmtPair(x2, y2),
        val: String(v),
        path: k === demoPath[i],
        top: v === top,
      };
    });
    while (cells.length < DEMO_ROWS) cells.push({ m1: '·', m2: '·', val: '·', path: false, top: false });

    const prev = i > 0 ? demoLayers[i - 1].size : 0;
    const grew = i > 0 ? prev * 2 - layer.size : 0;
    const title = i === 0 ? 'ก่อนเริ่ม' : `ชิ้นที่ ${i} คือ ${NAME[demoSeq[i - 1]]}`;
    const html =
      i === 0
        ? '<p class="dps-q">เหมืองทั้งสองยังว่างเปล่า ตารางจึงมีสถานะเดียวคือ <b>· · / · ·</b> ถ่านที่ได้เท่ากับ 0</p>' +
          '<p class="dps-a">คอลัมน์แรกคือคู่ล่าสุดของเหมือง 1 คอลัมน์ที่สองคือของเหมือง 2 คอลัมน์ขวาสุดคือถ่านรวมที่ดีที่สุดที่พาสถานะนั้นมาได้</p>'
        : `<p class="dps-q">แจกของชิ้นนี้ให้ทุกสถานะที่ค้างอยู่ <b>${prev}</b> สถานะ สถานะละสองทาง (เข้าเหมือง 1 หรือเหมือง 2) ` +
          `จึงได้ปลายทาง <b>${prev * 2}</b> ครั้ง ` +
          (grew === 0
            ? 'รอบนี้ไม่มีปลายทางไหนซ้ำกันเลย '
            : `มีปลายทางซ้ำกัน <b>${grew}</b> ครั้ง ซึ่งถูกยุบเหลือตัวที่ถ่านมากกว่า `) +
          `ตารางจึงเหลือ <b>${layer.size}</b> สถานะ</p>` +
          `<p class="dps-a">ถ่านมากที่สุดตอนนี้คือ <b>${top}</b> แถวสีเขียวคือสถานะที่จะพาไปจบที่คำตอบ ${trapBest.total}</p>`;
    steps.push({ title, html, cells });
  }
  return steps;
}
const simSteps = buildSteps();

/* ---------- สูตร ---------- */

const TEX_G = `${mc.fn('g')}(x, y, c) ${mc.op('=')} |\\{x, y, c\\} \\setminus \\{\\,\\cdot\\,\\}|`;
const TEX_MOVE = [
  `${mc.fn("dp'")}\\big[(y_1, c),\\;(x_2, y_2)\\big] &${mc.op('\\;\\Leftarrow\\;')} ${mc.fn('dp')}\\big[(x_1, y_1),\\;(x_2, y_2)\\big] ${mc.op('+')} ${mc.fn('g')}(x_1, y_1, c)`,
  `${mc.fn("dp'")}\\big[(x_1, y_1),\\;(y_2, c)\\big] &${mc.op('\\;\\Leftarrow\\;')} ${mc.fn('dp')}\\big[(x_1, y_1),\\;(x_2, y_2)\\big] ${mc.op('+')} ${mc.fn('g')}(x_2, y_2, c)`,
].join(' \\\\[6pt] ');
const texG = texCode(TEX_G);
const texMove = texCode(`\\begin{aligned} ${TEX_MOVE} \\end{aligned}`);
const texAns = texCode(`${mc.fn('answer')} ${mc.op('=')} ${mc.max}_{s} \\; ${mc.fn('dp')}_{${mc.num('n')}}[s]`);

/* ---------- โค้ด ---------- */

const solution = `#include <bits/stdc++.h>
using namespace std;

// จำนวนชนิดอาหารที่ไม่ซ้ำกันในสามช่องล่าสุด (0 = ช่องว่าง ไม่นับ)
int coal(int a, int b, int c) {
    bool seen[4] = {false, false, false, false};
    seen[a] = seen[b] = seen[c] = true;
    return (int)seen[1] + (int)seen[2] + (int)seen[3];
}

int code(char c) { return c == 'M' ? 1 : (c == 'F' ? 2 : 3); }

int main() {
    int n;
    string s;
    if (!(cin >> n >> s)) return 0;

    // สถานะคือ (x1, y1, x2, y2) ช่องละ 4 ค่า อัดเป็นเลขฐานสี่สี่หลัก จึงมี 256 ช่อง
    const int S = 256;
    vector<int> cur(S, -1), nxt(S, -1);   // -1 = สถานะนี้ยังไปไม่ถึง (0 เป็นแต้มที่ถูกต้องได้)
    cur[0] = 0;                           // เริ่มต้น เหมืองทั้งสองยังว่าง

    for (int i = 0; i < n; i++) {
        int f = code(s[i]);
        fill(nxt.begin(), nxt.end(), -1); // ปลายทางถูกเขียนซ้ำได้ ต้องล้างก่อนทุกรอบ
        for (int st = 0; st < S; st++) {
            if (cur[st] < 0) continue;
            int x1 = st >> 6, y1 = (st >> 4) & 3, x2 = (st >> 2) & 3, y2 = st & 3;

            // ส่งเข้าเหมือง 1: คู่ล่าสุดของเหมือง 1 เลื่อนเป็น (y1, f) ส่วนเหมือง 2 ไม่ขยับ
            int t1 = (y1 << 6) | (f << 4) | (x2 << 2) | y2;
            int v1 = cur[st] + coal(x1, y1, f);
            if (v1 > nxt[t1]) nxt[t1] = v1;

            // ส่งเข้าเหมือง 2
            int t2 = (x1 << 6) | (y1 << 4) | (y2 << 2) | f;
            int v2 = cur[st] + coal(x2, y2, f);
            if (v2 > nxt[t2]) nxt[t2] = v2;
        }
        cur.swap(nxt);
    }

    cout << *max_element(cur.begin(), cur.end()) << '\\n';
    return 0;
}`;

const bruteCode = `// ตัวตรวจสอบแบบซื่อ ๆ ลองแบ่งทุกแบบด้วยบิตมาสก์ ใช้ได้แค่ n ราว ๆ 20
// เอาไว้สุ่มเทียบกับโค้ดจริงก่อนส่ง ไม่ใช่โค้ดที่ส่งเข้าระบบตัดสิน
#include <bits/stdc++.h>
using namespace std;

int coal(int a, int b, int c) {
    bool seen[4] = {false, false, false, false};
    seen[a] = seen[b] = seen[c] = true;
    return (int)seen[1] + (int)seen[2] + (int)seen[3];
}
int code(char c) { return c == 'M' ? 1 : (c == 'F' ? 2 : 3); }

int main() {
    int n; string s;
    cin >> n >> s;
    int best = 0;
    for (long long mask = 0; mask < (1LL << n); mask++) {
        vector<int> q[2];
        int tot = 0;
        for (int i = 0; i < n; i++) {
            int f = code(s[i]);
            vector<int>& v = q[mask >> i & 1];
            int a = v.size() >= 2 ? v[v.size() - 2] : 0;
            int b = v.size() >= 1 ? v.back() : 0;
            tot += coal(a, b, f);
            v.push_back(f);
        }
        best = max(best, tot);
    }
    cout << best << '\\n';
}`;

const coreLine = `// หัวใจของทั้งข้อ: หนึ่งสถานะ แตกได้สองทาง เท่านั้น
int t1 = (y1 << 6) | (f << 4) | (x2 << 2) | y2;   // ของชิ้นนี้เข้าเหมือง 1
int v1 = cur[st] + coal(x1, y1, f);
if (v1 > nxt[t1]) nxt[t1] = v1;

int t2 = (x1 << 6) | (y1 << 4) | (y2 << 2) | f;   // ของชิ้นนี้เข้าเหมือง 2
int v2 = cur[st] + coal(x2, y2, f);
if (v2 > nxt[t2]) nxt[t2] = v2;`;

