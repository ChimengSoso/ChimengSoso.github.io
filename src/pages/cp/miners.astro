  .mg-bar{
    display:flex;
    flex-wrap:wrap;
    gap:0.6rem 1rem;
    align-items:center;
    justify-content:space-between;
    margin-bottom:0.8rem;
  }
  .mg-sets{display:flex;gap:0.35rem;flex-wrap:wrap;}
  .mg-set{
    font:inherit;
    font-size:0.74rem;
    cursor:pointer;
    border-radius:999px;
    padding:0.28rem 0.8rem;
    border:1px solid var(--dl-border);
    background:#141b2b;
    color:var(--dl-muted);
    transition:border-color .15s ease, color .15s ease;
  }
  .mg-set[aria-pressed="true"]{border-color:var(--dl-emerald);color:var(--dl-emerald-bright);}
  .mg-score{
    font-family:"JetBrains Mono", monospace;
    font-size:1.05rem;
    color:var(--dl-gold);
    white-space:nowrap;
    min-width:5rem;
    text-align:right;
  }
  .mg-score .mg-sep, .mg-score .mg-goal{color:var(--dl-muted);font-size:0.85rem;}
  .mg-queue{
    display:flex;
    flex-wrap:wrap;
    gap:0.3rem;
    padding:0.6rem;
    border:1px solid var(--dl-border);
    border-radius:10px;
    background:#070c17;
    min-height:3rem;
  }
  .mg-queue :global(.mg-chip){
    width:1.9rem;
    height:1.9rem;
    display:grid;
    place-items:center;
    border-radius:7px;
    font-family:"Fira Code","Fira Mono",monospace;
    font-size:0.82rem;
    border:1px solid var(--dl-border);
    background:#1c2536;
    color:#e7ecf6;
  }
  .mg-queue :global(.mg-chip.done){opacity:0.32;}
  .mg-queue :global(.mg-chip.now){
    border-color:#fff3c4;
    background:var(--dl-gold);
