  .mg-mines{display:flex;flex-wrap:wrap;gap:0.8rem;margin-top:0.8rem;}
  .mg-mine{
    flex:1 1 12rem;
    border:1px solid var(--dl-border);
    border-radius:10px;
    padding:0.7rem;
    background:#101827;
  }
  .mg-mine-h{margin:0 0 0.5rem;font-size:0.76rem;color:var(--dl-muted);letter-spacing:0.08em;text-transform:uppercase;}
  .mg-slots{display:flex;gap:0.3rem;min-height:2.2rem;align-items:center;}
  .mg-slots :global(.mg-slot){
    width:1.9rem;
    height:1.9rem;
    display:grid;
    place-items:center;
    border-radius:7px;
    font-family:"Fira Code","Fira Mono",monospace;
    font-size:0.82rem;
    border:1px dashed var(--dl-border);
    background:transparent;
