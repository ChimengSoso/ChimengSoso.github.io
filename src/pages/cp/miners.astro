    transition:background .15s ease;
  }
  .mg-send:hover:not(:disabled){background:#17243a;}
  .mg-send:disabled{opacity:0.35;cursor:default;border-color:var(--dl-border);color:var(--dl-muted);}
  .mg-say{
    width:0;
    min-width:100%;
    margin-top:0.8rem;
    font-size:0.82rem;
    line-height:1.6;
    color:var(--dl-ink);
    min-height:3.2rem;
  }
  .mg-say :global(.win){color:var(--dl-emerald-bright);font-weight:700;}
  .mg-say :global(.lose){color:var(--dl-gold);font-weight:700;}
  .mg-acts{display:flex;gap:0.35rem;margin-top:0.5rem;}
  .mg-b{
    font:inherit;
    font-size:0.72rem;
    cursor:pointer;
    border-radius:999px;
    padding:0.24rem 0.7rem;
    border:1px solid var(--dl-border);
    background:#141b2b;
    color:var(--dl-muted);
  }
  .mg-b:hover:not(:disabled){border-color:var(--dl-emerald);color:#fff;}
  .mg-b:disabled{opacity:0.4;cursor:default;}
  .minegame figcaption{
    width:0;
    min-width:100%;
    margin-top:0.8rem;
    font-size:0.78rem;
    color:var(--dl-muted);
    line-height:1.6;
  }

  .ns-cue{color:var(--dl-muted);font-size:0.86rem;}

  @media (prefers-reduced-motion: reduce){
    table.statetbl td.pair, table.statetbl td.num, .mg-send{transition:none;}
  }
  @media (max-width:640px){
    .dps-say{min-height:9.5rem;}
  }
</style>

<script>
  // ตัวเล่นตารางสถานะ ขั้นตอนถูกสร้างไว้ตอน build แล้วส่งมาทาง data-steps
  // ตัวคุมปุ่มและแถบเลื่อนอยู่ที่ src/lib/cpPlayer.ts หน้านี้ส่งมาแค่วิธีวาดตาราง
  import { initCpPlayers } from '../../lib/cpPlayer';

  type Cell = { m1: string; m2: string; val: string; path: boolean; top: boolean };
  type SimStep = { title: string; html: string; cells: Cell[] };

  function isCell(v: unknown): v is Cell {
    if (typeof v !== 'object' || v === null) return false;
    const o = v as Record<string, unknown>;
    return typeof o.m1 === 'string' && typeof o.m2 === 'string' && typeof o.val === 'string';
  }

  function isSimStep(v: unknown): v is SimStep {
    if (typeof v !== 'object' || v === null) return false;
    const o = v as Record<string, unknown>;
    return typeof o.title === 'string' && typeof o.html === 'string' && Array.isArray(o.cells) && o.cells.every(isCell);
  }

  document.addEventListener('astro:page-load', () => {
    initCpPlayers<SimStep>('[data-minesim]', {
      playMs: 1600,
      zeroBased: true,
      narrow: (raw) => {
        const ok = raw.filter(isSimStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.html,
      draw: (st, ctx) => {
        const rows = Array.from(ctx.parts.root.querySelectorAll<HTMLTableRowElement>('tbody tr'));
        rows.forEach((tr, i) => {
          const c = st.cells[i];
          const tds = tr.querySelectorAll<HTMLTableCellElement>('td');
          const t1 = tds[0].querySelector('span');
          const t2 = tds[1].querySelector('span');
          if (t1) t1.textContent = c ? c.m1 : '·';
          if (t2) t2.textContent = c ? c.m2 : '·';
          tds[2].textContent = c ? c.val : '·';
          tr.className = '';
          if (!c || c.val === '·') tr.classList.add('is-empty');
          else if (c.path) tr.classList.add('is-path');
          else if (c.top) tr.classList.add('is-top');
        });
        const cap = ctx.parts.root.querySelector<HTMLElement>('.sim-cap');
        if (cap) cap.textContent = `STATE TABLE · ${st.title}`;
      },
    });
  });
</script>

<script>
  // เกมแจกของให้สองเหมือง คะแนนเต็มของแต่ละกองเป็นค่าคงที่ที่คำนวณไว้ตอน build
  // (ไม่ส่งตัวแก้โจทย์ลงหน้าเว็บ เพราะเฉลยข้างล่างคือตัวแก้โจทย์อยู่แล้ว)
  type GameSet = { id: string; label: string; seq: string; best: number };

  function isGameSet(v: unknown): v is GameSet {
    if (typeof v !== 'object' || v === null) return false;
    const o = v as Record<string, unknown>;
    return typeof o.seq === 'string' && typeof o.best === 'number' && typeof o.label === 'string';
  }

  function coalOf(win: string[]): number {
    return new Set(win).size;
  }

  function initMineGame(root: HTMLElement) {
    if (root.dataset.wired === '1') return;
    root.dataset.wired = '1';

    const parsed: unknown = JSON.parse(root.dataset.sets ?? '[]');
    const sets: GameSet[] = Array.isArray(parsed) ? parsed.filter(isGameSet) : [];
    if (sets.length === 0) return;

    const queue = root.querySelector<HTMLElement>('.mg-queue');
    const now = root.querySelector<HTMLElement>('.mg-now');
    const goal = root.querySelector<HTMLElement>('.mg-goal');
    const say = root.querySelector<HTMLElement>('.mg-say');
    const slots = Array.from(root.querySelectorAll<HTMLElement>('.mg-slots'));
    const sends = Array.from(root.querySelectorAll<HTMLButtonElement>('.mg-send'));
    const setBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.mg-set'));
    const acts = Array.from(root.querySelectorAll<HTMLButtonElement>('.mg-b'));
    if (!queue || !now || !goal || !say) return;

    let setIdx = 0;
    let picks: number[] = []; // 0 หรือ 1 ต่อของหนึ่งชิ้น

    // เดินตามที่เลือกไว้ทั้งหมด คืนสภาพเหมืองและถ่านรวม
    const replay = () => {
      const seq = [...sets[setIdx].seq];
      const mines: string[][] = [[], []];
      let total = 0;
      let lastMine = -1;
      picks.forEach((k, i) => {
        const q = mines[k];
        const win = [...q.slice(-2), seq[i]];
        total += coalOf(win);
        q.push(seq[i]);
        lastMine = k;
      });
      return { seq, mines, total, lastMine };
    };

    const render = () => {
      const set = sets[setIdx];
      const { seq, mines, total, lastMine } = replay();
      const done = picks.length === seq.length;

      queue.textContent = '';
      seq.forEach((ch, i) => {
        const el = document.createElement('span');
        el.className = 'mg-chip' + (i < picks.length ? ' done' : i === picks.length ? ' now' : '');
        el.textContent = ch;
        queue.appendChild(el);
      });

      slots.forEach((holder, k) => {
        holder.textContent = '';
        const tail = mines[k].slice(-3);
        for (let i = 0; i < 3; i++) {
          const el = document.createElement('span');
          const ch = tail[tail.length - 3 + i];
          const filled = ch !== undefined;
          const isFresh = filled && k === lastMine && i === 2;
          el.className = 'mg-slot' + (filled ? ' fill' : '') + (isFresh ? ' fresh' : '');
          el.textContent = filled ? ch : '·';
          holder.appendChild(el);
        }
      });

      now.textContent = String(total);
      goal.textContent = String(set.best);
      for (const b of sends) b.disabled = done;
      for (const b of acts) {
        if (b.dataset.act === 'undo') b.disabled = picks.length === 0;
        if (b.dataset.act === 'reset') b.disabled = picks.length === 0;
      }
      setBtns.forEach((b, i) => b.setAttribute('aria-pressed', i === setIdx ? 'true' : 'false'));

      if (!done) {
        say.innerHTML = `แจกไปแล้ว ${picks.length} จาก ${seq.length} ชิ้น ของชิ้นถัดไปคือ <b>${seq[picks.length]}</b>`;
      } else if (total === set.best) {
        say.innerHTML = `<span class="win">ได้ ${total} เท่าคะแนนเต็มพอดี</span> ลองกองอื่นต่อได้เลย`;
      } else {
        say.innerHTML = `<span class="lose">ได้ ${total} ยังห่างคะแนนเต็ม ${set.best} อยู่ ${set.best - total}</span> ลองย้อนกลับไปดูจังหวะที่สองเหมืองให้ถ่านเท่ากัน แล้วเปลี่ยนใจดู`;
      }
    };

    for (const b of sends) {
      b.addEventListener('click', () => {
        const k = b.dataset.send === '2' ? 1 : 0;
        if (picks.length >= sets[setIdx].seq.length) return;
        picks.push(k);
        render();
      });
    }
    for (const b of acts) {
      b.addEventListener('click', () => {
        if (b.dataset.act === 'undo') picks.pop();
        else picks = [];
        render();
      });
    }
    setBtns.forEach((b, i) => {
      b.addEventListener('click', () => {
        setIdx = i;
        picks = [];
        render();
      });
    });

    render();
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-minegame]').forEach(initMineGame);
  });
</script>
