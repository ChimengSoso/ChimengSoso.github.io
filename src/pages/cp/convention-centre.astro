          <text x="12" y={30 + ri * 30 + 16} fill="#9aa7bd" font-size="13" font-family="monospace">#{q.id}</text>
          <rect x={spX(q.s) + 2} y={30 + ri * 30} width={(q.e - q.s + 1) * SP_UNIT - 4} height="22" rx="5" fill="#1c2536" stroke="#3d4a6b" />
          <text x={spX(q.s) + ((q.e - q.s + 1) * SP_UNIT) / 2} y={30 + ri * 30 + 16} fill="#cdd6ea" font-size="12" text-anchor="middle">{q.s} ถึง {q.e}</text>
        </>
      ))}
    </svg>
  </ZoomableDiagram>

  <Spoiler label="แตะเพื่อดูว่าทำไมคำตอบเป็นชุดนี้">
    <p class="io-note">
      ชุดที่ใหญ่ที่สุดของตัวอย่างนี้มีสามชุด คือ (1, 3), (2, 3) และ (1, 4)
      เรียงตามพจนานุกรมแล้ว (1, 3) มาก่อน (1, 4) และ (1, 4) มาก่อน (2, 3) คำตอบคือ (1, 3)
    </p>
  </Spoiler>

  <div class="callout callout-tip">
    <p class="callout-label">ใบ้</p>
    <p>
      โจทย์มีสองชั้น ชั้นแรกคือจำนวนต้องมากที่สุด ชั้นที่สองคือหมายเลขต้องเล็กที่สุด
      ชั้นแรกเป็นโจทย์คลาสสิกที่มีวิธีตอบสั้น ๆ อยู่แล้ว
    </p>
    <p>
      สำหรับชั้นที่สอง ลองไล่บริษัทที่ 1, 2, 3 ไปเรื่อย ๆ แล้วรับตัวที่รับได้
      คำถามที่ต้องตอบคือ <strong>"รับได้" แปลว่าอะไร และตรวจมันได้เร็วแค่ไหน</strong>
    </p>
  </div>

  <h2>ลองเอง &middot; หาชุดที่ใหญ่ที่สุดและหมายเลขเล็กที่สุด</h2>
  <div class="cpgame ccgame" data-ccgame data-puzzles={puzzlesJson}>
    <div class="cpg-tabs" role="tablist" aria-label="เลือกชุดคำขอ">
      {puzzles.map((p, k) => (
        <button type="button" class="cpg-tab" role="tab" data-cpg-tab={String(k)} aria-selected={k === 0 ? 'true' : 'false'}>
          {p.label}
        </button>
      ))}
    </div>

    <p class="cpg-tease" data-cpg-tease>{puzzles[0].tease}</p>

    <div class="cpg-scroll">
      {puzzles.map((p, k) => {
        const unit = 34;
        const left = 54;
        const w = left + (p.hi - p.lo + 1) * unit + 2;
        const h = 30 + p.reqs.length * 28 + 10;
        return (
          <div class="cc-wrap" data-cc-board={String(k)} hidden={k !== 0}>
            <svg class="cc-board" viewBox={`0 0 ${w} ${h}`} xmlns="http://www.w3.org/2000/svg" style={`max-width:min(100%, ${Math.round(w * 1.25)}px)`} role="img" aria-label={`เส้นเวลาแสดงคำขอของบริษัท ${p.reqs.length} ราย แต่ละแท่งคือช่วงวันที่บริษัทนั้นขอใช้ห้อง กดที่แท่งเพื่อเลือกบริษัทนั้น`}>
              {Array.from({ length: p.hi - p.lo + 1 }, (_, i) => (
                <text class="cc-day" x={left + i * unit + unit / 2} y="18" text-anchor="middle">{p.lo + i}</text>
              ))}
              {p.reqs.map((q, ri) => (
                <>
                  <text class="cc-name" x="12" y={30 + ri * 28 + 17}>#{q.id}</text>
                  <rect
                    class="cc-bar"
                    data-cc-req={`${k}:${q.id}`}
                    x={left + (q.s - p.lo) * unit + 2}
                    y={30 + ri * 28 + 3}
                    width={(q.e - q.s + 1) * unit - 4}
                    height="20"
                    rx="5"
                  />
                  <text class="cc-span" x={left + (q.s - p.lo) * unit + ((q.e - q.s + 1) * unit) / 2} y={30 + ri * 28 + 17} text-anchor="middle">{q.s} ถึง {q.e}</text>
                </>
              ))}
            </svg>
          </div>
        );
      })}
    </div>

    <div class="cpg-controls">
      <button type="button" class="cpg-btn" data-cc-clear>ล้างที่เลือก</button>
      <button type="button" class="cpg-btn main" data-cc-check>ตรวจคำตอบ</button>
    </div>

    <p class="cpg-status" data-cpg-status>กดที่แท่งเพื่อรับบริษัทนั้น แท่งที่ทับกันรับพร้อมกันไม่ได้</p>
    <p class="cpg-score" data-cpg-score>รับไว้ 0 บริษัท</p>
    <p class="cpg-hint">เลือกครบแล้วกดตรวจคำตอบ หน้านี้จะบอกว่าจำนวนยังขาด หรือยังมีชุดที่หมายเลขเล็กกว่า</p>
  </div>
  <p class="io-note">
    ชุดที่สองมีตัวล่อ (บริษัทที่ดูน่ารับเพราะหมายเลขเล็กหรือเริ่มเร็ว แต่รับแล้วเสียจำนวน) คือบริษัทที่เริ่มวันแรกสุดแต่ยาวจนกินที่ของอีกสองราย
    รับมันแล้วจำนวนรวมลดลงทันที ทั้งที่หมายเลขมันเล็กที่สุด
  </p>

  <h2>เฉลย ตอนที่ 1 &middot; ลองทุกชุด ถูกแน่แต่ไปได้แค่ N ราว 22</h2>
  <Spoiler>
    <p>วิธีที่ถูกแน่นอนแต่ช้า จะเป็นตัวตรวจของทุกวิธีที่ตามมา</p>
    <div class="callout callout-tip">
      <p class="callout-label">ลองทุกเซตย่อย</p>
      <ul>
        <li>ไล่ทุกชุดของบริษัท ซึ่งมี 2<sup>N</sup> ชุด</li>
        <li>ชุดไหนมีสองบริษัทที่ทับวันกัน ทิ้ง</li>
        <li>เก็บชุดที่ใหญ่ที่สุด ถ้าใหญ่เท่ากันเก็บชุดที่เล็กกว่าตามพจนานุกรม</li>
      </ul>
    </div>
    <p>
      ทุก ๆ บริษัทที่เพิ่มขึ้นหนึ่งราย จำนวนชุดเพิ่มเป็นสองเท่า วัดจริงที่ N = 20 ใช้ {MEASURED.brute20Sec} วินาที
      ที่ N = 22 ใช้ {MEASURED.brute22Sec} วินาที ใกล้ลิมิต {TIME_LIMIT} วินาทีแล้ว
    </p>
    <figure class="tbl">
      <table class="rec">
        <caption>ชุดทดสอบของโจทย์</caption>
        <thead><tr><th>ส่วน</th><th class="num">N ไม่เกิน</th><th>ลองทุกเซตย่อยผ่านไหม</th></tr></thead>
        <tbody>
          <tr><td>50% แรก</td><td class="num">{fmt(N_SUB)}</td><td>ไม่ผ่าน</td></tr>
          <tr><td>อีก 50%</td><td class="num">{fmt(N_MAX)}</td><td>ไม่ผ่าน</td></tr>
        </tbody>
      </table>
      <figcaption>วิธีนี้ไม่ได้คะแนนเลย แต่ทุกโค้ดในหน้านี้ถูกเทียบกับมันบนชุดเล็ก</figcaption>
    </figure>
  </Spoiler>

  <h2>เฉลย ตอนที่ 2 &middot; ครึ่งแรก: นับว่าวางได้มากที่สุดกี่งาน</h2>
  <Spoiler>
    <p>
      การหาจำนวนมากที่สุดคือโจทย์จัดตารางช่วงเวลา (interval scheduling) ซึ่งมีวิธีตอบที่รู้กันมานาน
      เรียกว่าวิธีโลภ (greedy อ่านว่า "กรีดดี้" แปลว่าตะกละ) คือทุกครั้งหยิบตัวที่ดูดีที่สุดตรงหน้า แล้วไม่ย้อนกลับมาแก้
    </p>
    <div class="callout callout-tip">
      <p class="callout-label">กฎการหยิบ</p>
      <p>
        ยืนอยู่ที่วัน <code>p</code> หยิบงานที่เริ่มไม่ก่อน <code>p</code> และจบเร็วที่สุด
        ถ้างานนั้นจบวัน <code>e</code> ก็ย้ายไปยืนที่วัน <code>e + 1</code> แล้วทำซ้ำ
      </p>
    </div>
    <p>
      ตั้งแต่ตอนนี้จนจบบทใช้ชุดตัวอย่างชุดเดียว (ชุดเดียวกับแท็บที่สามของเกม) มี {DEMO.length} บริษัท
      ช่วงวันที่ 1 ถึง {DEMO_HI}: {DEMO_LIST.join(', ')}
    </p>
    <p>เริ่มยืนที่วันที่ 1 แล้วทำตามกฎ</p>
    <ul>
      {GREEDY_STEPS.map((g) => (
        <li>
          ยืนวัน {g.p} · เริ่มไม่ก่อนวัน {g.p} และจบเร็วสุดคือ #{g.q.id} ({g.q.s} ถึง {g.q.e}) · ไปยืนวัน {g.next}
          {g.ties.length > 0 ? ` (#${g.ties.join(', #')} ก็จบวัน ${g.q.e} หยิบตัวหมายเลขน้อยกว่า)` : ''}
        </li>
      ))}
      <li>ยืนวัน {GREEDY_STEPS[GREEDY_STEPS.length - 1].next} · ไม่มีงานที่เริ่มตั้งแต่วันนี้และจบไม่เกินวัน {DEMO_HI} · หยุด ได้ {DEMO_CHAIN.length} งาน</li>
    </ul>
    <p>
      ถ้ามีหลายงานจบวันเดียวกัน จะหยิบตัวไหนก็ได้จำนวนเท่ากัน เพราะก้าวต่อไปยืนวันเดียวกัน
      หน้านี้หยิบตัวหมายเลขน้อยกว่าเสมอ
    </p>
    <ZoomableDiagram caption={`ชุดตัวอย่าง ${DEMO.length} บริษัท เรียงตามหมายเลข แท่งเขียวคืองานที่วิธีโลภหยิบ แถวล่างใต้เส้นคั่นเรียงงานที่หยิบตามลำดับ ลูกศรทองคือการย้ายไปยืนวันถัดจากวันจบ ที่วันที่ ${TIE.p} บริษัท ${TIE.id} กับ ${TIE.other} จบวัน ${TIE.e} เท่ากัน ภาพนี้หยิบ ${TIE.id}`}>
      <svg viewBox={`0 0 ${TL_W} ${TL_H}`} xmlns="http://www.w3.org/2000/svg" style={`display:block;margin:0 auto;max-width:${Math.round(TL_W * 1.25)}px`} role="img" aria-label={`เส้นเวลาวันที่ 1 ถึง ${DEMO_HI} มีแท่งแทนคำขอของบริษัท 1 ถึง ${DEMO.length} แท่งที่วิธีโลภหยิบเป็นสีเขียว คือบริษัท ${DEMO_CHAIN.map((q) => q.id).join(', ')} ตามลำดับที่หยิบ แถวล่างวางแท่งเหล่านี้เรียงต่อกันพร้อมลูกศร`}>
        <defs>
          <marker id="ccArrow" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto">
            <path d="M0 0 L9 4.5 L0 9 z" fill="#d8b25a" />
          </marker>
        </defs>
        {TL_DAYS.map((d) => (
          <text x={tlX(d) + TL_UNIT / 2} y="16" fill="#7b8397" font-size="12" text-anchor="middle" font-family="monospace">{d}</text>
        ))}
        {DEMO.map((q, ri) => {
          const picked = TL_PICKED.has(q.id);
          return (
            <>
              <text x="12" y={34 + ri * TL_ROW + 16} fill="#9aa7bd" font-size="13" font-family="monospace">#{q.id}</text>
              <rect x={tlX(q.s) + 2} y={34 + ri * TL_ROW} width={(q.e - q.s + 1) * TL_UNIT - 4} height="22" rx="5" fill={picked ? '#163a2a' : '#1c2536'} stroke={picked ? '#2f9e5c' : '#3d4a6b'} />
              <text x={tlX(q.s) + ((q.e - q.s + 1) * TL_UNIT) / 2} y={34 + ri * TL_ROW + 16} fill={picked ? '#4ade80' : '#9aa7bd'} font-size="12" text-anchor="middle">{q.s} ถึง {q.e}</text>
            </>
          );
        })}
        <line x1="12" y1={TL_LANE - 14} x2={TL_W - 12} y2={TL_LANE - 14} stroke="#2a3350" />
        {DEMO_CHAIN.map((q) => (
          <>
            <rect x={tlX(q.s) + 2} y={TL_LANE} width={(q.e - q.s + 1) * TL_UNIT - 4} height="22" rx="5" fill="#163a2a" stroke="#2f9e5c" />
            <text x={tlX(q.s) + ((q.e - q.s + 1) * TL_UNIT) / 2} y={TL_LANE + 16} fill="#4ade80" font-size="12" text-anchor="middle" font-family="monospace">#{q.id}</text>
          </>
        ))}
        {TL_ARCS.map((d) => (
          <path d={d} stroke="#d8b25a" stroke-width="1.8" fill="none" marker-end="url(#ccArrow)" />
        ))}
      </svg>
    </ZoomableDiagram>
    <div class="callout callout-note">
      <p class="callout-label">ทำไมจบเร็วก่อนถึงได้จำนวนมากที่สุด</p>
      <p>
        เอาชุดที่ดีที่สุดชุดไหนก็ได้มาหนึ่งชุด แล้วสลับงานแรกของมันเป็นงานที่จบเร็วที่สุด
        งานที่สองของชุดเดิมเริ่มหลังงานแรกเดิมจบ และงานใหม่จบไม่ช้ากว่างานแรกเดิม งานที่สองก็ยังเริ่มหลังงานใหม่จบ
      </p>
      <p>
        จำนวนไม่ลด ทำแบบเดียวกันกับงานที่สอง ที่สาม ไปเรื่อย ๆ ชุดที่ดีที่สุดก็กลายเป็นชุดของวิธีโลภทีละตัว
      </p>
    </div>
    <p>
      วิธีนี้ตอบได้แค่<strong>จำนวน</strong> ชุดที่มันหยิบมาเรียงแล้วคือ {DEMO_CHAIN_SORTED.join(', ')}
      แต่คำตอบของชุดนี้คือ {DEMO_RUN.chosen.join(', ')} ซึ่งเล็กกว่าตามพจนานุกรม
    </p>
    <div class="callout callout-tip">
      <p class="callout-label">นิยาม cnt(l, r)</p>
      <p>
        เริ่มยืนที่วัน <code>l</code> แล้วหยิบตามกฎข้างบน โดยนับเฉพาะงานที่จบไม่เกินวัน <code>r</code>
        ได้กี่งานคือ <code>cnt(l, r)</code> พูดง่าย ๆ คือช่วงวัน l ถึง r วางงานที่ไม่ทับกันได้มากสุดกี่งาน
      </p>
      <p>เช่น <code>cnt(1, {DEMO_HI})</code> = {DEMO_RUN.total} ตามที่เพิ่งเดินไป ถ้า <code>l &gt; r</code> ให้ค่าเป็น 0</p>
    </div>
  </Spoiler>

  <h2>เฉลย ตอนที่ 3 &middot; ครึ่งหลัง: ไล่ตามหมายเลข รับเมื่อช่องว่างไม่เสียจำนวน</h2>
  <Spoiler>
    <div class="callout callout-note">
      <p class="callout-label">ที่มาของแนวคิดนี้</p>
      <p>
        วิธีที่อยากทำที่สุดคือไล่บริษัทตามหมายเลข แล้วถามทีละตัวว่า "ถ้ารับตัวนี้ จำนวนรวมยังเท่าเดิมไหม"
        คำถามนี้ถูกต้อง แต่ถ้าตอบด้วยการนับใหม่ทั้งชุดทุกครั้ง ราคาคือ <code>N</code> คูณ <code>N</code>
      </p>
      <p>
        ช่องว่างที่จะเล่าต่อไปไม่ได้ทำให้ถูกลงด้วยตัวเอง (ตอนที่ 4 จะเห็นว่ามันยังราว 2 × N × N)
        สิ่งที่มันให้คือคำถามเหลือแค่นับสองช่วง แล้วการนับช่วงหนึ่งทำให้เร็วได้ด้วยตารางกระโดดในตอนที่ 5
      </p>
    </div>
    <p>เริ่มจากเหตุผลว่าทำไมไล่ตามหมายเลขแล้วได้ชุดที่เล็กที่สุด</p>
    <ul>
      <li>
        ถ้ามีชุดที่ใหญ่ที่สุดสักชุดที่มีบริษัท 1 ชุดนั้นชนะทุกชุดที่ไม่มีบริษัท 1
        เพราะตัวแรกของมันคือ 1 ส่วนอีกฝั่งขึ้นต้นด้วยเลขที่มากกว่า
      </li>
      <li>ต้องรับบริษัท 1 ถ้ารับแล้วยังทำจำนวนมากที่สุดได้ ถ้าทำไม่ได้ก็ข้าม</li>
      <li>จากนั้นถามแบบเดียวกันกับบริษัท 2 โดยถือว่าตัวที่รับไว้แล้วต้องอยู่ในชุดเสมอ แล้วไล่ไปจนครบ</li>
      <li>
        บริษัทที่ข้ามไปไม่ต้องกลับมาดูอีก ตอนที่ข้ามมัน ไม่มีชุดที่ใหญ่ที่สุดไหนมีทั้งมันและตัวที่รับไว้ตอนนั้น
        ตัวที่รับเพิ่มทีหลังมีแต่ทำให้เงื่อนไขแน่นขึ้น
      </li>
    </ul>
    <p>
      ตัวที่รับไปแล้วยึดวันของมันไว้ วันที่เหลือแตกเป็นท่อนที่ไม่ติดกัน เรียกแต่ละท่อนว่า<strong>ช่องว่าง</strong> (gap)
    </p>
    <div class="callout callout-note">
      <p class="callout-label">นึกภาพ</p>
      <p>
        ถนนริมทางที่มีรถจอดอยู่แล้วบางคัน ที่ว่างระหว่างรถสองคันเป็นช่องแยกกัน
        รถคันใหม่ต้องลงในช่องเดียวทั้งคัน และการจอดในช่องหนึ่งไม่กินที่ของช่องอื่น
      </p>
    </div>
    <div class="callout callout-tip">
      <p class="callout-label">สิ่งที่เป็นจริงตลอดการไล่</p>
      <p>จำนวนตัวที่รับไว้ + ผลรวมของ <code>cnt</code> ของทุกช่องว่าง = จำนวนมากที่สุดของทั้งโจทย์</p>
    </div>
    <p>
