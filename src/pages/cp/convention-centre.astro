---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

const href = 'convention-centre/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Req = { id: number; s: number; e: number };
const overlaps = (a: Req, b: Req): boolean => !(a.e < b.s || b.e < a.s);

/** cnt(l, r): จำนวนงานมากที่สุดที่วางได้ทั้งก้อนในช่วงวัน [l, r] ด้วยท่าโลภจบเร็วก่อน */
function countIn(reqs: Req[], l: number, r: number): number {
  const fit = reqs.filter((q) => q.s >= l && q.e <= r).sort((a, b) => a.e - b.e);
  let cur = l - 1;
  let n = 0;
  for (const q of fit)
    if (q.s > cur) {
      cur = q.e;
      n++;
    }
  return n;
}

/** งานที่ท่าโลภหยิบจริงในช่วง [lo, hi] เรียงตามลำดับที่หยิบ */
function greedyChain(reqs: Req[], lo: number, hi: number): Req[] {
  const out: Req[] = [];
  let p = lo;
  for (;;) {
    const cand = reqs.filter((q) => q.s >= p && q.e <= hi).sort((a, b) => a.e - b.e)[0];
    if (!cand) break;
    out.push(cand);
    p = cand.e + 1;
  }
  return out;
}

type Kind = 'take' | 'count' | 'straddle' | 'full';
type Trace = { id: number; s: number; e: number; kind: Kind; gl: number; gr: number; c: number; c1: number; c2: number; hit: Req | null };

/** ไล่ตามหมายเลขบริษัท ช่องว่างแต่ละช่องจำจำนวนของตัวเอง รับเมื่อซ้าย + 1 + ขวา เท่าของเดิม */
function lexSmallest(reqs: Req[], LO: number, HI: number): { chosen: number[]; total: number; trace: Trace[] } {
  const total = countIn(reqs, LO, HI);
  let gaps: { l: number; r: number; c: number }[] = [{ l: LO, r: HI, c: total }];
  const chosen: number[] = [];
  const trace: Trace[] = [];
  const blank = { gl: 0, gr: 0, c: 0, c1: 0, c2: 0, hit: null };
  for (const q of reqs) {
    if (chosen.length === total) {
      trace.push({ id: q.id, s: q.s, e: q.e, kind: 'full', ...blank });
      continue;
    }
    const g = gaps.find((x) => q.s >= x.l && q.e <= x.r);
    if (!g) {
      const hit = reqs.find((o) => chosen.includes(o.id) && overlaps(o, q)) ?? null;
      trace.push({ id: q.id, s: q.s, e: q.e, kind: 'straddle', ...blank, hit });
      continue;
    }
    const c1 = countIn(reqs, g.l, q.s - 1);
    const c2 = countIn(reqs, q.e + 1, g.r);
    const ok = c1 + 1 + c2 === g.c;
    if (ok) {
      gaps = gaps.filter((x) => x !== g);
      if (g.l <= q.s - 1) gaps.push({ l: g.l, r: q.s - 1, c: c1 });
      if (q.e + 1 <= g.r) gaps.push({ l: q.e + 1, r: g.r, c: c2 });
      gaps.sort((a, b) => a.l - b.l);
      chosen.push(q.id);
    }
    trace.push({ id: q.id, s: q.s, e: q.e, kind: ok ? 'take' : 'count', gl: g.l, gr: g.r, c: g.c, c1, c2, hit: null });
  }
  return { chosen, total, trace };
}

/** ตัวตรวจ ลองทุกเซตย่อย เอาเซตใหญ่ที่สุดที่เรียงแล้วเล็กที่สุดตามพจนานุกรม ไม่มีท่าโลภหรือช่องว่างอยู่ในนี้ */
function bruteLex(reqs: Req[]): number[] {
  let best: number[] = [];
  for (let m = 0; m < 1 << reqs.length; m++) {
    const ids: number[] = [];
    for (let i = 0; i < reqs.length; i++) if ((m >> i) & 1) ids.push(i);
    let ok = true;
    for (let a = 0; a < ids.length && ok; a++)
      for (let b = a + 1; b < ids.length && ok; b++) if (overlaps(reqs[ids[a]], reqs[ids[b]])) ok = false;
    if (!ok) continue;
    const list = ids.map((i) => reqs[i].id);
    if (list.length > best.length) best = list;
    else if (list.length === best.length) {
      for (let i = 0; i < list.length; i++) {
        if (list[i] < best[i]) {
          best = list;
          break;
        }
        if (list[i] > best[i]) break;
      }
    }
  }
  return best;
}
const bruteCount = (reqs: Req[], l: number, r: number): number => bruteLex(reqs.filter((q) => q.s >= l && q.e <= r)).length;

const mk = (rows: [number, number][]): Req[] => rows.map(([s, e], i) => ({ id: i + 1, s, e }));
const fmt = (n: number): string => n.toLocaleString('en-US');

/* ---------- ตัวอย่างในโจทย์ ---------- */
const SAMPLE = mk([[4, 9], [9, 11], [13, 19], [10, 17]]);
const SAMPLE_RUN = lexSmallest(SAMPLE, 1, 1000000000);
if (SAMPLE_RUN.chosen.join(' ') !== '1 3') throw new Error('convention-centre: ตัวอย่างในโจทย์ไม่ได้ 1 3');

/* ภาพตัวอย่างในโจทย์ แท่งละบริษัท เรียงตามหมายเลข */
const SP_LO = Math.min(...SAMPLE.map((q) => q.s));
const SP_HI = Math.max(...SAMPLE.map((q) => q.e));
const SP_UNIT = 38;
const SP_L = 44;
const spX = (d: number): number => SP_L + (d - SP_LO) * SP_UNIT;
const SP_DAYS = Array.from({ length: SP_HI - SP_LO + 1 }, (_, i) => SP_LO + i);
const SP_W = spX(SP_HI) + SP_UNIT + 12;
const SP_H = 30 + SAMPLE.length * 30 + 34;

/* ด่านตรวจตอนบิลด์ ท่าที่สอนต้องตรงกับการลองทุกเซตย่อย ไม่งั้นหน้านี้ไม่ขึ้น */
const SWEEP_CASES = 400;
{
  let seed = 20280909;
  const rnd = (m: number): number => {
    seed = (Math.imul(seed, 1103515245) + 12345) >>> 0;
    return (seed >>> 8) % m;
  };
  for (let t = 0; t < SWEEP_CASES; t++) {
    const n = 1 + rnd(9);
    const D = [6, 12, 25][rnd(3)];
    const rows: [number, number][] = [];
    for (let i = 0; i < n; i++) {
      const a = 1 + rnd(D);
      rows.push([a, a + rnd(5)]);
    }
    const reqs = mk(rows);
    const got = lexSmallest(reqs, 1, 1000000000).chosen;
    const want = bruteLex(reqs);
    if (got.join(',') !== want.join(','))
      throw new Error(`convention-centre: ได้ [${got}] แต่ควรได้ [${want}] ที่ ${JSON.stringify(rows)}`);
  }
}

/* ---------- ชุดตัวอย่างของบทนี้ 8 บริษัท ใช้ตั้งแต่ตอนที่ 2 จนจบ ---------- */
const DEMO = mk([[7, 10], [9, 10], [11, 12], [1, 3], [2, 4], [2, 2], [8, 8], [12, 12]]);
const DEMO_HI = 14;
const DEMO_RUN = lexSmallest(DEMO, 1, DEMO_HI);
if (DEMO_RUN.chosen.join(',') !== bruteLex(DEMO).join(',')) throw new Error('convention-centre: ชุดตัวอย่างไม่ตรงกับการลองทุกเซตย่อย');
for (const t of DEMO_RUN.trace) {
  if (t.kind !== 'take' && t.kind !== 'count') continue;
  if (t.c !== bruteCount(DEMO, t.gl, t.gr) || t.c1 !== bruteCount(DEMO, t.gl, t.s - 1) || t.c2 !== bruteCount(DEMO, t.e + 1, t.gr))
    throw new Error(`convention-centre: ตัวเลขของบริษัท ${t.id} ไม่ตรงกับการนับตรง ๆ`);
  if ((t.kind === 'take') !== (t.c1 + 1 + t.c2 === t.c)) throw new Error(`convention-centre: ผลของบริษัท ${t.id} ขัดกับสูตร`);
}
const demoKinds = new Set(DEMO_RUN.trace.map((t) => t.kind));
for (const k of ['take', 'count', 'straddle', 'full'] as Kind[])
  if (!demoKinds.has(k)) throw new Error(`convention-centre: ชุดตัวอย่างไม่มีกรณี ${k}`);

/* ตัวอย่างสูตรสองตัว ต้องมีทุกพจน์ไม่เป็นศูนย์ ทั้งตัวที่รับและตัวที่ไม่รับ */
const wxMaybe = DEMO_RUN.trace.find((t) => t.kind === 'take' && t.c1 > 0 && t.c2 > 0);
const wrMaybe = DEMO_RUN.trace.find((t) => t.kind === 'count' && t.c1 > 0 && t.c2 > 0);
if (!wxMaybe || !wrMaybe) throw new Error('convention-centre: ไม่มีตัวอย่างสูตรที่ทุกพจน์ไม่เป็นศูนย์');
const WX: Trace = wxMaybe;
const WR: Trace = wrMaybe;
/* ภาพของตอนที่ 3 บอกว่าทั้งสองตัวอยู่ในช่องว่างเต็มท่อน ตอนที่ยังไม่มีใครถูกรับ */
for (const t of [WX, WR])
  if (t.gl !== 1 || t.gr !== DEMO_HI || t.c !== DEMO_RUN.total) throw new Error('convention-centre: ตัวอย่างสูตรไม่ได้อยู่ในช่องว่างเต็มท่อน');
const WX_SUM = WX.c1 + 1 + WX.c2;
const WR_SUM = WR.c1 + 1 + WR.c2;
const straddleMaybe = DEMO_RUN.trace.find((t) => t.kind === 'straddle');
if (!straddleMaybe || !straddleMaybe.hit || !DEMO_RUN.trace.some((t) => t.kind === 'full'))
  throw new Error('convention-centre: ขาดกรณีทับหรือกรณีครบ');
const STRADDLE: Trace = straddleMaybe;
const STRADDLE_HIT: Req = straddleMaybe.hit;

/* ท่าโลภของตอนที่ 2 หยิบชุดหนึ่ง ซึ่งต้องไม่ใช่คำตอบ ไม่งั้นตอนที่ 3 ไม่มีเหตุให้มีอยู่ */
const DEMO_CHAIN = greedyChain(DEMO, 1, DEMO_HI);
const DEMO_CHAIN_SORTED = DEMO_CHAIN.map((q) => q.id).sort((a, b) => a - b);
if (DEMO_CHAIN.length !== DEMO_RUN.total) throw new Error('convention-centre: ท่าโลภนับไม่ตรงกับจำนวนรวม');
if (DEMO_CHAIN_SORTED.join(',') === DEMO_RUN.chosen.join(',')) throw new Error('convention-centre: ท่าโลภบังเอิญได้คำตอบ ตัวอย่างนี้สอนอะไรไม่ได้');

/* โน้ตของตัวเล่นทีละขั้น ใช้รูปแบบเดียวทุกบรรทัด */
const demoSteps = DEMO_RUN.trace.map((t) => {
  const head = `#${t.id} ขอ ${t.s} ถึง ${t.e}`;
  if (t.kind === 'full') return { note: `${head} · รับครบ ${DEMO_RUN.total} งานแล้ว · หยุด ไม่ต้องดูตัวที่เหลือ` };
  if (t.kind === 'straddle')
    return { note: `${head} · ทับ #${t.hit?.id} (${t.hit?.s} ถึง ${t.hit?.e}) ที่รับไว้แล้ว · ไม่รับ โดยไม่ต้องนับ` };
  const sum = t.c1 + 1 + t.c2;
  const verdict = t.kind === 'take' ? 'เท่าเดิม รับ' : `น้อยกว่า ${t.c} ไม่รับ`;
  return { note: `${head} · ช่องว่าง ${t.gl} ถึง ${t.gr} เดิมได้ ${t.c} · ซ้าย ${t.c1} + 1 + ขวา ${t.c2} = ${sum} · ${verdict}` };
});
const demoRows = DEMO_RUN.trace.map((t) => ({
  id: t.id,
  span: `${t.s} ถึง ${t.e}`,
  gap: t.kind === 'take' || t.kind === 'count' ? `${t.gl} ถึง ${t.gr}` : t.kind === 'straddle' ? `ทับ #${t.hit?.id}` : '·',
  c: t.kind === 'take' || t.kind === 'count' ? String(t.c) : '·',
  sum: t.kind === 'take' || t.kind === 'count' ? `${t.c1} + 1 + ${t.c2} = ${t.c1 + 1 + t.c2}` : '·',
  res: t.kind === 'take' ? 'รับ' : t.kind === 'full' ? 'หยุด' : 'ไม่รับ',
  yes: t.kind === 'take',
}));

/* ---------- ภาพชุดตัวอย่าง แท่งละบริษัท + เลนของท่าโลภ (ตอนที่ 2) ---------- */
const TL_UNIT = 44;
const TL_L = 44;
const TL_ROW = 30;
const tlX = (d: number): number => TL_L + (d - 1) * TL_UNIT;
const TL_DAYS = Array.from({ length: DEMO_HI }, (_, i) => i + 1);
const TL_W = tlX(DEMO_HI) + TL_UNIT + 12;
const TL_LANE = 34 + DEMO.length * TL_ROW + 22;
const TL_H = TL_LANE + 22 + 34;
const TL_PICKED = new Set(DEMO_CHAIN.map((q) => q.id));
/* ลูกศรโค้งเหนือเลน จากกลางท้ายแท่งที่เพิ่งหยิบ ไปหัวแท่งถัดไป แท่งที่ติดกันก็ยังเห็นลูกศร */
const TL_ARCS = DEMO_CHAIN.slice(0, -1).map((q, i) => {
  const nxt = DEMO_CHAIN[i + 1];
  const x1 = tlX(q.e) + TL_UNIT * 0.6;
  const x2 = tlX(nxt.s) + TL_UNIT * 0.4;
  const y = TL_LANE - 1;
  return `M${x1} ${y} Q${(x1 + x2) / 2} ${y - 16} ${x2} ${y}`;
});

/* ---------- ภาพการเทียบสองบริษัทในช่องว่าง (ตอนที่ 3) ---------- */
const GD_UNIT = 44;
const GD_L = 12;
const gdX = (d: number): number => GD_L + (d - 1) * GD_UNIT;
const GD_W = gdX(DEMO_HI) + GD_UNIT + 12;
const gdPanel = (t: Trace, py: number) => {
  const left = t.gl <= t.s - 1 ? greedyChain(DEMO, t.gl, t.s - 1) : [];
  const right = t.e + 1 <= t.gr ? greedyChain(DEMO, t.e + 1, t.gr) : [];
  if (left.length !== t.c1 || right.length !== t.c2) throw new Error('convention-centre: ภาพช่องว่างนับไม่ตรงกับตาราง');
  const sum = t.c1 + 1 + t.c2;
  return {
    py,
    t,
    left,
    right,
    title: `#${t.id} ขอวันที่ ${t.s} ถึง ${t.e} · ช่องว่าง ${t.gl} ถึง ${t.gr} เดิมได้ ${t.c} · ซ้าย ${t.c1} + 1 + ขวา ${t.c2} = ${sum} · ${t.kind === 'take' ? 'รับ' : 'ไม่รับ'}`,
    leftMid: (gdX(t.gl) + gdX(t.s)) / 2,
    rightMid: (gdX(t.e + 1) + gdX(t.gr) + GD_UNIT) / 2,
  };
};
const GD_PANELS = [gdPanel(WR, 30), gdPanel(WX, 154)];
const GD_DAYS = TL_DAYS;
const GD_H = 154 + 112 + 34;

/* ---------- ตารางกระโดดของชุดตัวอย่าง (ตอนที่ 5) ---------- */
/** ก้าวเดียวจากวัน p: หยิบงานที่เริ่มไม่ก่อน p และจบเร็วที่สุด แล้วไปยืนที่วันจบ + 1 */
const pickFrom = (p: number): Req | undefined => DEMO.filter((q) => q.s >= p).sort((a, b) => a.e - b.e)[0];
const jump1 = (p: number): number | null => {
  const q = pickFrom(p);
  return q ? q.e + 1 : null;
};
const jumpK = (p: number, steps: number): number | null => {
  let cur: number | null = p;
  for (let i = 0; i < steps && cur !== null; i++) cur = jump1(cur);
  return cur;
};
const JT_COORDS = [...new Set([1, ...DEMO.map((q) => q.e + 1), DEMO_HI + 1])].sort((a, b) => a - b);
const JT_LEVELS = [1, 2, 4];
if (DEMO_RUN.total >= 2 * JT_LEVELS[JT_LEVELS.length - 1]) throw new Error('convention-centre: ชั้นของตารางตัวอย่างไม่พอ');
const JT_ROWS = JT_COORDS.map((p) => {
  const q = pickFrom(p);
  const ties = q ? DEMO.filter((o) => o.s >= p && o.e === q.e && o.id !== q.id).map((o) => `#${o.id}`) : [];
  const pickText = q ? `#${q.id} (${q.s} ถึง ${q.e})${ties.length ? ` เสมอ ${ties.join(', ')}` : ''}` : '·';
  return { p, pick: pickText, to: JT_LEVELS.map((k) => jumpK(p, k) ?? '·') };
});
/** cnt ด้วยการกระโดด ไล่ชั้นจากใหญ่ลงเล็ก ก้าวเมื่อยังไม่เลย r + 1 */
function cntByJumps(l: number, r: number): number {
  let cur = l;
  let res = 0;
  for (const k of [...JT_LEVELS].reverse()) {
    const to = jumpK(cur, k);
    if (to !== null && to <= r + 1) {
      res += k;
      cur = to;
    }
  }
  return res;
}
for (const l of JT_COORDS)
  for (let r = l - 1; r <= DEMO_HI; r++)
    if (cntByJumps(l, r) !== countIn(DEMO, l, r)) throw new Error(`convention-centre: การกระโดดนับ [${l}, ${r}] ไม่ตรง`);
/* ตัวอย่างการกระโดดใช้ซ้าย ของสูตรในตอนที่ 3 เพื่อให้เป็นตัวเลขเดียวกัน */
const CJ_L = WX.gl;
const CJ_R = WX.s - 1;
const CJ = (() => {
  let cur = CJ_L;
  let res = 0;
  return [...JT_LEVELS].reverse().map((k) => {
    const from = cur;
    const to = jumpK(cur, k);
    const ok = to !== null && to <= CJ_R + 1;
    if (ok && to !== null) {
      res += k;
      cur = to;
    }
    return { k, from, to: to === null ? 'ไปต่อไม่ได้' : String(to), ok, res };
  });
})();
const CJ_RES = CJ[CJ.length - 1].res;
if (CJ_RES !== WX.c1) throw new Error('convention-centre: ตัวอย่างการกระโดดไม่ได้ค่าซ้ายของตอนที่ 3');
if (!CJ.some((x) => x.ok) || !CJ.some((x) => !x.ok)) throw new Error('convention-centre: ตัวอย่างการกระโดดต้องมีทั้งชั้นที่ก้าวและไม่ก้าว');

/* ---------- มินิเกม ---------- */
type GamePuzzle = { id: string; label: string; tease: string; reqs: Req[]; answer: number[]; lo: number; hi: number };
function makePuzzle(id: string, label: string, tease: string, reqs: Req[], hi: number): GamePuzzle {
  const byGap = lexSmallest(reqs, 1, 1000000000).chosen;
  const byBrute = bruteLex(reqs);
  if (byGap.join(',') !== byBrute.join(',')) throw new Error(`convention-centre: เฉลยเกม ${id} ไม่ตรงกัน`);
  return { id, label, tease, reqs, answer: byBrute, lo: 1, hi };
}
const puzzles: GamePuzzle[] = [
  makePuzzle('a', 'ตัวอย่างในโจทย์ 4 บริษัท', 'ชุดนี้มีหลายวิธีที่ได้จำนวนเท่ากัน คำถามคือชุดไหนที่หมายเลขเรียงแล้วเล็กที่สุด', SAMPLE, 20),
  makePuzzle('b', '7 บริษัท ที่มีตัวล่อ', 'ตัวที่เริ่มเร็วที่สุดไม่ได้ควรรับเสมอ ลองดูว่าตัวไหนยาวจนกินที่ของอีกสองตัว', mk([[1, 6], [1, 2], [3, 4], [5, 6], [7, 9], [8, 12], [10, 12]]), 14),
  makePuzzle('c', '8 บริษัทของบทนี้', 'ชุดนี้คือชุดที่เฉลยใช้ตั้งแต่ตอนที่ 2 จนจบ ลองทำเองก่อนแล้วค่อยไปเทียบ', DEMO, DEMO_HI),
];
const puzzlesJson = JSON.stringify(puzzles);

/* ---------- ค่าใช้จ่าย นับตามที่โค้ดทำจริง ---------- */
const N_MAX = 200000;
const N_SUB = 3000;
const TIME_LIMIT = 1.5;
const MEM_LIMIT = 64;
const STEPS_PER_SEC = 1e8; /* กติกาหยาบ ๆ ไม่ใช่ค่าที่วัด */
const BUDGET = TIME_LIMIT * STEPS_PER_SEC;
const LOG = 18;
if (2 ** LOG <= N_MAX || 2 ** (LOG - 1) > N_MAX) throw new Error('convention-centre: LOG ไม่พอดีกับ N');
const BS = Math.ceil(Math.log2(N_MAX + 2)); /* ค้นหาแบบแบ่งครึ่งหนึ่งครั้งบนพิกัด N + 2 ตัว */
/* วิธีไล่ทีละงาน: ต่อบริษัทนับสองครั้ง แต่ละครั้งไล่งานได้ถึง N ตัว */
const slowOps = (n: number): number => 2 * n * n;
/* วิธีตารางกระโดด: ต่อบริษัทนับสองครั้ง ครั้งละค้นแบบแบ่งครึ่งสองที (จุดเริ่มกับขอบขวา) + อ่านตาราง LOG ชั้น
   บวกหาช่องว่างใน map อีกหนึ่งที และตอนเตรียม: เรียงสองรอบกับสร้างตาราง LOG ชั้น */
const FULL_PER_COMPANY = 2 * (2 * BS + LOG) + BS;
const fullOps = (n: number): number => n * FULL_PER_COMPANY + 2 * n * BS + LOG * (n + 2);
const sci = (v: number): { m: string; e: number } => {
  const e = Math.floor(Math.log10(v));
  return { m: (v / 10 ** e).toFixed(1), e };
};
const CH_X0 = 196;
const CH_DEC = 58;
const chX = (v: number): number => CH_X0 + (Math.log10(v) - 6) * CH_DEC;
const CH_TICKS = [6, 8, 10, 12];
const CH_BOTTOM = 166;
const CH_BARS = [
  { name: `ไล่ทีละงาน N = ${fmt(N_SUB)}`, v: slowOps(N_SUB), y: 44 },
  { name: `ไล่ทีละงาน N = ${fmt(N_MAX)}`, v: slowOps(N_MAX), y: 84 },
  { name: `ตารางกระโดด N = ${fmt(N_MAX)}`, v: fullOps(N_MAX), y: 124 },
].map((b) => ({ ...b, s: sci(b.v), ok: b.v <= BUDGET, over: Math.round(b.v / BUDGET) }));
if (!CH_BARS[0].ok || CH_BARS[1].ok || !CH_BARS[2].ok) throw new Error('convention-centre: กราฟแท่งทัน/ไม่ทันผิดจากที่บทความเล่า');
/* ป้ายท้ายแท่งยาวราว 160 หน่วย ความกว้างจริงต้องวัดในเบราว์เซอร์อีกรอบ */
const CH_W = Math.round(Math.max(chX(1e12), ...CH_BARS.map((b) => chX(b.v) + 8 + 85))) + 12; // 85 = ความกว้างป้ายตัวเลขที่วัดจริงในเบราว์เซอร์

/* หน่วยความจำของตารางกระโดด หน่วย MB ในหน้านี้คือ 1,048,576 ไบต์ ตรงกับที่ /usr/bin/time รายงาน */
const MIB = 1048576;
const mb = (bytes: number): string => (bytes / MIB).toFixed(1);
const TABLE_OLD = (3 * N_MAX + 2) * LOG * 4;
const TABLE_NEW = (N_MAX + 2) * LOG * 4;

/* ---------- ค่าที่วัดจริง ----------
   วิธีวัด: WSL Ubuntu 22.04, g++ 11.4 -O2, /usr/bin/time (เวลาจริงกับหน่วยความจำสูงสุด)
   หกชุดที่ N = 200,000 (งานยาวสุ่มเต็มช่วง งานทับกันหนาแน่น งานสั้นกระจายห่าง งานยาวหนึ่งถึงสองวัน และแบบผสม)
   ตัวเลขข้างล่างคือค่าที่แย่ที่สุดในหกชุด ของเวลาที่เร็วที่สุดจาก 5 รอบ และหน่วยความจำสูงสุด
   ใช้รอบที่เร็วที่สุดเพราะเครื่องมีงานอื่นรันอยู่พร้อมกัน */
const MEASURED = {
  oldSec: 0.92,
  oldKb: 60452,
  newSec: 0.59,
  newKb: 34704,
  /* ชุดเดียวกัน (งานสั้นกระจายห่าง) ใช้เทียบหน่วยความจำก่อนกับหลัง */
  oldSameKb: 60432,
  newSameKb: 32636,
  slowFullSec: 23.0,
  brute20Sec: 0.26,
  brute22Sec: 1.37,
  stressSmall: 3000,
  stressMedium: 300,
};
const mbKb = (kb: number): string => (kb / 1024).toFixed(1);
const OLD_HEADROOM = (MEM_LIMIT - MEASURED.oldKb / 1024).toFixed(1);
/* บนชุดเดียวกัน หน่วยความจำที่ลดต้องใกล้กับที่ตารางเล็กลง ไม่งั้นคำอธิบายผิด */
const SAME_DROP = (MEASURED.oldSameKb - MEASURED.newSameKb) / 1024;
const TABLE_DROP = (TABLE_OLD - TABLE_NEW) / MIB;
if (Math.abs(SAME_DROP - TABLE_DROP) > 1.5) throw new Error('convention-centre: หน่วยความจำที่ลดไม่ตรงกับขนาดตาราง');

/* ---------- ข้อความที่งอกจากชุดตัวอย่าง ---------- */
const DEMO_LIST = DEMO.map((q) => `#${q.id} (${q.s} ถึง ${q.e})`);

/* ท่าโลภเดินจากวันที่ 1 ทีละก้าว พร้อมบอกตัวที่จบวันเดียวกัน */
const GREEDY_STEPS = (() => {
  let p = 1;
  return DEMO_CHAIN.map((q) => {
    const ties = DEMO.filter((o) => o.s >= p && o.e <= DEMO_HI && o.e === q.e && o.id !== q.id).map((o) => o.id);
    const step = { p, q, ties, next: q.e + 1 };
    p = q.e + 1;
    return step;
  });
})();
const TIE_STEP = GREEDY_STEPS.find((g) => g.ties.length > 0);
if (!TIE_STEP) throw new Error('convention-centre: ชุดตัวอย่างไม่มีตัวที่จบวันเดียวกัน ข้อความเรื่องเสมอใช้ไม่ได้');
const TIE: { p: number; id: number; other: number; e: number } = { p: TIE_STEP.p, id: TIE_STEP.q.id, other: TIE_STEP.ties[0], e: TIE_STEP.q.e };

/* สภาพหลังรับตัวแรก: ตัวที่รับ + ผลรวมของแต่ละช่องว่าง ต้องเท่ากับจำนวนรวม */
const FIRST_TAKE = DEMO_RUN.trace.find((t) => t.kind === 'take');
if (!FIRST_TAKE || FIRST_TAKE.id !== WX.id) throw new Error('convention-centre: ตัวแรกที่รับต้องเป็นตัวอย่างสูตร');
const GAP_STATE = [
  { l: WX.gl, r: WX.s - 1, c: WX.c1 },
  { l: WX.e + 1, r: WX.gr, c: WX.c2 },
];
for (const g of GAP_STATE) if (g.c !== bruteCount(DEMO, g.l, g.r)) throw new Error('convention-centre: จำนวนของช่องว่างไม่ตรง');
if (1 + GAP_STATE[0].c + GAP_STATE[1].c !== DEMO_RUN.total) throw new Error('convention-centre: ตัวที่รับ + ช่องว่างไม่เท่ากับจำนวนรวม');

/* แจกแจงจำนวนก้าวของโค้ดเต็ม ให้รวมกันได้ fullOps พอดี */
const OPS_QUERY = N_MAX * FULL_PER_COMPANY;
const OPS_SORT = 2 * N_MAX * BS;
const OPS_BUILD = LOG * (N_MAX + 2);
if (OPS_QUERY + OPS_SORT + OPS_BUILD !== fullOps(N_MAX)) throw new Error('convention-centre: แจกแจงก้าวไม่ครบ');
const SLOW_MEASURED_X = Math.round(MEASURED.slowFullSec / TIME_LIMIT);

const slowCode = `// ชุดย่อย N <= 3,000: ตรรกะช่องว่างเหมือนตัวเต็มทุกบรรทัด ต่างกันแค่ cnt ที่ไล่งานทีละตัว
#include <bits/stdc++.h>
using namespace std;

vector<pair<int,int>> byEnd;          // (วันจบ, วันเริ่ม) เรียงตามวันจบ

// ท่าโลภ: ไล่งานตามวันจบ หยิบทุกตัวที่อยู่ในช่วงและเริ่มหลังตัวที่หยิบล่าสุด
int cnt(int l, int r){
    int cur = l - 1, res = 0;
    for(auto [en, st] : byEnd){
        if(en > r) break;
        if(st > cur){ cur = en; res++; }
        // st >= l เป็นจริงเองเมื่อ st > cur เพราะ cur เริ่มที่ l - 1
    }
    return res;
}

int main(){
    int n;
    if(scanf("%d", &n) != 1) return 0;
    vector<int> s(n), e(n);
    for(int i = 0; i < n; i++) if(scanf("%d %d", &s[i], &e[i]) != 2) return 0;
    for(int i = 0; i < n; i++) byEnd.push_back({e[i], s[i]});
    sort(byEnd.begin(), byEnd.end());

    const int LO = 1, HI = 1000000000;
    int total = cnt(LO, HI);
    map<int, pair<int,int>> gaps;     // วันเริ่มช่องว่าง -> (วันจบช่องว่าง, วางได้กี่งาน)
    gaps[LO] = {HI, total};
    vector<int> chosen;
    for(int i = 0; i < n && (int)chosen.size() < total; i++){
        auto it = gaps.upper_bound(s[i]);
        if(it == gaps.begin()) continue;
        --it;
        int gl = it->first, gr = it->second.first, c = it->second.second;
        if(e[i] > gr) continue;                                  // คร่อมงานที่รับไปแล้ว
        int c1 = cnt(gl, s[i] - 1), c2 = cnt(e[i] + 1, gr);
        if(c1 + 1 + c2 != c) continue;                           // รับแล้วช่องว่างนี้เสียจำนวน
        gaps.erase(it);
        if(gl <= s[i] - 1) gaps[gl] = {s[i] - 1, c1};
        if(e[i] + 1 <= gr) gaps[e[i] + 1] = {gr, c2};
        chosen.push_back(i + 1);
    }

    printf("%d\\n", total);
    for(size_t i = 0; i < chosen.size(); i++) printf("%d%c", chosen[i], i + 1 == chosen.size() ? '\\n' : ' ');
    if(chosen.empty()) printf("\\n");
}`;

const solution = `#include <bits/stdc++.h>
using namespace std;

const int LOG = 18;                   // 2^18 = 262,144 มากกว่า N ที่มากที่สุด
const int NONE = INT_MAX;             // ไปต่อไม่ได้ ตั้งเป็นค่าใหญ่สุดเพื่อให้ตกการเทียบ q <= lim เอง
vector<int> xs;                       // พิกัดที่การนับไปยืนได้: วันที่ 1 และวันจบ + 1 ของทุกงาน
vector<array<int, LOG>> up;           // up[i][k] = กระโดด 2^k ก้าวจากพิกัด i แล้วไปถึงพิกัดไหน
inline int idxOf(int v){ return (int)(lower_bound(xs.begin(), xs.end(), v) - xs.begin()); }

// ---- นับ: วางงานที่ไม่ทับกันได้มากที่สุดกี่งาน ในช่วงวัน [l, r] ----
int cnt(int l, int r){
    if(l > r) return 0;
    int cur = idxOf(l), res = 0;
    int lim = (int)(upper_bound(xs.begin(), xs.end(), r + 1) - xs.begin()) - 1;  // พิกัดสุดท้ายที่ไม่เกิน r + 1
    for(int k = LOG - 1; k >= 0; k--){
        int q = up[cur][k];
        if(q <= lim){ res += 1 << k; cur = q; }   // ก้าวนี้ยังไม่เลยขอบขวา ก้าวได้
    }
    return res;
}

int main(){
    int n;
    if(scanf("%d", &n) != 1) return 0;
    vector<int> s(n), e(n);
    for(int i = 0; i < n; i++) if(scanf("%d %d", &s[i], &e[i]) != 2) return 0;

    // ---- บีบพิกัด: ไม่ต้องเก็บวันเริ่ม เพราะการนับไม่เคยไปยืนที่วันเริ่ม ----
    xs.reserve(n + 2);
    for(int i = 0; i < n; i++) xs.push_back(e[i] + 1);
    xs.push_back(1); xs.push_back(1000000001);
    sort(xs.begin(), xs.end()); xs.erase(unique(xs.begin(), xs.end()), xs.end());
    int m = (int)xs.size();

    // ---- ก้าวเดียว: จากพิกัด i หยิบงานที่เริ่มไม่ก่อน xs[i] และจบเร็วที่สุด แล้วไปต่อที่วันจบ + 1 ----
    vector<pair<int,int>> byStart(n);
    for(int i = 0; i < n; i++) byStart[i] = {s[i], e[i]};
    sort(byStart.begin(), byStart.end());
    up.assign(m, {});
    int best = INT_MAX, j = n - 1;
    for(int i = m - 1; i >= 0; i--){
        while(j >= 0 && byStart[j].first >= xs[i]){ best = min(best, byStart[j].second); j--; }
        up[i][0] = (best == INT_MAX) ? NONE : idxOf(best + 1);
    }

    // ---- ตารางกระโดด: 2^k ก้าว = 2^(k-1) ก้าว สองรอบ ----
    for(int k = 1; k < LOG; k++) for(int i = 0; i < m; i++){
        int q = up[i][k - 1];
        up[i][k] = (q == NONE) ? NONE : up[q][k - 1];
    }

    // ---- ไล่ตามหมายเลข: ช่องว่างแต่ละช่องจำไว้ว่าวางได้กี่งาน ----
    const int LO = 1, HI = 1000000000;
    int total = cnt(LO, HI);
    map<int, pair<int,int>> gaps;     // วันเริ่มช่องว่าง -> (วันจบช่องว่าง, วางได้กี่งาน)
    gaps[LO] = {HI, total};
    vector<int> chosen;
    for(int i = 0; i < n && (int)chosen.size() < total; i++){
        auto it = gaps.upper_bound(s[i]);
        if(it == gaps.begin()) continue;
        --it;
        int gl = it->first, gr = it->second.first, c = it->second.second;
        if(e[i] > gr) continue;                                  // คร่อมงานที่รับไปแล้ว
        int c1 = cnt(gl, s[i] - 1), c2 = cnt(e[i] + 1, gr);
        if(c1 + 1 + c2 != c) continue;                           // รับแล้วช่องว่างนี้เสียจำนวน
        gaps.erase(it);
        if(gl <= s[i] - 1) gaps[gl] = {s[i] - 1, c1};
        if(e[i] + 1 <= gr) gaps[e[i] + 1] = {gr, c2};
        chosen.push_back(i + 1);
    }

    printf("%d\\n", total);
    for(size_t i = 0; i < chosen.size(); i++) printf("%d%c", chosen[i], i + 1 == chosen.size() ? '\\n' : ' ');
    if(chosen.empty()) printf("\\n");
}`;

const bruteCode = `// ตัวตรวจ ลองทุกเซตย่อย เอาเซตใหญ่ที่สุดที่เรียงแล้วเล็กที่สุดตามพจนานุกรม
// ไม่มีท่าโลภหรือตารางกระโดดอยู่ในนี้เลย
#include <bits/stdc++.h>
using namespace std;
int main(){
    int n; scanf("%d", &n); vector<int> s(n), e(n);
    for(int i = 0; i < n; i++) scanf("%d %d", &s[i], &e[i]);
    vector<int> best;
    for(int m = 0; m < (1 << n); m++){
        vector<int> id; bool ok = true;
        for(int i = 0; i < n; i++) if(m >> i & 1) id.push_back(i);
        for(size_t a = 0; a < id.size() && ok; a++) for(size_t b = a + 1; b < id.size() && ok; b++){
            int x = id[a], y = id[b]; if(!(e[x] < s[y] || e[y] < s[x])) ok = false; }
        if(!ok) continue;
        if(id.size() > best.size() || (id.size() == best.size() && id < best)) best = id;
    }
    printf("%d\\n", (int)best.size());
    for(size_t i = 0; i < best.size(); i++) printf("%d%c", best[i] + 1, i + 1 == best.size() ? '\\n' : ' ');
    if(best.empty()) printf("\\n");
}`;
