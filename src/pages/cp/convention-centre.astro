<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type CcReq = { id: number; s: number; e: number };
  type CcPuzzle = { id: string; label: string; tease: string; reqs: CcReq[]; answer: number[]; lo: number; hi: number };

  function initConventionGame(): void {
    const maybeUi = cpGameUi('[data-ccgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as CcPuzzle[];
    if (puzzles.length === 0) return;

    let pi = 0;
    let taken: number[] = [];

    const pz = (): CcPuzzle => puzzles[pi];
    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-cc-board]'));
    const reqOf = (p: CcPuzzle, id: number): CcReq | undefined => p.reqs.find((q) => q.id === id);

    function render(): void {
      const p = pz();
      boards.forEach((b, k) => {
        b.hidden = k !== pi;
      });
      for (const bar of Array.from(boards[pi].querySelectorAll<SVGRectElement>('[data-cc-req]'))) {
        const id = Number((bar.dataset.ccReq ?? '').split(':')[1]);
        const q = reqOf(p, id);
        const clash =
          q !== undefined &&
          !taken.includes(id) &&
          taken.some((t) => {
            const o = reqOf(p, t);
            return o !== undefined && !(q.e < o.s || o.e < q.s);
          });
        bar.classList.toggle('taken', taken.includes(id));
        bar.classList.toggle('clash', clash);
      }
      ui.setScore(`รับไว้ ${taken.length} บริษัท คือ ${taken.length ? [...taken].sort((a, b) => a - b).join(', ') : 'ยังไม่มี'}`);
    }

    function toggle(id: number): void {
      const p = pz();
      const at = taken.indexOf(id);
      if (at >= 0) {
        taken.splice(at, 1);
        render();
        return;
      }
      const q = reqOf(p, id);
      if (!q) return;
      const hit = taken.find((t) => {
        const o = reqOf(p, t);
        return o !== undefined && !(q.e < o.s || o.e < q.s);
      });
      if (hit !== undefined) {
        ui.setStatus(`บริษัท ${id} ทับช่วงกับบริษัท ${hit} ที่รับไว้แล้ว ห้องมีห้องเดียว จึงรับพร้อมกันไม่ได้`, 'bad');
        return;
      }
      taken.push(id);
      ui.setStatus(`รับบริษัท ${id} แล้ว`, 'plain');
      render();
    }

    function check(): void {
      const p = pz();
      const mine = [...taken].sort((a, b) => a - b);
      const want = p.answer;
      if (mine.join(',') === want.join(',')) {
        ui.setStatus(`ถูกต้องครับ ชุดนี้ใหญ่ที่สุดที่ ${want.length} บริษัท และหมายเลขเล็กที่สุดด้วย`, 'good');
        return;
      }
      if (mine.length < want.length) {
        ui.setStatus(`ชุดนี้ได้ ${mine.length} บริษัท แต่จัดได้ถึง ${want.length} บริษัท ลองหาตัวที่กินที่ของคนอื่นแล้วเอาออก`, 'bad');
        return;
      }
      ui.setStatus(`จำนวนถูกแล้วที่ ${want.length} บริษัท แต่ยังมีชุดที่หมายเลขเล็กกว่านี้ ลองไล่จากบริษัทหมายเลขน้อยไปมากดู`, 'bad');
    }

    function selectPuzzle(k: number): void {
      pi = k;
      taken = [];
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ui.setStatus('กดที่แท่งเพื่อรับบริษัทนั้น แท่งที่ทับกันรับพร้อมกันไม่ได้');
      render();
    }

    ui.root.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const bar = e.target.closest('[data-cc-req]');
      if (!(bar instanceof SVGElement)) return;
      toggle(Number((bar.dataset.ccReq ?? '').split(':')[1]));
    });

    ui.onClick('data-cc-clear', () => selectPuzzle(pi));
    ui.onClick('data-cc-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initConventionGame);
</script>

