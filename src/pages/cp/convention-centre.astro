const href = 'convention-centre/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Req = { id: number; s: number; e: number };

/** จำนวนงานมากที่สุดที่วางได้ทั้งก้อนในช่วงวัน [l, r] ท่าโลภมาตรฐาน คือเลือกตัวที่จบเร็วที่สุดก่อน */
function countIn(reqs: Req[], l: number, r: number): number {
  const fit = reqs.filter((q) => q.s >= l && q.e <= r).sort((a, b) => a.e - b.e);
  let cur = l - 1;
  let n = 0;
  for (const q of fit)
    if (q.s > cur) {
      cur = q.e;
      n++;
    }
  return n;
}

type Trace = { id: number; s: number; e: number; taken: boolean; gap: [number, number] | null; c1: number; c2: number; c: number };

/** ไล่ตามหมายเลขบริษัท รับได้ก็รับ ตราบใดที่จำนวนรวมยังไม่ลด */
function lexSmallest(reqs: Req[], LO: number, HI: number): { chosen: number[]; total: number; trace: Trace[] } {
  const total = countIn(reqs, LO, HI);
  let gaps: [number, number][] = [[LO, HI]];
  const chosen: number[] = [];
  const trace: Trace[] = [];
  for (const q of reqs) {
    if (chosen.length === total) {
      trace.push({ id: q.id, s: q.s, e: q.e, taken: false, gap: null, c1: 0, c2: 0, c: 0 });
      continue;
    }
    const gi = gaps.findIndex((g) => q.s >= g[0] && q.e <= g[1]);
    if (gi < 0) {
      trace.push({ id: q.id, s: q.s, e: q.e, taken: false, gap: null, c1: 0, c2: 0, c: 0 });
      continue;
    }
    const [gl, gr] = gaps[gi];
    const c = countIn(reqs, gl, gr);
    const c1 = countIn(reqs, gl, q.s - 1);
    const c2 = countIn(reqs, q.e + 1, gr);
    const ok = c1 + 1 + c2 === c;
    if (ok) {
      gaps = gaps.filter((_, i) => i !== gi);
      if (gl <= q.s - 1) gaps.push([gl, q.s - 1]);
      if (q.e + 1 <= gr) gaps.push([q.e + 1, gr]);
      gaps.sort((a, b) => a[0] - b[0]);
      chosen.push(q.id);
    }
    trace.push({ id: q.id, s: q.s, e: q.e, taken: ok, gap: [gl, gr], c1, c2, c });
  }
  return { chosen, total, trace };
}

/** ตัวตรวจ ลองทุกเซตย่อย เอาเซตใหญ่ที่สุดที่เรียงแล้วเล็กที่สุดตามพจนานุกรม */
function bruteLex(reqs: Req[]): number[] {
  let best: number[] = [];
  for (let m = 0; m < 1 << reqs.length; m++) {
    const ids: number[] = [];
    for (let i = 0; i < reqs.length; i++) if ((m >> i) & 1) ids.push(i);
    let ok = true;
    for (let a = 0; a < ids.length && ok; a++)
      for (let b = a + 1; b < ids.length && ok; b++) {
        const x = reqs[ids[a]];
        const y = reqs[ids[b]];
        if (!(x.e < y.s || y.e < x.s)) ok = false;
      }
    if (!ok) continue;
    const list = ids.map((i) => reqs[i].id);
    if (list.length > best.length) best = list;
    else if (list.length === best.length) {
      for (let i = 0; i < list.length; i++) {
        if (list[i] < best[i]) {
          best = list;
          break;
        }
        if (list[i] > best[i]) break;
      }
    }
  }
  return best;
}

const mk = (rows: [number, number][]): Req[] => rows.map(([s, e], i) => ({ id: i + 1, s, e }));

/* ---------- ตัวอย่างในโจทย์ ---------- */
const SAMPLE = mk([[4, 9], [9, 11], [13, 19], [10, 17]]);
const SAMPLE_RUN = lexSmallest(SAMPLE, 1, 1000000000);

/* ด่านตรวจตอนบิลด์ ท่าที่สอนต้องตรงกับการลองทุกเซตย่อย ไม่งั้นหน้านี้ไม่ขึ้น */
const SWEEP_CASES = 400;
{
  let seed = 20280909;
  const rnd = (m: number): number => {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed % m;
  };
  for (let t = 0; t < SWEEP_CASES; t++) {
    const n = 1 + rnd(9);
    const D = [6, 12, 25][rnd(3)];
    const rows: [number, number][] = [];
    for (let i = 0; i < n; i++) {
      const a = 1 + rnd(D);
      rows.push([a, a + rnd(5)]);
    }
    const reqs = mk(rows);
    const got = lexSmallest(reqs, 1, 1000000000).chosen;
    const want = bruteLex(reqs);
    if (got.join(',') !== want.join(','))
      throw new Error(`convention-centre: ได้ [${got}] แต่ควรได้ [${want}] ที่ ${JSON.stringify(rows)}`);
  }
  if (SAMPLE_RUN.chosen.join(' ') !== '1 3') throw new Error('convention-centre: ตัวอย่างในโจทย์ไม่ได้ 1 3');
}

/* ---------- ชุดสาธิตสำหรับตัวเล่นทีละขั้น ---------- */
const DEMO = mk([[2, 5], [1, 3], [4, 6], [6, 9], [7, 8], [10, 12], [9, 11], [3, 4]]);
const DEMO_RUN = lexSmallest(DEMO, 1, 20);
const demoSteps = DEMO_RUN.trace.map((t) => ({
  note: t.gap
    ? `บริษัท <b>${t.id}</b> ขอวันที่ <b>${t.s}</b> ถึง <b>${t.e}</b> ซึ่งอยู่ในช่องว่าง ${t.gap[0]} ถึง ${t.gap[1]} ` +
      `ช่องว่างนี้เดิมวางได้ <b>${t.c}</b> งาน ถ้ารับบริษัทนี้ จะเหลือซ้าย <b>${t.c1}</b> และขวา <b>${t.c2}</b> ` +
      `รวมเป็น <b>${t.c1 + 1 + t.c2}</b> ` +
      (t.taken ? 'ซึ่งเท่าเดิม จึง<b>รับได้</b>' : 'ซึ่ง<b>น้อยกว่าเดิม</b> จึงต้องปฏิเสธ')
    : `บริษัท <b>${t.id}</b> ขอวันที่ <b>${t.s}</b> ถึง <b>${t.e}</b> ซึ่ง<b>คร่อมงานที่รับไปแล้ว</b> จึงรับไม่ได้ตั้งแต่ต้น`,
}));

/* ---------- แผนภาพเส้นเวลา แสดงการกระโดดของท่าโลภ ---------- */
const TL_LO = 1;
const TL_HI = 12;
const TL_X = 40;
const TL_UNIT = 52;
const TL_ROW = 30;
const tlX = (d: number): number => TL_X + (d - TL_LO) * TL_UNIT;
/** จากตำแหน่ง p งานที่เริ่มไม่ก่อน p และจบเร็วที่สุด คือตัวที่ท่าโลภหยิบ */
function greedyChain(reqs: Req[], lo: number, hi: number): Req[] {
  const out: Req[] = [];
  let p = lo;
  for (;;) {
    const cand = reqs.filter((q) => q.s >= p && q.e <= hi).sort((a, b) => a.e - b.e)[0];
    if (!cand) break;
    out.push(cand);
    p = cand.e + 1;
  }
  return out;
}
const TL_CHAIN = greedyChain(DEMO, TL_LO, TL_HI);
const TL_ROWS = DEMO.slice().sort((a, b) => a.e - b.e);
const TL_W = tlX(TL_HI) + TL_UNIT + 12;
const TL_LANE = 34 + TL_ROWS.length * TL_ROW + 22;
const TL_H = TL_LANE + 22 + 34;

/* ---------- มินิเกม เลือกชุดที่ใหญ่ที่สุดและเล็กที่สุดตามพจนานุกรม ---------- */
type GamePuzzle = { id: string; label: string; tease: string; reqs: Req[]; answer: number[]; lo: number; hi: number };
function makePuzzle(id: string, label: string, tease: string, rows: [number, number][], hi: number): GamePuzzle {
  const reqs = mk(rows);
  const byGap = lexSmallest(reqs, 1, 1000000000).chosen;
  const byBrute = bruteLex(reqs);
  if (byGap.join(',') !== byBrute.join(',')) throw new Error(`convention-centre: เฉลยเกม ${id} ไม่ตรงกัน`);
  return { id, label, tease, reqs, answer: byBrute, lo: 1, hi };
}
const puzzles: GamePuzzle[] = [
  makePuzzle('a', 'ตัวอย่างในโจทย์ 4 บริษัท', 'ชุดนี้วางได้มากที่สุดสองงาน แต่มีหลายวิธี คำถามคือชุดไหนที่หมายเลขเรียงแล้วเล็กที่สุด', [[4, 9], [9, 11], [13, 19], [10, 17]], 20),
  makePuzzle('b', '7 บริษัท ที่มีตัวล่อ', 'ตัวที่เริ่มเร็วที่สุดไม่ได้ควรรับเสมอ ลองดูว่าตัวไหนกินที่ของอีกสองตัว', [[1, 6], [1, 2], [3, 4], [5, 6], [7, 9], [8, 12], [10, 12]], 14),
  makePuzzle('c', '8 บริษัทของบทนี้', 'ชุดนี้คือชุดที่ตารางเดินทีละขั้นข้างล่างใช้ ลองทำเองก่อนแล้วค่อยไปเทียบ', [[2, 5], [1, 3], [4, 6], [6, 9], [7, 8], [10, 12], [9, 11], [3, 4]], 14),
];
const puzzlesJson = JSON.stringify(puzzles);

/* ---------- บิลค่าใช้จ่าย ---------- */
const N_MAX = 200000;
const fmt = (n: number): string => n.toLocaleString('en-US');
const bill = [
  { name: 'ลองรับทีละตัว แล้วคำนวณจำนวนรวมใหม่ทั้งชุด', limit: 'N ไม่เกินราวสามพัน', work: `${fmt(N_MAX)} คูณ ${fmt(N_MAX)} คือสี่หมื่นล้าน` },
  { name: 'ตารางกระโดดสองยกกำลัง แล้วถามสี่ครั้งต่อบริษัท', limit: `N ถึง ${fmt(N_MAX)}`, work: `ราว ${fmt(N_MAX * 4 * 18 / 1000000)} ล้านครั้ง` },
];

const solution = `#include <bits/stdc++.h>
using namespace std;
int n, m_, LOG;
vector<int> xs;                       // พิกัดวันที่ถูกบีบแล้ว
vector<vector<int>> up;               // up[k][i] = ดัชนีพิกัดหลังกระโดด 2^k ครั้ง
const int NONE = -1;
inline int idxOf(int v){ return (int)(lower_bound(xs.begin(), xs.end(), v) - xs.begin()); }

// จำนวนงานที่ไม่ทับกันมากที่สุด ที่วางได้ทั้งก้อนในช่วงวัน [l, r]
int cnt(int l, int r){
    if(l > r) return 0;
    int cur = idxOf(l);               // พิกัดแรกที่ไม่ก่อน l
    if(cur >= m_) return 0;
    int res = 0;
    for(int k = LOG - 1; k >= 0; k--){
        int q = up[k][cur];
        if(q != NONE && xs[q] <= r + 1){ res += 1 << k; cur = q; }
    }
    return res;
}

int main(){
    if(scanf("%d", &n) != 1) return 0;
    vector<int> s(n), e(n);
    for(int i = 0; i < n; i++) scanf("%d %d", &s[i], &e[i]);
    xs.reserve(3 * n + 2);
    for(int i = 0; i < n; i++){ xs.push_back(s[i]); xs.push_back(e[i]); xs.push_back(e[i] + 1); }
    xs.push_back(1); xs.push_back(1000000001);
    sort(xs.begin(), xs.end()); xs.erase(unique(xs.begin(), xs.end()), xs.end());
    m_ = (int)xs.size();

    // f[i] = วันจบที่น้อยที่สุด ในบรรดางานที่เริ่มไม่ก่อนพิกัด xs[i]
    vector<int> f(m_, INT_MAX);
    { vector<vector<int>> byStart(m_);
      for(int i = 0; i < n; i++) byStart[idxOf(s[i])].push_back(e[i]);
      int best = INT_MAX;
      for(int i = m_ - 1; i >= 0; i--){ for(int v : byStart[i]) best = min(best, v); f[i] = best; } }

    LOG = 1; while((1 << LOG) <= n) LOG++;
    up.assign(LOG, vector<int>(m_, NONE));
    for(int i = 0; i < m_; i++) if(f[i] != INT_MAX) up[0][i] = idxOf(f[i] + 1);
    for(int k = 1; k < LOG; k++) for(int i = 0; i < m_; i++){
        int q = up[k-1][i]; up[k][i] = (q == NONE) ? NONE : up[k-1][q]; }

    int LO = 1, HI = 1000000000;
    int total = cnt(LO, HI);

    // ไล่ตามหมายเลขบริษัท รับได้ก็รับ ตราบใดที่จำนวนรวมยังไม่ลด
    set<pair<int,int>> gaps; gaps.insert({LO, HI});
    vector<int> chosen;
    for(int i = 0; i < n && (int)chosen.size() < total; i++){
        auto it = gaps.upper_bound({s[i], INT_MAX});
        if(it == gaps.begin()) continue;
        --it;
        int gl = it->first, gr = it->second;
        if(s[i] < gl || e[i] > gr) continue;                  // คร่อมงานที่รับไปแล้ว
        if(cnt(gl, s[i] - 1) + 1 + cnt(e[i] + 1, gr) != cnt(gl, gr)) continue;
        gaps.erase(it);
        if(gl <= s[i] - 1) gaps.insert({gl, s[i] - 1});
        if(e[i] + 1 <= gr) gaps.insert({e[i] + 1, gr});
        chosen.push_back(i + 1);
    }
    printf("%d\\n", total);
    for(size_t i = 0; i < chosen.size(); i++) printf("%d%c", chosen[i], i + 1 == chosen.size() ? '\\n' : ' ');
    if(chosen.empty()) printf("\\n");
}`;

const bruteCode = `// ตัวตรวจ ลองทุกเซตย่อย เอาเซตใหญ่ที่สุดที่เรียงแล้วเล็กที่สุดตามพจนานุกรม
// ไม่มีท่าโลภหรือตารางกระโดดอยู่ในนี้เลย
#include <bits/stdc++.h>
using namespace std;
int main(){
    int n; scanf("%d", &n); vector<int> s(n), e(n);
    for(int i = 0; i < n; i++) scanf("%d %d", &s[i], &e[i]);
    vector<int> best;
    for(int m = 0; m < (1 << n); m++){
        vector<int> id; bool ok = true;
        for(int i = 0; i < n; i++) if(m >> i & 1) id.push_back(i);
        for(size_t a = 0; a < id.size() && ok; a++) for(size_t b = a + 1; b < id.size() && ok; b++){
            int x = id[a], y = id[b]; if(!(e[x] < s[y] || e[y] < s[x])) ok = false; }
        if(!ok) continue;
        if(id.size() > best.size() || (id.size() == best.size() && id < best)) best = id;
    }
    printf("%d\\n", (int)best.size());
    for(size_t i = 0; i < best.size(); i++) printf("%d%c", best[i] + 1, i + 1 == best.size() ? '\\n' : ' ');
    if(best.empty()) printf("\\n");
}`;

const coreSnippet = `// รับบริษัทนี้ได้ก็ต่อเมื่อจำนวนรวมของช่องว่างที่มันตกอยู่ ไม่ลดลง
// ซ้ายของมัน บวกตัวมันเอง บวกขวาของมัน ต้องเท่ากับที่ช่องว่างนี้เคยวางได้
if(cnt(gl, s[i] - 1) + 1 + cnt(e[i] + 1, gr) != cnt(gl, gr)) continue;`;
