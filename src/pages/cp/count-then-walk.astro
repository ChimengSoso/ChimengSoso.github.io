  table.rec td{color:var(--dl-ink);line-height:1.55;}
  table.rec td strong{color:var(--dl-gold);}
  table.rec td.num{
    text-align:right;
    font-family:"Fira Code","Fira Mono",monospace;
    font-variant-numeric:tabular-nums;
    white-space:nowrap;
    color:#cdd6ea;
  }
  table.rec th.num{text-align:right;}

  .dim{color:#7b8397;}

  /* ---------- แถบหลักของมินิเกมนับแล้วเดิน ---------- */
  .cw-strip{display:flex;gap:5px;width:max-content;}
  .cw-strip :global(.cw-cell){
    width:2rem;height:2.3rem;
    display:flex;align-items:center;justify-content:center;
    font-family:var(--dl-mono,monospace);font-size:1rem;
    border:1px solid #2a3350;border-radius:6px;
    background:#101827;color:#7b8397;
  }
  .cw-strip :global(.cw-cell.zero){color:#9ecbff;border-color:#3d5a80;}
  .cw-strip :global(.cw-cell.one){color:#4ade80;border-color:#2f9e5c;background:#14351f;}
</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type CwPuzzle = {
    id: string;
    label: string;
    tease: string;
    n: number;
    r: number;
    total: number;
    answer: string;
  };

  function initCountWalkGame(): void {
    const maybeUi = cpGameUi('[data-cwgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as CwPuzzle[];
    if (puzzles.length === 0) return;

    const stripEl = ui.root.querySelector<HTMLElement>('[data-cw-strip]');
    const curEl = ui.root.querySelector<HTMLElement>('[data-cw-cur]');
    const nEl = ui.root.querySelector<HTMLElement>('[data-cw-n]');
    const rEl = ui.root.querySelector<HTMLElement>('[data-cw-r]');
    const totalEl = ui.root.querySelector<HTMLElement>('[data-cw-total]');
    if (!stripEl || !curEl || !nEl || !rEl || !totalEl) return;
    const strip: HTMLElement = stripEl;
    const curOut: HTMLElement = curEl;
    const nOut: HTMLElement = nEl;
    const rOut: HTMLElement = rEl;
    const totalOut: HTMLElement = totalEl;

    let pi = 0;
    let cur = '';

    const pz = (): CwPuzzle => puzzles[pi];

    function buildStrip(): void {
      const p = pz();
      strip.textContent = '';
      for (let i = 0; i < p.n; i++) {
        const cell = document.createElement('span');
        cell.className = 'cw-cell';
        cell.dataset.i = String(i);
        cell.textContent = '.';
        strip.appendChild(cell);
      }
    }

    function render(): void {
      const p = pz();
      for (const cell of Array.from(strip.querySelectorAll<HTMLElement>('.cw-cell'))) {
        const i = Number(cell.dataset.i);
        const has = i < cur.length;
        cell.textContent = has ? cur[i] : '.';
        cell.classList.toggle('one', has && cur[i] === '1');
        cell.classList.toggle('zero', has && cur[i] === '0');
      }
      curOut.textContent = cur === '' ? 'ยังว่าง' : cur;
      nOut.textContent = String(p.n);
      rOut.textContent = String(p.r);
      totalOut.textContent = String(p.total);
    }

    function put(c: string): void {
      const p = pz();
      if (cur.length >= p.n) {
        ui.setStatus(`ครบ ${p.n} หลักแล้ว กดตรวจได้เลย`);
        return;
      }
      if (c === '1' && cur[cur.length - 1] === '1') {
        ui.setStatus('วางเลขหนึ่งติดกันไม่ได้ครับ', 'bad');
        return;
      }
      cur += c;
      ui.setStatus('วางทีละหลัก ห้ามให้เลขหนึ่งอยู่ติดกัน');
      render();
    }

    function undo(): void {
      if (cur.length === 0) return;
      cur = cur.slice(0, -1);
      ui.setStatus('ถอนหลักล่าสุดแล้ว');
      render();
    }

    function check(): void {
      const p = pz();
      if (cur.length !== p.n) {
        ui.setStatus(`ยังไม่ครบ ต้องได้ ${p.n} หลัก ตอนนี้ ${cur.length} หลัก`, 'bad');
        return;
      }
      if (cur === p.answer) {
        ui.setStatus(`ถูกต้องครับ ${cur} คือสตริงอันดับที่ ${p.r}`, 'good');
        return;
      }
      ui.setStatus(
        `${cur} ถูกกติกาจริง แต่มัน${cur < p.answer ? 'มาก่อน' : 'มาหลัง'}อันดับที่ ${p.r}`,
        'bad',
      );
    }

    function selectPuzzle(k: number): void {
      pi = k;
      cur = '';
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildStrip();
      ui.setStatus('วางทีละหลัก ห้ามให้เลขหนึ่งอยู่ติดกัน');
      render();
    }

    ui.onClick('data-cw-zero', () => put('0'));
    ui.onClick('data-cw-one', () => put('1'));
    ui.onClick('data-cw-undo', undo);
    ui.onClick('data-cw-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initCountWalkGame);
</script>
