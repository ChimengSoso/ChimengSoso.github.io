---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const href = 'count-then-walk/';

/* ---------- ตัวเลขในหน้านี้งอกจากโมเดลข้างล่างนี้ ---------- */

const N = 6;
const R = 9;

/** สตริงฐานสองยาว n ที่ไม่มีเลข 1 ติดกัน เรียงตามพจนานุกรม */
function noAdjacentOnes(n: number): string[] {
  const out: string[] = [];
  const rec = (cur: string): void => {
    if (cur.length === n) {
      out.push(cur);
      return;
    }
    rec(cur + '0');
    if (cur[cur.length - 1] !== '1') rec(cur + '1');
  };
  rec('');
  return out;
}
const listed = noAdjacentOnes(N);
const target = listed[R - 1];

/** f[i][last] = จำนวนวิธีเติมตำแหน่ง i..n-1 เมื่อตัวก่อนหน้าคือ last */
function suffix(n: number): number[][] {
  const f: number[][] = Array.from({ length: n + 1 }, () => [0, 0]);
  f[n] = [1, 1];
  for (let i = n - 1; i >= 0; i--) {
    f[i][0] = f[i + 1][0] + f[i + 1][1];
    f[i][1] = f[i + 1][0];
  }
  return f;
}
const F = suffix(N);
const totalCount = F[0][0];

/* ---------- ภาพบันได ทุกช่องมาจาก walk() ตัวเดียวกับตารางในบทนี้ ----------
   แต่ละขั้นบันไดคือหนึ่งตำแหน่ง ซ้ายคือกิ่ง 0 ขวาคือกิ่ง 1
   กิ่งที่ถูกข้ามจะแสดงขนาดของมันไว้ เพราะขนาดนั้นคือจำนวนที่อันดับถูกหักออก */
const STEP_X = 116;
const STEP_Y = 56;
const BW2 = 52;
const BH2 = 34;
const stepX = (i: number): number => 26 + i * STEP_X;
const stepY = (i: number): number => 34 + i * STEP_Y;
/** อันดับที่เหลือ "ก่อน" ตัดสินใจของแต่ละขั้น ใช้เล่าว่าเทียบกับอะไร */
const remBefore = (i: number): number => (i === 0 ? R : walkRows[i - 1].rest);
const ctwVB = `0 0 ${stepX(N - 1) + BW2 + 162} ${stepY(N - 1) + BH2 + 68}`;


type Walk = { i: number; rest: number; zero: number; one: number | null; pick: string };
function walk(n: number, r: number): Walk[] {
  const f = suffix(n);
  const rows: Walk[] = [];
  let last = 0;
  let rem = r;
  for (let i = 0; i < n; i++) {
    const zero = f[i + 1][0];
    const one = last === 1 ? null : f[i + 1][1];
    let pick: string;
    if (rem <= zero) pick = '0';
    else {
      rem -= zero;
      pick = '1';
    }
    rows.push({ i, rest: rem, zero, one, pick });
    last = pick === '1' ? 1 : 0;
  }
  return rows;
}
const walkRows = walk(N, R);

/* ฟีโบนักชีที่โผล่มาเอง */
const fibRow = Array.from({ length: 10 }, (_, i) => ({ n: i + 1, c: noAdjacentOnes(i + 1).length }));

const code1 = `// สตริงฐานสองยาว n ที่ไม่มีเลข 1 ติดกัน  ตัวที่ R ตามลำดับพจนานุกรม
#include <bits/stdc++.h>
using namespace std;
typedef unsigned long long ull;
int main() {
    int n; ull R;
    scanf("%d %llu", &n, &R);
    // f[i][last] = จำนวนวิธีเติมตำแหน่ง i..n-1 เมื่อตัวก่อนหน้าคือ last
    vector<array<ull,2>> f(n + 1);
    f[n][0] = f[n][1] = 1;
    for (int i = n - 1; i >= 0; i--) {
        f[i][0] = f[i + 1][0] + f[i + 1][1];   // ตัวก่อนเป็น 0 ใส่ได้ทั้ง 0 และ 1
        f[i][1] = f[i + 1][0];                 // ตัวก่อนเป็น 1 ใส่ได้แค่ 0
    }
    if (R > f[0][0]) { printf("-1\\n"); return 0; }
    string out; int last = 0;
    for (int i = 0; i < n; i++) {
        for (int b = 0; b <= 1; b++) {         // ไล่ 0 ก่อน 1 ตามพจนานุกรม
            if (b == 1 && last == 1) continue;
            ull cnt = f[i + 1][b];
            if (R <= cnt) { out.push_back('0' + b); last = b; break; }
            R -= cnt;
        }
    }
    printf("%s\\n", out.c_str());
}`;
const code2 = `// อันดับของการเรียงสับเปลี่ยนตามพจนานุกรม  (สมาชิกคือ 1..n ไม่ซ้ำ)
#include <bits/stdc++.h>
using namespace std;
typedef unsigned long long ull;
int main() {
    int n; scanf("%d", &n);
    vector<int> p(n);
    for (auto& v : p) scanf("%d", &v);
    vector<ull> fact(n + 1, 1);
    for (int i = 1; i <= n; i++) fact[i] = fact[i - 1] * i;
    vector<char> used(n + 2, 0);
    ull rank_ = 1;
    for (int i = 0; i < n; i++) {
        int smaller = 0;                        // ตัวที่ยังไม่ถูกใช้และเล็กกว่า p[i]
        for (int v = 1; v < p[i]; v++) if (!used[v]) smaller++;
        rank_ += (ull)smaller * fact[n - i - 1];
        used[p[i]] = 1;
    }
    printf("%llu\\n", rank_);
}`;
/* ---------- มินิเกม เดินหาสตริงอันดับที่ R ----------
   รายการสตริงที่ถูกกติกาสร้างครบตอนบิลด์ อันดับที่เกมใช้ตัดสินจึงมาจากรายการจริง
   ไม่ได้มาจากสูตรนับที่บทนี้กำลังจะสอน */
type CwPuzzle = { id: string; label: string; tease: string; n: number; r: number };

const CW_PUZZLES: CwPuzzle[] = [
  { id: 'c1', label: 'ชุดที่ 1 · อุ่นเครื่อง', tease: 'ยาวสี่หลัก ลองไล่ดูก่อนว่ามีกี่แบบ', n: 4, r: 5 },
  { id: 'c2', label: 'ชุดที่ 2 · กลางตาราง', tease: 'ยาวหกหลัก อันดับอยู่กลาง ๆ เดาสุ่มเริ่มไม่ไหว', n: 6, r: 12 },
  { id: 'c3', label: 'ชุดที่ 3 · ตัวสุดท้าย', tease: 'ชุดนี้ขออันดับสุดท้ายพอดี ลองดูว่ามันหน้าตาเป็นยังไง', n: 7, r: noAdjacentOnes(7).length },
];

type CwPuzzleData = {
  id: string;
  label: string;
  tease: string;
  n: number;
  r: number;
  total: number;
  answer: string;
};
const cwPuzzles: CwPuzzleData[] = CW_PUZZLES.map((p) => {
  const list = noAdjacentOnes(p.n);
  if (p.r < 1 || p.r > list.length) {
    throw new Error(`มินิเกมของ count-then-walk: ชุด ${p.id} ขออันดับ ${p.r} แต่มีแค่ ${list.length} แบบ`);
  }
  return {
    id: p.id,
    label: p.label,
    tease: p.tease,
    n: p.n,
    r: p.r,
    total: list.length,
    answer: list[p.r - 1],
  };
});
const cwJson = JSON.stringify(cwPuzzles);

/* ---------- ค้นหาคำตอบแบบไบนารีคู่กับการนับ ----------
   โค้ดสองชิ้นนี้คอมไพล์แล้วสุ่มเทียบกัน 700 รอบ ตรงกันหมด
   วัดที่ n สองแสนได้ 0.08 วินาที */
const bsCode = `// ค้นหาคำตอบแบบไบนารีคู่กับการนับ: หาผลบวก a[i]+a[j] (i<j) ที่เล็กเป็นอันดับที่ k
// ไม่ต้องสร้างผลบวกทั้ง n(n-1)/2 ตัวเลย
// อินพุต: n k แล้วอาเรย์ n ตัว   เอาต์พุต: ค่าผลบวกอันดับที่ k (นับจาก 1)
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n; long long k;
    if (scanf("%d %lld", &n, &k) != 2) return 0;
    vector<long long> a(n);
    for (int i = 0; i < n; i++) scanf("%lld", &a[i]);
    sort(a.begin(), a.end());

    // นับว่ามีผลบวกกี่คู่ที่ไม่เกิน x ด้วยสองตัวชี้ ซึ่งเป็น O(n) ต่อการนับหนึ่งครั้ง
    auto countLE = [&](long long x) {
        long long c = 0;
        int j = n - 1;
        for (int i = 0; i < n; i++) {
            if (j <= i) j = i;                       // ไม่ให้ตัวชี้ขวาแซงมาซ้ายกว่าตัวชี้ซ้าย
            while (j > i && a[i] + a[j] > x) j--;
            if (j > i) c += j - i;                   // คู่ (i, i+1..j) ผ่านทั้งหมด
        }
        return c;
    };

    long long lo = a[0] + a[1], hi = a[n - 1] + a[n - 2];
    while (lo < hi) {
        long long mid = lo + (hi - lo) / 2;          // ระวังการปัดของเลขลบ ใช้รูปนี้จึงปลอดภัย
        if (countLE(mid) >= k) hi = mid;
        else lo = mid + 1;
    }
    printf("%lld\\n", lo);
    return 0;
}`;
const bsBrute = `// ตัวตรวจอิสระ: สร้างผลบวกทุกคู่จริง เรียง แล้วหยิบตัวที่ k
// ไม่มีการค้นหาแบบไบนารี ไม่มีการนับ จึงไม่ได้ทดสอบข้ออ้างของท่านั้นเลย
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n; long long k;
    if (scanf("%d %lld", &n, &k) != 2) return 0;
    vector<long long> a(n);
    for (int i = 0; i < n; i++) scanf("%lld", &a[i]);
    vector<long long> all;
    for (int i = 0; i < n; i++)
        for (int j = i + 1; j < n; j++) all.push_back(a[i] + a[j]);
    sort(all.begin(), all.end());
    printf("%lld\\n", all[k - 1]);
    return 0;
}`;
const BS_N = 200000;

---
<CpProblemLayout href={href}>
  <h2>ปัญหาที่บทนี้แก้</h2>
  <p>
    โจทย์ตระกูลนี้ถามอยู่สองแบบ ซึ่งเป็นคำถามกลับด้านกัน
  </p>
  <ul>
    <li><strong>ขอตัวที่ R</strong> เอาของทุกอย่างที่ถูกกติกามาเรียงตามพจนานุกรม แล้วขอตัวที่ <code>R</code></li>
    <li><strong>ขออันดับ</strong> ให้ของมาหนึ่งชิ้น ตอบว่ามันอยู่อันดับที่เท่าไรในลำดับนั้น</li>
  </ul>
  <p>
    ทั้งสองแบบมีกับดักเดียวกันคือ <strong>จำนวนของทั้งหมดโตแบบเลขชี้กำลัง</strong>
    การไล่สร้างทุกตัวแล้วเรียงจึงเป็นไปไม่ได้ทันทีที่ขนาดเกินสามสิบสี่สิบ
  </p>
  <p>
    ท่ามาตรฐานที่แก้ทั้งสองแบบด้วยเครื่องมือชิ้นเดียวคือ <strong>นับก่อน แล้วค่อยเดิน</strong>
    ถ้าเรานับได้ว่า "ของที่ขึ้นต้นด้วยแบบนี้มีกี่ชิ้น" ทั้งสองคำถามจะกลายเป็นเรื่องง่ายทันที
  </p>

  <h2>ขั้นที่ 1 นับ</h2>
  <p>
    สิ่งที่ต้องหาให้ได้คือฟังก์ชัน <code>f(ตำแหน่ง, สถานะ)</code> ที่ตอบว่า
    <strong>ถ้ายืนอยู่ที่ตำแหน่งนี้ด้วยสถานะนี้ จะเติมส่วนที่เหลือได้กี่แบบ</strong>
    ให้คิดถอยหลังจากท้ายมาหน้า เพราะการเติมส่วนที่เหลือไม่ขึ้นกับว่าเราเดินมายังไง ขึ้นกับสถานะปัจจุบันอย่างเดียว
  </p>
  <p>
    งานที่ยากจริงของขั้นนี้ไม่ใช่การเขียนดีพี แต่คือการหาว่า<strong>อะไรคือสถานะที่เล็กที่สุดที่ยังพอ</strong>
    หลักที่ใช้ได้เสมอคือ เขียนเวอร์ชันที่จำทุกอย่างก่อนให้ถูก แล้วค่อยถามว่าข้อมูลชิ้นไหนไม่เคยถูกใช้จริง
  </p>

  <h2>ขั้นที่ 2 เดิน</h2>
  <p>
    เมื่อ <code>f</code> พร้อมแล้ว ทั้งสองคำถามใช้โครงเดียวกันเป๊ะ คือยืนที่ตำแหน่งแรกแล้วไล่ตัวเลือก
    ตามลำดับพจนานุกรม
  </p>
  <ul>
    <li>
      <strong>ขอตัวที่ R</strong> ถามทีละตัวเลือกว่า "ถ้าเลือกอันนี้ จะมีของตามมาได้กี่ชิ้น"
      ถ้า <code>R</code> ยังมากกว่าจำนวนนั้น ก็หัก <code>R</code> ลงแล้วข้ามไปตัวเลือกถัดไป ถ้าไม่มากกว่า ก็เลือกอันนี้
    </li>
    <li>
      <strong>ขออันดับ</strong> ถามทีละตัวเลือกที่<strong>เล็กกว่า</strong>ตัวที่โจทย์ให้มา แล้วบวกจำนวนของที่ตามมาได้
      เข้าไปในอันดับ พอครบทุกตำแหน่งก็บวกหนึ่ง เพราะอันดับเริ่มที่หนึ่ง
    </li>
  </ul>
  <div class="callout callout-warn">
    <p class="callout-label">ระวัง</p>
    <p>
      สองบักที่เกิดกับทุกคนอย่างน้อยครั้งหนึ่ง อันแรกคือเทียบผิดข้าง ต้องเป็น <code>R ≤ cnt</code>
      ไม่ใช่ <code>R &lt; cnt</code> ถ้าเขียนผิดคำตอบจะเลื่อนไปหนึ่งช่องเสมอ ซึ่งจับได้ยากเพราะมันยังดูสมเหตุสมผล
    </p>
    <p>
      อันที่สองคือ<strong>ค่าล้น</strong> จำนวนของที่นับได้โตเร็วมาก ถ้าโจทย์บอกว่า <code>R</code> ไม่เกิน
      สองล้านล้านล้าน ก็ต้องบวกแบบมีเพดาน ไม่งั้นตัวเลขจะพลิกเป็นลบแล้วการเทียบทุกครั้งหลังจากนั้นก็มั่วหมด
    </p>
  </div>

  <ZoomableDiagram caption={`การเดินหาสตริงอันดับที่ ${R} ของความยาว ${N} ทีละตำแหน่ง ที่แต่ละขั้นเราถามคำถามเดียวคือ กิ่งที่เริ่มด้วย 0 มีสมาชิกกี่ตัว ถ้าอันดับที่เหลือยังไม่เกินจำนวนนั้น คำตอบอยู่ในกิ่งนั้น จึงเลือก 0 แล้วอันดับไม่เปลี่ยน ถ้าเกิน ก็ข้ามกิ่งนั้นทั้งกิ่ง เลือก 1 แล้วหักขนาดของกิ่งที่ข้ามออกจากอันดับ เดินครบ ${N} ตำแหน่งได้คำตอบ ${target} จากทั้งหมด ${totalCount} ตัว โดยไม่เคยสร้างสตริงตัวไหนขึ้นมาเลย (วาดประกอบโดยผู้เขียน)`}>
    <svg viewBox={ctwVB} xmlns="http://www.w3.org/2000/svg" role="img" aria-label={`บันได ${N} ขั้น ขั้นที่ i คือการตัดสินใจตำแหน่งที่ i โดยมีอันดับที่เหลือกำกับไว้ ${walkRows.map((w, i) => `ขั้นที่ ${i + 1} อันดับที่เหลือ ${remBefore(i)} กิ่งศูนย์มี ${w.zero} ตัว เลือก ${w.pick}`).join(' ')} สุดท้ายได้สตริง ${target}`}>
      {walkRows.map((w, i) => (
        <>
          {i > 0 && (
            <line
              x1={stepX(i - 1) + BW2 / 2}
              y1={stepY(i - 1) + BH2}
              x2={stepX(i) + BW2 / 2}
              y2={stepY(i)}
              stroke="#4ade80"
              stroke-width="1.8"
            />
          )}
          <rect x={stepX(i)} y={stepY(i)} width={BW2} height={BH2} rx="7" fill="#12291c" stroke="#4ade80" stroke-width="2" />
          <text x={stepX(i) + BW2 / 2} y={stepY(i) + 23} fill="#d7ffe4" font-size="17" text-anchor="middle" font-weight="700" font-family="monospace">
            {w.pick}
          </text>
          <text x={stepX(i) + BW2 + 12} y={stepY(i) + 15} fill="#cdd6ea" font-size="11.5" text-anchor="start" font-family="monospace">
            อันดับเหลือ {remBefore(i)} · กิ่ง 0 มี {w.zero}
          </text>
          <text
            x={stepX(i) + BW2 + 12}
            y={stepY(i) + 30}
            fill={w.pick === '1' ? '#e0b400' : '#7b8397'}
            font-size="11.5"
            text-anchor="start"
            font-family="monospace"
          >
            {w.pick === '1' ? `ข้ามกิ่ง 0 ทั้งกิ่ง หัก ${w.zero} เหลือ ${w.rest}` : 'คำตอบอยู่ในกิ่ง 0 ไม่ต้องหัก'}
          </text>
        </>
      ))}
      <text x={stepX(0)} y={stepY(N - 1) + BH2 + 30} fill="#4ade80" font-size="12.5" text-anchor="start" font-weight="700" font-family="monospace">
        ได้คำตอบ {target}
      </text>
    </svg>
  </ZoomableDiagram>

  <h2>ลองเอง · เดินไปหาสตริงอันดับที่ขอ</h2>
  <div class="cpgame cwgame" data-cwgame data-puzzles={cwJson}>
    <div class="cpg-tabs" role="tablist" aria-label="เลือกชุดโจทย์">
      {cwPuzzles.map((p, k) => (
        <button type="button" class="cpg-tab" role="tab" data-cpg-tab={String(k)} aria-selected={k === 0 ? 'true' : 'false'}>
          {p.label}
        </button>
      ))}
    </div>

    <p class="cpg-tease" data-cpg-tease>{cwPuzzles[0].tease}</p>
    <p class="fg-sub">
      ขอสตริงยาว <b data-cw-n>{cwPuzzles[0].n}</b> หลักที่ไม่มีเลขหนึ่งติดกัน อันดับที่
      <b data-cw-r>{cwPuzzles[0].r}</b> จากทั้งหมด <b data-cw-total>{cwPuzzles[0].total}</b> แบบ
    </p>

    <div class="cpg-scroll"><div class="cw-strip" data-cw-strip></div></div>

