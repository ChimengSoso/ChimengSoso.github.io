  }
  .ks-cell:hover{border-color:var(--dl-emerald);}
  .ks-cell.in{background:#132235;color:#e6edfb;border-color:#3d5a80;}
  .ks-cell.good{background:#14351f;color:#4ade80;border-color:#2f9e5c;}
  .ks-cell.corner{font-weight:700;}
</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type KsPuzzle = {
    id: string;
    label: string;
    tease: string;
    grid: string[];
    rows: number;
    cols: number;
    answer: number;
  };

  function initKillerGame(): void {
    const maybeUi = cpGameUi('[data-ksgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as KsPuzzle[];
    if (puzzles.length === 0) return;

    const boardEl = ui.root.querySelector<HTMLElement>('[data-ks-board]');
    const sizeEl = ui.root.querySelector<HTMLElement>('[data-ks-size]');
    const bestEl = ui.root.querySelector<HTMLElement>('[data-ks-best]');
    const minusEl = ui.root.querySelector<HTMLElement>('[data-ks-minus]');
    const plusEl = ui.root.querySelector<HTMLElement>('[data-ks-plus]');
    if (!boardEl || !sizeEl || !bestEl || !minusEl || !plusEl) return;
    const board: HTMLElement = boardEl;
    const sizeOut: HTMLElement = sizeEl;
    const bestOut: HTMLElement = bestEl;

    let pi = 0;
    let r = 0;
    let c = 0;
    let k = 2;
    let bestFound = 0;

    const pz = (): KsPuzzle => puzzles[pi];

    function isSym(): boolean {
      const g = pz().grid;
      for (let i = 0; i < k; i++)
        for (let j = 0; j < k; j++) if (g[r + i][c + j] !== g[r + k - 1 - i][c + k - 1 - j]) return false;
      return true;
    }

    function clamp(): void {
      const p = pz();
      k = Math.max(2, Math.min(Math.min(p.rows, p.cols), k));
      r = Math.max(0, Math.min(p.rows - k, r));
      c = Math.max(0, Math.min(p.cols - k, c));
    }

    function buildBoard(): void {
      const p = pz();
      board.textContent = '';
      for (let i = 0; i < p.rows; i++) {
        const row = document.createElement('div');
        row.className = 'ks-row';
        for (let j = 0; j < p.cols; j++) {
          const cell = document.createElement('button');
          cell.type = 'button';
          cell.className = 'ks-cell';
          cell.dataset.r = String(i);
          cell.dataset.c = String(j);
          cell.textContent = p.grid[i][j];
          cell.setAttribute('aria-label', `แถว ${i + 1} คอลัมน์ ${j + 1} ค่า ${p.grid[i][j]}`);
          row.appendChild(cell);
        }
        board.appendChild(row);
      }
    }

    function render(): void {
      clamp();
      const ok = isSym();
      for (const cell of Array.from(board.querySelectorAll<HTMLElement>('.ks-cell'))) {
        const i = Number(cell.dataset.r);
        const j = Number(cell.dataset.c);
        const inside = i >= r && i < r + k && j >= c && j < c + k;
        cell.classList.toggle('in', inside);
        cell.classList.toggle('good', inside && ok);
        cell.classList.toggle('corner', inside && (i === r || i === r + k - 1) && (j === c || j === c + k - 1));
      }
      sizeOut.textContent = String(k);
      bestOut.textContent = String(bestFound);
    }

    function check(): void {
      const p = pz();
      if (!isSym()) {
        ui.setStatus(`จัตุรัสด้าน ${k} ที่แถว ${r + 1} คอลัมน์ ${c + 1} หมุนแล้วไม่เหมือนเดิม`, 'bad');
        return;
      }
      if (k > bestFound) bestFound = k;
      if (k === p.answer) {
        ui.setStatus(`ใช่ครับ ด้าน ${k} คือจัตุรัสพิฆาตที่ใหญ่ที่สุดของตารางนี้`, 'good');
      } else {
        ui.setStatus(`ด้าน ${k} เป็นจัตุรัสพิฆาตจริง แต่ยังมีอันที่ใหญ่กว่านี้ ลองหาต่อ`, 'good');
      }
      render();
    }

    function sayNone(): void {
      const p = pz();
      if (p.answer === -1) {
        ui.setStatus('ถูกต้องครับ ตารางนี้ไม่มีจัตุรัสพิฆาตแม้แต่ด้าน 2 สักอันเดียว', 'good');
      } else {
        ui.setStatus(`มีครับ ตารางนี้มีจัตุรัสพิฆาตด้าน ${p.answer} อยู่ ลองหาดูอีกที`, 'bad');
      }
    }

    function selectPuzzle(idx: number): void {
      pi = idx;
      r = 0;
      c = 0;
      k = 2;
      bestFound = 0;
      ui.selectTab(idx);
      ui.setTease(pz().tease);
      buildBoard();
      ui.setStatus('คลิกช่องเพื่อวางมุมบนซ้าย แล้วปรับด้านยาวด้วยปุ่มบวกลบ จากนั้นกดตรวจ');
      render();
    }

    board.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const cell = e.target.closest('.ks-cell');
      if (!(cell instanceof HTMLElement)) return;
      r = Number(cell.dataset.r);
      c = Number(cell.dataset.c);
      ui.setStatus('คลิกช่องเพื่อวางมุมบนซ้าย แล้วปรับด้านยาวด้วยปุ่มบวกลบ จากนั้นกดตรวจ');
      render();
    });

    minusEl.addEventListener('click', () => {
      k -= 1;
      render();
    });
    plusEl.addEventListener('click', () => {
      k += 1;
      render();
    });

    ui.onClick('data-ks-check', check);
    ui.onClick('data-ks-none', sayNone);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initKillerGame);
</script>

