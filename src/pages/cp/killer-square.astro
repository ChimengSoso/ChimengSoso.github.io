    width:0;
    min-width:100%;
    font-size:0.78rem;
    color:var(--dl-muted);
    line-height:1.6;
    padding:0.6rem 0.85rem 0.75rem;
    border-top:1px solid var(--dl-border);
  }
  table.rec{
    width:100%;
    border-collapse:separate;
    border-spacing:0;
    font-size:0.84rem;
  }
  figure.tbl table.rec{width:auto;}
  table.rec caption{
    caption-side:top;
    text-align:left;
    font-family:"Fira Code","Fira Mono",monospace;
    font-weight:700;
    letter-spacing:0.18em;
