const LIMIT = 300;

/** จำนวนจัตุรัสที่ต้องพิจารณาทั้งหมดในตาราง R x C (ด้านยาวตั้งแต่ 2) */
function candidateCount(R: number, C: number): number {
  let n = 0;
  for (let k = 2; k <= Math.min(R, C); k++) n += (R - k + 1) * (C - k + 1);
  return n;
}
/** จำนวนครั้งที่ต้องเทียบช่องต่อช่อง ถ้าตรวจทุกจัตุรัสแบบซื่อ ๆ */
function naiveCellChecks(R: number, C: number): number {
  let n = 0;
  for (let k = 2; k <= Math.min(R, C); k++) n += (R - k + 1) * (C - k + 1) * k * k;
  return n;
}

