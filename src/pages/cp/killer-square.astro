---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { mc, texCode } from '../../lib/math';

const href = 'killer-square/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ไม่มีเลขไหนพิมพ์ด้วยมือ ---------- */

type Grid = string[];

/** จัตุรัสมุมบนซ้าย (r, c) ด้านยาว k หมุน 180 องศาแล้วเหมือนเดิมไหม (ตรวจแบบซื่อ ๆ) */
function isSym(g: Grid, r: number, c: number, k: number): boolean {
  for (let i = 0; i < k; i++)
    for (let j = 0; j < k; j++) if (g[r + i][c + j] !== g[r + k - 1 - i][c + k - 1 - j]) return false;
  return true;
}

type Sq = { r: number; c: number; k: number };

/** จัตุรัสพิฆาตทุกอันในตาราง (ด้านยาวตั้งแต่ 2 ขึ้นไป) เรียงจากใหญ่ไปเล็ก */
function allSquares(g: Grid): Sq[] {
  const R = g.length;
  const C = g[0].length;
  const out: Sq[] = [];
  for (let k = 2; k <= Math.min(R, C); k++)
    for (let r = 0; r + k <= R; r++) for (let c = 0; c + k <= C; c++) if (isSym(g, r, c, k)) out.push({ r, c, k });
  return out.sort((a, b) => b.k - a.k || a.r - b.r || a.c - b.c);
}

const answerOf = (g: Grid): number => {
  const all = allSquares(g);
  return all.length ? all[0].k : -1;
};

/** จัตุรัสที่ไม่ถูกจัตุรัสอันอื่นในลิสต์ครอบไว้ทั้งตัว เอาไว้โชว์ให้เห็นว่า "มีกี่อัน" โดยไม่ซ้ำซ้อน */
function maximalSquares(g: Grid): Sq[] {
  const all = allSquares(g);
  return all.filter(
    (s) =>
      !all.some(
        (t) => t !== s && t.k > s.k && t.r <= s.r && t.c <= s.c && t.r + t.k >= s.r + s.k && t.c + t.k >= s.c + s.k,
      ),
  );
}

/* ตารางตัวอย่างสามชุดในโจทย์ */
const EX1: Grid = ['101010', '111001', '101001'];
const EX2: Grid = ['10010', '01010', '10101', '01001'];
const EX3: Grid = ['101', '111', '100'];

const ans1 = answerOf(EX1);
const ans2 = answerOf(EX2);
const ans3 = answerOf(EX3);

const ex1Squares = maximalSquares(EX1);
const ex1Sizes = ex1Squares.map((s) => s.k);

/** วาดตารางเป็น "หน้ากาก" ตัวอักษร โดยช่องที่ไม่อยู่ในจัตุรัสที่สนใจกลายเป็นจุด */
function mask(g: Grid, s: Sq): string[] {
  return g.map((row, i) =>
    [...row].map((ch, j) => (i >= s.r && i < s.r + s.k && j >= s.c && j < s.c + s.k ? ch : '.')).join(''),
  );
}

/* ---------- ทำไมไล่ตรง ๆ ไม่รอด ---------- */

const LIMIT = 300;

/** จำนวนจัตุรัสที่ต้องพิจารณาทั้งหมดในตาราง R x C (ด้านยาวตั้งแต่ 2) */
function candidateCount(R: number, C: number): number {
  let n = 0;
  for (let k = 2; k <= Math.min(R, C); k++) n += (R - k + 1) * (C - k + 1);
  return n;
}
/** จำนวนครั้งที่ต้องเทียบช่องต่อช่อง ถ้าตรวจทุกจัตุรัสแบบซื่อ ๆ */
function naiveCellChecks(R: number, C: number): number {
  let n = 0;
  for (let k = 2; k <= Math.min(R, C); k++) n += (R - k + 1) * (C - k + 1) * k * k;
  return n;
}

const CAND = candidateCount(LIMIT, LIMIT);
const NAIVE = naiveCellChecks(LIMIT, LIMIT);

const fmt = (n: number): string => n.toLocaleString('en-US');
/** เขียนเลขใหญ่เป็นภาษาคน เช่น 8.96 ล้าน / 82.4 พันล้าน */
function human(n: number): string {
  if (n >= 1e9) return `${(n / 1e9).toFixed(1)} พันล้าน`;
  if (n >= 1e6) return `${(n / 1e6).toFixed(2)} ล้าน`;
  return fmt(n);
}

/** ตารางเทียบสองแนวคิด คิดหน่วยเดียวกันคือ "จำนวนครั้งที่แตะข้อมูล" */
const costRows = [
  {
    name: 'ตรวจทุกจัตุรัสแบบซื่อ ๆ',
    per: 'k × k ครั้งต่อหนึ่งจัตุรัส',
    total: naiveCellChecks(LIMIT, LIMIT),
  },
  {
    name: 'ปอกทีละวง เทียบขอบด้วยแฮช',
    per: '4 ครั้งต่อหนึ่งจัตุรัส',
    total: candidateCount(LIMIT, LIMIT) * 4,
  },
];

/* ---------- ตัวอย่างการปอกวง เอา 3x3 ของตัวอย่างแรกมาแกะ ---------- */

const PEEL = ex1Squares.find((s) => s.k === 3) as Sq;
const peelRows = [0, 1, 2].map((i) => EX1[PEEL.r + i].slice(PEEL.c, PEEL.c + 3));
const peelTop = peelRows[0];
const peelBottom = peelRows[2];
const peelBottomRev = [...peelBottom].reverse().join('');
const peelLeft = peelRows.map((row) => row[0]).join('');
const peelRight = peelRows.map((row) => row[2]).join('');
const peelRightRev = [...peelRight].reverse().join('');
const peelCore = peelRows[1][1];

/** ป้ายบอกคู่ของช่องในจัตุรัสด้าน 3 ช่องที่ป้ายเดียวกันคือช่องที่หมุนแล้วไปทับกัน */
const PAIR_TAG = ['A', 'B', 'C', 'D', '.', 'D', 'C', 'B', 'A'];
const pairTag = (i: number, j: number): string => PAIR_TAG[i * 3 + j];

/* ---------- สูตร ---------- */

const texSym = texCode(
  `${mc.fn('a')}[r ${mc.op('+')} i][c ${mc.op('+')} j] ${mc.op('=')} ${mc.fn('a')}[r ${mc.op('+')} k ${mc.op('-')} ${mc.num('1')} ${mc.op('-')} i][c ${mc.op('+')} k ${mc.op('-')} ${mc.num('1')} ${mc.op('-')} j]`,
);
const texPeel = texCode(
  `${mc.fn('ok')}(r, c, k) ${mc.op('=')} ${mc.fn('ok')}(r ${mc.op('+')} ${mc.num('1')}, c ${mc.op('+')} ${mc.num('1')}, k ${mc.op('-')} ${mc.num('2')}) \\;${mc.op('\\wedge')}\\; ${mc.fn('rowFit')}(r, c, k) \\;${mc.op('\\wedge')}\\; ${mc.fn('colFit')}(r, c, k)`,
);

/* ---------- โค้ด ---------- */

const solution = `#include <bits/stdc++.h>
using namespace std;
typedef unsigned long long ull;

// แฮชโมดูโล 2^61 - 1 คูณกันแล้วพับด้วยบิต ไม่ต้องหารเลย
const ull MOD = (1ULL << 61) - 1;
static inline ull add(ull a, ull b) { a += b; if (a >= MOD) a -= MOD; return a; }
static inline ull sub(ull a, ull b) { return add(a, MOD - b); }
static inline ull mul(ull a, ull b) {
    __uint128_t c = (__uint128_t)a * b;
    return add((ull)(c & MOD), (ull)(c >> 61));
}

int R, C;
ull B;
vector<ull> pw;
vector<vector<ull>> hRow, hRowRev, hCol, hColRev;

// แฮชนำหน้าของทุกบรรทัดในชุดที่ให้มา
static void build(vector<vector<ull>>& h, const vector<string>& s) {
    int n = s.size(), m = s[0].size();
    h.assign(n, vector<ull>(m + 1, 0));
    for (int i = 0; i < n; i++)
        for (int j = 0; j < m; j++)
            h[i][j + 1] = add(mul(h[i][j], B), (ull)(s[i][j] - '0' + 1));
}
static inline ull cut(const vector<vector<ull>>& h, int i, int l, int len) {
    return sub(h[i][l + len], mul(h[i][l], pw[len]));
}

int main() {
    scanf("%d %d", &R, &C);
    vector<string> row(R);
    for (int i = 0; i < R; i++) { char buf[512]; scanf("%s", buf); row[i] = buf; }

    mt19937_64 rng(chrono::steady_clock::now().time_since_epoch().count());
    B = rng() % (MOD - 300) + 256;                  // ฐานสุ่ม กันคนแต่งอินพุตมาชนแฮช
    pw.assign(max(R, C) + 1, 1);
    for (size_t i = 1; i < pw.size(); i++) pw[i] = mul(pw[i - 1], B);

    // เตรียมสี่ชุด: แถวปกติ แถวกลับด้าน คอลัมน์ปกติ คอลัมน์กลับด้าน
    vector<string> rowRev(R), col(C, string(R, '0')), colRev(C);
    for (int i = 0; i < R; i++) { rowRev[i] = row[i]; reverse(rowRev[i].begin(), rowRev[i].end()); }
    for (int j = 0; j < C; j++) {
        for (int i = 0; i < R; i++) col[j][i] = row[i][j];
        colRev[j] = col[j];
        reverse(colRev[j].begin(), colRev[j].end());
    }
    build(hRow, row); build(hRowRev, rowRev); build(hCol, col); build(hColRev, colRev);

    // ขอบบนช่วง [c, c+k-1] ต้องเท่ากับขอบล่างช่วงเดียวกัน "อ่านกลับด้าน"
    // ช่วงกลับด้านของ [c, c+k-1] ในสตริงที่กลับแล้ว คือ [C-c-k, C-c-1]
    auto rowFit = [&](int u, int v, int c, int k) {
        return cut(hRow, u, c, k) == cut(hRowRev, v, C - c - k, k);
    };
    auto colFit = [&](int a, int b, int r, int k) {
        return cut(hCol, a, r, k) == cut(hColRev, b, R - r - k, k);
    };

    int K = min(R, C);
    // สองชั้นที่ต้องเก็บคือ k-1 กับ k-2 เท่านั้น จัตุรัสด้าน 0 กับ 1 สมมาตรเสมอ
    vector<vector<char>> two(R, vector<char>(C, 1));
    vector<vector<char>> one(R, vector<char>(C, 1));
    int ans = -1;
    for (int k = 2; k <= K; k++) {
        vector<vector<char>> cur(R, vector<char>(C, 0));
        for (int r = 0; r + k <= R; r++)
            for (int c = 0; c + k <= C; c++) {
                if (!two[r + 1][c + 1]) continue;             // ไส้ในด้าน k-2 ต้องผ่านก่อน
                if (!rowFit(r, r + k - 1, c, k)) continue;    // ขอบบนคู่ขอบล่าง
                if (!colFit(c, c + k - 1, r, k)) continue;    // ขอบซ้ายคู่ขอบขวา
                cur[r][c] = 1;
                ans = k;
            }
        two = one;
        one = cur;
    }
    printf("%d\\n", ans);
    return 0;
}`;

const bruteCode = `// ตัวตรวจสอบแบบซื่อ ๆ ไล่ทุกจัตุรัสแล้วเทียบช่องต่อช่อง ใช้ได้แค่ตารางเล็ก ๆ
// เอาไว้สุ่มเทียบกับโค้ดจริงก่อนส่ง ไม่ใช่โค้ดที่ส่งเข้าระบบตัดสิน
#include <bits/stdc++.h>
using namespace std;

int main() {
    int R, C;
    scanf("%d %d", &R, &C);
    vector<string> g(R);
    for (auto& s : g) { char b[512]; scanf("%s", b); s = b; }

    int ans = -1;
    for (int k = 2; k <= min(R, C); k++)
        for (int r = 0; r + k <= R; r++)
            for (int c = 0; c + k <= C; c++) {
                bool ok = true;
                for (int i = 0; i < k && ok; i++)
                    for (int j = 0; j < k && ok; j++)
                        if (g[r + i][c + j] != g[r + k - 1 - i][c + k - 1 - j]) ok = false;
                if (ok) ans = max(ans, k);
            }
    printf("%d\\n", ans);
}`;

const peelSnippet = `if (!two[r + 1][c + 1]) continue;             // ไส้ในด้าน k-2 ต้องผ่านก่อน
if (!rowFit(r, r + k - 1, c, k)) continue;    // ขอบบนคู่ขอบล่าง
if (!colFit(c, c + k - 1, r, k)) continue;    // ขอบซ้ายคู่ขอบขวา
cur[r][c] = 1;`;
