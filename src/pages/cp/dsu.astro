---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const href = 'dsu/';

/* ================================================================
 * โมเดล DSU ตัวเดียวที่ภาพ เกม ตัวเดิน และตัวเลขในย่อหน้าทุกตัวใช้ร่วมกัน
 * par[1..n] ช่อง 0 ไม่ใช้ กติกาการรวมตรงกับแม่แบบ C++ บนหน้านี้ทุกประการ
 * ================================================================ */
type Par = number[];
const fresh = (n: number): Par => Array.from({ length: n + 1 }, (_, i) => i);
const rootOf = (par: Par, x: number): number => {
  let r = x;
  while (par[r] !== r) r = par[r];
  return r;
};
const depthOf = (par: Par, x: number): number => {
  let d = 0;
  for (let r = x; par[r] !== r; r = par[r]) d++;
  return d;
};
const heightOf = (par: Par): number => {
  let h = 0;
  for (let x = 1; x < par.length; x++) h = Math.max(h, depthOf(par, x));
  return h;
};
const groupsOf = (par: Par): number[][] => {
  const by = new Map<number, number[]>();
  for (let x = 1; x < par.length; x++) {
    const r = rootOf(par, x);
    by.set(r, [...(by.get(r) ?? []), x]);
  }
  return [...by.values()];
};

/** กฎของแม่แบบ: a กับ b คือหัวก๊วน ถ้าก๊วน a เล็กกว่าให้สลับ แล้วให้ b ไปขึ้นกับ a */
function uniteBySize(par: Par, sz: number[], x: number, y: number): boolean {
  let a = rootOf(par, x);
  let b = rootOf(par, y);
  if (a === b) return false;
  if (sz[a] < sz[b]) [a, b] = [b, a];
  par[b] = a;
  sz[a] += sz[b];
  return true;
}
/** กฎแบบซื่อ: หัวก๊วนของตัวแรกไปขึ้นกับหัวก๊วนของตัวหลังเสมอ */
function uniteNaive(par: Par, x: number, y: number): void {
  const a = rootOf(par, x);
  const b = rootOf(par, y);
  if (a !== b) par[a] = b;
}

/* ---------- ตัวจัดวางต้นไม้สำหรับวาดภาพ ---------- */
type Tone = 'base' | 'hot' | 'root' | 'dim' | 'new';
type DNode = { k: number; x: number; y: number; tone: Tone };
type DEdge = { x1: number; y1: number; x2: number; y2: number; tone: Tone };
type Drawing = { nodes: DNode[]; edges: DEdge[]; left: number; right: number; bottom: number };
const R = 15;

/** วางป่าของคนใน nodes: ใบเรียงซ้ายไปขวา แม่อยู่กึ่งกลางของลูก รากทุกต้นอยู่แถวเดียวกัน
 *  แล้วเลื่อนทั้งภาพให้กึ่งกลางอยู่ที่ cx */
function drawForest(
  par: Par,
  nodes: number[],
  cx: number,
  y0: number,
  opt: { gap?: number; row?: number; hot?: number[]; newEdges?: number[] } = {},
): Drawing {
  const gap = opt.gap ?? 46;
  const row = opt.row ?? 58;
  const hot = new Set(opt.hot ?? []);
  const newE = new Set(opt.newEdges ?? []);
  const inSet = new Set(nodes);
  const kids = new Map<number, number[]>();
  for (const v of nodes) if (par[v] !== v) kids.set(par[v], [...(kids.get(par[v]) ?? []), v]);
  const pos = new Map<number, { x: number; y: number }>();
  let cursor = 0;
  const place = (v: number, d: number): number => {
    const ch = (kids.get(v) ?? []).filter((c) => inSet.has(c)).sort((p, q) => p - q);
    let x: number;
    if (ch.length === 0) {
      x = cursor;
      cursor += gap;
    } else {
      const xs = ch.map((c) => place(c, d + 1));
      x = (xs[0] + xs[xs.length - 1]) / 2;
    }
    pos.set(v, { x, y: y0 + d * row });
    return x;
  };
  const roots = nodes.filter((v) => par[v] === v).sort((p, q) => p - q);
  roots.forEach((r, t) => {
    if (t > 0) cursor += gap * 0.5;
    place(r, 0);
  });
  const xsAll = [...pos.values()].map((p) => p.x);
  const shift = cx - (Math.min(...xsAll) + Math.max(...xsAll)) / 2;
  const out: DNode[] = [];
  const edges: DEdge[] = [];
  for (const v of nodes) {
    const p = pos.get(v);
    if (!p) continue;
    const tone: Tone = hot.has(v) ? 'hot' : par[v] === v ? 'root' : 'base';
    out.push({ k: v, x: p.x + shift, y: p.y, tone });
    if (par[v] !== v) {
      const q = pos.get(par[v]);
      if (!q) continue;
      const dx = q.x - p.x;
      const dy = q.y - p.y;
      const len = Math.hypot(dx, dy);
      const ux = dx / len;
      const uy = dy / len;
      edges.push({
        x1: p.x + shift + ux * R,
        y1: p.y + uy * R,
        x2: q.x + shift - ux * (R + 1),
        y2: q.y - uy * (R + 1),
        tone: newE.has(v) ? 'new' : hot.has(v) && hot.has(par[v]) ? 'hot' : 'base',
      });
    }
  }
  const ys = out.map((n) => n.y);
  return {
    nodes: out,
    edges,
    left: Math.min(...out.map((n) => n.x)) - R,
    right: Math.max(...out.map((n) => n.x)) + R,
    bottom: Math.max(...ys) + R,
  };
}
const stroke = (t: Tone): string =>
  t === 'hot' ? '#e0b400' : t === 'root' ? '#4ade80' : t === 'new' ? '#4ade80' : t === 'dim' ? '#2a3350' : '#4a5a7d';
const ink = (t: Tone): string =>
  t === 'hot' ? '#ffe9a8' : t === 'root' ? '#4ade80' : t === 'dim' ? '#7b8397' : '#cdd6ea';
const range = (a: number, b: number): number[] => Array.from({ length: b - a + 1 }, (_, i) => a + i);

/* ---------- ภาพที่ 1: แถวเดียวของ par กับป่าที่มันแทน ---------- */
const PAR_A: Par = [0, 1, 1, 2, 1, 5, 5, 6, 8, 8, 8];
const NA = PAR_A.length - 1;
const A_CELL = 54;
const A_X0 = 120;
const aCellX = (i: number): number => A_X0 + (i - 1) * A_CELL;
const aTableRight = aCellX(NA) + A_CELL;
const aForest = drawForest(PAR_A, range(1, NA), (A_X0 + aTableRight) / 2, 150, { gap: 58 });
const aGroups = groupsOf(PAR_A);
const aVB = `0 0 ${Math.ceil(Math.max(aTableRight, aForest.right) + 12)} ${Math.ceil(aForest.bottom + 34)}`;

/* ---------- ภาพที่ 2: ลำดับรวมแบบเดียวกัน สองกติกา ---------- */
const NB = 8;
const naiveB = fresh(NB);
const sizeB = fresh(NB);
const sizeBsz = Array<number>(NB + 1).fill(1);
for (let k = 2; k <= NB; k++) {
  uniteNaive(naiveB, 1, k);
  uniteBySize(sizeB, sizeBsz, 1, k);
}
const chainH = heightOf(naiveB);
const starH = heightOf(sizeB);
const bChain = drawForest(naiveB, range(1, NB), 150, 64, { row: 44 });
const bStar = drawForest(sizeB, range(1, NB), 500, 64, { gap: 46 });
const bVB = `0 0 ${Math.ceil(bStar.right + 12)} ${Math.ceil(Math.max(bChain.bottom, bStar.bottom) + 34)}`;

/* ---------- ข้ออ้างเรื่องความลึก ตรวจตอนบิลด์ ---------- */
/** จับคู่ก๊วนขนาดเท่ากันเป็นชั้น ๆ คือลำดับที่ทำให้รวมตามขนาดลึกที่สุด */
function pairingHeight(n: number): number {
  const par = fresh(n);
  const sz = Array<number>(n + 1).fill(1);
  for (let step = 1; step < n; step *= 2)
    for (let i = 1; i + step <= n; i += 2 * step) uniteBySize(par, sz, i, i + step);
  return heightOf(par);
}
const DEPTH_N = 1024;
const DEPTH_LOG = Math.log2(DEPTH_N);
const pairH = pairingHeight(DEPTH_N);
/* Park-Miller: ผลคูณไม่เกิน 2^47 เลขทศนิยมของ JS จึงแม่นทุกหลัก
   (ตัวคูณ 1103515245 เคยถูกใช้ตรงนี้ ผลคูณเกิน 2^53 บิตล่างกลายเป็นศูนย์ ลูปข้างล่างเลยไม่จบ) */
let seed = 20260910;
const rnd = (m: number): number => {
  seed = (seed * 48271) % 2147483647;
  return seed % m;
};
const RAND_RUNS = 200;
let randMax = 0;
for (let run = 0; run < RAND_RUNS; run++) {
  const par = fresh(DEPTH_N);
  const sz = Array<number>(DEPTH_N + 1).fill(1);
  let left = DEPTH_N - 1;
  while (left > 0) if (uniteBySize(par, sz, rnd(DEPTH_N) + 1, rnd(DEPTH_N) + 1)) left--;
  randMax = Math.max(randMax, heightOf(par));
}
if (pairH !== DEPTH_LOG || randMax > DEPTH_LOG)
  throw new Error(`dsu: ข้ออ้างความลึกไม่จริง pairH=${pairH} randMax=${randMax}`);

/* ---------- ภาพที่ 3 + ตัวเดิน: find(7) พร้อมบีบทางเดิน ---------- */
const PAR_F: Par = [0, 1, 1, 2, 2, 3, 3, 5, 1];
const NF = PAR_F.length - 1;
const F_START = 7;
const fPath: number[] = [];
for (let v = F_START; ; v = PAR_F[v]) {
  fPath.push(v);
  if (PAR_F[v] === v) break;
}
const fRoot = fPath[fPath.length - 1];
const afterF = [...PAR_F];
for (const v of fPath) afterF[v] = fRoot;
const fBefore = drawForest(PAR_F, range(1, NF), 175, 64, { hot: fPath });
const fAfter = drawForest(afterF, range(1, NF), 530, 64, {
  hot: fPath,
  newEdges: fPath.filter((v) => PAR_F[v] !== fRoot && v !== fRoot),
});
const fVB = `0 0 ${Math.ceil(fAfter.right + 12)} ${Math.ceil(Math.max(fBefore.bottom, fAfter.bottom) + 34)}`;
const fChanged = fPath.filter((v) => v !== fRoot && PAR_F[v] !== fRoot);

type FStep = { note: string; par: number[]; depth: number[]; cur: number; path: number[]; changed: number };
const depthRow = (par: Par): number[] => range(1, NF).map((v) => depthOf(par, v));
const fSteps: FStep[] = [];
{
  const par = [...PAR_F];
  fSteps.push({
    note: `เริ่มที่ <b>find(${F_START})</b> ตอนนี้ ${F_START} อยู่ลึก ${depthOf(par, F_START)} ชั้น ต้องถามต่อกันขึ้นไปจนเจอคนที่ไม่มีหัวหน้า`,
    par: [...par],
    depth: depthRow(par),
    cur: 0,
    path: [],
    changed: 0,
  });
  const seen: number[] = [];
  for (const v of fPath) {
    seen.push(v);
    const isRoot = par[v] === v;
    fSteps.push({
      note: isRoot
        ? `ถึง <b>${v}</b> แล้ว <code>par[${v}] = ${v}</code> คือชี้หาตัวเอง แปลว่า ${v} คือหัวก๊วน คำตอบของ find(${F_START}) คือ ${v}`
        : `อยู่ที่ <b>${v}</b> อ่าน <code>par[${v}] = ${par[v]}</code> ยังไม่ใช่ตัวเอง จึงเรียก find(${par[v]}) ต่อ แล้วรอคำตอบ`,
      par: [...par],
      depth: depthRow(par),
      cur: v,
      path: [...seen],
      changed: 0,
    });
  }
  /* ตอนตอบกลับ ลำดับการเขียนทับคือจากใกล้หัวไปหาจุดเริ่ม ตรงกับ par[x] = find(par[x]) ที่เรียกตัวเอง */
  for (const v of [...fPath].reverse().slice(1)) {
    const was = par[v];
    par[v] = fRoot;
    fSteps.push({
      note:
        was === fRoot
          ? `คำตอบ ${fRoot} ส่งกลับมาถึง <b>${v}</b> ซึ่งชี้ ${fRoot} อยู่แล้ว เขียนทับด้วยค่าเดิม ไม่มีอะไรเปลี่ยน`
          : `คำตอบ ${fRoot} ส่งกลับมาถึง <b>${v}</b> จึงเขียนทับ <code>par[${v}]</code> จาก ${was} เป็น ${fRoot} ตอนนี้ ${v} ลึกแค่ 1 ชั้น`,
      par: [...par],
      depth: depthRow(par),
      cur: v,
      path: fPath,
      changed: was === fRoot ? 0 : v,
    });
  }
  fSteps.push({
    note: `จบแล้ว ทุกคนบนทางชี้ตรงไปที่ ${fRoot} ครั้งหน้าถ้าถาม find(${F_START}) อีก จะเดินแค่ก้าวเดียว ส่วนคนที่ไม่ได้อยู่บนทาง (4, 6, 8) ไม่ถูกแตะเลย`,
    par: [...par],
    depth: depthRow(par),
    cur: 0,
    path: fPath,
    changed: 0,
  });
}

/* ---------- มินิเกม: เลือกว่าหัวไหนไปขึ้นกับหัวไหน ---------- */
type DgPuzzle = { id: string; label: string; tease: string; n: number; ops: [number, number][]; best: number };
/** ค่าที่ดีที่สุดคิดด้วยการลองทุกทางเลือก ไม่ได้ใช้กฎรวมตามขนาดที่บทสอน */
function bestHeight(n: number, ops: [number, number][]): number {
  let best = Infinity;
  const go = (i: number, par: Par): void => {
    if (i === ops.length) {
      best = Math.min(best, heightOf(par));
      return;
    }
    const a = rootOf(par, ops[i][0]);
    const b = rootOf(par, ops[i][1]);
    if (a === b) throw new Error('dsu game: คำสั่งรวมคนที่อยู่ก๊วนเดียวกันอยู่แล้ว');
    const p1 = [...par];
    p1[a] = b;
    go(i + 1, p1);
    const p2 = [...par];
    p2[b] = a;
    go(i + 1, p2);
  };
  go(0, fresh(n));
  return best;
}
const heightBySize = (n: number, ops: [number, number][]): number => {
  const par = fresh(n);
  const sz = Array<number>(n + 1).fill(1);
  for (const [a, b] of ops) uniteBySize(par, sz, a, b);
  return heightOf(par);
};
const heightNaive = (n: number, ops: [number, number][]): number => {
  const par = fresh(n);
  for (const [a, b] of ops) uniteNaive(par, a, b);
  return heightOf(par);
};
const dgRaw: Omit<DgPuzzle, 'best'>[] = [
  {
    id: 'a',
    label: 'ชุด ก',
    tease: 'คนที่ 1 ชวนเพื่อนเข้าก๊วนทีละคน ห้าครั้งติดกัน',
    n: 6,
    ops: [[1, 2], [1, 3], [1, 4], [1, 5], [1, 6]],
  },
  {
    id: 'b',
    label: 'ชุด ข',
    tease: 'จับคู่กันก่อน แล้วคู่ต่อคู่ แล้วสี่ต่อสี่',
    n: 8,
    ops: [[1, 2], [3, 4], [5, 6], [7, 8], [1, 3], [5, 7], [1, 5]],
  },
  {
    id: 'c',
    label: 'ชุด ค',
    tease: 'ก๊วนใหญ่สี่คนเจอก๊วนเล็ก แล้วมีคนมาต่อท้ายอีก',
    n: 8,
    ops: [[4, 5], [4, 6], [4, 7], [2, 3], [3, 6], [8, 2], [1, 8]],
  },
];
const dgPuzzles: DgPuzzle[] = dgRaw.map((p) => ({ ...p, best: bestHeight(p.n, p.ops) }));
for (const p of dgPuzzles)
  if (heightBySize(p.n, p.ops) !== p.best) throw new Error(`dsu game ${p.id}: รวมตามขนาดไม่ได้ค่าต่ำสุด`);
const dgJson = JSON.stringify(dgPuzzles);
const dgNaiveA = heightNaive(dgPuzzles[0].n, dgPuzzles[0].ops);
const dgBestB = dgPuzzles[1].best;

/* ---------- ตัวเลขเวลาที่วัดจริง ----------
   g++ 14.2 (MinGW) -O2 บนเครื่องเดียวกัน อินพุตรูปเดียวกันทุกแถว: unite(1, i) ทุก i แล้ว find อีก n ครั้ง
   ค่าที่แสดงคือเร็วสุดของสามรอบ */
const bench = [
  { n: 20000, naive: '0.49 วินาที', size: 'ไม่ถึง 1 ms', comp: 'ไม่ถึง 1 ms', both: 'ไม่ถึง 1 ms' },
  { n: 50000, naive: '3.07 วินาที', size: 'ไม่ถึง 1 ms', comp: 'ไม่ถึง 1 ms', both: 'ไม่ถึง 1 ms' },
  { n: 200000, naive: 'ไม่ได้รอ', size: '1 ms', comp: '1 ms', both: '1 ms' },
];

/* ---------- โค้ด ---------- */
const codeNaive = `// แบบซื่อ ๆ: ถูกต้อง แต่ต้นไม้อาจกลายเป็นโซ่ยาว n ชั้น
int par[100005];

void init(int n) {
    for (int i = 1; i <= n; i++) par[i] = i;   // ตอนเริ่ม ทุกคนเป็นหัวก๊วนของตัวเอง
}

int find(int x) {
    while (par[x] != x) x = par[x];            // ถามต่อขึ้นไปจนเจอคนที่ไม่มีหัวหน้า
    return x;
}

void unite(int a, int b) {
    par[find(a)] = find(b);                    // หัวก๊วนของ a ไปขึ้นกับหัวก๊วนของ b
}`;
const codeTemplate = `// แม่แบบ DSU: รวมตามขนาด + บีบทางเดิน ลอกไปใช้ได้ทุกข้อ
#include <bits/stdc++.h>
using namespace std;

const int MAXN = 200005;
int par[MAXN], sz[MAXN];

void init(int n) {
    for (int i = 1; i <= n; i++) par[i] = i, sz[i] = 1;
}

int find(int x) {
    // เรียกตัวเองได้อย่างปลอดภัย เพราะรวมตามขนาดทำให้ลึกไม่เกิน log2 n ชั้น
    return par[x] == x ? x : par[x] = find(par[x]);
}

bool unite(int a, int b) {
    a = find(a), b = find(b);
    if (a == b) return false;            // อยู่ก๊วนเดียวกันอยู่แล้ว
    if (sz[a] < sz[b]) swap(a, b);       // ให้ a เป็นก๊วนที่ใหญ่กว่าเสมอ
    par[b] = a;                          // ก๊วนเล็กไปขึ้นกับก๊วนใหญ่
    sz[a] += sz[b];
    return true;
}

int main() {
    int n, q;
    scanf("%d %d", &n, &q);
    init(n);
    while (q--) {
        char op; int a, b;
        scanf(" %c %d %d", &op, &a, &b);
        if (op == '+') unite(a, b);
        else puts(find(a) == find(b) ? "YES" : "NO");
    }
    return 0;
}`;

/* ================= ฝึกข้อ 1 · Road Construction ================= */
const P1_IN = [[5, 3], [1, 2], [1, 3], [4, 5]];
const p1Days: { a: number; b: number; comps: number; best: number; par: Par }[] = [];
{
  const n = P1_IN[0][0];
  const par = fresh(n);
  const sz = Array<number>(n + 1).fill(1);
  let comps = n;
  let best = 1;
  for (const [a, b] of P1_IN.slice(1)) {
    if (uniteBySize(par, sz, a, b)) {
      comps--;
      best = Math.max(best, sz[rootOf(par, a)]);
    }
    p1Days.push({ a, b, comps, best, par: [...par] });
  }
}
const P1_OUT = p1Days.map((d) => `${d.comps} ${d.best}`);
const P1_OUT_STATEMENT = ['4 2', '3 3', '2 3'];
if (P1_OUT.join('|') !== P1_OUT_STATEMENT.join('|')) throw new Error('dsu p1: โมเดลไม่ตรงกับตัวอย่างของโจทย์');
