    <p class="fg-sub" data-dg-ask>รอเริ่ม</p>
    <div class="dg-choices" data-dg-choices></div>
    <div class="cpg-scroll"><div class="dg-forest" data-dg-forest></div></div>
    <div class="cpg-controls">
