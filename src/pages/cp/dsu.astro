    <svg viewBox={p3VB} xmlns="http://www.w3.org/2000/svg" width="100%" role="img" aria-label="กราฟตัวอย่างของ Road Reparation กับถนนที่ถูกซ่อม">
      {p3Edges.map((e) => (
