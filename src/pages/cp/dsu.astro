<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type DgPuzzle = { id: string; label: string; tease: string; n: number; ops: [number, number][]; best: number };

  function isDgPuzzle(x: unknown): x is DgPuzzle {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return typeof o.n === 'number' && typeof o.best === 'number' && typeof o.tease === 'string' && Array.isArray(o.ops);
  }

  function initDgGame(): void {
    const maybeUi = cpGameUi('[data-dggame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่ เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root).filter(isDgPuzzle);
    if (puzzles.length === 0) return;
    const forestEl = ui.root.querySelector<HTMLElement>('[data-dg-forest]');
    const choicesEl = ui.root.querySelector<HTMLElement>('[data-dg-choices]');
    const askEl = ui.root.querySelector<HTMLElement>('[data-dg-ask]');
    if (!forestEl || !choicesEl || !askEl) return;
    const forest: HTMLElement = forestEl;
    const choices: HTMLElement = choicesEl;
    const ask: HTMLElement = askEl;

    let pi = 0;
    let at = 0;
    let par: number[] = [];

    const pz = (): DgPuzzle => puzzles[pi];
    const root = (x: number): number => {
      let r = x;
      while (par[r] !== r) r = par[r];
      return r;
    };
    const depth = (x: number): number => {
      let d = 0;
      for (let r = x; par[r] !== r; r = par[r]) d++;
      return d;
    };
    const members = (r: number): number[] => {
      const out: number[] = [];
      for (let x = 1; x <= pz().n; x++) if (root(x) === r) out.push(x);
      return out;
    };
    const heightOfGroup = (r: number): number => Math.max(...members(r).map(depth));
    const heightAll = (): number => {
      let h = 0;
      for (let x = 1; x <= pz().n; x++) h = Math.max(h, depth(x));
      return h;
    };

    function nodeEl(v: number, live: Set<number>): HTMLElement {
      const box = document.createElement('div');
      box.className = 'dg-n';
      const k = document.createElement('span');
      k.className = 'dg-k' + (par[v] === v ? ' root' : '') + (live.has(v) ? ' live' : '');
      k.textContent = String(v);
      box.appendChild(k);
      const kids: number[] = [];
      for (let x = 1; x <= pz().n; x++) if (x !== v && par[x] === v) kids.push(x);
      if (kids.length > 0) {
        const row = document.createElement('div');
        row.className = 'dg-c';
        for (const c of kids) row.appendChild(nodeEl(c, live));
        box.appendChild(row);
      }
      return box;
    }

    function render(): void {
      const p = pz();
      const live = new Set<number>();
      if (at < p.ops.length) {
        live.add(root(p.ops[at][0]));
        live.add(root(p.ops[at][1]));
      }
      forest.textContent = '';
      for (let r = 1; r <= p.n; r++) {
        if (par[r] !== r) continue;
        const tree = document.createElement('div');
        tree.className = 'dg-tree';
        tree.appendChild(nodeEl(r, live));
        const h = document.createElement('span');
        h.className = 'dg-h';
        h.textContent = `ลึก ${heightOfGroup(r)}`;
        tree.appendChild(h);
        forest.appendChild(tree);
      }
      choices.textContent = '';
      if (at < p.ops.length) {
        const [x, y] = p.ops[at];
        const a = root(x);
        const b = root(y);
        ask.textContent = `คำสั่งที่ ${at + 1} จาก ${p.ops.length}: รวมก๊วนของ ${x} กับ ${y} หัวของสองก๊วนคือ ${a} (${members(a).length} คน) กับ ${b} (${members(b).length} คน)`;
        for (const [child, parent] of [[a, b], [b, a]]) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'cpg-btn';
          btn.dataset.child = String(child);
          btn.dataset.parent = String(parent);
          btn.textContent = `หัว ${child} ไปขึ้นกับหัว ${parent}`;
          choices.appendChild(btn);
        }
      } else {
        ask.textContent = `รวมครบ ${p.ops.length} คำสั่งแล้ว`;
      }
      ui.setScore(at === 0 ? 'ยังไม่ได้รวมเลย' : `รวมไปแล้ว ${at} ครั้ง ตอนนี้คนที่ลึกที่สุดลึก ${heightAll()} ชั้น`);
    }

    function finish(): void {
      const p = pz();
      const h = heightAll();
      if (h === p.best) ui.setStatus(`ได้ความลึก ${h} ซึ่งเป็นค่าต่ำที่สุดที่ชุดนี้ทำได้แล้ว`, 'good');
      else ui.setStatus(`ได้ความลึก ${h} แต่ชุดนี้ทำได้ต่ำสุด ${p.best} ลองดูว่าครั้งไหนที่ก๊วนใหญ่ถูกยกไปขึ้นกับก๊วนเล็ก`, 'bad');
    }

    function selectPuzzle(t: number): void {
      pi = t;
      at = 0;
      par = Array.from({ length: pz().n + 1 }, (_, i) => i);
      ui.selectTab(t);
      ui.setTease(pz().tease);
      ui.setStatus('เลือกว่าหัวไหนจะไปขึ้นกับหัวไหน');
      render();
    }

    choices.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest('button');
      if (!(btn instanceof HTMLButtonElement)) return;
      const child = Number(btn.dataset.child);
      const parent = Number(btn.dataset.parent);
      par[child] = parent;
      at++;
      ui.setStatus(`หัว ${child} ไปขึ้นกับ ${parent} แล้ว ทั้งก๊วนของ ${child} ย้ายตามไปด้วย`);
      render();
      if (at === pz().ops.length) finish();
    });

    ui.onClick('data-dg-reset', () => selectPuzzle(pi));
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initDgGame);
</script>

<script>
  import { initCpPlayers } from '../../lib/cpPlayer';

  /* หนึ่งก้าวคือหนึ่งจังหวะของการเรียกตัวเอง ไม่ใช่หนึ่งแถวของตาราง
     จึงใช้ initCpRowPlayers ไม่ได้ ต้องส่ง draw ของตัวเองเข้ามา */
  type FStep = { note: string; par: number[]; depth: number[]; cur: number; path: number[]; changed: number };

  function isFStep(x: unknown): x is FStep {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return (
      typeof o.note === 'string' &&
      Array.isArray(o.par) &&
      Array.isArray(o.depth) &&
      typeof o.cur === 'number' &&
      Array.isArray(o.path) &&
      typeof o.changed === 'number'
    );
  }

  document.addEventListener('astro:page-load', () => {
    initCpPlayers<FStep>('[data-fdsim]', {
      narrow: (raw) => {
        const ok = raw.filter(isFStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      draw: (st, ctx) => {
        const root = ctx.parts.root;
        const onPath = new Set(st.path);
        let live: HTMLTableCellElement | null = null;
        for (const td of Array.from(root.querySelectorAll<HTMLTableCellElement>('td[data-fd-par]'))) {
          const v = Number(td.dataset.fdPar);
          td.textContent = String(st.par[v]);
          td.classList.toggle('is-cur', v === st.cur);
          td.classList.toggle('is-path', onPath.has(v) && v !== st.cur);
          td.classList.toggle('is-changed', v === st.changed);
          if (v === st.cur) live = td;
        }
        for (const td of Array.from(root.querySelectorAll<HTMLTableCellElement>('td[data-fd-dep]'))) {
          const v = Number(td.dataset.fdDep);
          td.textContent = String(st.depth[v - 1]);
          td.classList.toggle('is-changed', v === st.changed);
        }
        ctx.keepInView(live);
      },
    });
  });
</script>
