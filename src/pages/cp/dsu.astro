/* ================= ฝึกข้อ 5 · Parity ================= */
const P5_LEN = 10;
const P5_Q: [number, number, 'even' | 'odd'][] = [[1, 2, 'even'], [3, 4, 'odd'], [5, 6, 'even'], [1, 6, 'even'], [7, 10, 'odd']];
/** DSU ที่เก็บ xor ถึงหัว เขียนแยกจากโค้ด C++ เพื่อใช้เดาคำตอบของตัวอย่างและวาดภาพ */
function parityFirstLie(q: [number, number, 'even' | 'odd'][]): number {
  const par = new Map<number, number>();
  const d = new Map<number, number>();
  const get = (x: number): number => {
    if (!par.has(x)) {
      par.set(x, x);
      d.set(x, 0);
    }
    return x;
  };
  const find = (x: number): [number, number] => {
    let acc = 0;
    let r = get(x);
    while (par.get(r) !== r) {
      acc ^= d.get(r) ?? 0;
      r = par.get(r) ?? r;
    }
    return [r, acc];
  };
  for (let i = 0; i < q.length; i++) {
    const [l, r, s] = q[i];
    const w = s === 'odd' ? 1 : 0;
    const [ra, da] = find(l - 1);
    const [rb, db] = find(r);
    if (ra === rb) {
      if ((da ^ db) !== w) return i;
    } else {
      par.set(rb, ra);
      d.set(rb, da ^ db ^ w);
    }
  }
  return q.length;
}
const p5Answer = parityFirstLie(P5_Q);
if (p5Answer !== 3) throw new Error('dsu p5: โมเดลไม่ตรงกับตัวอย่างของโจทย์');
const p5Points = [...new Set(P5_Q.slice(0, p5Answer + 1).flatMap(([l, r]) => [l - 1, r]))].sort((a, b) => a - b);
const P5_GAP = 170;
const P5_X0 = 90;
const P5_Y = 190;
const p5x = (v: number): number => P5_X0 + p5Points.indexOf(v) * P5_GAP;
const p5Arcs = P5_Q.slice(0, p5Answer + 1).map(([l, r, s], i) => {
  const x1 = p5x(l - 1);
  const x2 = p5x(r);
  const h = 34 + (x2 - x1) * 0.28;
  return { i, l, r, s, x1, x2, h, lie: i === p5Answer, lx: (x1 + x2) / 2, ly: P5_Y - R - h * 0.75 - 6 };
});
