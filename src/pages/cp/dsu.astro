/* ================= ฝึกข้อ 8 · Strange Food Chain ================= */
const P8_N = 100;
const P8_ST: [number, number, number][] = [[1, 101, 1], [2, 1, 2], [2, 2, 3], [2, 3, 3], [1, 1, 3], [2, 3, 1], [1, 5, 5]];
type P8Row = { i: number; D: number; x: number; y: number; lie: boolean; why: string };
/** ตัวแปลความทีละประโยค: เก็บชนิดสัมพัทธ์ (มอดุโล 3) ของทุกตัวในก๊วนเทียบกับหัว */
const p8Rows: P8Row[] = [];
{
  const par = fresh(P8_N);
  const d = Array<number>(P8_N + 1).fill(0);
  const find = (x: number): [number, number] => {
    let acc = 0;
    let r = x;
    while (par[r] !== r) {
      acc = (acc + d[r]) % 3;
      r = par[r];
    }
    return [r, acc];
  };
  P8_ST.forEach(([D, x, y], i) => {
    let lie = false;
    let why: string;
    if (x > P8_N || y > P8_N) {
      lie = true;
      why = `มีสัตว์หมายเลขเกิน ${P8_N}`;
    } else if (D === 2 && x === y) {
      lie = true;
      why = 'บอกว่าสัตว์กินตัวเอง';
    } else {
      const w = D - 1;
      const [rx, dx] = find(x);
      const [ry, dy] = find(y);
      if (rx === ry) {
        const diff = (((dy - dx) % 3) + 3) % 3;
        lie = diff !== w;
        why = lie
          ? `ขัดกับที่รู้แล้ว ${diff === 0 ? `${x} กับ ${y} ชนิดเดียวกัน` : diff === 1 ? `${x} กิน ${y}` : `${y} กิน ${x}`}`
          : x === y
            ? 'ตัวเดียวกันย่อมเป็นชนิดเดียวกัน'
            : 'ตรงกับที่รู้แล้ว';
      } else {
        par[ry] = rx;
        d[ry] = (((dx + w - dy) % 3) + 3) % 3;
        why = 'ยังไม่เคยรู้ความสัมพันธ์ของสองตัวนี้ รับไว้เป็นความจริง';
      }
    }
    p8Rows.push({ i: i + 1, D, x, y, lie, why });
  });
}
const p8Lies = p8Rows.filter((r) => r.lie).map((r) => r.i);
if (p8Lies.join(',') !== '1,4,5') throw new Error('dsu p8: โมเดลไม่ตรงกับคำใบ้ของโจทย์');
const codeP8 = `#include <bits/stdc++.h>
using namespace std;

// ชนิดสัตว์เป็น 0, 1, 2 และ x กิน y  <=>  ชนิด(y) = ชนิด(x) + 1 (มอดุโล 3)
// d[x] = ชนิด(x) - ชนิด(par[x]) มอดุโล 3  (0 = พวกเดียวกับแม่, 1 = แม่กิน x, 2 = x กินแม่)
vector<int> par, sz, d;

int find(int x) {
    if (par[x] == x) return x;
    int r = find(par[x]);
    d[x] = (d[x] + d[par[x]]) % 3; // ต่อระยะ x ถึงแม่ กับแม่ถึงหัวหน้า
    par[x] = r;
    return r;
}

// บันทึกว่า ชนิด(y) - ชนิด(x) = w (มอดุโล 3)  คืน false ถ้าขัดกับที่เชื่อไปแล้ว
bool unite(int x, int y, int w) {
    int rx = find(x), ry = find(y);
    if (rx == ry) return ((d[y] - d[x]) % 3 + 3) % 3 == w;
    // ให้ ry ไปห้อยใต้ rx: ชนิด(ry) - ชนิด(rx) = d[x] + w - d[y]
    int t = ((d[x] + w - d[y]) % 3 + 3) % 3;
    if (sz[rx] < sz[ry]) {
        swap(rx, ry);
        t = (3 - t) % 3; // มองกลับด้าน ความต่างก็กลับเครื่องหมาย
    }
    par[ry] = rx;
    d[ry] = t;
    sz[rx] += sz[ry];
    return true;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin >> t;
    while (t--) {
        int n, k;
        cin >> n >> k;
        par.resize(n + 1);
        iota(par.begin(), par.end(), 0);
        sz.assign(n + 1, 1);
        d.assign(n + 1, 0);
        int lies = 0;
        for (int i = 0; i < k; i++) {
            int D, x, y;
            cin >> D >> x >> y;
            // เงื่อนไขโกหกสองข้อแรก ต้องเช็คก่อนแตะ DSU (x หรือ y อาจเกิน n)
            if (x > n || y > n || (D == 2 && x == y)) {
                lies++;
                continue;
            }
            // D = 1 พวกเดียวกัน ความต่าง 0  /  D = 2 x กิน y ความต่าง 1
            if (!unite(x, y, D - 1)) lies++; // ประโยคที่ขัดไม่ถูกบันทึก เพราะมันไม่ใช่ความจริง
        }
        cout << lies << '\\n';
    }
    return 0;
}`;
