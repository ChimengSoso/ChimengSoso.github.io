      <text x="530" y="24" fill="#9aa7bd" font-size="12.5" text-anchor="middle">หลัง find({F_START}) · {F_START} ลึก {depthOf(afterF, F_START)}</text>
      {[...fBefore.edges, ...fAfter.edges].map((e) => (
