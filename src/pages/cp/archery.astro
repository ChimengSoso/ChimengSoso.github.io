    tease: 'ชุดนี้มีจุดยืนที่ทำให้เป้าซ้าย ๆ ยังไม่มีคนแข็งเลยตอนเริ่ม ลองดูว่ามันได้เปรียบหรือเสียเปรียบ',
    cs: { N: 5, R: 30, skills: [4, 9, 10, 6, 7, 1, 2, 3, 5, 8] },
