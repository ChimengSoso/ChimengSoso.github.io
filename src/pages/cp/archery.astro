const seatsAt = (i: number): SteadySeat[] => steady1.filter((x) => x.target === i);

/* ---------- ภาพสองเฟสในตอนที่ 6 ----------
   เฟสแรกยาว i0 - 1 รอบ เมื่อ i0 คือเป้าซ้ายสุดที่มีคนแข็งอยู่ตั้งแต่ต้น
   ค่านี้คิดจาก n(0) จริง ไม่ได้กำหนดเอง และเลือกจุดเริ่มที่ทำให้เฟสแรกไม่เป็นศูนย์
   เพื่อให้ภาพแสดงสิ่งที่มันต้องแสดง */
const PH_CS = EX1;
