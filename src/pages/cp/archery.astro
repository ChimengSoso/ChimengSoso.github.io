<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type ArPuzzle = {
    id: string;
    label: string;
    tease: string;
    n: number;
    r: number;
    skills: number[];
    finals: number[];
    best: number;
    start: number;
    monotone: boolean;
  };

  function initArcheryGame(): void {
    const maybeUi = cpGameUi('[data-argame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as ArPuzzle[];
    if (puzzles.length === 0) return;

    const startsEl = ui.root.querySelector<HTMLElement>('[data-ar-starts]');
    const triedEl = ui.root.querySelector<HTMLElement>('[data-ar-tried]');
    const bestEl = ui.root.querySelector<HTMLElement>('[data-ar-best]');
    const infoEl = ui.root.querySelector<HTMLElement>('[data-ar-info]');
    if (!startsEl || !triedEl || !bestEl || !infoEl) return;
    const starts: HTMLElement = startsEl;
    const triedOut: HTMLElement = triedEl;
    const bestOut: HTMLElement = bestEl;
    const infoOut: HTMLElement = infoEl;

    let pi = 0;
    let tried = new Map<number, number>();
    let picked = 0;

    const pz = (): ArPuzzle => puzzles[pi];

    function buildStarts(): void {
      const p = pz();
      starts.textContent = '';
      for (let k = 1; k <= p.n; k++) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cpg-btn ar-start';
        b.dataset.k = String(k);
        b.textContent = `ยืนเป้า ${k}`;
        const res = document.createElement('span');
        res.className = 'ar-res';
        res.dataset.res = String(k);
        res.textContent = 'ยังไม่ลอง';
        b.appendChild(res);
        starts.appendChild(b);
      }
    }

    function render(): void {
      const p = pz();
      for (const b of Array.from(starts.querySelectorAll<HTMLElement>('[data-k]'))) {
        const k = Number(b.dataset.k);
        b.classList.toggle('picked', k === picked);
      }
      for (const sp of Array.from(starts.querySelectorAll<HTMLElement>('[data-res]'))) {
        const k = Number(sp.dataset.res);
        const v = tried.get(k);
        sp.textContent = v === undefined ? 'ยังไม่ลอง' : `จบที่เป้า ${v}`;
      }
      triedOut.textContent = String(tried.size);
      let bestSeen = 0;
      for (const v of tried.values()) bestSeen = bestSeen === 0 ? v : Math.min(bestSeen, v);
      bestOut.textContent = bestSeen === 0 ? 'ยังไม่มี' : String(bestSeen);
      infoOut.textContent = `${p.n} เป้า ยิงกัน ${p.r} รอบ`;
    }

    function tryStart(k: number): void {
      const p = pz();
      picked = k;
      tried.set(k, p.finals[k - 1]);
      ui.setStatus(`ยืนเป้า ${k} แล้วซ้อมครบ ${p.r} รอบ จะไปจบที่เป้า ${p.finals[k - 1]}`);
      render();
    }

    function claim(): void {
      const p = pz();
      if (picked === 0) {
        ui.setStatus('เลือกจุดยืนที่คิดว่าดีที่สุดก่อนครับ', 'bad');
        return;
      }
      if (p.finals[picked - 1] === p.best) {
        const note = p.monotone
          ? ''
          : ' และสังเกตไหมว่าผลของแต่ละจุดเริ่มต้นไม่ได้เรียงจากน้อยไปมาก การค้นหาแบบทวิภาคจึงใช้กับค่านี้ตรง ๆ ไม่ได้';
        ui.setStatus(`ถูกครับ จบที่เป้า ${p.best} ซึ่งดีที่สุดแล้ว${note}`, 'good');
      } else {
        ui.setStatus(
          `ยืนเป้า ${picked} จบที่เป้า ${p.finals[picked - 1]} แต่ยังมีจุดยืนที่จบได้ดีกว่านี้`,
          'bad',
        );
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      tried = new Map<number, number>();
      picked = 0;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildStarts();
      ui.setStatus('กดจุดยืนเพื่อดูว่าซ้อมจนจบแล้วเราไปอยู่เป้าไหน แล้วเลือกจุดที่ดีที่สุด');
      render();
    }

    starts.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('[data-k]');
      if (!(b instanceof HTMLElement)) return;
      tryStart(Number(b.dataset.k));
    });

    ui.onClick('data-ar-claim', claim);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initArcheryGame);
</script>

<script>
  import { initCpRowPlayers } from '../../lib/cpPlayer';

  document.addEventListener('astro:page-load', () => {
    initCpRowPlayers('[data-arcsim]');
    initCpRowPlayers('[data-flowsim]');
  });
</script>
