/** n(0) ของเป้าที่ i โดยวนรอบวงเมื่อเลยขอบ */
const n0at = (i: number): number => flowN0[(i - 1) % FLOW_CS.N];
const FLOW_I = 1;
const FLOW_T = FLOW_CS.N;
interface FlowOpt {
  j: number;
  straight: number;
  diag: number;
  total: number;
  targets: number[];
}
const flowOpts: FlowOpt[] = Array.from({ length: FLOW_T + 1 }, (_, j) => {
  const targets = Array.from({ length: j }, (_, q) => FLOW_I + q);
  const diag = targets.reduce((sum, t) => sum + n0at(t), 0);
  return { j, straight: FLOW_T - j, diag, total: FLOW_T - j + diag, targets };
});
const flowBest = flowOpts.reduce((b, x) => (x.total < b.total ? x : b), flowOpts[0]);

/* พิกัดของภาพสองเฟส เส้นเวลาเดียวแบ่งสองช่วง */
