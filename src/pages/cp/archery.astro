        const k = idx + 1;
        const isBest = fin === ans1.best;
        const isAns = k === ans1.start;
        return (
          <>
            <rect x={ukx(idx)} y={UK_TOP} width={UKW} height="28" rx="6" fill="#141b2b" stroke="#2a3350" stroke-width="1.4" />
            <text x={ukx(idx) + UKW / 2} y={UK_TOP + 19} fill="#cdd6ea" font-size="13" text-anchor="middle" font-weight="700" font-family="monospace">
              {k}
            </text>
            <rect
              x={ukx(idx)}
              y={UK_TOP + UK_ROW}
              width={UKW}
              height="28"
              rx="6"
              fill={isAns ? '#12291c' : isBest ? '#2e2510' : '#161d2e'}
              stroke={isAns ? '#4ade80' : isBest ? '#e0b400' : '#2a3350'}
              stroke-width={isBest ? '2' : '1.4'}
            />
            <text
              x={ukx(idx) + UKW / 2}
              y={UK_TOP + UK_ROW + 19}
              fill={isAns ? '#d7ffe4' : isBest ? '#ffe58a' : '#8f9ab2'}
              font-size="13"
              text-anchor="middle"
              font-weight="700"
              font-family="monospace"
            >
              {fin}
            </text>
          </>
        );
      })}
      <text x={ukx(0)} y={UK_TOP + 2 * UK_ROW + 34} fill="#e0b400" font-size="11.5" text-anchor="start">
        ทองคือจุดที่จบถึงเป้า {ans1.best} ซึ่งเป็นค่าที่ดีที่สุด มี {ukTies.length} จุด
      </text>
      <text x={ukx(0)} y={UK_TOP + 2 * UK_ROW + 58} fill="#4ade80" font-size="11.5" text-anchor="start">
        เขียวคือคำตอบ เพราะเสมอกันแล้วโจทย์ให้เอาจุดเริ่มที่มากที่สุด
      </text>
      <text x={ukx(0)} y={UK_TOP + 2 * UK_ROW + 82} fill="#98a3ba" font-size="11.5" text-anchor="start">
        แถวล่างขึ้นแล้วลง จึงห้ามค้นหาแบบทวิภาคบนค่านี้
      </text>
    </svg>
  </ZoomableDiagram>

  <h2>โค้ดเต็มขอบเขต</h2>
  <Spoiler>
    <figure class="tbl">
      <table class="rec">
        <caption>เวลาที่วัดได้ · N = {fmt(N_MAX)} และ R = {fmt(R_MAX)}</caption>
        <thead>
          <tr><th>ลักษณะอินพุต</th><th class="num">เวลา (มิลลิวินาที)</th><th>เทียบกับลิมิต 2 วินาที</th></tr>
        </thead>
