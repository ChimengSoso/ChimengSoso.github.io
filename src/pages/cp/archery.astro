  { code: 'เฟส 2: nt1[s] - (s == 1 ? 1 : 0)', where: 'ตอนที่ 7 (ใช้ n ของเป้า 1 ลบหนึ่ง)' },
  { code: 'cand, firstGE, lastLE', where: 'ตอนที่ 8 (ผู้เข้าชิงบล็อกละตัว)' },
  { code: 'f == bestF && u > bestU', where: 'ตอนที่ 8 และกล่องบักตอนเสมอกันข้างบน' },
];

/* ท่อนเลือกผู้ชนะจากผู้เข้าชิง เวอร์ชันที่ผมเขียนผิดรอบแรก ต่างจากโค้ดเต็มแค่บรรทัดเดียว */
const brokenPick = `// ผู้เข้าชิงคือค่า u ที่เล็กที่สุดของแต่ละบล็อก สองบล็อกให้เป้าสุดท้ายเท่ากันได้
ll bestF = LLONG_MAX, bestU = 0;
for (ll u : cand) {
    ll f = fOf(u);
    if (f < bestF) { bestF = f; bestU = u; }   // บรรทัดที่ผิด เสมอกันแล้วเก็บตัวที่เจอก่อน
}
int ans = lastLE(bestU);                       // ค่า u ที่เจอก่อนคือค่าน้อยกว่า จุดเริ่มจึงเล็กเกิน`;

