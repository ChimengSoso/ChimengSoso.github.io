const arPuzzles: ArPuzzleData[] = AR_PUZZLES.map((p) => {
  const a = answerOf(p.cs);
  // ตรวจกับการจำลองคนจริงทีละรอบ ให้แน่ใจว่าท่าย่อไม่ได้เพี้ยน
  for (let k = 1; k <= p.cs.N; k++) {
    const viaSim = simulateFull(p.cs, k, roundsNeeded(p.cs.N, p.cs.R));
    if (viaSim !== a.finals[k - 1]) {
      throw new Error(
        `มินิเกมของ archery: ชุด ${p.id} จุดเริ่ม ${k} ท่าย่อได้ ${a.finals[k - 1]} แต่จำลองจริงได้ ${viaSim}`,
      );
    }
  }
  const monotone = a.finals.every((v, i) => i === 0 || a.finals[i - 1] <= v);
  return {
    id: p.id,
    label: p.label,
    tease: p.tease,
    n: p.cs.N,
    r: p.cs.R,
    skills: p.cs.skills,
    finals: a.finals,
    best: a.best,
    start: a.start,
    monotone,
  };
});
