const phaseK = (() => {
  for (let k = 1; k <= PH_CS.N; k++) {
    const b = boardFor(PH_CS, k);
    if (b[1] === 0) return k;
  }
  return 1;
})();
const phaseN0 = boardFor(PH_CS, phaseK).slice(1);
/** เป้าซ้ายสุดที่มีคนแข็ง นับจาก 1 */
const phaseI0 = phaseN0.findIndex((v) => v >= 1) + 1;
const phaseOneLen = phaseI0 - 1;

/* ---------- ภาพของสูตร min over j ในตอนที่ 5 ----------
   เลือกเป้าและรอบที่ทำให้เห็นการแลกกันชัดที่สุด คือค่าที่ j ตัวชนะไม่ใช่ j = 0
   ค่าของทุก j คิดจาก n(0) จริงที่ boardFor() คืนมา ไม่ได้พิมพ์มือ */
const FLOW_CS = EX1;
