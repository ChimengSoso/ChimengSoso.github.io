const flowIdea = `// F_i(t) = จำนวนคนแข็งที่ออกจากเป้า i ไปแล้ว เมื่อผ่านไป t รอบ
// ความจริงข้อเดียวที่ต้องเชื่อ: เป้าธรรมดาที่มีคนแข็ง ปล่อยออกไปรอบละหนึ่งคนเสมอ
//   n_i(t)   = n_i(0) + F_{i+1}(t) - F_i(t)        ตั้งต้น + ไหลเข้า - ไหลออก
//   F_i(t+1) = F_i(t) + [ n_i(t) >= 1 ]
// เมื่อ n ไม่ติดลบ [ n >= 1 ] มีค่าเท่ากับ min(1, n) แทนค่าแล้วได้
//   F_i(t+1) = min( F_i(t) + 1 , F_{i+1}(t) + n_i(0) )
// คลี่ซ้ำไปจนถึงรอบ 0 (ที่ F ทุกตัวเป็น 0) ทุกขั้นเลือกได้สองทาง
//   "ตรง" อยู่เป้าเดิม บวก 1   หรือ   "ทแยง" ขยับไปเป้าขวา บวก n(0) ของเป้าที่ผ่าน
// เดินทแยง j ครั้ง ตรง t - j ครั้ง ลำดับไม่มีผล เหลือแค่เลือก j
//   F_i(t) = min over j in [0, t] ของ  (t - j) + ( n_i(0) + ... + n_{i+j-1}(0) )`;

const rmqIdea = `// ให้ P[y] = ผลรวมของ n(0) ตั้งแต่เป้าลำดับที่ 1 ถึง y-1 (คลี่วงออกเป็นเส้นตรง)
// และ G[y] = P[y] - y   สูตรข้างบนจะยุบเหลือ
//     F_i(t) = t - P[i] + i + min( G[i], G[i+1], ..., G[i+t] )
