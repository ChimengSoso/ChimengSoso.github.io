/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ไม่มีเลขไหนพิมพ์ด้วยมือ ---------- */

/** ตัวอย่างหนึ่งชุด skills[0] คือเรา ที่เหลือคือคนอื่นเรียงจากซ้ายไปขวา */
type Case = { N: number; R: number; skills: number[] };

const EX1: Case = { N: 4, R: 8, skills: [7, 4, 2, 6, 5, 8, 1, 3] };
const EX2: Case = { N: 4, R: 9, skills: [2, 1, 5, 8, 3, 4, 7, 6] };

const meOf = (c: Case): number => c.skills[0];
const othersOf = (c: Case): number[] => c.skills.slice(1);

/* ---------- ท่าซื่อ ๆ จำลองคนจริงทุกคน ใช้ตรวจว่าท่าย่อไม่เพี้ยน ---------- */

/** เรียงคนทั้ง 2N คนเป็นแถว โดยเราแทรกตัวเองที่เป้า k */
function lineFor(c: Case, k: number): number[] {
  const o = othersOf(c);
  return [...o.slice(0, 2 * k - 2), meOf(c), ...o.slice(2 * k - 2)];
}

/** จำลองแบบตรงไปตรงมา คืนเป้าที่เราอยู่หลังผ่านไป rounds รอบ */
function simulateFull(c: Case, k: number, rounds: number): number {
  const line = lineFor(c, k);
  let t: number[][] = [];
  for (let i = 1; i <= c.N; i++) t.push([line[2 * i - 2], line[2 * i - 1]]);
  for (let q = 0; q < rounds; q++) {
    const win = t.map((p) => Math.min(p[0], p[1]));
    const los = t.map((p) => Math.max(p[0], p[1]));
    const nt: number[][] = [];
    for (let i = 0; i < c.N; i++) {
      if (c.N === 1) nt.push([t[0][0], t[0][1]]);
      else if (i === 0) nt.push([win[0], win[1]]);
      else if (i < c.N - 1) nt.push([los[i], win[i + 1]]);
      else nt.push([los[c.N - 1], los[0]]);
    }
    t = nt;
  }
  return t.findIndex((p) => p.includes(meOf(c))) + 1;
}

/* ---------- ท่าย่อ นับแค่ว่าช่องไหนมีคนที่เราไม่ชนะกี่คน ---------- */

/** c[i] = จำนวนคนที่เป้า i ซึ่งเราไม่ชนะ (เก่งกว่าเรา หรือคือตัวเราเอง) มีค่า 0, 1 หรือ 2 */
function boardFor(cs: Case, k: number): number[] {
  const o = othersOf(cs);
  const me = meOf(cs);
  const c = [0];
  for (let i = 1; i <= cs.N; i++) {
    const a = i < k ? o[2 * i - 2] : i === k ? o[2 * i - 2] : o[2 * i - 3];
    const b = i < k ? o[2 * i - 1] : i === k ? me : o[2 * i - 2];
    c.push((a <= me ? 1 : 0) + (b <= me ? 1 : 0));
  }
  return c;
}

/** กระดานรอบถัดไป: ทุกเป้าส่ง "ตัวที่แข็งกว่า" ออกไปทางซ้าย และเก็บ "ตัวที่อ่อนกว่า" ไว้ */
function nextBoard(c: number[]): number[] {
  const N = c.length - 1;
  if (N === 1) return c.slice();
  const n = [0];
  for (let i = 1; i <= N; i++) {
    if (i === 1) n.push((c[1] >= 1 ? 1 : 0) + (c[2] >= 1 ? 1 : 0));
    else if (i < N) n.push((c[i] === 2 ? 1 : 0) + (c[i + 1] >= 1 ? 1 : 0));
    else n.push((c[N] === 2 ? 1 : 0) + (c[1] === 2 ? 1 : 0));
  }
  return n;
}

type Frame = { round: number; board: number[]; pos: number; oppStrong: boolean };

/** เดินทีละรอบ คืนภาพกระดานก่อนรอบนั้น พร้อมตำแหน่งเราและชนิดของคู่แข่ง */
function trace(cs: Case, k: number, rounds: number): Frame[] {
  let c = boardFor(cs, k);
  let pos = k;
  const out: Frame[] = [];
  for (let q = 0; q < rounds; q++) {
    const oppStrong = c[pos] === 2;
    out.push({ round: q + 1, board: c.slice(), pos, oppStrong });
    pos = pos === 1 ? (oppStrong ? cs.N : 1) : oppStrong ? pos : pos - 1;
    c = nextBoard(c);
  }
  out.push({ round: rounds + 1, board: c.slice(), pos, oppStrong: c[pos] === 2 });
  return out;
}

/** จำนวนรอบที่ต้องเดินจริง หลัง 2N รอบระบบวนคาบ N จึงตัดส่วนเกินทิ้งได้ */
const roundsNeeded = (N: number, R: number): number => (R <= 3 * N ? R : 3 * N + ((R - 3 * N) % N));

function finalTarget(cs: Case, k: number): number {
  const T = roundsNeeded(cs.N, cs.R);
  const fr = trace(cs, k, T);
  return fr[fr.length - 1].pos;
}

type Answer = { finals: number[]; best: number; start: number };
function answerOf(cs: Case): Answer {
  const finals: number[] = [];
  let best = Infinity;
  let start = -1;
  for (let k = 1; k <= cs.N; k++) {
    const f = finalTarget(cs, k);
    finals.push(f);
    if (f < best) { best = f; start = k; }
    else if (f === best) start = k;
  }
  return { finals, best, start };
}

const ans1 = answerOf(EX1);
const ans2 = answerOf(EX2);

/* ---------- มินิเกม เลือกจุดยืนเริ่มต้นเอง ----------
   ผลของทุกจุดเริ่มต้นมาจาก finalTarget ตัวเดียวกับที่เฉลยใช้
   และถูกตรวจซ้ำกับการจำลองคนจริงตอนบิลด์ ถ้าสองอย่างไม่ตรงกัน บิลด์จะพัง */
type ArPuzzle = { id: string; label: string; tease: string; cs: Case };
const AR_PUZZLES: ArPuzzle[] = [
  { id: 'a1', label: 'ชุดที่ 1 · ตัวอย่างแรก', tease: 'ตัวอย่างแรกของโจทย์ สี่เป้า แปดคน', cs: EX1 },
  { id: 'a2', label: 'ชุดที่ 2 · ตัวอย่างที่สอง', tease: 'ตัวอย่างที่สอง ลองหาจุดยืนที่ดีที่สุดเอง', cs: EX2 },
  {
    id: 'a3',
    label: 'ชุดที่ 3 · ยืนตรงไหนก็เท่ากัน',
    tease: 'ชุดนี้ทุกจุดยืนพาไปจบที่เป้าเดียวกันหมด แล้วโจทย์ให้ตอบจุดไหน',
    cs: { N: 4, R: 10, skills: [5, 2, 7, 1, 8, 3, 6, 4] },
  },
  {
    id: 'a4',
    label: 'ชุดที่ 4 · เรารอที่เป้าหน้าก่อนคนเก่งจะมาถึง',
    tease: 'ชุดนี้มีจุดยืนที่ทำให้เป้าซ้าย ๆ ยังไม่มีคนแข็งเลยตอนเริ่ม ลองดูว่ามันได้เปรียบหรือเสียเปรียบ',
    cs: { N: 5, R: 30, skills: [4, 9, 10, 6, 7, 1, 2, 3, 5, 8] },
  },
];

type ArPuzzleData = {
  id: string;
  label: string;
  tease: string;
  n: number;
  r: number;
  skills: number[];
  finals: number[];
  best: number;
  start: number;
  monotone: boolean;
};
const arPuzzles: ArPuzzleData[] = AR_PUZZLES.map((p) => {
  const a = answerOf(p.cs);
  // ตรวจกับการจำลองคนจริงทีละรอบ ให้แน่ใจว่าท่าย่อไม่ได้เพี้ยน
  for (let k = 1; k <= p.cs.N; k++) {
    const viaSim = simulateFull(p.cs, k, roundsNeeded(p.cs.N, p.cs.R));
    if (viaSim !== a.finals[k - 1]) {
      throw new Error(
        `มินิเกมของ archery: ชุด ${p.id} จุดเริ่ม ${k} ท่าย่อได้ ${a.finals[k - 1]} แต่จำลองจริงได้ ${viaSim}`,
      );
    }
  }
  const monotone = a.finals.every((v, i) => i === 0 || a.finals[i - 1] <= v);
  return {
    id: p.id,
    label: p.label,
    tease: p.tease,
    n: p.cs.N,
    r: p.cs.R,
    skills: p.cs.skills,
    finals: a.finals,
    best: a.best,
    start: a.start,
    monotone,
  };
});
const arJson = JSON.stringify(arPuzzles);

/** ตรวจว่าท่าย่อให้ผลเดียวกับการจำลองคนจริง ถ้าไม่ตรงจะโผล่ในตารางทันที */
const crossCheck = [EX1, EX2].every((cs) =>
  Array.from({ length: cs.N }, (_, i) => i + 1).every(
    (k) => finalTarget(cs, k) === simulateFull(cs, k, roundsNeeded(cs.N, cs.R)),
  ),
);

/* ---------- ตารางเดินกระดานทีละรอบ ---------- */

const DEMO = EX2;
const DEMO_K = ans2.start;
const demoFrames = trace(DEMO, DEMO_K, roundsNeeded(DEMO.N, DEMO.R));
const demoBetter = DEMO.skills.filter((s) => s <= meOf(DEMO)).length;
const demoWins = demoFrames.slice(0, -1).filter((f) => !f.oppStrong).length;
const demoLosses = demoFrames.length - 1 - demoWins;
const demoEnd = demoFrames[demoFrames.length - 1].pos;

/* ---------- ตัวเลขของขนาดปัญหา ---------- */

const N_MAX = 200000;
const R_MAX = 1000000000;
const SUB60 = 5000;
const SUB20 = 200;

const fmt = (n: number): string => n.toLocaleString('en-US');

/** เดินกระดานหนึ่งรอบ (คนจริงทุกคน) ใช้ตรวจว่าสภาวะคงตัวหน้าตาเป็นยังไง */
function stepBoard(N: number, t: number[][]): number[][] {
  const win = t.map((p) => Math.min(p[0], p[1]));
  const los = t.map((p) => Math.max(p[0], p[1]));
  const nt: number[][] = [];
  for (let i = 0; i < N; i++) {
    if (N === 1) nt.push([t[0][0], t[0][1]]);
    else if (i === 0) nt.push([win[0], win[1]]);
    else if (i < N - 1) nt.push([los[i], win[i + 1]]);
    else nt.push([los[N - 1], los[0]]);
  }
  return nt;
}

/** ใครขยับทุกรอบ ใครแข็งค้างอยู่กับที่ หลังระบบเข้าสภาวะคงตัวแล้ว */
function steadyRoles(cs: Case, k: number): { circulators: number[]; frozen: number[] } {
  const line = lineFor(cs, k);
  let t: number[][] = [];
  for (let i = 1; i <= cs.N; i++) t.push([line[2 * i - 2], line[2 * i - 1]]);
  for (let q = 0; q < 2 * cs.N; q++) t = stepBoard(cs.N, t);
  const posOf = (b: number[][]): Map<number, number> => {
    const m = new Map<number, number>();
    b.forEach((p, i) => p.forEach((a) => m.set(a, i + 1)));
    return m;
  };
  let prev = posOf(t);
  const moved = new Set<number>();
  for (let q = 0; q < cs.N; q++) {
    t = stepBoard(cs.N, t);
    const cur = posOf(t);
    for (const [a, p] of cur) if (prev.get(a) !== p) moved.add(a);
    prev = cur;
  }
  const all = Array.from({ length: 2 * cs.N }, (_, i) => i + 1);
  return { circulators: all.filter((a) => moved.has(a)), frozen: all.filter((a) => !moved.has(a)) };
}

/** สภาพกระดานจริงหลังเข้าสภาวะคงตัว คืนว่าใครอยู่เป้าไหน และคนคนนั้นวนหรือนิ่ง
 *  ต่างจาก steadyRoles() ที่บอกแค่ว่าใครวน ตัวนี้ต้องรู้ตำแหน่งเพื่อวาดภาพได้ */
interface SteadySeat {
  target: number;
  rank: number;
  moving: boolean;
}
function steadyBoard(cs: Case, k: number): SteadySeat[] {
  const line = lineFor(cs, k);
  let t: number[][] = [];
  for (let i = 1; i <= cs.N; i++) t.push([line[2 * i - 2], line[2 * i - 1]]);
  for (let q = 0; q < 2 * cs.N; q++) t = stepBoard(cs.N, t);
  const roles = steadyRoles(cs, k);
  const seats: SteadySeat[] = [];
  t.forEach((pair, i) => {
    for (const rank of [...pair].sort((a, b) => a - b)) {
      seats.push({ target: i + 1, rank, moving: roles.circulators.indexOf(rank) !== -1 });
    }
  });
  return seats;
}
const steady1 = steadyBoard(EX1, 1);
/** ลำดับที่จอดถาวรที่เป้า 1 ต้องเป็นลำดับ 1 ตามข้ออ้างของหัวข้อนี้ */
const parkedRank = Math.min(...steady1.filter((x) => x.target === 1).map((x) => x.rank));
const steadyClaim = parkedRank === 1;

const roles1 = steadyRoles(EX1, 1);
const roles2 = steadyRoles(EX2, 3);
/** ข้ออ้างที่ต้องตรวจ: คนที่หมุนคือลำดับ 2 ถึง N+1 พอดี ทั้งสองตัวอย่าง */
const rolesOk = (cs: Case, r: { circulators: number[] }): boolean =>
  r.circulators.length === cs.N && r.circulators.every((a, i) => a === i + 2);
const rolesClaim =
  [
    [EX1, roles1] as const,
    [EX2, roles2] as const,
  ].every(
    ([cs, r]) =>
      r.circulators.length === cs.N &&
      r.circulators.every((a, i) => a === i + 2),
  );

/** เวลาของโค้ดรอบแรก วัดใหม่ 19 ต.ค. 2026 จากโค้ดที่ดึงออกจากหน้านี้จริง (g++ -O2 บน WSL)
 *  อินพุตสุ่ม R = 1,000,000,000 */
const timing = [
  { n: 200, ms: 38 },
  { n: 500, ms: 501 },
  { n: 800, ms: 2053 },
  { n: 1200, ms: 6388 },
];
const LIMIT_MS = 2000;
const firstOkN = Math.max(...timing.filter((t) => t.ms < LIMIT_MS).map((t) => t.n));
const firstBadN = Math.min(...timing.filter((t) => t.ms >= LIMIT_MS).map((t) => t.n));

/** การสุ่มเทียบที่รันจริงกับโค้ดสามชุดที่ดึงออกจากหน้านี้ (19 ต.ค. 2026) */
const STRESS = { small: 2000, smallMaxN: 8, mid: 500, midMinN: 9, midMaxN: 60, bad: 0 };
/** จำนวนครั้งที่โค้ดเต็มเรียก evalU ที่ N = 200,000 วัดจากโค้ดเดียวกันที่ใส่ตัวนับเพิ่ม
 *  อินพุตห้าแบบในตารางเวลา: แบบที่เราเป็นลำดับ 1 ไม่เรียกเลย อีกสี่แบบเรียก min ถึง max ครั้ง */
const EVALS = { inputs: 4, min: 20, max: 39 };
/** การตรวจเชิงทดลองด้วยสคริปต์แยก (จำลองคนจริงทุกคน ไม่ใช้ท่าย่อ) 19 ต.ค. 2026
 *  boards: กระดานสุ่ม N = 1..maxN ดูว่ากระดานเริ่มซ้ำทุก N รอบตั้งแต่รอบไหน (ช้าสุดที่เจอคือรอบ N)
 *  และหลังรอบ 2N คนที่ขยับคือลำดับ 2 ถึง N+1 ทุกกระดาน
 *  uBoards: กระดานสุ่ม N = 2..uMaxN ทุกจุดเริ่ม ตรวจว่า u(k) ไม่ลด และเดิน T รอบให้ผลเท่าเดิน R รอบ */
const EMP = { boards: 7600, maxN: 40, latestStartOverN: 1, uBoards: 960, uMaxN: 25, bad: 0 };

/** ความพยายามแต่ละรอบกับสูตรที่เป้า 1 ตัวเลขคือจุดที่ไม่ตรงกับการเดินกระดานจริง */
const formulaTries = [
  { name: 'ใช้สูตร min-plus ตรง ๆ ทั้งวง', wrong: 1306, of: 11156 },
  { name: 'ตัดค่าติดลบทิ้งด้วย max(0, ...)', wrong: 774, of: 14394 },
  { name: 'ใช้ค่ามากสุดสะสมตามเวลาแทน', wrong: 278, of: 14394 },
  { name: 'ทดสอบเฉพาะกรณีที่เป้า 1 มีคนแข็งอยู่แล้ว', wrong: 0, of: 18264 },
  { name: 'แยกสองเฟส (เฉลยจริง)', wrong: 0, of: 36510 },
].map((t) => ({ ...t, pct: ((100 * t.wrong) / t.of).toFixed(1) }));

/** เวลาของโค้ดเต็มขอบเขต วัดที่ N = 200,000 กับ R = 1,000,000,000 (ดีที่สุดในสามรอบ วัดพร้อมกับตารางบน) */
const timingFull = [
  { name: 'อินพุตสุ่ม', ms: 252 },
  { name: 'เรียงจากเก่งไปอ่อน (เราคือลำดับ 1)', ms: 28 },
  { name: 'เรียงจากอ่อนไปเก่ง', ms: 407 },
  { name: 'เราอ่อนที่สุด คนแข็งกองท้ายแถว', ms: 409 },
  { name: 'เราลำดับ 2 คนเก่งสุดอยู่ท้ายแถว', ms: 468 },
];
const fullMaxMs = Math.max(...timingFull.map((t) => t.ms));

/* ---------- ช่องว่างระหว่างโค้ดรอบแรกกับงบ (ตอนที่ 5) ----------
   ไม่เดาความเร็วเครื่อง ใช้เวลาที่วัดได้จริงที่ N = 1,200 หารด้วยงานจริงของมัน (N จุดเริ่ม × T รอบ × N เป้า)
   แล้วคูณกลับด้วยงานที่ N = 200,000 โดยใช้ T ของแต่ละขนาดตามที่โค้ดรอบแรกคำนวณจริง */
const roundsFull = (N: number, R: number): number => (R <= 2 * N ? R : 2 * N + ((R - 2 * N) % N));
const lastTiming = timing[timing.length - 1];
const firstRoundsAt = (N: number): number => roundsNeeded(N, R_MAX);
const msPerCell = lastTiming.ms / (lastTiming.n * firstRoundsAt(lastTiming.n) * lastTiming.n);
const firstRoundsAtMax = firstRoundsAt(N_MAX);
const firstProjMs = msPerCell * N_MAX * firstRoundsAtMax * N_MAX;
/** สมมติให้การจำลองคนจริงเดินรอบละเร็วเท่าโค้ดรอบแรก ซึ่งใจดีกับมันแล้ว ต่างกันแค่ต้องเดินครบ R รอบ */
const bruteProjMs = firstProjMs * (R_MAX / firstRoundsAtMax);
const oneStartMs = firstProjMs / N_MAX;
const oneStartOver = Math.round(oneStartMs / LIMIT_MS);
const fullRoundsAtMax = roundsFull(N_MAX, R_MAX);

/* เพดานจำนวนครั้งที่โค้ดเต็มประเมิน u(k) อ่านจากโครงของ main()
   u อยู่ระหว่าง 1 - T ถึง N และ T ไม่เกิน 3N - 1 จึงคร่อมได้ไม่เกิน BLOCKS_MAX บล็อก
   = 2 ครั้ง (u(1), u(N)) + เส้นแบ่งบล็อกละ (ค้นหาแบบทวิภาค + 1) + lastLE อีกหนึ่งการค้นหา */
const BS_ITERS = Math.ceil(Math.log2(N_MAX + 1));
const T_FULL_MAX = 3 * N_MAX - 1;
const blockOfU = (u: number): number => Math.floor((u - 1) / N_MAX);
const BLOCKS_MAX = blockOfU(N_MAX) - blockOfU(1 - T_FULL_MAX) + 1;
const EVAL_BOUND = 2 + (BLOCKS_MAX - 1) * (BS_ITERS + 1) + BS_ITERS;
if (EVALS.max > EVAL_BOUND) throw new Error('archery: จำนวนครั้งที่วัดได้เกินเพดานที่คิดจากโค้ด');
/** ถ้าลองจุดเริ่มได้ไม่เกิน EVAL_BOUND ครั้ง แต่ละรอบของการเดินมีงบกี่นาโนวินาที */
const nsBudgetRaw = (LIMIT_MS * 1e6) / (EVAL_BOUND * fullRoundsAtMax);
const nsPerRoundBudget = Math.round(nsBudgetRaw);
/** โค้ดรอบแรกใช้กี่นาโนวินาทีต่อหนึ่งรอบของหนึ่งจุดเริ่ม */
const nsFirstRaw = (firstProjMs * 1e6) / (N_MAX * firstRoundsAtMax);
const nsPerRoundFirst = Math.round(nsFirstRaw);
const roundGap = Math.round(nsFirstRaw / nsBudgetRaw);
if (oneStartOver < 2 || roundGap < 10) throw new Error('archery: ตัวเลขช่องว่างไม่สอดคล้องกับเรื่องที่ตอนที่ 5 เล่า');

const fmtSec = (ms: number): string => {
  const s = ms / 1000;
  if (s < 1) return `${fmt(Math.round(ms))} มิลลิวินาที`;
  if (s < 60) return `${Math.round(s)} วินาที`;
  if (s < 3600) return `${(s / 60).toFixed(1).replace(/\.0$/, '')} นาที`;
  if (s < 86400) return `${Math.round(s / 3600)} ชั่วโมง`;
  if (s < 86400 * 365) return `${Math.round(s / 86400)} วัน`;
  return `${fmt(Math.round(s / (86400 * 365)))} ปี`;
};

/* กราฟแท่งเวลา สเกล log10 หน่วยมิลลิวินาที */
const CH_LO = 2;
const CH_HI = 14;
const CH_X0 = 186;
const CH_W = 380;
const CH_ROW = 46;
const CH_Y0 = 46;
const chX = (v: number): number => CH_X0 + ((Math.log10(v) - CH_LO) / (CH_HI - CH_LO)) * CH_W;
const sci = (v: number): { m: string; e: number } => {
  const e = Math.floor(Math.log10(v));
  return { m: (v / 10 ** e).toFixed(1).replace(/\.0$/, ''), e };
};
const CH_BARS = [
  { name: 'จำลองครบ R รอบ', v: bruteProjMs, ok: false },
  { name: 'โค้ดรอบแรก', v: firstProjMs, ok: false },
  { name: 'โค้ดเต็ม (วัดจริง)', v: fullMaxMs, ok: true },
].map((b, k) => ({ ...b, y: CH_Y0 + k * CH_ROW, s: sci(b.v), over: Math.round(b.v / LIMIT_MS) }));
if (CH_BARS.some((b) => b.ok !== b.v <= LIMIT_MS)) throw new Error('archery: กราฟงบเวลา แท่งที่บอกว่าทันไม่ตรงกับตัวเลข');
const CH_TICKS = Array.from({ length: (CH_HI - CH_LO) / 3 + 1 }, (_, k) => CH_LO + k * 3);
const CH_BOTTOM = CH_Y0 + CH_BARS.length * CH_ROW;

/* เรื่องเล่าในกล่อง "สองทางที่ผมลองก่อน" คิดจากขอบเขตจริง ไม่พิมพ์มือ */
const BIT_WORDS = Math.ceil(N_MAX / 64);
const LOG_N = Math.ceil(Math.log2(N_MAX));
const BIT_TOTAL = BIT_WORDS * 2 * N_MAX * LOG_N;

/* ---------- พิกัดภาพสภาวะคงตัว ----------
   เป้าเรียงซ้ายไปขวา ตรงกับกติกาที่ผู้ชนะไหลไปทางซ้าย
   ที่เว้นล่าง 34 หน่วยคือที่ว่างให้ปุ่มขยายของ ZoomableDiagram */
const STW = 104;
const STGAP = 14;
const stx = (i: number): number => 20 + (i - 1) * (STW + STGAP);
const stcx = (i: number): number => stx(i) + STW / 2;
const ST_TOP = 86;
const ST_H = 82;
const steadyVB = `0 0 ${stx(EX1.N) + STW + 12} 284`;
/** ที่นั่งของเป้าหนึ่งเป้า เรียงลำดับน้อยไปมาก */
const seatsAt = (i: number): SteadySeat[] => steady1.filter((x) => x.target === i);

/* ---------- ตัวอย่างประจำตอนที่ 6 และ 7 ----------
   ใช้กระดานเดียวทั้งสองตอน ผู้อ่านจะได้เรียนตัวเลขชุดเดียว
   เลือกด้วยสคริปต์ค้นหา ให้ (ก) เป้า 1 ว่างจากคนแข็งตอนเริ่ม ซึ่งเป็นเคสที่ตอนที่ 7 ต้องใช้
   และ (ข) ค่าน้อยสุดในสูตรการไหลชนะที่ j ตรงกลาง ไม่ใช่ปลาย ซึ่งตรวจซ้ำข้างล่าง */
const FX: Case = { N: 6, R: 12, skills: [6, 12, 7, 8, 10, 11, 3, 2, 5, 9, 4, 1] };
const FX_K = 3;

/** n(0) แบบในโค้ดเต็ม: จำนวนคนที่แข็งกว่าเราที่แต่ละเป้า "ไม่นับตัวเรา" (c ในตอนที่ 1 นับตัวเราด้วย) */
function strongBoard(cs: Case, k: number): number[] {
  return boardFor(cs, k).map((v, i) => (i === k ? v - 1 : v));
}

/** นับตรง ๆ: เดินกระดานคนแข็ง t รอบ แล้วนับว่าเป้า i ปล่อยคนแข็งออกไปกี่คน */
function emittedDirect(n0: number[], i: number, t: number): number {
  let b = n0.slice();
  let out = 0;
  for (let q = 0; q < t; q++) {
    out += i === 1 ? (b[1] === 2 ? 1 : 0) : b[i] >= 1 ? 1 : 0;
    b = nextBoard(b);
  }
  return out;
}

/** สูตรการไหล: ค่าน้อยสุดของ (t - j) + ผลรวม n(0) ของ j เป้าแรกนับจากเป้า i
 *  ใช้ได้เมื่อทุกเป้าบนทางเป็นเป้าธรรมดา คือ i >= 2 และ i + t - 1 <= N */
function emittedFormula(n0: number[], i: number, t: number): number {
  let best = Infinity;
  let sum = 0;
  for (let j = 0; j <= t; j++) {
    best = Math.min(best, t - j + sum);
    if (j < t) sum += n0[i + j];
  }
  return best;
}

/** ตรวจสูตรกับการนับตรง ๆ ทุกเป้าทุกจำนวนรอบที่สูตรใช้ได้ บนกระดานสุ่มหลายร้อยแบบ ไม่ตรงคือบิลด์พัง */
let lcg = 20261019;
const rnd = (m: number): number => {
  lcg = (lcg * 1103515245 + 12345) % 2147483648;
  return Math.floor((lcg / 2147483648) * m);
};
const randomCase = (N: number, extra: number): Case => {
  const p = Array.from({ length: 2 * N }, (_, i) => i + 1);
  for (let i = p.length - 1; i > 0; i--) {
    const j = rnd(i + 1);
    [p[i], p[j]] = [p[j], p[i]];
  }
  return { N, R: 2 * N + extra, skills: p };
};
const RANDOM_CASES: Case[] = Array.from({ length: 300 }, (_, q) => randomCase(1 + (q % 7), rnd(3 * (1 + (q % 7)) + 1)));
let flowChecks = 0;
for (const cs of [FX, ...RANDOM_CASES]) {
  for (let k = 1; k <= cs.N; k++) {
    const n0 = strongBoard(cs, k);
    for (let i = 2; i <= cs.N; i++) {
      for (let t = 0; i + t - 1 <= cs.N; t++) {
        if (emittedFormula(n0, i, t) !== emittedDirect(n0, i, t)) {
          throw new Error(`archery: สูตรการไหลไม่ตรงกับการนับตรง ๆ ที่ N=${cs.N} k=${k} เป้า ${i} รอบ ${t}`);
        }
        flowChecks++;
      }
    }
  }
}

/* ภาพและเครื่องเดินของสูตรการไหล: เป้า 2 ผ่านไป N - 1 รอบ ทางเดินจึงครอบเป้า 2 ถึง N ซึ่งเป็นเป้าธรรมดาทั้งหมด */
const flowN0 = strongBoard(FX, FX_K);
const FLOW_I = 2;
const FLOW_T = FX.N - 1;
interface FlowOpt {
  j: number;
  straight: number;
  diag: number;
  total: number;
  targets: number[];
}
const flowOpts: FlowOpt[] = Array.from({ length: FLOW_T + 1 }, (_, j) => {
  const targets = Array.from({ length: j }, (_, q) => FLOW_I + q);
  const diag = targets.reduce((sum, t) => sum + flowN0[t], 0);
  return { j, straight: FLOW_T - j, diag, total: FLOW_T - j + diag, targets };
});
const flowBest = flowOpts.reduce((b, x) => (x.total < b.total ? x : b), flowOpts[0]);
const flowTies = flowOpts.filter((o) => o.total === flowBest.total).length;
const flowDirect = emittedDirect(flowN0, FLOW_I, FLOW_T);
if (flowBest.total !== flowDirect || flowBest.j === 0 || flowBest.j === FLOW_T || flowTies !== 1) {
  throw new Error('archery: ตัวอย่างประจำตอนที่ 6 ไม่ได้ให้ทางชนะที่ j ตรงกลางเพียงทางเดียว หรือสูตรไม่ตรงกับการนับ');
}
/** เป้าคนแข็งที่ใกล้เป้า FLOW_I ที่สุดทางขวา ใช้ในคำบรรยายของเครื่องเดิน */
const flowNear = flowN0.findIndex((v, i) => i >= FLOW_I && v >= 1);

/** เครื่องเดินของการไหล: แถวที่ t คือกระดานหลังผ่านไป t รอบ */
interface FlowFrame {
  t: number;
  board: number[];
  emit: boolean;
  F: number;
}
const flowFrames: FlowFrame[] = (() => {
  const out: FlowFrame[] = [];
  let b = flowN0.slice();
  let F = 0;
  for (let t = 0; t <= FLOW_T; t++) {
    const emit = t < FLOW_T && b[FLOW_I] >= 1;
    out.push({ t, board: b.slice(1), emit, F });
    if (t < FLOW_T) {
      F += emit ? 1 : 0;
      b = nextBoard(b);
    }
  }
  return out;
})();
if (flowFrames[flowFrames.length - 1].F !== flowBest.total) throw new Error('archery: เครื่องเดินการไหลจบไม่ตรงกับสูตร');
const flowNotes = flowFrames.map((f, idx) => {
  const here = f.board[FLOW_I - 1];
  let note: string;
  if (idx === 0) {
    note =
      `ก่อนเริ่ม เป้า ${FLOW_I} มีคนแข็ง ${here} คน ` +
      (f.emit
        ? 'จึงปล่อยออกหนึ่งคนในรอบแรกได้เลย'
        : `ยังไม่มีใครให้ปล่อย คนแข็งที่ใกล้ที่สุดอยู่เป้า ${flowNear} ต้องเดินมาอีก ${flowNear - FLOW_I} รอบ`);
  } else if (idx === flowFrames.length - 1) {
    note = `ครบ ${FLOW_T} รอบ เป้า ${FLOW_I} ปล่อยไปทั้งหมด <b>${f.F}</b> คน ตรงกับสูตรที่ให้ ${flowBest.total}`;
  } else if (idx === 1) {
    note =
      `ผ่านไป 1 รอบ ทุกเป้าที่มีคนแข็ง (ยกเว้นเป้า 1) ส่งออกไปทางซ้ายเป้าละหนึ่งคน ตอนนี้เป้า ${FLOW_I} มี ${here} คน ` +
      `ที่ออกไปแล้วรวม F = ${f.F}` +
      (f.emit ? ' รอบนี้ปล่อยได้อีกหนึ่ง' : ' รอบนี้ยังปล่อยไม่ได้');
  } else {
    note = `ผ่านไป ${f.t} รอบ · เป้า ${FLOW_I} มี ${here} คน · ${f.emit ? 'ปล่อย 1' : 'ไม่ปล่อย'} · F = ${f.F}`;
  }
  return { note };
});

/* ---------- ภาพสองเฟสในตอนที่ 7 ใช้กระดานเดียวกับตอนที่ 6 ---------- */
const phaseN0 = flowN0.slice(1);
/** เป้าซ้ายสุดที่มีคนแข็ง นับจาก 1 */
const phaseI0 = phaseN0.findIndex((v) => v >= 1) + 1;
const phaseOneLen = phaseI0 - 1;
if (phaseN0[0] !== 0 || phaseOneLen < 1) {
  throw new Error('ภาพสองเฟส: กระดานที่เลือกไม่ได้ทำให้เป้า 1 ว่างจากคนแข็ง ภาพจะเล่าเรื่องที่ไม่ตรงกับคำบรรยาย');
}

/* พิกัดของภาพสองเฟส เส้นเวลาเดียวแบ่งสองช่วง */
const PHW = 58;
const PHGAP = 9;
const phx = (i: number): number => 116 + (i - 1) * (PHW + PHGAP);
const PH_TOP = 74;
const phaseVB = `0 0 ${phx(FX.N) + PHW + 12} 262`;

/* พิกัดของภาพสูตร แถวบนคือ n(0) ของเป้า 2 ถึง N แถวล่างคือตัวเลือกของ j ทีละแถว */
const FLW = 58;
const FLGAP = 9;
const flx = (i: number): number => 96 + (i - FLOW_I) * (FLW + FLGAP);
const FL_TOP = 66;
const FL_ROW = 30;
/* ขอบซ้ายขวาวัดในเบราว์เซอร์ด้วย getBoundingClientRect ให้เหลือราว 12 หน่วยทั้งสองฝั่ง */
const FL_VB_X = 4;
const flowVB = `${FL_VB_X} 0 ${flx(FLOW_I + FLOW_T - 1) + FLW + 81 - FL_VB_X} ${FL_TOP + 44 + (FLOW_T + 1) * FL_ROW + 80}`;

/* ---------- u(k) ตำแหน่งที่คลี่วงออกเป็นเส้นตรง (ตอนที่ 8) ----------
   ทุกก้าวของเราเป็นก้าวซ้าย รวมถึงตอนแพ้ที่เป้า 1 ซึ่งคือก้าวจาก 1 ไป 0 บนเส้นที่คลี่ออก (0 กับ N คือเป้าเดียวกัน) */
interface UInfo {
  k: number;
  steps: number;
  u: number;
  f: number;
  block: number;
}
const blockOf = (u: number, N: number): number => Math.floor((u - 1) / N);
function uOf(cs: Case, k: number): UInfo {
  const fr = trace(cs, k, roundsFull(cs.N, cs.R));
  let steps = 0;
  for (let q = 0; q + 1 < fr.length; q++) if (fr[q + 1].pos !== fr[q].pos) steps++;
  const u = k - steps;
  const f = (((u - 1) % cs.N) + cs.N) % cs.N + 1;
  if (f !== fr[fr.length - 1].pos) throw new Error(`archery: u(${k}) แปลงกลับเป็นเป้าไม่ตรง`);
  return { k, steps, u, f, block: blockOf(u, cs.N) };
}
/** วิธีของโค้ดเต็ม: ผู้เข้าชิงคือ u ตัวเล็กสุดของแต่ละบล็อก เสมอกันเอา u มาก แล้วตอบ k มากสุดที่ u(k) ไม่เกินค่านั้น */
function viaCandidates(cs: Case): { cands: number[]; start: number } {
  const us = Array.from({ length: cs.N }, (_, i) => uOf(cs, i + 1));
  const cands = us.filter((x, i) => i === 0 || x.block !== us[i - 1].block).map((x) => x.u);
  let bestF = Infinity;
  let bestU = 0;
  for (const u of cands) {
    const f = (((u - 1) % cs.N) + cs.N) % cs.N + 1;
    if (f < bestF || (f === bestF && u > bestU)) {
      bestF = f;
      bestU = u;
    }
  }
  const start = Math.max(...us.filter((x) => x.u <= bestU).map((x) => x.k));
  return { cands, start };
}
/* ตรวจสองข้ออ้างของตอนที่ 8 กับการจำลองคนจริงครบ R รอบ (ไม่ใช้ท่าย่อเลย):
   u(k) ไม่ลด และวิธีผู้เข้าชิงให้คำตอบเดียวกับการลองทุกจุด */
let uChecks = 0;
for (const cs of [EX1, EX2, FX, ...AR_PUZZLES.map((p) => p.cs), ...RANDOM_CASES]) {
  let prev = -Infinity;
  let bestF = Infinity;
  let bestK = -1;
  for (let k = 1; k <= cs.N; k++) {
    const x = uOf(cs, k);
    if (x.u < prev) throw new Error(`archery: u(k) ลดลงที่ N=${cs.N} k=${k}`);
    prev = x.u;
    const real = simulateFull(cs, k, cs.R);
    if (real !== x.f) throw new Error(`archery: u(k) ให้เป้า ${x.f} แต่จำลองจริงได้ ${real}`);
    if (real <= bestF) {
      bestF = real;
      bestK = k;
    }
  }
  if (viaCandidates(cs).start !== bestK) throw new Error(`archery: วิธีผู้เข้าชิงตอบไม่ตรงกับการลองทุกจุดที่ N=${cs.N}`);
  uChecks++;
}
const uRows1 = Array.from({ length: EX1.N }, (_, i) => uOf(EX1, i + 1));
const cand1 = viaCandidates(EX1);
if (cand1.start !== ans1.start) throw new Error('archery: ตาราง u ของตัวอย่างที่ 1 ตอบไม่ตรง');
const uBlocks1 = new Set(uRows1.map((x) => x.block)).size;
const uCandRow1 = uRows1.map((x, i) => i === 0 || x.block !== uRows1[i - 1].block);

/** ภาพเส้นที่คลี่แล้วของ N = 4: ตำแหน่ง u แต่ละค่าตรงกับเป้าไหน และอยู่บล็อกไหน */
const unrollCells = Array.from({ length: 12 }, (_, q) => {
  const u = q - 3;
  return { u, target: (((u - 1) % EX1.N) + EX1.N) % EX1.N + 1, block: blockOf(u, EX1.N) };
});

/* ---------- ตัวอย่างประจำตอน: n(0) มาจากไหน ---------- */
const fxLine = lineFor(FX, FX_K);
const fxPairs = Array.from({ length: FX.N }, (_, i) => {
  const pair = [fxLine[2 * i], fxLine[2 * i + 1]].map((v) => (v === meOf(FX) ? 'เรา' : String(v)));
  return { target: i + 1, pair: pair.join(', '), strong: flowN0[i + 1] };
});

/* ---------- P กับ G ของตัวอย่างประจำตอน (ตอนที่ 6) ---------- */
const fxP = Array.from({ length: FX.N + 2 }, (_, y) => {
  let s = 0;
  for (let q = 1; q < y; q++) s += q <= FX.N ? flowN0[q] : 0;
  return s;
});
const fxG = fxP.map((p, y) => p - y);
const pgYs = Array.from({ length: FLOW_T + 1 }, (_, q) => FLOW_I + q);
const pgMin = Math.min(...pgYs.map((y) => fxG[y]));
const pgF = FLOW_T - fxP[FLOW_I] + FLOW_I + pgMin;
if (pgF !== flowBest.total) throw new Error('archery: สูตร P กับ G ให้ผลไม่ตรงกับตัวเลือก j');

/* ---------- จบเฟสแรกของตัวอย่างประจำตอน (ตอนที่ 7) ----------
   เฟสแรกเป้า 1 ยังไม่ปล่อยใคร จึงนับว่าเลยเป้า N ไปไม่มีคนแข็ง (ค่าเป็น 0) แล้วใช้สูตรเส้นตรงได้ทุกเป้า */
function emittedPadded(n0: number[], N: number, i: number, t: number): number {
  let best = Infinity;
  let sum = 0;
  for (let j = 0; j <= t; j++) {
    best = Math.min(best, t - j + sum);
    sum += i + j <= N ? n0[i + j] : 0;
  }
  return best;
}
const t1 = phaseOneLen;
const phaseF = Array.from({ length: FX.N + 2 }, (_, i) => (i >= 2 && i <= FX.N ? emittedPadded(flowN0, FX.N, i, t1) : 0));
const phaseEnd = Array.from({ length: FX.N }, (_, q) => {
  const i = q + 1;
  return flowN0[i] + (i < FX.N ? phaseF[i + 1] : 0) - phaseF[i];
});
const phaseEndDirect = (() => {
  let b = flowN0.slice();
  for (let q = 0; q < t1; q++) b = nextBoard(b);
  return b.slice(1);
})();
if (phaseEnd.join() !== phaseEndDirect.join() || phaseEnd[0] < 1) {
  throw new Error('archery: สภาพกระดานตอนจบเฟสแรกจากสูตรไม่ตรงกับการเดินกระดาน');
}
