/** เดินกระดานหนึ่งรอบ (คนจริงทุกคน) ใช้ตรวจว่าสภาวะคงตัวหน้าตาเป็นยังไง */
function stepBoard(N: number, t: number[][]): number[][] {
  const win = t.map((p) => Math.min(p[0], p[1]));
  const los = t.map((p) => Math.max(p[0], p[1]));
  const nt: number[][] = [];
  for (let i = 0; i < N; i++) {
    if (N === 1) nt.push([t[0][0], t[0][1]]);
    else if (i === 0) nt.push([win[0], win[1]]);
    else if (i < N - 1) nt.push([los[i], win[i + 1]]);
    else nt.push([los[N - 1], los[0]]);
  }
  return nt;
}

/** ใครขยับทุกรอบ ใครแข็งค้างอยู่กับที่ หลังระบบเข้าสภาวะคงตัวแล้ว */
function steadyRoles(cs: Case, k: number): { circulators: number[]; frozen: number[] } {
  const line = lineFor(cs, k);
  let t: number[][] = [];
  for (let i = 1; i <= cs.N; i++) t.push([line[2 * i - 2], line[2 * i - 1]]);
  for (let q = 0; q < 2 * cs.N; q++) t = stepBoard(cs.N, t);
  const posOf = (b: number[][]): Map<number, number> => {
    const m = new Map<number, number>();
    b.forEach((p, i) => p.forEach((a) => m.set(a, i + 1)));
    return m;
  };
  let prev = posOf(t);
  const moved = new Set<number>();
  for (let q = 0; q < cs.N; q++) {
    t = stepBoard(cs.N, t);
    const cur = posOf(t);
    for (const [a, p] of cur) if (prev.get(a) !== p) moved.add(a);
    prev = cur;
  }
  const all = Array.from({ length: 2 * cs.N }, (_, i) => i + 1);
  return { circulators: all.filter((a) => moved.has(a)), frozen: all.filter((a) => !moved.has(a)) };
}

/** สภาพกระดานจริงหลังเข้าสภาวะคงตัว คืนว่าใครอยู่เป้าไหน และคนคนนั้นวนหรือนิ่ง
 *  ต่างจาก steadyRoles() ที่บอกแค่ว่าใครวน ตัวนี้ต้องรู้ตำแหน่งเพื่อวาดภาพได้ */
interface SteadySeat {
  target: number;
  rank: number;
  moving: boolean;
}
function steadyBoard(cs: Case, k: number): SteadySeat[] {
  const line = lineFor(cs, k);
  let t: number[][] = [];
  for (let i = 1; i <= cs.N; i++) t.push([line[2 * i - 2], line[2 * i - 1]]);
  for (let q = 0; q < 2 * cs.N; q++) t = stepBoard(cs.N, t);
  const roles = steadyRoles(cs, k);
  const seats: SteadySeat[] = [];
  t.forEach((pair, i) => {
    for (const rank of [...pair].sort((a, b) => a - b)) {
      seats.push({ target: i + 1, rank, moving: roles.circulators.indexOf(rank) !== -1 });
    }
  });
  return seats;
}
const steady1 = steadyBoard(EX1, 1);
/** ลำดับที่จอดถาวรที่เป้า 1 ต้องเป็นลำดับ 1 ตามข้ออ้างของหัวข้อนี้ */
const parkedRank = Math.min(...steady1.filter((x) => x.target === 1).map((x) => x.rank));
const steadyClaim = parkedRank === 1;

const roles1 = steadyRoles(EX1, 1);
const roles2 = steadyRoles(EX2, 3);
/** ข้ออ้างที่ต้องตรวจ: คนที่หมุนคือลำดับ 2 ถึง N+1 พอดี ทั้งสองตัวอย่าง */
const rolesClaim =
  [
    [EX1, roles1] as const,
    [EX2, roles2] as const,
  ].every(
    ([cs, r]) =>
