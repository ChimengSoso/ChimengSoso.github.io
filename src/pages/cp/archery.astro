---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { mc, texCode } from '../../lib/math';

const href = 'archery/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ไม่มีเลขไหนพิมพ์ด้วยมือ ---------- */

/** ตัวอย่างหนึ่งชุด skills[0] คือเรา ที่เหลือคือคนอื่นเรียงจากซ้ายไปขวา */
type Case = { N: number; R: number; skills: number[] };

const EX1: Case = { N: 4, R: 8, skills: [7, 4, 2, 6, 5, 8, 1, 3] };
const EX2: Case = { N: 4, R: 9, skills: [2, 1, 5, 8, 3, 4, 7, 6] };

const meOf = (c: Case): number => c.skills[0];
const othersOf = (c: Case): number[] => c.skills.slice(1);

/* ---------- ท่าซื่อ ๆ จำลองคนจริงทุกคน ใช้ตรวจว่าท่าย่อไม่เพี้ยน ---------- */

/** เรียงคนทั้ง 2N คนเป็นแถว โดยเราแทรกตัวเองที่เป้า k */
function lineFor(c: Case, k: number): number[] {
  const o = othersOf(c);
  return [...o.slice(0, 2 * k - 2), meOf(c), ...o.slice(2 * k - 2)];
}

/** จำลองแบบตรงไปตรงมา คืนเป้าที่เราอยู่หลังผ่านไป rounds รอบ */
function simulateFull(c: Case, k: number, rounds: number): number {
  const line = lineFor(c, k);
  let t: number[][] = [];
  for (let i = 1; i <= c.N; i++) t.push([line[2 * i - 2], line[2 * i - 1]]);
  for (let q = 0; q < rounds; q++) {
    const win = t.map((p) => Math.min(p[0], p[1]));
    const los = t.map((p) => Math.max(p[0], p[1]));
    const nt: number[][] = [];
    for (let i = 0; i < c.N; i++) {
      if (c.N === 1) nt.push([t[0][0], t[0][1]]);
      else if (i === 0) nt.push([win[0], win[1]]);
      else if (i < c.N - 1) nt.push([los[i], win[i + 1]]);
      else nt.push([los[c.N - 1], los[0]]);
    }
    t = nt;
  }
  return t.findIndex((p) => p.includes(meOf(c))) + 1;
}

/* ---------- ท่าย่อ นับแค่ว่าช่องไหนมีคนที่เราไม่ชนะกี่คน ---------- */

/** c[i] = จำนวนคนที่เป้า i ซึ่งเราไม่ชนะ (เก่งกว่าเรา หรือคือตัวเราเอง) มีค่า 0, 1 หรือ 2 */
function boardFor(cs: Case, k: number): number[] {
  const o = othersOf(cs);
  const me = meOf(cs);
  const c = [0];
  for (let i = 1; i <= cs.N; i++) {
    const a = i < k ? o[2 * i - 2] : i === k ? o[2 * i - 2] : o[2 * i - 3];
    const b = i < k ? o[2 * i - 1] : i === k ? me : o[2 * i - 2];
    c.push((a <= me ? 1 : 0) + (b <= me ? 1 : 0));
  }
  return c;
}

/** กระดานรอบถัดไป: ทุกเป้าส่ง "ตัวที่แข็งกว่า" ออกไปทางซ้าย และเก็บ "ตัวที่อ่อนกว่า" ไว้ */
function nextBoard(c: number[]): number[] {
  const N = c.length - 1;
  if (N === 1) return c.slice();
  const n = [0];
  for (let i = 1; i <= N; i++) {
    if (i === 1) n.push((c[1] >= 1 ? 1 : 0) + (c[2] >= 1 ? 1 : 0));
    else if (i < N) n.push((c[i] === 2 ? 1 : 0) + (c[i + 1] >= 1 ? 1 : 0));
    else n.push((c[N] === 2 ? 1 : 0) + (c[1] === 2 ? 1 : 0));
  }
  return n;
}

type Frame = { round: number; board: number[]; pos: number; oppStrong: boolean };

/** เดินทีละรอบ คืนภาพกระดานก่อนรอบนั้น พร้อมตำแหน่งเราและชนิดของคู่แข่ง */
function trace(cs: Case, k: number, rounds: number): Frame[] {
  let c = boardFor(cs, k);
  let pos = k;
  const out: Frame[] = [];
  for (let q = 0; q < rounds; q++) {
    const oppStrong = c[pos] === 2;
    out.push({ round: q + 1, board: c.slice(), pos, oppStrong });
    pos = pos === 1 ? (oppStrong ? cs.N : 1) : oppStrong ? pos : pos - 1;
    c = nextBoard(c);
  }
  out.push({ round: rounds + 1, board: c.slice(), pos, oppStrong: c[pos] === 2 });
  return out;
}

/** จำนวนรอบที่ต้องเดินจริง หลัง 2N รอบระบบวนคาบ N จึงตัดส่วนเกินทิ้งได้ */
const roundsNeeded = (N: number, R: number): number => (R <= 3 * N ? R : 3 * N + ((R - 3 * N) % N));

function finalTarget(cs: Case, k: number): number {
  const T = roundsNeeded(cs.N, cs.R);
  const fr = trace(cs, k, T);
  return fr[fr.length - 1].pos;
}

type Answer = { finals: number[]; best: number; start: number };
function answerOf(cs: Case): Answer {
  const finals: number[] = [];
  let best = Infinity;
  let start = -1;
  for (let k = 1; k <= cs.N; k++) {
    const f = finalTarget(cs, k);
    finals.push(f);
    if (f < best) { best = f; start = k; }
    else if (f === best) start = k;
  }
  return { finals, best, start };
}

const ans1 = answerOf(EX1);
const ans2 = answerOf(EX2);

/** ตรวจว่าท่าย่อให้ผลเดียวกับการจำลองคนจริง ถ้าไม่ตรงจะโผล่ในตารางทันที */
const crossCheck = [EX1, EX2].every((cs) =>
  Array.from({ length: cs.N }, (_, i) => i + 1).every(
    (k) => finalTarget(cs, k) === simulateFull(cs, k, roundsNeeded(cs.N, cs.R)),
  ),
);

/* ---------- ตารางเดินกระดานทีละรอบ ---------- */

const DEMO = EX2;
const DEMO_K = ans2.start;
const demoFrames = trace(DEMO, DEMO_K, roundsNeeded(DEMO.N, DEMO.R));
const demoBetter = DEMO.skills.filter((s) => s <= meOf(DEMO)).length;
const demoWins = demoFrames.slice(0, -1).filter((f) => !f.oppStrong).length;
const demoLosses = demoFrames.length - 1 - demoWins;
const demoEnd = demoFrames[demoFrames.length - 1].pos;

/* ---------- ตัวเลขของขนาดปัญหา ---------- */

const N_MAX = 200000;
const R_MAX = 1000000000;
const SUB60 = 5000;
const SUB20 = 200;

const fmt = (n: number): string => n.toLocaleString('en-US');

/** เวลาที่วัดได้จริงบนเครื่องผมกับอินพุตสุ่มเต็มขอบเขต R */
const timing = [
  { n: 200, ms: 34 },
  { n: 500, ms: 216 },
  { n: 800, ms: 828 },
  { n: 1200, ms: 2273 },
];

/* ---------- สูตร ---------- */

const texBoard = texCode(
  `\\begin{aligned}
${mc.fn("c'")}[${mc.num('1')}] &${mc.op('=')} [\\,${mc.fn('c')}[${mc.num('1')}] ${mc.op('\\ge')} ${mc.num('1')}\\,] ${mc.op('+')} [\\,${mc.fn('c')}[${mc.num('2')}] ${mc.op('\\ge')} ${mc.num('1')}\\,] \\\\[4pt]
${mc.fn("c'")}[i] &${mc.op('=')} [\\,${mc.fn('c')}[i] ${mc.op('=')} ${mc.num('2')}\\,] ${mc.op('+')} [\\,${mc.fn('c')}[i ${mc.op('+')} ${mc.num('1')}] ${mc.op('\\ge')} ${mc.num('1')}\\,] \\\\[4pt]
${mc.fn("c'")}[N] &${mc.op('=')} [\\,${mc.fn('c')}[N] ${mc.op('=')} ${mc.num('2')}\\,] ${mc.op('+')} [\\,${mc.fn('c')}[${mc.num('1')}] ${mc.op('=')} ${mc.num('2')}\\,]
\\end{aligned}`,
);

const texRounds = texCode(
  `${mc.fn('T')} ${mc.op('=')} ${mc.num('3')}N ${mc.op('+')} \\big((R ${mc.op('-')} ${mc.num('3')}N) \\bmod N\\big)`,
);

/* ---------- โค้ด ---------- */

const solution = `#include <bits/stdc++.h>
using namespace std;

int main() {
    long long N, R;
    scanf("%lld %lld", &N, &R);
    vector<int> s(2 * N);
    for (int i = 0; i < 2 * N; i++) scanf("%d", &s[i]);
    int me = s[0];
    vector<int> o(s.begin() + 1, s.end());     // คนอื่น 2N-1 คน เรียงจากซ้ายไปขวา

    // หลัง 2N รอบระบบวนคาบ N ส่วนที่เกินจึงตัดทิ้งได้ เดินจริงไม่เกิน 4N รอบ
    long long T = (R <= 3 * N) ? R : 3 * N + ((R - 3 * N) % N);

    vector<int> c(N + 2), nc(N + 2);
    long long bestFinal = LLONG_MAX, bestStart = -1;

    for (long long k = 1; k <= N; k++) {
        // แทรกตัวเองที่เป้า k แล้วคนอื่นจับคู่กันตามลำดับเดิม
        for (long long i = 1; i <= N; i++) {
            int a, b;
            if (i < k)       { a = o[2 * i - 2]; b = o[2 * i - 1]; }
            else if (i == k) { a = o[2 * i - 2]; b = me; }
            else             { a = o[2 * i - 3]; b = o[2 * i - 2]; }
            c[i] = (a <= me) + (b <= me);      // นับคนที่เราไม่ชนะ (รวมตัวเราเอง)
        }

        long long pos = k;
        for (long long q = 0; q < T; q++) {
            // เราคือคนที่อ่อนที่สุดในกลุ่ม "ไม่แพ้ให้เรา" คู่แข่งจึงแข็งกว่าเรา
            // ก็ต่อเมื่อช่องนี้มีคนกลุ่มนั้นอยู่สองคน คือเรากับอีกคนหนึ่ง
            bool oppStrong = (c[pos] == 2);
            if (pos == 1) pos = oppStrong ? N : 1;   // แพ้ที่เป้า 1 คือถูกส่งไปท้ายแถว
            else if (!oppStrong) pos--;              // ชนะที่เป้าอื่นคือขยับไปทางซ้าย

            for (long long i = 1; i <= N; i++) {
                if (i == 1)      nc[1] = (c[1] >= 1) + (N >= 2 ? (c[2] >= 1) : 0);
                else if (i < N)  nc[i] = (c[i] == 2) + (c[i + 1] >= 1);
                else             nc[N] = (c[N] == 2) + (c[1] == 2);
            }
            if (N == 1) nc[1] = c[1];
            swap(c, nc);
        }

        if (pos < bestFinal) { bestFinal = pos; bestStart = k; }
        else if (pos == bestFinal) bestStart = k;    // เสมอกันเลือกเป้าเริ่มต้นที่มากที่สุด
    }

    printf("%lld\\n", bestStart);
    return 0;
}`;

const bruteCode = `// ตัวตรวจสอบแบบซื่อ ๆ จำลองคนจริงทุกคนครบ R รอบ ใช้ได้แค่ N เล็ก ๆ กับ R ไม่กี่ร้อย
// เอาไว้สุ่มเทียบกับโค้ดจริงก่อนส่ง ไม่ใช่โค้ดที่ส่งเข้าระบบตัดสิน
#include <bits/stdc++.h>
using namespace std;

int N; long long R;
int me;
vector<int> o;

int simulate(int k, long long rounds) {
    vector<int> line;
    for (int i = 0; i < 2 * k - 2; i++) line.push_back(o[i]);
    line.push_back(me);
    for (int i = 2 * k - 2; i < (int)o.size(); i++) line.push_back(o[i]);

    vector<array<int, 2>> t(N + 1);
    for (int i = 1; i <= N; i++) { t[i][0] = line[2 * i - 2]; t[i][1] = line[2 * i - 1]; }

    for (long long q = 0; q < rounds; q++) {
        vector<int> win(N + 1), los(N + 1);
        for (int i = 1; i <= N; i++) {
            win[i] = min(t[i][0], t[i][1]);       // เลขลำดับน้อยกว่าคือเก่งกว่า
            los[i] = max(t[i][0], t[i][1]);
        }
        vector<array<int, 2>> nt(N + 1);
        for (int i = 1; i <= N; i++) {
            if (i == 1)      nt[i] = {win[1], N >= 2 ? win[2] : los[1]};
            else if (i < N)  nt[i] = {los[i], win[i + 1]};
            else             nt[i] = {los[N], los[1]};
        }
        if (N == 1) nt[1] = t[1];
        t = nt;
    }
    for (int i = 1; i <= N; i++) if (t[i][0] == me || t[i][1] == me) return i;
    return -1;
}

int main() {
    scanf("%d %lld", &N, &R);
    scanf("%d", &me);
    o.resize(2 * N - 1);
    for (int i = 0; i < 2 * N - 1; i++) scanf("%d", &o[i]);

    int best = INT_MAX, bestK = -1;
    for (int k = 1; k <= N; k++) {
        int f = simulate(k, R);
        if (f < best) { best = f; bestK = k; }
        else if (f == best) bestK = k;
    }
    printf("%d\\n", bestK);
}`;

const coreLine = `bool oppStrong = (c[pos] == 2);
if (pos == 1) pos = oppStrong ? N : 1;   // แพ้ที่เป้า 1 คือถูกส่งไปท้ายแถว
else if (!oppStrong) pos--;              // ชนะที่เป้าอื่นคือขยับไปทางซ้าย`;
