---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { texCode, mc } from '../../lib/math';

const href = 'knuth-optimization/';

/* ============================================================================
   ตัวเลขทุกตัวในหน้านี้งอกจากโมเดลข้างล่าง ไม่มีเลขไหนพิมพ์ด้วยมือ
   และมี throw กันไว้ทุกข้ออ้าง ถ้าข้ออ้างไหนไม่จริง หน้านี้จะบิลด์ไม่ผ่านเลย
   ========================================================================== */

const INF = Number.POSITIVE_INFINITY;
type CostFn = (i: number, j: number) => number;

type DpResult = { dp: number[][]; opt: number[][]; scans: number };

/** DP บนช่วงแบบไล่จุดตัดทุกจุด O(n^3) นี่คือความจริงที่ทุกอย่างต้องตรงกับมัน */
function cubicDp(n: number, C: CostFn): DpResult {
  const dp: number[][] = Array.from({ length: n + 2 }, () => Array<number>(n + 2).fill(0));
  const opt: number[][] = Array.from({ length: n + 2 }, () => Array<number>(n + 2).fill(0));
  let scans = 0;
  for (let i = 1; i <= n; i++) opt[i][i] = i;
  for (let len = 2; len <= n; len++) {
    for (let i = 1; i + len - 1 <= n; i++) {
      const j = i + len - 1;
      let best = INF;
      let bk = i;
      for (let k = i; k < j; k++) {
        scans++;
        const v = dp[i][k] + dp[k + 1][j] + C(i, j);
        if (v < best) {
          best = v;
          bk = k;
        }
      }
      dp[i][j] = best;
      opt[i][j] = bk;
    }
  }
  return { dp, opt, scans };
}

/** ท่าเดียวกัน แต่ลูปในสุดส่องแค่หน้าต่าง [opt(i,j-1), opt(i+1,j)] */
function knuthDp(n: number, C: CostFn): DpResult {
  const dp: number[][] = Array.from({ length: n + 2 }, () => Array<number>(n + 2).fill(0));
  const opt: number[][] = Array.from({ length: n + 2 }, () => Array<number>(n + 2).fill(0));
  let scans = 0;
  for (let i = 1; i <= n; i++) opt[i][i] = i;
  for (let len = 2; len <= n; len++) {
    for (let i = 1; i + len - 1 <= n; i++) {
      const j = i + len - 1;
      const lo = Math.max(opt[i][j - 1], i);
      const hi = Math.min(opt[i + 1][j], j - 1);
      let best = INF;
      let bk = lo;
      for (let k = lo; k <= hi; k++) {
        scans++;
        const v = dp[i][k] + dp[k + 1][j] + C(i, j);
        if (v < best) {
          best = v;
          bk = k;
        }
      }
      dp[i][j] = best;
      opt[i][j] = bk;
    }
  }
  return { dp, opt, scans };
}

/** ต้นทุนแบบ "ผลรวมของช่วง" ซึ่งเป็นรูปที่โจทย์ตัดไม้กับหักสตริงใช้ */
function sumCost(gaps: number[]): CostFn {
  const pre = [0];
  for (const g of gaps) pre.push(pre[pre.length - 1] + g);
  return (i, j) => pre[j] - pre[i - 1];
}

/** ไล่ "ลำดับการตัด" ทุกแบบจริง ๆ ไม่ใช้ดีพีและไม่ใช้ข้ออ้างเรื่อง opt เลย
 *  นี่คือตัวตรวจที่อิสระจากทุกอย่างที่บทนี้กำลังจะอ้าง */
function bestByCutOrder(gaps: number[]): number {
  const n = gaps.length;
  const pre = [0];
  for (const g of gaps) pre.push(pre[pre.length - 1] + g);
  const span = (l: number, r: number): number => pre[r] - pre[l - 1];
  const seen = new Map<string, number>();
  const go = (pieces: [number, number][]): number => {
    const live = pieces.filter((p) => p[1] > p[0]);
    if (live.length === 0) return 0;
    const key = live
      .slice()
      .sort((a, b) => a[0] - b[0])
      .map((p) => p[0] + ':' + p[1])
      .join(',');
    const hit = seen.get(key);
    if (hit !== undefined) return hit;
    let best = INF;
    for (let idx = 0; idx < live.length; idx++) {
      const [l, r] = live[idx];
      const price = span(l, r);
      for (let c = l; c < r; c++) {
        const rest = live.filter((_, t) => t !== idx);
        const v = price + go([...rest, [l, c], [c + 1, r]]);
        if (v < best) best = v;
      }
    }
    seen.set(key, best);
    return best;
  };
  return n <= 1 ? 0 : go([[1, n]]);
}

/** แปลงไม้ยาว L ที่มีรอยกา cuts ให้เป็นความยาวของช่องว่างระหว่างรอยกา */
function gapsOf(L: number, cuts: number[]): number[] {
  const out: number[] = [];
  let p = 0;
  for (const c of cuts) {
    out.push(c - p);
    p = c;
  }
  out.push(L - p);
  return out;
}

/* ---------- ไม้ต้นที่บทนี้เดินให้ดูทั้งบท: ยาว 10 มีรอยกาสี่รอย ---------- */
const RUN_L = 10;
const RUN_CUTS = [4, 5, 7, 8];
const RUN_GAPS = gapsOf(RUN_L, RUN_CUTS);
const RN = RUN_GAPS.length;
const runCost = sumCost(RUN_GAPS);
const runCubic = cubicDp(RN, runCost);
const runKnuth = knuthDp(RN, runCost);
const runAnswer = runCubic.dp[1][RN];
const runByOrder = bestByCutOrder(RUN_GAPS);
if (runKnuth.dp[1][RN] !== runAnswer || runByOrder !== runAnswer) {
  throw new Error(
    `knuth-optimization: ไม้ตัวอย่างไม่ตรงกัน ไล่จุดตัดทุกจุด ${runAnswer} หน้าต่าง Knuth ${runKnuth.dp[1][RN]} ไล่ลำดับตัดทุกแบบ ${runByOrder}`,
  );
}

/** ข้ออ้างของ Knuth บนไม้ต้นนี้ ตรวจทุกช่องจริง ไม่ได้เชื่อตามตำรา */
type MonoCheck = { i: number; j: number; left: number; here: number; below: number };
const runMono: MonoCheck[] = [];
for (let len = 2; len <= RN; len++) {
  for (let i = 1; i + len - 1 <= RN; i++) {
    const j = i + len - 1;
    const row = { i, j, left: runCubic.opt[i][j - 1], here: runCubic.opt[i][j], below: runCubic.opt[i + 1][j] };
    if (row.left > row.here || row.here > row.below) {
      throw new Error(`knuth-optimization: ข้ออ้างพังที่ช่อง (${i},${j}) คือ ${row.left} ${row.here} ${row.below}`);
    }
    runMono.push(row);
  }
}

/* ---------- ตารางเทียบจำนวนครั้งที่ต้องส่อง ---------- */
const runSaving = runCubic.scans - runKnuth.scans;

/* ---------- ช่องที่เอาไปวาดภาพสะพาน เลือกช่องที่ประหยัดได้มากที่สุด ---------- */
const bridgeCell = runMono.reduce((best, r) => {
  const gain = (r.j - 1 - r.i + 1) - (Math.min(r.below, r.j - 1) - Math.max(r.left, r.i) + 1);
  const bestGain = (best.j - 1 - best.i + 1) - (Math.min(best.below, best.j - 1) - Math.max(best.left, best.i) + 1);
  return gain > bestGain ? r : best;
});
const bridgeLo = Math.max(bridgeCell.left, bridgeCell.i);
const bridgeHi = Math.min(bridgeCell.below, bridgeCell.j - 1);
const bridgeFull = bridgeCell.j - 1 - bridgeCell.i + 1;
const bridgeWindow = bridgeHi - bridgeLo + 1;

/* ตัวเปรียบเทียบ < และ <= ที่เขียนในเทมเพลต ทำให้ตัวแปลของ Astro อ่านเป็นแท็ก JSX แล้วพัง
   ทุกการเทียบจึงคิดไว้ที่นี่ แล้วเทมเพลตอ่านแค่ค่าที่คิดเสร็จแล้ว */
const runOptGrid: (number | null)[][] = Array.from({ length: RN }, (_, r) =>
  Array.from({ length: RN }, (_, c) => (c < r ? null : runCubic.opt[r + 1][c + 1])),
);
type BoardCell = { i: number; j: number; kind: 'blank' | 'zero' | 'later'; v: string };
const runBoard: BoardCell[][] = Array.from({ length: RN }, (_, r) =>
  Array.from({ length: RN }, (_, c) => {
    const i = r + 1;
    const j = c + 1;
    if (c < r) return { i, j, kind: 'blank' as const, v: '' };
    if (c === r) return { i, j, kind: 'zero' as const, v: '0' };
    return { i, j, kind: 'later' as const, v: String(runCubic.dp[i][j]) };
  }),
);
/* แถบจุดตัดของภาพสะพาน เก็บเฉพาะ k ที่อยู่ในช่วงเต็ม พร้อมธงว่าอยู่ในหน้าต่างไหม */
const d2Bar = Array.from({ length: bridgeFull }, (_, t) => {
  const k = bridgeCell.i + t;
  return { k, inWin: k >= bridgeLo && k <= bridgeHi };
});

/* ---------- ไม้ต้นที่สองสำหรับภาพเรื่องผลรวมงานทั้งเส้นทแยง ---------- */
const TEL_GAPS = [3, 1, 4, 1, 5, 9, 2, 6, 5];
const TN = TEL_GAPS.length;
const telCost = sumCost(TEL_GAPS);
const telCubic = cubicDp(TN, telCost);
const telKnuth = knuthDp(TN, telCost);
if (telCubic.dp[1][TN] !== telKnuth.dp[1][TN]) {
  throw new Error('knuth-optimization: ไม้ต้นที่สองตอบไม่ตรงกัน');
}
/** เส้นทแยงที่ยาวพอจะเห็นว่าขอบทั้งสองข้างขยับไปทางขวาอย่างเดียว */
const TEL_LEN = 5;
const telBars = Array.from({ length: TN - TEL_LEN + 1 }, (_, t) => {
  const i = t + 1;
  const j = i + TEL_LEN - 1;
  return {
    i,
    j,
    lo: Math.max(telCubic.opt[i][j - 1], i),
    hi: Math.min(telCubic.opt[i + 1][j], j - 1),
    full: j - 1 - i + 1,
  };
});
const telBarWork = telBars.reduce((s, b) => s + (b.hi - b.lo + 1), 0);
const telBarFull = telBars.reduce((s, b) => s + b.full, 0);
const telSpan = telBars[telBars.length - 1].hi - telBars[0].lo + 1;
const telBound = telSpan + telBars.length;
if (telBarWork > telBound) {
  throw new Error('knuth-optimization: ผลรวมงานของเส้นทแยงเกินเพดานที่บทนี้อ้างไว้');
}
/** ขอบทั้งสองข้างต้องไม่ถอยหลังเลย ไม่งั้นเหตุผลเรื่องเพดานใช้ไม่ได้ */
for (let t = 1; t < telBars.length; t++) {
  if (telBars[t].lo < telBars[t - 1].lo || telBars[t].hi < telBars[t - 1].hi) {
    throw new Error('knuth-optimization: ขอบของหน้าต่างในเส้นทแยงเดียวกันถอยหลัง');
  }
}

/* ---------- สเต็ปของเครื่องเดิน: เติมตารางไล่ตามความยาวช่วง ---------- */
type KnStep = {
  note: string;
  i: number;
  j: number;
  lo: number;
  hi: number;
  pick: number;
  filled: string[];
};
const knSteps: KnStep[] = [];
{
  const filled: string[] = [];
  for (let len = 2; len <= RN; len++) {
    for (let i = 1; i + len - 1 <= RN; i++) {
      const j = i + len - 1;
      const lo = Math.max(runCubic.opt[i][j - 1], i);
      const hi = Math.min(runCubic.opt[i + 1][j], j - 1);
      filled.push(`${i}-${j}`);
      const full = j - 1 - i + 1;
      const win = hi - lo + 1;
      const saved =
        win === full
          ? 'รอบนี้หน้าต่างกว้างเท่าช่วงเต็มพอดี จึงไม่ได้ประหยัดอะไร ซึ่งเกิดได้และไม่ใช่เรื่องผิด'
          : 'ส่องแค่ <em>' + win + '</em> ช่อง แทนที่จะเป็น ' + full + ' ช่อง';
      knSteps.push({
        note:
          'ช่องที่กำลังเติมคือ <b>[' +
          i +
          '..' +
          j +
          ']</b> เพื่อนบ้านสองช่องที่เติมไปแล้วบอกขอบให้ คือ <b>opt[' +
          i +
          '][' +
          (j - 1) +
          '] = ' +
          runCubic.opt[i][j - 1] +
          '</b> ทางซ้าย และ <b>opt[' +
          (i + 1) +
          '][' +
          j +
          '] = ' +
          runCubic.opt[i + 1][j] +
          '</b> ข้างล่าง จุดตัดจึงอยู่ใน <em>' +
          lo +
          '..' +
          hi +
          '</em> ' +
          saved +
          ' ผลคือตัดที่ <b>' +
          runCubic.opt[i][j] +
          '</b> ได้ค่า <b>' +
          runCubic.dp[i][j] +
          '</b>',
        i,
        j,
        lo,
        hi,
        pick: runCubic.opt[i][j],
        filled: [...filled],
      });
    }
  }
}

/* ---------- มินิเกม: เลือกลำดับตัดไม้เอง ----------
   คำตอบของทุกชุดมาจากการไล่ลำดับการตัดทุกแบบ ไม่ได้มาจากดีพีที่บทนี้กำลังสอน
   แล้วยังเทียบกับดีพีอีกชั้นก่อนปล่อยขึ้นหน้า */
type KnSeed = { id: string; label: string; tease: string; L: number; cuts: number[] };
const KN_SEEDS: KnSeed[] = [
  {
    id: 'k1',
    label: 'ชุดที่ 1 · ไม้ที่แบ่งเท่ากันหมด',
    tease: 'ไม้ยาว 100 มีรอยกาสามรอยที่แบ่งเท่า ๆ กัน ชุดนี้ตัดยังไงก็ได้เท่ากันหลายทาง ใช้ชินกับกติกาก่อน',
    L: 100,
    cuts: [25, 50, 75],
  },
  {
    id: 'k2',
    label: 'ชุดที่ 2 · ชุดที่บทนี้เดินให้ดู',
    tease: 'ไม้ยาว 10 รอยกาที่ 4, 5, 7, 8 ชุดเดียวกับตารางที่จะเดินให้ดูทีหลัง จำคำตอบไว้แล้วไปเทียบกันได้',
    L: 10,
    cuts: [4, 5, 7, 8],
  },
  {
    id: 'k3',
    label: 'ชุดที่ 3 · กับดักของการตัดจากซ้ายไปขวา',
    tease: 'ไม้ยาว 30 รอยกาห้ารอยที่วางไม่สม่ำเสมอ ชุดนี้ลงโทษคนที่ไล่ตัดเรียงจากรอยซ้ายสุด',
    L: 30,
    cuts: [2, 4, 6, 20, 26],
  },
];

type KnPuzzle = KnSeed & { gaps: number[]; best: number };
const knPuzzles: KnPuzzle[] = KN_SEEDS.map((s) => {
  const gaps = gapsOf(s.L, s.cuts);
  const byOrder = bestByCutOrder(gaps);
  const viaCubic = cubicDp(gaps.length, sumCost(gaps)).dp[1][gaps.length];
  const viaKnuth = knuthDp(gaps.length, sumCost(gaps)).dp[1][gaps.length];
  if (byOrder !== viaCubic || viaCubic !== viaKnuth) {
    throw new Error(
      `มินิเกมของ knuth-optimization: ชุด ${s.id} ไล่ลำดับตัดได้ ${byOrder} ดีพีได้ ${viaCubic} หน้าต่างได้ ${viaKnuth}`,
    );
  }
  return { ...s, gaps, best: byOrder };
});

/** กฎที่คนคิดออกก่อนเสมอ คือไล่ตัดจากรอยกาซ้ายสุดไปขวาสุด */
function leftToRightCost(gaps: number[]): number {
  const pre = [0];
  for (const g of gaps) pre.push(pre[pre.length - 1] + g);
  let sum = 0;
  for (let t = 1; t < gaps.length; t++) {
    // ตัดที่รอยกาที่ t ตอนนี้ชิ้นที่ยังไม่ถูกตัดคือ t..n
    sum += pre[gaps.length] - pre[t - 1];
  }
  return sum;
}
const trapSeed = knPuzzles[2];
const trapLeft = leftToRightCost(trapSeed.gaps);
if (trapLeft <= trapSeed.best) {
  throw new Error(
    `knuth-optimization: ชุดที่ 3 ควรหักกฎตัดจากซ้ายไปขวา แต่กฎนั้นได้ ${trapLeft} ส่วนคำตอบจริง ${trapSeed.best}`,
  );
}

const knJson = JSON.stringify(
  knPuzzles.map((p) => ({ id: p.id, label: p.label, tease: p.tease, L: p.L, gaps: p.gaps, best: p.best })),
);

/* ---------- ตัวอย่างค้าน: ตารางค่าใช้จ่ายที่ทำให้ Knuth ตอบผิด ----------
   ตารางนี้หามาจากการสุ่มตารางเล็ก ๆ แล้วเทียบกับ O(n^3) จนเจอตัวแรกที่ไม่ตรงกัน
   ค่าที่ไม่ใช่ศูนย์มีแค่สองช่อง ซึ่งเป็นตัวค้านที่เล็กที่สุดเท่าที่หาเจอ */
const CE_N = 4;
const CE_TABLE: Record<string, number> = { '1,2': 1, '2,4': 1 };
const ceCost: CostFn = (i, j) => CE_TABLE[`${i},${j}`] ?? 0;
const ceTruth = cubicDp(CE_N, ceCost).dp[1][CE_N];
const ceGot = knuthDp(CE_N, ceCost).dp[1][CE_N];
if (ceGot === ceTruth) {
  throw new Error('knuth-optimization: ตัวอย่างค้านไม่ค้านแล้ว หน้าต่าง Knuth ดันตอบถูก');
}
/** ช่องที่ดีพีอ่านจริงมีแค่ i<j เท่านั้น ตัวค้านจึงต้องพังที่ช่องพวกนั้น */
function firstQiBreak(n: number, C: CostFn): { a: number; b: number; c: number; d: number } | null {
  for (let a = 1; a <= n; a++)
    for (let b = a; b <= n; b++)
      for (let c = b; c <= n; c++)
        for (let d = c; d <= n; d++) if (C(a, c) + C(b, d) > C(a, d) + C(b, c)) return { a, b, c, d };
  return null;
}
function firstMonoBreak(n: number, C: CostFn): { a: number; b: number; c: number; d: number } | null {
  for (let a = 1; a <= n; a++)
    for (let b = a; b <= n; b++)
      for (let c = b; c <= n; c++)
        for (let d = c; d <= n; d++) if (C(b, c) > C(a, d)) return { a, b, c, d };
  return null;
}
const ceQi = firstQiBreak(CE_N, ceCost);
const ceMono = firstMonoBreak(CE_N, ceCost);
if (ceQi === null || ceMono === null) {
  throw new Error('knuth-optimization: ตัวอย่างค้านควรทำให้เงื่อนไขทั้งสองข้อพัง');
}
/** ค่าใช้จ่ายแบบผลรวมของช่วงต้องผ่านทั้งสองเงื่อนไข ไม่งั้นทั้งบทนี้ผิด */
if (firstQiBreak(RN, runCost) !== null || firstMonoBreak(RN, runCost) !== null) {
  throw new Error('knuth-optimization: ค่าใช้จ่ายแบบผลรวมของช่วงควรผ่านทั้งสองเงื่อนไข');
}
/** แถว opt ของตัวค้าน ใช้โชว์ว่ามันถอยหลังจริง */
const ceOptRows = (() => {
  const { opt } = cubicDp(CE_N, ceCost);
  const rows: { i: number; cells: { j: number; v: number | null }[] }[] = [];
  for (let i = 1; i <= CE_N; i++) {
    rows.push({
      i,
      cells: Array.from({ length: CE_N }, (_, t) => {
        const j = t + 1;
        return { j, v: j >= i ? opt[i][j] : null };
      }),
    });
  }
  return rows;
})();
/** ช่องแรกที่ opt ถอยหลัง คือเหตุผลตรง ๆ ว่าทำไมหน้าต่างถึงพลาดคำตอบ */
const ceBackStep = (() => {
