const P3_N = P3_FREQ.length;
const p3pre = [0];
for (const f of P3_FREQ) p3pre.push(p3pre[p3pre.length - 1] + f);
const p3Sum = (i: number, j: number): number => (i > j ? 0 : p3pre[j] - p3pre[i - 1]);
/** g[i][j] = ค่าน้อยสุดของช่วง i..j เมื่อรากของช่วงนั้นนับเป็นชั้นที่ 1 */
type ObstResult = { g: number[][]; opt: number[][]; scans: number };
function obstCubic(n: number, S: (i: number, j: number) => number, f: number[]): ObstResult {
  const g: number[][] = Array.from({ length: n + 3 }, () => Array<number>(n + 3).fill(0));
  const opt: number[][] = Array.from({ length: n + 3 }, () => Array<number>(n + 3).fill(0));
  let scans = 0;
  for (let i = 1; i <= n; i++) {
    g[i][i] = f[i - 1];
    opt[i][i] = i;
  }
  for (let len = 2; len <= n; len++)
    for (let i = 1; i + len - 1 <= n; i++) {
      const j = i + len - 1;
      let best = INF;
      let bk = i;
      for (let k = i; k <= j; k++) {
        scans++;
        const v = (k > i ? g[i][k - 1] : 0) + (k < j ? g[k + 1][j] : 0) + S(i, j);
        if (v < best) {
          best = v;
          bk = k;
        }
      }
      g[i][j] = best;
      opt[i][j] = bk;
    }
  return { g, opt, scans };
}
function obstKnuth(n: number, S: (i: number, j: number) => number, f: number[]): ObstResult {
  const g: number[][] = Array.from({ length: n + 3 }, () => Array<number>(n + 3).fill(0));
  const opt: number[][] = Array.from({ length: n + 3 }, () => Array<number>(n + 3).fill(0));
  let scans = 0;
  for (let i = 1; i <= n; i++) {
    g[i][i] = f[i - 1];
    opt[i][i] = i;
  }
  for (let len = 2; len <= n; len++)
    for (let i = 1; i + len - 1 <= n; i++) {
      const j = i + len - 1;
      const lo = Math.max(opt[i][j - 1], i);
      const hi = Math.min(opt[i + 1][j], j);
      let best = INF;
      let bk = lo;
      for (let k = lo; k <= hi; k++) {
        scans++;
        const v = (k > i ? g[i][k - 1] : 0) + (k < j ? g[k + 1][j] : 0) + S(i, j);
        if (v < best) {
          best = v;
          bk = k;
        }
      }
      g[i][j] = best;
      opt[i][j] = bk;
    }
  return { g, opt, scans };
}
/** ไล่ทุกทรงของต้นไม้จริง ๆ ไม่มีตารางจำ คิดจากนิยาม ผลรวมของ ความถี่ คูณ ชั้น */
function bestByEveryTree(f: number[]): number {
  const rec = (i: number, j: number, depth: number): number => {
    if (i > j) return 0;
    let best = INF;
    for (let k = i; k <= j; k++) {
      const v = depth * f[k - 1] + rec(i, k - 1, depth + 1) + rec(k + 1, j, depth + 1);
      if (v < best) best = v;
    }
    return best;
  };
  return rec(1, f.length, 1);
}
const p3Cubic = obstCubic(P3_N, p3Sum, P3_FREQ);
const p3Knuth = obstKnuth(P3_N, p3Sum, P3_FREQ);
const p3ByTree = bestByEveryTree(P3_FREQ);
const p3Answer = p3Cubic.g[1][P3_N];
