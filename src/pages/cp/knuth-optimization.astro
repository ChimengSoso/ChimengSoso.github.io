  );
}
/** ต้นไม้ที่ดีที่สุด อ่านออกมาจากตาราง opt แล้ววางพิกัดให้วาดได้ */
type ObstNode = { key: string; freq: number; idx: number; depth: number; x: number; parent: number; id: number };
const p3Nodes: ObstNode[] = [];
{
  let slot = 0;
  const build = (i: number, j: number, depth: number, parent: number): void => {
    if (i > j) return;
    const k = p3Cubic.opt[i][j];
    const id = p3Nodes.length;
    const node: ObstNode = { key: P3_KEYS[k - 1], freq: P3_FREQ[k - 1], idx: k, depth, x: 0, parent, id };
    p3Nodes.push(node);
    build(i, k - 1, depth + 1, id);
    node.x = slot;
    slot++;
    build(k + 1, j, depth + 1, id);
  };
  build(1, P3_N, 1, -1);
}
const p3Check = p3Nodes.reduce((s, nd) => s + nd.freq * nd.depth, 0);
if (p3Check !== p3Answer) throw new Error('knuth-optimization: ต้นไม้ที่วาดรวมได้ไม่ตรงคำตอบ');
/** ทรงที่คนเดาก่อนเสมอ คือเอาตัวที่ความถี่สูงสุดขึ้นเป็นรากแล้วทำแบบเดียวกันต่อ */
function greedyRootTree(f: number[]): number {
  const rec = (i: number, j: number, depth: number): number => {
    if (i > j) return 0;
    let k = i;
    for (let t = i; t <= j; t++) if (f[t - 1] > f[k - 1]) k = t;
    return depth * f[k - 1] + rec(i, k - 1, depth + 1) + rec(k + 1, j, depth + 1);
  };
  return rec(1, f.length, 1);
}
const p3Greedy = greedyRootTree(P3_FREQ);
