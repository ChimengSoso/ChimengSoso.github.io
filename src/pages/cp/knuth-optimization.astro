}
/** ลำดับการตัดหนึ่งลำดับที่ได้ค่าต่ำสุด ใช้วาดภาพ */
function oneBestOrder(gaps: number[]): { mark: number; piece: [number, number]; price: number }[] {
  const pre = [0];
  for (const g of gaps) pre.push(pre[pre.length - 1] + g);
  const span = (l: number, r: number): number => pre[r] - pre[l - 1];
  const { opt } = cubicDp(gaps.length, sumCost(gaps));
  const out: { mark: number; piece: [number, number]; price: number }[] = [];
  const walk = (l: number, r: number): void => {
    if (l >= r) return;
    const k = opt[l][r];
    out.push({ mark: k, piece: [l, r], price: span(l, r) });
    walk(l, k);
    walk(k + 1, r);
  };
  walk(1, gaps.length);
  return out;
}
const p1Order = oneBestOrder(P1_GAPS);
const p1Total = p1Order.reduce((s, x) => s + x.price, 0);
if (p1Total !== p1Answer) throw new Error('knuth-optimization: ลำดับตัดของข้อที่ 1 รวมได้ไม่ตรงคำตอบ');
/** มีกี่ลำดับที่ได้ค่าต่ำสุดเท่ากัน ต้องบอก ไม่งั้นคนอ่านจะงงว่าทำไมภาพตัดคนละที่กับที่เขาคิด */
function countOptimalFirstCuts(gaps: number[]): number {
  const n = gaps.length;
  const pre = [0];
  for (const g of gaps) pre.push(pre[pre.length - 1] + g);
  const { dp } = cubicDp(n, sumCost(gaps));
  const total = pre[n] - pre[0];
  let c = 0;
  for (let k = 1; k < n; k++) if (dp[1][k] + dp[k + 1][n] + total === dp[1][n]) c++;
  return c;
}
