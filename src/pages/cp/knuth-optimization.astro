<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type KnPuzzle = { id: string; label: string; tease: string; L: number; gaps: number[]; best: number };

  function initKnGame(): void {
    const maybeUi = cpGameUi('[data-kngame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as KnPuzzle[];
    if (puzzles.length === 0) return;

    const rowEl = ui.root.querySelector<HTMLElement>('[data-kn-row]');
    const lenEl = ui.root.querySelector<HTMLElement>('[data-kn-len]');
    const marksEl = ui.root.querySelector<HTMLElement>('[data-kn-marks]');
    if (!rowEl || !lenEl || !marksEl) return;
    const row: HTMLElement = rowEl;
    const lenOut: HTMLElement = lenEl;
    const marksOut: HTMLElement = marksEl;

    let pi = 0;
    /* ชิ้นไม้ที่ยังอยู่ เก็บเป็นช่วงของ "ช่อง" ฐานหนึ่ง */
    let pieces: [number, number][] = [];
    let order = new Map<number, number>();
    let paid = 0;

    const pz = (): KnPuzzle => puzzles[pi];
    const spanLen = (l: number, r: number): number => {
      let s = 0;
      for (let t = l; t <= r; t++) s += pz().gaps[t - 1];
      return s;
    };
    /** ชิ้นที่รอยกาหมายเลข m อยู่ข้างใน (รอยกา m คั่นระหว่างช่อง m กับ m+1) */
    const pieceOf = (m: number): number => pieces.findIndex((p) => p[0] <= m && m < p[1]);

    function build(): void {
      const p = pz();
      row.textContent = '';
      const edge = document.createElement('span');
      edge.className = 'kn-edge';
      row.appendChild(edge);
      p.gaps.forEach((g, t) => {
        const seg = document.createElement('span');
        seg.className = 'kn-seg';
        seg.dataset.seg = String(t + 1);
        /* ความกว้างตามความยาวจริงของช่อง จะได้เห็นว่าชิ้นไหนยาวกว่ากัน */
        seg.style.width = `${Math.max(2.2, (g / p.L) * 26)}rem`;
        const len = document.createElement('span');
        len.className = 'kn-len';
        len.textContent = String(g);
        seg.appendChild(len);
        row.appendChild(seg);
        if (t < p.gaps.length - 1) {
          const mk = document.createElement('button');
          mk.type = 'button';
          mk.className = 'kn-mark';
          mk.dataset.mark = String(t + 1);
          mk.setAttribute('aria-label', `ตัดที่รอยกาที่ ${t + 1}`);
          row.appendChild(mk);
        }
      });
      const edge2 = document.createElement('span');
      edge2.className = 'kn-edge';
      row.appendChild(edge2);
    }

    function render(): void {
      const p = pz();
      for (const mk of Array.from(row.querySelectorAll<HTMLElement>('.kn-mark'))) {
        const m = Number(mk.dataset.mark);
        const ord = order.get(m);
        mk.classList.toggle('cut', ord !== undefined);
        const old = mk.querySelector('.kn-ord');
        if (old) old.remove();
        if (ord !== undefined) {
          const tag = document.createElement('span');
          tag.className = 'kn-ord';
          tag.textContent = String(ord);
          mk.appendChild(tag);
        }
      }
      lenOut.textContent = String(p.L);
      marksOut.textContent = String(p.gaps.length - 1);
      const left = p.gaps.length - 1 - order.size;
      ui.setScore(
        order.size === 0
          ? 'ยังไม่ได้ตัดเลย จ่ายไป 0'
          : `ตัดไปแล้ว ${order.size} รอย จ่ายไป ${paid} เหลืออีก ${left} รอย`,
      );
    }

    function check(): void {
      const p = pz();
      const need = p.gaps.length - 1;
      if (order.size !== need) {
        ui.setStatus(`ต้องตัดให้ครบ ${need} รอยก่อนครับ ตอนนี้ตัดไป ${order.size} รอย`, 'bad');
        return;
      }
      if (paid === p.best) {
        ui.setStatus(`ถูกต้องครับ ${paid} คือค่าที่น้อยที่สุดของไม้ต้นนี้`, 'good');
        return;
      }
      ui.setStatus(
        `ลำดับนี้จ่าย ${paid} ซึ่งยังมากกว่าคำตอบที่ดีที่สุดอยู่ ${paid - p.best} ลองสลับลำดับดูอีกที`,
        'bad',
      );
    }

    function selectPuzzle(t: number): void {
      pi = t;
      pieces = [[1, puzzles[t].gaps.length]];
      order = new Map<number, number>();
      paid = 0;
      ui.selectTab(t);
      ui.setTease(pz().tease);
      build();
      ui.setStatus('คลิกที่รอยกาสีทองเพื่อตัดตรงนั้น');
      render();
    }

    row.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest('.kn-mark');
      if (!(btn instanceof HTMLElement)) return;
      const m = Number(btn.dataset.mark);
      if (order.has(m)) {
        ui.setStatus('รอยนี้ตัดไปแล้ว ถอนคืนไม่ได้ กดเริ่มใหม่ถ้าอยากลองลำดับอื่น', 'bad');
        return;
      }
      const idx = pieceOf(m);
      if (idx === -1) return;
      const [l, r] = pieces[idx];
      const price = spanLen(l, r);
      paid += price;
      order.set(m, order.size + 1);
      pieces.splice(idx, 1, [l, m], [m + 1, r]);
      ui.setStatus(`ตัดที่รอยที่ ${m} ตอนนั้นชิ้นที่ถือยาว ${price} จึงจ่าย ${price}`);
      render();
    });

    ui.onClick('data-kn-reset', () => selectPuzzle(pi));
    ui.onClick('data-kn-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initKnGame);
</script>

<script>
  import { initCpPlayers } from '../../lib/cpPlayer';

  /* ตัวเล่นนี้เดินไปตาม "เส้นทแยง" ไม่ใช่ตามแถวของตาราง หนึ่งก้าวคือการเติมหนึ่งช่อง
     จึงใช้ initCpRowPlayers ไม่ได้ ต้องส่ง draw ของตัวเองเข้ามา */
  type KnStep = { note: string; i: number; j: number; lo: number; hi: number; pick: number; filled: string[] };

  function isKnStep(x: unknown): x is KnStep {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return (
      typeof o.note === 'string' &&
      typeof o.i === 'number' &&
      typeof o.j === 'number' &&
      typeof o.lo === 'number' &&
      typeof o.hi === 'number' &&
      typeof o.pick === 'number' &&
      Array.isArray(o.filled)
    );
  }

  document.addEventListener('astro:page-load', () => {
    initCpPlayers<KnStep>('[data-knsim]', {
      narrow: (raw) => {
        const ok = raw.filter(isKnStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      draw: (st, ctx) => {
        const root = ctx.parts.root;
        const cells = Array.from(root.querySelectorAll<HTMLTableCellElement>('td.num[data-kn-i]'));
        const shown = new Set(st.filled);
        let live: HTMLTableCellElement | null = null;
        for (const td of cells) {
          const i = Number(td.dataset.knI);
          const j = Number(td.dataset.knJ);
          if (j < i) continue;
          const key = `${i}-${j}`;
          /* ช่องแนวทแยงเป็นศูนย์อยู่แล้วตั้งแต่ต้น ที่เหลือเผยเมื่อถึงคิว */
          td.textContent = i === j || shown.has(key) ? (td.dataset.v ?? '·') : '·';
          const isTarget = i === st.i && j === st.j;
          const isNb = (i === st.i && j === st.j - 1) || (i === st.i + 1 && j === st.j);
          td.classList.toggle('is-target', isTarget);
          td.classList.toggle('is-nb', isNb);
          if (isTarget) live = td;
        }
        ctx.keepInView(live);
      },
    });
  });
</script>
