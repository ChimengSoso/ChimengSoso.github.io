      : r.touched.length > 0
        ? `ช่อง ${list(r.touched)} ตกรอบ ล็อกคะแนน ${list(r.touched.map((p) => r.score[p]))}`
        : 'ไม่มีช่องให้ล็อกเพิ่ม';
    const skip = r.skipped.length > 0 ? ` · ช่อง ${list(r.skipped)} ล็อกไปก่อนแล้ว ข้ามไปโดยไม่แตะ` : '';
