<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import { initCpRowPlayers } from '../../lib/cpPlayer';
  import type { CpGameUi } from '../../lib/cpGame';

  type Chip = { t: string; k: 'win' | 'lose' | 'skip' | 'gone' | 'none' };
  type TrnPuzzle = {
    id: string;
    label: string;
    tease: string;
    N: number;
    R: number;
    K: number[];
    rounds: [number, number][];
    wins: number[];
    max: number;
    best: number;
    ties: number;
    chips: Chip[][];
    trapP: number;
    trapWhy: string;
  };

  function initTournamentGame(): void {
    const maybeUi = cpGameUi('[data-trngame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่ตรงนี้ เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as TrnPuzzle[];
    const maybeLine = ui.root.querySelector<HTMLElement>('[data-trn-line]');
    const maybeRounds = ui.root.querySelector<HTMLElement>('[data-trn-rounds]');
    const maybeTrace = ui.root.querySelector<HTMLElement>('[data-trn-trace]');
    if (puzzles.length === 0 || !maybeLine || !maybeRounds || !maybeTrace) return;
    const lineEl: HTMLElement = maybeLine;
    const roundsEl: HTMLElement = maybeRounds;
    const traceEl: HTMLElement = maybeTrace;

    let pi = 0;
    let tried: number[] = [];
    let picked = -1;
    const pz = (): TrnPuzzle => puzzles[pi];

    function renderLine(): void {
      const p = pz();
      lineEl.textContent = '';
      for (let s = 0; s < p.N; s++) {
        const b = document.createElement('button');
        b.type = 'button';
        const seen = tried.indexOf(s) >= 0;
        const top = seen && p.wins[s] === p.max;
        b.className = `trn-slot${seen ? ' tried' : ''}${top ? ' top' : ''}${s === picked ? ' pick' : ''}`;
        b.dataset.trnSlot = String(s);
        b.setAttribute('aria-label', `แทรกที่ช่อง ${s}`);
        const no = document.createElement('span');
        no.textContent = `ช่อง ${s}`;
        const badge = document.createElement('span');
        badge.className = 'trn-badge';
        badge.textContent = seen ? String(p.wins[s]) : '?';
        b.append(no, badge);
        lineEl.append(b);
        if (s + 1 < p.N) {
          const k = document.createElement('div');
          k.className = p.K[s] > p.R ? 'trn-k strong' : 'trn-k';
          const cap = document.createElement('small');
          cap.textContent = 'พลัง';
          const val = document.createElement('b');
          val.textContent = String(p.K[s]);
          k.append(cap, val);
          lineEl.append(k);
        }
      }
    }

    function renderTrace(): void {
      const p = pz();
      traceEl.textContent = '';
      if (picked < 0) return;
      p.chips[picked].forEach((c) => {
        const el = document.createElement('span');
        const tone = c.k === 'win' ? ' win' : c.k === 'lose' ? ' lose' : '';
        el.className = `trn-chip${tone}`;
        const word = c.k === 'win' ? 'ชนะ' : c.k === 'lose' ? 'แพ้และตกรอบ' : c.k === 'skip' ? 'ไม่ได้ลง' : 'ตกไปแล้ว';
        el.textContent = `${c.t} ${word}`;
        traceEl.append(el);
      });
    }

    function renderScore(): void {
      const p = pz();
      const bestSeen = tried.reduce((a, s) => (p.wins[s] > a ? p.wins[s] : a), -1);
      const seenBest = bestSeen === p.max;
      const head = `ลองไปแล้ว ${tried.length} จาก ${p.N} ช่อง`;
      ui.setScore(seenBest ? `${head} · ดีที่สุดที่เจอคือ ${bestSeen} รอบ ซึ่งคือค่าสูงสุดของชุดนี้` : `${head} · ดีที่สุดที่เจอคือ ${tried.length === 0 ? 0 : bestSeen} รอบ`);
    }

    function pick(s: number): void {
      const p = pz();
      picked = s;
      if (tried.indexOf(s) < 0) tried.push(s);
      renderLine();
      renderTrace();
      renderScore();
      const w = p.wins[s];
      if (w === p.max) {
        const tie = p.ties > 1 ? ` ชุดนี้มีช่องที่ได้ ${p.max} รอบเท่ากันอยู่ ${p.ties} ช่อง คำตอบที่ต้องพิมพ์คือช่องเลขน้อยสุดในนั้น คือ ${p.best}` : ` และเป็นช่องเดียวที่ทำได้ คำตอบที่ต้องพิมพ์คือ ${p.best}`;
        ui.setStatus(`ช่อง ${s} ชนะ ${w} รอบ ซึ่งมากที่สุดเท่าที่เป็นไปได้แล้ว${tie}`, 'good');
        return;
      }
      if (s === p.trapP) {
        ui.setStatus(`ช่อง ${s} ชนะ ${w} รอบ ช่องนี้คือท่า${p.trapWhy} ซึ่งชุดนี้ตั้งใจลงโทษไว้ ยังมีช่องที่ดีกว่านี้อยู่`, 'bad');
        return;
      }
      ui.setStatus(`ช่อง ${s} ชนะ ${w} รอบ ยังไม่ใช่ค่าที่ดีที่สุด ลองดูว่ารอบไหนที่เขาไม่ได้ลงสนาม และรอบไหนที่เขาเจอคนแรงกว่า`, 'bad');
    }

    function selectPuzzle(k: number): void {
      pi = k;
      tried = [];
      picked = -1;
      const p = pz();
      ui.selectTab(k);
      ui.setTease(p.tease);
      roundsEl.textContent = `รอบทั้งหมด: ${p.rounds.map((r, j) => `${j + 1}) S=${r[0]} E=${r[1]}`).join('   ')}   ·   พลังของคนมาสาย R=${p.R}`;
      ui.setStatus('กดช่องสีเทาช่องใดช่องหนึ่งเพื่อแทรกอัศวินที่มาสายลงตรงนั้น');
      renderLine();
      renderTrace();
      renderScore();
    }

    lineEl.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest('[data-trn-slot]');
      if (!(btn instanceof HTMLElement)) return;
      pick(Number(btn.dataset.trnSlot));
    });
    ui.onClick('data-trn-reset', () => selectPuzzle(pi));
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initTournamentGame);
  document.addEventListener('astro:page-load', () => initCpRowPlayers('[data-trnsim]'));
</script>
