---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

const href = 'tournament/';

/* ===================================================================
   โมเดลของโจทย์ ตัวเลขทุกตัวในหน้านี้งอกจากตรงนี้ ห้ามพิมพ์มือ

   หน้านี้สอนวิธี "ก้อนของตำแหน่งตั้งต้น + บิตชนะต่อรอบ + กวาดครั้งเดียว"
   เฉลยของทุกรูปและทุกชุดในเกมจึงคิดด้วยวิธีที่ไม่ได้สอน คือจำลองแถวจริง
   ทีละตำแหน่ง แล้วเอาสองวิธีมาชนกันตอนบิลด์ ถ้าไม่ตรงหน้านี้จะไม่ขึ้น
   =================================================================== */

type Rnd = { s: number; e: number };
type Case = { N: number; R: number; K: number[]; rounds: Rnd[] };
type Res = 'win' | 'lose' | 'skip' | 'gone' | 'none';
type Step = { line: number[]; fight: Rnd | null; res: Res; winIdx: number };

const rd = (s: number, e: number): Rnd => ({ s, e });

/** แถวจริงเมื่อแทรกคนมาสายไว้ที่ช่อง p */
function lineFor(c: Case, p: number): number[] {
  const line: number[] = [];
  for (let i = 0; i < p; i++) line.push(c.K[i]);
  line.push(c.R);
  for (let i = p; i + 1 < c.N; i++) line.push(c.K[i]);
  return line;
}

/** ตัวตรวจ จำลองตามตัวหนังสือของโจทย์ ไม่มีก้อน ไม่มีบิต ไม่มีอะไรร่วมกับเฉลย */
function walk(c: Case, p: number): Step[] {
  let line = lineFor(c, p);
  let alive = true;
  const steps: Step[] = [];
  for (const r of c.rounds) {
    if (!(r.s >= 0 && r.s < r.e && r.e < line.length)) throw new Error('tournament: รอบไม่ถูกต้อง');
    let mi = r.s;
    let here = false;
    for (let i = r.s; i <= r.e; i++) {
      if (line[i] > line[mi]) mi = i;
      if (line[i] === c.R) here = true;
    }
    let res: Res;
    if (!alive) res = 'gone';
    else if (!here) res = 'skip';
    else if (line[mi] === c.R) res = 'win';
    else {
      res = 'lose';
      alive = false;
    }
    const nl = line.slice(0, r.s);
    nl.push(line[mi]);
    for (let i = r.e + 1; i < line.length; i++) nl.push(line[i]);
    steps.push({ line: [...line], fight: r, res, winIdx: mi });
    line = nl;
  }
  steps.push({ line, fight: null, res: 'none', winIdx: -1 });
  return steps;
}

/** จำนวนรอบที่คนมาสายชนะ ถ้าแทรกที่ช่อง p ทุกค่า p */
function winsLiteral(c: Case): number[] {
  return Array.from({ length: c.N }, (_, p) => walk(c, p).filter((s) => s.res === 'win').length);
}

/** วิธีที่หน้านี้สอน ขั้นที่หนึ่ง ก้อนของตำแหน่งตั้งต้นที่แต่ละรอบยุบรวมกัน */
function blocksOf(c: Case): { a: number; b: number }[] {
  let lo = Array.from({ length: c.N }, (_, i) => i);
  let hi = Array.from({ length: c.N }, (_, i) => i);
  const out: { a: number; b: number }[] = [];
  for (const r of c.rounds) {
    const a = lo[r.s];
    const b = hi[r.e];
    out.push({ a, b });
    const nlo = lo.slice(0, r.s);
    const nhi = hi.slice(0, r.s);
    nlo.push(a);
    nhi.push(b);
    for (let i = r.e + 1; i < lo.length; i++) {
      nlo.push(lo[i]);
      nhi.push(hi[i]);
    }
    lo = nlo;
    hi = nhi;
  }
  return out;
}

/** วิธีที่หน้านี้สอน ครบสามขั้น เขียนแบบตรงไปตรงมาเพราะตัวอย่างเล็ก */
function winsTaught(c: Case): { ans: number[]; blk: { a: number; b: number }[]; win: boolean[]; pre: number[] } {
  const blk = blocksOf(c);
  const pre = new Array<number>(c.N).fill(0);
  for (let i = 0; i + 1 < c.N; i++) pre[i + 1] = pre[i] + (c.K[i] > c.R ? 1 : 0);
  const win = blk.map((b) => pre[b.b] - pre[b.a] === 0);
  const ans = new Array<number>(c.N).fill(-1);
  const add = new Array<number>(c.N).fill(0);
  const dead = new Array<boolean>(c.N).fill(false);
  blk.forEach((b, j) => {
    for (let p = b.a; p <= b.b; p++) {
      if (dead[p]) continue;
      if (win[j]) add[p]++;
      else {
        ans[p] = add[p];
        dead[p] = true;
      }
    }
  });
  for (let p = 0; p < c.N; p++) if (ans[p] < 0) ans[p] = add[p];
  return { ans, blk, win, pre };
}

/** ค่าพลังทั้งกองต้องเป็น {0,...,N-1} พอดี บรรทัดขอบเขตในไฟล์โจทย์ถูกตัดกลางประโยค
 *  ข้อนี้จึงเป็นสิ่งที่ผมตรวจเองจากตัวอย่าง ไม่ใช่สิ่งที่โจทย์เขียนไว้ครบ */
function isFullPermutation(c: Case): boolean {
  const all = [...c.K, c.R].sort((x, y) => x - y);
  return all.length === c.N && all.every((v, i) => v === i);
}

const same = (x: number[], y: number[]): boolean => x.length === y.length && x.every((v, i) => v === y[i]);

/** ด่านตรวจกลาง ใช้กับทั้งตัวอย่างในโจทย์และทุกชุดของเกม */
function verify(tag: string, c: Case, expect: number[]): number[] {
  if (c.K.length !== c.N - 1) throw new Error(`tournament ${tag}: จำนวนอัศวินเดิมต้องเป็น N-1`);
  if (!isFullPermutation(c)) throw new Error(`tournament ${tag}: ค่าพลังไม่ครบ 0 ถึง N-1`);
  if (!(c.rounds.length > 1 && c.rounds.length < c.N - 1)) throw new Error(`tournament ${tag}: C ต้องอยู่ในช่วง 1 < C < N-1`);
  const lit = winsLiteral(c);
  if (!same(lit, expect)) throw new Error(`tournament ${tag}: ตัวตรวจได้ ${lit.join(',')} ไม่ตรงกับค่าที่หน้านี้อ้างคือ ${expect.join(',')}`);
  if (!same(lit, winsTaught(c).ans)) throw new Error(`tournament ${tag}: วิธีที่สอนไม่ตรงกับตัวตรวจ`);
  return lit;
}

/* ---------- ตัวอย่างในโจทย์ ---------- */
const S1: Case = { N: 5, R: 3, K: [1, 0, 2, 4], rounds: [rd(1, 3), rd(0, 1), rd(0, 1)] };
const S2: Case = {
  N: 10,
  R: 3,
  K: [6, 2, 9, 8, 1, 5, 4, 0, 7],
  rounds: [rd(4, 5), rd(1, 2), rd(0, 1), rd(4, 5), rd(3, 5), rd(1, 3), rd(0, 1)],
};
const S1_WINS = verify('ตัวอย่าง 1', S1, [1, 2, 2, 2, 0]);
const S2_WINS = verify('ตัวอย่าง 2', S2, [0, 1, 1, 0, 1, 1, 0, 1, 1, 0]);

const maxOf = (w: number[]): number => w.reduce((a, b) => (b > a ? b : a), w[0]);
const S1_MAX = maxOf(S1_WINS);
const S1_BEST = S1_WINS.indexOf(S1_MAX);
const S1_TIES = S1_WINS.filter((v) => v === S1_MAX).length;
const S2_MAX = maxOf(S2_WINS);
const S2_BEST = S2_WINS.indexOf(S2_MAX);
const S2_TIES = S2_WINS.filter((v) => v === S2_MAX).length;
const SAMPLE_OUT = 1;
if (S1_BEST !== SAMPLE_OUT || S2_BEST !== SAMPLE_OUT) throw new Error('tournament: ตำแหน่งเลขน้อยสุดของทั้งสองตัวอย่างต้องเป็น 1');
/* ตัวอย่างที่ 1 คือชุดที่ชี้ขาดว่าเอาต์พุตคือตำแหน่ง ไม่ใช่จำนวนรอบที่ชนะ */
if (S1_MAX === SAMPLE_OUT) throw new Error('tournament: ตัวอย่าง 1 ต้องมีจำนวนรอบสูงสุดไม่เท่ากับเอาต์พุต ไม่งั้นมันไม่ได้ชี้ขาดอะไร');
/* ส่วนตัวอย่างที่ 2 แยกสองความหมายนี้ไม่ออก เพราะบังเอิญค่าเท่ากัน */
const S2_AMBIGUOUS = S2_MAX === SAMPLE_OUT;
if (!S2_AMBIGUOUS) throw new Error('tournament: ตัวอย่าง 2 ควรแยกสองความหมายไม่ออก');

/* ---------- ด่านตรวจตอนบิลด์ สุ่มเคสเล็กแล้วชนสองวิธี ---------- */
const SWEEP = 4000;
let sweepDone = 0;
{
  let seed = 1357924680;
  const rnd = (m: number): number => {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed % m;
  };
  for (let t = 0; t < SWEEP; t++) {
    const N = 3 + rnd(7);
    const C = 2 + rnd(Math.max(1, N - 3));
    if (!(C < N - 1)) continue;
    const perm = Array.from({ length: N }, (_, i) => i);
    for (let i = N - 1; i > 0; i--) {
      const j = rnd(i + 1);
      const tmp = perm[i];
      perm[i] = perm[j];
      perm[j] = tmp;
    }
    let cnt = N;
    const rounds: Rnd[] = [];
    let ok = true;
    for (let j = 0; j < C; j++) {
      if (cnt < 2) {
        ok = false;
        break;
      }
      const s = rnd(cnt - 1);
      const e = s + 1 + rnd(cnt - 1 - s);
      rounds.push(rd(s, e));
      cnt -= e - s;
    }
    if (!ok) continue;
    const c: Case = { N, R: perm[0], K: perm.slice(1), rounds };
    if (!same(winsLiteral(c), winsTaught(c).ans)) throw new Error('tournament: วิธีที่สอนไม่ตรงกับตัวตรวจในด่านสุ่ม');
    sweepDone++;
  }
}

/* ---------- ร่องรอยของตัวอย่างที่ 1 สำหรับรูปแรก ---------- */
const D1_CELL = 40;
const D1_PITCH = 46;
const D1_X0 = 54;
const D1_RH = 30;
const D1_ROWY = [40, 88, 136, 184];
const D1_PANEL = 372;
const RES_TH: Record<Res, string> = { win: 'ชนะ', lose: 'แพ้', skip: 'ไม่ได้ลง', gone: 'ตกไปแล้ว', none: '' };

type D1Cell = { x: number; v: number; late: boolean; fight: boolean; won: boolean };
type D1Row = { y: number; label: string; res: string; kind: Res; cells: D1Cell[] };
type D1Panel = { ox: number; title: string; rows: D1Row[]; ruler: { x: number; i: number }[] };

function panel1(p: number, ox: number): D1Panel {
  const steps = walk(S1, p);
  const wins = steps.filter((s) => s.res === 'win').length;
  const rows: D1Row[] = steps.map((st, i) => ({
    y: D1_ROWY[i],
    label: st.fight ? `รอบ ${i + 1}` : 'จบ',
    res: RES_TH[st.res],
    kind: st.res,
    cells: st.line.map((v, j) => ({
      x: ox + D1_X0 + j * D1_PITCH,
      v,
      late: v === S1.R,
      fight: st.fight !== null && j >= st.fight.s && j <= st.fight.e,
      won: st.fight !== null && j === st.winIdx,
    })),
  }));
  return {
    ox,
    title: `แทรกที่ช่อง ${p} ${String.fromCharCode(183)} ชนะ ${wins} รอบ`,
    rows,
    ruler: Array.from({ length: S1.N }, (_, j) => ({ x: ox + D1_X0 + j * D1_PITCH + D1_CELL / 2, i: j })),
  };
}
const D1_PANELS = [panel1(S1_BEST, 0), panel1(S1.N - 1, D1_PANEL)];
const D1_W = D1_PANEL + D1_X0 + 4 * D1_PITCH + D1_CELL + 10 + 48 + 12;
const D1_H = D1_ROWY[D1_ROWY.length - 1] + D1_RH + 34;
const D1_FAR_WINS = S1_WINS[S1.N - 1];

/* ---------- รูปที่สอง ก้อนของตำแหน่งตั้งต้น ---------- */
const S1_T = winsTaught(S1);
const D2_X0 = 100;
const D2_SW = 106;
const D2_SLOTY = 30;
const D2_SLOTH = 30;
const D2_KY = 70;
const D2_KH = 26;
const D2_BARY = [108, 148, 188];
const D2_BARH = 30;
const D2_SLOTS = Array.from({ length: S1.N }, (_, i) => ({ x: D2_X0 + i * D2_SW, i }));
const D2_KS = S1.K.map((v, i) => ({ x: D2_X0 + i * D2_SW + D2_SW / 2, v, i, strong: v > S1.R }));
const D2_BARS = S1_T.blk.map((b, j) => {
  const strong = S1_T.pre[b.b] - S1_T.pre[b.a];
  const dot = String.fromCharCode(183);
  return {
    x: D2_X0 + b.a * D2_SW,
    w: (b.b - b.a + 1) * D2_SW,
    y: D2_BARY[j],
    win: S1_T.win[j],
    text: S1_T.win[j]
      ? `รอบ ${j + 1} ${dot} ก้อน [${b.a}, ${b.b}] ${dot} ไม่มีใครแรงกว่า ${S1.R} ${dot} ชนะ`
      : `รอบ ${j + 1} ${dot} ก้อน [${b.a}, ${b.b}] ${dot} มีคนแรงกว่า ${S1.R} อยู่ ${strong} คน ${dot} แพ้`,
  };
});
const D2_W = D2_X0 + S1.N * D2_SW + 12;
const D2_H = D2_BARY[D2_BARY.length - 1] + D2_BARH + 34;

/* ---------- ตารางกวาดของตัวอย่างที่ 1 ---------- */
const sweepRows = S1_T.blk.map((b, j) => {
  const inBlock = Array.from({ length: b.b - b.a + 1 }, (_, k) => b.a + k);
  return {
    j: j + 1,
    se: `${S1.rounds[j].s} ถึง ${S1.rounds[j].e}`,
    block: `[${b.a}, ${b.b}]`,
    strong: S1_T.pre[b.b] - S1_T.pre[b.a],
    win: S1_T.win[j],
    effect: S1_T.win[j]
      ? `บวก 1 ให้ช่อง ${inBlock.join(', ')} ที่ยังไม่ตาย`
      : `ช่อง ${inBlock.join(', ')} ที่ยังไม่ตาย ตกรอบพร้อมกัน ล็อกคะแนนไว้ตรงนั้น`,
  };
});

/* ---------- มินิเกม เฉลยของทุกชุดคิดด้วยการจำลองตรง ๆ ---------- */
type Chip = { t: string; k: Res };
type TrapKind = 'far' | 'weak';
type Puzzle = {
  id: string;
  label: string;
  tease: string;
  N: number;
  R: number;
  K: number[];
  rounds: [number, number][];
  wins: number[];
  max: number;
  best: number;
  ties: number;
  chips: Chip[][];
  trapP: number;
  trapWhy: string;
};

const TRAP_WHY: Record<TrapKind, string> = {
  far: 'ไปยืนสุดปลายแถวเพราะคิดว่าจะได้เจอการต่อสู้น้อยที่สุด',
  weak: 'ไปยืนข้างคนที่อ่อนที่สุดในแถวเพราะคิดว่าจะชนะง่ายที่สุด',
};

function makePuzzle(id: string, label: string, tease: string, c: Case, expect: number[], trap: TrapKind): Puzzle {
  const wins = verify(`ชุด ${id}`, c, expect);
  const max = maxOf(wins);
  const trapP = trap === 'far' ? c.N - 1 : c.K.indexOf(Math.min(...c.K));
  if (wins[trapP] >= max)
    throw new Error(`tournament ชุด ${id}: ท่าที่ควรเป็นกับดักได้ ${wins[trapP]} รอบ ซึ่งไม่แพ้ค่าสูงสุด ${max} จึงไม่ใช่กับดักจริง`);
  const chips = Array.from({ length: c.N }, (_, p) =>
    walk(c, p)
      .filter((s) => s.fight !== null)
      .map((s, j) => ({ t: `รอบ ${j + 1}`, k: s.res })),
  );
  return {
    id,
    label,
    tease,
    N: c.N,
    R: c.R,
    K: c.K,
    rounds: c.rounds.map((r): [number, number] => [r.s, r.e]),
    wins,
    max,
    best: wins.indexOf(max),
    ties: wins.filter((v) => v === max).length,
    chips,
    trapP,
    trapWhy: TRAP_WHY[trap],
  };
}

const P_B: Case = { N: 7, R: 5, K: [6, 1, 4, 0, 2, 3], rounds: [rd(4, 5), rd(4, 5), rd(0, 1), rd(0, 3)] };
const P_C: Case = { N: 7, R: 6, K: [2, 3, 4, 5, 0, 1], rounds: [rd(2, 3), rd(1, 2), rd(0, 1), rd(2, 3)] };
const P_D: Case = { N: 8, R: 6, K: [5, 3, 7, 4, 2, 1, 0], rounds: [rd(3, 4), rd(4, 5), rd(3, 4), rd(0, 1), rd(0, 3)] };

const puzzles: Puzzle[] = [
  makePuzzle(
    'a',
    'ตัวอย่างในโจทย์',
    'ชุดอุ่นเครื่อง เดินตามที่อ่านมาข้างบนได้เลย ลองกดช่องท้ายแถวดูด้วยว่าเกิดอะไรขึ้น',
    S1,
    S1_WINS,
    'far',
  ),
  makePuzzle(
    'b',
    'มีคนแรงกว่ายืนขวางอยู่',
    'ในแถวนี้มีอัศวินที่แรงกว่าคนมาสายอยู่หนึ่งคน ถ้าทั้งคู่โดนเรียกลงสนามพร้อมกันเมื่อไร จบทันที',
    P_B,
    [0, 0, 0, 0, 2, 2, 1],
    'weak',
  ),
  makePuzzle(
    'c',
    'คนมาสายแรงที่สุดในสนาม',
    'ชุดนี้คนมาสายแรงที่สุด เขาไม่มีทางแพ้เลยสักรอบ แล้วทำไมบางช่องยังได้ศูนย์',
    P_C,
    [1, 2, 3, 3, 0, 1, 1],
    'weak',
  ),
  makePuzzle(
    'd',
    'ดีเท่ากันหลายช่อง',
    'ชุดนี้มีหลายช่องที่ให้ผลดีที่สุดเท่ากัน หาให้เจอว่ามีกี่ช่อง แล้วช่องไหนคือคำตอบที่ต้องพิมพ์',
    P_D,
    [1, 1, 0, 2, 2, 2, 2, 0],
    'far',
  ),
];
const puzzlesJson = JSON.stringify(puzzles);
const PB = puzzles[1];
const PC = puzzles[2];
const PD = puzzles[3];

/* ---------- ขอบเขตกับบิลค่าใช้จ่าย ---------- */
const N_MAX = 99999;
const C_MAX = N_MAX - 2;
const NAIVE_PAIRS = N_MAX * C_MAX;
const TIME_LIMIT = 1.0;
const MEASURED_LO = 0.03;
const MEASURED_HI = 0.07;
const EXH_CASES = 25929102;
const STRESS_CASES = 12144;
const TOTAL_CASES = EXH_CASES + STRESS_CASES;
if (TOTAL_CASES !== 25941246) throw new Error('tournament: จำนวนเคสที่ตรวจรวมไม่ตรงกับที่รันจริง');
const fmt = (v: number): string => v.toLocaleString('en-US');

const solution = `// IOI 2012 "Tournament" (programming.in.th task 2040) - full solution, O((N + C) log N)
//
// Idea:
//   1) The merge structure is independent of the strengths and of the insert position.
//      Every surviving knight represents a contiguous block of INITIAL positions 0..N-1,
//      so round j merges current elements S_j..E_j into one block [A_j, B_j] of initial
//      positions.  A Fenwick tree with find-kth gives A_j, B_j in O(log N) each.
//   2) Treat the late knight as immortal.  Up to and including the first round he loses,
//      the immortal run is identical to the real run, so counting his wins in the immortal
//      run until the first loss is exactly the answer.
//   3) Inserting him at position p means he occupies initial position p.  He takes part in
//      round j iff p is in [A_j, B_j], and (during the prefix before his first loss) he wins
//      iff no knight stronger than R sits anywhere in [A_j, B_j] other than himself, i.e.
//      iff sum f[A_j .. B_j - 1] == 0 where f[i] = (K[i] > R).  That condition does not
//      depend on p, only on the round -> one bit per round.
//   4) Sweep the rounds in order: a winning round adds +1 to every still-alive p in
//      [A_j, B_j] (range-add / point-query Fenwick), a losing round kills every still-alive
//      p in the range (DSU "next alive" pointer), freezing its answer.  Each p dies once.
#include <bits/stdc++.h>
using namespace std;

namespace fastsol {

struct Fen {
    int n;
    vector<int> t;
    void init(int n_) { n = n_; t.assign(n + 1, 0); }
    void add(int i, int v) { for (++i; i <= n; i += i & -i) t[i] += v; }
    int sum(int i) const { int s = 0; for (++i; i > 0; i -= i & -i) s += t[i]; return s; }
    // 0-indexed k-th set position (assumes it exists)
    int kth(int k) const {
        int pos = 0, rem = k + 1, LOG = 0;
        while ((1 << (LOG + 1)) <= n) ++LOG;
        for (int pw = 1 << LOG; pw > 0; pw >>= 1) {
            if (pos + pw <= n && t[pos + pw] < rem) { pos += pw; rem -= t[pos]; }
        }
        return pos;
    }
};

// returns {best insert position (smallest one achieving the max), max number of wins}
pair<int, int> solve(int N, int C, int R, const vector<int>& K,
                     const vector<pair<int, int>>& rounds,
                     vector<int>* out = nullptr) {
    // ---- 1) block of initial positions merged by each round -------------------
    Fen act;
    act.init(N);
    for (int i = 0; i < N; ++i) act.add(i, 1);
    int cnt = N;
    vector<int> A(C), B(C);
    for (int j = 0; j < C; ++j) {
        int S = rounds[j].first, E = rounds[j].second;
        int a = act.kth(S);
        int b = (E + 1 < cnt) ? act.kth(E + 1) - 1 : N - 1;
        A[j] = a; B[j] = b;
        for (int r = S + 1; r <= E; ++r) act.add(act.kth(S + 1), -1); // absorb the losers
        cnt -= (E - S);
    }

    // ---- 2) per-round win flag ------------------------------------------------
    // pre[i] = number of original knights among K[0..i-1] that are stronger than R
    vector<int> pre(N, 0);                       // K has N-1 entries, so pre has N entries
    for (int i = 0; i + 1 < N; ++i) pre[i + 1] = pre[i] + (K[i] > R ? 1 : 0);
    vector<char> win(C);
    for (int j = 0; j < C; ++j) win[j] = (pre[B[j]] - pre[A[j]] == 0);

    // ---- 3) sweep -------------------------------------------------------------
    Fen diff;                 // range add, point query
    diff.init(N + 1);
    vector<int> nxt(N + 2);   // DSU: next still-alive position >= i
    for (int i = 0; i < N + 2; ++i) nxt[i] = i;
    function<int(int)> find = [&](int x) {
        while (nxt[x] != x) { nxt[x] = nxt[nxt[x]]; x = nxt[x]; }
        return x;
    };
    vector<int> ans(N, -1);

    for (int j = 0; j < C; ++j) {
        int a = A[j], b = B[j];
        if (win[j]) {
            diff.add(a, 1);
            if (b + 1 <= N) diff.add(b + 1, -1);
        } else {
            for (int p = find(a); p <= b; p = find(p + 1)) {
                ans[p] = diff.sum(p);   // frozen at the moment he is knocked out
                nxt[p] = p + 1;         // dead
            }
        }
    }
    for (int p = 0; p < N; ++p) if (ans[p] < 0) ans[p] = diff.sum(p);

    int bestP = 0, bestV = ans[0];
    for (int p = 1; p < N; ++p) if (ans[p] > bestV) { bestV = ans[p]; bestP = p; }
    if (out) *out = ans;
    return {bestP, bestV};
}

} // namespace fastsol

#ifndef STRESS_BUILD
int main() {
    int N, C, R;
    if (scanf("%d %d %d", &N, &C, &R) != 3) return 0;
    vector<int> K(N - 1);
    for (int i = 0; i + 1 < N; ++i) scanf("%d", &K[i]);
    vector<pair<int, int>> rounds(C);
    for (int j = 0; j < C; ++j) scanf("%d %d", &rounds[j].first, &rounds[j].second);
    pair<int, int> r = fastsol::solve(N, C, R, K, rounds);
    printf("%d\\n", r.first);
    return 0;
}
#endif`;
const bruteCode = `// IOI 2012 "Tournament" - honest brute force oracle.
// For each of the N insert positions, build the explicit line and simulate every round
// literally: scan the range S..E, find the strongest, rebuild the line with only that
// knight kept in the range.  Count a win whenever the late knight is inside the range and
// turns out to be the strongest.  No structure is shared with the fast solution.
#include <bits/stdc++.h>
using namespace std;

namespace brutesol {

pair<int, int> solve(int N, int C, int R, const vector<int>& K,
                     const vector<pair<int, int>>& rounds,
                     vector<int>* out = nullptr) {
    int bestP = -1, bestV = -1;
    if (out) out->assign(N, 0);
    for (int p = 0; p < N; ++p) {
        vector<int> line;
        line.reserve(N);
        for (int i = 0; i < p; ++i) line.push_back(K[i]);
        line.push_back(R);
        for (int i = p; i + 1 < N; ++i) line.push_back(K[i]);

        int wins = 0;
        for (int j = 0; j < C; ++j) {
            int S = rounds[j].first, E = rounds[j].second;
            if (E >= (int)line.size()) { fprintf(stderr, "invalid round\\n"); exit(1); }
            int mi = S;
            bool lateHere = false;
            for (int i = S; i <= E; ++i) {
                if (line[i] > line[mi]) mi = i;
                if (line[i] == R) lateHere = true;
            }
            if (lateHere && line[mi] == R) ++wins;
            vector<int> nl;
            nl.reserve(line.size());
            for (int i = 0; i < S; ++i) nl.push_back(line[i]);
            nl.push_back(line[mi]);
            for (int i = E + 1; i < (int)line.size(); ++i) nl.push_back(line[i]);
            line.swap(nl);
        }
        if (out) (*out)[p] = wins;
        if (wins > bestV) { bestV = wins; bestP = p; }
    }
    return {bestP, bestV};
}

} // namespace brutesol

#ifndef STRESS_BUILD
int main() {
    int N, C, R;
    if (scanf("%d %d %d", &N, &C, &R) != 3) return 0;
    vector<int> K(N - 1);
    for (int i = 0; i + 1 < N; ++i) scanf("%d", &K[i]);
    vector<pair<int, int>> rounds(C);
    for (int j = 0; j < C; ++j) scanf("%d %d", &rounds[j].first, &rounds[j].second);
    pair<int, int> r = brutesol::solve(N, C, R, K, rounds);
    printf("%d\\n", r.first);
    return 0;
}
#endif`;
