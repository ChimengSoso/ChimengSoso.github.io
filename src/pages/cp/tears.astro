---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';

const href = 'tears/';

/* ---------- โมเดลของโจทย์ ตัวเลขทุกตัวในหน้านี้งอกจากตรงนี้ ---------- */

type Rect = { r1: number; r2: number; c1: number; c2: number };

const SAMPLE_P = [9, 8, 7, 6, 2, 4, 5, 3, 1];
const SAMPLE_N = SAMPLE_P.length;
const SAMPLE_Q: Rect[] = [
  { r1: 4, r2: 9, c1: 3, c2: 6 },
  { r1: 2, r2: 9, c1: 1, c2: 8 },
  { r1: 3, r2: 8, c1: 2, c2: 4 },
  { r1: 3, r2: 9, c1: 2, c2: 7 },
  { r1: 2, r2: 8, c1: 1, c2: 6 },
  { r1: 1, r2: 9, c1: 1, c2: 9 },
  { r1: 1, r2: 3, c1: 5, c2: 7 },
  { r1: 2, r2: 3, c1: 3, c2: 3 },
  { r1: 6, r2: 6, c1: 6, c2: 6 },
];
const SAMPLE_OUT = [1, 4, 2, 4, 4, 4, 0, 0, 0];

/** ค่าที่ตำแหน่ง i (i เริ่มที่ 1) */
const valAt = (P: number[], i: number): number => P[i - 1];

/** ตัวตรวจอิสระ: ไล่ทุกคู่ตามนิยามโจทย์ตรง ๆ ไม่ใช้ท่าที่หน้านี้สอนเลย */
function pairsIn(P: number[], q: Rect): [number, number][] {
  const out: [number, number][] = [];
  const n = P.length;
  for (let i = 1; i <= n; i++) {
    const vi = valAt(P, i);
    if (i < q.r1 || i > q.r2 || vi < q.c1 || vi > q.c2) continue;
    for (let j = i + 1; j <= n; j++) {
      const vj = valAt(P, j);
      if (j < q.r1 || j > q.r2 || vj < q.c1 || vj > q.c2) continue;
      if (vi < vj) out.push([i, j]);
    }
  }
  return out;
}
const countIn = (P: number[], q: Rect): number => pairsIn(P, q).length;

/* ตรวจตอน build: โมเดลต้องตรงกับเฉลยของโจทย์ทุกบรรทัด ไม่ตรงคือ build ล้ม */
const sampleCalc = SAMPLE_Q.map((q) => countIn(SAMPLE_P, q));
if (sampleCalc.join(' ') !== SAMPLE_OUT.join(' '))
  throw new Error('tears: โมเดลไม่ตรงกับเฉลยตัวอย่างของโจทย์');

/* โจทย์ไล่คู่ของคำถามที่ 1 และ 2 ออกมาให้ด้วย ใช้เป็นการตรวจที่แน่นกว่าเทียบแค่จำนวน */
const q1Pairs = pairsIn(SAMPLE_P, SAMPLE_Q[0]);
const q2Pairs = pairsIn(SAMPLE_P, SAMPLE_Q[1]);
const fmtPairs = (ps: [number, number][]): string => ps.map(([a, b]) => `(${a}, ${b})`).join(', ');
if (fmtPairs(q1Pairs) !== '(6, 7)') throw new Error('tears: คู่ของคำถามที่ 1 ไม่ตรงกับที่โจทย์ระบุ');
if (fmtPairs(q2Pairs) !== '(5, 6), (5, 7), (5, 8), (6, 7)')
  throw new Error('tears: คู่ของคำถามที่ 2 ไม่ตรงกับที่โจทย์ระบุ');

/* การอ่านอีกสามแบบที่ตัวอย่างปัดตกไป ใช้เล่าในคำอธิบายว่าทำไมตัวอย่างชี้ขาดได้ */
function invCount(P: number[], q: Rect): number {
  let s = 0;
  const n = P.length;
  for (let i = 1; i <= n; i++) {
    const vi = valAt(P, i);
    if (i < q.r1 || i > q.r2 || vi < q.c1 || vi > q.c2) continue;
    for (let j = i + 1; j <= n; j++) {
      const vj = valAt(P, j);
      if (j < q.r1 || j > q.r2 || vj < q.c1 || vj > q.c2) continue;
      if (vi > vj) s++;
    }
  }
  return s;
}
const q1Inversions = invCount(SAMPLE_P, SAMPLE_Q[0]);
const q1SwappedFields = countIn(SAMPLE_P, { r1: 4, r2: 3, c1: 9, c2: 6 });
if (q1Inversions === SAMPLE_OUT[0] || q1SwappedFields === SAMPLE_OUT[0])
  throw new Error('tears: ตัวอย่างแยกการอ่านโจทย์ไม่ได้ คำอธิบายในหน้าจะผิด');

/* จำนวนจุดที่อยู่ในกรอบของคำถามที่ 1 ใช้เตือนว่าเอาต์พุตนับคู่ ไม่ได้นับจุด */
const q1Inside = SAMPLE_P.map((v, k) => ({ i: k + 1, v })).filter(
  (p) => p.i >= SAMPLE_Q[0].r1 && p.i <= SAMPLE_Q[0].r2 && p.v >= SAMPLE_Q[0].c1 && p.v <= SAMPLE_Q[0].c2,
);

/* ---------- รูปที่หนึ่ง: ตัวอย่างทั้งเก้าจุด กับกรอบของคำถามที่ 1 ---------- */
const D_PAD = 54;
const D_CELL = 58;
const dX = (i: number): number => D_PAD + (i - 1) * D_CELL + D_CELL / 2;
const dY = (v: number): number => 34 + (SAMPLE_N - v) * D_CELL + D_CELL / 2;
const D_GRID_R = D_PAD + SAMPLE_N * D_CELL;
const D_GRID_B = 34 + SAMPLE_N * D_CELL;
/* ขอบซ้ายวัดในเบราว์เซอร์ เลื่อนจุดเริ่ม viewBox ให้เหลือราว 12 หน่วยเท่าขอบขวา */
const D_VB_X = 22;
const D_VB_W = D_GRID_R + 12 - D_VB_X;
const D_VB_H = D_GRID_B + 26 + 34;
const dq = SAMPLE_Q[0];
const dRectX = D_PAD + (dq.r1 - 1) * D_CELL;
const dRectY = 34 + (SAMPLE_N - dq.c2) * D_CELL;
const dRectW = (dq.r2 - dq.r1 + 1) * D_CELL;
const dRectH = (dq.c2 - dq.c1 + 1) * D_CELL;
const dInsideSet = new Set(q1Inside.map((p) => p.i));

/* ---------- เกม ---------- */
type Puzzle = { id: string; label: string; tease: string; P: number[]; rect: Rect; answer: number; hint: string };

const rawPuzzles: { id: string; label: string; tease: string; P: number[]; rect: Rect; expect: number; hint: string }[] = [
  {
    id: 'a', label: 'ชุด A', P: [2, 5, 4, 3, 1], rect: { r1: 1, r2: 5, c1: 1, c2: 5 }, expect: 3,
    tease: 'กรอบกินทั้งกระดาน อุ่นเครื่องก่อน',
    hint: 'กรอบคลุมทุกจุด จึงเหลือคำถามเดียวคือคู่ไหนที่ขึ้นทั้งสองแกน จุดแรกค่าน้อยที่สุดในบรรดาจุดต้น ๆ จึงจับคู่ได้หลายทาง',
  },
  {
    id: 'b', label: 'ชุด B', P: [1, 3, 5, 6, 4, 2], rect: { r1: 1, r2: 5, c1: 2, c2: 5 }, expect: 2,
    tease: 'คราวนี้กรอบตัดทั้งแกนดัชนีและแกนค่า',
    hint: 'ในกรอบเหลือสามจุด แต่คำตอบคือสองคู่ จำนวนจุดกับจำนวนคู่เป็นคนละเรื่องกัน',
  },
  {
    id: 'c', label: 'ชุด C', P: [5, 4, 3, 2, 1], rect: { r1: 1, r2: 5, c1: 1, c2: 5 }, expect: 0,
    tease: 'ชุดนี้มีจุดครบห้าจุดในกรอบ แต่คำตอบอาจไม่ใช่อย่างที่คิด',
    hint: 'ค่าลดลงตลอด ไม่มีคู่ไหนขึ้นทั้งสองแกนเลย ชุดแบบนี้มีไว้เตือนว่าจุดเยอะไม่ได้แปลว่าคู่เยอะ',
  },
  {
    id: 'd', label: 'ชุด D', P: [1, 2, 3, 5, 7, 4, 6], rect: { r1: 2, r2: 7, c1: 4, c2: 7 }, expect: 3,
    tease: 'กระดานใหญ่ขึ้น นับจุดในกรอบให้ดีก่อนลงมือ',
    hint: 'ในกรอบมีสี่จุดแต่ตอบสามคู่ ถ้าเผลอตอบจำนวนจุดจะพลาดทันที',
  },
];

const puzzles: Puzzle[] = rawPuzzles.map((r) => {
  const got = countIn(r.P, r.rect);
  if (got !== r.expect) throw new Error(`tears: เกมชุด ${r.label} ควรได้ ${r.expect} แต่โมเดลได้ ${got}`);
  return { id: r.id, label: r.label, tease: r.tease, P: r.P, rect: r.rect, answer: got, hint: r.hint };
});

/* ชุด D ต้องหลอกจริง คือจำนวนจุดในกรอบต้องไม่เท่าคำตอบ ไม่งั้นกับดักไม่ทำงาน */
const pdD = puzzles[3];
const pdInside = pdD.P.map((v, k) => ({ i: k + 1, v })).filter(
  (p) => p.i >= pdD.rect.r1 && p.i <= pdD.rect.r2 && p.v >= pdD.rect.c1 && p.v <= pdD.rect.c2,
).length;
if (pdInside === pdD.answer) throw new Error('tears: ชุด D ไม่ได้หลอกอะไรเลย จำนวนจุดบังเอิญเท่าคำตอบ');

/* กระดานของเกม คิดพิกัดไว้ให้หมดตั้งแต่ตอน build */
const G_CELL = 44;
/* ขอบซ้ายขวาของกระดานวัดในเบราว์เซอร์ให้เหลือราว 12 หน่วยทั้งสองฝั่ง */
const G_PAD = 12;
type Board = { id: string; w: number; h: number; n: number; rx: number; ry: number; rw: number; rh: number;
               dots: { i: number; v: number; x: number; y: number; inside: boolean }[] };
const boards: Board[] = puzzles.map((p) => {
  const n = p.P.length;
  const w = G_PAD + n * G_CELL + 12;
  const h = 18 + n * G_CELL + 26;
  const dots = p.P.map((v, k) => {
    const i = k + 1;
    const inside = i >= p.rect.r1 && i <= p.rect.r2 && v >= p.rect.c1 && v <= p.rect.c2;
    return { i, v, x: G_PAD + (i - 1) * G_CELL + G_CELL / 2, y: 18 + (n - v) * G_CELL + G_CELL / 2, inside };
  });
  return {
    id: p.id, w, h, n,
    rx: G_PAD + (p.rect.r1 - 1) * G_CELL,
    ry: 18 + (n - p.rect.c2) * G_CELL,
    rw: (p.rect.r2 - p.rect.r1 + 1) * G_CELL,
    rh: (p.rect.c2 - p.rect.c1 + 1) * G_CELL,
    dots,
  };
});
const puzzlesJson = JSON.stringify(
  puzzles.map((p) => ({ id: p.id, label: p.label, tease: p.tease, answer: p.answer, hint: p.hint,
                        pairs: pairsIn(p.P, p.rect) })),
);

/* ---------- ตัวเลขที่ใช้ในเนื้อหา ---------- */
const N_MAX = 100000;
const M_MAX = 200000;
const TIME_LIMIT = 4;
const MEM_LIMIT = 1024;
const BLOCK_FACTOR = 0.44;
const BLOCK_AT_MAX = Math.max(1, Math.floor(Math.sqrt(N_MAX) * BLOCK_FACTOR));
const NB_AT_MAX = Math.ceil(N_MAX / BLOCK_AT_MAX);
const STRESS_CASES = 980;
const STRESS_SIZES = [8, 20, 45, 120, 400, 1200, 4000];
/* เวลาที่วัดได้จริง หน่วยวินาที เครื่อง WSL Ubuntu g++ 11.4.0 -O2 ที่ N = 1e5, M = 2e5 */
const TIMINGS = [
  { shape: 'กรอบสุ่มทั้งสองแกน', sec: 3.66, mb: 365 },
  { shape: 'กรอบเต็มระนาบทุกคำถาม', sec: 1.70, mb: 359 },
  { shape: 'กรอบยาวเกือบเต็มแกนดัชนี', sec: 3.59, mb: 363 },
  { shape: 'กรอบสั้น', sec: 0.77, mb: 363 },
];
const WORST_SEC = Math.max(...TIMINGS.map((t) => t.sec));
const WORST_MB = Math.max(...TIMINGS.map((t) => t.mb));
const BUDGET_PCT = Math.round((WORST_SEC / TIME_LIMIT) * 100);
/* ประวัติการไล่เวลา ทุกแถววัดจริงบนอินพุตชุดเดียวกัน */
const PERF_STEPS = [
  { what: 'ตัวแรกที่ให้คำตอบถูก', sec: 14.75 },
  { what: 'ตัด binary search ต่อบล็อกต่อคำถาม ใช้ตาราง F แทน', sec: 8.14 },
  { what: 'สลับแกนตาราง F จาก F[บล็อก][ค่า] เป็น F[ค่า][บล็อก]', sec: 3.88 },
  { what: 'สลับแกนตาราง E กับตาราง f แล้วจูนขนาดบล็อกใหม่', sec: WORST_SEC },
];
const SPEEDUP = +(PERF_STEPS[0].sec / WORST_SEC).toFixed(1);
const CACHE_GAIN = +(8.14 - 3.88).toFixed(2);
/* ขนาดก้าวกระโดดของการอ่านตาราง F แบบผิดแกน หน่วยกิโลไบต์ */
const F_ROW_KB = Math.round(((N_MAX + 1) * 4) / 1024);

const SUBTASKS = [
  { pct: 12, cond: 'N, M ไม่เกิน 10' },
  { pct: 12, cond: 'N, M ไม่เกิน 3000 ถึง 5000 (สามชั้น ชั้นละ 4%)' },
  { pct: 16, cond: 'c1 = 1 และ c2 = N คือไม่มีขอบค่า (สี่ชั้น)' },
  { pct: 12, cond: 'กรอบสองอันซ้อนกันสนิทหรือไม่แตะกันเลย (สามชั้น)' },
  { pct: 24, cond: 'N ไม่เกิน 20000 ถึง 70000 (หกชั้น)' },
  { pct: 12, cond: 'ทั้งลำดับมีคู่ที่ไม่เพิ่มขึ้นไม่เกิน 50 คู่' },
  { pct: 12, cond: 'ไม่มีเงื่อนไขเพิ่ม' },
];
const SUBTASK_TOTAL = SUBTASKS.reduce((s, x) => s + x.pct, 0);
if (SUBTASK_TOTAL !== 100) throw new Error('tears: สัดส่วนคะแนนของ subtask รวมกันไม่ได้ 100');

/* งบเวลาที่ใช้เล่าในตอนที่ 1 */
const LOG_N = Math.ceil(Math.log2(N_MAX));
const WALK_OPS = M_MAX * N_MAX * LOG_N;
const SQRT_N = Math.round(Math.sqrt(N_MAX));
const SQRT_TOTAL_M = Math.round((M_MAX * SQRT_N) / 1e6);
const fmtBig = (x: number): string => x.toLocaleString('en-US');

/* กราฟแท่งงบเวลา (ตอนที่ 1) สเกล log10 ทุกแท่งคำนวณจากขอบเขตเต็ม
   ความเร็วเครื่องเป็นค่าสมมติแบบหยาบที่เขียนบอกไว้ในหน้า ไม่ใช่ค่าที่วัด */
const OPS_PER_SEC = 1e8;
const BUDGET_OPS = TIME_LIMIT * OPS_PER_SEC;
const BRUTE_OPS = M_MAX * N_MAX * N_MAX;
/* ต้นทุนจริงต่อคำถามของวิธีเต็ม: ฝั่งบล็อกเต็มราว N/B ส่วนฝั่งเศษราว B log B (ดึงเศษแล้วนับด้วย BIT)
   ใช้ทั้งในกราฟตอนที่ 1 และในเหตุผลที่เลือก B ในตอนที่ 3 */
const perQ = (B: number): number => Math.ceil(N_MAX / B) + Math.round(B * Math.log2(B));
const PERQ_BEST = perQ(BLOCK_AT_MAX);
const PERQ_SQRT = perQ(SQRT_N);
const PERQ_FULL = Math.ceil(N_MAX / BLOCK_AT_MAX);
const PERQ_FRAG = Math.round(BLOCK_AT_MAX * Math.log2(BLOCK_AT_MAX));
if (PERQ_BEST >= PERQ_SQRT) throw new Error('tears: B ที่โค้ดใช้ต้องถูกกว่า B = √N ตามที่หน้าเขียนไว้');
const SQRT_OPS = M_MAX * PERQ_BEST;
const SWEEP_OPS = N_MAX * NB_AT_MAX;
const CH_LO = 7;
const CH_HI = 16;
const CH_X0 = 196;
const CH_W = 360;
const CH_ROW = 46;
const CH_Y0 = 46;
const chX = (v: number): number => CH_X0 + ((Math.log10(v) - CH_LO) / (CH_HI - CH_LO)) * CH_W;
const sci = (v: number): { m: string; e: number } => {
  const e = Math.floor(Math.log10(v));
  const m = v / 10 ** e;
  return { m: m.toFixed(1).replace(/\.0$/, ''), e };
};
const CH_BARS = [
  { name: 'ไล่ทุกคู่', v: BRUTE_OPS, ok: false },
  { name: 'เดินตามดัชนี + BIT', v: WALK_OPS, ok: false },
  { name: `แบ่งราก (B = ${BLOCK_AT_MAX})`, v: SQRT_OPS, ok: true },
].map((b, k) => ({ ...b, y: CH_Y0 + k * CH_ROW, s: sci(b.v), over: Math.round(b.v / BUDGET_OPS) }));
if (CH_BARS.some((b) => b.ok !== b.v <= BUDGET_OPS)) throw new Error('tears: กราฟงบเวลา แท่งที่บอกว่าทัน/ไม่ทันไม่ตรงกับตัวเลข');
const CH_TICKS = Array.from({ length: (CH_HI - CH_LO) / 3 + 1 }, (_, k) => CH_LO + k * 3);
const CH_BOTTOM = CH_Y0 + CH_BARS.length * CH_ROW;
const WALK_OVER = Math.round(WALK_OPS / BUDGET_OPS);

/* ---------- เงื่อนไขแปดข้อของคู่หนึ่งคู่ (ตอนที่ 2) ---------- */
const CONDS: { cond: string; keep: boolean; why: string }[] = [
  { cond: 'i ≥ r1', keep: true, why: 'ต้องเช็ก' },
  { cond: 'i ≤ r2', keep: false, why: 'ฟรี เพราะ i &lt; j ≤ r2' },
  { cond: 'j ≥ r1', keep: false, why: 'ฟรี เพราะ j &gt; i ≥ r1' },
  { cond: 'j ≤ r2', keep: true, why: 'ต้องเช็ก' },
  { cond: 'P<sub>i</sub> ≥ c1', keep: true, why: 'ต้องเช็ก' },
  { cond: 'P<sub>i</sub> ≤ c2', keep: false, why: 'ฟรี เพราะ P<sub>i</sub> &lt; P<sub>j</sub> ≤ c2' },
  { cond: 'P<sub>j</sub> ≥ c1', keep: false, why: 'ฟรี เพราะ P<sub>j</sub> &gt; P<sub>i</sub> ≥ c1' },
  { cond: 'P<sub>j</sub> ≤ c2', keep: true, why: 'ต้องเช็ก' },
];
if (CONDS.filter((c) => c.keep).length !== 4) throw new Error('tears: ต้องเหลือเงื่อนไขจริงสี่ข้อ');

/* ---------- ตัวอย่างเล็กของการกวาดค่า (ตอนที่ 4) ----------
   12 ตำแหน่ง บล็อกละ 3 จึงมี 4 บล็อก (เลขบล็อกเริ่มที่ 0 ตามโค้ด)
   คำถามมีเศษซ้ายในบล็อก 0 เศษขวาในบล็อก 3 บล็อกเต็มคือ 1 กับ 2 */
const SW_P = [7, 11, 1, 2, 9, 5, 6, 3, 10, 12, 4, 8];
const SW_N = SW_P.length;
const SW_B = 3;
const SW_NB = Math.ceil(SW_N / SW_B);
const swBlk = (i: number): number => Math.floor((i - 1) / SW_B);
const SW_Q: Rect = { r1: 2, r2: 11, c1: 4, c2: 10 };
const SW_FB1 = swBlk(SW_Q.r1) + 1;
const SW_FB2 = swBlk(SW_Q.r2) - 1;
const swIsFull = (b: number): boolean => b >= SW_FB1 && b <= SW_FB2;
const swNa = (b1: number, b: number): boolean => b < b1;
const SW_E_ROWS = Array.from({ length: SW_NB - 1 }, (_, k) => k + 1);

type SwStep = {
  note: string; vals: number[]; c: number[]; col: number[]; E: number[][];
  hotPos: number; hotBx: number; read: '' | 'lo' | 'hi';
  /** ตำแหน่ง (เริ่มที่ 0) ของตัวที่เพิ่งจับคู่กับตัวที่ใส่ในขั้นนี้ ใช้วาดเส้นบนกระดาน */
  pairs: number[];
};

const swPosOf: number[] = [];
SW_P.forEach((v, k) => { swPosOf[v] = k + 1; });
/** ผลอ่านของคำถาม ณ เวลาที่กวาดมาถึง: ผลรวม colTotal[bx] − E[b1][bx] บนช่วงบล็อกเต็ม */
const swReadAt = (col: number[], E: number[][]): number => {
  let s = 0;
  for (let bx = SW_FB1; bx <= SW_FB2; bx++) s += col[bx] - E[SW_FB1][bx];
  return s;
};

const swSteps: SwStep[] = [];
let swRead = { lo: 0, hi: 0 };
{
  const vals = Array<number>(SW_N).fill(0);
  const c = Array<number>(SW_NB).fill(0);
  const col = Array<number>(SW_NB).fill(0);
  const E = Array.from({ length: SW_NB }, () => Array<number>(SW_NB).fill(0));
  const snap = (note: string, hotPos: number, hotBx: number, read: SwStep['read'], pairs: number[]): void => {
    swSteps.push({ note, vals: [...vals], c: [...c], col: [...col], E: E.map((r) => [...r]), hotPos, hotBx, read, pairs });
  };
  snap(
    `ยังไม่ได้ใส่อะไร ทุกช่องเป็นศูนย์ ต่อไปจะใส่ค่า 1, 2, 3, … ทีละตัวเรียงตามค่า ตำแหน่งจึงกระโดดไปมาได้`,
    -1, -1, '', [],
  );
  for (let t = 1; t <= SW_N; t++) {
    const pos = swPosOf[t];
    const bx = swBlk(pos);
    const before = (b: number): number => c.slice(0, b).reduce((s, x) => s + x, 0);
    const pref = before(bx);
    const partners = vals.map((v, k) => (v > 0 && swBlk(k + 1) < bx ? k : -1)).filter((k) => k >= 0);
    if (partners.length !== pref) throw new Error('tears: เส้นคู่บนกระดานไม่เท่ากับจำนวนคู่ใหม่');
    col[bx] += pref;
    const eAdds: string[] = [];
    for (let b1 = 0; b1 < SW_NB; b1++) {
      E[b1][bx] += before(b1);
      if (b1 >= 1 && b1 <= bx) eAdds.push(`E[${b1}][${bx}] +${before(b1)}`);
    }
    c[bx]++;
    vals[pos - 1] = t;
    /* สามขั้นแรกเล่าเต็มประโยค หลังจากนั้นผู้อ่านจับรูปแบบได้แล้ว ใช้แบบย่อ ไม่งั้นข้อความซ้ำกันสิบครั้ง */
    let note: string;
    if (t <= 3) {
      note = `ใส่ค่า <b>${t}</b> ที่ตำแหน่ง ${pos} ซึ่งอยู่บล็อก ${bx} `;
      note += pref === 0
        ? `บล็อกก่อนหน้ายังไม่มีของที่ใส่แล้วเลย จึงยังไม่เกิดคู่ใหม่`
        : `บล็อกก่อนหน้ามีของที่ใส่แล้ว ${pref} ตัว ทุกตัวค่าน้อยกว่า ${t} แน่นอนเพราะใส่ก่อน จึงเกิดคู่ใหม่ ${pref} คู่ colTotal[${bx}] เพิ่ม ${pref}`;
      if (eAdds.length > 0) note += ` ส่วนแถว E เพิ่มเฉพาะคู่ที่ปลายล่างอยู่ก่อนบล็อกของแถว: ${eAdds.join(', ')}`;
    } else {
      note = `ใส่ <b>${t}</b> ที่ตำแหน่ง ${pos} (บล็อก ${bx}) · คู่ใหม่ ${pref}`;
      if (pref > 0) note += ` · colTotal[${bx}] +${pref}`;
      if (eAdds.length > 0) note += ` · ${eAdds.join(', ')}`;
    }
    let read: SwStep['read'] = '';
    if (t === SW_Q.c1 - 1) {
      read = 'lo';
      swRead = { ...swRead, lo: swReadAt(col, E) };
      note += `<br />ตรงนี้คือเวลา c1 − 1 = ${t} ของคำถาม อ่านค่าเก็บไว้: ผลรวม colTotal[bx] − E[${SW_FB1}][bx] ของบล็อก ${SW_FB1} ถึง ${SW_FB2} ได้ <b>${swRead.lo}</b>`;
    }
    if (t === SW_Q.c2) {
      read = 'hi';
      swRead = { ...swRead, hi: swReadAt(col, E) };
      note += `<br />ตรงนี้คือเวลา c2 = ${t} ของคำถาม อ่านค่าแบบเดียวกันได้ <b>${swRead.hi}</b>`;
    }
    snap(note, pos - 1, bx, read, partners);
  }
}

/* กระดานจุดในเครื่องเดิน: แกนนอนคือตำแหน่ง แกนตั้งคือค่า แถบเขียวคือบล็อกเต็มของคำถาม */
const SB_CELL = 24;
const SB_PAD = 34;
const SB_TOP = 10;
const sbX = (k: number): number => SB_PAD + k * SB_CELL + SB_CELL / 2;
const sbY = (v: number): number => SB_TOP + (SW_N - v) * SB_CELL + SB_CELL / 2;
const SB_GRID = SW_N * SB_CELL;
const SB_VB_W = SB_PAD + SB_GRID + 12;
const SB_VB_H = SB_TOP + SB_GRID + 30;

/* ส่วน Cross(A, S) ของคำถามตัวอย่าง: สมาชิก A ในบล็อกก่อนหน้า คูณ สมาชิก S ในบล็อกปัจจุบัน */
const swInBlock = (b: number, lo: number, hi: number): number =>
  SW_P.filter((v, k) => swBlk(k + 1) === b && v >= lo && v <= hi).length;
let swCross = 0;
{
  let runA = 0;
  for (let b = SW_FB1; b <= SW_FB2; b++) {
    swCross += swInBlock(b, SW_Q.c1, SW_Q.c2) * runA;
    runA += swInBlock(b, 1, SW_Q.c1 - 1);
  }
}
const swAnswer = swRead.hi - swRead.lo - swCross;
/* ตัวตรวจอิสระ: นับตรง ๆ เฉพาะคู่ที่ปลายทั้งสองอยู่ในบล็อกเต็มคนละบล็อก */
const swBrute = (() => {
  let s = 0;
  for (let i = 1; i <= SW_N; i++)
    for (let j = i + 1; j <= SW_N; j++) {
      const bi = swBlk(i), bj = swBlk(j), vi = SW_P[i - 1], vj = SW_P[j - 1];
      if (bi < SW_FB1 || bj > SW_FB2 || bi === bj) continue;
      if (vi >= SW_Q.c1 && vj <= SW_Q.c2 && vi < vj) s++;
    }
  return s;
})();
if (swAnswer !== swBrute) throw new Error(`tears: ตัวอย่างการกวาดได้ ${swAnswer} แต่นับตรง ๆ ได้ ${swBrute}`);
if (swRead.lo === 0 || swCross === 0) throw new Error('tears: ตัวอย่างการกวาดต้องให้ทั้งค่าที่ c1−1 และ Cross ไม่เป็นศูนย์ ไม่งั้นสูตรไม่มีอะไรให้ดู');
const swAOf = (b: number): number[] => SW_P.filter((v, k) => swBlk(k + 1) === b && v < SW_Q.c1);
const swSOf = (b: number): number[] => SW_P.filter((v, k) => swBlk(k + 1) === b && v >= SW_Q.c1 && v <= SW_Q.c2);
/* ประโยคที่ไล่ Cross ทีละบล็อก สร้างจากข้อมูล ไม่ได้พิมพ์เอง */
const swCrossTerms: string[] = [];
for (let b = SW_FB1; b <= SW_FB2; b++) {
  const s = swSOf(b);
  const aBefore: number[] = [];
  for (let b0 = SW_FB1; b0 < b; b0++) aBefore.push(...swAOf(b0));
  if (s.length > 0 && aBefore.length > 0)
    swCrossTerms.push(`ตัวใน S ของบล็อก ${b} (ค่า ${s.join(', ')}) จับคู่กับตัวใน A ที่อยู่บล็อกก่อนหน้า (ค่า ${aBefore.join(', ')}) ได้ ${s.length} × ${aBefore.length} = ${s.length * aBefore.length} คู่`);
}

/* ตาราง F ของตัวอย่าง: F[v][b] = จำนวนตำแหน่งในบล็อก 0..b-1 ที่ค่าไม่เกิน v */
const swF = (v: number, b: number): number => SW_P.filter((x, k) => swBlk(k + 1) < b && x <= v).length;
const swFDemo = {
  hiR: swF(SW_Q.c2, SW_FB2 + 1), hiL: swF(SW_Q.c2, SW_FB1),
  loR: swF(SW_Q.c1 - 1, SW_FB2 + 1), loL: swF(SW_Q.c1 - 1, SW_FB1),
};
const swFAns = swFDemo.hiR - swFDemo.hiL - (swFDemo.loR - swFDemo.loL);
const swFDirect = SW_P.filter((x, k) => swBlk(k + 1) >= SW_FB1 && swBlk(k + 1) <= SW_FB2 && x >= SW_Q.c1 && x <= SW_Q.c2);
if (swFAns !== swFDirect.length) throw new Error('tears: ตัวอย่างตาราง F ไม่ตรงกับการนับตรง ๆ');
/* ตาราง F เต็มของตัวอย่าง 12 ตำแหน่ง ช่องที่สูตรใช้ถูกเน้น */
const SW_F_ROWS = Array.from({ length: SW_N + 1 }, (_, v) => v);
const SW_F_COLS = Array.from({ length: SW_NB + 1 }, (_, b) => b);
const swFHot = (v: number, b: number): boolean =>
  (v === SW_Q.c2 || v === SW_Q.c1 - 1) && (b === SW_FB1 || b === SW_FB2 + 1);
/* รูปกอง A / S บนแกนค่า เส้นโค้งวาดตามค่า 1-3, 6-9, 2-5 ของคำถามตัวอย่างนี้ ถ้าเปลี่ยนคำถามต้องวาดใหม่ */
if (SW_Q.c1 !== 4 || SW_Q.c2 !== 10) throw new Error("tears: รูปกอง A/S วาดไว้สำหรับแถบค่า [4, 10] เท่านั้น");
const swValFill = (v: number): string =>
  v < SW_Q.c1 ? "rgba(224,122,122,0.25)" : v <= SW_Q.c2 ? "rgba(110,231,168,0.22)" : "#141c2c";
const SW_BLOCK_VALS = Array.from({ length: SW_NB }, (_, b) => SW_P.filter((_, k) => swBlk(k + 1) === b));
const BLOCK_CELLS_M = +((N_MAX * BLOCK_AT_MAX) / 1e6).toFixed(1);

/* ---------- เกมหดกรอบ (ลองเอง เกมที่ 2) ----------
   คู่ตายตัวหนึ่งคู่ ปลายล่าง (2, 2) ปลายบน (5, 5) บนกระดาน 6 x 6 */
const EG_N = 6;
const EG_LO = { i: 2, v: 2 };
const EG_HI = { i: 5, v: 5 };
const EG_CELL = 40;
const EG_PAD = 30;
const EG_TOP = 10;
const egX = (i: number): number => EG_PAD + (i - 1) * EG_CELL + EG_CELL / 2;
const egY = (v: number): number => EG_TOP + (EG_N - v) * EG_CELL + EG_CELL / 2;
const EG_VB_W = EG_PAD + EG_N * EG_CELL + 12;
const EG_VB_H = EG_TOP + EG_N * EG_CELL + 30;
const EG_EDGES = [
  { id: 'r1', name: 'ขอบซ้าย (r1)' },
  { id: 'r2', name: 'ขอบขวา (r2)' },
  { id: 'c1', name: 'ขอบล่าง (c1)' },
  { id: 'c2', name: 'ขอบบน (c2)' },
];

/* ---------- รูปบล็อก (ตอนที่ 3) ---------- */
const BK_CELL = 26;
const BK_B = 4;
const BK_NB = 6;
const BK_X0 = 16;
const BK_R1 = 3;
const BK_R2 = 21;
const bkX = (i: number): number => BK_X0 + (i - 1) * BK_CELL;
const bkKind = (i: number): 'out' | 'left' | 'full' | 'right' => {
  if (i < BK_R1 || i > BK_R2) return 'out';
  const b = Math.floor((i - 1) / BK_B);
  if (b === Math.floor((BK_R1 - 1) / BK_B)) return 'left';
  if (b === Math.floor((BK_R2 - 1) / BK_B)) return 'right';
  return 'full';
};
const BK_FILL = { out: '#141c2c', left: 'rgba(212,175,55,0.30)', full: 'rgba(110,231,168,0.22)', right: 'rgba(212,175,55,0.30)' };
const BK_RIGHT = bkX(BK_NB * BK_B + 1);
const bkLeftEnd = BK_B;
const bkRightStart = (BK_NB - 1) * BK_B + 1;
/* เกมจัดหมวดคู่ (ตอนที่ 3) ใช้แถบเดียวกับรูปบล็อก */
const BK_CELLS = Array.from({ length: BK_NB * BK_B }, (_, k) => ({ i: k + 1, blk: Math.floor(k / BK_B), kind: bkKind(k + 1) }));
const BK_BLOCKS = Array.from({ length: BK_NB }, (_, b) => BK_CELLS.filter((c) => c.blk === b));

const solution = `// NOI 2020 "Tears" / โศกนาฏกรรม  (programming.in.th 2043, Luogu P6774)
// full constraints: N <= 1e5, M <= 2e5
//
// นับคู่ (i, j) ที่ i < j, P_i < P_j, ดัชนีทั้งคู่อยู่ใน [r1,r2], ค่าทั้งคู่อยู่ใน [c1,c2]
//
// ข้อสังเกตที่ใช้ตลอดไฟล์: คู่ที่นับมี i < j และ P_i < P_j อยู่แล้ว ขอบสี่ด้านจึงผูกปลายละข้าง
//     ดัชนีอยู่ใน [r1,r2] ทั้งคู่  <=>  i >= r1 และ j <= r2
//     ค่าอยู่ใน [c1,c2] ทั้งคู่    <=>  P_i >= c1 และ P_j <= c2
//
// หั่นแกนดัชนีเป็นบล็อกขนาด B แล้วแตกคำถามเป็นหกหมวดตามที่ปลายสองข้างตกอยู่
//   ซ้ายเศษ x ซ้ายเศษ, ขวาเศษ x ขวาเศษ, ซ้ายเศษ x ขวาเศษ   -> รวมเป็นรอบเดียว O(B log B)
//   ซ้ายเศษ x บล็อกเต็ม, บล็อกเต็ม x ขวาเศษ                 -> O(1) ต่อชิ้น ด้วยตาราง F
//   บล็อกเต็มบล็อกเดียวกัน                                    -> O(1) ต่อบล็อก ด้วยตาราง f ของบล็อกนั้น
//   บล็อกเต็มคนละบล็อก                                        -> กวาดค่า + ตาราง E (ดูด้านล่าง)
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

// อ่านอินพุตทั้งไฟล์ทีเดียวแล้วแกะเอง อินพุตเต็มขอบเขตมีตัวเลขราวเก้าแสนตัว
static char *inBuf; static size_t inPos, inLen;
static void readAll() {
    size_t cap = 1 << 22; inBuf = (char *)malloc(cap); inLen = 0;
    while (true) {
        if (inLen + (1 << 20) > cap) { cap <<= 1; inBuf = (char *)realloc(inBuf, cap); }
        size_t got = fread(inBuf + inLen, 1, 1 << 20, stdin);
        inLen += got;
        if (got < (1 << 20)) break;
    }
    inPos = 0;
}
static inline int readInt() {
    while (inPos < inLen && (inBuf[inPos] < '0' || inBuf[inPos] > '9')) inPos++;
    int x = 0;
    while (inPos < inLen && inBuf[inPos] >= '0' && inBuf[inPos] <= '9') x = x * 10 + (inBuf[inPos++] - '0');
    return x;
}

static int n, m, B, nb;
static vector<int> P, posOf;          // posOf[v] = ตำแหน่งของค่า v
static vector<int> blkOf, blkL, blkR;

// F[v][b] = จำนวนตำแหน่งในบล็อก 0..b-1 ที่มีค่า <= v   (b = 0..nb)
// เก็บโดยให้ "ค่า" เป็นแถว เพราะลูปร้อนทุกอันวิ่งตาม b โดยตรึง v ไว้
// เวอร์ชันแรกเก็บสลับกัน ทำให้ทุกการอ่านห่างกัน 400KB และพลาดแคชทุกครั้ง
static vector<int> F;                 // ขนาด (n+1) * (nb+1)
static int NBP1;
static inline int Fat(int b, int v) { return F[(size_t)v * NBP1 + b]; }
// จำนวนตำแหน่งในบล็อก [bl, br] ที่มีค่าอยู่ใน [lo, hi]
static inline int cntBlocks(int bl, int br, int lo, int hi) {
    if (bl > br || lo > hi) return 0;
    if (lo < 1) lo = 1;
    if (hi > n) hi = n;
    if (lo > hi) return 0;
    return (Fat(br + 1, hi) - Fat(bl, hi)) - (Fat(br + 1, lo - 1) - Fat(bl, lo - 1));
}

// ---- ต่อบล็อก: ค่าที่เรียงแล้ว, อันดับภายในบล็อก, และตาราง f ----
static vector<vector<int>> blkSortedPos;   // ตำแหน่งในบล็อก เรียงตามค่า
static vector<int> rankIn;                 // rankIn[pos] = อันดับของค่าที่ pos ภายในบล็อกของมัน (1-based)
static vector<vector<int>> fTab;           // fTab[b] = ตาราง (sz+1)^2 แบบผลรวมสะสมสองมิติ

// f[u][v] = จำนวนคู่ i<j ในบล็อกนี้ ที่ rank_i <= u, rank_j <= v และ rank_i < rank_j
// ผู้เรียกส่งอันดับมาให้เลย (คำนวณจากตาราง F ได้ในเวลาคงที่) จึงไม่ต้อง binary search
// เวอร์ชันแรกใช้ lower_bound/upper_bound ต่อบล็อกต่อคำถาม ซึ่งทำให้เคสช่วงยาวใช้เวลา 14.75 วินาที
static inline ll withinBlockRank(int b, int lo, int hi) {
    if (lo > hi) return 0;
    int W = blkR[b] - blkL[b] + 2;
    const int *f = fTab[b].data();
    // เก็บแบบ f[v][u] (แถวคือ v) การอ่านสองครั้งจึงอยู่แถวเดียวกัน ลด cache miss ครึ่งหนึ่ง
    const int *row = f + (size_t)hi * W;
    // #{rank_i >= lo, rank_j <= hi}  (rank_i < rank_j อยู่ในนิยามของ f แล้ว)
    return (ll)row[hi] - (ll)row[lo - 1];
}

int main() {
    // ---------- อ่านอินพุต ----------
    readAll();
    n = readInt(); m = readInt();
    P.assign(n + 2, 0); posOf.assign(n + 2, 0);
    for (int i = 1; i <= n; i++) { P[i] = readInt(); posOf[P[i]] = i; }

    // จูนแล้วที่ n = 1e5: B ราว 140 เร็วที่สุด (บล็อกเล็กลงทำให้ตาราง f ของแต่ละบล็อกอยู่ในแคชได้)
    B = max(1, (int)(sqrt((double)n) * 0.44));
    if (const char *e = getenv("BLK")) { int v = atoi(e); if (v > 0) B = v; }  // ใช้ตอนจูนเท่านั้น
    nb = (n + B - 1) / B;
    blkOf.assign(n + 2, 0); blkL.assign(nb, 0); blkR.assign(nb, 0);
    for (int i = 1; i <= n; i++) blkOf[i] = (i - 1) / B;
    for (int b = 0; b < nb; b++) { blkL[b] = b * B + 1; blkR[b] = min(n, (b + 1) * B); }

    // ---------- ตาราง F ----------
    NBP1 = nb + 1;
    F.assign((size_t)(n + 1) * NBP1, 0);
    for (int v = 1; v <= n; v++) {
        int *cur = &F[(size_t)v * NBP1];
        const int *prv = &F[(size_t)(v - 1) * NBP1];
        int bv = blkOf[posOf[v]];
        for (int b = 0; b <= bv; b++) cur[b] = prv[b];
        for (int b = bv + 1; b <= nb; b++) cur[b] = prv[b] + 1;
    }

    // ---------- ต่อบล็อก: เรียงค่า, อันดับ, ตาราง f ----------
    blkSortedPos.assign(nb, {});
    rankIn.assign(n + 2, 0);
    fTab.assign(nb, {});
    for (int b = 0; b < nb; b++) {
        int sz = blkR[b] - blkL[b] + 1;
        vector<int> ps(sz);
        for (int k = 0; k < sz; k++) ps[k] = blkL[b] + k;
        sort(ps.begin(), ps.end(), [&](int x, int y) { return P[x] < P[y]; });
        blkSortedPos[b] = ps;
        for (int k = 0; k < sz; k++) rankIn[ps[k]] = k + 1;

        int W = sz + 1;
        vector<int> f((size_t)W * W, 0);
        // ใส่ 1 ที่ (rank_i, rank_j) ของทุกคู่ที่ i < j และ rank_i < rank_j
        for (int i = blkL[b]; i <= blkR[b]; i++)
            for (int j = i + 1; j <= blkR[b]; j++)
                if (rankIn[i] < rankIn[j]) f[(size_t)rankIn[j] * W + rankIn[i]]++;
        // ผลรวมสะสมสองมิติบน layout f[v][u]
        for (int v = 1; v < W; v++)
            for (int u = 1; u < W; u++)
                f[(size_t)v * W + u] += f[(size_t)(v - 1) * W + u] + f[(size_t)v * W + u - 1]
                                      - f[(size_t)(v - 1) * W + u - 1];
        fTab[b] = move(f);
    }

    // ---------- อ่านคำถาม ----------
    vector<int> qr1(m), qr2(m), qc1(m), qc2(m);
    vector<ll> ans(m, 0);
    for (int k = 0; k < m; k++) { qr1[k] = readInt(); qr2[k] = readInt(); qc1[k] = readInt(); qc2[k] = readInt(); }

    // ---------- หมวด "บล็อกเต็มคนละบล็อก": กวาดค่าจากน้อยไปมาก ----------
    // colTotal[bx] = จำนวนคู่ที่ปลายบนอยู่บล็อก bx และปลายล่างอยู่บล็อกใดก็ได้ที่เล็กกว่า bx
    // E[bx][b1]   = จำนวนคู่ที่ปลายบนอยู่บล็อก bx และปลายล่างอยู่บล็อกที่เล็กกว่า b1
    // ทั้งสองนับเฉพาะของที่ใส่ไปแล้ว (ค่า <= เวลาปัจจุบัน) และ P_i < P_j รับประกันโดยลำดับการใส่
    vector<ll> colTotal(nb, 0);
    vector<ll> E((size_t)nb * nb, 0);
    vector<int> c(nb, 0);
    // เหตุการณ์: คำถาม k ต้องอ่านค่าที่เวลา c2 (บวก) และที่เวลา c1-1 (ลบ)
    vector<vector<pair<int,int>>> evAt(n + 2);   // evAt[t] = (k, sign)
    for (int k = 0; k < m; k++) {
        int b1 = blkOf[qr1[k]], b2 = blkOf[qr2[k]];
        if (b2 - b1 < 2) continue;               // ไม่มีบล็อกเต็มสองบล็อกขึ้นไป
        evAt[qc2[k]].push_back({k, +1});
        if (qc1[k] - 1 >= 1) evAt[qc1[k] - 1].push_back({k, -1});
    }
    for (int t = 1; t <= n; t++) {
        int pos = posOf[t], bx = blkOf[pos];
        // อัปเดตก่อนนับตัวเอง: คู่ใหม่เกิดกับของที่ใส่ไปแล้วเท่านั้น
        ll run = 0, pref = 0;
        ll *Ebase = &E[bx];
        for (int b1 = 0; b1 < nb; b1++) {
            if (b1 == bx) pref = run;      // run ตอนนี้คือผลรวมของบล็อกที่ < bx พอดี ไม่ต้องวนซ้ำ
            Ebase[(size_t)b1 * nb] += run;
            run += c[b1];
        }
        colTotal[bx] += pref;
        c[bx]++;

        for (auto &ev : evAt[t]) {
            int k = ev.first, sg = ev.second;
            int bb1 = blkOf[qr1[k]] + 1, bb2 = blkOf[qr2[k]] - 1;
            ll s = 0;
            const ll *Erow = &E[(size_t)bb1 * nb];   // ติดกันในหน่วยความจำ
            for (int bx2 = bb1; bx2 <= bb2; bx2++) s += colTotal[bx2] - Erow[bx2];
            ans[k] += sg * s;
        }
    }

    // ---------- ประกอบคำตอบของแต่ละคำถาม ----------
    // BIT เล็กสำหรับหมวดเศษ (ดัชนีอัดเป็น 0..cntPart-1)
    vector<int> bitArr;
    auto bitInit = [&](int sz) { bitArr.assign(sz + 1, 0); };
    auto bitAdd  = [&](int i)  { for (++i; i < (int)bitArr.size(); i += i & -i) bitArr[i]++; };
    auto bitSum  = [&](int i)  { int s = 0; for (++i; i > 0; i -= i & -i) s += bitArr[i]; return s; };

    vector<int> partPos;    // ตำแหน่งของชิ้นเศษ เรียงตามค่า
    vector<int> idxOfPos;   // ตำแหน่ง -> ลำดับที่ (ตามตำแหน่ง) ในกองเศษ
    idxOfPos.assign(n + 2, -1);

    for (int k = 0; k < m; k++) {
        int r1 = qr1[k], r2 = qr2[k], c1 = qc1[k], c2 = qc2[k];
        if (c1 > c2 || r1 > r2) { ans[k] = 0; continue; }
        int b1 = blkOf[r1], b2 = blkOf[r2];
        ll res = ans[k];   // ส่วนที่ได้จากการกวาดแล้ว (หมวดบล็อกเต็มคนละบล็อก)

        if (b1 == b2) {
            // ทั้งคำถามอยู่ในบล็อกเดียว: นับตรง ๆ ด้วย BIT บนอันดับภายในบล็อก
            res = 0;
            int sz = blkR[b1] - blkL[b1] + 1;
            bitInit(sz + 1);
            for (int i = r1; i <= r2; i++) {
                int v = P[i];
                if (v < c1 || v > c2) continue;
                res += bitSum(rankIn[i] - 1);
                bitAdd(rankIn[i]);
            }
            ans[k] = res;
            continue;
        }

        int bb1 = b1 + 1, bb2 = b2 - 1;          // ช่วงบล็อกเต็ม (อาจว่าง)
        bool hasFull = bb1 <= bb2;
        int L = hasFull ? blkL[bb1] : 0, R = hasFull ? blkR[bb2] : -1;

        // (ก)+(ข) รอบเดียวเหนือบล็อกเต็ม อ่านตาราง F สี่ครั้งต่อบล็อก
        //   lo_b = จำนวนค่าในบล็อก b ที่ <= c1-1   (ใช้เป็นขอบล่างของอันดับ และเป็นขนาดของ A)
        //   hi_b = จำนวนค่าในบล็อก b ที่ <= c2     (ใช้เป็นขอบบนของอันดับ)
        // (ก) คู่ที่อยู่ในบล็อกเต็มบล็อกเดียวกัน
        // (ข) แก้แถบค่าของหมวดบล็อกเต็มคนละบล็อก: ลบส่วน Cross(A, S) ออก
        //     A = ค่า <= c1-1, S = ค่าใน [c1,c2]; ค่าใน A น้อยกว่าใน S ทุกตัว ปลายล่างจึงเป็นฝั่ง A เสมอ
        if (hasFull) {
            int lowCap = c1 - 1;
            const int *rowLo = lowCap >= 1 ? &F[(size_t)lowCap * NBP1] : nullptr;
            const int *rowHi = &F[(size_t)c2 * NBP1];
            ll runA = 0, cross = 0;
            for (int b = bb1; b <= bb2; b++) {
                int lo = rowLo ? rowLo[b + 1] - rowLo[b] : 0;
                int hi = rowHi[b + 1] - rowHi[b];
                res += withinBlockRank(b, lo + 1, hi);
                if (lowCap >= 1) { cross += (ll)(hi - lo) * runA; runA += lo; }
            }
            res -= cross;
        }

        // รวบรวมชิ้นเศษสองฝั่ง โดยดึงออกมาเรียงตามค่าอยู่แล้ว (ไม่ต้อง sort)
        partPos.clear();
        {
            // ซ้ายเศษ = ตำแหน่ง r1..blkR[b1] ; ขวาเศษ = blkL[b2]..r2
            const vector<int> &sl = blkSortedPos[b1];
            const vector<int> &sr = blkSortedPos[b2];
            size_t a = 0, b = 0;
            while (a < sl.size() || b < sr.size()) {
                while (a < sl.size() && (sl[a] < r1 || P[sl[a]] < c1 || P[sl[a]] > c2)) a++;
                while (b < sr.size() && (sr[b] > r2 || P[sr[b]] < c1 || P[sr[b]] > c2)) b++;
                if (a >= sl.size() && b >= sr.size()) break;
                if (b >= sr.size() || (a < sl.size() && P[sl[a]] < P[sr[b]])) partPos.push_back(sl[a++]);
                else partPos.push_back(sr[b++]);
            }
        }
        int cntPart = (int)partPos.size();
        // ลำดับตามตำแหน่ง: ซ้ายเศษมาก่อนขวาเศษเสมอ จึงจัดลำดับด้วยตำแหน่งจริงได้เลย
        {
            vector<int> byPos = partPos;
            sort(byPos.begin(), byPos.end());
            for (int t = 0; t < cntPart; t++) idxOfPos[byPos[t]] = t;
        }
        // (ค) คู่ที่ปลายทั้งสองเป็นชิ้นเศษ (ซ้ายxซ้าย, ขวาxขวา, ซ้ายxขวา) รวบเป็นรอบเดียว
        bitInit(cntPart + 1);
        for (int t = 0; t < cntPart; t++) {
            int id = idxOfPos[partPos[t]];
            res += bitSum(id - 1);      // ของที่ค่าน้อยกว่า และตำแหน่งอยู่ก่อนหน้า
            bitAdd(id);
        }
        // (ง) ชิ้นเศษ x บล็อกเต็ม
        if (hasFull) {
            for (int pos : partPos) {
                int v = P[pos];
                if (pos <= blkR[b1]) res += cntBlocks(bb1, bb2, v + 1, c2);   // เศษซ้ายเป็นปลายล่าง
                else                 res += cntBlocks(bb1, bb2, c1, v - 1);   // เศษขวาเป็นปลายบน
            }
        }
        for (int pos : partPos) idxOfPos[pos] = -1;
        ans[k] = res;
        (void)L; (void)R;
    }

    for (int k = 0; k < m; k++) printf("%lld\\n", ans[k]);
    return 0;
}`;
const subCode = `// NOI 2020 "Tears" (2043) - เฉลย subtask: N, M <= 5000
// เดินหน้าต่างตามลำดับดัชนี แล้วนับด้วย BIT บนแกนค่า  O(ความยาวช่วง * log n) ต่อคำถาม
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

int n, m;
vector<int> P, t;

void add(int i, int v) { for (; i <= n; i += i & -i) t[i] += v; }
int sum(int i) { int s = 0; for (; i > 0; i -= i & -i) s += t[i]; return s; }

int main() {
    if (scanf("%d %d", &n, &m) != 2) return 0;
    P.assign(n + 1, 0); t.assign(n + 1, 0);
    for (int i = 1; i <= n; i++) if (scanf("%d", &P[i]) != 1) return 0;
    vector<int> touched;
    touched.reserve(n);
    for (int k = 0; k < m; k++) {
        int r1, r2, c1, c2;
        if (scanf("%d %d %d %d", &r1, &r2, &c1, &c2) != 4) return 0;
        ll s = 0;
        touched.clear();
        if (r1 <= r2 && c1 <= c2) {
            int base = sum(c1 - 1);            // ค่าที่ต่ำกว่าแถบ ไม่มีวันถูกใส่ จึงคงที่
            (void)base;
            for (int i = r1; i <= r2; i++) {
                int v = P[i];
                if (v < c1 || v > c2) continue;
                s += sum(v - 1) - sum(c1 - 1);  // ของที่ใส่แล้วและค่าน้อยกว่า v (อยู่ในแถบแน่นอน)
                add(v, 1);
                touched.push_back(v);
            }
            for (int v : touched) add(v, -1);
        }
        printf("%lld\\n", s);
    }
    return 0;
}`;
const bruteCode = `// NOI 2020 "Tears" (2043) - ตัวตรวจ อ่านจากนิยามโจทย์ตรง ๆ  O(N^2) ต่อคำถาม
// ใช้ได้กับ subtask N, M <= 10 และเป็นตัวเทียบในการ stress test
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
int main() {
    int n, m;
    if (scanf("%d %d", &n, &m) != 2) return 0;
    vector<int> P(n + 1);
    for (int i = 1; i <= n; i++) if (scanf("%d", &P[i]) != 1) return 0;
    for (int k = 0; k < m; k++) {
        int r1, r2, c1, c2;
        if (scanf("%d %d %d %d", &r1, &r2, &c1, &c2) != 4) return 0;
        ll s = 0;
        for (int i = 1; i <= n; i++) {
            if (i < r1 || i > r2 || P[i] < c1 || P[i] > c2) continue;
            for (int j = i + 1; j <= n; j++) {
                if (j < r1 || j > r2 || P[j] < c1 || P[j] > c2) continue;
                if (P[i] < P[j]) s++;      // คู่ที่เพิ่มขึ้น ตามที่โจทย์นิยาม
            }
        }
        printf("%lld\\n", s);
    }
    return 0;
}`;
