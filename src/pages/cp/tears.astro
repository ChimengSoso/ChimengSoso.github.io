<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';
  import { initCpPlayers } from '../../lib/cpPlayer';

  type TePuzzle = { id: string; label: string; tease: string; answer: number; hint: string; pairs: [number, number][] };

  function initTearsGame(): void {
    const maybeUi = cpGameUi('[data-tegame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as TePuzzle[];
    if (puzzles.length === 0) return;

    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-te-board]'));
    const hintEl = ui.root.querySelector<HTMLElement>('[data-cpg-hint]');
    const setHint = (t: string): void => { if (hintEl) hintEl.textContent = t; };
    let pi = 0;
    let picked: number[] = [];
    let found: string[] = [];
    /* ยังไม่บอกจำนวนคู่ทั้งหมดจนกว่าผู้เล่นจะลองเสนอคู่แรก ไม่งั้นชุดที่ตอบศูนย์จะถูกเฉลยตั้งแต่เห็นการ์ด */
    let tried = false;

    const pz = (): TePuzzle => puzzles[pi];
    const keyOf = (a: number, b: number): string => `${Math.min(a, b)}-${Math.max(a, b)}`;

    function dotsOf(k: number): HTMLElement[] {
      return Array.from(ui.root.querySelectorAll<HTMLElement>(`[data-te-dot^="${k}:"]`));
    }

    function paint(): void {
      boards.forEach((b, k) => { b.hidden = k !== pi; });
      for (const d of dotsOf(pi)) {
        const raw = d.getAttribute('data-te-dot');
        if (!raw) continue;
        const idx = Number(raw.split(':')[1]);
        d.setAttribute('stroke-width', picked.includes(idx) ? '4' : '2');
        d.setAttribute('stroke', picked.includes(idx) ? '#6ee7a8' : d.getAttribute('data-base-stroke') || d.getAttribute('stroke') || '#3a4459');
      }
      const total = pz().answer;
      ui.setScore(tried ? `หาได้แล้ว ${found.length} จาก ${total} คู่` : 'ยังไม่ได้เสนอคู่ไหน');
    }

    function reset(): void {
      picked = [];
      found = [];
      tried = false;
      const lines = ui.root.querySelector<HTMLElement>(`[data-te-lines="${pi}"]`);
      if (lines) lines.textContent = '';
      ui.setStatus('กดจุดสองจุดเพื่อเลือกหนึ่งคู่', 'plain');
      setHint('');
      paint();
    }

    function drawPair(a: number, b: number): void {
      const lines = ui.root.querySelector<HTMLElement>(`[data-te-lines="${pi}"]`);
      const da = ui.root.querySelector<HTMLElement>(`[data-te-dot="${pi}:${a}"]`);
      const db = ui.root.querySelector<HTMLElement>(`[data-te-dot="${pi}:${b}"]`);
      if (!lines || !da || !db) return;
      const ln = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      ln.setAttribute('x1', da.getAttribute('cx') || '0');
      ln.setAttribute('y1', da.getAttribute('cy') || '0');
      ln.setAttribute('x2', db.getAttribute('cx') || '0');
      ln.setAttribute('y2', db.getAttribute('cy') || '0');
      ln.setAttribute('stroke', '#6ee7a8');
      ln.setAttribute('stroke-width', '3');
      lines.appendChild(ln);
    }

    function submit(a: number, b: number): void {
      tried = true;
      const lo = Math.min(a, b);
      const hi = Math.max(a, b);
      const k = keyOf(lo, hi);
      const isReal = pz().pairs.some((p) => keyOf(p[0], p[1]) === k);
      if (!isReal) {
        ui.setStatus(`คู่ (${lo}, ${hi}) ยังไม่เข้าเงื่อนไข ต้องอยู่ในกรอบทั้งสองจุด และค่าต้องเพิ่มขึ้นตามดัชนี`, 'bad');
        return;
      }
      if (found.includes(k)) {
        ui.setStatus(`คู่ (${lo}, ${hi}) นับไปแล้ว`, 'plain');
        return;
      }
      found.push(k);
      drawPair(lo, hi);
      if (found.length === pz().answer) {
        ui.setStatus(`ครบแล้ว ${pz().answer} คู่`, 'good');
        setHint(pz().hint);
      } else {
        ui.setStatus(`ใช่ครับ คู่ (${lo}, ${hi}) นับได้ เหลืออีก ${pz().answer - found.length} คู่`, 'good');
      }
      paint();
    }

    for (const d of ui.root.querySelectorAll<HTMLElement>('[data-te-dot]')) {
      d.setAttribute('data-base-stroke', d.getAttribute('stroke') || '#3a4459');
      d.addEventListener('click', () => {
        const raw = d.getAttribute('data-te-dot');
        if (!raw) return;
        const parts = raw.split(':');
        if (Number(parts[0]) !== pi) return;
        const idx = Number(parts[1]);
        if (picked.includes(idx)) { picked = picked.filter((x) => x !== idx); paint(); return; }
        picked.push(idx);
        if (picked.length === 2) {
          submit(picked[0], picked[1]);
          picked = [];
        }
        paint();
      });
    }

    ui.onClick('data-te-reset', () => reset());
    ui.onClick('data-te-give', () => {
      tried = true;
      if (pz().answer === 0) {
        ui.setStatus('ถูกครับ ชุดนี้ไม่มีคู่ไหนเข้าเงื่อนไขเลย', 'good');
        setHint(pz().hint);
      } else {
        ui.setStatus(`ชุดนี้มีอยู่ ${pz().answer} คู่ ลองอีกที`, 'bad');
      }
      paint();
    });

    ui.onTab((k) => { pi = k; reset(); ui.setTease(pz().tease); });
    reset();
    ui.setTease(pz().tease);
  }

  document.addEventListener('astro:page-load', initTearsGame);

  /* เกมหดกรอบ: บันทึกว่าตอนคู่เปลี่ยนจากนับได้เป็นนับไม่ได้ ปลายไหนเป็นตัวที่ออกนอกกรอบ */
  type EgBox = { r1: number; r2: number; c1: number; c2: number };
  function initEdgeGame(): void {
    const maybeUi = cpGameUi('[data-teedge]');
    if (!maybeUi) return;
    const ui: CpGameUi = maybeUi;
    const N = 6;
    const LO = { i: 2, v: 2 };
    const HI = { i: 5, v: 5 };
    const CELL = 40;
    const PAD = 30;
    const TOP = 10;
    const names: Record<string, string> = { r1: 'ขอบซ้าย', r2: 'ขอบขวา', c1: 'ขอบล่าง', c2: 'ขอบบน' };
    const box: EgBox = { r1: 1, r2: N, c1: 1, c2: N };
    let seen = new Set<string>();
    const hintEl = ui.root.querySelector<HTMLElement>('[data-cpg-hint]');
    const rect = ui.root.querySelector<SVGRectElement>('[data-eg-box]');
    const line = ui.root.querySelector<SVGLineElement>('[data-eg-line]');
    const loDot = ui.root.querySelector<SVGCircleElement>('[data-eg-lo]');
    const hiDot = ui.root.querySelector<SVGCircleElement>('[data-eg-hi]');
    const inside = (p: { i: number; v: number }): boolean => p.i >= box.r1 && p.i <= box.r2 && p.v >= box.c1 && p.v <= box.c2;
    const counted = (): boolean => inside(LO) && inside(HI);

    function paint(): void {
      if (rect) {
        rect.setAttribute('x', String(PAD + (box.r1 - 1) * CELL));
        rect.setAttribute('y', String(TOP + (N - box.c2) * CELL));
        rect.setAttribute('width', String((box.r2 - box.r1 + 1) * CELL));
        rect.setAttribute('height', String((box.c2 - box.c1 + 1) * CELL));
      }
      loDot?.setAttribute('fill', inside(LO) ? '#d4af37' : '#3a4459');
      hiDot?.setAttribute('fill', inside(HI) ? '#6ee7a8' : '#3a4459');
      line?.setAttribute('stroke', counted() ? '#6ee7a8' : '#3a4459');
      line?.setAttribute('stroke-dasharray', counted() ? '' : '6 5');
      ui.root.querySelectorAll<HTMLElement>('[data-eg-cell]').forEach((td) => {
        const hit = seen.has(td.dataset.egCell ?? '');
        td.textContent = hit ? 'หลุด' : '·';
        td.classList.toggle('hit', hit);
      });
      const edges = new Set(Array.from(seen).map((k) => k.split(':')[0]));
      ui.setScore(`หดจนคู่หลุดแล้ว ${edges.size} จาก 4 ขอบ`);
      if (hintEl) hintEl.textContent = edges.size === 4
        ? 'ดูตารางอีกที ขอบแต่ละด้านไล่ออกได้แค่ปลายเดียวเสมอ ข้อนี้คือกุญแจของเฉลยตอนที่ 2'
        : '';
    }

    function move(edge: string, dir: string): void {
      const before = counted();
      const next: EgBox = { ...box };
      const d = dir === 'in' ? 1 : -1;
      if (edge === 'r1') next.r1 = Math.min(Math.max(1, box.r1 + d), box.r2);
      if (edge === 'r2') next.r2 = Math.max(Math.min(N, box.r2 - d), box.r1);
      if (edge === 'c1') next.c1 = Math.min(Math.max(1, box.c1 + d), box.c2);
      if (edge === 'c2') next.c2 = Math.max(Math.min(N, box.c2 - d), box.c1);
      Object.assign(box, next);
      const after = counted();
      if (before && !after) {
        const end = !inside(LO) ? 'lo' : 'hi';
        seen.add(`${edge}:${end}`);
        ui.setStatus(`${names[edge]}หดเข้ามาแล้วคู่หลุด เพราะ${end === 'lo' ? 'ปลายล่าง i' : 'ปลายบน j'}ออกนอกกรอบ`, 'bad');
      } else if (!before && after) {
        ui.setStatus('คู่กลับมาอยู่ในกรอบครบ นับได้อีกครั้ง', 'good');
      } else {
        ui.setStatus(after ? 'คู่ยังอยู่ในกรอบครบ ยังนับได้' : 'คู่ยังหลุดอยู่ ขยายขอบออกเพื่อให้กลับมา', 'plain');
      }
      paint();
    }

    ui.root.querySelectorAll<HTMLElement>('[data-eg-move]').forEach((b) => {
      b.addEventListener('click', () => {
        const [edge, dir] = (b.dataset.egMove ?? '').split(':');
        move(edge, dir);
      });
    });
    ui.onClick('data-eg-reset', () => {
      Object.assign(box, { r1: 1, r2: N, c1: 1, c2: N });
      seen = new Set<string>();
      ui.setStatus('คู่นี้อยู่ในกรอบครบทั้งสองปลาย ยังนับได้', 'plain');
      paint();
    });
    paint();
  }
  document.addEventListener('astro:page-load', initEdgeGame);

  /* เกมจัดหมวดคู่: กดสองช่อง แล้วบอกว่าคู่นี้อยู่หมวดไหน นับด้วยวิธีอะไร */
  function initKindGame(): void {
    const maybeUi = cpGameUi('[data-tekind]');
    if (!maybeUi) return;
    const ui: CpGameUi = maybeUi;
    const hintEl = ui.root.querySelector<HTMLElement>('[data-cpg-hint]');
    const cells = Array.from(ui.root.querySelectorAll<HTMLButtonElement>('[data-tk]'));
    const found = new Set<string>();
    let first: HTMLButtonElement | null = null;
    const isFrag = (c: HTMLButtonElement): boolean => c.dataset.kind === 'left' || c.dataset.kind === 'right';

    function classify(a: HTMLButtonElement, b: HTMLButtonElement): { key: string; text: string } {
      if (isFrag(a) && isFrag(b)) return { key: 'frag', text: 'เศษทั้งคู่: ดึงชิ้นเศษออกมาเรียงตามค่า แล้วนับรวมรอบเดียวด้วย BIT' };
      if (isFrag(a) || isFrag(b)) return { key: 'mix', text: 'เศษกับบล็อกเต็ม: ต่อชิ้นเศษหนึ่งชิ้น ถามตาราง F ครั้งเดียว' };
      if (a.dataset.blk === b.dataset.blk) return { key: 'same', text: `บล็อกเต็มเดียวกัน (บล็อก ${a.dataset.blk}): อ่านตาราง f ของบล็อกนั้น` };
      return { key: 'cross', text: 'บล็อกเต็มคนละบล็อก: แบบที่ยากที่สุด เล่าในตอนที่ 4' };
    }

    cells.forEach((c) => {
      c.addEventListener('click', () => {
        if (!first) {
          first = c;
          c.classList.add('picked');
          ui.setStatus(`เลือกตำแหน่ง ${c.dataset.tk} แล้ว กดอีกช่อง`, 'plain');
          return;
        }
        if (first === c) {
          c.classList.remove('picked');
          first = null;
          ui.setStatus('กดช่องแรก', 'plain');
          return;
        }
        const a = Number(first.dataset.tk) < Number(c.dataset.tk) ? first : c;
        const b = a === first ? c : first;
        const r = classify(a, b);
        found.add(r.key);
        ui.setStatus(`คู่ตำแหน่ง ${a.dataset.tk} กับ ${b.dataset.tk} · ${r.text}`, 'good');
        ui.setScore(`เจอแล้ว ${found.size} จาก 4 แบบ`);
        if (hintEl) hintEl.textContent = found.size === 4 ? 'ครบทั้งสี่แบบแล้ว สามแบบแรกนับได้ทันทีจากของที่เตรียมไว้ แบบสุดท้ายคือเรื่องของตอนที่ 4' : '';
        first.classList.remove('picked');
        first = null;
      });
    });
  }
  document.addEventListener('astro:page-load', initKindGame);

  /* เครื่องเดินการกวาดค่า ทุกตัวเลขคำนวณไว้ตอนบิลด์ในแต่ละขั้น ฝั่งนี้แค่เขียนลงช่อง */
  type SwStep = {
    note: string; vals: number[]; c: number[]; col: number[]; E: number[][];
    hotPos: number; hotBx: number; read: string; pairs: number[];
  };
  const isNumArr = (x: unknown): x is number[] => Array.isArray(x) && x.every((v) => typeof v === 'number');
  function isSwStep(x: unknown): x is SwStep {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return typeof o.note === 'string' && isNumArr(o.vals) && isNumArr(o.c) && isNumArr(o.col)
      && Array.isArray(o.E) && o.E.every(isNumArr)
      && typeof o.hotPos === 'number' && typeof o.hotBx === 'number' && typeof o.read === 'string' && isNumArr(o.pairs);
  }

  document.addEventListener('astro:page-load', () => {
    initCpPlayers<SwStep>('[data-tesweep]', {
      narrow: (raw) => {
        const ok = raw.filter(isSwStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      countWord: 'ขั้น',
      zeroBased: true,
      draw: (st, ctx) => {
        const root = ctx.parts.root;
        const tab = root.querySelector<HTMLElement>('[data-fb1]');
        const fb1 = Number(tab?.dataset.fb1 ?? -1);
        const fb2 = Number(tab?.dataset.fb2 ?? -2);
        root.querySelectorAll<HTMLTableCellElement>('[data-sw-val]').forEach((td) => {
          const k = Number(td.dataset.swVal);
          const v = st.vals[k] ?? 0;
          td.textContent = v > 0 ? String(v) : '·';
          td.classList.toggle('is-empty', v === 0);
          td.classList.toggle('is-hot', k === st.hotPos);
        });
        root.querySelectorAll<HTMLTableCellElement>('[data-sw-c]').forEach((td) => {
          const b = Number(td.dataset.swC);
          td.textContent = String(st.c[b] ?? 0);
          td.classList.toggle('is-hot', b === st.hotBx);
        });
        root.querySelectorAll<HTMLTableCellElement>('[data-sw-col]').forEach((td) => {
          const b = Number(td.dataset.swCol);
          td.textContent = String(st.col[b] ?? 0);
          td.classList.toggle('is-hot', b === st.hotBx);
          td.classList.toggle('is-read', st.read !== '' && b >= fb1 && b <= fb2);
        });
        root.querySelectorAll<HTMLTableCellElement>('[data-sw-e]').forEach((td) => {
          if (td.classList.contains('na')) return;
          const [b1, b] = (td.dataset.swE ?? '0:0').split(':').map(Number);
          td.textContent = String(st.E[b1]?.[b] ?? 0);
          td.classList.toggle('is-hot', b === st.hotBx);
          td.classList.toggle('is-read', st.read !== '' && b1 === fb1 && b <= fb2);
        });
        /* กระดานจุด: จุดที่ใส่แล้วสว่าง จุดที่เพิ่งใส่เป็นสีทอง เส้นเขียวคือคู่ใหม่ของขั้นนี้
           ตั้งสีผ่าน attribute ตรง ๆ เพราะเส้นสร้างด้วย JS สไตล์ scoped ของหน้าจับไม่ถึง */
        root.querySelectorAll<SVGCircleElement>('[data-sw-dot]').forEach((dot) => {
          const k = Number(dot.dataset.swDot);
          const on = (st.vals[k] ?? 0) > 0;
          const hot = k === st.hotPos;
          dot.setAttribute('fill', hot ? '#d4af37' : on ? '#cdd6ea' : '#141c2c');
          dot.setAttribute('stroke', hot ? '#d4af37' : on ? '#cdd6ea' : '#3a4459');
          dot.setAttribute('r', hot ? '8' : '6');
        });
        const g = root.querySelector<SVGGElement>('[data-sw-pairs]');
        const hotDot = root.querySelector<SVGCircleElement>(`[data-sw-dot="${st.hotPos}"]`);
        if (g) {
          g.replaceChildren();
          for (const p of st.pairs) {
            const other = root.querySelector<SVGCircleElement>(`[data-sw-dot="${p}"]`);
            if (!other || !hotDot) continue;
            const ln = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            ln.setAttribute('x1', other.getAttribute('cx') ?? '0');
            ln.setAttribute('y1', other.getAttribute('cy') ?? '0');
            ln.setAttribute('x2', hotDot.getAttribute('cx') ?? '0');
            ln.setAttribute('y2', hotDot.getAttribute('cy') ?? '0');
            ln.setAttribute('stroke', '#6ee7a8');
            ln.setAttribute('stroke-width', '2');
            g.appendChild(ln);
          }
        }
        ctx.keepInView(root.querySelector('[data-sw-val].is-hot'));
      },
    });
  });
</script>
