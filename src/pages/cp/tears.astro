        ))}
        {Array.from({ length: SW_N + 1 }).map((_, k) => (
          <line x1={SB_PAD} y1={SB_TOP + k * SB_CELL} x2={SB_PAD + SB_GRID} y2={SB_TOP + k * SB_CELL} stroke="#1e2738" stroke-width="1" />
        ))}
        {SW_P.map((_, k) => (
          <text x={sbX(k)} y={SB_TOP + SB_GRID + 16} text-anchor="middle" fill="#7b8397" font-size="10">{k + 1}</text>
        ))}
        {SW_P.map((_, k) => (
          <text x={SB_PAD - 6} y={sbY(k + 1) + 4} text-anchor="end" fill="#7b8397" font-size="10">{k + 1}</text>
        ))}
