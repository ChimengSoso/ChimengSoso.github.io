---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

const href = 'fifteen-puzzle/';

/* ---------- โมเดล: อัลกอริทึมเดียวกับโค้ด C++ ที่แจกท้ายบท ----------
   ทุกตัวเลขในหน้านี้ (จำนวนตาของแต่ละกระดาน, ขั้นในตัวเล่น, ป้ายบอกเฟส) งอกจากตรงนี้
   ผมเทียบผลของสองภาษานี้กับกระดานสุ่ม 400 กระดานแล้วว่าให้สตริงเดียวกันเป๊ะ */

const DR = [-1, 0, 1, 0];
const DC = [0, 1, 0, -1];
const LET = ['N', 'E', 'S', 'W'];

type Phase = { name: string; short: string; count: number; until: number; lock: boolean[] };
type Solved = { moves: string; phases: Phase[] };

function solve(startBoard: number[]): Solved {
  const g = startBoard.slice();
  const lock = new Array<boolean>(16).fill(false);
  let bl = g.indexOf(0);
  const moves: string[] = [];
  const phases: Phase[] = [];

  const nb = (p: number, d: number): number => {
    const r = ((p / 4) | 0) + DR[d];
    const c = (p % 4) + DC[d];
    if (r < 0 || r > 3 || c < 0 || c > 3) return -1;
    const q = r * 4 + c;
    return lock[q] ? -1 : q;
  };
  const apply = (d: number): void => {
    const q = nb(bl, d);
    g[bl] = g[q];
    g[q] = 0;
    bl = q;
    moves.push(LET[d]);
  };

  // เฟสวางหมากทีละตัว: ค้นบนสถานะ (ช่องของหมาก, ช่องว่าง) = 256 แบบ
  function placeOne(v: number, goal: number): number {
    const start = g.indexOf(v) * 16 + bl;
    const from = new Int32Array(256).fill(-2);
    const dir = new Int8Array(256).fill(-1);
    from[start] = -1;
    const q: number[] = [start];
    let end = -1;
    for (let h = 0; h < q.length && end < 0; h++) {
      const s = q[h];
      const tp = (s / 16) | 0;
      const bp = s % 16;
      if (tp === goal) { end = s; break; }
      for (let d = 0; d < 4; d++) {
        const np = nb(bp, d);
        if (np < 0) continue;
        const ntp = np === tp ? bp : tp;
        const ns = ntp * 16 + np;
        if (from[ns] !== -2) continue;
        from[ns] = s;
        dir[ns] = d;
        q.push(ns);
      }
    }
    const path: number[] = [];
    for (let s = end; from[s] !== -1; s = from[s]) path.push(dir[s]);
    path.reverse();
    path.forEach(apply);
    lock[goal] = true;
    return path.length;
  }

  // เฟสวางหมากสองตัวพร้อมกัน: ค้นบนสถานะ (ช่อง A, ช่อง B, ช่องว่าง) = 4096 แบบ
  function placePair(va: number, vb: number, ga: number, gb: number): number {
    const enc = (a: number, b: number, c: number): number => (a * 16 + b) * 16 + c;
    const start = enc(g.indexOf(va), g.indexOf(vb), bl);
    const from = new Int32Array(4096).fill(-2);
    const dir = new Int8Array(4096).fill(-1);
    from[start] = -1;
    const q: number[] = [start];
    let end = -1;
    for (let h = 0; h < q.length && end < 0; h++) {
      const s = q[h];
      const ap = (s / 256) | 0;
      const bp = ((s / 16) | 0) % 16;
      const bk = s % 16;
      if (ap === ga && bp === gb) { end = s; break; }
      for (let d = 0; d < 4; d++) {
        const np = nb(bk, d);
        if (np < 0) continue;
        const nap = np === ap ? bk : ap;
        const nbp = np === bp ? bk : bp;
        const ns = enc(nap, nbp, np);
        if (from[ns] !== -2) continue;
        from[ns] = s;
        dir[ns] = d;
        q.push(ns);
      }
    }
    const path: number[] = [];
    for (let s = end; from[s] !== -1; s = from[s]) path.push(dir[s]);
    path.reverse();
    path.forEach(apply);
    lock[ga] = true;
    lock[gb] = true;
    return path.length;
  }

  // เฟสสุดท้าย: สองแถวล่างมีแปดช่อง เรียงได้ 8! = 40320 แบบ ค้นทีเดียวจบ
  const FCT = [1, 1, 2, 6, 24, 120, 720, 5040, 40320];
  const rankPerm = (a: number[]): number => {
    let r = 0;
    for (let i = 0; i < 8; i++) {
      let less = 0;
      for (let j = i + 1; j < 8; j++) if (a[j] < a[i]) less++;
      r += less * FCT[7 - i];
    }
    return r;
  };
  const unrankPerm = (rk: number): number[] => {
    const pool = [0, 1, 2, 3, 4, 5, 6, 7];
    const a: number[] = [];
    let r = rk;
    for (let i = 0; i < 8; i++) {
      const k = (r / FCT[7 - i]) | 0;
      r %= FCT[7 - i];
      a.push(pool[k]);
      pool.splice(k, 1);
    }
    return a;
  };

  function finishBottom(): number {
    const cur: number[] = [];
    for (let i = 0; i < 8; i++) cur.push(g[8 + i] === 0 ? 7 : g[8 + i] - 9);
    const start = rankPerm(cur);
    const target = rankPerm([0, 1, 2, 3, 4, 5, 6, 7]);
    const from = new Int32Array(40320).fill(-2);
    const dir = new Int8Array(40320).fill(-1);
    from[start] = -1;
    const q: number[] = [start];
    for (let h = 0; h < q.length; h++) {
      const s = q[h];
      if (s === target) break;
      const a = unrankPerm(s);
      const z = a.indexOf(7);
      for (let d = 0; d < 4; d++) {
        const nr = ((z / 4) | 0) + DR[d];
        const nc = (z % 4) + DC[d];
        if (nr < 0 || nr > 1 || nc < 0 || nc > 3) continue;
        const nz = nr * 4 + nc;
        const b = a.slice();
        b[z] = a[nz];
        b[nz] = a[z];
        const ns = rankPerm(b);
        if (from[ns] !== -2) continue;
        from[ns] = s;
        dir[ns] = d;
        q.push(ns);
      }
    }
    const path: number[] = [];
    for (let s = target; from[s] !== -1; s = from[s]) path.push(dir[s]);
    path.reverse();
    path.forEach(apply);
    return path.length;
  }

  const mark = (name: string, short: string, n: number): void => {
    phases.push({ name, short, count: n, until: moves.length, lock: lock.slice() });
  };

  for (let r = 0; r < 2; r++) {
    mark(`วางหมาก ${4 * r + 1} เข้าที่`, `หมาก ${4 * r + 1}`, placeOne(4 * r + 1, r * 4));
    mark(`วางหมาก ${4 * r + 2} เข้าที่`, `หมาก ${4 * r + 2}`, placeOne(4 * r + 2, r * 4 + 1));
    mark(
      `วางหมาก ${4 * r + 3} กับ ${4 * r + 4} พร้อมกัน`,
      `หมาก ${4 * r + 3}+${4 * r + 4}`,
      placePair(4 * r + 3, 4 * r + 4, r * 4 + 2, r * 4 + 3),
    );
  }
  mark('สองแถวล่างที่เหลือ ค้นทีเดียวจบ', 'สองแถวล่าง', finishBottom());

  return { moves: moves.join(''), phases };
}

const parse = (rows: string): number[] => rows.trim().split(/\s+/).map(Number);

const SAMPLE = parse('1 2 8 3  5 7 10 4  9 6 11 0  13 14 15 12');
const DEMO = parse('12 1 6 4  3 0 2 10  5 9 8 7  13 11 14 15');
const HARD = parse('14 1 2 3  5 6 7 4  9 12 0 13  10 11 8 15');

const sampleSolved = solve(SAMPLE);
const demoSolved = solve(DEMO);
const hardSolved = solve(HARD);

/* ตัวเลขที่วัดมาจริง ไม่ใช่ประมาณเอา (รายละเอียดวิธีวัดอยู่ในเนื้อหา) */
const STATES_ALL = 10461394944000; // 16! / 2
const LIMIT_MOVES = 5000;
const BOUND_TOTAL = 165; // ผลรวมของระยะไกลสุดของแต่ละเฟส คำนวณด้วย BFS ถอยหลัง
const BOUND_PARTS = [21, 17, 32, 17, 13, 29, 36];
const TESTED_BOARDS = 31000;
const OBSERVED_MAX = 135;
const OBSERVED_AVG = '85';

/* ---------- ขั้นของตัวเล่น: เดินกระดานเดโมทีละตา ---------- */

type Step = { board: number[]; lock: boolean[]; letter: string; phase: string; note: string; idx: number };

function buildSteps(start: number[], sol: Solved): Step[] {
  const g = start.slice();
  let bl = g.indexOf(0);
  const steps: Step[] = [];
  const phaseAt = (i: number): Phase => sol.phases.find((p) => i <= p.until) ?? sol.phases[sol.phases.length - 1];
  const lockBefore = (i: number): boolean[] => {
    let out = new Array<boolean>(16).fill(false);
    for (const p of sol.phases) {
      if (p.until <= i) out = p.lock.slice();
    }
    return out;
  };

  steps.push({
    board: g.slice(),
    lock: new Array<boolean>(16).fill(false),
    letter: '',
    phase: sol.phases[0].name,
    note: `กระดานเริ่มต้น ยังไม่มีหมากตัวไหนถูกล็อก โปรแกรมจะเดินทั้งหมด ${sol.moves.length} ตา`,
    idx: 0,
  });

  [...sol.moves].forEach((ch, i) => {
    const d = LET.indexOf(ch);
    const r = ((bl / 4) | 0) + DR[d];
    const c = (bl % 4) + DC[d];
    const q = r * 4 + c;
    const moved = g[q];
    g[bl] = g[q];
    g[q] = 0;
    bl = q;
    const ph = phaseAt(i + 1);
    steps.push({
      board: g.slice(),
      lock: lockBefore(i + 1),
      letter: ch,
      phase: ph.name,
      note: `ตาที่ ${i + 1} ตัวอักษร <b>${ch}</b> แปลว่าหมากที่อยู่ทาง${
        { N: 'เหนือ', E: 'ตะวันออก', S: 'ใต้', W: 'ตะวันตก' }[ch]
      }ของช่องว่างเลื่อนเข้ามาแทน คราวนี้คือหมากหมายเลข ${moved}`,
      idx: i + 1,
    });
  });

  return steps;
}

const demoSteps = buildSteps(DEMO, demoSolved);

const games = [
  { label: 'กระดานตัวอย่าง', board: SAMPLE, best: sampleSolved.moves.length },
  { label: 'กระดานเดโม', board: DEMO, best: demoSolved.moves.length },
  { label: 'กระดานที่ยุ่งกว่า', board: HARD, best: hardSolved.moves.length },
];

/* ---------- โค้ด ---------- */

const solution = `#include <bits/stdc++.h>
using namespace std;

int g[16];              // g[i] = หมายเลขหมากในช่อง i (0 = ช่องว่าง)
bool lockd[16];         // ช่องที่เข้าที่แล้ว ห้ามแตะอีก
int bl;                 // ช่องว่างอยู่ที่ไหน
string ans;

const int DR[4] = {-1, 0, 1, 0};
const int DC[4] = {0, 1, 0, -1};
const char LET[4] = {'N', 'E', 'S', 'W'};   // ทิศที่ "ช่องว่าง" ขยับไป

// ช่องปลายทางเมื่อช่องว่างที่ p ขยับไปทาง d (คืน -1 ถ้าตกขอบหรือชนช่องที่ล็อกไว้)
int nb(int p, int d) {
    int r = p / 4 + DR[d], c = p % 4 + DC[d];
    if (r < 0 || r > 3 || c < 0 || c > 3) return -1;
    int q = r * 4 + c;
    return lockd[q] ? -1 : q;
}

void apply1(int d) {
    int q = nb(bl, d);
    g[bl] = g[q];
    g[q] = 0;
    bl = q;
    ans += LET[d];
}

// วางหมากตัวเดียว: สถานะคือ (ช่องของหมาก, ช่องว่าง) มีไม่เกิน 16 x 16 แบบ
void placeOne(int v, int goal) {
    int start = (int)(find(g, g + 16, v) - g) * 16 + bl;
    vector<int> from(256, -2);
    vector<char> dir(256, -1);
    from[start] = -1;
    queue<int> q;
    q.push(start);
    int end = -1;
    while (!q.empty()) {
        int s = q.front(); q.pop();
        int tp = s >> 4, bp = s & 15;
        if (tp == goal) { end = s; break; }
        for (int d = 0; d < 4; d++) {
            int np = nb(bp, d);
            if (np < 0) continue;
            int ntp = (np == tp) ? bp : tp;      // ช่องว่างเดินทับหมาก = หมากถูกดันมาที่เดิมของช่องว่าง
            int ns = ntp * 16 + np;
            if (from[ns] != -2) continue;
            from[ns] = s; dir[ns] = (char)d;
            q.push(ns);
        }
    }
    vector<int> path;
    for (int s = end; from[s] != -1; s = from[s]) path.push_back(dir[s]);
    reverse(path.begin(), path.end());
    for (int d : path) apply1(d);
    lockd[goal] = true;
}

// วางหมากสองตัวท้ายแถวพร้อมกัน: สถานะคือ (ช่อง A, ช่อง B, ช่องว่าง) มีไม่เกิน 16^3 แบบ
void placePair(int va, int vb, int ga, int gb) {
    int pa = (int)(find(g, g + 16, va) - g), pb = (int)(find(g, g + 16, vb) - g);
    int start = (pa * 16 + pb) * 16 + bl;
    vector<int> from(4096, -2);
    vector<char> dir(4096, -1);
    from[start] = -1;
    queue<int> q;
    q.push(start);
    int end = -1;
    while (!q.empty()) {
        int s = q.front(); q.pop();
        int ap = s >> 8, bp = (s >> 4) & 15, bk = s & 15;
        if (ap == ga && bp == gb) { end = s; break; }
        for (int d = 0; d < 4; d++) {
            int np = nb(bk, d);
            if (np < 0) continue;
            int nap = (np == ap) ? bk : ap;
            int nbp = (np == bp) ? bk : bp;
            int ns = (nap * 16 + nbp) * 16 + np;
            if (from[ns] != -2) continue;
            from[ns] = s; dir[ns] = (char)d;
            q.push(ns);
        }
    }
    vector<int> path;
    for (int s = end; from[s] != -1; s = from[s]) path.push_back(dir[s]);
    reverse(path.begin(), path.end());
    for (int d : path) apply1(d);
    lockd[ga] = lockd[gb] = true;
}

// สองแถวล่างที่เหลือ: แปดช่อง เรียงได้ 8! = 40320 แบบ ค้นทีเดียวจบ
int fct[9];

int rankPerm(const int a[8]) {
    int r = 0;
    for (int i = 0; i < 8; i++) {
        int less = 0;
        for (int j = i + 1; j < 8; j++) if (a[j] < a[i]) less++;
        r += less * fct[7 - i];
    }
    return r;
}

void unrankPerm(int r, int a[8]) {
    int pool[8] = {0, 1, 2, 3, 4, 5, 6, 7}, n = 8;
    for (int i = 0; i < 8; i++) {
        int k = r / fct[7 - i];
        r %= fct[7 - i];
        a[i] = pool[k];
        for (int j = k; j < n - 1; j++) pool[j] = pool[j + 1];
        n--;
    }
}

void finishBottom() {
    fct[0] = 1;
    for (int i = 1; i <= 8; i++) fct[i] = fct[i - 1] * i;

    int cur[8], goal[8];
    for (int i = 0; i < 8; i++) {
        cur[i] = g[8 + i] == 0 ? 7 : g[8 + i] - 9;   // ช่องว่างเป็นเลข 7 หมาก 9..15 เป็น 0..6
        goal[i] = i;
    }
    int start = rankPerm(cur), target = rankPerm(goal);

    vector<int> from(40320, -2);
    vector<char> dir(40320, -1);
    from[start] = -1;
    queue<int> q;
    q.push(start);
    while (!q.empty()) {
        int s = q.front(); q.pop();
        if (s == target) break;
        int a[8];
        unrankPerm(s, a);
        int z = 0;
        while (a[z] != 7) z++;
        for (int d = 0; d < 4; d++) {
            int nr = z / 4 + DR[d], nc = z % 4 + DC[d];
            if (nr < 0 || nr > 1 || nc < 0 || nc > 3) continue;   // ขยับได้เฉพาะในกระดานย่อยสองแถว
            int nz = nr * 4 + nc;
            int b[8];
            memcpy(b, a, sizeof b);
            swap(b[z], b[nz]);
            int ns = rankPerm(b);
            if (from[ns] != -2) continue;
            from[ns] = s; dir[ns] = (char)d;
            q.push(ns);
        }
    }
    vector<int> path;
    for (int s = target; from[s] != -1; s = from[s]) path.push_back(dir[s]);
    reverse(path.begin(), path.end());
    for (int d : path) apply1(d);
}

int main() {
    for (int i = 0; i < 16; i++) {
        if (!(cin >> g[i])) return 0;
        if (g[i] == 0) bl = i;
    }

    for (int r = 0; r < 2; r++) {
        placeOne(4 * r + 1, r * 4 + 0);
        placeOne(4 * r + 2, r * 4 + 1);
        placePair(4 * r + 3, 4 * r + 4, r * 4 + 2, r * 4 + 3);
    }
    finishBottom();

    cout << ans << '\\n';
    return 0;
}`;

const checkerCode = `// ตัวตรวจ: รับกระดานกับสตริงคำตอบ แล้วเดินตามจริงว่าจบที่สถานะสิ้นสุดไหม
// ใช้คู่กับตัวสุ่มกระดาน (สุ่มโดยเดินถอยจากสถานะสิ้นสุด กระดานที่ได้จึงแก้ได้เสมอ)
const D = { N: [-1, 0], E: [0, 1], S: [1, 0], W: [0, -1] };

function check(board, moves) {
  const g = board.slice();
  let b = g.indexOf(0);
  for (const ch of moves) {
    if (!(ch in D)) return \`มีอักษรที่ไม่ใช่ N E W S: \${ch}\`;
    const r = ((b / 4) | 0) + D[ch][0];
    const c = (b % 4) + D[ch][1];
    if (r < 0 || r > 3 || c < 0 || c > 3) return 'เลื่อนออกนอกกระดาน';
    const k = r * 4 + c;
    g[b] = g[k];
    g[k] = 0;
    b = k;
  }
  for (let i = 0; i < 15; i++) if (g[i] !== i + 1) return 'ยังไม่ถึงสถานะสิ้นสุด';
  return g[15] === 0 ? null : 'ยังไม่ถึงสถานะสิ้นสุด';
}`;

const boundCode = `// หาขอบบนของจำนวนตา: BFS ถอยหลังจากเป้าหมายของแต่ละเฟส
// แล้วดูว่าสถานะที่ไกลที่สุดในเฟสนั้นห่างกี่ตา เอาทุกเฟสมาบวกกัน
int eccOne(int goal) {              // เฟสวางหมากตัวเดียว
    vector<int> dist(256, -1);
    queue<int> q;
    for (int b = 0; b < 16; b++) {  // ปลายทางคือ "หมากถึงที่แล้ว" ช่องว่างอยู่ไหนก็ได้
        if (lockd[b] || b == goal) continue;
        dist[goal * 16 + b] = 0;
        q.push(goal * 16 + b);
    }
    int mx = 0;
    while (!q.empty()) {
        int s = q.front(); q.pop();
        mx = max(mx, dist[s]);
        int tp = s >> 4, bp = s & 15;
        for (int d = 0; d < 4; d++) {
            int np = nb(bp, d);
            if (np < 0) continue;
            int ns = ((np == tp) ? bp : tp) * 16 + np;
            if (dist[ns] != -1) continue;
            dist[ns] = dist[s] + 1;
            q.push(ns);
        }
    }
    return mx;                      // ไกลสุดของเฟสนี้
}`;

const fmtInt = (n: number): string => n.toLocaleString('en-US');
