<script>
  // ตัวเล่นเดินกระดานทีละตา ขั้นทั้งหมดถูกสร้างไว้ตอน build แล้วส่งมาทาง data-steps
  type Step = { board: number[]; lock: boolean[]; letter: string; phase: string; note: string; idx: number };
  type PhaseInfo = { short: string; until: number; count: number };

  const PLAY_MS = 700;

  function isStep(v: unknown): v is Step {
    if (typeof v !== 'object' || v === null) return false;
    const o = v as Record<string, unknown>;
    return Array.isArray(o.board) && Array.isArray(o.lock) && typeof o.note === 'string';
  }
  function isPhase(v: unknown): v is PhaseInfo {
    if (typeof v !== 'object' || v === null) return false;
    const o = v as Record<string, unknown>;
    return typeof o.short === 'string' && typeof o.until === 'number' && typeof o.count === 'number';
  }

  function initSim(root: HTMLElement) {
    if (root.dataset.wired === '1') return;
    root.dataset.wired = '1';

    const rawSteps: unknown = JSON.parse(root.dataset.steps ?? '[]');
    const rawPhases: unknown = JSON.parse(root.dataset.phases ?? '[]');
    const steps: Step[] = Array.isArray(rawSteps) ? rawSteps.filter(isStep) : [];
    const phases: PhaseInfo[] = Array.isArray(rawPhases) ? rawPhases.filter(isPhase) : [];
    if (steps.length === 0) return;

    const board = root.querySelector<HTMLElement>('.sim-board');
    const bars = root.querySelector<HTMLElement>('.sim-bars');
    const phaseEl = root.querySelector<HTMLElement>('.sim-phase');
    const say = root.querySelector<HTMLElement>('.dps-say');
    const range = root.querySelector<HTMLInputElement>('.dps-range');
    const count = root.querySelector<HTMLElement>('.dps-count');
    const playBtn = root.querySelector<HTMLButtonElement>('.dps-play');
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('.dps-b'));
    if (!board || !bars || !phaseEl || !say || !range || !count || !playBtn) return;

    const cells: HTMLElement[] = [];
    for (let i = 0; i < 16; i++) {
      const el = document.createElement('div');
      el.className = 'cell';
      board.appendChild(el);
      cells.push(el);
    }
    const barEls: HTMLElement[] = phases.map((p) => {
      const el = document.createElement('div');
      el.className = 'pbar';
      el.innerHTML = `<span>${p.short}</span><b>${p.count}</b>`;
      bars.appendChild(el);
      return el;
    });

    range.max = String(steps.length - 1);
    let at = 0;
    let timer: number | null = null;

    const render = () => {
      const st = steps[at];
      const prev = at > 0 ? steps[at - 1] : null;
      for (let i = 0; i < 16; i++) {
        const v = st.board[i];
        const el = cells[i];
        el.textContent = v === 0 ? '' : String(v);
        el.className = 'cell';
        if (v === 0) el.classList.add('blank');
        else if (st.lock[i]) el.classList.add('locked');
        else if (prev && prev.board[i] !== v && v !== 0) el.classList.add('moved');
      }
      phaseEl.textContent = st.phase;
      barEls.forEach((el, i) => {
        el.className = 'pbar';
        const startAt = i === 0 ? 0 : phases[i - 1].until;
        if (st.idx > phases[i].until) el.classList.add('done');
        else if (st.idx > startAt || (st.idx === 0 && i === 0)) el.classList.add('now');
      });
      say.innerHTML = st.note;
      range.value = String(at);
      count.textContent = `ตา ${at} / ${steps.length - 1}`;
      for (const b of btns) {
        const act = b.dataset.act;
        if (act === 'prev' || act === 'first') b.disabled = at === 0;
        if (act === 'next' || act === 'last') b.disabled = at === steps.length - 1;
      }
    };

    const stop = () => {
      if (timer !== null) window.clearInterval(timer);
      timer = null;
      playBtn.textContent = 'เล่น';
    };
    const go = (to: number) => {
      at = Math.max(0, Math.min(steps.length - 1, to));
      if (at === steps.length - 1) stop();
      render();
    };

    for (const b of btns) {
      b.addEventListener('click', () => {
        const act = b.dataset.act;
        if (act === 'play') {
          if (timer !== null) { stop(); return; }
          if (at === steps.length - 1) at = 0;
          playBtn.textContent = 'หยุด';
          timer = window.setInterval(() => go(at + 1), PLAY_MS);
          go(at + 1);
          return;
        }
        stop();
        if (act === 'first') go(0);
        else if (act === 'prev') go(at - 1);
        else if (act === 'next') go(at + 1);
        else if (act === 'last') go(steps.length - 1);
      });
    }

    range.addEventListener('input', () => { stop(); go(Number(range.value)); });
    root.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') { stop(); go(at + 1); e.preventDefault(); }
      else if (e.key === 'ArrowLeft') { stop(); go(at - 1); e.preventDefault(); }
    });

    document.addEventListener('astro:before-swap', stop, { once: true });
    render();
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-pzsim]').forEach(initSim);
  });
</script>

<script>
  // เกมเล่นเอง: กดหมากที่ติดช่องว่างเพื่อเลื่อน จำนวนตาที่โปรแกรมใช้เป็นค่าคงที่ที่คิดไว้ตอน build
  // (ไม่ส่งตัวแก้ปริศนาลงหน้าเว็บ เพราะเฉลยข้างล่างคือตัวแก้ปริศนาอยู่แล้ว)
  type Game = { label: string; board: number[]; best: number };

  function isGame(v: unknown): v is Game {
    if (typeof v !== 'object' || v === null) return false;
    const o = v as Record<string, unknown>;
    return typeof o.label === 'string' && Array.isArray(o.board) && typeof o.best === 'number';
  }

  function initGame(root: HTMLElement) {
    if (root.dataset.wired === '1') return;
    root.dataset.wired = '1';

    const parsed: unknown = JSON.parse(root.dataset.games ?? '[]');
    const games: Game[] = Array.isArray(parsed) ? parsed.filter(isGame) : [];
    if (games.length === 0) return;

    const boardEl = root.querySelector<HTMLElement>('.pz-board');
    const nEl = root.querySelector<HTMLElement>('.pz-n');
    const sayEl = root.querySelector<HTMLElement>('.pz-say');
    const movesEl = root.querySelector<HTMLElement>('.pz-moves');
    const setBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.pz-set'));
    const acts = Array.from(root.querySelectorAll<HTMLButtonElement>('.pz-b'));
    if (!boardEl || !nEl || !sayEl || !movesEl) return;

    const LETTER = ['N', 'E', 'S', 'W'];
    const DR = [-1, 0, 1, 0];
    const DC = [0, 1, 0, -1];

    let idx = 0;
    let board: number[] = games[0].board.slice();
    let hole = board.indexOf(0);
    let letters: string[] = [];
    const history: { board: number[]; hole: number }[] = [];

    const tiles: HTMLButtonElement[] = [];
    for (let i = 0; i < 16; i++) {
      const el = document.createElement('button');
      el.type = 'button';
      el.className = 'tile';
      el.addEventListener('click', () => tap(i));
      boardEl.appendChild(el);
      tiles.push(el);
    }

    const solved = (): boolean => {
      for (let i = 0; i < 15; i++) if (board[i] !== i + 1) return false;
      return board[15] === 0;
    };

    const dirFromHole = (i: number): number => {
      for (let d = 0; d < 4; d++) {
        const r = ((hole / 4) | 0) + DR[d];
        const c = (hole % 4) + DC[d];
        if (r >= 0 && r < 4 && c >= 0 && c < 4 && r * 4 + c === i) return d;
      }
      return -1;
    };

    function tap(i: number) {
      const d = dirFromHole(i);
      if (d < 0 || solved()) return;
      history.push({ board: board.slice(), hole });
      board[hole] = board[i];
      board[i] = 0;
      hole = i;
      letters.push(LETTER[d]);
      render();
    }

    const render = () => {
      for (let i = 0; i < 16; i++) {
        const v = board[i];
        const el = tiles[i];
        el.textContent = v === 0 ? '' : String(v);
        el.className = 'tile';
        if (v === 0) {
          el.classList.add('hole');
          el.disabled = true;
        } else {
          el.disabled = false;
          if (v === i + 1) el.classList.add('home');
          if (dirFromHole(i) >= 0) el.classList.add('can');
        }
        el.setAttribute('aria-label', v === 0 ? 'ช่องว่าง' : `หมากหมายเลข ${v}`);
      }
      nEl.textContent = String(letters.length);
      movesEl.textContent = letters.join('');
      const g = games[idx];
      if (solved()) {
        sayEl.innerHTML = `<span class="win">แก้ได้แล้วใน ${letters.length} ตา</span> โปรแกรมในเฉลยใช้ ${g.best} ตากับกระดานใบนี้`;
      } else {
        sayEl.textContent = 'กดหมากที่อยู่ติดช่องว่างเพื่อเลื่อนมันเข้ามา';
      }
      for (const b of acts) {
        if (b.dataset.act === 'undo') b.disabled = history.length === 0;
        if (b.dataset.act === 'reset') b.disabled = letters.length === 0;
      }
      setBtns.forEach((b, i) => b.setAttribute('aria-pressed', i === idx ? 'true' : 'false'));
    };

    const load = (i: number) => {
      idx = i;
      board = games[i].board.slice();
      hole = board.indexOf(0);
      letters = [];
      history.length = 0;
      render();
    };

    for (const b of acts) {
      b.addEventListener('click', () => {
        if (b.dataset.act === 'undo') {
          const prev = history.pop();
          if (!prev) return;
          board = prev.board;
          hole = prev.hole;
          letters.pop();
          render();
        } else {
          load(idx);
        }
      });
    }
    setBtns.forEach((b, i) => b.addEventListener('click', () => load(i)));

    load(0);
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-puzzlegame]').forEach(initGame);
  });
</script>
