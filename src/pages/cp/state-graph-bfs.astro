<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type JgPuzzle = { id: string; label: string; tease: string; x: number; y: number; z: number; best: number };

  function initJugGame(): void {
    const maybeUi = cpGameUi('[data-juggame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as JgPuzzle[];
    if (puzzles.length === 0) return;

    const aFill = ui.root.querySelector<HTMLElement>('[data-jg-a]');
    const bFill = ui.root.querySelector<HTMLElement>('[data-jg-b]');
    const aCap = ui.root.querySelector<HTMLElement>('[data-jg-acap]');
    const bCap = ui.root.querySelector<HTMLElement>('[data-jg-bcap]');
    const movesEl = ui.root.querySelector<HTMLElement>('[data-jg-moves]');
    const goalEl = ui.root.querySelector<HTMLElement>('[data-jg-goal]');
    if (!aFill || !bFill || !aCap || !bCap || !movesEl || !goalEl) return;
    const jarA: HTMLElement = aFill;
    const jarB: HTMLElement = bFill;
    const capA: HTMLElement = aCap;
    const capB: HTMLElement = bCap;
    const movesOut: HTMLElement = movesEl;
    const goalOut: HTMLElement = goalEl;

    let pi = 0;
    let a = 0;
    let b = 0;
    let moves = 0;

    const pz = (): JgPuzzle => puzzles[pi];

    function render(): void {
      const p = pz();
      jarA.style.height = `${(a / p.x) * 100}%`;
      jarB.style.height = `${(b / p.y) * 100}%`;
      jarA.dataset.v = String(a);
      jarB.dataset.v = String(b);
      capA.textContent = `${a} / ${p.x}`;
      capB.textContent = `${b} / ${p.y}`;
      movesOut.textContent = String(moves);
      goalOut.textContent = String(p.z);
      const hit = a === p.z || b === p.z;
      jarA.classList.toggle('hit', a === p.z);
      jarB.classList.toggle('hit', b === p.z);
      if (hit) {
        if (moves === p.best) {
          ui.setStatus(`ได้ ${p.z} ลิตรพอดีด้วย ${moves} ท่า ซึ่งน้อยที่สุดแล้ว`, 'good');
        } else {
          ui.setStatus(`ได้ ${p.z} ลิตรแล้ว แต่ใช้ ${moves} ท่า ยังมีทางที่ใช้แค่ ${p.best} ท่า`, 'bad');
        }
      }
    }

    function act(kind: string): void {
      const p = pz();
      if (kind === 'fillA') a = p.x;
      else if (kind === 'fillB') b = p.y;
      else if (kind === 'emptyA') a = 0;
      else if (kind === 'emptyB') b = 0;
      else if (kind === 'AtoB') {
        const t = Math.min(a, p.y - b);
        a -= t;
        b += t;
      } else if (kind === 'BtoA') {
        const t = Math.min(b, p.x - a);
        b -= t;
        a += t;
      }
      moves++;
      ui.setStatus('เติม เททิ้ง หรือเทใส่กัน ทีละท่า จนกว่าจะมีใบไหนได้ปริมาณที่ขอ');
      render();
    }

    function sayImpossible(): void {
      const p = pz();
      if (p.best === -1) {
        ui.setStatus(`ถูกต้องครับ ${p.z} ลิตรตวงไม่ได้เลยด้วยเหยือก ${p.x} กับ ${p.y}`, 'good');
      } else {
        ui.setStatus(`ตวงได้ครับ มีทางที่ใช้ ${p.best} ท่า ลองใหม่อีกที`, 'bad');
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      a = 0;
      b = 0;
      moves = 0;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ui.setStatus('เติม เททิ้ง หรือเทใส่กัน ทีละท่า จนกว่าจะมีใบไหนได้ปริมาณที่ขอ');
      render();
    }

    for (const kind of ['fillA', 'fillB', 'emptyA', 'emptyB', 'AtoB', 'BtoA']) {
      ui.onClick(`data-jg-${kind}`, () => act(kind));
    }
    ui.onClick('data-jg-reset', () => selectPuzzle(pi));
    ui.onClick('data-jg-none', sayImpossible);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initJugGame);
</script>
