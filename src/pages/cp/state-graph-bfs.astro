const href = 'state-graph-bfs/';

/* ---------- โมเดลกลาง ทุกตัวเลขและทุกภาพในหน้านี้งอกจากตรงนี้ ---------- */

/* เหยือกน้ำสองใบ ใช้เป็นตัวอย่างเดินเรื่องทั้งบท */
const JUG_X = 3;
const JUG_Y = 5;
const JUG_Z = 4;

type Jug = [number, number];
const jugId = (a: number, b: number): number => a * (JUG_Y + 1) + b;

/** ท่าที่ทำได้จากสถานะหนึ่ง เติมเต็มสองแบบ เททิ้งสองแบบ เทใส่กันสองแบบ */
function jugMoves([a, b]: Jug): Jug[] {
  const t = Math.min(a, JUG_Y - b);
  const t2 = Math.min(b, JUG_X - a);
  return [
    [JUG_X, b],
    [a, JUG_Y],
    [0, b],
    [a, 0],
    [a - t, b + t],
    [a + t2, b - t2],
  ];
}
const MOVE_NAMES = [
  'เติมใบเล็กให้เต็ม',
  'เติมใบใหญ่ให้เต็ม',
  'เททิ้งใบเล็ก',
  'เททิ้งใบใหญ่',
  'เทใบเล็กใส่ใบใหญ่',
  'เทใบใหญ่ใส่ใบเล็ก',
];

/** ค้นตามความกว้าง คืนชั้นของสถานะทั้งหมดที่ไปถึงได้ */
function jugLayers(): { layers: Jug[][]; dist: number[] } {
  const dist = new Array<number>((JUG_X + 1) * (JUG_Y + 1)).fill(-1);
  const layers: Jug[][] = [];
  const q: Jug[] = [[0, 0]];
  dist[jugId(0, 0)] = 0;
  for (let head = 0; head < q.length; head++) {
    const cur = q[head];
    const d = dist[jugId(cur[0], cur[1])];
    (layers[d] = layers[d] ?? []).push(cur);
    for (const nx of jugMoves(cur))
      if (dist[jugId(nx[0], nx[1])] === -1) {
        dist[jugId(nx[0], nx[1])] = d + 1;
        q.push(nx);
      }
  }
  return { layers, dist };
}
const { layers: JUG_LAYERS, dist: JUG_DIST } = jugLayers();

const jugTotal = (JUG_X + 1) * (JUG_Y + 1);
const jugReachable = JUG_DIST.filter((d) => d >= 0).length;
/** ชั้นแรกที่มีเหยือกใบไหนสักใบเก็บน้ำได้ Z ลิตรพอดี */
const jugAnswerLayer = JUG_LAYERS.findIndex((l) => l.some(([a, b]) => a === JUG_Z || b === JUG_Z));
const jugAnswerState = JUG_LAYERS[jugAnswerLayer].find(([a, b]) => a === JUG_Z || b === JUG_Z) as Jug;

/** เดินย้อนจากคำตอบกลับไปหาจุดเริ่ม เพื่อเล่าว่าหกท่าคืออะไรบ้าง */
function jugPath(goal: Jug): { from: Jug; move: string; to: Jug }[] {
  const steps: { from: Jug; move: string; to: Jug }[] = [];
  let cur = goal;
  while (JUG_DIST[jugId(cur[0], cur[1])] > 0) {
    const d = JUG_DIST[jugId(cur[0], cur[1])];
    let found: { from: Jug; move: string; to: Jug } | null = null;
    for (let a = 0; a <= JUG_X && !found; a++)
      for (let b = 0; b <= JUG_Y && !found; b++) {
        if (JUG_DIST[jugId(a, b)] !== d - 1) continue;
        jugMoves([a, b]).forEach((nx, k) => {
          if (!found && nx[0] === cur[0] && nx[1] === cur[1])
            found = { from: [a, b], move: MOVE_NAMES[k], to: cur };
        });
      }
    if (!found) break;
    steps.push(found);
    cur = (found as { from: Jug }).from;
  }
  return steps.reverse();
}
const JUG_PATH = jugPath(jugAnswerState);

/* ---------- ตารางขนาดสถานะของโจทย์ต่าง ๆ ---------- */

/** 16! หารสอง คือจำนวนหน้าตาที่ปริศนา 15 เป็นไปได้ */
const factorial16 = (() => {
  let f = 1n;
  for (let i = 2n; i <= 16n; i++) f *= i;
  return f;
})();
const puzzleStates = factorial16 / 2n;

const sizeRows = [
  { name: 'กริด 1000 × 1000', state: 'ตำแหน่ง (แถว, คอลัมน์)', count: BigInt(1000 * 1000) },
  { name: `เหยือกน้ำ ${JUG_X} กับ ${JUG_Y} ลิตร`, state: 'ปริมาณน้ำในเหยือกทั้งสองใบ', count: BigInt(jugTotal) },
  { name: 'ล็อกรหัสสี่หลัก', state: 'ตัวเลขสี่หลักที่วงล้อชี้อยู่', count: 10000n },
  { name: 'ปริศนา 15', state: 'ตำแหน่งของเบี้ยทั้ง 16 ช่อง', count: puzzleStates },
];

const fmt = (n: number | bigint): string => n.toLocaleString('en-US');

/* ---------- ตัวช่วยวาดกราฟชั้น ---------- */

const COL = 68;
const ROW_H = 52;
const PAD_L = 30;
const TOP = 44;
const MAXROW = Math.max(...JUG_LAYERS.map((l) => l.length));
const G_W = PAD_L * 2 + JUG_LAYERS.length * COL;
const G_H = TOP + MAXROW * ROW_H + 46;

/** ตำแหน่งกลางของสถานะหนึ่งบนภาพ */
function nodePos(d: number, k: number): { x: number; y: number } {
  const inLayer = JUG_LAYERS[d].length;
  const offset = (MAXROW - inLayer) / 2;
  return { x: PAD_L + d * COL + COL / 2, y: TOP + (offset + k) * ROW_H + 16 };
}

/** เส้นเชื่อมที่ทำให้สถานะปลายทางถูกพบครั้งแรก (โครงของต้นไม้ค้นหา) */
const treeEdges: { a: { x: number; y: number }; b: { x: number; y: number } }[] = [];
JUG_LAYERS.forEach((layer, d) => {
  layer.forEach((s, k) => {
    if (d === 0) return;
    for (let pd = 0; pd < JUG_LAYERS[d - 1].length; pd++) {
      const p = JUG_LAYERS[d - 1][pd];
      if (jugMoves(p).some((nx) => nx[0] === s[0] && nx[1] === s[1])) {
        treeEdges.push({ a: nodePos(d - 1, pd), b: nodePos(d, k) });
        break;
      }
    }
  });
});

/* ---------- โค้ด ---------- */

const shapeCode = `// โครงของการค้นตามความกว้าง ใช้ซ้ำได้ทุกข้อ เปลี่ยนแค่สามจุดที่มีคอมเมนต์กำกับ
vector<int> dist(STATES, -1);          // (1) จำนวนสถานะทั้งหมด
queue<int> q;

dist[START] = 0;                       // (2) สถานะเริ่มต้น
q.push(START);

while (!q.empty()) {
    int v = q.front(); q.pop();
    if (isGoal(v)) { answer = dist[v]; break; }

    for (int u : neighbours(v)) {      // (3) หนึ่งท่าที่ทำได้จากสถานะ v
        if (dist[u] != -1) continue;   // เคยไปถึงแล้วด้วยระยะที่สั้นกว่าหรือเท่ากัน
        dist[u] = dist[v] + 1;
        q.push(u);
    }
}`;

const q1Code = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int R, C;
    scanf("%d %d", &R, &C);
    vector<string> g(R);
    for (auto& s : g) { char b[1024]; scanf("%s", b); s = b; }

    int sr = 0, sc = 0, tr = 0, tc = 0;
    for (int i = 0; i < R; i++)
        for (int j = 0; j < C; j++) {
            if (g[i][j] == 'S') { sr = i; sc = j; }
            if (g[i][j] == 'T') { tr = i; tc = j; }
        }

    vector<vector<int>> dist(R, vector<int>(C, -1));
    queue<pair<int, int>> q;
    dist[sr][sc] = 0;
    q.push({sr, sc});

    const int dx[4] = {-1, 1, 0, 0}, dy[4] = {0, 0, -1, 1};
    while (!q.empty()) {
        auto [x, y] = q.front(); q.pop();
        for (int k = 0; k < 4; k++) {
            int nx = x + dx[k], ny = y + dy[k];
            if (nx < 0 || ny < 0 || nx >= R || ny >= C) continue;
            if (g[nx][ny] == '#') continue;
            if (dist[nx][ny] != -1) continue;
            dist[nx][ny] = dist[x][y] + 1;
            q.push({nx, ny});
        }
    }
    printf("%d\\n", dist[tr][tc]);   // ไปไม่ถึงจะยังเป็น -1 อยู่พอดี
    return 0;
}`;

const q2Code = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int X, Y, Z;
    scanf("%d %d %d", &X, &Y, &Z);

    // สถานะคือ (a, b) ปริมาณน้ำในใบเล็กและใบใหญ่ อัดเป็นเลขตัวเดียว a*(Y+1)+b
    int S = (X + 1) * (Y + 1);
    vector<int> dist(S, -1);
    auto id = [&](int a, int b) { return a * (Y + 1) + b; };

    queue<int> q;
    dist[id(0, 0)] = 0;
    q.push(id(0, 0));

    int ans = -1;
    while (!q.empty()) {
        int cur = q.front(); q.pop();
        int a = cur / (Y + 1), b = cur % (Y + 1);
        if (a == Z || b == Z) { ans = dist[cur]; break; }

        int t  = min(a, Y - b);        // เทใบเล็กใส่ใบใหญ่ ได้เท่าที่ใบใหญ่ยังว่าง
        int t2 = min(b, X - a);        // เทใบใหญ่ใส่ใบเล็ก
        int nx[6][2] = {{X, b}, {a, Y}, {0, b}, {a, 0}, {a - t, b + t}, {a + t2, b - t2}};

        for (auto& p : nx) {
            int j = id(p[0], p[1]);
            if (dist[j] == -1) { dist[j] = dist[cur] + 1; q.push(j); }
        }
    }
    printf("%d\\n", ans);
    return 0;
}`;

const q3Code = `#include <bits/stdc++.h>
using namespace std;

int main() {
    char tgt[16];
    int m;
    scanf("%s %d", tgt, &m);

    vector<char> bad(10000, 0);
    for (int i = 0; i < m; i++) { char s[16]; scanf("%s", s); bad[atoi(s)] = 1; }
    int target = atoi(tgt);

    if (bad[0]) { printf("-1\\n"); return 0; }   // ออกจากจุดเริ่มไม่ได้เลย

    vector<int> dist(10000, -1);
    queue<int> q;
    dist[0] = 0;
    q.push(0);

    while (!q.empty()) {
        int v = q.front(); q.pop();
        if (v == target) break;

        int p[4] = {1000, 100, 10, 1};
        for (int k = 0; k < 4; k++) {
            int digit = (v / p[k]) % 10;
            for (int d : {1, 9}) {                 // หมุนขึ้นหนึ่ง กับหมุนลงหนึ่ง (คือขึ้นเก้าแบบวน)
                int nd = (digit + d) % 10;
                int u = v + (nd - digit) * p[k];
                if (bad[u] || dist[u] != -1) continue;
                dist[u] = dist[v] + 1;
                q.push(u);
            }
        }
    }
    printf("%d\\n", dist[target]);
    return 0;
}`;
/* ---------- มินิเกม ตวงน้ำเอง ----------
   จำนวนท่าที่น้อยที่สุดของแต่ละชุดหาด้วยการค้นตามความกว้างจริง ๆ ตอนบิลด์
   ซึ่งเป็นวิธีเดียวกับที่บทนี้สอน เกมจึงตัดสินด้วยของจริง ไม่ใช่ด้วยเลขที่พิมพ์ไว้ */
type JugPuzzle = { id: string; label: string; tease: string; x: number; y: number; z: number };

/** จำนวนท่าที่น้อยที่สุด หรือ -1 ถ้าทำไม่ได้ */
function jugBfs(x: number, y: number, z: number): number {
  const key = (a: number, b: number): number => a * (y + 1) + b;
  const dist = new Map<number, number>([[key(0, 0), 0]]);
  const q: [number, number][] = [[0, 0]];
  for (let h = 0; h < q.length; h++) {
    const [a, b] = q[h];
    const d = dist.get(key(a, b)) as number;
    if (a === z || b === z) return d;
    const moves: [number, number][] = [
      [x, b],
      [a, y],
      [0, b],
      [a, 0],
      [a - Math.min(a, y - b), b + Math.min(a, y - b)],
      [a + Math.min(b, x - a), b - Math.min(b, x - a)],
    ];
    for (const [na, nb] of moves) {
      if (!dist.has(key(na, nb))) {
        dist.set(key(na, nb), d + 1);
        q.push([na, nb]);
      }
    }
  }
  return -1;
}

const JUG_PUZZLES: JugPuzzle[] = [
  { id: 'j1', label: 'ชุดที่ 1 · อุ่นเครื่อง', tease: 'เหยือกสามกับห้าลิตร ขอสี่ลิตรพอดี', x: 3, y: 5, z: 4 },
  { id: 'j2', label: 'ชุดที่ 2 · ยากขึ้น', tease: 'ชุดนี้ต้องเทกลับไปกลับมาหลายรอบกว่าจะได้', x: 5, y: 9, z: 7 },
  { id: 'j3', label: 'ชุดที่ 3 · ทำไม่ได้', tease: 'ชุดนี้อาจไม่มีทางตวงได้เลย ถ้าคิดว่าไม่มีทาง ก็กดปุ่มบอกได้', x: 4, y: 6, z: 5 },
];

type JugPuzzleData = {
  id: string;
  label: string;
  tease: string;
  x: number;
  y: number;
  z: number;
  best: number;
};
const jugPuzzles: JugPuzzleData[] = JUG_PUZZLES.map((p) => ({
  id: p.id,
  label: p.label,
  tease: p.tease,
  x: p.x,
  y: p.y,
  z: p.z,
  best: jugBfs(p.x, p.y, p.z),
}));
const jugJson = JSON.stringify(jugPuzzles);

/* ---------- 0-1 BFS ----------
   โค้ดสองชิ้นนี้คอมไพล์แล้วสุ่มเทียบกัน 700 รอบ ตรงกันหมด */
const zoCode = `// 0-1 BFS: ระยะทางสั้นสุดเมื่อเส้นเชื่อมมีน้ำหนักได้แค่ 0 หรือ 1
// ใช้แถวสองหัว เส้นน้ำหนัก 0 ใส่หัวแถว เส้นน้ำหนัก 1 ใส่ท้ายแถว
// อินพุต: n m start แล้ว m บรรทัด u v w  (กราฟไม่มีทิศ, w เป็น 0 หรือ 1)
// เอาต์พุต: ระยะจาก start ถึงทุกปม ปมที่ไปไม่ถึงพิมพ์ -1
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, m, start;
    if (scanf("%d %d %d", &n, &m, &start) != 3) return 0;
    vector<vector<pair<int, int>>> g(n);
    for (int i = 0; i < m; i++) {
        int u, v, w;
        scanf("%d %d %d", &u, &v, &w);
        g[u].push_back({v, w});
        g[v].push_back({u, w});
    }
    const int INF = INT_MAX;
    vector<int> dist(n, INF);
    deque<int> dq;
    dist[start] = 0;
    dq.push_back(start);
    while (!dq.empty()) {
        int u = dq.front();
        dq.pop_front();
        for (auto [v, w] : g[u]) {
            // ถ้าเส้นนี้ไม่เพิ่มระยะเลย ปมปลายทางต้องได้คิวเท่ากับปมนี้ จึงต้องอยู่หัวแถว
            if (dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                if (w == 0) dq.push_front(v);
                else dq.push_back(v);
            }
        }
    }
    for (int i = 0; i < n; i++) printf("%d%c", dist[i] == INF ? -1 : dist[i], i + 1 == n ? '\\n' : ' ');
    return 0;
}`;
const zoBrute = `// ตัวตรวจอิสระของ 0-1 BFS: Bellman-Ford แบบผ่อนคลายซ้ำจนไม่มีอะไรเปลี่ยน
// ไม่รู้จักแถวสองหัว ไม่รู้จักลำดับคิว จึงไม่ได้ทดสอบข้ออ้างเรื่องหัวแถวท้ายแถวเลย
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, m, start;
    if (scanf("%d %d %d", &n, &m, &start) != 3) return 0;
    vector<array<int, 3>> e(m);
    for (int i = 0; i < m; i++) scanf("%d %d %d", &e[i][0], &e[i][1], &e[i][2]);
    const int INF = INT_MAX;
    vector<int> dist(n, INF);
    dist[start] = 0;
    for (int it = 0; it < n; it++) {
        bool changed = false;
        for (auto& x : e) {
            int u = x[0], v = x[1], w = x[2];
            if (dist[u] != INF && dist[u] + w < dist[v]) { dist[v] = dist[u] + w; changed = true; }
            if (dist[v] != INF && dist[v] + w < dist[u]) { dist[u] = dist[v] + w; changed = true; }
        }
        if (!changed) break;
    }
    for (int i = 0; i < n; i++) printf("%d%c", dist[i] == INF ? -1 : dist[i], i + 1 == n ? '\\n' : ' ');
    return 0;
}`;

