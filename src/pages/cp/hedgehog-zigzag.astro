---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

const href = 'hedgehog-zigzag/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

/** ช่องสีเทา คือช่องที่เลขแถวกับเลขคอลัมน์ไม่มีบิต 1 ตรงตำแหน่งเดียวกันเลย (นิยามของโจทย์) */
const isGrey = (r: number, c: number): boolean => (r & c) === 0;

/** จำนวนบิต 1 ของ v */
function popcountOf(v: number): number {
  return v.toString(2).split('').filter((ch) => ch === '1').length;
}

/** ลำดับที่เม่นเดิน แนวทแยงคี่เดินลงล่าง แนวทแยงคู่เดินขึ้นบน */
function walk(R: number, C: number, K: number): { r: number; c: number }[] {
  const out: { r: number; c: number }[] = [];
  for (let d = 0; d < R + C - 1 && out.length < K; d++) {
    const lo = Math.max(0, d - C + 1);
    const hi = Math.min(R - 1, d);
    if (d % 2 === 1) {
      for (let r = lo; r <= hi && out.length < K; r++) out.push({ r, c: d - r });
    } else {
      for (let r = hi; r >= lo && out.length < K; r--) out.push({ r, c: d - r });
    }
  }
  return out;
}

/** ตัวเดินอีกตัว ขยับทีละก้าวแล้วเด้งเมื่อชนขอบ ไม่ใช้สูตร lo/hi ของแนวทแยง (แบบเดียวกับ brute_sim.cpp) */
function walkBounce(R: number, C: number, K: number): { r: number; c: number }[] {
  const out: { r: number; c: number }[] = [];
  let r = 0;
  let c = 0;
  let upRight = true;
  while (out.length < K) {
    out.push({ r, c });
    if (upRight) {
      if (r - 1 >= 0 && c + 1 < C) {
        r--;
        c++;
      } else {
        if (c + 1 < C) c++;
        else r++;
        upRight = false;
      }
    } else if (r + 1 < R && c - 1 >= 0) {
      r++;
      c--;
    } else {
      if (r + 1 < R) r++;
      else c++;
      upRight = true;
    }
  }
  return out;
}

/** นับตรง ๆ ด้วยตัวเดินแบบเด้งขอบกับนิยามของสี ใช้เป็นตัวเทียบของทุกตัวเลขในหน้า */
const slowCount = (R: number, C: number, K: number): number =>
  walkBounce(R, C, K).filter((p) => isGrey(p.r, p.c)).length;

const BITS = 21;
const N_MAX = 1000000;
const K_MAX = N_MAX * N_MAX;
const D_MAX = 2 * N_MAX - 2;
if (N_MAX >= 2 ** BITS || D_MAX >= 2 ** BITS) throw new Error('hedgehog-zigzag: 21 บิตไม่พอ');

/** จำนวนคู่ (r, c) ที่ r < R, c < C, บิตไม่ชนกัน และ r + c < D */
function countBelow(R: number, C: number, D: number): number {
  if (D <= 0) return 0;
  let dp = new Float64Array(8);
  const at = (a: number, b: number, s: number): number => a * 4 + b * 2 + s;
  dp[at(1, 1, 1)] = 1;
  for (let i = BITS - 1; i >= 0; i--) {
    const nx = new Float64Array(8);
    const rb = (R >> i) & 1;
    const cb = (C >> i) & 1;
    const db = (D >> i) & 1;
    for (let a = 0; a < 2; a++)
      for (let b = 0; b < 2; b++)
        for (let s = 0; s < 2; s++) {
          const v = dp[at(a, b, s)];
          if (v === 0) continue;
          for (let x = 0; x < 2; x++)
            for (let y = 0; y < 2; y++) {
              if (x === 1 && y === 1) continue;
              const so = x | y;
              if (a === 1 && x > rb) continue;
              if (b === 1 && y > cb) continue;
              if (s === 1 && so > db) continue;
              const na = a === 1 && x === rb ? 1 : 0;
              const nb = b === 1 && y === cb ? 1 : 0;
              const ns = s === 1 && so === db ? 1 : 0;
              nx[at(na, nb, ns)] += v;
            }
        }
    dp = nx;
  }
  return dp[at(0, 0, 0)];
}

/** จำนวน r ที่บิตของมันเป็นสับเซตของบิต D และ r ไม่เกิน x */
function subLE(D: number, x: number): number {
  if (x < 0) return 0;
  let res = 0;
  let tight = true;
  let below = 0;
  for (let i = BITS; i >= 0; i--) if ((D >> i) & 1) below++;
  for (let i = BITS; i >= 0; i--) {
    const di = (D >> i) & 1;
    const xi = (x >> i) & 1;
    if (di === 1) below--;
    if (xi === 1) {
      res += 2 ** below;
      if (di === 0) {
        tight = false;
        break;
      }
    }
  }
  return res + (tight ? 1 : 0);
}

/** ท่าที่โค้ดใช้ สองท่อน คือแนวทแยงที่เต็มแล้ว บวกส่วนที่เดินบนแนวทแยงสุดท้าย */
function fastCount(R: number, C: number, K: number): { ans: number; D: number; seen: number; a: number; b: number } {
  let seen = 0;
  let D = 0;
  for (let d = 0; d < R + C - 1; d++) {
    const len = Math.min(R - 1, d) - Math.max(0, d - C + 1) + 1;
    if (seen + len >= K) {
      D = d;
      break;
    }
    seen += len;
  }
  const t = K - seen;
  const lo = Math.max(0, D - C + 1);
  const hi = Math.min(R - 1, D);
  const a = D % 2 === 1 ? lo : hi - t + 1;
  const b = D % 2 === 1 ? lo + t - 1 : hi;
  const ans = countBelow(R, C, D) + subLE(D, b) - subLE(D, a - 1);
  return { ans, D, seen, a, b };
}

/* ด่านตรวจตอนบิลด์ ท่าที่สอนต้องตรงกับการเดินจริงทุกกระดานเล็ก ไม่งั้นหน้านี้ไม่ขึ้น */
let SWEEP_CASES = 0;
for (let R = 1; R <= 12; R++)
  for (let C = 1; C <= 12; C++)
    for (let K = 1; K <= R * C; K++) {
      SWEEP_CASES++;
      if (fastCount(R, C, K).ans !== slowCount(R, C, K))
        throw new Error(`hedgehog-zigzag: สูตรนับไม่ตรงกับการเดินจริงที่ R=${R} C=${C} K=${K}`);
    }
if (SWEEP_CASES !== 6084) throw new Error('hedgehog-zigzag: ด่านตรวจรันไม่ครบ');
/* ลำดับของ walk (ใช้วาดภาพและสร้างเกม) ต้องตรงกับตัวเดินแบบเด้งขอบทุกก้าว */
for (let R = 1; R <= 12; R++)
  for (let C = 1; C <= 12; C++)
    if (JSON.stringify(walk(R, C, R * C)) !== JSON.stringify(walkBounce(R, C, R * C)))
      throw new Error(`hedgehog-zigzag: ลำดับการเดินสองแบบไม่ตรงกันที่ R=${R} C=${C}`);

/* ตัวเลขที่เอาไปพูดในเนื้อความ */
const fmt = (n: number): string => n.toLocaleString('en-US');
const SAMPLES = [
  { R: 10, C: 10, K: 6 },
  { R: 3, C: 5, K: 11 },
  { R: 10, C: 10, K: 100 },
].map((s) => ({ ...s, out: slowCount(s.R, s.C, s.K) }));
const SAMPLE_OUTS = [5, 8, 51];
SAMPLES.forEach((s, i) => {
  if (s.out !== SAMPLE_OUTS[i]) throw new Error(`hedgehog-zigzag: ตัวอย่างที่ ${i + 1} ไม่ตรงกับโจทย์`);
});

/* ---------- ตัวอย่างตัวทด สำหรับตอนที่ 1 ---------- */
const CARRY = [
  { r: 5, c: 2 },
  { r: 5, c: 3 },
].map((p) => ({ ...p, sum: p.r + p.c, or: p.r | p.c, clash: (p.r & p.c) !== 0 }));
if (CARRY[0].clash || CARRY[0].sum !== CARRY[0].or || !CARRY[1].clash || CARRY[1].sum === CARRY[1].or)
  throw new Error('hedgehog-zigzag: ตัวอย่างตัวทดไม่ได้แสดงสิ่งที่ข้อความพูด');

/* ---------- ไล่ subLE(D, lim) ทีละบิต สำหรับตอนที่ 3 ---------- */
const TR_D = 6;
const TR_LIM = 5;
const TR_W = 3;
const trSteps: string[] = [];
let trTotal = 0;
{
  let below = popcountOf(TR_D);
  let tight = true;
  for (let i = TR_W - 1; i >= 0; i--) {
    const di = (TR_D >> i) & 1;
    const li = (TR_LIM >> i) & 1;
    if (di === 1) below--;
    if (li === 0) {
      trSteps.push(`บิต ${i}: lim เป็น 0 ให้ r เป็น 0 ด้วย แล้วไปต่อ (ข้อ 1)`);
      continue;
    }
    trTotal += 2 ** below;
    const head = `บิต ${i}: lim เป็น 1 ถ้า r เป็น 0 ตรงนี้ บิตที่ต่ำกว่าเลือกตามบิต 1 ของ D ได้ ${below} ตัว บวก ${2 ** below} (ข้อ 2)`;
    if (di === 0) {
      tight = false;
      trSteps.push(`${head} แต่ D ตรงนี้เป็น 0 r เป็น 1 ตาม lim ไม่ได้ หยุด (ข้อ 3)`);
      break;
    }
    trSteps.push(`${head} และ D ตรงนี้เป็น 1 r เป็น 1 ตาม lim ได้ ไปต่อ`);
  }
  if (tight) {
    trTotal += 1;
    trSteps.push('เดินครบโดยไม่หยุด lim เองเป็นสับเซตของ D บวก 1 (ข้อ 4)');
  }
}
const trBrute = Array.from({ length: TR_LIM + 1 }, (_, r) => r).filter((r) => (r & ~TR_D) === 0);
if (trTotal !== trBrute.length || trTotal !== subLE(TR_D, TR_LIM) || TR_D >= 2 ** TR_W || TR_LIM >= 2 ** TR_W)
  throw new Error('hedgehog-zigzag: ตัวอย่าง subLE ไม่ตรงกับการไล่ตรง ๆ');

/* ค่าที่วัดจากโปรแกรมจริงบน WSL (g++ -O2, /usr/bin/time) */
const MEASURED = {
  fullOut: 3441847383, // ผลของ hedgehog.cpp ที่ R = C = 1,000,000, K = 10^12
  solPeakKiB: 3768, // ค่าสูงสุดจากหกอินพุตขนาดเต็ม
  midSec: 0.13, // ทางนับสับเซตทีละแนวทแยง ที่ R = C = 1,000,000, K = 10^12
  bruteSteps: 2000000000, // brute_hedgehog.cpp ที่ K = 2,000 ล้าน
  bruteSec: 1.05,
  midCases: 499, // mid.cpp เทียบกับ brute_sim.cpp (อินพุตที่ K ไม่เกิน R x C)
};
const FULL_ANS = fastCount(N_MAX, N_MAX, K_MAX).ans;
if (FULL_ANS !== MEASURED.fullOut) throw new Error('hedgehog-zigzag: โมเดลกับโปรแกรมจริงตอบเคสใหญ่ไม่ตรงกัน');
const SOL_PEAK_MB = ((MEASURED.solPeakKiB * 1024) / 1e6).toFixed(1);
const BRUTE_RATE_M = Math.round(MEASURED.bruteSteps / MEASURED.bruteSec / 1e6);
const BRUTE_FULL_MIN = Math.round(((K_MAX / MEASURED.bruteSteps) * MEASURED.bruteSec) / 60);

/* ---------- กระดานตัวอย่างสิบคูณสิบ สำหรับแผนภาพ ---------- */
const BOARD = 10;
const CELL = 26;
const boardCells: { r: number; c: number; grey: boolean }[] = [];
for (let r = 0; r < BOARD; r++) for (let c = 0; c < BOARD; c++) boardCells.push({ r, c, grey: isGrey(r, c) });
const PATH_STEPS = 21;
const pathPts = walk(BOARD, BOARD, PATH_STEPS)
  .map((p) => `${p.c * CELL + CELL / 2 + 22},${p.r * CELL + CELL / 2 + 20}`)
  .join(' ');
const BOARD_W = (BOARD - 1) * CELL + 22 + (CELL - 2) + 12;
const BOARD_H = (BOARD - 1) * CELL + 20 + (CELL - 2) + 34;

/* ---------- แนวทแยงหนึ่งเส้น สำหรับแผนภาพสับเซต ---------- */
const DEMO_D = 6;
const popcount = popcountOf;
const demoSub: { r: number; c: number }[] = [];
const demoOther: { r: number; c: number }[] = [];
for (let r = 0; r <= DEMO_D; r++) (isGrey(r, DEMO_D - r) ? demoSub : demoOther).push({ r, c: DEMO_D - r });
if (demoSub.length !== 2 ** popcount(DEMO_D)) throw new Error('hedgehog-zigzag: แผนภาพ d = 6 ไม่ตรงกับ 2 ยกกำลังจำนวนบิต');
const bin = (v: number, w = 3): string => v.toString(2).padStart(w, '0');
const DEMO_H = 66 + (demoSub.length - 1) * 32 + 26 + 34;

/* แนวทแยงที่โดนขอบกระดาน 10 x 10 ตัด จำนวนช่องสีเทาจึงน้อยกว่า 2 ยกกำลังจำนวนบิต */
const CLIP_D = 12;
const clipAll = Array.from({ length: CLIP_D + 1 }, (_, r) => ({ r, c: CLIP_D - r })).filter((p) => isGrey(p.r, p.c));
const clipOn = clipAll.filter((p) => p.r < BOARD && p.c < BOARD);
if (clipAll.length !== 2 ** popcount(CLIP_D) || clipOn.length >= clipAll.length)
  throw new Error('hedgehog-zigzag: ตัวอย่างแนวทแยงโดนตัดไม่ได้แสดงสิ่งที่ข้อความพูด');
const pairList = (ps: { r: number; c: number }[]): string => ps.map((p) => `(${p.r}, ${p.c})`).join(' ');

/* ---------- ตัวอย่างแรกของโจทย์ เดินผ่านสองท่อน ---------- */
const EX = SAMPLES[0];
const exFast = fastCount(EX.R, EX.C, EX.K);
const exLens = Array.from({ length: exFast.D + 1 }, (_, d) => Math.min(EX.R - 1, d) - Math.max(0, d - EX.C + 1) + 1);
const exT = EX.K - exFast.seen;
const exPart1Cells = walk(EX.R, EX.C, exFast.seen);
const exPart1 = exPart1Cells.filter((p) => isGrey(p.r, p.c)).length;
const exPart2Rs = Array.from({ length: exFast.b - exFast.a + 1 }, (_, i) => exFast.a + i).filter((r) => isGrey(r, exFast.D - r));
const exPart2 = exPart2Rs.length;
if (exPart1 === 0 || exPart2 === 0 || exPart1 + exPart2 !== EX.out || exPart1 !== countBelow(EX.R, EX.C, exFast.D))
  throw new Error('hedgehog-zigzag: ตัวอย่างสองท่อนไม่ตรงกับการนับตรง ๆ');

/* ---------- มินิเกม ทายว่าช่องไหนเป็นสีเทาใน K ช่องแรก ---------- */
type GameCell = { r: number; c: number; ord: number; grey: boolean };
type GamePuzzle = { id: string; label: string; tease: string; R: number; C: number; K: number; cells: GameCell[]; greyCount: number };

function makePuzzle(id: string, label: string, tease: string, R: number, C: number, K: number): GamePuzzle {
  const order = walk(R, C, K);
  const cells: GameCell[] = order.map((p, i) => ({ r: p.r, c: p.c, ord: i + 1, grey: isGrey(p.r, p.c) }));
  const greyCount = cells.filter((c) => c.grey).length;
  if (greyCount !== fastCount(R, C, K).ans)
    throw new Error(`hedgehog-zigzag: เฉลยเกม ${id} ไม่ตรงกับสูตร`);
  return { id, label, tease, R, C, K, cells, greyCount };
}

const puzzles: GamePuzzle[] = [
  makePuzzle('a', 'กระดาน 4 x 4', 'เดินครบทั้งกระดาน 16 ช่อง', 4, 4, 16),
  makePuzzle('b', 'กระดาน 6 x 6 หยุดที่ 21', 'คราวนี้เม่นหลับก่อนเดินครบ ช่องที่ยังไม่ได้ไปไม่นับ แม้มันจะเป็นสีเทาก็ตาม', 6, 6, 21),
  makePuzzle('c', 'กระดาน 5 x 8 หยุดที่ 24', 'กระดานไม่เป็นสี่เหลี่ยมจัตุรัส แนวทแยงบางเส้นจึงสั้นกว่าที่คิด', 5, 8, 24),
];
const puzzlesJson = JSON.stringify(puzzles);
const GAME_STATUS0 = 'ตัวเลขในช่องคือลำดับก้าวของเม่น ช่องที่เป็นจุดคือช่องที่เม่นหลับก่อนจะไปถึง';
const gameScore0 = `เลือกไว้ 0 ช่อง จากที่เม่นเหยียบทั้งหมด ${puzzles[0].cells.length} ช่อง`;

/* ---------- ตัวเล่นทีละขั้น เดินบิตของ R, C, D ---------- */
/* D = 12 คือสิบสองแนวทแยงแรกของกระดาน 10 x 10 ขอบของ R และ C จึงมีผลด้วย */
const PLAY_R = 10;
const PLAY_C = 10;
const PLAY_D = 12;
const PLAY_BITS = 4;
type StateRow = { key: string; label: string; vals: number[] };
const stateKeys: { a: number; b: number; s: number }[] = [];
for (let a = 1; a >= 0; a--) for (let b = 1; b >= 0; b--) for (let s = 1; s >= 0; s--) stateKeys.push({ a, b, s });
const stLabel = (k: number): string =>
  `${flags(k)} (${k & 4 ? 'ติด' : 'หลุด'} R, ${k & 2 ? 'ติด' : 'หลุด'} C, ${k & 1 ? 'ติด' : 'หลุด'} ผลรวม)`;
const flags = (k: number): string => `${(k >> 2) & 1}${(k >> 1) & 1}${k & 1}`;
const liveList = (vals: number[]): string =>
  vals
    .map((v, k) => ({ v, k }))
    .filter((x) => x.v > 0)
    .map((x) => `${flags(x.k)} = ${x.v}`)
    .join(', ');
/* บิต 20 ถึง PLAY_BITS ของ R, C, D เป็น 0 หมด สถานะจึงค้างที่ 111 และตัวเล่นข้ามบิตพวกนั้น */
if ((PLAY_R | PLAY_C | PLAY_D) >= 2 ** PLAY_BITS) throw new Error('hedgehog-zigzag: ตัวเล่นต้องการบิตมากกว่า 4');

const playSteps: { bit: number; say: string; vals: number[] }[] = [];
{
  const at = (a: number, b: number, s: number): number => a * 4 + b * 2 + s;
  let dp = new Float64Array(8);
  dp[at(1, 1, 1)] = 1;
  playSteps.push({
    bit: PLAY_BITS,
    say:
      `ธงเรียงเป็น R C ผลรวม (1 = ติดขอบ, 0 = หลุด) บิต 20 ถึง ${PLAY_BITS} ของทั้งสามเลขเป็น 0 หมด ` +
      `ทางเดียวที่ไม่เกินขอบคือเลือก 00 ทุกบิต สถานะจึงยังเป็น 111 = 1 แล้วเริ่มดูที่บิต ${PLAY_BITS - 1}`,
    vals: Array.from(dp),
  });
  for (let i = PLAY_BITS - 1; i >= 0; i--) {
    const nx = new Float64Array(8);
    const rb = (PLAY_R >> i) & 1;
    const cb = (PLAY_C >> i) & 1;
    const db = (PLAY_D >> i) & 1;
    const moves: string[] = [];
    for (let a = 1; a >= 0; a--)
      for (let b = 1; b >= 0; b--)
        for (let s = 1; s >= 0; s--) {
          const v = dp[at(a, b, s)];
          if (v === 0) continue;
          const outs: string[] = [];
          for (let x = 0; x < 2; x++)
            for (let y = 0; y < 2; y++) {
              if (x === 1 && y === 1) continue;
              const so = x | y;
              if (a === 1 && x > rb) continue;
              if (b === 1 && y > cb) continue;
              if (s === 1 && so > db) continue;
              const k = at(a === 1 && x === rb ? 1 : 0, b === 1 && y === cb ? 1 : 0, s === 1 && so === db ? 1 : 0);
              nx[k] += v;
              outs.push(`${x}${y}→${flags(k)}`);
            }
          moves.push(`${flags(at(a, b, s))}×${v}: ${outs.join(' ')}`);
        }
    dp = nx;
    playSteps.push({
      bit: i,
      say: `บิตของ R C D = ${rb} ${cb} ${db} · ${moves.join(' | ')} · รวมได้ ${liveList(Array.from(dp))}`,
      vals: Array.from(dp),
    });
  }
  playSteps.push({
    bit: -1,
    say:
      `ครบทุกบิต คำตอบคือสถานะ 000 = ${dp[at(0, 0, 0)]} ` +
      `สถานะที่ยังมีธง 1 แปลว่าเลขตัวนั้นเท่ากับขอบพอดี โจทย์ต้องการน้อยกว่าขอบเท่านั้น จึงไม่นับ`,
    vals: Array.from(dp),
  });
}
const playRows: StateRow[] = stateKeys.map(({ a, b, s }) => ({
  key: `${a}${b}${s}`,
  label: stLabel(a * 4 + b * 2 + s),
  vals: playSteps.map((st) => st.vals[a * 4 + b * 2 + s]),
}));
const playerSteps = playSteps.map((st, i) => ({
  note:
    (st.bit === PLAY_BITS ? 'ก่อนเริ่ม' : st.bit >= 0 ? `กำลังเดินบิตที่ ${st.bit}` : 'อ่านคำตอบ') +
    ' &middot; ' +
    st.say,
  col: i,
}));
const PLAY_ANSWER = countBelow(PLAY_R, PLAY_C, PLAY_D);
const PLAY_K = walk(PLAY_R, PLAY_C, PLAY_R * PLAY_C).filter((p) => p.r + p.c < PLAY_D).length;
const PLAY_SLOW = slowCount(PLAY_R, PLAY_C, PLAY_K);
const PLAY_LENS = Array.from({ length: PLAY_D }, (_, d) => Math.min(PLAY_R - 1, d) - Math.max(0, d - PLAY_C + 1) + 1);
if (PLAY_LENS.reduce((x, y) => x + y, 0) !== PLAY_K) throw new Error('hedgehog-zigzag: ความยาวแนวทแยงของตัวเล่นรวมไม่ตรง');
if (PLAY_ANSWER !== PLAY_SLOW || walk(PLAY_R, PLAY_C, PLAY_K).some((p) => p.r + p.c >= PLAY_D))
  throw new Error('hedgehog-zigzag: ตัวเล่นไม่ตรงกับการนับตรง ๆ');

/* ---------- งานต่อหนึ่งอินพุต นับเป็นก้าว (หนึ่งรอบของลูปในสุด) ---------- */
const SUBLE_LOOP = BITS + 1; // subLE วนบิต 21..0 คือ 22 บิต (countBelow วนแค่ 20..0)
const SUBLE_STEPS = 2 * 2 * SUBLE_LOOP; // เรียก 2 ครั้ง x 2 ลูป (นับบิต 1 ของ D ก่อน แล้วค่อยเดินจริง) x 22
const DP_STEPS = BITS * 8 * 4; // 21 บิต x 8 สถานะ x 4 คู่ (x, y) นับคู่ (1,1) ที่ถูกทิ้งและสถานะที่เป็น 0 ด้วย จึงเป็นขอบบน
const DIAG_FULL = D_MAX + 1; // D + 1 ไม่เกิน R + C - 1
const DIAG_HALF = 999999; // D + 1 ไม่เกิน K และ K น้อยกว่าหนึ่งล้าน
const SUBS = [
  { label: 'ชุด 50%', head: 'K < 1,000,000', diag: DIAG_HALF, k: 999999 },
  { label: 'ชุดเต็ม', head: 'K ≤ 10¹²', diag: DIAG_FULL, k: K_MAX },
];
const ladderRows = [
  { name: 'วิธีที่ 1', time: `ราว ${BRUTE_FULL_MIN} นาที (ประมาณ)`, cells: SUBS.map((s, i) => ({ steps: s.k, ok: i === 0 })) },
  { name: 'วิธีที่ 2', time: `${MEASURED.midSec} วินาที`, cells: SUBS.map((s) => ({ steps: s.diag * SUBLE_STEPS, ok: true })) },
  { name: 'วิธีที่ 3', time: 'ไม่ถึง 10 มิลลิวินาที', cells: SUBS.map((s) => ({ steps: s.diag + DP_STEPS + SUBLE_STEPS, ok: true })) },
];

/* ---------- ทดสอบตัวเอง ---------- */
const QUIZ1_D = 5;
const QUIZ1_RS = Array.from({ length: QUIZ1_D + 1 }, (_, r) => r).filter((r) => isGrey(r, QUIZ1_D - r));
const QUIZ2 = SAMPLES[1];
const quiz2Fast = fastCount(QUIZ2.R, QUIZ2.C, QUIZ2.K);
const quiz2T = QUIZ2.K - quiz2Fast.seen;
const quiz2Cells = walk(QUIZ2.R, QUIZ2.C, QUIZ2.K).slice(quiz2Fast.seen);
const quiz2Part2 = quiz2Cells.filter((p) => isGrey(p.r, p.c)).length;
const QUIZ3_BITS = 3;
let QUIZ3 = 0;
for (let r = 0; r < 2 ** QUIZ3_BITS; r++) for (let c = 0; c < 2 ** QUIZ3_BITS; c++) if (isGrey(r, c)) QUIZ3++;
if (QUIZ1_RS.length !== 4 || quiz2Fast.D !== 4 || quiz2T !== 2 || quiz2Part2 !== 0 || QUIZ3 !== 3 ** QUIZ3_BITS)
  throw new Error('hedgehog-zigzag: คำเฉลยทดสอบตัวเองไม่ตรง');

const solution = `#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
const int B = 21;                       // 10^6 < 2^20 ส่วนผลรวมสองตัวใช้ 21 บิตพอ
ll R, C, K;

// จำนวนคู่ (r, c) ที่ r < R, c < C, บิตไม่ชนกัน และ r + c < D
ll countBelow(ll D){
    if(D <= 0) return 0;
    ll dp[2][2][2] = {};                // ยังติดขอบของ R, ของ C, ของ D อยู่ไหม
    dp[1][1][1] = 1;
    for(int i = B - 1; i >= 0; i--){
        ll nx[2][2][2] = {};
        int rb = (R >> i) & 1, cb = (C >> i) & 1, db = (D >> i) & 1;
        for(int a = 0; a < 2; a++) for(int b = 0; b < 2; b++) for(int c = 0; c < 2; c++){
            ll v = dp[a][b][c]; if(!v) continue;
            for(int x = 0; x < 2; x++) for(int y = 0; y < 2; y++){
                if(x && y) continue;                      // r กับ c ห้ามมีบิต 1 ตรงกัน
                int s = x | y;                            // บิตไม่ชนกัน ผลบวกจึงเท่ากับผลหรือ
                if(a && x > rb) continue; int na = (a && x == rb) ? 1 : 0;
                if(b && y > cb) continue; int nb = (b && y == cb) ? 1 : 0;
                if(c && s > db) continue; int nc = (c && s == db) ? 1 : 0;
                nx[na][nb][nc] += v;
            }
        }
        memcpy(dp, nx, sizeof dp);
    }
    // เอาเฉพาะสถานะที่หลุดขอบครบทั้งสามตัว ที่ยังติดขอบคือค่าเท่าขอบพอดี ซึ่งต้องไม่นับ
    return dp[0][0][0];
}

// จำนวน r ที่บิตเป็นสับเซตของ D และ r <= x
ll subLE(ll D, ll x){
    if(x < 0) return 0;
    ll res = 0, below = 0; bool tight = true;
    for(int i = B; i >= 0; i--) if((D >> i) & 1) below++;
    for(int i = B; i >= 0; i--){
        int di = (D >> i) & 1, xi = (x >> i) & 1;
        if(di) below--;
        if(xi){
            res += 1LL << below;                          // บิตนี้เลือกเป็น 0 ที่เหลืออิสระหมด
            if(!di){ tight = false; break; }              // บิตนี้บังคับเป็น 0 อยู่แล้ว เลิกติดขอบ
        }
    }
    return res + (tight ? 1 : 0);
}

int main(){
    if(scanf("%lld %lld %lld", &R, &C, &K) != 3) return 0;
    ll seen = 0, D = 0;                                   // หาเส้น D ที่ก้าวที่ K ตกอยู่ (อาจเป็นช่องสุดท้ายของเส้น)
    for(ll d = 0; d < R + C - 1; d++){
        ll len = min(R - 1, d) - max(0LL, d - C + 1) + 1;
        if(seen + len >= K){ D = d; break; }
        seen += len;
    }
    ll ans = countBelow(D);                               // ท่อนแรก แนวทแยงที่เดินจบแล้ว
    ll t = K - seen;                                      // ท่อนสอง เหลืออีก t ช่องบนเส้น D
    ll lo = max(0LL, D - C + 1), hi = min(R - 1, D), a, b;
    if(D & 1){ a = lo;         b = lo + t - 1; }          // แนวทแยงคี่เดินจากบนลงล่าง
    else     { a = hi - t + 1; b = hi; }                  // แนวทแยงคู่เดินจากล่างขึ้นบน
    ans += subLE(D, b) - subLE(D, a - 1);
    printf("%lld\\n", ans);
}`;

const bruteCode = `// ตัวตรวจ เดินจริงทีละช่องตามที่โจทย์เล่า ใช้ได้เฉพาะกระดานเล็ก
#include <bits/stdc++.h>
using namespace std;
int main(){
    long long R, C, K; cin >> R >> C >> K;
    long long cnt = 0, seen = 0;
    for(long long d = 0; d < R + C - 1 && seen < K; d++){
        long long lo = max(0LL, d - C + 1), hi = min(R - 1, d);
        if(d % 2 == 1) for(long long r = lo; r <= hi && seen < K; r++){
            long long c = d - r; seen++; if((r & c) == 0) cnt++; }
        else for(long long r = hi; r >= lo && seen < K; r--){
            long long c = d - r; seen++; if((r & c) == 0) cnt++; }
    }
    cout << cnt << "\\n";
}`;

const coreSnippet = `// ช่องสีเทาคือช่องที่บิตของแถวกับของคอลัมน์ไม่ชนกัน
// พอบิตไม่ชนกัน r + c จึงเท่ากับ r | c พอดี
// แปลว่าบนแนวทแยง r + c = d ช่องสีเทาคือคู่ที่ r เป็นสับเซตของบิต d (และช่องนั้นอยู่บนกระดาน)
bool grey(int r, int c){ return (r & c) == 0; }`;
---
<CpProblemLayout href={href}>
  <h2>โจทย์ &middot; เม่นเดินซิกแซกบนกระดานที่ระบายสีด้วยเลขฐานสอง</h2>
