<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type HzCell = { r: number; c: number; ord: number; grey: boolean };
  type HzPuzzle = { id: string; label: string; tease: string; R: number; C: number; K: number; cells: HzCell[]; greyCount: number };

  function initHedgehogGame(): void {
    const maybeUi = cpGameUi('[data-hzgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as HzPuzzle[];
    if (puzzles.length === 0) return;

    let pi = 0;
    let guess = new Set<string>();
    let revealed = false;

    const pz = (): HzPuzzle => puzzles[pi];
    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-hz-board]'));

    function render(): void {
      const p = pz();
      boards.forEach((b, k) => {
        b.hidden = k !== pi;
      });
      for (const btn of Array.from(boards[pi].querySelectorAll<HTMLElement>('[data-hz-cell]'))) {
        const key = btn.dataset.hzCell ?? '';
        const parts = key.split(':');
        const cell = p.cells.find((x) => x.r === Number(parts[1]) && x.c === Number(parts[2]));
        const picked = guess.has(key);
        btn.classList.toggle('picked', picked);
        btn.classList.toggle('right', revealed && cell !== undefined && picked === cell.grey);
        btn.classList.toggle('wrong', revealed && cell !== undefined && picked !== cell.grey);
      }
      ui.setScore(`เลือกไว้ ${guess.size} ช่อง จากที่เม่นเหยียบทั้งหมด ${p.cells.length} ช่อง`);
    }

    function check(): void {
      const p = pz();
      let right = 0;
      for (const cell of p.cells) {
        const key = `${pi}:${cell.r}:${cell.c}`;
        if (guess.has(key) === cell.grey) right++;
      }
      revealed = true;
      render();
      if (right === p.cells.length) {
        ui.setStatus(`ถูกทั้ง ${p.cells.length} ช่องครับ ช่องสีเทามี ${p.greyCount} ช่อง ซึ่งคือคำตอบของกระดานนี้`, 'good');
      } else {
        ui.setStatus(
          `ถูก ${right} จาก ${p.cells.length} ช่อง ช่องที่ผิดถูกตีกรอบแดงไว้แล้ว ลองเขียนเลขแถวกับเลขคอลัมน์ของช่องพวกนั้นเป็นฐานสองดู`,
          'bad',
        );
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      guess = new Set<string>();
      revealed = false;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ui.setStatus('ตัวเลขในช่องคือลำดับก้าวของเม่น ช่องที่เป็นจุดคือช่องที่เม่นหลับก่อนจะไปถึง');
      render();
    }

    ui.root.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const btn = e.target.closest('[data-hz-cell]');
      if (!(btn instanceof HTMLElement)) return;
      const key = btn.dataset.hzCell ?? '';
      if (guess.has(key)) guess.delete(key);
      else guess.add(key);
      revealed = false;
      ui.setStatus('ตัวเลขในช่องคือลำดับก้าวของเม่น ช่องที่เป็นจุดคือช่องที่เม่นหลับก่อนจะไปถึง');
      render();
    });

    ui.onClick('data-hz-clear', () => selectPuzzle(pi));
    ui.onClick('data-hz-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initHedgehogGame);
</script>

<script>
  import { initCpPlayers } from '../../lib/cpPlayer';

  /* ตัวเล่นของหน้านี้เดินไปตาม "คอลัมน์" ไม่ใช่ตามแถว เพราะหนึ่งก้าวคือหนึ่งบิต
     ส่วนแถวคือสถานะทั้งแปดซึ่งอยู่ครบตั้งแต่ต้น จึงใช้ initCpRowPlayers ไม่ได้ */
  type HzStep = { note: string; col: number };

  function isHzStep(x: unknown): x is HzStep {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return typeof o.note === 'string' && typeof o.col === 'number';
  }

  document.addEventListener('astro:page-load', () => {
    initCpPlayers<HzStep>('[data-hzsim]', {
      narrow: (raw) => {
        const ok = raw.filter(isHzStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      zeroBased: true,
      draw: (st, ctx) => {
        const rows = Array.from(ctx.parts.root.querySelectorAll<HTMLTableRowElement>('tbody tr'));
        for (const tr of rows) {
          const cells = Array.from(tr.querySelectorAll<HTMLTableCellElement>('td.num'));
          cells.forEach((td, i) => {
            /* คอลัมน์ที่ยังไม่ถึงต้องว่างไว้ ไม่งั้นผู้อ่านเห็นคำตอบของบิตที่ยังไม่ได้เดิน */
            td.textContent = i <= st.col ? (td.dataset.v ?? '·') : '·';
            td.classList.toggle('is-live', i === st.col);
          });
          const live = cells[st.col];
          if (live && tr === rows[rows.length - 1]) ctx.keepInView(live);
        }
      },
    });
  });
</script>
