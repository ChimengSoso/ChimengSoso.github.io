    width:2.1rem;height:2.1rem;
    display:flex;align-items:center;justify-content:center;
    font-family:"Fira Code","Fira Mono",monospace;
    font-size:0.72rem;
    border-radius:5px;
    border:1px solid #2a3350;
    background:#121a2b;
    color:#9aa7bd;
    cursor:pointer;
    padding:0;
  }
  .hz-cell.hz-off{background:#0b1220;color:#4a5468;cursor:default;border-style:dashed;}
  .hz-cell.picked{background:#163a2a;border-color:var(--dl-emerald-bright);color:#eaf2ff;font-weight:700;}
  .hz-cell.right{outline:2px solid #2f9e5c;outline-offset:1px;}
