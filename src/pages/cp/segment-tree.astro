  table.rec td strong{color:var(--dl-gold);}
  table.rec td.num{
    text-align:right;
    font-family:"Fira Code","Fira Mono",monospace;
    font-variant-numeric:tabular-nums;
    white-space:nowrap;
    color:#cdd6ea;
  }
  table.rec th.num{text-align:right;}

  .dim{color:#7b8397;}

  /* แถบอาเรย์ .ps-strip กับปุ่ม .ps-key ย้ายไปนิยามที่ CpProblemLayout แล้ว
     เพราะมีสามหน้าที่ใช้คลาสชุดนี้ ที่นี่จึงไม่ต้องมีอะไรอีก */

  /* ---------- ภาพต้นไม้ในเครื่องเดินทีละขั้น กับในมินิเกม ----------
     ความกว้างจริงตั้งจาก viewBox ในมาร์กอัป ที่นี่คุมแค่การย่อบนจอแคบ
     ไม่เขียนเป็น .dps-scroll svg เพราะ .dps-scroll เป็นของ CpStepPlayer คนละ cid กับหน้านี้
     ตัวเลือกที่ลอดผ่านกล่องของคอมโพเนนต์จะไม่ตรงกับอะไรเลย โดยไม่มีอะไรฟ้อง */
  .qtree, .kztree, .asntree, .pertree{
    display:block;
    max-width:100%;
    height:auto;
    margin:0 auto;
  }
  /* บนจอแคบ ห้ามย่อภาพลงตามการ์ด เพราะป้ายในปมมีขนาด 9 ถึง 13 พิกเซลอยู่แล้ว
     ย่อเหลือครึ่งหนึ่งเมื่อไรก็อ่านไม่ออกทันที ให้กล่องที่ครอบมันเลื่อนแนวนอนแทน
     ซึ่งทั้ง .dps-scroll และ .cpg-scroll ทำได้อยู่แล้ว หน้าเว็บจึงไม่เลื่อนตาม */
  @media (max-width:720px){
    .qtree, .kztree, .asntree, .pertree{max-width:none;}
  }

  /* ปุ่มลงซ้ายกับลงขวาต้องกว้างเท่ากันเสมอ ไม่งั้นแถบปุ่มขยับตอนข้อความสถานะเปลี่ยน */
  .kzgame .cpg-btn.main{min-width:6.2rem;}
  .kzbits{font-family:var(--dl-mono,monospace);letter-spacing:0.16em;color:#cdd6ea;}

  /* หัวข้อย่อยต้องเล็กกว่า h2 ของเลย์เอาต์ ซึ่งอยู่ที่ 1rem
     และมีระยะห่างด้านบนน้อยกว่า h2 เพื่อให้อ่านเป็นหัวข้อลูก ไม่ใช่หัวข้อพี่น้อง */
  h3{
    font-size:0.92rem;
    margin:1.5rem auto 0.5rem;
    max-width:46rem;
    color:var(--dl-ink);
    letter-spacing:0.02em;
  }
</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type SgStep = { kind: string; text: string; answer: number; arr: number[]; l: number; r: number };
  type SgPuzzle = { id: string; label: string; tease: string; arr: number[]; steps: SgStep[] };

  function initSegGame(): void {
    const maybeUi = cpGameUi('[data-sggame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as SgPuzzle[];
    if (puzzles.length === 0) return;

    const stripEl = ui.root.querySelector<HTMLElement>('[data-sg-strip]');
    const taskEl = ui.root.querySelector<HTMLElement>('[data-sg-task]');
    const padEl = ui.root.querySelector<HTMLElement>('[data-sg-pad]');
    const typedEl = ui.root.querySelector<HTMLElement>('[data-sg-typed]');
    const scoreEl = ui.root.querySelector<HTMLElement>('[data-sg-right]');
    const totalEl = ui.root.querySelector<HTMLElement>('[data-sg-total]');
    if (!stripEl || !taskEl || !padEl || !typedEl || !scoreEl || !totalEl) return;
    const strip: HTMLElement = stripEl;
    const taskOut: HTMLElement = taskEl;
    const pad: HTMLElement = padEl;
    const typedOut: HTMLElement = typedEl;
    const rightOut: HTMLElement = scoreEl;
    const totalOut: HTMLElement = totalEl;

    let pi = 0;
    let si = 0;
    let typed = '';
    let right = 0;

    const pz = (): SgPuzzle => puzzles[pi];
    const step = (): SgStep | undefined => pz().steps[si];

    function buildPad(): void {
      pad.textContent = '';
      for (const d of ['1', '2', '3', '4', '5', '6', '7', '8', '9', '0']) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cpg-btn ps-key';
        b.dataset.digit = d;
        b.textContent = d;
        pad.appendChild(b);
      }
    }

    function render(): void {
      const p = pz();
      const st = step();
      const arr = st ? st.arr : p.arr;
      strip.textContent = '';
      arr.forEach((v, i) => {
        const cell = document.createElement('span');
        cell.className = 'ps-cell';
        const idx = document.createElement('small');
        idx.textContent = String(i + 1);
        const val = document.createElement('b');
        val.textContent = String(v);
        cell.append(idx, val);
        if (st && i + 1 >= st.l && i + 1 <= st.r) {
          cell.classList.add(st.kind === 'min' ? 'in' : 'touched');
        }
        strip.appendChild(cell);
      });
      taskOut.textContent = st ? st.text : 'จบชุดนี้แล้ว';
      typedOut.textContent = typed === '' ? '-' : typed;
      rightOut.textContent = String(right);
      totalOut.textContent = String(p.steps.filter((x) => x.kind === 'min').length);
    }

    function advanceThroughSets(): void {
      // ข้ามขั้นที่เป็นการแก้ค่าไปเอง เพราะไม่ต้องให้ผู้เล่นตอบ
      while (step() !== undefined && (step() as SgStep).kind === 'add') {
        ui.setStatus(`${(step() as SgStep).text} แล้ว ลองดูว่าค่าน้อยสุดของช่วงไหนเปลี่ยนไปบ้าง`, 'plain');
        si++;
      }
    }

    function submit(): void {
      const st = step();
      if (st === undefined) {
        ui.setStatus('จบชุดนี้แล้วครับ', 'plain');
        return;
      }
      if (typed === '') {
        ui.setStatus('พิมพ์คำตอบก่อนครับ', 'bad');
        return;
      }
      if (Number(typed) === st.answer) {
        right++;
        ui.setStatus(`ถูกต้อง ${st.text} เท่ากับ ${st.answer}`, 'good');
      } else {
        ui.setStatus(`ยังไม่ใช่ ${st.text} เท่ากับ ${st.answer}`, 'bad');
      }
      typed = '';
      si++;
      advanceThroughSets();
      render();
      if (step() === undefined) {
        const p = pz();
        const asks = p.steps.filter((x) => x.kind === 'min').length;
        ui.setStatus(`จบชุดนี้ ตอบถูก ${right} จาก ${asks} ข้อ`, right === asks ? 'good' : 'bad');
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      si = 0;
      typed = '';
      right = 0;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildPad();
      advanceThroughSets();
      ui.setStatus('อ่านคำถามแล้วพิมพ์ค่าน้อยสุดของช่วงที่ถูกไฮไลต์');
      render();
    }

    pad.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('[data-digit]');
      if (!(b instanceof HTMLElement)) return;
      typed += b.dataset.digit ?? '';
      render();
    });

    ui.onClick('data-sg-clear', () => {
      typed = '';
      render();
    });
    ui.onClick('data-sg-submit', submit);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initSegGame);
</script>

<script>
  /* เครื่องเดินทั้งสามตัวของหน้านี้ ทาสีปมตามสถานะที่สเต็ปบอก
     สเต็ปทุกตัวถูกสร้างตอนบิลด์จากการเดินอัลกอริทึมจริง สคริปต์นี้จึงมีหน้าที่วาดอย่างเดียว */
  import { initCpPlayers } from '../../lib/cpPlayer';

  const INK = {
    full: { fill: '#12291c', stroke: '#4ade80', text: '#d7ffe4', sub: '#7fd6a0', w: '2.2' },
    pass: { fill: '#2e2510', stroke: '#e0b400', text: '#ffe58a', sub: '#c9a83a', w: '2' },
    cut: { fill: '#1a1420', stroke: '#5b3a5f', text: '#8a6f92', sub: '#6b5570', w: '1.4' },
    idle: { fill: '#101827', stroke: '#2a3350', text: '#5b6478', sub: '#4a5468', w: '1.4' },
    now: { fill: '#2e2510', stroke: '#e0b400', text: '#ffe58a', sub: '#c9a83a', w: '2.4' },
    got: { fill: '#12291c', stroke: '#4ade80', text: '#d7ffe4', sub: '#7fd6a0', w: '2.2' },
    seen: { fill: '#101827', stroke: '#2f9e5c', text: '#cdd6ea', sub: '#7b8397', w: '1.6' },
  };
  type InkKind = keyof typeof INK;

  function paint(g: SVGGElement, kind: InkKind): void {
    const ink = INK[kind];
    const rect = g.querySelector('rect');
    const texts = g.querySelectorAll('text');
    if (rect) {
      rect.setAttribute('fill', ink.fill);
      rect.setAttribute('stroke', ink.stroke);
      rect.setAttribute('stroke-width', ink.w);
    }
    if (texts[0]) texts[0].setAttribute('fill', ink.text);
    if (texts[1]) texts[1].setAttribute('fill', ink.sub);
  }

  /* ---------- ก. คำถามหนึ่งครั้งเดินแตะปมไหนบ้าง ---------- */
  interface QVisitClient {
    id: number;
    kind: 'full' | 'pass' | 'cut';
    acc: string;
    depth: number;
    note: string;
  }
  function isQVisit(x: unknown): x is QVisitClient {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return typeof o.id === 'number' && typeof o.kind === 'string' && typeof o.note === 'string';
  }

  /* ---------- ค. ป้ายกำหนดค่า และการดันป้ายลงลูก ---------- */
  interface AsnCellClient { id: number; sum: number; mark: number | null }
  interface AsnStepClient { cells: AsnCellClient[]; hot: number[]; push: number[]; note: string }
  function isAsnStep(x: unknown): x is AsnStepClient {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return Array.isArray(o.cells) && Array.isArray(o.hot) && Array.isArray(o.push) && typeof o.note === 'string';
  }

  /* ---------- ง. ต้นไม้ที่จำอดีตได้ ---------- */
  interface PerStepClient { show: string[]; hot: string | null; note: string }
  function isPerStep(x: unknown): x is PerStepClient {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return Array.isArray(o.show) && typeof o.note === 'string';
  }

  document.addEventListener('astro:page-load', () => {
    initCpPlayers<QVisitClient>('[data-qsim]', {
      narrow: (raw) => {
        const ok = raw.filter(isQVisit);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      draw: (st, ctx) => {
        /* ปมที่ถูกแตะไปแล้วในก้าวก่อนหน้ายังคงสีไว้ ผู้อ่านจะได้เห็นเส้นทางสะสม
           ไม่ใช่เห็นทีละปมแล้วลืมว่าเพิ่งผ่านอะไรมา จึงวาดใหม่จากต้นทุกครั้ง */
        const nodes = new Map<number, SVGGElement>();
        ctx.parts.root.querySelectorAll<SVGGElement>('g.qnode').forEach((g) => {
          paint(g, 'idle');
          nodes.set(Number(g.dataset.id), g);
        });
        const parsed: unknown = JSON.parse(ctx.parts.root.dataset.steps ?? '[]');
        if (Array.isArray(parsed)) {
          for (let i = 0; i <= ctx.at; i++) {
            const v: unknown = parsed[i];
            if (!isQVisit(v) || v.id === 0) continue;
            const g = nodes.get(v.id);
            if (g) paint(g, v.kind);
          }
        }
        const cur = nodes.get(st.id);
        if (cur) {
          ctx.keepInView(cur);
          const rect = cur.querySelector('rect');
          if (rect) rect.setAttribute('stroke-width', '3');
        }
      },
    });

    initCpPlayers<AsnStepClient>('[data-asnsim]', {
      playMs: 1500,
      narrow: (raw) => {
        const ok = raw.filter(isAsnStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      draw: (st, ctx) => {
        ctx.parts.root.querySelectorAll<SVGGElement>('g.asnnode').forEach((g) => {
          const id = Number(g.dataset.id);
          const cell = st.cells.filter((c) => c.id === id)[0];
          const sumEl = g.querySelector('text.asnsum');
          const markEl = g.querySelector('text.asnmark');
          if (!cell || !sumEl || !markEl) return;
          sumEl.textContent = String(cell.sum);
          markEl.textContent = cell.mark === null ? '' : `ป้าย ${cell.mark}`;
          const kind: InkKind = st.hot.indexOf(id) !== -1 ? 'now' : st.push.indexOf(id) !== -1 ? 'got' : cell.mark !== null ? 'seen' : 'idle';
          paint(g, kind);
          if (cell.mark === null) markEl.setAttribute('fill', '#5b6478');
        });
      },
    });

    initCpPlayers<PerStepClient>('[data-persim]', {
      playMs: 1400,
      narrow: (raw) => {
        const ok = raw.filter(isPerStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      draw: (st, ctx) => {
        ctx.parts.root.querySelectorAll<SVGGElement>('g.pernode').forEach((g) => {
          const key = g.dataset.key ?? '';
          if (key.indexOf('v0') === 0) {
            g.setAttribute('opacity', '1');
            return;
          }
          const on = st.show.indexOf(key) !== -1;
          g.setAttribute('opacity', on ? '1' : '0');
          if (on && key === st.hot) {
            const rect = g.querySelector('rect');
            if (rect) rect.setAttribute('stroke-width', '3');
          } else {
            const rect = g.querySelector('rect');
            if (rect) rect.setAttribute('stroke-width', '2');
          }
        });
        ctx.parts.root.querySelectorAll<SVGLineElement>('line.peredge').forEach((ln) => {
          const from = ln.dataset.from ?? '';
          ln.setAttribute('opacity', st.show.indexOf(from) !== -1 ? '1' : '0');
        });
      },
    });
  });
</script>

<script>
  /* มินิเกม เดินลงต้นไม้หาศูนย์ตัวที่ k
     ผู้เล่นเลือกลงซ้ายหรือลงขวาทีละชั้น เกมไม่ได้ตรวจว่าเดินตรงกับอัลกอริทึมไหม
     แต่ตรวจว่าใบที่ไปจบเป็นคำตอบจริงหรือเปล่า ซึ่งคำนวณไว้ตอนบิลด์ด้วยการกวาดอาเรย์ */
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  interface KzNode { id: number; lo: number; hi: number; cnt: number }
  interface KzRound { k: number; answer: number | null; bits: number[]; nodes: KzNode[] }
  interface KzPuzzle { id: string; label: string; tease: string; rounds: KzRound[] }

  function initKzGame(): void {
    const maybeUi = cpGameUi('[data-kzgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as KzPuzzle[];
    if (puzzles.length === 0) return;

    const bitsEl = ui.root.querySelector<HTMLElement>('[data-kz-bits]');
    const rightEl = ui.root.querySelector<HTMLElement>('[data-kz-right-count]');
    const totalEl = ui.root.querySelector<HTMLElement>('[data-kz-total]');
    const svgEl = ui.root.querySelector<SVGSVGElement>('svg.kztree');
    if (!bitsEl || !rightEl || !totalEl || !svgEl) return;
    const bitsOut: HTMLElement = bitsEl;
    const rightOut: HTMLElement = rightEl;
    const totalOut: HTMLElement = totalEl;
    const svg: SVGSVGElement = svgEl;
    bitsOut.classList.add('kzbits');

    let pi = 0;
    let ri = 0;
    let cur = 1;
    let need = 0;
    let solved = 0;
    let done = false;

    const pz = (): KzPuzzle => puzzles[pi];
    const round = (): KzRound | undefined => pz().rounds[ri];
    const nodeOf = (id: number): KzNode | undefined => round()?.nodes.filter((n) => n.id === id)[0];

    function render(): void {
      const r = round();
      const path: number[] = [];
      for (let v = cur; v >= 1; v = Math.floor(v / 2)) path.push(v);
      svg.querySelectorAll<SVGGElement>('g.kznode').forEach((g) => {
        const id = Number(g.dataset.id);
        const n = r ? nodeOf(id) : undefined;
        const cnt = g.querySelector('text.kzcnt');
        if (cnt) cnt.textContent = n ? String(n.cnt) : '·';
        const rect = g.querySelector('rect');
        const onPath = path.indexOf(id) !== -1;
        const isCur = id === cur;
        if (rect) {
          rect.setAttribute('fill', isCur ? '#2e2510' : onPath ? '#12291c' : '#101827');
          rect.setAttribute('stroke', isCur ? '#e0b400' : onPath ? '#2f9e5c' : '#2a3350');
          rect.setAttribute('stroke-width', isCur ? '2.6' : onPath ? '1.8' : '1.4');
        }
        if (cnt) cnt.setAttribute('fill', isCur ? '#ffe58a' : onPath ? '#d7ffe4' : '#cdd6ea');
      });
      bitsOut.textContent = r ? r.bits.join(' ') : '-';
      rightOut.textContent = String(solved);
      totalOut.textContent = String(pz().rounds.length);
    }

    function ask(): void {
      const r = round();
      if (r === undefined) {
        done = true;
        ui.setStatus(`จบด่านนี้แล้ว ผ่าน ${solved} จาก ${pz().rounds.length} ข้อ`, solved === pz().rounds.length ? 'good' : 'bad');
        render();
        return;
      }
      done = false;
      cur = 1;
      need = r.k;
      ui.setStatus(`หาศูนย์ตัวที่ ${r.k} ตอนนี้ยืนอยู่ที่รากซึ่งดูแลทั้งอาเรย์ จะลงซ้ายหรือลงขวา`, 'plain');
      render();
    }

    function finishLeaf(): void {
      const r = round();
      const n = nodeOf(cur);
      if (r === undefined || n === undefined) return;
      const ok = r.answer !== null && n.lo === r.answer;
      if (ok) {
        solved++;
        ui.setStatus(`ถูกต้อง ศูนย์ตัวที่ ${r.k} อยู่ที่ช่อง ${n.lo}`, 'good');
      } else if (r.answer === null) {
        ui.setStatus(`ยังไม่ใช่ ชุดนี้มีศูนย์ไม่ถึง ${r.k} ตัว คำตอบคือไม่มี ไม่ใช่ช่องใดช่องหนึ่ง`, 'bad');
      } else {
        ui.setStatus(`ยังไม่ใช่ ช่อง ${n.lo} ไม่ใช่ศูนย์ตัวที่ ${r.k} คำตอบคือช่อง ${r.answer}`, 'bad');
      }
      done = true;
      ri++;
      render();
      window.setTimeout(ask, 1400);
    }

    function go(dir: 'left' | 'right'): void {
      if (done) return;
      const n = nodeOf(cur);
      if (n === undefined) return;
      if (n.lo === n.hi) return;
      const left = nodeOf(cur * 2);
      if (left === undefined) return;
      if (dir === 'right') need -= left.cnt;
      cur = dir === 'left' ? cur * 2 : cur * 2 + 1;
      const nn = nodeOf(cur);
      if (nn === undefined) return;
      if (nn.lo === nn.hi) {
        finishLeaf();
        return;
      }
      ui.setStatus(
        `ตอนนี้อยู่ที่ปมที่ดูแลช่อง ${nn.lo} ถึง ${nn.hi} และกำลังตามหาศูนย์ตัวที่ ${need} ของปมนี้`,
        'plain',
      );
      render();
    }

    function claimNone(): void {
      if (done) return;
      const r = round();
      if (r === undefined) return;
      if (r.answer === null) {
        solved++;
        ui.setStatus(`ถูกต้อง ชุดนี้มีศูนย์ไม่ถึง ${r.k} ตัว จึงไม่มีคำตอบ`, 'good');
      } else {
        ui.setStatus(`ยังไม่ใช่ ชุดนี้มีคำตอบอยู่ คือช่อง ${r.answer}`, 'bad');
      }
      done = true;
      ri++;
      render();
      window.setTimeout(ask, 1400);
    }

    function selectPuzzle(k: number): void {
      pi = k;
      ri = 0;
      solved = 0;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ask();
    }

    ui.onClick('data-kz-left', () => go('left'));
    ui.onClick('data-kz-right', () => go('right'));
    ui.onClick('data-kz-none', claimNone);
    ui.onClick('data-kz-reset', () => {
      if (ri >= pz().rounds.length) return;
      ask();
    });
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initKzGame);
</script>
