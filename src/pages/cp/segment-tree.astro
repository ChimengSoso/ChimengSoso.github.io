 else{int l,r;scanf("%d %d",&l,&r);long long s=0;for(int i=l;i<=r;i++)s+=a[i];
  printf("%lld\\n",s);}}
return 0;}`;


/* ผังของภาพต้นไม้ที่ทุกปมเก็บรายการเรียง กล่องกว้างตามจำนวนตัวเลขที่ปมนั้นถือ
   ความกว้างของ viewBox คิดจากขอบขวาสุดของกล่องจริง ไม่ได้ปัดเป็นเลขกลม
   ไม่งั้นภาพจะดูเหมือนถูกดันไปทางซ้าย */
const MS_DRAW = TREE;
const MSH = 28;
const MS_SLOT = 78;
const msItems = (n: SgNode): number => (msSorted.get(n.id) ?? []).length;
const msW = (n: SgNode): number => 16 + msItems(n) * 15;
const msCx = (n: SgNode): number => 12 + ((n.lo + n.hi) / 2 + 0.5) * MS_SLOT;
const msX = (n: SgNode): number => msCx(n) - msW(n) / 2;
const msY = (n: SgNode): number => 10 + n.depth * 46;
const MS_RIGHT = Math.max(...MS_DRAW.map((n) => msX(n) + msW(n)));
const MS_BOTTOM = Math.max(...MS_DRAW.map((n) => msY(n) + MSH));
const MS_VB = `0 0 ${Math.ceil(MS_RIGHT) + 12} ${Math.ceil(MS_BOTTOM) + 34}`;

/* บรรทัดที่พังของการเดินลงต้นไม้ ตัดมาจากไฟล์จริงที่คอมไพล์แล้วเทียบกับตัวตรวจ */
