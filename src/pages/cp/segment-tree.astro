/* ---------- ข. มินิเกม เดินลงต้นไม้หาศูนย์ตัวที่ k ----------
   ต้นไม้เก็บจำนวนศูนย์ในช่วง คำถามคือศูนย์ตัวที่ k อยู่ช่องไหน
   เฉลยของทุกด่านคิดจากการกวาดอาเรย์ตรง ๆ ไม่ได้ใช้การเดินลงต้นไม้ที่บทนี้กำลังสอน
   แล้วเอาสองวิธีมาเทียบกันตอนบิลด์ ถ้าไม่ตรงกันหน้าจะไม่ยอมถูกสร้าง */
interface ZeroNode {
  id: number;
  lo: number;
  hi: number;
  cnt: number;
  depth: number;
}
function buildZeroTree(bits: number[]): ZeroNode[] {
  const out: ZeroNode[] = [];
  const go = (id: number, lo: number, hi: number, depth: number): number => {
    if (lo === hi) {
      const c = bits[lo] === 0 ? 1 : 0;
      out.push({ id, lo, hi, cnt: c, depth });
      return c;
    }
    const mid = Math.floor((lo + hi) / 2);
    const c = go(id * 2, lo, mid, depth + 1) + go(id * 2 + 1, mid + 1, hi, depth + 1);
    out.push({ id, lo, hi, cnt: c, depth });
    return c;
  };
  go(1, 0, bits.length - 1, 0);
  return out.sort((x, y) => x.id - y.id);
}
/** เฉลยแบบกวาดตรง ๆ คืนตำแหน่งของศูนย์ตัวที่ k นับจากหนึ่ง หรือ null เมื่อไม่มี */
function kthZeroBrute(bits: number[], k: number): number | null {
  let seen = 0;
  for (let i = 0; i < bits.length; i++) {
    if (bits[i] === 0) {
      seen++;
      if (seen === k) return i;
    }
  }
  return null;
}
/** เฉลยแบบเดินลงต้นไม้ คืนลำดับปมที่เดินผ่าน พร้อมตำแหน่งปลายทาง */
function kthZeroDescend(nodes: ZeroNode[], k: number): { path: number[]; pos: number | null } {
  const map = new Map<number, ZeroNode>(nodes.map((n) => [n.id, n]));
  const root = map.get(1);
  if (root === undefined || root.cnt < k) return { path: [1], pos: null };
  const path: number[] = [1];
  let cur = 1;
  let need = k;
  for (;;) {
    const n = map.get(cur);
    if (n === undefined) throw new Error('ต้นไม้ของเกมไม่ครบ');
    if (n.lo === n.hi) return { path, pos: n.lo };
    const left = map.get(cur * 2);
    if (left === undefined) throw new Error('ต้นไม้ของเกมไม่ครบ');
    if (left.cnt >= need) cur = cur * 2;
    else {
      need -= left.cnt;
      cur = cur * 2 + 1;
    }
    path.push(cur);
  }
}

