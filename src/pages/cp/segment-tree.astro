          {OPS.map((o) => <>{o.kind === 'add' ? `1 ${o.l} ${o.r} ${o.v}` : `2 ${o.l} ${o.r}`}<br /></>)}
        </td>
        <td>{rows.filter((r) => r.out !== null).map((r) => <>{r.out}<br /></>)}</td>
