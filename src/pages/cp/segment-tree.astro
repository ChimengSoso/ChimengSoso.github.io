  return out.sort((x, y) => x.id - y.id);
})();

type AsnCell = { id: number; sum: number; mark: number | null };
type AsnStep = { cells: AsnCell[]; hot: number[]; push: number[]; note: string };

function runAssignSim(): { steps: AsnStep[]; finalArr: number[]; queryAnswer: number } {
  const sum = new Map<number, number>();
  const mark = new Map<number, number | null>();
  const steps: AsnStep[] = [];
  const nodeOf = new Map<number, AsnNode>(ASN_NODES.map((n) => [n.id, n]));
  const at = (id: number): AsnNode => {
    const n = nodeOf.get(id);
    if (n === undefined) throw new Error(`ไม่มีปม ${id}`);
    return n;
  };
  const build = (id: number): number => {
    const n = at(id);
    mark.set(id, null);
    if (n.lo === n.hi) {
      sum.set(id, ASN_A[n.lo]);
      return ASN_A[n.lo];
    }
    const v = build(id * 2) + build(id * 2 + 1);
    sum.set(id, v);
    return v;
  };
  const snap = (hot: number[], push: number[], note: string): void => {
    steps.push({
      cells: ASN_NODES.map((n) => ({ id: n.id, sum: sum.get(n.id) ?? 0, mark: mark.get(n.id) ?? null })),
      hot,
      push,
      note,
    });
  };
  const rangeText = (id: number): string => {
    const n = at(id);
    return n.lo === n.hi ? `ช่อง ${n.lo}` : `ช่อง ${n.lo} ถึง ${n.hi}`;
  };
  /** ดันป้ายของปมลงลูกทั้งสอง แล้วล้างป้ายของตัวเอง */
  const push = (id: number): boolean => {
    const m = mark.get(id) ?? null;
    if (m === null) return false;
    for (const c of [id * 2, id * 2 + 1]) {
      const cn = at(c);
      sum.set(c, m * (cn.hi - cn.lo + 1));
      mark.set(c, m);
    }
    mark.set(id, null);
    snap(
      [id],
      [id * 2, id * 2 + 1],
      `ปม ${rangeText(id)} มีป้าย <b>กำหนดค่าเป็น ${m}</b> ค้างอยู่ และตอนนี้เราจำเป็นต้องลงไปดูลูกของมัน จึงต้อง<b>ดันป้ายลงลูก</b>ก่อน ลูกทั้งสองรับป้ายเดียวกันไป แล้วผลรวมของลูกก็คิดใหม่เป็นค่าที่กำหนดคูณจำนวนช่องที่มันดูแล พอส่งต่อแล้วป้ายของปมนี้ก็ถูกล้าง เพราะงานถูกส่งไปอยู่ที่ลูกแล้ว`,
    );
    return true;
  };
  const assign = (id: number, ql: number, qr: number, v: number): void => {
    const n = at(id);
    if (qr < n.lo || n.hi < ql) return;
    if (ql <= n.lo && n.hi <= qr) {
      sum.set(id, v * (n.hi - n.lo + 1));
      mark.set(id, v);
      snap(
        [id],
        [],
        `ปม ${rangeText(id)} อยู่ในคำสั่งพอดีทั้งก้อน จึง<b>แปะป้ายไว้เฉย ๆ</b> ว่าทั้งช่วงนี้ถูกกำหนดเป็น ${v} แล้วคิดผลรวมของตัวเองใหม่เป็น ${v * (n.hi - n.lo + 1)} ลูกของมันยังเก็บค่าเก่าอยู่ ซึ่งไม่เป็นไร ตราบใดที่ยังไม่มีใครลงไปถามลูก`,
      );
      return;
    }
    push(id);
    assign(id * 2, ql, qr, v);
    assign(id * 2 + 1, ql, qr, v);
    sum.set(id, (sum.get(id * 2) ?? 0) + (sum.get(id * 2 + 1) ?? 0));
    snap(
      [id],
      [],
      `ลูกทั้งสองของปม ${rangeText(id)} จัดการเสร็จแล้ว จึงรวมค่าของลูกขึ้นมาเป็นผลรวมใหม่ของปมนี้ ได้ ${sum.get(id)}`,
    );
  };
  const query = (id: number, ql: number, qr: number): number => {
    const n = at(id);
    if (qr < n.lo || n.hi < ql) return 0;
    if (ql <= n.lo && n.hi <= qr) {
      snap(
        [id],
        [],
        `ปม ${rangeText(id)} อยู่ในคำถามพอดี จึงตอบด้วยผลรวมที่มันเก็บไว้ คือ ${sum.get(id)}`,
      );
      return sum.get(id) ?? 0;
    }
    push(id);
    return query(id * 2, ql, qr) + query(id * 2 + 1, ql, qr);
  };

  build(1);
  snap([], [], `ต้นไม้ของอาเรย์ ${ASN_A.join(', ')} ตัวเลขบนคือผลรวมของช่วงที่ปมนั้นดูแล ยังไม่มีป้ายค้างที่ไหนเลย`);
  assign(1, 0, 3, 5);
  assign(1, 2, 3, 9);
  const ans = query(1, 1, 2);
  snap([], [], `คำตอบของช่วงช่อง 1 ถึง 2 คือ <b>${ans}</b> สังเกตว่าป้ายที่เคยค้างอยู่ที่รากถูกดันลงมาทีละชั้นเฉพาะทางที่คำถามเดินผ่านเท่านั้น ทางที่ไม่มีใครถามยังคงมีป้ายค้างอยู่เหมือนเดิม`);

  /* ตรวจกับการไล่อาเรย์ตรง ๆ ถ้าไม่ตรงกันแปลว่าภาพในเครื่องเดินนี้โกหก */
  const flat = [...ASN_A];
  for (let i = 0; i <= 3; i++) flat[i] = 5;
  for (let i = 2; i <= 3; i++) flat[i] = 9;
  const bruteAns = flat[1] + flat[2];
  if (bruteAns !== ans) throw new Error(`เครื่องเดินป้ายกำหนดค่าตอบ ${ans} แต่การไล่อาเรย์ตรง ๆ ตอบ ${bruteAns}`);
  return { steps, finalArr: flat, queryAnswer: ans };
}
