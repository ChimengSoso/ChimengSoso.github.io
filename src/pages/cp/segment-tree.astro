---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const href = 'segment-tree/';

/* ---------- ตัวเลขในหน้านี้งอกจากโมเดลข้างล่างนี้ ---------- */

const A = [5, 2, 9, 1, 7, 3, 8, 4];

type Op = { kind: 'add'; l: number; r: number; v: number } | { kind: 'min'; l: number; r: number };
const OPS: Op[] = [
  { kind: 'min', l: 0, r: 7 },
  { kind: 'add', l: 2, r: 5, v: -3 },
  { kind: 'min', l: 3, r: 6 },
  { kind: 'add', l: 0, r: 3, v: 4 },
  { kind: 'min', l: 0, r: 4 },
];
type Row = { i: number; text: string; arr: number[]; out: number | null };
function runOps(): Row[] {
  const a = [...A];
  return OPS.map((op, i) => {
    if (op.kind === 'add') {
      for (let k = op.l; k <= op.r; k++) a[k] += op.v;
      return { i: i + 1, text: `บวก ${op.v} ให้ช่อง ${op.l} ถึง ${op.r}`, arr: [...a], out: null };
    }
    const m = Math.min(...a.slice(op.l, op.r + 1));
    return { i: i + 1, text: `ถามค่าน้อยสุดของช่อง ${op.l} ถึง ${op.r}`, arr: [...a], out: m };
  });
}
const rows = runOps();

/* ---------- โครงต้นไม้ของอาเรย์ตัวอย่าง ใช้วาดภาพ ----------
   สร้างจาก A ตัวเดียวกับที่ตารางข้างล่างใช้ ค่าในปมจึงเป็นค่าน้อยสุดจริงของช่วงนั้น
   และรายชื่อปมที่คำถามแตะก็มาจากการเดินต้นไม้จริง ไม่ใช่การเลือกด้วยตา */
interface SgNode {
  id: number;
  lo: number;
  hi: number;
  val: number;
  depth: number;
}
function buildTree(a: number[]): SgNode[] {
  const out: SgNode[] = [];
  const go = (id: number, lo: number, hi: number, depth: number): number => {
    if (lo === hi) {
      out.push({ id, lo, hi, val: a[lo], depth });
      return a[lo];
    }
    const mid = Math.floor((lo + hi) / 2);
    const v = Math.min(go(id * 2, lo, mid, depth + 1), go(id * 2 + 1, mid + 1, hi, depth + 1));
    out.push({ id, lo, hi, val: v, depth });
    return v;
  };
  go(1, 0, a.length - 1, 0);
  return out;
}
/** ปมที่การถามช่วง [ql..qr] แตะจริง แยกเป็นปมที่ตอบได้ทั้งก้อน กับปมที่ต้องเดินผ่านลงไป */
function touched(a: number[], ql: number, qr: number): { full: number[]; pass: number[] } {
  const full: number[] = [];
  const pass: number[] = [];
  const go = (id: number, lo: number, hi: number): void => {
    if (qr < lo || hi < ql) return;
    if (ql <= lo && hi <= qr) {
      full.push(id);
      return;
    }
    pass.push(id);
    const mid = Math.floor((lo + hi) / 2);
    go(id * 2, lo, mid);
    go(id * 2 + 1, mid + 1, hi);
  };
  go(1, 0, a.length - 1);
  return { full, pass };
}
const TREE = buildTree(A);
const QL = 3;
const QR = 6;
const HIT = touched(A, QL, QR);
const qAnswer = Math.min(...A.slice(QL, QR + 1));

/* พิกัดของภาพ ปมกว้าง 60 เรียงตามลำดับใบซ้ายไปขวา ชั้นละ 62 พิกเซล */
const NW = 60;
const NH = 46;
const NGAP = 8;
const LEAF_N = A.length;
const nodeX = (n: SgNode): number => 16 + ((n.lo + n.hi) / 2) * (NW + NGAP) + (NW + NGAP - NW) / 2;
const nodeY = (n: SgNode): number => 30 + n.depth * 62;
const TREE_W = 16 + LEAF_N * (NW + NGAP) - NGAP + 16;
const TREE_H = 30 + 4 * 62 + 30;
const treeVB = `0 0 ${TREE_W} ${TREE_H}`;
const parentOf = (id: number): SgNode | undefined => TREE.find((n) => n.id === Math.floor(id / 2));
const kindOf = (id: number): 'full' | 'pass' | 'none' =>
  HIT.full.indexOf(id) !== -1 ? 'full' : HIT.pass.indexOf(id) !== -1 ? 'pass' : 'none';
const FILL = { full: '#12291c', pass: '#2e2510', none: '#141b2b' };
const LINE = { full: '#4ade80', pass: '#e0b400', none: '#2a3350' };
const INK = { full: '#d7ffe4', pass: '#ffe58a', none: '#7b8397' };

/* ต้นทุนของสองแนวคิด */
const NB = 200000;
const QB = 200000;
const costRows = [
  { name: 'แก้ทีละช่อง ถามทีละช่อง', per: 'n ต่อหนึ่งคำสั่ง', total: NB * QB },
  { name: 'เซกเมนต์ทรีแบบมีป้ายค้าง', per: 'ราว 2 log n ต่อหนึ่งคำสั่ง', total: Math.round(QB * 2 * Math.log2(NB)) },
];

/* ตัวอย่างการค้นหาคำตอบแบบไบนารี */
const TIMES = [3, 5, 7];
const NEED = 10;
const made = (T: number): number => TIMES.reduce((s, t) => s + Math.floor(T / t), 0);
let bsHi = Math.min(...TIMES) * NEED;
let bsLo = 1;
type BsRow = { lo: number; hi: number; mid: number; got: number; ok: boolean };
const bsRows: BsRow[] = [];
while (bsLo < bsHi) {
  const mid = bsLo + Math.floor((bsHi - bsLo) / 2);
  const got = made(mid);
  const ok = got >= NEED;
  bsRows.push({ lo: bsLo, hi: bsHi, mid, got, ok });
  if (ok) bsHi = mid;
  else bsLo = mid + 1;
}
const bsAnswer = bsLo;

const fmt = (n: number): string => n.toLocaleString('en-US');

const code1 = `// เซกเมนต์ทรีแบบบวกทั้งช่วง ถามค่าน้อยสุดของช่วง
// คำสั่ง "1 l r v" คือบวก v ให้ทุกช่องในช่วง  "2 l r" คือถามค่าน้อยสุดในช่วง
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
int SZ; vector<ll> mn, lz;
void build(int n) {
    SZ = 1; while (SZ < n) SZ <<= 1;
    mn.assign(2 * SZ, 0); lz.assign(2 * SZ, 0);
    for (int i = n; i < SZ; i++) mn[SZ + i] = LLONG_MAX / 4;   // ใบส่วนเกินต้องเป็นอนันต์
    for (int i = SZ - 1; i >= 1; i--) mn[i] = min(mn[2 * i], mn[2 * i + 1]);
}
void add(int node, int l, int r, int ql, int qr, ll v) {
    if (qr < l || r < ql) return;
    if (ql <= l && r <= qr) { mn[node] += v; lz[node] += v; return; }
    int m = (l + r) / 2;
    add(2 * node, l, m, ql, qr, v); add(2 * node + 1, m + 1, r, ql, qr, v);
    mn[node] = min(mn[2 * node], mn[2 * node + 1]) + lz[node];
}
ll query(int node, int l, int r, int ql, int qr) {
    if (qr < l || r < ql) return LLONG_MAX / 4;
    if (ql <= l && r <= qr) return mn[node];
    int m = (l + r) / 2;
    return min(query(2 * node, l, m, ql, qr), query(2 * node + 1, m + 1, r, ql, qr)) + lz[node];
}
int main() {
    int n, q; scanf("%d %d", &n, &q);
    build(n);
    for (int i = 0; i < n; i++) { ll v; scanf("%lld", &v); add(1, 0, SZ - 1, i, i, v); }
    while (q--) {
        int t, l, r; scanf("%d %d %d", &t, &l, &r);
        if (t == 1) { ll v; scanf("%lld", &v); add(1, 0, SZ - 1, l, r, v); }
        else printf("%lld\\n", query(1, 0, SZ - 1, l, r));
    }
}`;
const code2 = `// เครื่องจักร n เครื่อง เครื่องที่ i ผลิตได้หนึ่งชิ้นทุก t[i] หน่วยเวลา
// ถามว่าอย่างน้อยต้องใช้เวลาเท่าไรถึงจะได้ครบ m ชิ้น
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
int n; ll m;
vector<ll> t;
// ภายในเวลา T เครื่องที่ i ผลิตได้ T / t[i] ชิ้น  ฟังก์ชันนี้ไม่มีทางลดลงเมื่อ T เพิ่ม
bool enough(ll T) {
    ll made = 0;
    for (ll x : t) {
        made += T / x;
        if (made >= m) return true;              // ตัดตั้งแต่พอ กันค่าล้น
    }
    return false;
}
int main() {
    scanf("%d %lld", &n, &m);
    t.resize(n);
    for (auto& v : t) scanf("%lld", &v);
    ll lo = 1, hi = *min_element(t.begin(), t.end()) * m;   // เพดานคือใช้เครื่องเร็วสุดเครื่องเดียว
    while (lo < hi) { ll md = lo + (hi - lo) / 2; if (enough(md)) hi = md; else lo = md + 1; }
    printf("%lld\\n", lo);
}`;
/* ---------- มินิเกม บวกทั้งช่วง ถามค่าน้อยสุดของช่วง ----------
   คำตอบของทุกคำถามคิดจากอาเรย์จริงตอนบิลด์ ด้วยการวนหาค่าน้อยสุดตรง ๆ
   ไม่ได้ใช้เซกเมนต์ทรีที่บทนี้กำลังจะสอน */
type SgOp =
  | { kind: 'add'; l: number; r: number; v: number }
  | { kind: 'min'; l: number; r: number };

type SgPuzzle = { id: string; label: string; tease: string; arr: number[]; ops: SgOp[] };

const SG_PUZZLES: SgPuzzle[] = [
  {
    id: 'g1',
    label: 'ชุดที่ 1 · อุ่นเครื่อง',
    tease: 'บวกทีละช่วง แล้วถามค่าน้อยสุด ลองไล่ด้วยตาก่อน',
    arr: [5, 3, 8, 6, 2, 7],
    ops: [
      { kind: 'min', l: 1, r: 6 },
      { kind: 'add', l: 2, r: 4, v: 4 },
      { kind: 'min', l: 1, r: 4 },
      { kind: 'min', l: 4, r: 6 },
    ],
  },
  {
    id: 'g2',
    label: 'ชุดที่ 2 · บวกซ้อนกัน',
    tease: 'ชุดนี้ช่วงที่บวกซ้อนทับกัน ต้องระวังว่าช่องไหนโดนบวกกี่รอบ',
    arr: [9, 1, 4, 4, 7, 2, 6, 3],
    ops: [
      { kind: 'add', l: 1, r: 5, v: 2 },
      { kind: 'min', l: 1, r: 5 },
      { kind: 'add', l: 3, r: 8, v: 3 },
      { kind: 'min', l: 3, r: 6 },
      { kind: 'min', l: 1, r: 8 },
    ],
  },
];

type SgStep = { kind: string; text: string; answer: number; arr: number[]; l: number; r: number };
type SgPuzzleData = { id: string; label: string; tease: string; arr: number[]; steps: SgStep[] };

const sgPuzzles: SgPuzzleData[] = SG_PUZZLES.map((p) => {
  const cur = [...p.arr];
  const steps: SgStep[] = [];
  for (const op of p.ops) {
    if (op.kind === 'add') {
      for (let k = op.l - 1; k <= op.r - 1; k++) cur[k] += op.v;
      steps.push({
        kind: 'add',
        text: `บวก ${op.v} ให้ช่องที่ ${op.l} ถึง ${op.r}`,
        answer: -1,
        arr: [...cur],
        l: op.l,
        r: op.r,
      });
    } else {
      let m = Number.POSITIVE_INFINITY;
      for (let k = op.l - 1; k <= op.r - 1; k++) m = Math.min(m, cur[k]);
      steps.push({
        kind: 'min',
        text: `ค่าน้อยสุดของช่องที่ ${op.l} ถึง ${op.r}`,
        answer: m,
        arr: [...cur],
        l: op.l,
        r: op.r,
      });
    }
  }
  return { id: p.id, label: p.label, tease: p.tease, arr: p.arr, steps };
});
const sgJson = JSON.stringify(sgPuzzles);

/* ---------- เซกเมนต์ทรีแบบวนซ้ำ ----------
   โค้ดสองชิ้นนี้คอมไพล์แล้วสุ่มเทียบกัน 700 รอบ ตรงกันหมด
   วัดเวลาที่ขอบเขตจริงได้ 0.10 วินาที */
const itCode = `// เซกเมนต์ทรีแบบวนซ้ำ (iterative) หาค่าน้อยสุดของช่วง กับแก้ทีละช่อง
// ไม่มีการเรียกซ้ำเลย ต้นไม้เก็บในอาเรย์เดียว ใบเริ่มที่ตำแหน่ง sz
// อินพุต: n q, อาเรย์, แล้ว q บรรทัด  1 i v = ตั้ง a[i]=v, 2 l r = ถามค่าน้อยสุดช่วง l..r
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, q;
    if (scanf("%d %d", &n, &q) != 2) return 0;
    int sz = 1;
    while (sz < n) sz <<= 1;
    const long long INF = (long long)4e18;
    vector<long long> t(2 * sz, INF);           // ใบส่วนเกินต้องเป็น INF ไม่ใช่ 0
    for (int i = 0; i < n; i++) scanf("%lld", &t[sz + i]);
    for (int i = sz - 1; i >= 1; i--) t[i] = min(t[2 * i], t[2 * i + 1]);

    for (int k = 0; k < q; k++) {
        int op; scanf("%d", &op);
        if (op == 1) {
            int i; long long v; scanf("%d %lld", &i, &v);
            int p = sz + i;
            t[p] = v;
            for (p >>= 1; p >= 1; p >>= 1) t[p] = min(t[2 * p], t[2 * p + 1]);
        } else {
            int l, r; scanf("%d %d", &l, &r);
            // ไต่จากใบขึ้นไป เก็บค่าของฝั่งที่หลุดออกจากคู่ของตัวเอง
            long long res = INF;
            int a = l + sz, b = r + sz + 1;
            while (a < b) {
                if (a & 1) res = min(res, t[a++]);
                if (b & 1) res = min(res, t[--b]);
                a >>= 1;
                b >>= 1;
            }
            printf("%lld\\n", res);
        }
    }
    return 0;
}`;
const itBrute = `// ตัวตรวจอิสระของเซกเมนต์ทรีแบบวนซ้ำ: กวาดหาค่าน้อยสุดทีละช่อง
// ไม่มีต้นไม้ ไม่มีการไต่บิต จึงไม่ได้ทดสอบแค่การพิมพ์
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, q;
    if (scanf("%d %d", &n, &q) != 2) return 0;
    vector<long long> a(n);
    for (int i = 0; i < n; i++) scanf("%lld", &a[i]);
    for (int k = 0; k < q; k++) {
        int op; scanf("%d", &op);
        if (op == 1) {
            int i; long long v; scanf("%d %lld", &i, &v);
            a[i] = v;
        } else {
            int l, r; scanf("%d %d", &l, &r);
            long long res = a[l];
            for (int i = l; i <= r; i++) res = min(res, a[i]);
            printf("%lld\\n", res);
        }
    }
    return 0;
}`;

---
<CpProblemLayout href={href}>
  <h2>ปัญหาที่บทนี้แก้</h2>
  <p>
    บทนี้รวมเครื่องมือสองชิ้นที่มักถูกใช้ด้วยกัน และเป็นคู่ที่ปลดล็อกโจทย์ระดับยากได้หลายข้อ
  </p>
  <ul>
    <li>
      <strong>เซกเมนต์ทรี</strong> ตอบคำถามเกี่ยวกับ<strong>ช่วง</strong> ในขณะที่ข้อมูลยังถูกแก้ไปเรื่อย ๆ
      โดยแก้ได้ทั้งช่วง ไม่ใช่ทีละช่อง
