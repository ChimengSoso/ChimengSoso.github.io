const ASN_NODES: AsnNode[] = (() => {
  const out: AsnNode[] = [];
  const go = (id: number, lo: number, hi: number, depth: number): void => {
    out.push({ id, lo, hi, depth });
    if (lo === hi) return;
    const mid = Math.floor((lo + hi) / 2);
    go(id * 2, lo, mid, depth + 1);
    go(id * 2 + 1, mid + 1, hi, depth + 1);
  };
