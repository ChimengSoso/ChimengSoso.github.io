/* ---------- ง. เครื่องเดินทีละขั้น ต้นไม้ที่จำอดีตได้ ----------
   สร้างเวอร์ชันใหม่จากการแก้หนึ่งช่อง แล้วนับว่าปมใหม่เกิดกี่ปม ปมเก่าถูกใช้ร่วมกี่ปม
   ตัวเลขทั้งสองมาจากการนับของจริงในการสร้าง ไม่ได้เขียนไว้ล่วงหน้า */
const PER_A = [2, 7, 1, 5];
const PER_SET_AT = 2;
const PER_SET_TO = 9;
interface PerNode {
  key: string;
  ver: 0 | 1;
  lo: number;
  hi: number;
  depth: number;
  sum: number;
  leftKey: string | null;
  rightKey: string | null;
}
function buildPersistent(): { nodes: PerNode[]; order: string[]; fresh: number; shared: number; v1Arr: number[] } {
  const nodes = new Map<string, PerNode>();
  const key = (ver: number, lo: number, hi: number): string => `v${ver}:${lo}-${hi}`;
  const build = (lo: number, hi: number, depth: number): string => {
    const k = key(0, lo, hi);
    if (lo === hi) {
      nodes.set(k, { key: k, ver: 0, lo, hi, depth, sum: PER_A[lo], leftKey: null, rightKey: null });
      return k;
    }
    const mid = Math.floor((lo + hi) / 2);
    const lk = build(lo, mid, depth + 1);
    const rk = build(mid + 1, hi, depth + 1);
    const s = (nodes.get(lk)?.sum ?? 0) + (nodes.get(rk)?.sum ?? 0);
    nodes.set(k, { key: k, ver: 0, lo, hi, depth, sum: s, leftKey: lk, rightKey: rk });
    return k;
  };
  build(0, PER_A.length - 1, 0);

  const order: string[] = [];
  let fresh = 0;
  let shared = 0;
  const clone = (oldKey: string, lo: number, hi: number, depth: number, pos: number, val: number): string => {
    const k = key(1, lo, hi);
    fresh++;
    if (lo === hi) {
      nodes.set(k, { key: k, ver: 1, lo, hi, depth, sum: val, leftKey: null, rightKey: null });
      order.push(k);
      return k;
    }
    const old = nodes.get(oldKey);
    if (old === undefined || old.leftKey === null || old.rightKey === null) throw new Error('ต้นไม้เวอร์ชันศูนย์ไม่ครบ');
    const mid = Math.floor((lo + hi) / 2);
    let lk = old.leftKey;
    let rk = old.rightKey;
    if (pos <= mid) {
      lk = clone(old.leftKey, lo, mid, depth + 1, pos, val);
      shared++;
    } else {
      rk = clone(old.rightKey, mid + 1, hi, depth + 1, pos, val);
      shared++;
    }
    const s = (nodes.get(lk)?.sum ?? 0) + (nodes.get(rk)?.sum ?? 0);
    nodes.set(k, { key: k, ver: 1, lo, hi, depth, sum: s, leftKey: lk, rightKey: rk });
    order.push(k);
    return k;
  };
  clone(key(0, 0, PER_A.length - 1), 0, PER_A.length - 1, 0, PER_SET_AT, PER_SET_TO);

  const v1Arr = [...PER_A];
  v1Arr[PER_SET_AT] = PER_SET_TO;
  const rootV1 = nodes.get(key(1, 0, PER_A.length - 1));
  const want = v1Arr.reduce((a, b) => a + b, 0);
  if ((rootV1?.sum ?? -1) !== want) throw new Error(`ผลรวมของเวอร์ชันใหม่เป็น ${rootV1?.sum} แต่ควรเป็น ${want}`);
  const rootV0 = nodes.get(key(0, 0, PER_A.length - 1));
  const want0 = PER_A.reduce((a, b) => a + b, 0);
  if ((rootV0?.sum ?? -1) !== want0) throw new Error('เวอร์ชันเก่าถูกแก้ไปด้วย ซึ่งผิดความหมายของคำว่าจำอดีตได้');
  return { nodes: Array.from(nodes.values()), order, fresh, shared, v1Arr };
}
