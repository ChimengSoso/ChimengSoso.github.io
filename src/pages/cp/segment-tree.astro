}`;


/* =======================================================================
   โมเดลของส่วนที่เพิ่มเข้ามาจาก cp-algorithms
   ทุกตัวเลข ทุกภาพ และทุกคำอธิบายข้างล่างนี้งอกจากการเดินอัลกอริทึมจริง
   ไม่มีตัวเลขไหนถูกพิมพ์ด้วยมือ
   ======================================================================= */

const byId = new Map<number, SgNode>(TREE.map((n) => [n.id, n]));
function nodeById(id: number): SgNode {
  const n = byId.get(id);
  if (n === undefined) throw new Error(`ไม่มีปมหมายเลข ${id} ในต้นไม้`);
  return n;
}

/* ---------- ก. คำถามหนึ่งครั้งเดินแตะปมไหนบ้าง ----------
   เดินต้นไม้ตามอัลกอริทึมจริง แล้วบันทึกทุกครั้งที่เข้าปมหนึ่งปม
   ค่าที่สะสมได้ระหว่างทางจึงเป็นค่าที่โปรแกรมเห็นจริง */
type QVisit = { id: number; kind: 'full' | 'pass' | 'cut'; acc: string; depth: number; note: string };
function traceQuery(ql: number, qr: number): QVisit[] {
  const out: QVisit[] = [];
  let acc = Number.POSITIVE_INFINITY;
  const show = (): string => (acc === Number.POSITIVE_INFINITY ? 'ยังไม่มี' : String(acc));
  const go = (id: number): void => {
    const n = nodeById(id);
    const range = n.lo === n.hi ? `ช่อง ${n.lo}` : `ช่อง ${n.lo} ถึง ${n.hi}`;
    if (qr < n.lo || n.hi < ql) {
      out.push({
        id,
        kind: 'cut',
        acc: show(),
        depth: n.depth,
        note: `ปม ${range} <b>ไม่ทับคำถามเลย</b> ตัดทิ้งทันที ไม่ต้องลงไปดูลูกของมันสักตัว ค่าที่สะสมไว้ยังเป็น ${show()}`,
      });
      return;
    }
    if (ql <= n.lo && n.hi <= qr) {
      acc = Math.min(acc, n.val);
      out.push({
        id,
        kind: 'full',
        acc: show(),
        depth: n.depth,
        note: `ปม ${range} <b>อยู่ในคำถามพอดีทั้งก้อน</b> จึงหยิบค่าที่ปมนี้เก็บไว้แล้ว คือ ${n.val} มาใช้ได้เลย ไม่ต้องลงไปหาลูก ค่าที่สะสมได้ตอนนี้คือ ${show()}`,
      });
      return;
    }
    out.push({
      id,
      kind: 'pass',
      acc: show(),
      depth: n.depth,
      note: `ปม ${range} <b>ล้นออกนอกคำถาม</b> คำตอบของมันใช้ไม่ได้ทั้งก้อน ต้องแยกไปถามลูกซ้ายกับลูกขวาต่อ ค่าที่สะสมไว้ยังเป็น ${show()}`,
    });
    go(id * 2);
    go(id * 2 + 1);
  };
  go(1);
  const visited = out.length;
  out.push({
    id: 0,
    kind: 'full',
    acc: show(),
    depth: 0,
    note: `เดินจบแล้ว คำตอบของช่วง ${ql} ถึง ${qr} คือ <b>${show()}</b> โดยแตะปมไปทั้งหมด ${visited} ปม จากต้นไม้ที่มี ${TREE.length} ปม`,
  });
  return out;
}
const qTrace = traceQuery(QL, QR);
/* ปมที่ตอบได้ทั้งก้อนต้องไม่เกินสองปมต่อหนึ่งชั้น ซึ่งเป็นเหตุผลที่คำถามใช้เวลา log n
   ตรวจข้ออ้างนี้ตอนบิลด์ ถ้าผิดหน้าจะไม่ยอมถูกสร้าง */
const fullPerDepth = new Map<number, number>();
for (const v of qTrace) {
  if (v.kind === 'full' && v.id !== 0) fullPerDepth.set(v.depth, (fullPerDepth.get(v.depth) ?? 0) + 1);
}
const maxFullPerDepth = Math.max(...Array.from(fullPerDepth.values()));
if (maxFullPerDepth > 2) {
  throw new Error(`ข้ออ้างในบทนี้ผิด มีปมที่ตอบได้ทั้งก้อนถึง ${maxFullPerDepth} ปมในชั้นเดียว`);
}

/* ผังของต้นไม้ในเครื่องเดินทีละขั้น ใช้ผังเดียวกับภาพข้างบนแต่ย่อลง */
const PW = 52;
const PH = 40;
const PGAP = 6;
const pX = (n: SgNode): number => 12 + ((n.lo + n.hi) / 2) * (PW + PGAP);
