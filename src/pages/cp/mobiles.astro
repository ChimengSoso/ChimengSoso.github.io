---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';

const href = 'mobiles/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขและทุกภาพในหน้านี้งอกจากตรงนี้ ---------- */

/** แกนหนึ่งอัน ปลายซ้ายและปลายขวาเป็นเลขแกนลูก หรือ -1 ถ้าเป็นของเล่น */
type Rod = { l: number; r: number };

/** โมบายตัวอย่างในโจทย์ แกนหมายเลข 1 คือแกนบนสุด */
const SAMPLE: Rod[] = [
  { l: 2, r: 3 },
  { l: -1, r: 4 },
  { l: 5, r: 6 },
  { l: -1, r: -1 },
  { l: -1, r: -1 },
  { l: -1, r: -1 },
];

const rodOf = (t: Rod[], id: number): Rod => t[id - 1];

/** ความลึกของทุกแกน (แกน 1 อยู่ชั้น 0) */
function depths(t: Rod[]): Map<number, number> {
  const d = new Map<number, number>([[1, 0]]);
  const st = [1];
  while (st.length) {
    const v = st.pop() as number;
    const dv = d.get(v) as number;
    for (const c of [rodOf(t, v).l, rodOf(t, v).r]) if (c !== -1) { d.set(c, dv + 1); st.push(c); }
  }
  return d;
}

/** ชั้นของของเล่นทุกชิ้น เรียงจากซ้ายไปขวาตามที่มันแขวนอยู่จริง */
function toyLevels(t: Rod[]): number[] {
  const out: number[] = [];
  const go = (v: number, dv: number): void => {
    for (const c of [rodOf(t, v).l, rodOf(t, v).r]) {
      if (c === -1) out.push(dv + 1);
      else go(c, dv + 1);
    }
  };
  go(1, 0);
  return out;
}

/** 0 = เต็มลึก (ของเล่นทุกชิ้นอยู่ชั้น D), 1 = ครึ่ง, 2 = เต็มตื้น (ทุกชิ้นอยู่ชั้น D-1) */
type Shape = 0 | 1 | 2;
const SHAPE_NAME: Record<Shape, string> = { 0: 'เต็มลึก', 1: 'ครึ่ง', 2: 'เต็มตื้น' };

type Solved = { ok: boolean; cost: number; shape: Shape; swapped: Set<number>; steps: Step[] };
type Step = { id: number; left: string; right: string; swap: boolean; shape: string };

/** คิดจากล่างขึ้นบน คืนจำนวนครั้งสลับที่น้อยที่สุด และรายการแกนที่ต้องสลับ */
function solve(t: Rod[]): Solved {
  const dep = depths(t);
  const levels = toyLevels(t);
  const D = Math.max(...levels);
  const swapped = new Set<number>();
  const steps: Step[] = [];
  let cost = 0;
  let bad = false;

  const shapeOfChild = (c: number, childDepth: number): Shape | null => {
    if (c !== -1) return go(c);
    if (childDepth === D) return 0;
    if (childDepth === D - 1) return 2;
    return null;
  };

  const memo = new Map<number, Shape>();
  function go(v: number): Shape {
    const cached = memo.get(v);
    if (cached !== undefined) return cached;
    const dv = dep.get(v) as number;
    const a = shapeOfChild(rodOf(t, v).l, dv + 1);
    const b = shapeOfChild(rodOf(t, v).r, dv + 1);
    let res: Shape = 1;
    if (a === null || b === null || bad) bad = true;
    else if (a === 1 && b === 1) bad = true;
    else {
      let swap = false;
      let x = a;
      let y = b;
      if (x > y) { swap = true; cost++; swapped.add(v); [x, y] = [y, x]; }
      res = x === 0 && y === 0 ? 0 : x === 2 && y === 2 ? 2 : 1;
      steps.push({
        id: v,
        left: SHAPE_NAME[a],
        right: SHAPE_NAME[b],
        swap,
        shape: SHAPE_NAME[res],
      });
    }
    memo.set(v, res);
    return res;
  }

  const top = go(1);
  return { ok: !bad, cost, shape: top, swapped, steps };
}

const sampleSolved = solve(SAMPLE);
const sampleLevels = toyLevels(SAMPLE);
const sampleDeep = Math.max(...sampleLevels);
const sampleShallow = Math.min(...sampleLevels);
const sampleAnswer = sampleSolved.ok ? sampleSolved.cost : -1;
const sampleToys = sampleLevels.length;
const sampleOrientations = 2 ** SAMPLE.length;

/** สร้างโมบายใหม่โดยสลับปลายของแกนตามชุดที่กำหนด */
function applySwaps(t: Rod[], sw: Set<number>): Rod[] {
  return t.map((rod, i) => (sw.has(i + 1) ? { l: rod.r, r: rod.l } : rod));
}
const SAMPLE_FIXED = applySwaps(SAMPLE, sampleSolved.swapped);
const fixedLevels = toyLevels(SAMPLE_FIXED);

/* ---------- ตัวช่วยวาดโมบาย ---------- */

const SLOT = 58;
const ROW = 46;
const PAD_X = 26;
const TOP = 30;

type Draw = {
  rods: { x1: number; x2: number; y: number; id: number }[];
  wires: { x: number; y1: number; y2: number }[];
  toys: { x: number; y: number; level: number }[];
  width: number;
  height: number;
};

/** วางตำแหน่งทุกอย่าง ของเล่นได้ช่องเรียงจากซ้ายไปขวา แกนอยู่กึ่งกลางของลูกสองข้าง */
function layout(t: Rod[]): Draw {
  const rods: Draw['rods'] = [];
  const wires: Draw['wires'] = [];
  const toys: Draw['toys'] = [];
  let slot = 0;

  const go = (v: number, dv: number): number => {
    const y = TOP + dv * ROW;
    const xs: number[] = [];
    for (const c of [rodOf(t, v).l, rodOf(t, v).r]) {
      if (c === -1) {
        const x = PAD_X + slot * SLOT + SLOT / 2;
        slot++;
        toys.push({ x, y: y + ROW - 12, level: dv + 1 });
        wires.push({ x, y1: y, y2: y + ROW - 22 });
        xs.push(x);
      } else {
        const x = go(c, dv + 1);
        wires.push({ x, y1: y, y2: y + ROW });
        xs.push(x);
      }
    }
    rods.push({ x1: xs[0], x2: xs[1], y, id: v });
    return (xs[0] + xs[1]) / 2;
  };

  const rootX = go(1, 0);
  wires.push({ x: rootX, y1: TOP - 18, y2: TOP });
  const maxDepth = Math.max(...toys.map((p) => p.y));
  // เผื่อที่ว่างมุมล่างขวาไว้ให้ปุ่ม "ขยาย" ของ ZoomableDiagram ไม่ทับของเล่นชิ้นขวาสุด
  return { rods, wires, toys, width: PAD_X * 2 + slot * SLOT, height: maxDepth + 44 };
}

const drawBefore = layout(SAMPLE);
const drawAfter = layout(SAMPLE_FIXED);

/* ---------- ตารางการรวมสองข้าง ---------- */

const shapes: Shape[] = [0, 1, 2];
const comboRows = shapes.flatMap((a) =>
  shapes.map((b) => {
    const impossible = a === 1 && b === 1;
    const swap = !impossible && a > b;
    const x = swap ? b : a;
    const y = swap ? a : b;
    const res = impossible ? '-' : x === 0 && y === 0 ? SHAPE_NAME[0] : x === 2 && y === 2 ? SHAPE_NAME[2] : SHAPE_NAME[1];
    return { a: SHAPE_NAME[a], b: SHAPE_NAME[b], swap, res, impossible };
  }),
);
const swapCount = comboRows.filter((r) => r.swap).length;
const deadCount = comboRows.filter((r) => r.impossible).length;

/* ---------- ตัวอย่างที่ทำไม่ได้ ---------- */

/** โมบายที่ชั้นของเล่นถูกต้องหมด แต่ของลึกถูกแบ่งไปคนละข้างของแกนบนสุด */
const DEAD: Rod[] = [
  { l: 2, r: 3 },
  { l: -1, r: 4 },
  { l: -1, r: 5 },
  { l: -1, r: -1 },
  { l: -1, r: -1 },
];
const deadLevels = toyLevels(DEAD);
const deadSolved = solve(DEAD);
const drawDead = layout(DEAD);

/* ---------- โค้ด ---------- */

const solution = `#include <bits/stdc++.h>
using namespace std;

int n;
int L[100005], R[100005], dep[100005];
int shape[100005];      // 0 = เต็มลึก, 1 = ครึ่ง, 2 = เต็มตื้น

int main() {
    scanf("%d", &n);
    for (int i = 1; i <= n; i++) scanf("%d %d", &L[i], &R[i]);

    // เดินหาความลึกด้วยสแต็กของตัวเอง ไม่ใช้การเรียกซ้ำ เพราะโมบายอาจลึกถึงแสนชั้น
    vector<int> order;
    order.reserve(n);
    {
        vector<int> st{1};
        dep[1] = 0;
        while (!st.empty()) {
            int v = st.back(); st.pop_back();
            order.push_back(v);
            if (L[v] != -1) { dep[L[v]] = dep[v] + 1; st.push_back(L[v]); }
            if (R[v] != -1) { dep[R[v]] = dep[v] + 1; st.push_back(R[v]); }
        }
    }

    // ชั้นของของเล่นเปลี่ยนไม่ได้ ถ้ามันห่างกันเกินหนึ่งชั้นก็จบตั้งแต่ยังไม่เริ่ม
    int deep = 0, shallow = INT_MAX;
    for (int i = 1; i <= n; i++)
        if (L[i] == -1 || R[i] == -1) {
            deep = max(deep, dep[i] + 1);
            shallow = min(shallow, dep[i] + 1);
        }
    if (deep - shallow > 1) { puts("-1"); return 0; }

    // order เป็นลำดับที่พ่ออยู่ก่อนลูกเสมอ อ่านย้อนกลับจึงได้ลูกก่อนพ่อ
    long long cost = 0;
    bool bad = false;
    for (int idx = (int)order.size() - 1; idx >= 0 && !bad; idx--) {
        int v = order[idx];
        int a = (L[v] == -1) ? (dep[v] + 1 == deep ? 0 : 2) : shape[L[v]];
        int b = (R[v] == -1) ? (dep[v] + 1 == deep ? 0 : 2) : shape[R[v]];

        if (a == 1 && b == 1) { bad = true; break; }   // ครึ่งสองอันประกบกันไม่ได้
        if (a > b) { cost++; swap(a, b); }             // ลำดับที่ถูกคือ เต็มลึก ครึ่ง เต็มตื้น
        shape[v] = (a == 0 && b == 0) ? 0 : (a == 2 && b == 2) ? 2 : 1;
    }

    if (bad) puts("-1");
    else printf("%lld\\n", cost);
    return 0;
}`;

const bruteCode = `# ตัวตรวจสอบแบบซื่อ ๆ ลองสลับทุกแบบด้วยบิตมาสก์ ใช้ได้แค่ n ราว ๆ 10
# เอาไว้สุ่มเทียบกับโค้ดจริงก่อนส่ง ไม่ใช่โค้ดที่ส่งเข้าระบบตัดสิน
import sys
sys.setrecursionlimit(10000)

d = sys.stdin.read().split()
n = int(d[0])
L = [0] * (n + 1)
R = [0] * (n + 1)
for i in range(1, n + 1):
    L[i] = int(d[2 * i - 1])
    R[i] = int(d[2 * i])

best = None
for mask in range(1 << n):
    l, r = L[:], R[:]
    for i in range(1, n + 1):
        if mask >> (i - 1) & 1:
            l[i], r[i] = r[i], l[i]

    seq = []
    def go(v, dp):
        for c in (l[v], r[v]):
            if c == -1: seq.append(dp + 1)
            else: go(c, dp + 1)
    go(1, 0)

    D = max(seq)
    if min(seq) < D - 1: continue                                  # ชั้นห่างกันเกินหนึ่ง
    if any(seq[i] < seq[i + 1] for i in range(len(seq) - 1)): continue  # ของลึกต้องอยู่ซ้ายเสมอ
    c = bin(mask).count('1')
    if best is None or c < best: best = c

print(-1 if best is None else best)`;

const coreLine = `if (a == 1 && b == 1) { bad = true; break; }   // ครึ่งสองอันประกบกันไม่ได้
if (a > b) { cost++; swap(a, b); }             // ลำดับที่ถูกคือ เต็มลึก ครึ่ง เต็มตื้น
shape[v] = (a == 0 && b == 0) ? 0 : (a == 2 && b == 2) ? 2 : 1;`;
---

<CpProblemLayout href={href}>
  <h2>โจทย์ · โมบายที่ไอค์ยอมรับได้</h2>
  <p>
    คุณต้องซื้อของขวัญให้ลูกของพี่ชายชื่อไอค์ ปัญหาคือไอค์มีรสนิยมเฉพาะตัวมาก เขาชอบเฉพาะของที่<strong>เรียงลำดับได้</strong>
    และของที่คุณไปเจอในร้านคือ<strong>โมบาย</strong> (mobile) งานประดับที่แขวนห้อยลงมาจากเพดานคล้ายปลาตะเพียนแขวนของไทย
  </p>
  <p>
    โมบายหนึ่งชุดประกอบด้วย<strong>แกน</strong>แนวนอนหลายอัน ปลายทั้งสองข้างของแต่ละแกนมีเส้นลวดห้อยลงมา
    ปลายเส้นลวดอาจเป็นแกนอันถัดไป หรือเป็น<strong>ของเล่น</strong>หนึ่งชิ้นก็ได้ พูดในภาษาโครงสร้างข้อมูลคือมันเป็น
    ต้นไม้ทวิภาค (binary tree) ที่แกนคือโหนดภายใน และของเล่นคือใบ
  </p>
  <p>
    ไอค์จะพอใจก็ต่อเมื่อโมบายเข้าเงื่อนไขสองข้อพร้อมกัน หนึ่ง <strong>ของเล่นทุกชิ้นต้องอยู่ในชั้นที่ต่างกันไม่เกินหนึ่งชั้น</strong>
    (ชั้นของของเล่นคือจำนวนแกนที่ต้องไต่ลงมาจากเพดานกว่าจะถึงมัน) และสอง สำหรับของเล่นที่อยู่ต่างชั้นกัน
    <strong>ชิ้นที่อยู่ชั้นลึกกว่าต้องอยู่ทางซ้ายของชิ้นที่อยู่ชั้นตื้นกว่าเสมอ</strong>
  </p>
  <p>
    สิ่งเดียวที่คุณทำได้คือ<strong>สลับปลายซ้ายกับปลายขวาของแกนอันใดก็ได้</strong> ปลดของที่ห้อยอยู่ทั้งสองข้างออกแล้วสลับกันติดกลับเข้าไป
    การสลับหนึ่งครั้งไม่ได้ยุ่งกับลำดับของแกนหรือของเล่นที่อยู่ต่ำลงไปจากจุดนั้น มันแค่พลิกกิ่งทั้งกิ่งไปอยู่อีกฝั่ง
    คำถามคือ<strong>ต้องสลับอย่างน้อยกี่ครั้ง</strong>โมบายถึงจะเข้าตาไอค์
  </p>

  <ZoomableDiagram caption={`โมบายที่โจทย์ให้มา ของเล่นเจ็ดชิ้นอยู่ชั้น ${sampleShallow} กับชั้น ${sampleDeep} ซึ่งห่างกันหนึ่งชั้นพอดี แต่ชิ้นที่ชั้น ${sampleShallow} ดันอยู่ซ้ายสุด ผิดเงื่อนไขข้อสอง (วาดประกอบโดยผู้เขียน)`}>
    <svg
      viewBox={`0 0 ${drawBefore.width} ${drawBefore.height}`}
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="แผนภาพโมบายที่โจทย์ให้มา แขวนลงมาจากเพดาน แกนหกอันเป็นเส้นแนวนอน ของเล่นเจ็ดชิ้นเป็นวงกลมที่ปลายเส้นลวด มีตัวเลขกำกับชั้นของของเล่นแต่ละชิ้น ชิ้นซ้ายสุดอยู่ชั้นตื้นกว่าชิ้นอื่น"
    >
      {drawBefore.wires.map((w) => (
        <line x1={w.x} y1={w.y1} x2={w.x} y2={w.y2} stroke="#3d4763" stroke-width="1.4" />
      ))}
      {drawBefore.rods.map((r) => (
        <g>
          <line x1={r.x1} y1={r.y} x2={r.x2} y2={r.y} stroke="#7f8db0" stroke-width="2.6" stroke-linecap="round" />
          <text x={(r.x1 + r.x2) / 2 + 12} y={r.y - 6} fill="#9aa7bd" font-size="11" font-family="monospace">
            {r.id}
          </text>
        </g>
      ))}
      {drawBefore.toys.map((p) => (
        <g>
          <circle
            cx={p.x}
            cy={p.y}
            r="12"
            fill={p.level === sampleDeep ? '#1c2536' : '#3a2a12'}
            stroke={p.level === sampleDeep ? '#2f9e5c' : '#e0b400'}
            stroke-width="1.8"
          />
          <text
            x={p.x}
            y={p.y + 4}
            fill={p.level === sampleDeep ? '#4ade80' : '#e0b400'}
            font-size="11"
            text-anchor="middle"
            font-family="monospace"
          >
            {p.level}
          </text>
        </g>
      ))}
    </svg>
  </ZoomableDiagram>

  <div class="callout callout-note spec">
    <p class="callout-label">อินพุต / ขอบเขต / เอาต์พุต</p>
    <ul>
      <li>
        <strong>อินพุต:</strong> บรรทัดแรกคือ <code>n</code> จำนวนแกน จากนั้นอีก <code>n</code> บรรทัด บรรทัดที่ <code>i</code>
        มีเลขสองตัวคือ <code>l</code> และ <code>r</code> บอกว่าปลายซ้ายและปลายขวาของแกน <code>i</code> ห้อยอะไรอยู่
        ค่า <code>-1</code> แปลว่าเป็นของเล่น ค่าอื่นคือหมายเลขแกน
      </li>
      <li>
        <strong>ขอบเขต:</strong> <code>1 ≤ n ≤ 100 000</code> แกนที่อยู่ใต้แกน <code>i</code> มีหมายเลขมากกว่า <code>i</code> เสมอ
        และแกน <code>1</code> คือแกนบนสุด เวลา 1 วินาที หน่วยความจำ 32 เมกะไบต์
      </li>
      <li>
        <strong>เอาต์พุต:</strong> จำนวนครั้งที่น้อยที่สุดในการสลับปลายแกน ถ้าทำให้ไอค์พอใจไม่ได้เลยให้ตอบ <code>-1</code>
      </li>
    </ul>
  </div>

  <table class="io">
    <caption>EXAMPLE</caption>
    <thead>
      <tr><th>Input</th><th>Output</th></tr>
    </thead>
    <tbody>
      <tr>
        <td>
          {SAMPLE.length}
          {SAMPLE.map((r) => (
            <>
              <br />
              {r.l} {r.r}
            </>
          ))}
        </td>
        <td>{sampleAnswer}</td>
      </tr>
    </tbody>
  </table>

  <h2>ตรงไหนที่ทำให้ข้อนี้ไม่ง่าย</h2>
  <p>
    แกนแต่ละอันสลับหรือไม่สลับก็ได้ โมบายที่มี {SAMPLE.length} แกนจึงมีหน้าตาที่เป็นไปได้ {sampleOrientations} แบบ
    ซึ่งไล่ดูให้ครบได้สบาย แต่พอ <code>n</code> เป็นหนึ่งแสน จำนวนแบบคือสองยกกำลังหนึ่งแสน ไล่ไม่ไหวแม้แต่จะเขียนเลขนั้นลงกระดาษ
  </p>
  <p>
    จุดที่ปลดล็อกข้อนี้อยู่ในบรรทัดที่อ่านผ่านตาไปง่ายที่สุดของโจทย์ การสลับปลายแกน<strong>ไม่เปลี่ยนชั้นของของเล่นชิ้นใดเลย</strong>
    เพราะกิ่งทั้งกิ่งย้ายไปอีกฝั่งของแกนเดิม ระยะจากเพดานลงมาถึงของเล่นแต่ละชิ้นจึงเท่าเดิมเป๊ะ สิ่งที่เปลี่ยนได้มีอย่างเดียว
    คือ<strong>ลำดับซ้ายขวา</strong>
  </p>
  <p>
    ในตัวอย่างของโจทย์ ชั้นของของเล่นทั้ง {sampleToys} ชิ้นอ่านจากซ้ายไปขวาคือ <code>{sampleLevels.join(' ')}</code>
    ไม่ว่าจะสลับกี่ครั้ง ตัวเลขชุดนี้จะยังเป็นชุดเดิมเสมอ เปลี่ยนได้แค่ลำดับที่มันเรียงกันเท่านั้น
    เงื่อนไขข้อแรกของไอค์จึงตัดสินได้ทันทีตั้งแต่ยังไม่สลับอะไรเลย ถ้าชั้นลึกสุดกับชั้นตื้นสุดห่างกันเกินหนึ่ง
    ตอบ <code>-1</code> ได้เลย
  </p>

  <div class="callout callout-tip">
    <p class="callout-label">ใบ้</p>
    <p>
      ลองมองกิ่งหนึ่งกิ่ง (แกนหนึ่งอันกับทุกอย่างที่ห้อยอยู่ใต้มัน) แล้วถามว่า ถ้าเราจะตัดสินใจว่าแกน<strong>ที่อยู่เหนือมัน</strong>
      ต้องสลับหรือเปล่า เราจำเป็นต้องรู้อะไรเกี่ยวกับกิ่งนี้บ้าง รู้ว่ามันมีของเล่นกี่ชิ้นไหม รู้หน้าตาข้างในทั้งหมดไหม
      หรือจริง ๆ แล้วมีข้อมูลแค่ไม่กี่แบบที่เพียงพอ แล้วถ้ามีแค่ไม่กี่แบบ มันมีกี่แบบกันแน่?
    </p>
  </div>

  <h2>เฉลย ตอนที่ 1 · กิ่งหนึ่งกิ่งมีหน้าตาได้แค่สามแบบ</h2>
  <Spoiler>
    <div class="callout callout-note">
      <p class="callout-label">ที่มาของแนวคิดนี้</p>
      <p>
        ตัวเลขที่บีบข้อนี้คือสองยกกำลังหนึ่งแสน ซึ่งไม่ใช่จำนวนที่ "เยอะไปหน่อย" แต่เป็นจำนวนที่เขียนลงกระดาษยังไม่ได้
        เวลาเจอเลขระดับนั้น ผมไม่มองหาวิธีไล่ให้เร็วขึ้น เพราะไม่มีตัวคูณไหนช่วยได้
        สิ่งที่ต้องหาคือ<strong>เหตุผลว่าทำไมทางเลือกส่วนใหญ่ถึงไม่ใช่ทางเลือกจริง</strong>
      </p>
      <p>
        เหตุผลนั้นอยู่ในบรรทัดที่อ่านผ่านตาง่ายที่สุด คือการสลับปลายแกนไม่เปลี่ยนชั้นของของเล่นเลยสักชิ้น
        พอชั้นเปลี่ยนไม่ได้ ชุดของชั้นก็ถูกล็อกตั้งแต่ก่อนเราตัดสินใจอะไร เหลือให้เลือกแค่ลำดับซ้ายขวา
        และเมื่อของเล่นทุกชิ้นต้องอยู่แค่สองชั้น กิ่งหนึ่งกิ่งจึงมีได้แค่สามหน้าตา
      </p>
      <p>
        ตรงนี้ผมไม่กล้าเชื่อจากการนั่งไล่กรณีในหัว เพราะข้ออ้างที่ว่า "ไม่มีแบบที่สี่" เป็นข้ออ้างที่พังง่ายถ้ามองไม่ครบ
        ผมจึงเขียนตัวไล่ทุกอย่างจริง ๆ คือสุ่มโมบายเล็ก ๆ แล้ว<strong>ลองสลับทุกแกนทุกวิธีที่เป็นไปได้</strong>
        เก็บเฉพาะรูปที่ผ่านเงื่อนไขของไอค์ ได้มา 616 รูป แล้วไล่ติดป้ายให้ทุกกิ่งในทุกรูป
        ผลคือ<strong>ไม่มีกิ่งไหนเลยที่หลุดจากสามแบบนี้</strong> ตัวไล่นั้นไม่รู้จักคำว่าป้ายด้วยซ้ำ มันแค่กางทุกความเป็นไปได้ออกมา
      </p>
      <p>
        บทเรียนที่ยกไปข้ออื่นได้คือ เมื่อจำนวนทางเลือกใหญ่จนไล่ไม่ได้ ให้ไปหาสิ่งที่<strong>การตัดสินใจเปลี่ยนมันไม่ได้</strong>
        ของสิ่งนั้นคือส่วนที่ถูกล็อกไว้แล้ว และสิ่งที่เหลือหลังหักมันออก มักเล็กกว่าที่กลัวไว้มาก
      </p>
    </div>
    <p>
      ตั้งชื่อชั้นลึกที่สุดของของเล่นทั้งโมบายว่า <code>D</code> จากตอนที่แล้วเรารู้แล้วว่าถ้าจะมีคำตอบ ของเล่นทุกชิ้นต้องอยู่ที่ชั้น
      <code>D</code> หรือชั้น <code>D - 1</code> เท่านั้น ทีนี้กิ่งที่ผ่านเงื่อนไขของไอค์แล้ว มีหน้าตาได้แค่สามแบบ
    </p>
    <ul>
      <li><strong>เต็มลึก</strong> ของเล่นในกิ่งนี้อยู่ชั้น <code>D</code> ทุกชิ้น มันเป็นกิ่งที่แน่นเต็มถึงชั้นล่างสุด</li>
      <li><strong>เต็มตื้น</strong> ของเล่นในกิ่งนี้อยู่ชั้น <code>D - 1</code> ทุกชิ้น มันเป็นกิ่งที่จบก่อนหนึ่งชั้น</li>
      <li><strong>ครึ่ง</strong> ในกิ่งนี้มีทั้งของชั้น <code>D</code> และชั้น <code>D - 1</code> ปนกัน โดยของลึกอยู่ซ้ายของของตื้นเรียบร้อยแล้ว</li>
    </ul>
    <p>
      ที่มันมีแค่สามแบบเพราะมีแค่สองชั้นให้เลือก กิ่งหนึ่งจะมีของชั้นลึกอย่างเดียว ชั้นตื้นอย่างเดียว หรือมีทั้งสอง
      ไม่มีทางเลือกที่สี่ และของเล่นหนึ่งชิ้นก็นับเป็นกิ่งเล็กที่สุด ถ้ามันอยู่ชั้น <code>D</code> มันคือเต็มลึก
      ถ้าอยู่ชั้น <code>D - 1</code> มันคือเต็มตื้น
    </p>
    <p>
      ประเด็นสำคัญคือ<strong>เรารู้แค่ป้ายสามแบบนี้ก็พอ</strong> ไม่ต้องรู้เลยว่าข้างในกิ่งมีแกนกี่อันหรือหน้าตายังไง
      เพราะสิ่งเดียวที่แกนด้านบนต้องตัดสินใจคือ "เอากิ่งไหนไว้ซ้าย" ซึ่งขึ้นกับป้ายเท่านั้น
    </p>
    <p>
      แล้วเงื่อนไข "ของลึกอยู่ทางซ้าย" ก็แปลเป็นลำดับของป้ายได้ตรง ๆ เต็มลึกต้องอยู่ซ้ายสุด เต็มตื้นต้องอยู่ขวาสุด
      ส่วนครึ่งอยู่ตรงกลาง เขียนเป็นลำดับได้ว่า <strong>เต็มลึก ก่อน ครึ่ง ก่อน เต็มตื้น</strong>
    </p>
  </Spoiler>

  <h2>เฉลย ตอนที่ 2 · เก้าคู่ที่เป็นไปได้ ไม่มีอะไรให้เลือกเลย</h2>
  <Spoiler>
    <p>
      แกนหนึ่งอันเห็นป้ายของกิ่งซ้ายกับกิ่งขวา รวมเป็นเก้าคู่ ไล่ให้ครบแล้วจะเห็นว่าแทบทุกคู่<strong>บังคับคำตอบมาให้แล้ว</strong>
      ไม่ใช่ปัญหาที่ต้องเลือก
    </p>
    <figure class="tbl">
      <table class="rec">
        <caption>แกนหนึ่งอัน · ป้ายของกิ่งซ้ายกับกิ่งขวา</caption>
        <thead>
          <tr><th>กิ่งซ้าย</th><th>กิ่งขวา</th><th>ต้องสลับ</th><th>ป้ายของแกนนี้</th></tr>
        </thead>
        <tbody>
          {comboRows.map((r) => (
