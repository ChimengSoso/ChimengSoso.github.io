/* ด่านตรวจตอนบิลด์ หกทรงต้องตอบเท่ากับการลองทุกสามบล็อก ไม่งั้นหน้านี้ไม่ขึ้น */
const SWEEP_CASES = 220;
{
  let seed = 27092026;
  const rnd = (m: number): number => {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed % m;
  };
  let done = 0;
  while (done < SWEEP_CASES) {
    const K = 1 + rnd(3);
    const M = K + rnd(7);
    const N = K + rnd(7);
    if (Math.floor(M / K) * Math.floor(N / K) < 3) continue;
    const g: Grid = Array.from({ length: M }, () => Array.from({ length: N }, () => rnd(10)));
    if (bySixCases(g, K).best !== bruteBest(g, K).best)
      throw new Error(`oil-blocks: หกทรงไม่ตรงกับการลองทุกสามบล็อก ที่ M=${M} N=${N} K=${K}`);
    done++;
  }
  if (bruteBest(SAMPLE, 3).best !== SAMPLE_K3.best || SAMPLE_K3.best !== 208)
    throw new Error('oil-blocks: ตัวอย่างในโจทย์ไม่ได้ 208');
  if (SAMPLE_K2.best !== 100) throw new Error('oil-blocks: ตัวอย่างที่ K = 2 ไม่ได้ 100');
}

