/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Grid = number[][];

/** ผลรวมของบล็อก K คูณ K ที่มีมุมบนซ้ายอยู่ที่ (r, c) นับจากศูนย์ */
function blockSum(g: Grid, K: number, r: number, c: number): number {
  let s = 0;
  for (let i = 0; i < K; i++) for (let j = 0; j < K; j++) s += g[r + i][c + j];
  return s;
}

/** ค่าที่ดีที่สุดของบล็อกที่วางอยู่ในสี่เหลี่ยม [r1, r2] x [c1, c2] ทั้งก้อน */
function bestIn(g: Grid, K: number, r1: number, r2: number, c1: number, c2: number): number {
  let best = 0;
  for (let r = r1; r + K - 1 <= r2; r++) for (let c = c1; c + K - 1 <= c2; c++) best = Math.max(best, blockSum(g, K, r, c));
  return best;
}

type CaseRow = { name: string; value: number };

/** ท่าที่บทความสอน หกทรงของการแบ่งกระดาน */
function bySixCases(g: Grid, K: number): { rows: CaseRow[]; best: number } {
  const M = g.length;
  const N = g[0].length;
  const rows: CaseRow[] = [];
  /* แถบที่บางเกินกว่าจะวางบล็อกได้ จะได้ค่าศูนย์จาก bestIn เอง จึงไม่ต้องกันขอบเป็นพิเศษ */
  let v = 0;
  for (let a = K - 1; a < M; a++)
    for (let b = a + K; b < M; b++)
      v = Math.max(v, bestIn(g, K, 0, a, 0, N - 1) + bestIn(g, K, a + 1, b, 0, N - 1) + bestIn(g, K, b + 1, M - 1, 0, N - 1));
  rows.push({ name: 'แถบแนวนอนสามแถบ', value: v });

  v = 0;
  for (let a = K - 1; a < N; a++)
    for (let b = a + K; b < N; b++)
      v = Math.max(v, bestIn(g, K, 0, M - 1, 0, a) + bestIn(g, K, 0, M - 1, a + 1, b) + bestIn(g, K, 0, M - 1, b + 1, N - 1));
  rows.push({ name: 'แถบแนวตั้งสามแถบ', value: v });

  v = 0;
  for (let t = K - 1; t + K < M; t++)
    for (let c = K - 1; c + K < N; c++)
      v = Math.max(v, bestIn(g, K, 0, t, 0, N - 1) + bestIn(g, K, t + 1, M - 1, 0, c) + bestIn(g, K, t + 1, M - 1, c + 1, N - 1));
  rows.push({ name: 'ตัดขวางหนึ่งเส้น ครึ่งล่างตัดตั้ง', value: v });

  v = 0;
  for (let t = K - 1; t + K < M; t++)
    for (let c = K - 1; c + K < N; c++)
      v = Math.max(v, bestIn(g, K, t + 1, M - 1, 0, N - 1) + bestIn(g, K, 0, t, 0, c) + bestIn(g, K, 0, t, c + 1, N - 1));
  rows.push({ name: 'ตัดขวางหนึ่งเส้น ครึ่งบนตัดตั้ง', value: v });

  v = 0;
  for (let c = K - 1; c + K < N; c++)
    for (let t = K - 1; t + K < M; t++)
      v = Math.max(v, bestIn(g, K, 0, M - 1, 0, c) + bestIn(g, K, 0, t, c + 1, N - 1) + bestIn(g, K, t + 1, M - 1, c + 1, N - 1));
  rows.push({ name: 'ตัดตั้งหนึ่งเส้น ครึ่งขวาตัดขวาง', value: v });

  v = 0;
  for (let c = K - 1; c + K < N; c++)
    for (let t = K - 1; t + K < M; t++)
      v = Math.max(v, bestIn(g, K, 0, M - 1, c + 1, N - 1) + bestIn(g, K, 0, t, 0, c) + bestIn(g, K, t + 1, M - 1, 0, c));
  rows.push({ name: 'ตัดตั้งหนึ่งเส้น ครึ่งซ้ายตัดขวาง', value: v });

  return { rows, best: Math.max(...rows.map((r) => r.value)) };
}

/** ตัวตรวจ ลองทุกสามบล็อกที่ไม่ทับกัน ไม่ใช้ทฤษฎีการแบ่งแถบใด ๆ */
function bruteBest(g: Grid, K: number): { best: number; pick: [number, number][] } {
  const M = g.length;
  const N = g[0].length;
  const pos: { r: number; c: number; s: number }[] = [];
  for (let r = 0; r + K <= M; r++) for (let c = 0; c + K <= N; c++) pos.push({ r, c, s: blockSum(g, K, r, c) });
  const overlap = (a: { r: number; c: number }, b: { r: number; c: number }): boolean =>
    !(a.r + K <= b.r || b.r + K <= a.r || a.c + K <= b.c || b.c + K <= a.c);
  let best = -1;
  let pick: [number, number][] = [];
  for (let i = 0; i < pos.length; i++)
    for (let j = i + 1; j < pos.length; j++) {
      if (overlap(pos[i], pos[j])) continue;
      for (let k = j + 1; k < pos.length; k++) {
        if (overlap(pos[i], pos[k]) || overlap(pos[j], pos[k])) continue;
        const tot = pos[i].s + pos[j].s + pos[k].s;
        if (tot > best) {
          best = tot;
          pick = [[pos[i].r, pos[i].c], [pos[j].r, pos[j].c], [pos[k].r, pos[k].c]];
        }
      }
    }
  return { best, pick };
}

