<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type OilPuzzle = { id: string; label: string; tease: string; K: number; g: number[][]; best: number };

  function initOilGame(): void {
    const maybeUi = cpGameUi('[data-oilgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as OilPuzzle[];
    if (puzzles.length === 0) return;

    let pi = 0;
    let picks: { r: number; c: number }[] = [];

    const pz = (): OilPuzzle => puzzles[pi];
    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-oil-board]'));

    const sumOf = (p: OilPuzzle, r: number, c: number): number => {
      let s = 0;
      for (let i = 0; i < p.K; i++) for (let j = 0; j < p.K; j++) s += p.g[r + i][c + j];
      return s;
    };
    const overlap = (p: OilPuzzle, a: { r: number; c: number }, b: { r: number; c: number }): boolean =>
      !(a.r + p.K <= b.r || b.r + p.K <= a.r || a.c + p.K <= b.c || b.c + p.K <= a.c);

    function render(): void {
      const p = pz();
      boards.forEach((b, k) => {
        b.hidden = k !== pi;
      });
      for (const btn of Array.from(boards[pi].querySelectorAll<HTMLElement>('[data-oil-cell]'))) {
        const parts = (btn.dataset.oilCell ?? '').split(':');
        const r = Number(parts[1]);
        const c = Number(parts[2]);
        btn.classList.remove('b0', 'b1', 'b2', 'corner');
        picks.forEach((q, idx) => {
          if (r >= q.r && r < q.r + p.K && c >= q.c && c < q.c + p.K) {
            btn.classList.add(`b${idx}`);
            if (r === q.r && c === q.c) btn.classList.add('corner');
          }
        });
      }
      const total = picks.reduce((acc, q) => acc + sumOf(p, q.r, q.c), 0);
      ui.setScore(`วางแล้ว ${picks.length} จาก 3 บล็อก รวมได้ ${total}`);
    }

    function place(r: number, c: number): void {
      const p = pz();
      const at = picks.findIndex((q) => q.r === r && q.c === c);
      if (at >= 0) {
        picks.splice(at, 1);
        render();
        return;
      }
      if (r + p.K > p.g.length || c + p.K > p.g[0].length) {
        ui.setStatus(`บล็อกขนาด ${p.K} คูณ ${p.K} วางตรงนี้แล้วล้นขอบตาราง`, 'bad');
        return;
      }
      if (picks.length >= 3) {
        ui.setStatus('วางครบสามบล็อกแล้ว กดที่บล็อกเดิมเพื่อเอาออกก่อน', 'bad');
        return;
      }
      if (picks.some((q) => overlap(p, q, { r, c }))) {
        ui.setStatus('บล็อกนี้ทับกับบล็อกที่วางไว้แล้ว ซึ่งกติกาไม่ให้ทับกันเลย', 'bad');
        return;
      }
      picks.push({ r, c });
      ui.setStatus('วางแล้ว กดช่องอื่นเพื่อวางบล็อกถัดไป', 'plain');
      render();
    }

    function check(): void {
      const p = pz();
      if (picks.length < 3) {
        ui.setStatus('ยังวางไม่ครบสามบล็อก', 'bad');
        return;
      }
      const total = picks.reduce((acc, q) => acc + sumOf(p, q.r, q.c), 0);
      if (total === p.best) ui.setStatus(`มากที่สุดแล้วครับ ตารางนี้ได้ ${p.best} พอดี`, 'good');
      else ui.setStatus(`ชุดนี้ได้ ${total} แต่ตารางนี้ทำได้ถึง ${p.best} ลองลากเส้นแบ่งกระดานดูว่ายังเหลือทรงไหนที่ไม่ได้ลอง`, 'bad');
    }

    function selectPuzzle(k: number): void {
      pi = k;
      picks = [];
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ui.setStatus('กดที่ช่องเพื่อวางมุมบนซ้ายของบล็อก วางได้สามบล็อก กดซ้ำที่เดิมเพื่อเอาออก');
      render();
    }

    ui.root.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const btn = e.target.closest('[data-oil-cell]');
      if (!(btn instanceof HTMLElement)) return;
      const parts = (btn.dataset.oilCell ?? '').split(':');
      place(Number(parts[1]), Number(parts[2]));
    });

    ui.onClick('data-oil-clear', () => selectPuzzle(pi));
    ui.onClick('data-oil-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initOilGame);
</script>

