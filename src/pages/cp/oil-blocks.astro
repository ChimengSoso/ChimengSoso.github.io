type GamePuzzle = { id: string; label: string; tease: string; K: number; g: Grid; best: number };
function makePuzzle(id: string, label: string, tease: string, g: Grid, K: number): GamePuzzle {
  const b = bruteBest(g, K).best;
  if (bySixCases(g, K).best !== b) throw new Error(`oil-blocks: เฉลยเกม ${id} สองท่าไม่ตรงกัน`);
  return { id, label, tease, K, g, best: b };
}
