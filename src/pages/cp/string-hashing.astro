  .sh-strip :global(.sh-cell.b){background:#132235;border-color:#3d5a80;}
  .sh-strip :global(.sh-cell.b b){color:#9ecbff;}
  .sh-strip :global(.sh-cell.both){background:#35300f;border-color:#8a7a2f;}
  .sh-strip :global(.sh-cell.both b){color:#e6c84a;}
</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type ShAsk = { l1: number; l2: number; len: number; same: boolean; a: string; b: string };
  type ShPuzzle = { id: string; label: string; tease: string; s: string; asks: ShAsk[] };

  function initHashGame(): void {
    const maybeUi = cpGameUi('[data-shgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as ShPuzzle[];
    if (puzzles.length === 0) return;

    const stripEl = ui.root.querySelector<HTMLElement>('[data-sh-strip]');
    const askEl = ui.root.querySelector<HTMLElement>('[data-sh-ask]');
    const rightEl = ui.root.querySelector<HTMLElement>('[data-sh-right]');
    const totalEl = ui.root.querySelector<HTMLElement>('[data-sh-total]');
    if (!stripEl || !askEl || !rightEl || !totalEl) return;
    const strip: HTMLElement = stripEl;
    const askOut: HTMLElement = askEl;
    const rightOut: HTMLElement = rightEl;
    const totalOut: HTMLElement = totalEl;

    let pi = 0;
    let qi = 0;
    let right = 0;

    const pz = (): ShPuzzle => puzzles[pi];
    const ask = (): ShAsk | undefined => pz().asks[qi];

    function render(): void {
      const p = pz();
      const q = ask();
      strip.textContent = '';
      for (let i = 0; i < p.s.length; i++) {
        const cell = document.createElement('span');
        cell.className = 'sh-cell';
        const idx = document.createElement('small');
        idx.textContent = String(i + 1);
        const val = document.createElement('b');
        val.textContent = p.s[i];
        cell.append(idx, val);
        if (q) {
          const inA = i + 1 >= q.l1 && i + 1 < q.l1 + q.len;
          const inB = i + 1 >= q.l2 && i + 1 < q.l2 + q.len;
          if (inA && inB) cell.classList.add('both');
          else if (inA) cell.classList.add('a');
          else if (inB) cell.classList.add('b');
        }
        strip.appendChild(cell);
      }
      askOut.textContent = q
        ? `ช่วงที่เริ่มที่ ${q.l1} กับช่วงที่เริ่มที่ ${q.l2} ยาว ${q.len} ตัว เหมือนกันไหม`
        : 'จบชุดนี้แล้ว';
      rightOut.textContent = String(right);
      totalOut.textContent = String(p.asks.length);
    }

    function answer(said: boolean): void {
      const p = pz();
      const q = ask();
      if (!q) {
        ui.setStatus('จบชุดนี้แล้วครับ', 'plain');
        return;
      }
      if (said === q.same) {
        right++;
        ui.setStatus(`ถูกต้อง "${q.a}" กับ "${q.b}" ${q.same ? 'เหมือนกัน' : 'ต่างกัน'}`, 'good');
      } else {
        ui.setStatus(`ยังไม่ใช่ "${q.a}" กับ "${q.b}" ${q.same ? 'เหมือนกัน' : 'ต่างกัน'}`, 'bad');
      }
      qi++;
      render();
      if (!ask()) {
        ui.setStatus(
          `จบชุดนี้ ตอบถูก ${right} จาก ${p.asks.length} ข้อ`,
          right === p.asks.length ? 'good' : 'bad',
        );
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      qi = 0;
      right = 0;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ui.setStatus('ดูสองช่วงที่ถูกไฮไลต์ แล้วตอบว่าเหมือนกันไหม');
      render();
    }

    ui.onClick('data-sh-same', () => answer(true));
    ui.onClick('data-sh-diff', () => answer(false));
    ui.onClick('data-sh-reset', () => selectPuzzle(pi));
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initHashGame);
</script>
