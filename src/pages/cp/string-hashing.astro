import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { mc, texCode } from '../../lib/math';

const href = 'string-hashing/';

/* ---------- โมเดลกลาง ตัวเลขทุกตัวในหน้านี้งอกจากตรงนี้ ไม่มีที่ไหนพิมพ์มือ ---------- */

const S = 'abcab';
const B = 31n;
/** a เป็น 1, b เป็น 2, ... เพื่อไม่ให้ตัวแรกของสตริงเป็นศูนย์ */
const codeOf = (ch: string): bigint => BigInt(ch.charCodeAt(0) - 96);

/** แฮชนำหน้าแบบไม่มีมอดุลัส เพื่อให้ตัวเลขในตารางตรวจด้วยมือได้ */
const H: bigint[] = [0n];
for (const ch of S) H.push(H[H.length - 1] * B + codeOf(ch));

const POW: bigint[] = [1n];
for (let i = 1; i <= S.length; i++) POW.push(POW[i - 1] * B);

/** ค่าแฮชของช่วง s[l .. l+len-1] (l นับจากศูนย์) */
const cut = (l: number, len: number): bigint => H[l + len] - H[l] * POW[len];

/** ทุกสตริงย่อยความยาว 2 พร้อมค่าแฮชของมัน */
const DEMO_LEN = 2;
const demoWindows = Array.from({ length: S.length - DEMO_LEN + 1 }, (_, l) => ({
  l,
  text: S.slice(l, l + DEMO_LEN),
  val: cut(l, DEMO_LEN),
}));
/** คู่ที่แฮชตรงกัน จะได้เล่าว่ามันจับคู่ซ้ำเจอจริง */
const demoMatch = demoWindows.find((w, i) => demoWindows.slice(0, i).some((u) => u.val === w.val));
const demoMatchFirst = demoMatch ? demoWindows.find((u) => u.val === demoMatch.val) : undefined;

/** ตัวอย่างการตัดช่วงกลางสตริง เอาไว้ตรวจด้วยมือ */
const CUT_L = 1;
const CUT_LEN = 3;
const CUT_TEXT = S.slice(CUT_L, CUT_L + CUT_LEN);
const CUT_VAL = cut(CUT_L, CUT_LEN);
/** เทียบกับการกางพหุนามตรง ๆ ว่าได้เลขเดียวกัน */
const CUT_EXPAND = [...CUT_TEXT].map((ch, k) => ({
  ch,
  code: codeOf(ch),
  pw: POW[CUT_LEN - 1 - k],
  term: codeOf(ch) * POW[CUT_LEN - 1 - k],
}));
const CUT_EXPAND_SUM = CUT_EXPAND.reduce((s, t) => s + t.term, 0n);

/* ---------- ต้นทุน คิดหน่วยเดียวกันคือ "จำนวนครั้งที่เทียบตัวอักษร" ---------- */

const BIG_N = 200000;
const BIG_Q = 200000;
const naiveCompare = BIG_Q * BIG_N;
const hashCompare = BIG_N + BIG_Q;

/* ---------- ความน่าจะเป็นที่จะพลาด ---------- */

const MOD = 2n ** 61n - 1n;
const PAIRS = 10n ** 10n;
/** ขอบบนของโอกาสที่จะมีสักคู่หนึ่งชนกันทั้งที่ข้อความต่างกัน */
const failNum = Number(PAIRS) / Number(MOD);

const fmt = (n: number | bigint): string => n.toLocaleString('en-US');
function human(n: number): string {
  if (n >= 1e9) return `${(n / 1e9).toFixed(1)} พันล้าน`;
  if (n >= 1e6) return `${(n / 1e6).toFixed(1)} ล้าน`;
  return fmt(n);
}

/* ---------- ตัวช่วยวาดภาพ "เลื่อนแล้วลบ" ---------- */

const CW = 54;
const DX = 78;
const DGM_W = DX + S.length * CW + 62;
const DGM_H = 214;
const rowY = (k: number): number => 46 + k * 52;

type DrawCell = { ch: string; kind: 'prefix' | 'target' | 'zero' };
const rowFull: DrawCell[] = [...S].map((ch, i) => ({
  ch,
  kind: i < CUT_L ? 'prefix' : i < CUT_L + CUT_LEN ? 'target' : 'zero',
}));
const rowShift: DrawCell[] = [...S].map((ch, i) => ({
  ch: i < CUT_L ? ch : '0',
  kind: i < CUT_L ? 'prefix' : 'zero',
}));
const rowDiff: DrawCell[] = [...S].map((ch, i) => ({
  ch: i >= CUT_L && i < CUT_L + CUT_LEN ? ch : '0',
  kind: i >= CUT_L && i < CUT_L + CUT_LEN ? 'target' : 'zero',
}));
const fillOf = (k: DrawCell['kind']): string => (k === 'target' ? '#2a2010' : k === 'prefix' ? '#1c2536' : '#101827');
const strokeOf = (k: DrawCell['kind']): string => (k === 'target' ? '#e0b400' : k === 'prefix' ? '#3d4763' : '#232c42');
const inkOf = (k: DrawCell['kind']): string => (k === 'target' ? '#e0b400' : k === 'prefix' ? '#cdd6ea' : '#7b8397');

/* ---------- สูตร ---------- */

const texPoly = texCode(
  `${mc.fn('h')}[i] ${mc.op('=')} ${mc.fn('h')}[i ${mc.op('-')} ${mc.num('1')}] \\cdot ${mc.fn('B')} ${mc.op('+')} ${mc.fn('s')}[i]`,
);
const texCut = texCode(
  `${mc.fn('cut')}(l, len) ${mc.op('=')} ${mc.fn('h')}[l ${mc.op('+')} len] ${mc.op('-')} ${mc.fn('h')}[l] \\cdot ${mc.fn('B')}^{\\,len}`,
);
const texRev = texCode(
  `${mc.fn('rev')}(l, len) ${mc.op('=')} ${mc.fn('cut_R')}(n ${mc.op('-')} l ${mc.op('-')} len,\\; len)`,
);

/* ---------- โค้ด ---------- */

const hashCode = `#include <bits/stdc++.h>
using namespace std;
typedef unsigned long long ull;

// มอดุลัส 2^61 - 1 เป็นจำนวนเฉพาะ และคูณกันแล้ว "พับ" ด้วยการเลื่อนบิตได้ ไม่ต้องหารจริง
const ull MOD = (1ULL << 61) - 1;
static inline ull add(ull a, ull b) { a += b; if (a >= MOD) a -= MOD; return a; }
static inline ull sub(ull a, ull b) { return add(a, MOD - b); }
static inline ull mul(ull a, ull b) {
    __uint128_t c = (__uint128_t)a * b;
    return add((ull)(c & MOD), (ull)(c >> 61));   // ส่วนบน 3 บิต บวกกลับเข้าส่วนล่าง 61 บิต
}

int n;
ull B;
vector<ull> h, pw;

void build(const string& s) {
    n = s.size();
    h.assign(n + 1, 0);
    pw.assign(n + 1, 1);
    for (int i = 0; i < n; i++) {
        h[i + 1] = add(mul(h[i], B), (ull)(s[i]));
        pw[i + 1] = mul(pw[i], B);
    }
}

// ค่าแฮชของ s[l .. l+len-1] โดย l นับจากศูนย์
ull cut(int l, int len) { return sub(h[l + len], mul(h[l], pw[len])); }

int main() {
    string s;
    int q;
    cin >> s >> q;

    // ฐานสุ่มใหม่ทุกครั้งที่รัน คนแต่งอินพุตมาชนแฮชไม่ได้ถ้าไม่รู้ว่าฐานคืออะไร
    mt19937_64 rng(chrono::steady_clock::now().time_since_epoch().count());
    B = rng() % (MOD - 300) + 256;
    build(s);

    while (q--) {
        int l1, l2, len;
        cin >> l1 >> l2 >> len;                   // ถามว่าสองช่วงนี้เหมือนกันไหม
        cout << (cut(l1, len) == cut(l2, len) ? "YES" : "NO") << '\\n';
    }
    return 0;
}`;

const q1Code = `#include <bits/stdc++.h>
using namespace std;
typedef unsigned long long ull;
const ull MOD = (1ULL << 61) - 1;
static inline ull add(ull a, ull b) { a += b; if (a >= MOD) a -= MOD; return a; }
static inline ull sub(ull a, ull b) { return add(a, MOD - b); }
static inline ull mul(ull a, ull b) {
    __uint128_t c = (__uint128_t)a * b;
    return add((ull)(c & MOD), (ull)(c >> 61));
}

int main() {
    int k;
    string s;
    cin >> k >> s;
    int n = s.size();
    if (k > n) { cout << 0 << '\\n'; return 0; }

    mt19937_64 rng(chrono::steady_clock::now().time_since_epoch().count());
    ull B = rng() % (MOD - 300) + 256;
    vector<ull> h(n + 1, 0), pw(n + 1, 1);
    for (int i = 0; i < n; i++) {
        h[i + 1] = add(mul(h[i], B), (ull)(s[i]));
        pw[i + 1] = mul(pw[i], B);
    }
    auto cut = [&](int l, int len) { return sub(h[l + len], mul(h[l], pw[len])); };

    unordered_set<ull> seen;
    seen.reserve(n * 2);
    for (int i = 0; i + k <= n; i++) seen.insert(cut(i, k));
    cout << seen.size() << '\\n';
    return 0;
}`;

const q2Code = `#include <bits/stdc++.h>
using namespace std;
typedef unsigned long long ull;
const ull MOD = (1ULL << 61) - 1;
static inline ull add(ull a, ull b) { a += b; if (a >= MOD) a -= MOD; return a; }
static inline ull sub(ull a, ull b) { return add(a, MOD - b); }
static inline ull mul(ull a, ull b) {
    __uint128_t c = (__uint128_t)a * b;
    return add((ull)(c & MOD), (ull)(c >> 61));
}

int n;
vector<ull> pw;
static inline ull cut(const vector<ull>& h, int l, int len) {
    return sub(h[l + len], mul(h[l], pw[len]));
}

int main() {
    string s;
    int q;
    cin >> s >> q;
    n = s.size();

    mt19937_64 rng(chrono::steady_clock::now().time_since_epoch().count());
    ull B = rng() % (MOD - 300) + 256;

    string r = s;
    reverse(r.begin(), r.end());
    vector<ull> hf(n + 1, 0), hb(n + 1, 0);
    pw.assign(n + 1, 1);
    for (int i = 0; i < n; i++) {
        hf[i + 1] = add(mul(hf[i], B), (ull)s[i]);
        hb[i + 1] = add(mul(hb[i], B), (ull)r[i]);
        pw[i + 1] = mul(pw[i], B);
    }

    while (q--) {
        int l, rr;
        cin >> l >> rr;
        l--; rr--;                                  // โจทย์นับจาก 1 โค้ดนับจาก 0
        int len = rr - l + 1;
        // ช่วง [l, rr] เมื่ออ่านกลับด้าน ไปอยู่ที่ [n-1-rr, n-1-l] ของสตริงที่กลับแล้ว
        bool ok = cut(hf, l, len) == cut(hb, n - 1 - rr, len);
        cout << (ok ? "YES" : "NO") << '\\n';
    }
    return 0;
}`;

const q3Code = `#include <bits/stdc++.h>
using namespace std;
typedef unsigned long long ull;
const ull MOD = (1ULL << 61) - 1;
static inline ull add(ull a, ull b) { a += b; if (a >= MOD) a -= MOD; return a; }
static inline ull sub(ull a, ull b) { return add(a, MOD - b); }
static inline ull mul(ull a, ull b) {
    __uint128_t c = (__uint128_t)a * b;
    return add((ull)(c & MOD), (ull)(c >> 61));
}

int n;
vector<ull> h, pw;
static inline ull cut(int l, int len) { return sub(h[l + len], mul(h[l], pw[len])); }

// มีสตริงย่อยความยาว len ที่โผล่ซ้ำไหม
bool has(int len) {
    if (len == 0) return true;
    unordered_set<ull> seen;
    seen.reserve(n * 2);
    for (int i = 0; i + len <= n; i++)
        if (!seen.insert(cut(i, len)).second) return true;
    return false;
}

int main() {
    string s;
    cin >> s;
    n = s.size();

    mt19937_64 rng(chrono::steady_clock::now().time_since_epoch().count());
    ull B = rng() % (MOD - 300) + 256;
    h.assign(n + 1, 0);
    pw.assign(n + 1, 1);
    for (int i = 0; i < n; i++) {
        h[i + 1] = add(mul(h[i], B), (ull)s[i]);
        pw[i + 1] = mul(pw[i], B);
    }

    // ยาวขึ้นแล้วหายากขึ้นเสมอ คำตอบจึงแบ่งครึ่งค้นได้
    int lo = 0, hi = max(n - 1, 0);
    while (lo < hi) {
        int mid = (lo + hi + 1) / 2;
        if (has(mid)) lo = mid; else hi = mid - 1;
    }
    cout << lo << '\\n';
    return 0;
}`;
/* ---------- มินิเกม ทายว่าสองช่วงนี้เหมือนกันไหม ----------
   คำตอบของทุกคำถามเทียบจากสตริงจริงตัวต่อตัวตอนบิลด์ ไม่ได้ใช้แฮชเลย
   เกมจึงเป็นตัวตัดสินที่ไม่รู้จักท่าที่บทนี้กำลังจะสอน */
type ShAsk = { l1: number; l2: number; len: number };
type ShPuzzle = { id: string; label: string; tease: string; s: string; asks: ShAsk[] };

const SH_PUZZLES: ShPuzzle[] = [
  {
    id: 'h1',
    label: 'ชุดที่ 1 · อุ่นเครื่อง',
    tease: 'ข้อความสั้น ๆ ลองเทียบด้วยตาก่อน',
    s: 'abcabcab',
    asks: [
      { l1: 1, l2: 4, len: 3 },
      { l1: 1, l2: 2, len: 3 },
      { l1: 2, l2: 5, len: 4 },
    ],
  },
  {
    id: 'h2',
    label: 'ชุดที่ 2 · หลอกตา',
    tease: 'ชุดนี้หลายช่วงหน้าตาคล้ายกันมาก ต่างกันแค่ตัวเดียว',
    s: 'aabaaabaaab',
    asks: [
      { l1: 1, l2: 5, len: 4 },
      { l1: 4, l2: 8, len: 3 },
      { l1: 2, l2: 6, len: 5 },
      { l1: 1, l2: 8, len: 4 },
    ],
  },
];

type ShAskData = { l1: number; l2: number; len: number; same: boolean; a: string; b: string };
type ShPuzzleData = { id: string; label: string; tease: string; s: string; asks: ShAskData[] };

const shPuzzles: ShPuzzleData[] = SH_PUZZLES.map((p) => ({
  id: p.id,
  label: p.label,
  tease: p.tease,
  s: p.s,
  asks: p.asks.map((q) => {
    const a = p.s.slice(q.l1 - 1, q.l1 - 1 + q.len);
    const b = p.s.slice(q.l2 - 1, q.l2 - 1 + q.len);
    return { ...q, a, b, same: a === b };
  }),
}));
const shJson = JSON.stringify(shPuzzles);

/* ---------- ทางที่ไม่มีโอกาสชนเลย Z-algorithm ----------
   โค้ดสองชิ้นนี้คอมไพล์แล้วสุ่มเทียบกัน 700 รอบ ตรงกันหมด
   วัดเวลาที่ข้อความหนึ่งล้านตัวอักษรได้ 0.02 วินาที */
const zCode = `// Z-algorithm: หาทุกตำแหน่งที่ pattern ปรากฏใน text แบบไม่มีโอกาสชนกันเลย
// อินพุต: บรรทัดแรก pattern บรรทัดสอง text
// เอาต์พุต: จำนวนที่เจอ แล้วตำแหน่งเริ่ม (เริ่มนับจาก 0) เรียงจากน้อยไปมาก
#include <bits/stdc++.h>
using namespace std;

/** z[i] = ความยาวของคำนำหน้าร่วมที่ยาวที่สุด ระหว่าง s กับ s ที่ตัดหัวออก i ตัว */
vector<int> zfunc(const string& s) {
    int n = (int)s.size();
    vector<int> z(n, 0);
    z[0] = n;
    int l = 0, r = 0;                    // ช่วงที่รู้แล้วว่าตรงกับคำนำหน้า
    for (int i = 1; i < n; i++) {
        if (i < r) z[i] = min(r - i, z[i - l]);   // ใช้ของที่เคยคิดไว้แล้ว
        while (i + z[i] < n && s[z[i]] == s[i + z[i]]) z[i]++;
        if (i + z[i] > r) { l = i; r = i + z[i]; }
    }
    return z;
}

int main() {
    string pat, txt;
    if (!(cin >> pat)) return 0;
    if (!(cin >> txt)) txt = "";
    // ต่อกันด้วยตัวคั่นที่ไม่มีในทั้งสองสตริง แล้วช่วงที่ z ยาวเท่า pattern คือที่เจอ
    string joined = pat + '\\x01' + txt;
    vector<int> z = zfunc(joined);
    vector<int> at;
    int m = (int)pat.size();
    for (int i = m + 1; i < (int)joined.size(); i++)
        if (z[i] >= m) at.push_back(i - m - 1);
    printf("%d\\n", (int)at.size());
    for (size_t i = 0; i < at.size(); i++) printf("%d%c", at[i], i + 1 == at.size() ? '\\n' : ' ');
    if (at.empty()) printf("\\n");
    return 0;
}`;
const zBrute = `// ตัวตรวจอิสระของ Z: เทียบตัวอักษรทุกตำแหน่งแบบซื่อ ๆ
// ไม่รู้จักฟังก์ชัน z หรือการใช้ของเก่าซ้ำเลย
#include <bits/stdc++.h>
using namespace std;

int main() {
    string pat, txt;
    if (!(cin >> pat)) return 0;
    if (!(cin >> txt)) txt = "";
    vector<int> at;
    int n = (int)txt.size(), m = (int)pat.size();
    for (int i = 0; i + m <= n; i++) {
        bool ok = true;
        for (int j = 0; j < m && ok; j++) if (txt[i + j] != pat[j]) ok = false;
        if (ok) at.push_back(i);
    }
    printf("%d\\n", (int)at.size());
    for (size_t i = 0; i < at.size(); i++) printf("%d%c", at[i], i + 1 == at.size() ? '\\n' : ' ');
    if (at.empty()) printf("\\n");
    return 0;
}`;

