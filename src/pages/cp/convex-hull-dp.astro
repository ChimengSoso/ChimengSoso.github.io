/* ---------- กระดานของเกม: วาดกราฟของทุกชุดตอนบิลด์ แล้วให้สคริปต์แค่สลับว่าโชว์ชุดไหน ----------
   เหตุผลที่ไม่วาดด้วย JS คือรูปเป็นข้อมูลของโมเดล ไม่ใช่ผลของการกดปุ่ม
   วาดตอนบิลด์แปลว่ามันถูกตรวจไปพร้อมกับตัวเลขอื่นทั้งหมดแล้ว */
type GameBoard = { plot: Plot; segs: { t: number; L: Ln; seg: { ax: number; ay: number; bx: number; by: number } | null }[]; env: string; vb: string; bot: number };

function autoPlot(lines: Ln[]): Plot {
  const hull = new LowerHull();
  for (const L of [...lines].sort((a, b) => b.m - a.m || a.b - b.b)) hull.add(L);
  const breaks: number[] = [];
  for (let t = 0; t + 1 < hull.st.length; t++) {
    const dm = hull.st[t].m - hull.st[t + 1].m;
    if (dm !== 0) breaks.push((hull.st[t + 1].b - hull.st[t].b) / dm);
  }
  const lo = breaks.length === 0 ? -4 : Math.floor(Math.min(...breaks)) - 4;
  const hi = breaks.length === 0 ? 4 : Math.ceil(Math.max(...breaks)) + 4;
  const x0 = lo;
  const x1 = hi - lo < 8 ? lo + 8 : hi;
  const edge = lines.flatMap((L) => [lnAt(L, x0), lnAt(L, x1)]);
  const envLo = Math.min(...hull.st.map((L) => Math.min(lnAt(L, x0), lnAt(L, x1))));
  const envHi = Math.max(...edge);
  const pad = Math.max(4, (envHi - envLo) * 0.06);
  return makePlot(x0, x1, envLo - pad, envHi + pad, 520, 260);
}

const gameBoards: GameBoard[] = gamePuzzles.map((pz) => {
  const plot = autoPlot(pz.lines);
  const segs = pz.lines.map((L, t) => ({ t, L, seg: clipLine(L, plot) }));
  /* ทุกเส้นต้องโผล่ในกรอบ ไม่งั้นผู้เล่นจะเห็นชิปที่ไม่มีเส้นให้ดู */
  for (const s of segs) {
    if (s.seg === null) {
      throw new Error(`convex-hull-dp: กระดานของชุด ${pz.id} มีเส้นที่ตกกรอบ`);
    }
  }
  const bot = plot.padT + plot.h;
  return {
    plot,
    segs,
    env: envelopePath(pz.lines, plot),
    vb: `0 0 ${plot.padL + plot.w + 72 + 12} ${bot + 40 + 34}`,
    bot,
  };
});

/* ============================================================================
   โค้ดทุกก้อนในหน้านี้คอมไพล์ด้วย g++ 11.4 แล้วตรวจกับตัวไล่ทุกทางเลือกมาแล้ว
   ก้อนที่ตั้งใจให้ผิดสองก้อนท้ายสุด ก็คอมไพล์และรันเพื่อยืนยันว่ามันผิดจริงตามที่เล่า
   ========================================================================== */
const codeTemplate = `
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

/* ============================================================
   แม่แบบ CHT ระดับ 1 · ลอกไปใช้ได้เลย
   ใช้ได้เมื่อครบสองข้อ
     1. ความชันของเส้นที่ใส่ เรียงจากมากไปน้อย
     2. ตำแหน่งที่ถาม เรียงจากน้อยไปมาก
   หาค่า "น้อยสุด" ถ้าต้องการค่ามากสุด ให้กลับเครื่องหมายทั้งชันและจุดตัด
   แล้วกลับเครื่องหมายคำตอบอีกที
   ============================================================ */
struct Line { ll m, b; };
static inline ll lineAt(const Line &L, ll x) { return L.m * x + L.b; }

struct Hull {
  vector<Line> st;                                 // เส้นที่ยังมีสิทธิ์ชนะ เรียงตามความชันจากมากไปน้อย
  int ptr = 0;                                     // ตัวชี้ว่ารอบก่อนเส้นไหนชนะ เดินไปข้างหน้าทางเดียว

  /* เส้นกลาง b ทิ้งได้ ถ้าจุดตัดของ a กับเส้นใหม่ c ไม่ได้อยู่ขวากว่าจุดตัดของ a กับ b
