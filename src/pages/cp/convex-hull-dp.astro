     เทียบกับการไล่ทุกเส้น  */
  const int LO = -60, HI = 60;
  mt19937 rng(20260911);
  for (int round = 1; round <= 400; round++) {
    nd.assign(1, {0, 0, 0, INF});
    int root = 0;
    vector<pair<ll, ll>> all;
    int n = 1 + (int)(rng() % 10);
    for (int t = 0; t < n; t++) {
      ll m = (ll)(rng() % 21) - 10, b = (ll)(rng() % 41) - 20;
      all.push_back({m, b});
      root = addLine(root, LO, HI, m, b);
    }
    for (int x = LO; x <= HI; x++) {
      ll got = queryTree(root, LO, HI, x);
      ll want = INF;
      for (auto &L : all) want = min(want, L.first * x + L.second);
      if (got != want) {
        printf("ROUND %d x=%d got=%lld want=%lld\\n", round, x, got, want);
        return 1;
      }
    }
  }
  printf("ok\\n");
  return 0;
}
