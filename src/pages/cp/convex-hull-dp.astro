    sort(x.begin(), x.end());
    ll a = byHull(x, c), b = byEveryChoice(x, c);
    rounds++;
    if (a != b) {
      printf("DIFF n=%d c=%lld hull=%lld truth=%lld\\nx =", n, c, a, b);
