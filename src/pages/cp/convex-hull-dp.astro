/* ============================================================================
   ตัวอย่างค้าน: ฝืนใช้ท่าระดับ 1 ในสถานการณ์ที่มันใช้ไม่ได้
   ทั้งสองตัวหามาจากการไล่ทุกกรณีเล็ก ๆ ตามลำดับจากเล็กไปใหญ่
   ตัวแรกที่เจอจึงเป็นตัวที่เล็กที่สุดจริง ไม่ใช่ตัวที่สุ่มมาได้
   ========================================================================== */

/* ---------- ค้านที่ 1: ตำแหน่งที่ถามไม่เรียง ตัวชี้เดินหน้าทางเดียวจึงถอยกลับไปดูไม่ได้ ---------- */
type QueryTrap = { lines: Ln[]; queries: number[]; at: number; got: number; want: number };
const queryTrap: QueryTrap = (() => {
  const SL = [2, 1, 0, -1, -2];
  const BS = [-1, 0, 1];
  for (let nl = 2; nl <= 3; nl++) {
    for (const combo of pickSlopes(SL, nl)) {
      for (const bs of pickWithRepeat(BS, nl)) {
        const lines: Ln[] = combo.map((m, t) => ({ m, b: bs[t] }));
        for (const qs of pickWithRepeat([-1, 0, 1], 2)) {
          if (qs[1] >= qs[0]) continue;                 // สนใจแค่กรณีที่คำถามถอยหลัง
          const h = new LowerHull();
          for (const L of lines) h.add(L);
          for (let t = 0; t < qs.length; t++) {
            const got = h.query(qs[t]);
            const want = naiveMin(lines, qs[t]);
            if (got !== want) return { lines, queries: qs, at: qs[t], got, want };
          }
        }
      }
    }
  }
  throw new Error('convex-hull-dp: หาตัวค้านของคำถามที่ไม่เรียงไม่เจอ ซึ่งไม่ควรเกิด');
})();

/* ---------- ค้านที่ 2: ความชันใส่เข้ามาแบบไม่เรียง สแต็กจึงทิ้งเส้นที่ยังมีประโยชน์ ---------- */
type SlopeTrap = { lines: Ln[]; lost: Ln; at: number; got: number; want: number };
const slopeTrap: SlopeTrap = (() => {
  const MS = [-2, -1, 0, 1, 2];
  const BS = [-2, -1, 0, 1, 2];
  for (const ms of pickWithRepeat(MS, 3)) {
    const descending = ms[0] > ms[1] && ms[1] > ms[2];
    if (descending) continue;                           // ต้องเป็นลำดับที่ผิดกติกาเท่านั้น
    if (ms[0] === ms[1] || ms[1] === ms[2] || ms[0] === ms[2]) continue;
    for (const bs of pickWithRepeat(BS, 3)) {
      const lines: Ln[] = ms.map((m, t) => ({ m, b: bs[t] }));
      const h = new LowerHull();
      for (const L of lines) h.add(L);
      const kept = new Set(h.st.map((L) => L.m + ':' + L.b));
      const useful = usefulByRationalScan(lines);
      for (let t = 0; t < lines.length; t++) {
        if (!useful[t]) continue;
        if (kept.has(lines[t].m + ':' + lines[t].b)) continue;
        for (let x = -4; x <= 4; x++) {
          const got = naiveMin(h.st, x);
          const want = naiveMin(lines, x);
          if (got !== want) return { lines, lost: lines[t], at: x, got, want };
        }
      }
    }
  }
  throw new Error('convex-hull-dp: หาตัวค้านของความชันที่ไม่เรียงไม่เจอ ซึ่งไม่ควรเกิด');
})();

/** เลือก nl ค่าจาก pool โดยเรียงจากมากไปน้อยและไม่ซ้ำ */
function pickSlopes(pool: number[], nl: number): number[][] {
  if (nl === 0) return [[]];
  const out: number[][] = [];
  for (let i = 0; i + nl <= pool.length; i++) {
    for (const rest of pickSlopes(pool.slice(i + 1), nl - 1)) out.push([pool[i], ...rest]);
  }
  return out;
}
/** ทุกลำดับความยาว k จาก pool ซ้ำได้ */
function pickWithRepeat(pool: number[], k: number): number[][] {
  if (k === 0) return [[]];
  const out: number[][] = [];
  for (const head of pool) for (const rest of pickWithRepeat(pool, k - 1)) out.push([head, ...rest]);
  return out;
}

/* ============================================================================
   ตัวช่วยวาดกราฟเส้นตรง ใช้ร่วมกันสามที่ คือภาพเปลือกล่าง ภาพเส้นที่ถูกบีบ และกระดานของเกม
   ทุก viewBox กว้างเท่าเนื้อหาบวก 12 สูงเท่าเนื้อหาบวก 34 เพื่อเว้นมุมขวาล่างให้ปุ่ม "ขยาย"
   ========================================================================== */
type Plot = {
  w: number;
  h: number;
  padL: number;
  padT: number;
  x0: number;
  x1: number;
  y0: number;
  y1: number;
  sx: (x: number) => number;
  sy: (y: number) => number;
};

function makePlot(x0: number, x1: number, y0: number, y1: number, w: number, h: number): Plot {
  const padL = 46;
  const padT = 16;
  return {
    w,
    h,
    padL,
    padT,
    x0,
    x1,
    y0,
    y1,
    sx: (x) => padL + ((x - x0) / (x1 - x0)) * w,
    sy: (y) => padT + ((y1 - y) / (y1 - y0)) * h,
  };
}

/** ตัดเส้นตรงให้พอดีกรอบ คืน null ถ้าเส้นไม่โผล่ในกรอบเลย */
function clipLine(L: Ln, p: Plot): { ax: number; ay: number; bx: number; by: number } | null {
  const pts: { x: number; y: number }[] = [];
  const push = (x: number, y: number): void => {
    const inX = x >= p.x0 - 1e-9 && x <= p.x1 + 1e-9;
    const inY = y >= p.y0 - 1e-9 && y <= p.y1 + 1e-9;
    if (inX && inY) pts.push({ x, y });
  };
  push(p.x0, lnAt(L, p.x0));
  push(p.x1, lnAt(L, p.x1));
  if (L.m !== 0) {
    push((p.y0 - L.b) / L.m, p.y0);
    push((p.y1 - L.b) / L.m, p.y1);
  }
  if (pts.length < 2) return null;
  pts.sort((a, b) => a.x - b.x);
  const a = pts[0];
  const b = pts[pts.length - 1];
  if (Math.abs(a.x - b.x) < 1e-9) return null;
  return { ax: p.sx(a.x), ay: p.sy(a.y), bx: p.sx(b.x), by: p.sy(b.y) };
}

/** เส้นทางของเปลือกล่างในกรอบ คิดจากจุดตัดของเส้นที่อยู่บนเปลือกเรียงตามความชัน */
function envelopePath(lines: Ln[], p: Plot): string {
  const hull = new LowerHull();
  for (const L of [...lines].sort((a, b) => b.m - a.m || a.b - b.b)) hull.add(L);
  const st = hull.st;
  const xs: number[] = [p.x0];
  for (let t = 0; t + 1 < st.length; t++) {
    const dm = st[t].m - st[t + 1].m;
    if (dm !== 0) xs.push((st[t + 1].b - st[t].b) / dm);
  }
  xs.push(p.x1);
  const pieces: string[] = [];
  for (let t = 0; t < st.length; t++) {
    const a = Math.max(p.x0, xs[t]);
    const b = Math.min(p.x1, xs[t + 1]);
    if (b - a <= 1e-9) continue;
    const ya = lnAt(st[t], a);
    const yb = lnAt(st[t], b);
    pieces.push(`${pieces.length === 0 ? 'M' : 'L'}${p.sx(a).toFixed(1)} ${p.sy(ya).toFixed(1)}`);
    pieces.push(`L${p.sx(b).toFixed(1)} ${p.sy(yb).toFixed(1)}`);
  }
  return pieces.join(' ');
}

/** สีของเส้นแต่ละเส้น วนซ้ำได้ถ้าเส้นเยอะกว่าสี */
const LINE_COLORS = ['#4ade80', '#e0b400', '#7dd3fc', '#f472b6', '#c084fc', '#fb923c'];
const colorOf = (t: number): string => LINE_COLORS[t % LINE_COLORS.length];

/* ---------- ภาพที่ 2: เปลือกล่างของชุดที่ 3 ในเกม ---------- */
const HULL_SET = gamePuzzles[2].lines;
const hullUseless = new Set(gamePuzzles[2].useless);
