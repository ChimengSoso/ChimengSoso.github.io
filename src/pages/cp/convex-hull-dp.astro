---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { texCode, mc } from '../../lib/math';

const href = 'convex-hull-dp/';

/* ============================================================================
   ตัวเลขทุกตัวในหน้านี้งอกจากโมเดลข้างล่าง ไม่มีเลขไหนพิมพ์ด้วยมือ
   ยกเว้นเวลาที่วัดจากการรันจริง ซึ่งเป็นผลการวัด ไม่ใช่ผลการคำนวณ
   และมี throw กันไว้ทุกข้ออ้าง ถ้าข้ออ้างไหนไม่จริง หน้านี้จะบิลด์ไม่ผ่านเลย
   ========================================================================== */

const INF = Number.POSITIVE_INFINITY;

/** เส้นตรง y = m*x + b */
type Ln = { m: number; b: number };
const lnAt = (L: Ln, x: number): number => L.m * x + L.b;

/** ความจริงที่ทุกอย่างต้องตรงกับมัน คือไล่ดูทุกเส้นทุกครั้ง ไม่มีเปลือก ไม่มีตัวชี้ */
const naiveMin = (lines: Ln[], x: number): number =>
  lines.reduce((best, L) => Math.min(best, lnAt(L, x)), INF);

/* ---------------------------------------------------------------------------
   ตัวตรวจอิสระ: เส้นไหนอยู่บนเปลือกล่างจริง โดยไม่สร้างเปลือกเลย

   เหตุผลที่ต้องอิสระ: ทั้งบทนี้กำลังจะอ้างว่า "เส้นที่ถูกเปลือกทิ้ง คือเส้นที่ไม่มีวันชนะ"
   ถ้าตัวตรวจสร้างเปลือกด้วยวิธีเดียวกัน มันก็แค่ตรวจว่าพิมพ์โค้ดถูก ไม่ได้ตรวจข้ออ้าง

   วิธีที่ใช้: ลำดับของค่าทุกเส้นเปลี่ยนได้เฉพาะที่จุดตัดของเส้นคู่ใดคู่หนึ่ง
   จึงเก็บจุดตัดทุกคู่เป็นเศษส่วนแท้ ๆ แล้วทดสอบที่ตัวจุดตัดเอง ที่กลางช่วงระหว่างจุดตัด
   และที่ปลายซ้าย/ขวานอกจุดตัดทั้งหมด เทียบด้วยการคูณไขว้ ไม่แตะทศนิยมเลย
   เส้นไหน "เคยเป็นตัวที่ต่ำที่สุดเพียงตัวเดียว" ที่จุดทดสอบใดก็ตาม คือเส้นที่มีประโยชน์
   --------------------------------------------------------------------------- */
type Frac = { p: number; q: number };
const fracCmp = (a: Frac, b: Frac): number => a.p * b.q - b.p * a.q;
/** ค่าของเส้นที่ x = p/q คูณด้วย q ไว้ เทียบกันได้เพราะ q เท่ากันและเป็นบวก */
const lnAtFrac = (L: Ln, f: Frac): number => L.m * f.p + L.b * f.q;

function usefulByRationalScan(lines: Ln[]): boolean[] {
  const cuts: Frac[] = [];
  for (let i = 0; i < lines.length; i++) {
    for (let j = i + 1; j < lines.length; j++) {
      const dm = lines[i].m - lines[j].m;
      if (dm === 0) continue;
      const q = dm > 0 ? dm : -dm;
      const p = dm > 0 ? lines[j].b - lines[i].b : lines[i].b - lines[j].b;
      cuts.push({ p, q });
    }
  }
  cuts.sort(fracCmp);
  const tests: Frac[] = [];
  if (cuts.length === 0) {
    tests.push({ p: 0, q: 1 });
  } else {
    tests.push({ p: cuts[0].p - cuts[0].q, q: cuts[0].q });
    for (let t = 0; t < cuts.length; t++) {
      tests.push(cuts[t]);
      const nx = t + 1 < cuts.length ? cuts[t + 1] : null;
      if (nx !== null && fracCmp(cuts[t], nx) !== 0) {
        tests.push({ p: cuts[t].p * nx.q + nx.p * cuts[t].q, q: 2 * cuts[t].q * nx.q });
      }
    }
    const last = cuts[cuts.length - 1];
    tests.push({ p: last.p + last.q, q: last.q });
  }
  const useful = lines.map(() => false);
  for (const f of tests) {
    const vals = lines.map((L) => lnAtFrac(L, f));
    const lo = Math.min(...vals);
    const winners = vals.reduce((acc: number[], v, idx) => (v === lo ? [...acc, idx] : acc), []);
    if (winners.length === 1) useful[winners[0]] = true;
  }
  return useful;
}

/* ---------------------------------------------------------------------------
   เปลือกล่างแบบสแต็กกับตัวชี้ คือท่าที่บทนี้สอน (ระดับ 1)
   ใช้ได้เมื่อความชันใส่เข้ามาแบบลดลง และตำแหน่งที่ถามเรียงเพิ่มขึ้น
   --------------------------------------------------------------------------- */
type HullEvent = { kind: 'pop' | 'push' | 'skip'; line: Ln };

class LowerHull {
  st: Ln[] = [];
  ptr = 0;
  lastEvents: HullEvent[] = [];

  /** เส้นกลาง b ไม่จำเป็น ถ้าจุดตัดของ a กับเส้นใหม่ c อยู่ซ้ายกว่าหรือตรงกับจุดตัดของ a กับ b */
  static useless(a: Ln, b: Ln, c: Ln): boolean {
    return (c.b - a.b) * (a.m - b.m) <= (b.b - a.b) * (a.m - c.m);
  }
  private clampPtr(): void {
    if (this.ptr >= this.st.length) this.ptr = this.st.length - 1;
    if (this.ptr < 0) this.ptr = 0;
  }
  add(L: Ln): void {
    this.lastEvents = [];
    if (this.st.length > 0 && this.st[this.st.length - 1].m === L.m) {
      if (this.st[this.st.length - 1].b <= L.b) {
        this.lastEvents.push({ kind: 'skip', line: L });
        return;
      }
      this.lastEvents.push({ kind: 'pop', line: this.st[this.st.length - 1] });
      this.st.pop();
    }
    while (this.st.length >= 2 && LowerHull.useless(this.st[this.st.length - 2], this.st[this.st.length - 1], L)) {
      this.lastEvents.push({ kind: 'pop', line: this.st[this.st.length - 1] });
      this.st.pop();
    }
    this.st.push(L);
    this.lastEvents.push({ kind: 'push', line: L });
    this.clampPtr();
  }
  /** ถามค่าน้อยสุดที่ x โดยให้ตัวชี้เดินไปข้างหน้าทางเดียว */
  query(x: number): number {
    this.clampPtr();
    while (this.ptr + 1 < this.st.length && lnAt(this.st[this.ptr + 1], x) <= lnAt(this.st[this.ptr], x)) this.ptr++;
    return lnAt(this.st[this.ptr], x);
  }
  /** ถามแบบไม่ใช้ตัวชี้ ใช้ตอนตำแหน่งที่ถามไม่เรียง (ระดับ 2 ย่อ ๆ) */
  queryScan(x: number): number {
    return naiveMin(this.st, x);
  }
}

/* ============================================================================
   โจทย์ที่บทนี้เดินให้ดูทั้งบท: ทางเดินมีหลังคา (Covered Walkway)
   จุดที่ต้องคลุมเรียงอยู่บนเส้นตรง หลังคาหนึ่งผืนคลุมจาก x ถึง y ราคา c + (x-y)^2
   ========================================================================== */

const RUN_C = 5000;
const RUN_X = [1, 23, 45, 67, 101, 124, 560, 789, 990, 1019];
const RN = RUN_X.length;

type WalkResult = { dp: number[]; cut: number[]; scans: number };

/** ไล่ทุกจุดตัดทุกครั้ง O(n^2) นี่คือความจริง */
function walkNaive(x: number[], c: number): WalkResult {
  const n = x.length;
  const dp = Array<number>(n + 1).fill(INF);
  const cut = Array<number>(n + 1).fill(0);
  let scans = 0;
  dp[0] = 0;
  for (let i = 1; i <= n; i++) {
    for (let j = 0; j < i; j++) {
      scans++;
      const d = x[i - 1] - x[j];
      const v = dp[j] + c + d * d;
      if (v < dp[i]) {
        dp[i] = v;
        cut[i] = j;
      }
    }
  }
  return { dp, cut, scans };
}

/** ท่าเดียวกัน แต่ยัดทางเลือกทุกทางเป็นเส้นตรงแล้วถามเปลือกล่าง O(n) */
function walkHull(x: number[], c: number): { dp: number[]; probes: number } {
  const n = x.length;
  const dp = Array<number>(n + 1).fill(0);
  const h = new LowerHull();
  let probes = 0;
  for (let i = 1; i <= n; i++) {
    const j = i - 1;
    h.add({ m: -2 * x[j], b: dp[j] + x[j] * x[j] });
    probes++;
    dp[i] = h.query(x[i - 1]) + x[i - 1] * x[i - 1] + c;
  }
  return { dp, probes };
}

const runNaive = walkNaive(RUN_X, RUN_C);
const runHull = walkHull(RUN_X, RUN_C);
const runAnswer = runNaive.dp[RN];
if (runHull.dp[RN] !== runAnswer) {
  throw new Error(
    `convex-hull-dp: ทางเดินตัวอย่างตอบไม่ตรงกัน ไล่ทุกเส้น ${runAnswer} เปลือกนูน ${runHull.dp[RN]}`,
  );
}
if (runAnswer !== 30726) {
  throw new Error(`convex-hull-dp: ตัวอย่างของโจทย์ต้นทางตอบ 30726 แต่โมเดลได้ ${runAnswer}`);
}

/** หลังคาแต่ละผืนของคำตอบที่ดีที่สุด อ่านย้อนจากตาราง cut */
type Roof = { from: number; to: number; span: number; price: number };
const runRoofs: Roof[] = (() => {
  const out: Roof[] = [];
  let i = RN;
  while (i > 0) {
    const j = runNaive.cut[i];
    const span = RUN_X[i - 1] - RUN_X[j];
    out.push({ from: RUN_X[j], to: RUN_X[i - 1], span, price: RUN_C + span * span });
    i = j;
  }
  out.reverse();
  return out;
})();
const runRoofTotal = runRoofs.reduce((s, r) => s + r.price, 0);
if (runRoofTotal !== runAnswer) throw new Error('convex-hull-dp: หลังคาที่วาดรวมได้ไม่ตรงคำตอบ');
/** ผืนที่แพงที่สุดกับผืนที่คลุมจุดเดียว ใช้เขียนคำอธิบายภาพโดยไม่ต้องพิมพ์เลขมือ */
const runWidest = runRoofs.reduce((best, r) => (r.span > best.span ? r : best));
const runSingles = runRoofs.filter((r) => r.span === 0).length;

/** ถ้าคลุมทุกจุดด้วยผืนเดียว กับถ้าคลุมจุดละผืน สองอย่างนี้แพงกว่าคำตอบจริงทั้งคู่ */
const runOneRoof = RUN_C + (RUN_X[RN - 1] - RUN_X[0]) ** 2;
const runAllSingles = RUN_C * RN;
if (runOneRoof <= runAnswer || runAllSingles <= runAnswer) {
  throw new Error('convex-hull-dp: สองทางสุดขั้วควรแพงกว่าคำตอบจริงทั้งคู่');
}

/* ---------- เส้นตรงของแต่ละทางเลือกในรอบที่เอาไปวาดภาพ ----------
   เลือกรอบที่มีเส้นในสแต็กมากที่สุด จะได้เห็นเปลือกเป็นรูปเป็นร่าง */
type PickRound = { i: number; x: number; stack: Ln[]; all: Ln[]; useful: boolean[] };
const runRounds: PickRound[] = (() => {
  const out: PickRound[] = [];
  const dp = Array<number>(RN + 1).fill(0);
  const h = new LowerHull();
  const all: Ln[] = [];
  for (let i = 1; i <= RN; i++) {
    const j = i - 1;
    const L = { m: -2 * RUN_X[j], b: dp[j] + RUN_X[j] * RUN_X[j] };
    h.add(L);
    all.push(L);
    dp[i] = h.query(RUN_X[i - 1]) + RUN_X[i - 1] * RUN_X[i - 1] + RUN_C;
    out.push({ i, x: RUN_X[i - 1], stack: [...h.st], all: [...all], useful: usefulByRationalScan([...all]) });
  }
  return out;
})();
/** ทุกรอบ เส้นที่เปลือกทิ้งต้องเป็นเส้นที่ตัวตรวจอิสระบอกว่าไม่มีวันชนะจริง */
for (const rd of runRounds) {
  const kept = new Set(rd.stack.map((L) => L.m + ':' + L.b));
  for (let t = 0; t < rd.all.length; t++) {
    const inStack = kept.has(rd.all[t].m + ':' + rd.all[t].b);
    if (!inStack && rd.useful[t]) {
      throw new Error(`convex-hull-dp: รอบที่ ${rd.i} เปลือกทิ้งเส้นที่ยังมีประโยชน์`);
    }
  }
}

/* ---------- สเต็ปของเครื่องเดิน: เติม dp ของทางเดินมีหลังคาทีละจุด ---------- */
type RowStep = { note: string };
type BoardRow = {
  i: number;
  x: number;
  added: string;
  dropped: string;
  stackSize: number;
  ptrSlope: string;
  dp: number;
};
const boardRows: BoardRow[] = [];
const rowSteps: RowStep[] = [];
{
  const dp = Array<number>(RN + 1).fill(0);
  const h = new LowerHull();
  for (let i = 1; i <= RN; i++) {
    const j = i - 1;
    const L: Ln = { m: -2 * RUN_X[j], b: dp[j] + RUN_X[j] * RUN_X[j] };
    h.add(L);
    const popped = h.lastEvents.filter((e) => e.kind === 'pop');
    const skipped = h.lastEvents.some((e) => e.kind === 'skip');
    const before = h.ptr;
    dp[i] = h.query(RUN_X[i - 1]) + RUN_X[i - 1] * RUN_X[i - 1] + RUN_C;
    const moved = h.ptr - before;
    const chosen = h.st[h.ptr];
    boardRows.push({
      i,
      x: RUN_X[i - 1],
      added: skipped ? 'ไม่ใส่' : `${L.m}x ${L.b >= 0 ? '+' : '-'} ${Math.abs(L.b)}`,
      dropped: popped.length === 0 ? '' : String(popped.length),
      stackSize: h.st.length,
      ptrSlope: String(chosen.m),
      dp: dp[i],
    });
    const dropText =
      popped.length === 0
        ? 'ไม่มีเส้นไหนถูกทิ้ง'
        : `เส้นเก่า <em>${popped.length}</em> เส้นถูกทิ้ง เพราะเส้นใหม่ตัดหน้าไปก่อนที่เส้นพวกนั้นจะได้ชนะ`;
    const moveText =
      moved === 0
        ? 'ตัวชี้อยู่ที่เดิม เส้นที่ชนะรอบก่อนยังชนะอยู่'
        : `ตัวชี้เดินไปข้างหน้า <em>${moved}</em> ช่อง`;
    rowSteps.push({
      note:
        `จุดที่ต้องคลุมคือ <b>x = ${RUN_X[i - 1]}</b> ก่อนถาม ต้องใส่เส้นของทางเลือก "หลังคาผืนสุดท้ายเริ่มที่จุดที่ ${i}" ` +
        `ซึ่งมีความชัน <b>${L.m}</b> และจุดตัดแกน <b>${L.b}</b> ` +
        dropText +
        ' ' +
        moveText +
        ` เส้นที่ต่ำที่สุดที่ x นี้คือเส้นชัน <b>${chosen.m}</b> จึงได้ <b>dp[${i}] = ${dp[i]}</b>`,
    });
  }
  if (dp[RN] !== runAnswer) throw new Error('convex-hull-dp: เครื่องเดินคิดได้ไม่ตรงคำตอบ');
}
if (rowSteps.length !== boardRows.length) {
  throw new Error('convex-hull-dp: จำนวนก้าวของเครื่องเดินไม่เท่าจำนวนแถวของตาราง');
}

/* ============================================================================
   มินิเกม: เส้นไหนไม่มีวันชนะ
   เฉลยของทุกชุดมาจาก usefulByRationalScan ซึ่งไม่สร้างเปลือกเลย
   แล้วยังเทียบกับเปลือกที่บทนี้สอนอีกชั้นก่อนปล่อยขึ้นหน้า
   ========================================================================== */
type GameSeed = { id: string; label: string; tease: string; lines: Ln[] };
const GAME_SEEDS: GameSeed[] = [
  {
    id: 'g1',
    label: 'ชุดที่ 1 · อุ่นเครื่อง',
    tease: 'สี่เส้น มีเส้นหนึ่งที่ดูออกได้ตั้งแต่ยังไม่ต้องคิด ใช้ชินกับกติกาก่อน',
    lines: [
      { m: -2, b: 0 },
      { m: 0, b: -1 },
      { m: 2, b: 0 },
      { m: 0, b: 6 },
    ],
  },
  {
    id: 'g2',
    label: 'ชุดที่ 2 · ชันเท่ากัน',
    tease: 'ห้าเส้น มีสองคู่ที่ชันเท่ากัน เส้นที่ชันเท่ากันไม่มีวันตัดกัน จึงตัดสินได้ทันที',
    lines: [
      { m: -2, b: 0 },
      { m: -2, b: 5 },
      { m: 1, b: 0 },
      { m: 1, b: 4 },
      { m: 0, b: -1 },
    ],
  },
  {
    id: 'g3',
    label: 'ชุดที่ 3 · เส้นที่ถูกบีบจากสองข้าง',
    tease: 'ห้าเส้น ทุกเส้นดูมีที่ทางของตัวเอง แต่มีหนึ่งเส้นที่ถูกเพื่อนบ้านสองข้างบีบจนไม่เหลือช่วงของตัวเอง',
    lines: [
      { m: -5, b: 40 },
      { m: -3, b: 30 },
      { m: -1, b: 2 },
      { m: 0, b: 0 },
      { m: 2, b: 3 },
    ],
  },
  {
    id: 'g4',
    label: 'ชุดที่ 4 · ชุดที่ไม่มีอะไรให้ทิ้ง',
    tease: 'สี่เส้น ชุดนี้อาจไม่มีเส้นไหนที่ทิ้งได้เลย ถ้าคิดว่าเป็นอย่างนั้นก็กดปุ่มบอกได้',
    lines: [
      { m: -5, b: 40 },
      { m: -1, b: 2 },
      { m: 0, b: 0 },
      { m: 2, b: 3 },
    ],
  },
];

type GamePuzzle = GameSeed & { useless: number[] };
const gamePuzzles: GamePuzzle[] = GAME_SEEDS.map((s) => {
  const useful = usefulByRationalScan(s.lines);
  const useless = useful.reduce((acc: number[], ok, idx) => (ok ? acc : [...acc, idx]), []);
  /* ชั้นที่สอง: เรียงตามความชันจากมากไปน้อยแล้วสร้างเปลือกด้วยท่าที่บทนี้สอน
     เส้นที่เหลือในสแต็กต้องเป็นชุดเดียวกับเส้นที่ตัวตรวจอิสระบอกว่ามีประโยชน์ */
  const sorted = [...s.lines].sort((a, b) => b.m - a.m || a.b - b.b);
  const h = new LowerHull();
  for (const L of sorted) h.add(L);
  const keptKeys = new Set(h.st.map((L) => L.m + ':' + L.b));
  const usefulKeys = new Set(s.lines.filter((_, t) => useful[t]).map((L) => L.m + ':' + L.b));
  const same =
    keptKeys.size === usefulKeys.size && [...keptKeys].every((k) => usefulKeys.has(k));
  if (!same) {
    throw new Error(
      `มินิเกมของ convex-hull-dp: ชุด ${s.id} เปลือกเก็บ {${[...keptKeys].join(' ')}} แต่ตัวตรวจอิสระบอกว่ามีประโยชน์คือ {${[...usefulKeys].join(' ')}}`,
    );
  }
  return { ...s, useless };
});
/** ชุดที่ 4 ต้องไม่มีเส้นที่ทิ้งได้เลย ไม่งั้นปุ่ม "ทุกเส้นใช้ได้" กลายเป็นคำตอบผิด */
if (gamePuzzles[3].useless.length !== 0) {
  throw new Error('convex-hull-dp: ชุดที่ 4 ควรไม่มีเส้นที่ทิ้งได้ แต่มี');
}
/** อีกสามชุดต้องมีของให้ทิ้งจริง ไม่งั้นเกมสอนไม่ได้ */
for (let t = 0; t < 3; t++) {
  if (gamePuzzles[t].useless.length === 0) {
    throw new Error(`convex-hull-dp: ชุดที่ ${t + 1} ควรมีเส้นที่ทิ้งได้ แต่ไม่มี`);
  }
}
const gameJson = JSON.stringify(
  gamePuzzles.map((p) => ({ id: p.id, label: p.label, tease: p.tease, lines: p.lines, useless: p.useless })),
