   เพราะการเปิดโปรเซสใหม่ต่อหนึ่งเคสแพงกว่าการคิดเคสนั้นหลายสิบเท่า */
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

struct Line { ll m, b; };
static inline ll lineAt(const Line &L, ll x) { return L.m * x + L.b; }

struct Hull {
  vector<Line> st;
  int ptr = 0;
  static bool useless(const Line &a, const Line &b, const Line &c) {
    return (__int128)(c.b - a.b) * (a.m - b.m) <= (__int128)(b.b - a.b) * (a.m - c.m);
  }
  void clampPtr() {
    if (ptr >= (int)st.size()) ptr = (int)st.size() - 1;
    if (ptr < 0) ptr = 0;
  }
  void add(Line L) {
    if (!st.empty() && st.back().m == L.m) {
      if (st.back().b <= L.b) return;
      st.pop_back();
    }
    while (st.size() >= 2 && useless(st[st.size() - 2], st.back(), L)) st.pop_back();
    st.push_back(L);
    clampPtr();
  }
  ll query(ll x) {
    clampPtr();
    while (ptr + 1 < (int)st.size() && lineAt(st[ptr + 1], x) <= lineAt(st[ptr], x)) ptr++;
    return lineAt(st[ptr], x);
  }
};

ll byHull(const vector<ll> &x, ll c) {
  int n = (int)x.size();
  vector<ll> dp(n + 1, 0);
  Hull h;
  for (int i = 1; i <= n; i++) {
    int j = i - 1;
    h.add({-2 * x[j], dp[j] + x[j] * x[j]});
    dp[i] = h.query(x[i - 1]) + x[i - 1] * x[i - 1] + c;
  }
  return dp[n];
}

ll byEveryChoice(const vector<ll> &x, ll c) {
  int n = (int)x.size();
  vector<ll> dp(n + 1, LLONG_MAX);
  dp[0] = 0;
  for (int i = 1; i <= n; i++)
    for (int j = 0; j < i; j++) {
      ll d = x[i - 1] - x[j];
      ll v = dp[j] + c + d * d;
      if (v < dp[i]) dp[i] = v;
    }
  return dp[n];
}

int main() {
