})();

/* ---------- ภาพที่ 3: เส้นที่ถูกบีบจากสองข้าง ---------- */
const squeezeIdx = gamePuzzles[2].useless[0];
const squeezeLine = HULL_SET[squeezeIdx];
/** เพื่อนบ้านสองข้างที่บีบมันไว้ คือเส้นบนเปลือกที่ชันมากกว่าและน้อยกว่าที่ใกล้ที่สุด */
const squeezeHi = hullOrder.filter((L) => L.m > squeezeLine.m).reduce((a, b) => (a.m < b.m ? a : b));
const squeezeLo = hullOrder.filter((L) => L.m < squeezeLine.m).reduce((a, b) => (a.m > b.m ? a : b));
/** จุดตัดของเส้นที่ถูกทิ้งกับเพื่อนบ้านแต่ละข้าง เขียนเป็นเศษส่วนไว้เลี่ยงทศนิยมในเนื้อหา */
const sqCutHi = (squeezeHi.b - squeezeLine.b) / (squeezeLine.m - squeezeHi.m);
const sqCutLo = (squeezeLo.b - squeezeLine.b) / (squeezeLine.m - squeezeLo.m);
const sqNeighboursCross = (squeezeLo.b - squeezeHi.b) / (squeezeHi.m - squeezeLo.m);
/** ข้ออ้างของภาพนี้: จุดตัดของเพื่อนบ้านสองข้างอยู่ต่ำกว่าเส้นที่ถูกทิ้งตรงตำแหน่งนั้น */
const sqCrossY = lnAt(squeezeHi, sqNeighboursCross);
const sqDeadY = lnAt(squeezeLine, sqNeighboursCross);
if (sqCrossY >= sqDeadY) {
  throw new Error('convex-hull-dp: ภาพเส้นที่ถูกบีบ จุดตัดของเพื่อนบ้านควรอยู่ต่ำกว่าเส้นที่ถูกทิ้ง');
}
const P3 = makePlot(-6, 12, -14, 42, 560, 290);
const p3Trio = [squeezeHi, squeezeLine, squeezeLo].map((L, t) => ({ t, L, seg: clipLine(L, P3) }));
const P3_BOT = P3.padT + P3.h;
const p3VB = `0 0 ${P3.padL + P3.w + 62 + 24} ${P3_BOT + 40 + 34}`;

/* ---------- ภาพที่ 1: ทางเดินกับหลังคาที่ถูกที่สุด ---------- */
const D1_X0 = 26;
const D1_W = 620;
const d1x = (pos: number): number => D1_X0 + ((pos - RUN_X[0]) / (RUN_X[RN - 1] - RUN_X[0])) * D1_W;
const D1_ROW_Y = 92;
const D1_ROW_H = 32;
const d1Bottom = D1_ROW_Y + runRoofs.length * D1_ROW_H + 22;
const D1_LBL = 104;   /* วัดจากที่เรนเดอร์จริง ป้ายท้ายแถบยาวถึง x=750 */
const d1VB = `0 0 ${D1_X0 + D1_W + D1_LBL + 12} ${d1Bottom + 34}`;

/* ---------- ภาพที่ 4: ต้นไม้ลีเชา เก็บเส้นหนึ่งเส้นต่อหนึ่งปม ---------- */
const LC_LO = 0;
const LC_HI = 7;
type LcNode = { l: number; r: number; line: Ln | null; depth: number; pos: number };
const lcNodes: LcNode[] = [];
const LC_LINES: Ln[] = [
  { m: 3, b: 2 },
  { m: -2, b: 20 },
  { m: 0, b: 7 },
  { m: 1, b: 1 },
];
{
  /* ต้นไม้เต็มรูป สร้างทุกปมไว้ก่อนเพื่อวาดง่าย แล้วค่อยหย่อนเส้นลงไปตามกติกาของลีเชา */
  const idx = new Map<string, number>();
  const build = (l: number, r: number, depth: number, pos: number): void => {
    idx.set(l + ':' + r, lcNodes.length);
    lcNodes.push({ l, r, line: null, depth, pos });
    if (l === r) return;
    const mid = l + Math.floor((r - l) / 2);
    build(l, mid, depth + 1, pos * 2);
    build(mid + 1, r, depth + 1, pos * 2 + 1);
  };
  build(LC_LO, LC_HI, 0, 0);
  const put = (l: number, r: number, nw: Ln): void => {
    const at = idx.get(l + ':' + r);
    if (at === undefined) return;
    const node = lcNodes[at];
    let cur = node.line;
    let add = nw;
    if (cur === null) {
      node.line = add;
      return;
    }
    const mid = l + Math.floor((r - l) / 2);
    const leftBetter = lnAt(add, l) < lnAt(cur, l);
    const midBetter = lnAt(add, mid) < lnAt(cur, mid);
    if (midBetter) {
      const swap = cur;
      cur = add;
      add = swap;
      node.line = cur;
    }
    if (l === r) return;
    if (leftBetter !== midBetter) put(l, mid, add);
    else put(mid + 1, r, add);
  };
  for (const L of LC_LINES) put(LC_LO, LC_HI, L);
}
/** เดินรากถึงใบที่ตำแหน่งนี้ ต้องเจอเส้นที่ต่ำที่สุดจริงระหว่างทาง */
const LC_Q = 5;
const lcPath: LcNode[] = (() => {
  const out: LcNode[] = [];
  let l = LC_LO;
  let r = LC_HI;
  for (;;) {
    const node = lcNodes.find((nd) => nd.l === l && nd.r === r);
    if (node === undefined) break;
    out.push(node);
    if (l === r) break;
    const mid = l + Math.floor((r - l) / 2);
    if (LC_Q <= mid) r = mid;
    else l = mid + 1;
  }
  return out;
})();
const lcBest = lcPath.reduce(
  (best, nd) => (nd.line === null ? best : Math.min(best, lnAt(nd.line, LC_Q))),
  INF,
);
const lcTruth = naiveMin(LC_LINES, LC_Q);
if (lcBest !== lcTruth) {
  throw new Error(`convex-hull-dp: ต้นไม้ลีเชาในภาพตอบ ${lcBest} แต่ความจริงคือ ${lcTruth}`);
}
const LC_DEPTH = Math.max(...lcNodes.map((nd) => nd.depth));
const LC_BW = 74;
const LC_BH = 34;
const LC_GAPY = 62;
const lcLeaves = 1 << LC_DEPTH;
const lcx = (nd: LcNode): number => {
  const span = lcLeaves >> nd.depth;
  return 20 + (nd.pos * span + span / 2) * (LC_BW + 6) - LC_BW / 2;
};
const lcy = (nd: LcNode): number => 34 + nd.depth * LC_GAPY;
const lcPathKeys = new Set(lcPath.map((nd) => nd.l + ':' + nd.r));
const lcRight = Math.max(...lcNodes.map((nd) => lcx(nd) + LC_BW));
const lcBottom = lcy(lcNodes[lcNodes.length - 1]) + LC_BH + 26;
const lcVB = `0 0 ${lcRight + 12} ${lcBottom + 34}`;
const lcEdges = lcNodes
  .filter((nd) => nd.depth > 0)
  .map((nd) => {
    const span = (lcLeaves >> nd.depth) * 2;
    const pl = Math.floor(nd.pos / 2);
    const parent = lcNodes.find((p) => p.depth === nd.depth - 1 && p.pos === pl);
    return { from: parent, to: nd, span };
  })
  .filter((e): e is { from: LcNode; to: LcNode; span: number } => e.from !== undefined);

/* ============================================================================
   ตัวอย่างของโจทย์ฝึกแต่ละข้อ ทุกตัวเลขคิดที่นี่ ไม่มีเลขไหนพิมพ์ด้วยมือ
   ========================================================================== */

/* ---------- ฝึกข้อ 2: โค่นต้นไม้ (CF 319C) ใช้ตัวอย่างที่สองของโจทย์ ---------- */
const P2_A = [1, 2, 3, 10, 20, 30];
const P2_B = [6, 5, 4, 3, 2, 0];
const P2_N = P2_A.length;
type TreeRow = { i: number; dp: number; from: number; charge: number; hits: number };
const p2Rows: TreeRow[] = (() => {
  const dp = Array<number>(P2_N + 1).fill(INF);
  const from = Array<number>(P2_N + 1).fill(0);
  dp[1] = 0;
  for (let i = 2; i <= P2_N; i++) {
    for (let j = 1; j < i; j++) {
      const v = dp[j] + P2_B[j - 1] * P2_A[i - 1];
      if (v < dp[i]) {
        dp[i] = v;
        from[i] = j;
      }
    }
  }
  const out: TreeRow[] = [];
  for (let i = 1; i <= P2_N; i++) {
    out.push({
      i,
      dp: dp[i],
      from: from[i],
      charge: i === 1 ? 0 : P2_B[from[i] - 1],
      hits: P2_A[i - 1],
    });
  }
  return out;
})();
const p2Answer = p2Rows[P2_N - 1].dp;
if (p2Answer !== 138) {
  throw new Error(`convex-hull-dp: ตัวอย่างของฝึกข้อ 2 ต้องได้ 138 แต่โมเดลได้ ${p2Answer}`);
}
/** ตรวจด้วยเปลือกล่างอีกชั้น ความชัน b เรียงลดลง ตำแหน่งถาม a เรียงเพิ่มขึ้น จึงใช้ท่าระดับ 1 ได้ */
{
  const dp = Array<number>(P2_N + 1).fill(0);
  const h = new LowerHull();
  h.add({ m: P2_B[0], b: 0 });
  for (let i = 2; i <= P2_N; i++) {
    dp[i] = h.query(P2_A[i - 1]);
    h.add({ m: P2_B[i - 1], b: dp[i] });
  }
  if (dp[P2_N] !== p2Answer) throw new Error('convex-hull-dp: ฝึกข้อ 2 เปลือกล่างตอบไม่ตรงกับการไล่ทุกเส้น');
}
/** กฎที่คนคิดออกก่อนเสมอ คือโค่นต้นถัดไปเรื่อย ๆ ตามลำดับ ไม่ข้ามต้นไหน */
const p2StepByStep = (() => {
  let sum = 0;
  for (let i = 2; i <= P2_N; i++) sum += P2_B[i - 2] * P2_A[i - 1];
  return sum;
})();
if (p2StepByStep <= p2Answer) {
  throw new Error(`convex-hull-dp: ฝึกข้อ 2 กฎโค่นเรียงต้นควรแพ้ แต่ได้ ${p2StepByStep} ส่วนคำตอบจริง ${p2Answer}`);
}
/** ต้นที่คำตอบเลือกโค่นจริง อ่านย้อนจากตาราง from */
const p2Chain = (() => {
  const out: number[] = [];
  let i = P2_N;
  while (i >= 1) {
    out.push(i);
    if (i === 1) break;
    i = p2Rows[i - 1].from;
  }
  out.reverse();
  return out;
})();
const p2ChainCost = (() => {
  let sum = 0;
  for (let t = 1; t < p2Chain.length; t++) {
    sum += P2_B[p2Chain[t - 1] - 1] * P2_A[p2Chain[t] - 1];
  }
  return sum;
})();
if (p2ChainCost !== p2Answer) throw new Error('convex-hull-dp: ลำดับโค่นของฝึกข้อ 2 รวมได้ไม่ตรงคำตอบ');

/* ---------- ฝึกข้อ 3: สี่เหลี่ยมของนัท (CF 1083E) ใช้ตัวอย่างแรกของโจทย์ ---------- */
type Rect = { x: number; y: number; a: number };
const P3_RECTS: Rect[] = [
  { x: 4, y: 4, a: 8 },
  { x: 1, y: 5, a: 0 },
  { x: 5, y: 2, a: 10 },
];
const p3Sorted = [...P3_RECTS].sort((r, s) => r.x - s.x);
const P3_N = p3Sorted.length;
type RectRow = { t: number; r: Rect; own: number; f: number; from: number };
const p3Rows: RectRow[] = (() => {
  const f = Array<number>(P3_N + 1).fill(0);
  const from = Array<number>(P3_N + 1).fill(0);
  const out: RectRow[] = [];
  for (let i = 1; i <= P3_N; i++) {
    const r = p3Sorted[i - 1];
    let best = 0;
    let bj = 0;
    for (let j = 1; j < i; j++) {
      const v = f[j] - p3Sorted[j - 1].x * r.y;
      if (v > best) {
        best = v;
        bj = j;
      }
    }
    f[i] = r.x * r.y - r.a + best;
    from[i] = bj;
    out.push({ t: i, r, own: r.x * r.y - r.a, f: f[i], from: bj });
  }
  return out;
})();
const p3Answer = Math.max(0, ...p3Rows.map((row) => row.f));
if (p3Answer !== 9) {
  throw new Error(`convex-hull-dp: ตัวอย่างของฝึกข้อ 3 ต้องได้ 9 แต่โมเดลได้ ${p3Answer}`);
}
/** ตรวจอิสระ: ไล่ทุกสับเซตแล้วคิดพื้นที่ยูเนียนจากนิยาม ไม่ใช้ดีพีเลย */
const p3BySubset = (() => {
  let best = 0;
  for (let mask = 1; mask < 1 << P3_N; mask++) {
    const pick = p3Sorted.filter((_, t) => (mask >> t) & 1);
    const cuts = [...new Set(pick.map((r) => r.x))].sort((a, b) => a - b);
    let area = 0;
    let prev = 0;
    for (const cut of cuts) {
      const top = pick.reduce((mx, r) => (r.x >= cut ? Math.max(mx, r.y) : mx), 0);
      area += (cut - prev) * top;
      prev = cut;
    }
    best = Math.max(best, area - pick.reduce((s, r) => s + r.a, 0));
  }
  return best;
})();
if (p3BySubset !== p3Answer) {
  throw new Error(`convex-hull-dp: ฝึกข้อ 3 ไล่ทุกสับเซตได้ ${p3BySubset} แต่ดีพีได้ ${p3Answer}`);
}
/** รูปที่คำตอบเลือกจริง กับขั้นบันไดของยูเนียน ใช้วาดภาพ */
const p3BestIdx = p3Rows.reduce((best, row) => (row.f > best.f ? row : best)).t;
const p3Chosen = (() => {
  const out: number[] = [];
  let i = p3BestIdx;
  while (i >= 1) {
    out.push(i);
    i = p3Rows[i - 1].from;
  }
  out.reverse();
  return out;
})();
const p3Steps = p3Chosen.map((i, t) => {
  const r = p3Sorted[i - 1];
  const prevX = t === 0 ? 0 : p3Sorted[p3Chosen[t - 1] - 1].x;
  return { i, r, prevX, band: (r.x - prevX) * r.y };
});
const p3Area = p3Steps.reduce((s, st) => s + st.band, 0);
const p3Cost = p3Chosen.reduce((s, i) => s + p3Sorted[i - 1].a, 0);
if (p3Area - p3Cost !== p3Answer) {
  throw new Error('convex-hull-dp: ขั้นบันไดของฝึกข้อ 3 รวมได้ไม่ตรงคำตอบ');
}

/* ---------- ฝึกข้อ 4: กระโดดลงใบ (CF 932F) ใช้ตัวอย่างที่สองของโจทย์ ---------- */
const P4_A = [5, -10, 5, 7];
const P4_B = [-8, -80, -3, -10];
const P4_EDGES: [number, number][] = [
  [2, 1],
  [2, 4],
  [1, 3],
];
const P4_N = P4_A.length;
type JumpNode = { u: number; par: number; kids: number[]; depth: number; dp: number; via: number };
const p4Nodes: JumpNode[] = (() => {
  const adj: number[][] = Array.from({ length: P4_N + 1 }, () => []);
  for (const [u, v] of P4_EDGES) {
    adj[u].push(v);
    adj[v].push(u);
  }
  const par = Array<number>(P4_N + 1).fill(0);
  const depth = Array<number>(P4_N + 1).fill(0);
  const order: number[] = [];
  par[1] = -1;
  const stack = [1];
  while (stack.length > 0) {
    const u = stack.pop();
    if (u === undefined) break;
    order.push(u);
    for (const v of adj[u]) {
      if (v === par[u]) continue;
      par[v] = u;
      depth[v] = depth[u] + 1;
      stack.push(v);
    }
  }
  const kids: number[][] = Array.from({ length: P4_N + 1 }, () => []);
  for (let u = 1; u <= P4_N; u++) if (par[u] > 0) kids[par[u]].push(u);
  /** ปมทุกตัวในต้นย่อยของ u คิดจากล่างขึ้นบน */
  const sub: number[][] = Array.from({ length: P4_N + 1 }, () => []);
  const dp = Array<number>(P4_N + 1).fill(0);
  const via = Array<number>(P4_N + 1).fill(0);
  for (let t = order.length - 1; t >= 0; t--) {
    const u = order[t];
    sub[u] = [u];
    for (const v of kids[u]) sub[u] = [...sub[u], ...sub[v]];
    let best = INF;
    let bv = 0;
    for (const v of sub[u]) {
      if (v === u) continue;
      const val = P4_A[u - 1] * P4_B[v - 1] + dp[v];
      if (val < best) {
        best = val;
        bv = v;
      }
    }
    dp[u] = best === INF ? 0 : best;
    via[u] = bv;
  }
  const out: JumpNode[] = [];
  for (let u = 1; u <= P4_N; u++) out.push({ u, par: par[u], kids: kids[u], depth: depth[u], dp: dp[u], via: via[u] });
  return out;
})();
const p4Answer = p4Nodes.map((nd) => nd.dp).join(' ');
if (p4Answer !== '-300 100 0 0') {
  throw new Error(`convex-hull-dp: ตัวอย่างของฝึกข้อ 4 ต้องได้ "-300 100 0 0" แต่โมเดลได้ "${p4Answer}"`);
}
/** ความชันของเส้นในข้อนี้คือ b ซึ่งเรียงไม่ได้เลย และตำแหน่งที่ถามคือ a ก็เรียงไม่ได้
    นั่นคือเหตุผลเดียวที่ต้องยกต้นไม้ลีเชามาใช้ ตรวจข้ออ้างนี้ไว้ด้วย */
const p4SlopesSorted = (() => {
  const up = P4_B.every((v, t) => t === 0 || P4_B[t - 1] <= v);
  const down = P4_B.every((v, t) => t === 0 || P4_B[t - 1] >= v);
  return up || down;
})();
if (p4SlopesSorted) {
  throw new Error('convex-hull-dp: ตัวอย่างของฝึกข้อ 4 ควรมีความชันที่เรียงไม่ได้ เพื่อให้เหตุผลของลีเชาชัด');
}
/** เส้นทางกระโดดของปมที่ 1 ในตัวอย่าง ใช้เขียนคำอธิบายภาพ */
const p4Path = (() => {
  const out: { from: number; to: number; price: number }[] = [];
  let u = 1;
  for (;;) {
    const nd = p4Nodes[u - 1];
    if (nd.via === 0) break;
    out.push({ from: u, to: nd.via, price: P4_A[u - 1] * P4_B[nd.via - 1] });
    u = nd.via;
  }
  return out;
})();
const p4PathTotal = p4Path.reduce((s, j) => s + j.price, 0);
if (p4PathTotal !== p4Nodes[0].dp) {
  throw new Error('convex-hull-dp: เส้นทางกระโดดของปมที่ 1 รวมได้ไม่ตรงกับ dp');
}

