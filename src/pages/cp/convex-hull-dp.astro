/* ภาพฝึกข้อ 2: ต้นไม้เรียงตามความสูง กับลำดับการโค่นที่ถูกที่สุด */
const D5_X0 = 40;
const D5_GAP = 96;
const D5_BASE = 210;
const d5x = (i: number): number => D5_X0 + (i - 1) * D5_GAP;
const P2_MAXA = Math.max(...P2_A);
const d5h = (a: number): number => 24 + (a / P2_MAXA) * 130;
const p2ChainSet = new Set(p2Chain);
const d5Bottom = D5_BASE + 40;
const d5VB = `0 0 ${d5x(P2_N) + 60 + 12} ${d5Bottom + 34}`;

/* ภาพฝึกข้อ 3: ยูเนียนของสี่เหลี่ยมมุมศูนย์ เป็นขั้นบันได */
const P3_MAXX = Math.max(...p3Sorted.map((r) => r.x));
const P3_MAXY = Math.max(...p3Sorted.map((r) => r.y));
const D6_X0 = 52;
const D6_W = 380;
const D6_H = 220;
const D6_Y0 = 26;
const d6x = (x: number): number => D6_X0 + (x / P3_MAXX) * D6_W;
const d6y = (y: number): number => D6_Y0 + D6_H - (y / P3_MAXY) * D6_H;
const D6_TXT = D6_X0 + D6_W + 30;
const D6_ROW_H = 28;
const d6Bottom = Math.max(D6_Y0 + D6_H + 34, D6_Y0 + 20 + p3Steps.length * D6_ROW_H + 40);
const d6VB = `0 0 ${D6_TXT + 151} ${d6Bottom + 34}`;   /* 139 คือขอบขวาของข้อความจริง บวกเผื่อ 12 */

/* ภาพฝึกข้อ 4: ต้นไม้กับค่าประจำปม และลูกศรกระโดดของคำตอบ */
const D7_BW = 96;
const D7_BH = 46;
const D7_GAPY = 76;
const p4Slots = (() => {
  /* วางปมตามลำดับที่เดินซ้ายไปขวา ใบได้ช่องของตัวเอง ปมในได้ตำแหน่งกลางของลูก */
  const slot = new Map<number, number>();
  let next = 0;
  const walk = (u: number): number => {
    const nd = p4Nodes[u - 1];
    if (nd.kids.length === 0) {
      const s = next;
      next++;
      slot.set(u, s);
      return s;
    }
    const cs = nd.kids.map(walk);
    const s = (Math.min(...cs) + Math.max(...cs)) / 2;
    slot.set(u, s);
    return s;
  };
  walk(1);
  return slot;
})();
const d7x = (u: number): number => 24 + (p4Slots.get(u) ?? 0) * (D7_BW + 26);
const d7y = (u: number): number => 30 + p4Nodes[u - 1].depth * D7_GAPY;
const P4_MAXDEPTH = Math.max(...p4Nodes.map((nd) => nd.depth));
const d7Right = Math.max(...p4Nodes.map((nd) => d7x(nd.u) + D7_BW));
const d7Bottom = 30 + P4_MAXDEPTH * D7_GAPY + D7_BH + 44;
const d7VB = `0 0 ${d7Right + 84 + 12} ${d7Bottom + 34}`;   /* 84 คือขอบขวาของป้าย "ตอบ N" บวกเผื่อ 12 */
const p4TreeEdges = p4Nodes.filter((nd) => nd.par > 0).map((nd) => ({ from: nd.par, to: nd.u }));
const p4JumpSet = new Set(p4Path.map((j) => j.from + '>' + j.to));

/* ============================================================================
   ตารางวัดเวลา ตัวเลขพวกนี้มาจากการรันจริง ไม่ใช่การประมาณ
   คอมไพล์จากโค้ดที่หน้านี้ปล่อยจริง (ดึงออกจาก dist) ด้วย g++ 11.4 แล้ว -O2 บนอินพุตชุดเดียวกัน จุดสุ่ม 1 ถึง 1e9 และ c = 1e6
   ค่าเปลือกนูนเฉลี่ยจากการรันห้าครั้ง เพราะครั้งเดียวสั้นเกินกว่านาฬิกาจะละเอียดพอ
   ========================================================================== */
type Bench = { n: number; naive: string; hull: string; ratio: string };
const benchRows: Bench[] = [
  { n: 20000, naive: '0.15 s', hull: '0.004 s', ratio: '37 เท่า' },
