<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type Ln = { m: number; b: number };
  type ChtPuzzle = { id: string; label: string; tease: string; lines: Ln[]; useless: number[] };

  function initChtGame(): void {
    const maybeUi = cpGameUi('[data-chtgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as ChtPuzzle[];
    if (puzzles.length === 0) return;

    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-cht-board]'));
    const chips = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-cht-pick]'));
    if (boards.length !== puzzles.length) return;

    let pi = 0;
    /* เส้นที่ผู้เล่นบอกว่าทิ้งได้ แยกเก็บต่อชุด เพื่อให้สลับแท็บไปมาแล้วไม่หาย */
    const picked: Set<number>[] = puzzles.map(() => new Set<number>());

    const pz = (): ChtPuzzle => puzzles[pi];

    function render(): void {
      boards.forEach((bd, t) => bd.setAttribute('data-on', t === pi ? '1' : '0'));
      for (const chip of chips) {
        const raw = chip.dataset.chtPick ?? '';
        const parts = raw.split(':');
        const gi = Number(parts[0]);
        const li = Number(parts[1]);
        chip.classList.toggle('picked', gi === pi && picked[pi].has(li));
      }
      const n = picked[pi].size;
      ui.setScore(
        n === 0 ? 'ยังไม่ได้เลือกเส้นไหน' : 'เลือกไว้ ' + n + ' เส้น จากทั้งหมด ' + pz().lines.length + ' เส้น',
      );
    }

    function describe(idx: number[]): string {
      if (idx.length === 0) return 'ไม่มีเส้นไหนเลย';
      return idx
        .map((t) => {
          const L = pz().lines[t];
          return L.m + 'x' + (L.b >= 0 ? '+' : '-') + Math.abs(L.b);
        })
        .join(' และ ');
    }

    function check(): void {
      const want = new Set(pz().useless);
      const got = picked[pi];
      const missing = pz().useless.filter((t) => !got.has(t));
      const extra = Array.from(got).filter((t) => !want.has(t));
      if (missing.length === 0 && extra.length === 0) {
        ui.setStatus(
          want.size === 0
            ? 'ถูกต้องครับ ชุดนี้ทุกเส้นอยู่บนขอบล่างจริง ไม่มีเส้นไหนทิ้งได้'
            : 'ถูกต้องครับ เส้นที่ทิ้งได้คือ ' + describe(pz().useless) + ' และคุณเลือกครบพอดี',
          'good',
        );
        return;
      }
      if (extra.length > 0) {
        ui.setStatus(
          'ยังไม่ถูกครับ เส้น ' + describe(extra) + ' ทิ้งไม่ได้ มันมีช่วง x ที่มันชนะอยู่ ลองมองไกลออกไปนอกกรอบ',
          'bad',
        );
        return;
      }
      ui.setStatus(
        'ใกล้แล้วครับ ยังเหลือเส้นที่ทิ้งได้อีก ' + missing.length + ' เส้นที่ยังไม่ได้เลือก',
        'bad',
      );
    }

    function selectPuzzle(t: number): void {
      pi = t;
      ui.selectTab(t);
      ui.setTease(pz().tease);
      ui.setStatus('กดชิปของเส้นที่คิดว่าไม่มีวันชนะ แล้วกดตรวจคำตอบ');
      render();
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const raw = chip.dataset.chtPick ?? '';
        const parts = raw.split(':');
        const gi = Number(parts[0]);
        const li = Number(parts[1]);
        if (gi !== pi) return;
        if (picked[pi].has(li)) picked[pi].delete(li);
        else picked[pi].add(li);
        ui.setStatus('เลือกไว้แล้ว กดตรวจคำตอบเมื่อพร้อม');
        render();
      });
    }

    ui.onClick('data-cht-reset', () => {
      picked[pi].clear();
      ui.setStatus('เริ่มใหม่แล้ว กดชิปของเส้นที่คิดว่าไม่มีวันชนะ');
      render();
    });
    ui.onClick('data-cht-none', () => {
      picked[pi].clear();
      render();
      check();
    });
    ui.onClick('data-cht-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initChtGame);
</script>

<script>
  import { initCpRowPlayers } from '../../lib/cpPlayer';

  /* เครื่องเดินของหน้านี้เดินตามแถวของตารางตรง ๆ หนึ่งแถวคือหนึ่งจุดที่ต้องคลุม
     จึงใช้ตัวช่วยแบบแถวได้เลย ไม่ต้องเขียน draw เอง */
  document.addEventListener('astro:page-load', () => {
    initCpRowPlayers('[data-chtsim]');
  });
</script>
