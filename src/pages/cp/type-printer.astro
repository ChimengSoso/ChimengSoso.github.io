        <thead>
          <tr><th>ค้างคำไหนไว้</th><th class="num">ความลึก</th><th class="num">จำนวนคำสั่ง</th></tr>
        </thead>
        <tbody>
          <tr><td><code>{longest}</code> (ยาวที่สุด)</td><td class="num">{longest.length}</td><td class="num">{goodOps.length}</td></tr>
