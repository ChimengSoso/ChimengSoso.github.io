<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type TrPuzzle = {
    id: string;
    label: string;
    tease: string;
    words: string[];
    optimal: number;
    alphabet: string[];
  };

  function initPrinterGame(): void {
    const maybeUi = cpGameUi('[data-tprtgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as TrPuzzle[];
    if (puzzles.length === 0) return;

    const wordsEl = ui.root.querySelector<HTMLElement>('[data-tr-words]');
    const keysEl = ui.root.querySelector<HTMLElement>('[data-tr-keys]');
    const screenEl = ui.root.querySelector<HTMLElement>('[data-tr-screen]');
    const usedEl = ui.root.querySelector<HTMLElement>('[data-tr-used]');
    const optEl = ui.root.querySelector<HTMLElement>('[data-tr-opt]');
    if (!wordsEl || !keysEl || !screenEl || !usedEl || !optEl) return;
    const wordsTable: HTMLElement = wordsEl;
    const keys: HTMLElement = keysEl;
    const screen: HTMLElement = screenEl;
    const usedOut: HTMLElement = usedEl;
    const optOut: HTMLElement = optEl;

    let pi = 0;
    let cur = '';
    let used = 0;
    let printed = new Set<string>();

    const pz = (): TrPuzzle => puzzles[pi];

    function buildWords(): void {
      const p = pz();
      wordsTable.textContent = '';
      const head = document.createElement('tr');
      const th = document.createElement('th');
      th.textContent = 'คำที่ต้องพิมพ์';
      head.appendChild(th);
      for (const w of p.words) {
        const t = document.createElement('th');
        t.textContent = w;
        t.dataset.word = w;
        head.appendChild(t);
      }
      wordsTable.appendChild(head);
      const row = document.createElement('tr');
      const rh = document.createElement('th');
      rh.textContent = 'พิมพ์แล้ว';
      row.appendChild(rh);
      for (const w of p.words) {
        const td = document.createElement('td');
        td.dataset.mark = w;
        td.textContent = 'ยัง';
        row.appendChild(td);
      }
      wordsTable.appendChild(row);

      keys.textContent = '';
      for (const c of p.alphabet) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cpg-btn tr-key';
        b.dataset.letter = c;
        b.textContent = c;
        keys.appendChild(b);
      }
    }

    function render(): void {
      const p = pz();
      screen.textContent = cur === '' ? '(ว่าง)' : cur;
      usedOut.textContent = String(used);
      optOut.textContent = String(p.optimal);
      for (const td of Array.from(wordsTable.querySelectorAll<HTMLElement>('[data-mark]'))) {
        const w = td.dataset.mark ?? '';
        const done = printed.has(w);
        td.textContent = done ? 'พิมพ์แล้ว' : 'ยัง';
        td.classList.toggle('done', done);
      }
      for (const th of Array.from(wordsTable.querySelectorAll<HTMLElement>('[data-word]'))) {
        th.classList.toggle('here', th.dataset.word === cur);
      }
    }

    function finishCheck(): void {
      const p = pz();
      if (printed.size !== p.words.length) return;
      if (used === p.optimal) {
        ui.setStatus(`ครบทุกคำด้วย ${used} คำสั่ง ซึ่งน้อยที่สุดเท่าที่เป็นไปได้แล้ว`, 'good');
      } else {
        ui.setStatus(
          `ครบทุกคำแล้ว แต่ใช้ ${used} คำสั่ง ยังมีทางที่ใช้แค่ ${p.optimal} คำสั่ง ลองเปลี่ยนลำดับการพิมพ์ดู`,
          'bad',
        );
      }
    }

    function typeLetter(c: string): void {
      cur += c;
      used++;
      ui.setStatus('เติมตัวอักษรจนได้คำที่ต้องการ แล้วกดพิมพ์ ทำจนครบทุกคำในรายการ');
      render();
    }

    function back(): void {
      if (cur === '') {
        ui.setStatus('หน้าจอว่างอยู่แล้ว ลบอะไรไม่ได้', 'bad');
        return;
      }
      cur = cur.slice(0, -1);
      used++;
      ui.setStatus('เติมตัวอักษรจนได้คำที่ต้องการ แล้วกดพิมพ์ ทำจนครบทุกคำในรายการ');
      render();
    }

    function print(): void {
      const p = pz();
      if (!p.words.includes(cur)) {
        ui.setStatus(`บนหน้าจอคือ "${cur}" ซึ่งไม่ใช่คำในรายการ กดพิมพ์ไม่ได้`, 'bad');
        return;
      }
      used++;
      if (printed.has(cur)) {
        ui.setStatus(`"${cur}" พิมพ์ไปแล้ว การกดซ้ำเสียคำสั่งฟรี ๆ`, 'bad');
        render();
        return;
      }
      printed.add(cur);
      ui.setStatus(`พิมพ์ "${cur}" แล้ว เหลืออีก ${p.words.length - printed.size} คำ`, 'good');
      render();
      finishCheck();
    }

    function selectPuzzle(k: number): void {
      pi = k;
      cur = '';
      used = 0;
      printed = new Set<string>();
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildWords();
      ui.setStatus('เติมตัวอักษรจนได้คำที่ต้องการ แล้วกดพิมพ์ ทำจนครบทุกคำในรายการ');
      render();
    }

    keys.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('[data-letter]');
      if (!(b instanceof HTMLElement)) return;
      typeLetter(b.dataset.letter ?? '');
    });

    ui.onClick('data-tr-back', back);
    ui.onClick('data-tr-print', print);
    ui.onClick('data-tr-reset', () => selectPuzzle(pi));
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initPrinterGame);
</script>

