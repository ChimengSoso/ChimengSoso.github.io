    line-height:1.6;
    padding:0.6rem 0.85rem 0.75rem;
    border-top:1px solid var(--dl-border);
  }
  table.rec{
    width:100%;
    border-collapse:separate;
    border-spacing:0;
    font-size:0.84rem;
  }
  figure.tbl table.rec{width:auto;}
  table.rec caption{
    caption-side:top;
    text-align:left;
    font-family:"Fira Code","Fira Mono",monospace;
    font-weight:700;
    letter-spacing:0.18em;
    font-size:0.68rem;
    color:var(--dl-gold);
    background:#070c17;
    padding:0.5rem 0.85rem;
    border-bottom:1px solid var(--dl-border);
    white-space:nowrap;
  }
  table.rec th, table.rec td{
    padding:0.5rem 0.8rem;
    text-align:left;
    vertical-align:middle;
    border-bottom:1px solid var(--dl-border);
  }
  table.rec th + th, table.rec td + td{border-left:1px solid var(--dl-border);}
  table.rec tbody tr:last-child td{border-bottom:none;}
  table.rec th{
    background:#141b2b;
    color:var(--dl-muted);
    font-weight:600;
    font-size:0.68rem;
    letter-spacing:0.1em;
    text-transform:uppercase;
    white-space:nowrap;
  }
  table.rec td{color:var(--dl-ink);line-height:1.55;}
  table.rec td.num{
    text-align:right;
    font-family:"Fira Code","Fira Mono",monospace;
    font-variant-numeric:tabular-nums;
    white-space:nowrap;
    color:#cdd6ea;
  }
  table.rec th.num{text-align:right;}

  /* คอลัมน์กว้างคงที่ ตารางจึงไม่ขยับตอนไฮไลต์เปลี่ยนแถว
     ต้องใช้ !important เพราะกฎ body .panel .dpsim table.rec ในเลย์เอาต์ตั้ง width:100% ไว้ */
  table.rec.mtrec{width:auto !important;table-layout:fixed;}
  table.rec.mtrec th, table.rec.mtrec td{width:6.4rem;}
  table.rec.mtrec th.hand, table.rec.mtrec td.hand{width:15rem;}
  table.rec.mtrec td.hand{font-family:"Fira Code","Fira Mono",monospace;color:#cdd6ea;}
  table.rec.mtrec td.hand span{display:block;width:0;min-width:100%;}
  table.rec.mtrec tbody tr.is-later td{color:#4a5468;}
  table.rec.mtrec tbody tr.is-now td{background:#163a2a;}
  table.rec.mtrec tbody tr.is-now td.num{color:#eaf2ff;font-weight:700;}

  /* ---------- กระดานของมินิเกม ---------- */
  .mt-svg{display:block;margin:0.2rem auto 0.4rem;max-width:none;}
  .mt-edge{cursor:pointer;outline:none;}
  .mt-hit{fill:none;stroke:transparent;stroke-width:18;pointer-events:stroke;}
  .mt-line{fill:none;stroke:#56627d;stroke-width:2.2;pointer-events:none;transition:stroke .15s, stroke-width .15s;}
  .mt-lbl{
    fill:#9aa6c0;
    font-family:"Fira Code","Fira Mono",monospace;
    font-size:13px;
    stroke:#0b1220;
    stroke-width:4px;
    paint-order:stroke;
    pointer-events:none;
  }
  .mt-edge.new .mt-line{stroke:var(--dl-gold);stroke-dasharray:6 4;}
  .mt-edge.new .mt-lbl{fill:var(--dl-gold);}
  .mt-edge.on .mt-line{stroke:#6ee7a8;stroke-width:4.2;stroke-dasharray:none;}
  .mt-edge.on .mt-lbl{fill:#6ee7a8;font-weight:700;}
  .mt-edge:focus-visible .mt-hit{stroke:rgba(110,231,168,0.25);}
  .mt-node{fill:#1b2436;stroke:#7b8397;stroke-width:1.6;}
  .mt-nlbl{fill:#cdd6ea;font-family:"Fira Code","Fira Mono",monospace;font-size:14px;pointer-events:none;}
  @media (prefers-reduced-motion: reduce){
    .mt-line{transition:none;}
  }
</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type MtEdge = { u: number; v: number; z: number };
  type MtPuzzle = { label: string; tease: string; n: number; edges: MtEdge[]; ans: number[] };

  function isPuzzle(x: unknown): x is MtPuzzle {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return typeof o.n === 'number' && Array.isArray(o.edges) && Array.isArray(o.ans) && typeof o.tease === 'string';
  }

  function initMaintainGame(): void {
    const maybeUi = cpGameUi('[data-mtgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่ เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root).filter(isPuzzle);
    if (puzzles.length === 0) return;
    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-mt-board]'));
    const nextBtn = ui.root.querySelector<HTMLButtonElement>('[data-mt-next]');

    let pi = 0;
    let week = 0;
    let sel = new Set<number>();
    let solved: boolean[] = [];

    /** นับก๊วนของทางที่เลือก คืนจำนวนก๊วนที่เหลือ (1 = ถึงกันทุกจุด) */
    function components(p: MtPuzzle): number {
      const par = Array.from({ length: p.n + 1 }, (_, i) => i);
      const find = (x: number): number => (par[x] === x ? x : (par[x] = find(par[x])));
      let comps = p.n;
      for (const i of sel) {
        const a = find(p.edges[i].u);
        const b = find(p.edges[i].v);
        if (a !== b) {
          par[a] = b;
          comps--;
        }
      }
      return comps;
    }
    const total = (p: MtPuzzle): number => [...sel].reduce((s, i) => s + p.edges[i].z, 0);

    function render(): void {
      const p = puzzles[pi];
      boards.forEach((b, k) => {
        b.hidden = k !== pi;
      });
      for (const g of Array.from(boards[pi].querySelectorAll<SVGGElement>('[data-mt-e]'))) {
        const i = Number(g.dataset.mtE);
        g.toggleAttribute('hidden', i > week);
        g.classList.toggle('new', i === week);
        g.classList.toggle('on', sel.has(i));
        g.setAttribute('aria-pressed', sel.has(i) ? 'true' : 'false');
      }
      const done = solved.filter(Boolean).length;
      ui.setScore(
        `สัปดาห์ที่ ${week + 1} จาก ${p.edges.length} · เลือกไว้ ${sel.size} ทาง ยาวรวม ${total(p)} · ผ่านแล้ว ${done} สัปดาห์`,
      );
      if (nextBtn) nextBtn.disabled = week >= p.edges.length - 1;
    }

    function pass(msg: string): void {
      solved[week] = true;
      const p = puzzles[pi];
      const all = solved.filter(Boolean).length === p.edges.length;
      ui.setStatus(all ? `${msg} ครบทุกสัปดาห์ของชุดนี้แล้วครับ` : msg, 'good');
      render();
    }

    function check(): void {
      const p = puzzles[pi];
      const ans = p.ans[week];
      if (ans < 0) {
        ui.setStatus('สัปดาห์นี้ยังไม่มีชุดทางไหนพาไปถึงทุกจุดได้เลยครับ ดูว่าจุดไหนยังไม่มีทางแตะ', 'bad');
        return;
      }
      if (components(p) > 1) {
        ui.setStatus('ยังมีจุดที่เดินไปไม่ถึง ลองเลือกทางเพิ่ม', 'bad');
        return;
      }
      const s = total(p);
      if (s === ans) pass(`ถูกต้อง ยาวรวม ${ans} สั้นที่สุดของสัปดาห์นี้แล้ว`);
      else ui.setStatus(`ถึงกันครบแล้ว ยาวรวม ${s} แต่สัปดาห์นี้ทำให้สั้นกว่านั้นได้`, 'plain');
    }

    function checkNone(): void {
      const p = puzzles[pi];
      if (p.ans[week] < 0) pass('ถูกครับ สัปดาห์นี้ต้องตอบ -1');
      else ui.setStatus('สัปดาห์นี้มีชุดทางที่พาไปถึงทุกจุดได้แล้วครับ ลองหาดู', 'bad');
    }

    function nextWeek(): void {
      const p = puzzles[pi];
      if (week >= p.edges.length - 1) return;
      week++;
      const e = p.edges[week];
      ui.setStatus(`ทางใหม่ของสัปดาห์นี้คือ ${e.u}-${e.v} ยาว ${e.z} (สีทอง) ทางที่เลือกไว้เมื่อสัปดาห์ก่อนยังค้างอยู่`, 'plain');
      render();
    }

    function toggle(i: number): void {
      if (i > week) return;
      if (sel.has(i)) sel.delete(i);
      else sel.add(i);
      ui.setStatus('เลือกเสร็จแล้วกดส่งชุดนี้ หรือถ้าคิดว่ายังไปไม่ถึงทุกจุด กดปุ่ม -1', 'plain');
      render();
    }

    function selectPuzzle(k: number): void {
      pi = k;
      week = 0;
      sel = new Set<number>();
      solved = puzzles[pi].edges.map(() => false);
      ui.selectTab(k);
      ui.setTease(puzzles[pi].tease);
      ui.setStatus('กดที่ทางเพื่อเลือกดูแลหรือเลิกดูแล ทางสีทองคือทางที่เพิ่งเจอในสัปดาห์นี้');
      render();
    }

    function edgeFrom(t: EventTarget | null): number | null {
      if (!(t instanceof Element)) return null;
      const g = t.closest('[data-mt-e]');
      if (!(g instanceof SVGGElement)) return null;
      return Number(g.dataset.mtE);
    }
    ui.root.addEventListener('click', (e: MouseEvent) => {
      const i = edgeFrom(e.target);
      if (i !== null) toggle(i);
    });
    ui.root.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const i = edgeFrom(e.target);
      if (i === null) return;
      e.preventDefault();
      toggle(i);
    });

    ui.onClick('data-mt-clear', () => {
      sel = new Set<number>();
      render();
    });
    ui.onClick('data-mt-check', check);
    ui.onClick('data-mt-none', checkNone);
    ui.onClick('data-mt-next', nextWeek);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initMaintainGame);
</script>

<script>
  import { initCpRowPlayers } from '../../lib/cpPlayer';

  document.addEventListener('astro:page-load', () => {
    initCpRowPlayers('[data-mtsim]');
  });
</script>
