<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type RsPuzzle = { id: string; label: string; tease: string; vals: number[]; best: number };

  function initRollGame(): void {
    const maybeUi = cpGameUi('[data-rsgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as RsPuzzle[];
    if (puzzles.length === 0) return;

    const stripEl = ui.root.querySelector<HTMLElement>('[data-rs-strip]');
    const scoreEl = ui.root.querySelector<HTMLElement>('[data-rs-score]');
    const runEl = ui.root.querySelector<HTMLElement>('[data-rs-run]');
    if (!stripEl || !scoreEl || !runEl) return;
    const strip: HTMLElement = stripEl;
    const scoreOut: HTMLElement = scoreEl;
    const runOut: HTMLElement = runEl;

    let pi = 0;
    let taken: boolean[] = [];

    const pz = (): RsPuzzle => puzzles[pi];
    const score = (): number => pz().vals.reduce((t, v, i) => (taken[i] ? t + v : t), 0);

    /** ช่วงที่เลือกติดกันยาวที่สุดตอนนี้ */
    function longestRun(): number {
      let best = 0;
      let cur = 0;
      for (const t of taken) {
        cur = t ? cur + 1 : 0;
        best = Math.max(best, cur);
      }
      return best;
    }

    function buildStrip(): void {
      const p = pz();
      strip.textContent = '';
      p.vals.forEach((v, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'rs-cell';
        b.dataset.i = String(i);
        b.textContent = String(v);
        b.setAttribute('aria-pressed', 'false');
        strip.appendChild(b);
      });
    }

    function render(): void {
      const bad = longestRun() >= 3;
      for (const b of Array.from(strip.querySelectorAll<HTMLElement>('.rs-cell'))) {
        const i = Number(b.dataset.i);
        b.classList.toggle('on', taken[i]);
        b.setAttribute('aria-pressed', taken[i] ? 'true' : 'false');
      }
      // ทำเครื่องหมายช่วงที่ผิดกติกา ให้เห็นว่าผิดตรงไหน
      for (let i = 0; i + 2 < taken.length; i++) {
        const trio = taken[i] && taken[i + 1] && taken[i + 2];
        for (const k of [i, i + 1, i + 2]) {
          const cell = strip.children[k];
          if (cell instanceof HTMLElement && trio) cell.classList.add('bad');
        }
      }
      if (!bad) {
        for (const b of Array.from(strip.querySelectorAll<HTMLElement>('.rs-cell'))) b.classList.remove('bad');
      }
      scoreOut.textContent = String(score());
      runOut.textContent = String(longestRun());
    }

    function check(): void {
      const p = pz();
      if (longestRun() >= 3) {
        ui.setStatus('ยังผิดกติกาอยู่ มีของสามชิ้นติดกันที่ถูกเลือกพร้อมกัน', 'bad');
        return;
      }
      const s = score();
      if (s === p.best) {
        ui.setStatus(`ได้ ${s} แต้ม ซึ่งมากที่สุดเท่าที่กติกานี้ยอมให้แล้ว`, 'good');
      } else {
        ui.setStatus(`ได้ ${s} แต้ม ยังมีวิธีเลือกที่ได้ ${p.best} แต้ม`, 'bad');
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      taken = pz().vals.map(() => false);
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildStrip();
      ui.setStatus('กดเลือกของที่จะเก็บ ห้ามเลือกสามชิ้นที่ติดกัน');
      render();
    }

    strip.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('.rs-cell');
      if (!(b instanceof HTMLElement)) return;
      const i = Number(b.dataset.i);
      taken[i] = !taken[i];
      ui.setStatus('กดเลือกของที่จะเก็บ ห้ามเลือกสามชิ้นที่ติดกัน');
      render();
    });

    ui.onClick('data-rs-reset', () => selectPuzzle(pi));
    ui.onClick('data-rs-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initRollGame);
</script>

