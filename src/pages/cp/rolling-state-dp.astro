---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { mc, texCode } from '../../lib/math';

const href = 'rolling-state-dp/';

/* ---------- โมเดลกลาง ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ไม่มีที่ไหนพิมพ์มือ ---------- */

const NEG = Number.NEGATIVE_INFINITY;
const MAX_RUN = 3; // ห้ามเลือกติดกันครบสามชิ้น

/** แถวของตาราง หนึ่งช่องต่อหนึ่งค่าของ "เลือกติดกันมาแล้วกี่ชิ้น" */
type Layer = number[];

/** เดินตารางทีละชิ้น คืนแถวตั้งแต่ก่อนเริ่มจนจบแถว */
function layers(a: number[]): Layer[] {
  const out: Layer[] = [[0, NEG, NEG]];
  for (const v of a) {
    const cur = out[out.length - 1];
    const nxt: Layer = [NEG, NEG, NEG];
    cur.forEach((val, j) => {
      if (val === NEG) return;
      nxt[0] = Math.max(nxt[0], val); // ข้าม
      if (j < MAX_RUN - 1) nxt[j + 1] = Math.max(nxt[j + 1], val + v); // เก็บ
    });
    out.push(nxt);
  }
  return out;
}
const bestOf = (a: number[]): number => Math.max(...layers(a)[a.length]);

/** แผนที่ดีที่สุด ลองทุกแบบด้วยบิตมาสก์ ใช้ได้เฉพาะแถวสั้น ๆ ที่เอามาเล่า */
function bestPlan(a: number[]): { total: number; picks: number[] } {
  let best = { total: NEG, picks: [] as number[] };
  for (let m = 0; m < 1 << a.length; m++) {
    let run = 0;
    let ok = true;
    let s = 0;
    const picks: number[] = [];
    for (let i = 0; i < a.length && ok; i++) {
      if ((m >> i) & 1) {
        run++;
        s += a[i];
        picks.push(i + 1);
        if (run >= MAX_RUN) ok = false;
      } else run = 0;
    }
    if (ok && s > best.total) best = { total: s, picks };
  }
  return best;
}

/* แถวที่ใช้เล่าทั้งบท */
const MINI = [5, 5, 100];
const DEMO = [5, 5, 100, 1, 8, 9];

const miniBest = bestOf(MINI);
const miniPlan = bestPlan(MINI);
const demoBest = bestOf(DEMO);
const demoPlan = bestPlan(DEMO);
const demoLayers = layers(DEMO);

/** คะแนนที่ดีที่สุดของ MINI ถ้าจำแค่ตัวเลขเดียวต่อหนึ่งความยาวคำนำหน้า */
const miniGreedyPrefix = Math.max(...layers(MINI.slice(0, 2))[2]); // ดีที่สุดของสองชิ้นแรก
const miniTrapTotal = miniGreedyPrefix; // ทางนั้นเดินต่อไม่ได้แล้ว จบเท่านี้

const fmtCell = (v: number): string => (v === NEG ? '·' : String(v));

/* ---------- ตารางจำนวนสถานะ ---------- */

type Mem = { name: string; what: string; alpha: number; win: number; note?: string };
const MEMS: Mem[] = [
  { name: 'ตัวอย่างประจำบท', what: 'เลือกติดกันมาแล้วกี่ชิ้น', alpha: MAX_RUN, win: 1 },
  { name: 'ฝึกข้อ 2', what: 'สองช่องล่าสุดสีเหมือนกันไหม', alpha: 2, win: 1 },
  { name: 'ฝึกข้อ 3', what: 'ตัวอักษรสองตัวล่าสุด', alpha: 3, win: 2 },
  { name: 'ข้อ Miners', what: 'คู่ล่าสุดของสองเหมือง', alpha: 4, win: 4 },
];
const memRows = MEMS.map((m) => ({ ...m, count: m.alpha ** m.win }));

/* คำอธิบายรายแถวของตารางเดโม แถวศูนย์คือสภาพก่อนเริ่ม */
const rollNotes = demoLayers.map((row, i) => ({
  note:
    i === 0
      ? 'ก่อนเริ่ม ยังไม่มีของชิ้นไหนถูกตัดสินใจ สถานะเดียวที่ไปถึงได้คือค้าง 0 ชิ้น ที่ 0 คะแนน'
      : `หลังตัดสินใจของชิ้นที่ <b>${i}</b> ซึ่งมีค่า <b>${DEMO[i - 1]}</b> ` +
        `แถวนี้อ่านว่า ถ้าตอนนี้ค้าง 0, 1 หรือ 2 ชิ้น คะแนนที่ดีที่สุดคือ ` +
        `<b>${row.map((v) => fmtCell(v)).join(' , ')}</b> ตามลำดับ` +
        (i === demoLayers.length - 1
          ? ` และคำตอบของทั้งแถวคือค่าที่มากที่สุดในแถวนี้ คือ <em>${demoBest}</em>`
          : ''),
}));

const N_BIG = 100000;
const fmt = (n: number): string => n.toLocaleString('en-US');

/* ---------- สูตร ---------- */

const texMove = texCode(
  `\\begin{aligned}
${mc.fn("dp'")}[${mc.num('0')}] &${mc.op('=')} ${mc.max}_{j} \\; ${mc.fn('dp')}[j] \\\\[4pt]
${mc.fn("dp'")}[j ${mc.op('+')} ${mc.num('1')}] &${mc.op('=')} ${mc.fn('dp')}[j] ${mc.op('+')} ${mc.fn('a')}[i] \\qquad (j ${mc.op('<')} ${mc.num('2')})
\\end{aligned}`,
);
const texCount = texCode(
  `${mc.fn('states')} ${mc.op('=')} ${mc.fn('alphabet')}^{\\,${mc.fn('window')}}`,
);

/* ---------- โค้ด ---------- */

const solution = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    scanf("%d", &n);
    vector<long long> a(n);
    for (auto& x : a) scanf("%lld", &x);

    const long long NEG = LLONG_MIN / 4;          // เผื่อที่ให้บวกค่าเข้าไปโดยไม่ล้น
    vector<long long> cur(3, NEG), nxt(3);
    cur[0] = 0;                                   // ยังไม่เลือกอะไร ค้างศูนย์ชิ้น

    for (int i = 0; i < n; i++) {
        fill(nxt.begin(), nxt.end(), NEG);        // ต้องล้างก่อนทุกรอบ เพราะเราเขียนแบบผลัก
        for (int j = 0; j < 3; j++) {
            if (cur[j] == NEG) continue;          // สถานะนี้ยังไปไม่ถึง
            nxt[0] = max(nxt[0], cur[j]);                     // ข้ามชิ้นนี้ ช่วงที่เลือกติดกันขาด
            if (j < 2) nxt[j + 1] = max(nxt[j + 1], cur[j] + a[i]);  // เก็บชิ้นนี้ ช่วงยาวขึ้นหนึ่ง
        }
        cur = nxt;
    }

    printf("%lld\\n", *max_element(cur.begin(), cur.end()));
    return 0;
}`;

const bruteCode = `// ตัวตรวจสอบแบบซื่อ ๆ ลองทุกชุดที่เลือกได้ด้วยบิตมาสก์ ใช้ได้แค่ n ราว ๆ 20
// เอาไว้สุ่มเทียบกับโค้ดจริงก่อนส่ง ไม่ใช่โค้ดที่ส่งเข้าระบบตัดสิน
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    scanf("%d", &n);
    vector<long long> a(n);
    for (auto& x : a) scanf("%lld", &x);

    long long best = LLONG_MIN;
    for (int m = 0; m < (1 << n); m++) {
        int run = 0;
        bool ok = true;
        long long s = 0;
        for (int i = 0; i < n; i++) {
            if (m >> i & 1) {
                run++; s += a[i];
                if (run >= 3) { ok = false; break; }
            } else run = 0;
        }
        if (ok) best = max(best, s);
    }
    printf("%lld\\n", best);
}`;

const q1Code = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    scanf("%d", &n);
    vector<long long> c(n);
    for (auto& x : c) scanf("%lld", &x);

    const long long INF = LLONG_MAX / 4;
    vector<long long> cur(3, INF), nxt(3);
    cur[0] = 0;                                   // ยังไม่เว้นติดกันเลย

    for (int i = 0; i < n; i++) {
        fill(nxt.begin(), nxt.end(), INF);
        for (int j = 0; j < 3; j++) {
            if (cur[j] == INF) continue;
            nxt[0] = min(nxt[0], cur[j] + c[i]);           // เลือก ช่วงที่เว้นขาดทันที
            if (j < 2) nxt[j + 1] = min(nxt[j + 1], cur[j]);  // เว้น ช่วงยาวขึ้นหนึ่ง
        }
        cur = nxt;
    }

    printf("%lld\\n", *min_element(cur.begin(), cur.end()));
    return 0;
}`;

const q2Code = `#include <bits/stdc++.h>
using namespace std;
const long long MOD = 1000000007;

int main() {
    long long n, k;
    scanf("%lld %lld", &n, &k);
    long long k1 = (k - 1) % MOD;

    // สถานะไม่ใช่ "ช่องล่าสุดเป็นสีอะไร" ซึ่งมี k แบบ
    // แต่เป็น "สองช่องล่าสุดสีเหมือนกันไหม" ซึ่งมีสองแบบ ไม่ว่า k จะใหญ่แค่ไหน
    long long diff = k % MOD, same = 0;           // ช่องแรกนับรวมไว้ฝั่ง diff
    for (long long i = 2; i <= n; i++) {
        long long nd = (diff + same) % MOD * k1 % MOD;   // ทาสีต่างจากช่องก่อนหน้า
        long long ns = diff;                             // ทาซ้ำได้ ก็ต่อเมื่อคู่ก่อนหน้าไม่ซ้ำ
        diff = nd;
        same = ns;
    }

    printf("%lld\\n", (diff + same) % MOD);
    return 0;
}`;

const q3Code = `#include <bits/stdc++.h>
using namespace std;
const long long MOD = 1000000007;

int main() {
    long long n;
    scanf("%lld", &n);
    if (n == 1) { printf("3\\n"); return 0; }      // ยังไม่มีคู่ให้จำ ตอบตรง ๆ

    // สถานะคือคู่ตัวอักษรสองตัวล่าสุด อัดเป็น p*3+q โดย q คือตัวล่าสุด
    vector<long long> cur(9, 0), nxt(9);
    for (int p = 0; p < 3; p++)
        for (int q = 0; q < 3; q++) cur[p * 3 + q] = 1;   // ความยาว 2 ทุกคู่ยังไม่ผิดกติกา

    for (long long i = 3; i <= n; i++) {
        fill(nxt.begin(), nxt.end(), 0);
        for (int p = 0; p < 3; p++)
            for (int q = 0; q < 3; q++) {
                long long v = cur[p * 3 + q];
                if (!v) continue;
                for (int r = 0; r < 3; r++) {
                    if (p == q && q == r) continue;            // สามตัวติดกันเหมือนกัน
                    if (p == 0 && q == 1 && r == 2) continue;  // abc
                    nxt[q * 3 + r] = (nxt[q * 3 + r] + v) % MOD;
                }
            }
        cur = nxt;
    }

    long long s = 0;
    for (int i = 0; i < 9; i++) s = (s + cur[i]) % MOD;
    printf("%lld\\n", s);
    return 0;
}`;
/* ---------- มินิเกม เลือกของโดยห้ามติดกันสามชิ้น ----------
   คะแนนที่ดีที่สุดหาโดยไล่ทุกวิธีเลือกจริง ๆ ตอนบิลด์
   ไม่ได้ใช้ตารางสถานะที่บทนี้กำลังจะสอน */
type RsPuzzle = { id: string; label: string; tease: string; vals: number[] };

/** คะแนนมากที่สุด โดยห้ามเลือกของสามชิ้นที่ติดกัน ไล่ทุกวิธี */
function bestPickBrute(vals: number[]): number {
  const n = vals.length;
  let best = 0;
  for (let mask = 0; mask < 1 << n; mask++) {
    let ok = true;
    for (let i = 0; i + 2 < n; i++) {
      if ((mask >> i & 1) && (mask >> (i + 1) & 1) && (mask >> (i + 2) & 1)) {
        ok = false;
        break;
      }
    }
    if (!ok) continue;
    let s = 0;
    for (let i = 0; i < n; i++) if (mask >> i & 1) s += vals[i];
    best = Math.max(best, s);
  }
  return best;
}

const RS_PUZZLES: RsPuzzle[] = [
  { id: 'r1', label: 'ชุดที่ 1 · อุ่นเครื่อง', tease: 'ของสี่ชิ้น พอให้เห็นกติกาว่าห้ามติดกันสามชิ้น', vals: [5, 9, 4, 7] },
  { id: 'r2', label: 'ชุดที่ 2 · ตัวใหญ่เรียงกัน', tease: 'ชุดนี้ของแพงสามชิ้นวางติดกันพอดี ต้องยอมทิ้งชิ้นไหนสักชิ้น', vals: [8, 9, 7, 1, 6, 2] },
  { id: 'r3', label: 'ชุดที่ 3 · ยาวขึ้น', tease: 'ชุดนี้ยาวพอที่การเดาสุ่มจะเริ่มพลาด', vals: [3, 8, 8, 2, 9, 9, 1, 7, 6, 2] },
];

type RsPuzzleData = { id: string; label: string; tease: string; vals: number[]; best: number };
const rsPuzzles: RsPuzzleData[] = RS_PUZZLES.map((p) => ({
  id: p.id,
  label: p.label,
  tease: p.tease,
  vals: p.vals,
  best: bestPickBrute(p.vals),
}));
const rsJson = JSON.stringify(rsPuzzles);

/* ---------- DP บนหน้ากากบิต ----------
   โค้ดสองชิ้นนี้คอมไพล์แล้วสุ่มเทียบกัน 400 รอบ ตรงกันหมด */
const bpCode = `// DP บนหน้ากากบิต (broken profile): นับวิธีปูโดมิโน 1x2 ให้เต็มตาราง n แถว m คอลัมน์
// สถานะคือ "หน้ากากของช่องที่ยื่นล้ำมาจากคอลัมน์ก่อนหน้า" ซึ่งเป็นการบีบสถานะแบบเดียวกับบทนี้
// แต่สิ่งที่บีบไม่ใช่ตัวเลขเดียว มันคือแถวหนึ่งแถวที่เก็บเป็นบิต
// อินพุต: n m   เอาต์พุต: จำนวนวิธี หารเอาเศษด้วย 1e9+7
#include <bits/stdc++.h>
using namespace std;
const long long MOD = 1000000007LL;

int main() {
    int n, m;
    if (scanf("%d %d", &n, &m) != 2) return 0;
    if (n > m) swap(n, m);                 // ให้ n เป็นด้านที่แคบกว่า หน้ากากจึงเล็กที่สุด
    int full = 1 << n;
    vector<long long> cur(full, 0), nxt(full, 0);
    cur[0] = 1;
    for (int col = 0; col < m; col++) {
        // เดินทีละคอลัมน์ ภายในคอลัมน์เดินทีละแถว
        for (int row = 0; row < n; row++) {
            fill(nxt.begin(), nxt.end(), 0);
            for (int mask = 0; mask < full; mask++) {
                long long v = cur[mask];
                if (v == 0) continue;
                if (mask >> row & 1) {
                    // ช่องนี้ถูกโดมิโนแนวนอนจากคอลัมน์ก่อนกินไปแล้ว ปิดบิตทิ้ง
                    nxt[mask ^ (1 << row)] = (nxt[mask ^ (1 << row)] + v) % MOD;
                } else {
                    // วางแนวนอน ยื่นไปคอลัมน์ถัดไป
                    nxt[mask | (1 << row)] = (nxt[mask | (1 << row)] + v) % MOD;
                    // วางแนวตั้ง กินช่องนี้กับช่องล่างในคอลัมน์เดียวกัน
                    if (row + 1 < n && !(mask >> (row + 1) & 1))
                        nxt[mask | (1 << (row + 1))] = (nxt[mask | (1 << (row + 1))] + v) % MOD;
                }
            }
            cur.swap(nxt);
        }
    }
    printf("%lld\\n", cur[0] % MOD);
    return 0;
}`;
const bpBrute = `// ตัวตรวจอิสระของ broken profile: ไล่วางโดมิโนทุกวิธีด้วยการเรียกซ้ำบนช่องว่างแรกที่เจอ
// ไม่มีหน้ากากบิต ไม่มีการบีบสถานะ จึงไม่ได้ทดสอบข้ออ้างของท่านั้นเลย
#include <bits/stdc++.h>
using namespace std;
const long long MOD = 1000000007LL;

int n, m;
vector<vector<int>> used;
long long ways = 0;

void rec() {
    int r = -1, c = -1;
    for (int i = 0; i < n && r == -1; i++)
        for (int j = 0; j < m; j++)
            if (!used[i][j]) { r = i; c = j; break; }
    if (r == -1) { ways = (ways + 1) % MOD; return; }
    // วางแนวนอน
    if (c + 1 < m && !used[r][c + 1]) {
        used[r][c] = used[r][c + 1] = 1;
        rec();
        used[r][c] = used[r][c + 1] = 0;
    }
    // วางแนวตั้ง
    if (r + 1 < n && !used[r + 1][c]) {
        used[r][c] = used[r + 1][c] = 1;
        rec();
        used[r][c] = used[r + 1][c] = 0;
    }
}

int main() {
    if (scanf("%d %d", &n, &m) != 2) return 0;
    used.assign(n, vector<int>(m, 0));
    rec();
    printf("%lld\\n", ways % MOD);
    return 0;
}`;

