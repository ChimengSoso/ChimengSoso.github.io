import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { mc, texCode } from '../../lib/math';

const href = 'rolling-state-dp/';

/* ---------- โมเดลกลาง ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ไม่มีที่ไหนพิมพ์มือ ---------- */

const NEG = Number.NEGATIVE_INFINITY;
const MAX_RUN = 3; // ห้ามเลือกติดกันครบสามชิ้น

/** แถวของตาราง หนึ่งช่องต่อหนึ่งค่าของ "เลือกติดกันมาแล้วกี่ชิ้น" */
type Layer = number[];

/** เดินตารางทีละชิ้น คืนแถวตั้งแต่ก่อนเริ่มจนจบแถว */
function layers(a: number[]): Layer[] {
  const out: Layer[] = [[0, NEG, NEG]];
  for (const v of a) {
    const cur = out[out.length - 1];
    const nxt: Layer = [NEG, NEG, NEG];
    cur.forEach((val, j) => {
      if (val === NEG) return;
      nxt[0] = Math.max(nxt[0], val); // ข้าม
      if (j < MAX_RUN - 1) nxt[j + 1] = Math.max(nxt[j + 1], val + v); // เก็บ
    });
    out.push(nxt);
  }
  return out;
}
const bestOf = (a: number[]): number => Math.max(...layers(a)[a.length]);

/** แผนที่ดีที่สุด ลองทุกแบบด้วยบิตมาสก์ ใช้ได้เฉพาะแถวสั้น ๆ ที่เอามาเล่า */
function bestPlan(a: number[]): { total: number; picks: number[] } {
  let best = { total: NEG, picks: [] as number[] };
  for (let m = 0; m < 1 << a.length; m++) {
    let run = 0;
    let ok = true;
    let s = 0;
    const picks: number[] = [];
    for (let i = 0; i < a.length && ok; i++) {
      if ((m >> i) & 1) {
        run++;
        s += a[i];
        picks.push(i + 1);
        if (run >= MAX_RUN) ok = false;
      } else run = 0;
    }
    if (ok && s > best.total) best = { total: s, picks };
  }
  return best;
}

/* แถวที่ใช้เล่าทั้งบท */
const MINI = [5, 5, 100];
const DEMO = [5, 5, 100, 1, 8, 9];

const miniBest = bestOf(MINI);
const miniPlan = bestPlan(MINI);
const demoBest = bestOf(DEMO);
const demoPlan = bestPlan(DEMO);
const demoLayers = layers(DEMO);

/** คะแนนที่ดีที่สุดของ MINI ถ้าจำแค่ตัวเลขเดียวต่อหนึ่งความยาวคำนำหน้า */
const miniGreedyPrefix = Math.max(...layers(MINI.slice(0, 2))[2]); // ดีที่สุดของสองชิ้นแรก
const miniTrapTotal = miniGreedyPrefix; // ทางนั้นเดินต่อไม่ได้แล้ว จบเท่านี้

const fmtCell = (v: number): string => (v === NEG ? '·' : String(v));

/* ---------- ตารางจำนวนสถานะ ---------- */

type Mem = { name: string; what: string; alpha: number; win: number; note?: string };
const MEMS: Mem[] = [
  { name: 'ตัวอย่างประจำบท', what: 'เลือกติดกันมาแล้วกี่ชิ้น', alpha: MAX_RUN, win: 1 },
  { name: 'ฝึกข้อ 2', what: 'สองช่องล่าสุดสีเหมือนกันไหม', alpha: 2, win: 1 },
  { name: 'ฝึกข้อ 3', what: 'ตัวอักษรสองตัวล่าสุด', alpha: 3, win: 2 },
  { name: 'ข้อ Miners', what: 'คู่ล่าสุดของสองเหมือง', alpha: 4, win: 4 },
];
const memRows = MEMS.map((m) => ({ ...m, count: m.alpha ** m.win }));

const N_BIG = 100000;
const fmt = (n: number): string => n.toLocaleString('en-US');

/* ---------- สูตร ---------- */

const texMove = texCode(
  `\\begin{aligned}
${mc.fn("dp'")}[${mc.num('0')}] &${mc.op('=')} ${mc.max}_{j} \\; ${mc.fn('dp')}[j] \\\\[4pt]
${mc.fn("dp'")}[j ${mc.op('+')} ${mc.num('1')}] &${mc.op('=')} ${mc.fn('dp')}[j] ${mc.op('+')} ${mc.fn('a')}[i] \\qquad (j ${mc.op('<')} ${mc.num('2')})
\\end{aligned}`,
);
const texCount = texCode(
  `${mc.fn('states')} ${mc.op('=')} ${mc.fn('alphabet')}^{\\,${mc.fn('window')}}`,
);

/* ---------- โค้ด ---------- */

const solution = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    scanf("%d", &n);
    vector<long long> a(n);
    for (auto& x : a) scanf("%lld", &x);

    const long long NEG = LLONG_MIN / 4;          // เผื่อที่ให้บวกค่าเข้าไปโดยไม่ล้น
    vector<long long> cur(3, NEG), nxt(3);
    cur[0] = 0;                                   // ยังไม่เลือกอะไร ค้างศูนย์ชิ้น

    for (int i = 0; i < n; i++) {
        fill(nxt.begin(), nxt.end(), NEG);        // ต้องล้างก่อนทุกรอบ เพราะเราเขียนแบบผลัก
        for (int j = 0; j < 3; j++) {
            if (cur[j] == NEG) continue;          // สถานะนี้ยังไปไม่ถึง
            nxt[0] = max(nxt[0], cur[j]);                     // ข้ามชิ้นนี้ ช่วงที่เลือกติดกันขาด
            if (j < 2) nxt[j + 1] = max(nxt[j + 1], cur[j] + a[i]);  // เก็บชิ้นนี้ ช่วงยาวขึ้นหนึ่ง
        }
        cur = nxt;
    }

    printf("%lld\\n", *max_element(cur.begin(), cur.end()));
    return 0;
}`;

const bruteCode = `// ตัวตรวจสอบแบบซื่อ ๆ ลองทุกชุดที่เลือกได้ด้วยบิตมาสก์ ใช้ได้แค่ n ราว ๆ 20
// เอาไว้สุ่มเทียบกับโค้ดจริงก่อนส่ง ไม่ใช่โค้ดที่ส่งเข้าระบบตัดสิน
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    scanf("%d", &n);
    vector<long long> a(n);
    for (auto& x : a) scanf("%lld", &x);

    long long best = LLONG_MIN;
    for (int m = 0; m < (1 << n); m++) {
        int run = 0;
        bool ok = true;
        long long s = 0;
        for (int i = 0; i < n; i++) {
            if (m >> i & 1) {
                run++; s += a[i];
                if (run >= 3) { ok = false; break; }
            } else run = 0;
        }
        if (ok) best = max(best, s);
    }
    printf("%lld\\n", best);
}`;

const q1Code = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    scanf("%d", &n);
    vector<long long> c(n);
    for (auto& x : c) scanf("%lld", &x);

    const long long INF = LLONG_MAX / 4;
    vector<long long> cur(3, INF), nxt(3);
    cur[0] = 0;                                   // ยังไม่เว้นติดกันเลย

    for (int i = 0; i < n; i++) {
        fill(nxt.begin(), nxt.end(), INF);
        for (int j = 0; j < 3; j++) {
            if (cur[j] == INF) continue;
            nxt[0] = min(nxt[0], cur[j] + c[i]);           // เลือก ช่วงที่เว้นขาดทันที
            if (j < 2) nxt[j + 1] = min(nxt[j + 1], cur[j]);  // เว้น ช่วงยาวขึ้นหนึ่ง
        }
        cur = nxt;
    }

    printf("%lld\\n", *min_element(cur.begin(), cur.end()));
    return 0;
}`;

const q2Code = `#include <bits/stdc++.h>
using namespace std;
const long long MOD = 1000000007;

int main() {
    long long n, k;
    scanf("%lld %lld", &n, &k);
    long long k1 = (k - 1) % MOD;

    // สถานะไม่ใช่ "ช่องล่าสุดเป็นสีอะไร" ซึ่งมี k แบบ
    // แต่เป็น "สองช่องล่าสุดสีเหมือนกันไหม" ซึ่งมีสองแบบ ไม่ว่า k จะใหญ่แค่ไหน
    long long diff = k % MOD, same = 0;           // ช่องแรกนับรวมไว้ฝั่ง diff
    for (long long i = 2; i <= n; i++) {
        long long nd = (diff + same) % MOD * k1 % MOD;   // ทาสีต่างจากช่องก่อนหน้า
        long long ns = diff;                             // ทาซ้ำได้ ก็ต่อเมื่อคู่ก่อนหน้าไม่ซ้ำ
        diff = nd;
        same = ns;
    }

    printf("%lld\\n", (diff + same) % MOD);
    return 0;
}`;

const q3Code = `#include <bits/stdc++.h>
using namespace std;
const long long MOD = 1000000007;

int main() {
    long long n;
    scanf("%lld", &n);
    if (n == 1) { printf("3\\n"); return 0; }      // ยังไม่มีคู่ให้จำ ตอบตรง ๆ

    // สถานะคือคู่ตัวอักษรสองตัวล่าสุด อัดเป็น p*3+q โดย q คือตัวล่าสุด
    vector<long long> cur(9, 0), nxt(9);
    for (int p = 0; p < 3; p++)
        for (int q = 0; q < 3; q++) cur[p * 3 + q] = 1;   // ความยาว 2 ทุกคู่ยังไม่ผิดกติกา

    for (long long i = 3; i <= n; i++) {
        fill(nxt.begin(), nxt.end(), 0);
        for (int p = 0; p < 3; p++)
            for (int q = 0; q < 3; q++) {
                long long v = cur[p * 3 + q];
                if (!v) continue;
                for (int r = 0; r < 3; r++) {
                    if (p == q && q == r) continue;            // สามตัวติดกันเหมือนกัน
                    if (p == 0 && q == 1 && r == 2) continue;  // abc
                    nxt[q * 3 + r] = (nxt[q * 3 + r] + v) % MOD;
                }
            }
        cur = nxt;
    }

    long long s = 0;
    for (int i = 0; i < 9; i++) s = (s + cur[i]) % MOD;
    printf("%lld\\n", s);
    return 0;
}`;
---

<CpProblemLayout href={href}>
  <h2>อาการ · ตัวเลขเดียวต่อหนึ่งคำนำหน้า เก็บได้ไม่พอ</h2>
  <p>
    โจทย์ตัวอย่างสั้นที่สุดที่ทำให้เห็นปัญหานี้คือ ให้ของเรียงมาเป็นแถว เลือกกี่ชิ้นก็ได้ ได้คะแนนเท่าค่าของชิ้นที่เลือก
    มีกติกาข้อเดียวคือ<strong>ห้ามเลือกของสามชิ้นที่ติดกัน</strong> ให้คะแนนรวมมากที่สุด
  </p>
  <p>
    ท่ามาตรฐานของ DP คือให้ <code>dp[i]</code> เป็นคะแนนดีที่สุดเมื่อดูของ <code>i</code> ชิ้นแรก แล้วเดินไปข้างหน้าทีละชิ้น
    ลองใช้กับแถวสั้น ๆ แค่สามชิ้นคือ <code>{MINI.join(' ')}</code> ดู
  </p>
  <p>
    ดูของสองชิ้นแรกก่อน คะแนนดีที่สุดคือเลือกทั้งคู่ ได้ {miniGreedyPrefix} ถ้าเราจดไว้แค่เลขนี้แล้วเดินต่อ
    พอถึงชิ้นที่สามซึ่งมีค่า {MINI[2]} เราจะเลือกมันไม่ได้ เพราะนั่นจะเป็นการเลือกสามชิ้นติดกัน คำตอบที่ได้คือ {miniTrapTotal}
  </p>
  <p>
    แต่คำตอบจริงของแถวนี้คือ <strong>{miniBest}</strong> ซึ่งได้จากการเลือกชิ้นที่ {miniPlan.picks.join(' กับ ')}
    นั่นคือ<strong>ยอมทิ้งชิ้นที่สอง</strong> ทั้งที่มันทำให้คะแนนของคำนำหน้าลดลงจาก {miniGreedyPrefix} เหลือ {MINI[0]}
  </p>

  <div class="callout callout-warn">
    <p class="callout-label">ตรงนี้คือหัวใจของทั้งบท</p>
    <p>
      ทางที่คะแนน<strong>น้อยกว่า</strong>ในตอนนี้ กลับเป็นทางที่พาไปสู่คำตอบที่ดีกว่าในตอนจบ เพราะมันทิ้ง<strong>สภาพ</strong>
      ที่ดีกว่าไว้ให้ก้าวถัดไป ตราบใดที่ตารางเก็บได้แค่ตัวเลขเดียวต่อหนึ่งคำนำหน้า มันจะโยนทางที่ถูกทิ้งไปทุกครั้ง
      โดยไม่มีทางรู้ตัวเลย
    </p>
  </div>

  <h2>ทางออก · จดสภาพลงไปในสถานะด้วย</h2>
  <p>
    สิ่งที่ตารางขาดคือ "ตอนนี้เลือกติดกันมาแล้วกี่ชิ้น" ถ้าเพิ่มค่านี้เข้าไปเป็นดัชนีที่สองของตาราง ทางที่คะแนนน้อยกว่า
    แต่สภาพดีกว่าก็จะไม่ถูกโยนทิ้ง เพราะมันไปอยู่คนละช่องกัน
  </p>
  <p>
    ค่านี้เป็นได้แค่ 0, 1 หรือ 2 เท่านั้น (ถ้าถึง 3 ก็ผิดกติกาไปแล้ว) ตารางจึงกว้างขึ้นแค่<strong>สามเท่า</strong>
    ไม่ใช่โตแบบทวีคูณตามความยาวแถว และนี่คือรูปแบบที่บทนี้จะพูดถึงตลอด คือ<strong>สถานะที่เป็นความจำล่าสุด</strong>
    ของสิ่งที่เพิ่งเกิดขึ้น ไม่ใช่บันทึกของอดีตทั้งหมด
  </p>

  <div class="callout callout-note">
    <p class="callout-label">สองข้อสอบที่ของชิ้นหนึ่งต้องผ่าน ถึงจะเรียกว่าสถานะได้</p>
    <ul>
      <li>
        <strong>ข้อหนึ่ง พอไหม</strong> รู้แค่สถานะนี้แล้วคำนวณกำไรของก้าวถัดไปได้ครบทุกทางเลือกไหม
        โดยไม่ต้องย้อนกลับไปดูอดีตอีกเลยสักครั้ง
      </li>
      <li>
        <strong>ข้อสอง ปิดตัวเองไหม</strong> รู้สถานะเดิมกับสิ่งที่เพิ่งตัดสินใจ แล้วคำนวณ<strong>สถานะใหม่</strong>
        ได้ทันทีไหม โดยไม่ต้องย้อนกลับไปดูอดีตเช่นกัน
      </li>
    </ul>
    <p>
      ของที่ตกข้อใดข้อหนึ่งใช้เป็นสถานะไม่ได้ ส่วนของที่ผ่านทั้งสองข้อยังต้องผ่านด่านที่สามอีกหนึ่งด่าน
      คือ<strong>มันมีได้กี่แบบ</strong> ซึ่งเป็นด่านที่ตัดสินว่าท่านี้รอดหรือตาย
    </p>
  </div>

