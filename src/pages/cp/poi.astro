<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type PoiPuzzle = {
    id: string;
    label: string;
    tease: string;
    p: number;
    value: number[];
    score: number[];
    solved: number[];
    order: number[];
  };

  function isPuzzle(x: unknown): x is PoiPuzzle {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return (
      typeof o.p === 'number' &&
      typeof o.tease === 'string' &&
      Array.isArray(o.order) &&
      Array.isArray(o.score) &&
      Array.isArray(o.solved)
    );
  }

  function initPoiGame(): void {
    const maybeUi = cpGameUi('[data-poigame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่ เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root).filter(isPuzzle);
    if (puzzles.length === 0) return;

    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-poi-board]'));
    const valBtn = ui.root.querySelector<HTMLButtonElement>('[data-poi-vals]');
    let pi = 0;
    let placed: number[] = [];
    let showVals = false;

    function rowsOf(k: number): HTMLTableRowElement[] {
      return Array.from(boards[k].querySelectorAll<HTMLTableRowElement>('tbody tr'));
    }

    function render(): void {
      const p = puzzles[pi];
      boards.forEach((b, k) => {
        b.hidden = k !== pi;
      });
      rowsOf(pi).forEach((tr, i) => {
        const at = placed.indexOf(i);
        tr.classList.toggle('placed', at >= 0);
        const rk = tr.querySelector<HTMLElement>('[data-poi-rank]');
        if (rk) rk.textContent = at >= 0 ? String(at + 1) : '\u00a0';
        const btn = tr.querySelector<HTMLButtonElement>('[data-poi-row]');
        if (btn) btn.disabled = at >= 0;
      });
      boards[pi].querySelectorAll<HTMLElement>('[data-poi-val]').forEach((el) => {
        el.hidden = !showVals;
      });
      boards[pi].querySelectorAll<HTMLElement>('[data-poi-q]').forEach((el) => {
        el.hidden = showVals;
      });
      if (valBtn) valBtn.textContent = showVals ? 'ซ่อนค่าข้อ' : 'เปิดค่าข้อ';
      ui.setScore(`วางแล้ว ${placed.length} จาก ${p.order.length} คน`);
    }

    /** เหตุผลที่คนที่ i ยังไม่ถึงตา โดยดูจากคนที่ควรมาก่อน (e) แต่ไม่บอกว่าเป็นใคร */
    function why(p: PoiPuzzle, e: number, i: number): string {
      if (p.score[e] !== p.score[i]) return `ยังไม่ถึงตาคนที่ ${i + 1} ยังมีคนที่คะแนนมากกว่าเขา (${p.score[i]} คะแนน) เหลืออยู่`;
      if (p.solved[e] !== p.solved[i])
        return `ยังไม่ถึงตาคนที่ ${i + 1} ยังมีคนที่คะแนนเท่าเขา แต่ทำได้มากกว่า ${p.solved[i]} ข้อ เหลืออยู่`;
      return `ยังไม่ถึงตาคนที่ ${i + 1} ยังมีคนที่เสมอเขาทั้งคะแนนและจำนวนข้อ แต่เลขประจำตัวน้อยกว่า เหลืออยู่`;
    }

    function pick(i: number): void {
      const p = puzzles[pi];
      if (placed.includes(i) || placed.length >= p.order.length) return;
      const e = p.order[placed.length];
      if (e !== i) {
        ui.setStatus(why(p, e, i), 'bad');
        return;
      }
      placed.push(i);
      if (placed.length === p.order.length) {
        const me = p.p - 1;
        ui.setStatus(
          `ครบแล้วครับ Philip (คนที่ ${p.p}) ได้ ${p.score[me]} คะแนน อยู่อันดับ ${p.order.indexOf(me) + 1} ตรงกับที่โปรแกรมต้องตอบ`,
          'good',
        );
      } else ui.setStatus(`ถูกครับ คนที่ ${i + 1} อยู่อันดับ ${placed.length} ต่อไปคืออันดับ ${placed.length + 1}`, 'plain');
      render();
    }

    function selectPuzzle(k: number): void {
      pi = k;
      placed = [];
      showVals = false;
      ui.selectTab(k);
      ui.setTease(puzzles[pi].tease);
      ui.setStatus('กดเลขประจำตัวทีละคน เริ่มจากคนที่ควรอยู่อันดับ 1 ลงไปจนครบ');
      render();
    }

    ui.root.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest('[data-poi-row]');
      if (!(btn instanceof HTMLElement)) return;
      const [k, i] = (btn.dataset.poiRow ?? '').split(':').map(Number);
      if (k === pi) pick(i);
    });

    ui.onClick('data-poi-vals', () => {
      showVals = !showVals;
      render();
    });
    ui.onClick('data-poi-reset', () => selectPuzzle(pi));
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initPoiGame);
</script>

