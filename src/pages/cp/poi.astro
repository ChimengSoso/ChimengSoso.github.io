            <text x={c.x + DG_CW / 2} y={c.y + 21} fill={c.on ? '#eaf2ff' : '#7b8397'} font-size="14" text-anchor="middle" font-family="monospace">{c.on ? 1 : 0}</text>
          </>
        ))}
        {dgScoreText.map((s, i) => (
          <text x={DG_SX} y={dgRy(i) + 21} fill={i === ME ? '#6ee7a8' : '#cdd6ea'} font-size="14" font-family="monospace">{s}</text>
