<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type FgAsk = { from: number; k: number; ans: number };
  type FgPuzzle = {
    id: string;
    label: string;
    tease: string;
    f: number[];
    onCycle: boolean[];
    asks: FgAsk[];
  };

  function initFuncGraphGame(): void {
    const maybeUi = cpGameUi('[data-fggame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as FgPuzzle[];
    if (puzzles.length === 0) return;

    const mapEl = ui.root.querySelector<HTMLElement>('[data-fg-map]');
    const askEl = ui.root.querySelector<HTMLElement>('[data-fg-ask]');
    const posEl = ui.root.querySelector<HTMLElement>('[data-fg-pos]');
    const leftEl = ui.root.querySelector<HTMLElement>('[data-fg-left]');
    if (!mapEl || !askEl || !posEl || !leftEl) return;
    const mapOut: HTMLElement = mapEl;
    const askOut: HTMLElement = askEl;
    const posOut: HTMLElement = posEl;
    const leftOut: HTMLElement = leftEl;

    let pi = 0;
    let ai = 0;
    let pos = 1;
    let left = 0;

    const pz = (): FgPuzzle => puzzles[pi];
    const ask = (): FgAsk => pz().asks[ai];

    function buildMap(): void {
      const p = pz();
      mapOut.textContent = '';
      const head = document.createElement('tr');
      const h0 = document.createElement('th');
      h0.textContent = 'ปม';
      head.appendChild(h0);
      p.f.forEach((_, i) => {
        const th = document.createElement('th');
        th.textContent = String(i + 1);
        th.dataset.node = String(i + 1);
        head.appendChild(th);
      });
      mapOut.appendChild(head);
      const row = document.createElement('tr');
      const r0 = document.createElement('th');
      r0.textContent = 'ลูกศรไปที่';
      row.appendChild(r0);
      p.f.forEach((v, i) => {
        const td = document.createElement('td');
        td.textContent = String(v);
        td.dataset.arrow = String(i + 1);
        if (p.onCycle[i + 1]) td.classList.add('oncyc');
        row.appendChild(td);
      });
      mapOut.appendChild(row);
    }

    function render(): void {
      const a = ask();
      for (const th of Array.from(mapOut.querySelectorAll<HTMLElement>('[data-node]'))) {
        th.classList.toggle('here', Number(th.dataset.node) === pos);
      }
      askOut.textContent = `เริ่มที่ปม ${a.from} เดิน ${a.k} ก้าว`;
      posOut.textContent = String(pos);
      leftOut.textContent = String(left);
    }

    function step(): void {
      if (left === 0) {
        ui.setStatus('เดินครบตามที่ขอแล้ว กดตอบได้เลย', 'plain');
        return;
      }
      pos = pz().f[pos - 1];
      left--;
      ui.setStatus(`เดินแล้วหนึ่งก้าว เหลืออีก ${left} ก้าว`);
      render();
    }

    function answer(): void {
      const a = ask();
      if (pos === a.ans && left === 0) {
        ui.setStatus(`ถูกต้องครับ เดินครบ ${a.k} ก้าวแล้วอยู่ที่ปม ${a.ans}`, 'good');
      } else if (left > 0) {
        ui.setStatus(`ยังเดินไม่ครบ เหลืออีก ${left} ก้าว ปลายทางจริงคือปม ${a.ans}`, 'bad');
      } else {
        ui.setStatus(`ปลายทางที่ถูกคือปม ${a.ans}`, 'bad');
      }
    }

    function pickAsk(k: number): void {
      ai = k;
      const a = ask();
      pos = a.from;
      left = a.k;
      for (const b of Array.from(ui.root.querySelectorAll<HTMLElement>('[data-fg-pick]'))) {
        b.classList.toggle('picked', Number(b.dataset.fgPick) === k);
      }
      ui.setStatus('กดเดินทีละก้าว หรือถ้าเห็นวงแล้วก็ข้ามไปตอบเลย');
      render();
    }

    function buildAsks(): void {
      const p = pz();
      const bar = ui.root.querySelector<HTMLElement>('[data-fg-asks]');
      if (!bar) return;
      bar.textContent = '';
      p.asks.forEach((a, k) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cpg-btn';
        b.dataset.fgPick = String(k);
        b.textContent = `จากปม ${a.from} เดิน ${a.k} ก้าว`;
        bar.appendChild(b);
      });
    }

    function selectPuzzle(k: number): void {
      pi = k;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildMap();
      buildAsks();
      pickAsk(0);
    }

    const askBar = ui.root.querySelector<HTMLElement>('[data-fg-asks]');
    askBar?.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('[data-fg-pick]');
      if (!(b instanceof HTMLElement)) return;
      pickAsk(Number(b.dataset.fgPick));
    });

    ui.onClick('data-fg-step', step);
    ui.onClick('data-fg-answer', answer);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initFuncGraphGame);
</script>
