---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { mc, texCode } from '../../lib/math';

const href = 'tree-dp/';

/* ---------- โมเดลกลาง ทุกตัวเลขและทุกภาพในหน้านี้งอกจากตรงนี้ ---------- */

/** ต้นไม้ตัวอย่าง เขียนเป็นรายการเส้นเชื่อม โหนด 1 เป็นราก */
const EDGES: [number, number][] = [
  [1, 2],
  [1, 3],
  [1, 4],
  [2, 5],
  [2, 6],
  [3, 7],
  [4, 8],
  [4, 9],
  [7, 10],
  [7, 11],
  [9, 12],
];
const N = EDGES.length + 1;

const ADJ: number[][] = Array.from({ length: N + 1 }, () => [] as number[]);
for (const [u, v] of EDGES) {
  ADJ[u].push(v);
  ADJ[v].push(u);
}

/** เดินด้วยสแต็กของตัวเอง คืนลำดับที่พ่ออยู่ก่อนลูกเสมอ พร้อมพ่อของทุกโหนด */
function walk(root: number): { order: number[]; par: number[] } {
  const par = new Array<number>(N + 1).fill(0);
  const seen = new Array<boolean>(N + 1).fill(false);
  const order: number[] = [];
  const st = [root];
  seen[root] = true;
  while (st.length) {
    const v = st.pop() as number;
    order.push(v);
    for (const u of ADJ[v])
      if (!seen[u]) {
        seen[u] = true;
        par[u] = v;
        st.push(u);
      }
  }
  return { order, par };
}
const { order: ORDER, par: PAR } = walk(1);

/** ขนาดกิ่ง คิดจากท้ายลำดับกลับมาหาหัว */
function subtreeSizes(): number[] {
  const sz = new Array<number>(N + 1).fill(1);
  sz[0] = 0;
  for (let i = ORDER.length - 1; i >= 1; i--) sz[PAR[ORDER[i]]] += sz[ORDER[i]];
  return sz;
}
const SZ = subtreeSizes();

const childrenOf = (v: number): number[] => ADJ[v].filter((u) => u !== PAR[v]);
const depthOf = (v: number): number => (v === 1 ? 0 : depthOf(PAR[v]) + 1);

/** ตารางเดินย้อนลำดับ ทีละโหนด */
const sizeSteps = (() => {
  const sz = new Array<number>(N + 1).fill(1);
  const rows: { v: number; kids: number[]; result: number }[] = [];
  for (let i = ORDER.length - 1; i >= 0; i--) {
    const v = ORDER[i];
    const kids = childrenOf(v);
    rows.push({ v, kids, result: sz[v] });
    if (i >= 1) sz[PAR[v]] += sz[v];
  }
  // คิดค่าจริงอีกรอบให้ตรงกับผลสุดท้าย
  return rows.map((r) => ({ ...r, result: SZ[r.v] }));
})();

/* ---------- สเต็ปของเครื่องเดินบนต้นไม้ ----------
   หนึ่งขั้นคือหนึ่งโหนดในลำดับย้อนกลับ ค่าที่รู้แล้วสะสมไปเรื่อย
   ทุกอย่างมาจาก sizeSteps และ SZ ตัวเดียวกับที่หน้านี้ใช้ ไม่มีเลขพิมพ์มือ */
interface TreeStep {
  v: number;
  kids: number[];
  size: number;
  /** ค่าของทุกโหนด ดัชนีคือหมายเลขโหนด ศูนย์คือยังไม่ถึงคิว */
  vals: number[];
  note: string;
}
const treeSteps: TreeStep[] = (() => {
  const vals = new Array<number>(N + 1).fill(0);
  return sizeSteps.map((r) => {
    vals[r.v] = r.result;
    const kidPart = r.kids.length
      ? `ลูกของมันคือ <b>${r.kids.join(', ')}</b> ซึ่งตอบไปแล้วทุกตัว รวมขนาดได้ ` +
        `<b>${r.kids.map((k) => SZ[k]).join(' + ')}</b> = <b>${r.kids.reduce((t, k) => t + SZ[k], 0)}</b> ` +
        `บวกตัวมันเองอีกหนึ่ง จึงได้ <em>${r.result}</em>`
      : 'มันเป็นใบ ไม่มีลูกให้รอ จึงตอบได้ทันทีว่าขนาดกิ่งคือ <em>1</em>';
    return {
      v: r.v,
      kids: [...r.kids],
      size: r.result,
      vals: [...vals],
      note: `ถึงคิวโหนด <b>${r.v}</b> ${kidPart}`,
    };
  });
})();

/* ---------- ต้นทุนของสแต็ก ---------- */

const DEEP_N = 100000;
const FRAME_BYTES = 64;
const STACK_MB = 8;
const usedMB = (DEEP_N * FRAME_BYTES) / (1024 * 1024);

const fmt = (n: number): string => n.toLocaleString('en-US');

/* ---------- ตัวช่วยวาดต้นไม้ ---------- */

const SLOT = 74;
const ROW = 62;
const PAD_X = 30;
const TOP = 34;

type Draw = {
  edges: { x1: number; y1: number; x2: number; y2: number }[];
  nodes: { v: number; x: number; y: number }[];
  width: number;
  height: number;
};

function layout(): Draw {
  const pos = new Map<number, { x: number; y: number }>();
  let slot = 0;
  const place = (v: number, d: number): number => {
    const kids = childrenOf(v);
    let x: number;
    if (kids.length === 0) {
      x = PAD_X + slot * SLOT + SLOT / 2;
      slot++;
    } else {
      const xs = kids.map((u) => place(u, d + 1));
      x = (xs[0] + xs[xs.length - 1]) / 2;
    }
    pos.set(v, { x, y: TOP + d * ROW });
    return x;
  };
  place(1, 0);
  const R_NODE = 15;
  const edges = EDGES.map(([u, v]) => {
    const a = pos.get(u) as { x: number; y: number };
    const b = pos.get(v) as { x: number; y: number };
    // หดปลายเส้นเข้ามาเท่ารัศมีวงกลม เส้นจะได้ไม่พาดทับหมายเลขโหนด
    const len = Math.hypot(b.x - a.x, b.y - a.y) || 1;
    const ux = (b.x - a.x) / len;
    const uy = (b.y - a.y) / len;
    return {
      x1: a.x + ux * R_NODE,
      y1: a.y + uy * R_NODE,
      x2: b.x - ux * R_NODE,
      y2: b.y - uy * R_NODE,
    };
  });
  const nodes = [...pos.entries()].map(([v, p]) => ({ v, x: p.x, y: p.y }));
  const maxY = Math.max(...nodes.map((p) => p.y));
  // เผื่อที่ว่างมุมล่างขวาให้ปุ่มขยายของ ZoomableDiagram
  return { edges, nodes, width: PAD_X * 2 + slot * SLOT, height: maxY + 62 };
}
const DRAW = layout();

/* ---------- สูตร ---------- */

const texSize = texCode(
  `${mc.fn('sz')}[v] ${mc.op('=')} ${mc.num('1')} ${mc.op('+')} \\sum_{u \\,\\in\\, ${mc.fn('child')}(v)} ${mc.fn('sz')}[u]`,
);
const texMis = texCode(
  `\\begin{aligned}
${mc.fn('take')}[v] &${mc.op('=')} ${mc.fn('w')}[v] ${mc.op('+')} \\sum_{u} ${mc.fn('skip')}[u] \\\\[4pt]
${mc.fn('skip')}[v] &${mc.op('=')} \\sum_{u} ${mc.max}\\big(${mc.fn('take')}[u],\\; ${mc.fn('skip')}[u]\\big)
\\end{aligned}`,
);

/* ---------- โค้ด ---------- */

const walkCode = `// เดินต้นไม้ด้วยสแต็กที่ประกาศเอง ไม่มีการเรียกซ้ำเลยสักบรรทัด
vector<int> par(n + 1, 0), order;
order.reserve(n);
vector<char> seen(n + 1, 0);

vector<int> st{1};
seen[1] = 1;
while (!st.empty()) {
    int v = st.back();
    st.pop_back();
    order.push_back(v);                 // พ่อถูกใส่ก่อนลูกเสมอ
    for (int u : adj[v])
        if (!seen[u]) { seen[u] = 1; par[u] = v; st.push_back(u); }
}

// อ่าน order ย้อนกลับ จะได้ลูกก่อนพ่อ ซึ่งคือลำดับที่ DP บนต้นไม้ต้องการ
for (int i = n - 1; i >= 0; i--) {
    int v = order[i];
    // ตรงนี้ลูกทุกตัวของ v คิดเสร็จแล้วแน่นอน
}`;

const q1Code = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    scanf("%d", &n);
    vector<vector<int>> adj(n + 1);
    for (int i = 0; i < n - 1; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    vector<int> par(n + 1, 0), order;
    order.reserve(n);
    vector<char> seen(n + 1, 0);
    vector<int> st{1};
    seen[1] = 1;
    while (!st.empty()) {
        int v = st.back(); st.pop_back();
        order.push_back(v);
        for (int u : adj[v])
            if (!seen[u]) { seen[u] = 1; par[u] = v; st.push_back(u); }
    }

    vector<int> sz(n + 1, 1);
    // เริ่มที่ i = n-1 แล้วหยุดที่ 1 เพราะรากไม่มีพ่อให้บวกขึ้นไป
    for (int i = n - 1; i >= 1; i--) sz[par[order[i]]] += sz[order[i]];

    for (int i = 1; i <= n; i++) printf("%d%c", sz[i], i == n ? '\\n' : ' ');
    return 0;
}`;

const q2Code = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    scanf("%d", &n);
    vector<vector<int>> adj(n + 1);
    for (int i = 0; i < n - 1; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    vector<int> par(n + 1, 0), order;
    order.reserve(n);
    vector<char> seen(n + 1, 0);
    vector<int> st{1};
    seen[1] = 1;
    while (!st.empty()) {
        int v = st.back(); st.pop_back();
        order.push_back(v);
        for (int u : adj[v])
            if (!seen[u]) { seen[u] = 1; par[u] = v; st.push_back(u); }
    }

    vector<int> down(n + 1, 0);       // ทางที่ยาวที่สุดจาก v ลงไปหาใบในกิ่งของตัวเอง
    int ans = 0;
    for (int i = n - 1; i >= 0; i--) {
        int v = order[i];
        int b1 = 0, b2 = 0;           // สองกิ่งที่ยาวที่สุดของ v
        for (int u : adj[v]) {
            if (u == par[v]) continue;
            int d = down[u] + 1;
            if (d > b1) { b2 = b1; b1 = d; }
            else if (d > b2) b2 = d;
        }
        down[v] = b1;
        ans = max(ans, b1 + b2);      // ทางที่หักมุมที่ v พอดี
    }
    printf("%d\\n", ans);
    return 0;
}`;

const q3Code = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    scanf("%d", &n);
    vector<long long> w(n + 1);
    for (int i = 1; i <= n; i++) scanf("%lld", &w[i]);
    vector<vector<int>> adj(n + 1);
    for (int i = 0; i < n - 1; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    vector<int> par(n + 1, 0), order;
    order.reserve(n);
    vector<char> seen(n + 1, 0);
    vector<int> st{1};
    seen[1] = 1;
    while (!st.empty()) {
        int v = st.back(); st.pop_back();
        order.push_back(v);
        for (int u : adj[v])
            if (!seen[u]) { seen[u] = 1; par[u] = v; st.push_back(u); }
    }

    vector<long long> take(n + 1, 0), skip(n + 1, 0);
    for (int i = n - 1; i >= 0; i--) {
        int v = order[i];
        take[v] += w[v];
        for (int u : adj[v]) {
            if (u == par[v]) continue;
            take[v] += skip[u];                  // เลือก v แล้ว ลูกทุกตัวห้ามถูกเลือก
            skip[v] += max(take[u], skip[u]);    // ไม่เลือก v ลูกจะเลือกหรือไม่ก็ได้
        }
    }
    printf("%lld\\n", max(take[1], skip[1]));
    return 0;
}`;
/* ---------- มินิเกม ตอบขนาดของกิ่ง ----------
   ขนาดของทุกกิ่งคำนวณด้วยการไล่นับลูกหลานตรง ๆ ตอนบิลด์ */
type TdPuzzle = { id: string; label: string; tease: string; parent: number[] };

/** ขนาดของกิ่งที่ห้อยใต้แต่ละปม รวมตัวมันเอง */
function gameSubtreeSizes(parent: number[]): number[] {
  const n = parent.length;
  const kids: number[][] = Array.from({ length: n + 1 }, () => []);
  for (let i = 2; i <= n; i++) kids[parent[i - 1]].push(i);
  const size = new Array<number>(n + 1).fill(0);
  const order: number[] = [1];
  for (let h = 0; h < order.length; h++) for (const c of kids[order[h]]) order.push(c);
  for (let h = order.length - 1; h >= 0; h--) {
    const v = order[h];
    size[v] = 1;
    for (const c of kids[v]) size[v] += size[c];
  }
  return size;
}

const TD_PUZZLES: TdPuzzle[] = [
  {
    id: 'd1',
    label: 'ชุดที่ 1 · ต้นไม้เตี้ย',
    tease: 'เจ็ดปม แตกกิ่งกว้าง ลองนับดูก่อน',
    parent: [0, 1, 1, 2, 2, 3, 3],
  },
  {
    id: 'd2',
    label: 'ชุดที่ 2 · โซ่ยาว',
    tease: 'ชุดนี้เป็นโซ่ยาว ซึ่งเป็นรูปที่ทำให้การเรียกซ้ำตายในสนามจริง',
    parent: [0, 1, 2, 3, 4, 5, 6, 7],
  },
  {
    id: 'd3',
    label: 'ชุดที่ 3 · เอียงข้างเดียว',
    tease: 'ชุดนี้กิ่งซ้ายหนักกว่ากิ่งขวามาก',
    parent: [0, 1, 1, 2, 4, 5, 6, 3],
  },
];

type TdPuzzleData = {
  id: string;
  label: string;
  tease: string;
  parent: number[];
  size: number[];
  n: number;
};
const tdPuzzles: TdPuzzleData[] = TD_PUZZLES.map((p) => ({
  id: p.id,
  label: p.label,
  tease: p.tease,
  parent: p.parent,
  size: gameSubtreeSizes(p.parent),
  n: p.parent.length,
}));
const tdJson = JSON.stringify(tdPuzzles);

/* ---------- rerooting ----------
   โค้ดสองชิ้นนี้คอมไพล์แล้วสุ่มเทียบกัน 700 รอบ ตรงกันหมด
   วัดที่ n สองแสนได้ 0.06 วินาที */
const rrCode = `// Rerooting: ผลรวมระยะทางจากทุกปมไปยังปมอื่นทั้งหมด คิดครบทุกปมในสองรอบ
// อินพุต: n แล้ว n-1 บรรทัด u v  (ต้นไม้ ปมนับจาก 0)
// เอาต์พุต: ans[0..n-1] คือผลรวมระยะทางจากปมนั้นไปทุกปม
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    vector<vector<int>> g(n);
    for (int i = 0; i + 1 < n; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        g[u].push_back(v);
        g[v].push_back(u);
    }
    // ลำดับ BFS จากราก 0 ใช้แทนการเรียกซ้ำ กันสแต็กล้นบนต้นไม้ลึก
    vector<int> order, par(n, -1);
    order.reserve(n);
    order.push_back(0);
    for (int h = 0; h < (int)order.size(); h++) {
        int u = order[h];
        for (int v : g[u])
            if (v != par[u]) {
                par[v] = u;
                order.push_back(v);
            }
    }

    vector<long long> sz(n, 1), down(n, 0), ans(n, 0);
    // รอบที่หนึ่ง จากใบขึ้นหาราก เก็บขนาดกิ่งและผลรวมระยะทางที่มองลงเท่านั้น
    for (int i = n - 1; i >= 1; i--) {
        int v = order[i], p = par[v];
        sz[p] += sz[v];
        down[p] += down[v] + sz[v];
    }
    // รอบที่สอง จากรากลงหาใบ ย้ายรากทีละก้าว
    // ก้าวจาก p ไป v มีปม sz[v] ปมที่ใกล้ขึ้นหนึ่ง และ n - sz[v] ปมที่ไกลขึ้นหนึ่ง
    ans[0] = down[0];
    for (int i = 1; i < n; i++) {
        int v = order[i], p = par[v];
        ans[v] = ans[p] - sz[v] + (long long)(n - sz[v]);
    }
    for (int i = 0; i < n; i++) printf("%lld%c", ans[i], i + 1 == n ? '\\n' : ' ');
    return 0;
}`;
const rrBrute = `// ตัวตรวจอิสระของ rerooting: BFS ใหม่จากทุกปม แล้วบวกระยะทางตรง ๆ
// ไม่มีการย้ายราก ไม่มีสูตรส่วนต่าง จึงไม่ได้ทดสอบข้ออ้างของท่านั้นเลย
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    vector<vector<int>> g(n);
    for (int i = 0; i + 1 < n; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        g[u].push_back(v);
        g[v].push_back(u);
    }
    for (int s = 0; s < n; s++) {
        vector<int> dist(n, -1);
        dist[s] = 0;
        vector<int> q{s};
        for (int h = 0; h < (int)q.size(); h++)
            for (int v : g[q[h]])
                if (dist[v] == -1) {
                    dist[v] = dist[q[h]] + 1;
                    q.push_back(v);
                }
        long long tot = 0;
        for (int i = 0; i < n; i++) tot += dist[i];
        printf("%lld%c", tot, s + 1 == n ? '\\n' : ' ');
    }
    return 0;
}`;
const RR_N = 200000;

