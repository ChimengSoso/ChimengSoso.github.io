<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type TdPuzzle = {
    id: string;
    label: string;
    tease: string;
    parent: number[];
    size: number[];
    n: number;
  };

  function initTreeGame(): void {
    const maybeUi = cpGameUi('[data-tdgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as TdPuzzle[];
    if (puzzles.length === 0) return;

    const treeEl = ui.root.querySelector<HTMLElement>('[data-td-tree]');
    const padEl = ui.root.querySelector<HTMLElement>('[data-td-pad]');
    const typedEl = ui.root.querySelector<HTMLElement>('[data-td-typed]');
    const askEl = ui.root.querySelector<HTMLElement>('[data-td-ask]');
    const doneEl = ui.root.querySelector<HTMLElement>('[data-td-done]');
    if (!treeEl || !padEl || !typedEl || !askEl || !doneEl) return;
    const tree: HTMLElement = treeEl;
    const pad: HTMLElement = padEl;
    const typedOut: HTMLElement = typedEl;
    const askOut: HTMLElement = askEl;
    const doneOut: HTMLElement = doneEl;

    let pi = 0;
    let asked = 0;
    let typed = '';
    let solved = new Set<number>();

    const pz = (): TdPuzzle => puzzles[pi];

    /** ปมทุกตัวที่อยู่ในกิ่งของ v รวมตัวมันเอง */
    function inSubtree(v: number): Set<number> {
      const p = pz();
      const out = new Set<number>([v]);
      let grew = true;
      while (grew) {
        grew = false;
        for (let i = 2; i <= p.n; i++) {
          if (!out.has(i) && out.has(p.parent[i - 1])) {
            out.add(i);
            grew = true;
          }
        }
      }
      return out;
    }

    function buildTree(): void {
      const p = pz();
      tree.textContent = '';
      const depth = new Array<number>(p.n + 1).fill(0);
      for (let i = 2; i <= p.n; i++) depth[i] = depth[p.parent[i - 1]] + 1;
      const maxd = Math.max(...depth.slice(1));
      for (let d = 0; d <= maxd; d++) {
        const row = document.createElement('div');
        row.className = 'td-row';
        for (let i = 1; i <= p.n; i++) {
          if (depth[i] !== d) continue;
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'td-node';
          b.dataset.node = String(i);
          b.textContent = String(i);
          row.appendChild(b);
        }
        tree.appendChild(row);
      }
      pad.textContent = '';
      for (const dg of ['1', '2', '3', '4', '5', '6', '7', '8', '9', '0']) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cpg-btn ps-key';
        b.dataset.digit = dg;
        b.textContent = dg;
        pad.appendChild(b);
      }
    }

    function render(): void {
      const p = pz();
      const inside = asked === 0 ? new Set<number>() : inSubtree(asked);
      for (const b of Array.from(tree.querySelectorAll<HTMLElement>('[data-node]'))) {
        const i = Number(b.dataset.node);
        b.classList.toggle('picked', i === asked);
        b.classList.toggle('inside', inside.has(i) && i !== asked);
        b.classList.toggle('done', solved.has(i));
      }
      askOut.textContent = asked === 0 ? 'ยังไม่ได้เลือกปม' : `กิ่งของปม ${asked} มีกี่ปม`;
      typedOut.textContent = typed === '' ? '-' : typed;
      doneOut.textContent = `${solved.size} / ${p.n}`;
    }

    function submit(): void {
      const p = pz();
      if (asked === 0) {
        ui.setStatus('เลือกปมที่จะตอบก่อนครับ', 'bad');
        return;
      }
      if (typed === '') {
        ui.setStatus('พิมพ์คำตอบก่อนครับ', 'bad');
        return;
      }
      if (Number(typed) === p.size[asked]) {
        solved.add(asked);
        ui.setStatus(
          solved.size === p.n
            ? `ครบทุกปมแล้วครับ กิ่งของปม ${asked} มี ${p.size[asked]} ปม`
            : `ถูกต้อง กิ่งของปม ${asked} มี ${p.size[asked]} ปม`,
          'good',
        );
      } else {
        ui.setStatus(`ยังไม่ใช่ กิ่งของปม ${asked} มี ${p.size[asked]} ปม`, 'bad');
      }
      typed = '';
      render();
    }

    function selectPuzzle(k: number): void {
      pi = k;
      asked = 0;
      typed = '';
      solved = new Set<number>();
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildTree();
      ui.setStatus('กดที่ปมเพื่อถามว่ากิ่งของมันมีกี่ปม แล้วพิมพ์คำตอบ');
      render();
    }

    tree.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('[data-node]');
      if (!(b instanceof HTMLElement)) return;
      asked = Number(b.dataset.node);
      typed = '';
      ui.setStatus(`ถามกิ่งของปม ${asked} แล้ว ปมที่อยู่ในกิ่งถูกทำเครื่องหมายไว้ให้`);
      render();
    });
    pad.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('[data-digit]');
      if (!(b instanceof HTMLElement)) return;
      typed += b.dataset.digit ?? '';
      render();
    });

    ui.onClick('data-td-clear', () => {
      typed = '';
      render();
    });
    ui.onClick('data-td-submit', submit);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initTreeGame);
</script>

<script>
  import { initCpPlayers } from '../../lib/cpPlayer';

  interface TreeStepClient {
    v: number;
    kids: number[];
    size: number;
    vals: number[];
    note: string;
  }

  function isTreeStep(x: unknown): x is TreeStepClient {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return (
      typeof o.v === 'number' &&
      Array.isArray(o.kids) &&
      typeof o.size === 'number' &&
      Array.isArray(o.vals) &&
      typeof o.note === 'string'
    );
  }

  /* สีของวงตามสถานะ: โหนดที่กำลังคิด ลูกที่เพิ่งถูกบวกเข้ามา
     โหนดที่ตอบแล้ว และโหนดที่ยังไม่ถึงคิว */
  const INK = {
    now: { fill: '#12291c', stroke: '#4ade80', text: '#d7ffe4' },
    kid: { fill: '#2e2510', stroke: '#e0b400', text: '#ffe58a' },
    done: { fill: '#101827', stroke: '#2f9e5c', text: '#cdd6ea' },
    idle: { fill: '#101827', stroke: '#2a3350', text: '#5b6478' },
  };

  document.addEventListener('astro:page-load', () => {
    initCpPlayers<TreeStepClient>('[data-treesim]', {
      narrow: (raw) => {
        const ok = raw.filter(isTreeStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      draw: (st, ctx) => {
        ctx.parts.root.querySelectorAll<SVGGElement>('g.tnode').forEach((g) => {
          const v = Number(g.dataset.v);
          const circle = g.querySelector('circle');
          const label = g.querySelector('text');
          if (!circle || !label) return;
          const val = st.vals[v] ?? 0;
          const known = val > 0;
          label.textContent = known ? String(val) : '·';
          const kind = v === st.v ? 'now' : st.kids.indexOf(v) !== -1 ? 'kid' : known ? 'done' : 'idle';
          const ink = INK[kind];
          circle.setAttribute('fill', ink.fill);
          circle.setAttribute('stroke', ink.stroke);
          circle.setAttribute('stroke-width', kind === 'now' ? '2.6' : kind === 'kid' ? '2.2' : '1.6');
          label.setAttribute('fill', ink.text);
        });
      },
    });
  });
</script>
