  .gg-strip :global(.gg-cell.win){background:#14351f;color:#4ade80;border-color:#2f9e5c;}
  .gg-strip :global(.gg-cell.got){box-shadow:inset 0 -3px 0 #2f9e5c;}
  .gg-controls{display:flex;gap:0.5rem;align-items:center;margin:0.85rem 0 0.9rem;}
  .gg-btn{
    font:inherit;font-size:0.85rem;cursor:pointer;
    padding:0.4rem 0.8rem;border-radius:8px;
    border:1px solid var(--dl-border);background:#111c2e;color:#cdd6ea;
  }
  .gg-btn:hover{border-color:var(--dl-emerald);color:#fff;}
  .gg-claim{flex:1;font-weight:700;}
  .gg-count{border-collapse:collapse;font-size:0.85rem;margin-bottom:0.7rem;}
  .gg-count :global(th), .gg-count :global(td){
    border:1px solid #2a3350;padding:0.24rem 0.5rem;text-align:center;
    font-family:var(--dl-mono,monospace);color:#cdd6ea;
  }
  .gg-count :global(tbody th){text-align:left;font-family:inherit;color:#9aa7bd;white-space:nowrap;}
  .gg-count :global(td.ok){color:#4ade80;background:#14351f;}
  .gg-count :global(td.over){color:#f0a6a6;background:#351717;}
  .gg-count :global(td.moved){border-color:var(--dl-emerald-bright);}
  .gg-status{width:0;min-width:100%;margin:0 0 0.35rem;font-size:0.88rem;color:#cdd6ea;min-height:1.4em;}
  .gg-status.good{color:#4ade80;}
  .gg-status.bad{color:#f0a6a6;}
  .gg-score{width:0;min-width:100%;margin:0;font-size:0.88rem;color:#9aa7bd;}
  .gg-score b{color:#e6edfb;}
  @media (prefers-reduced-motion: reduce){
    .gg-strip :global(.gg-cell){transition:none;}
  }
</style>

<script>
  type GgPuzzle = {
    id: string;
    label: string;
    W: string;
    S: string;
    g: number;
    tease: string;
    hits: number[];
    total: number;
    chars: string[];
    need: Record<string, number>;
  };

  function initGlyphGame(): void {
    const root = document.querySelector<HTMLElement>('[data-glyphgame]');
    if (!root || root.dataset.wired === '1') return;
    root.dataset.wired = '1';

    const raw: unknown = JSON.parse(root.dataset.puzzles ?? '[]');
    if (!Array.isArray(raw)) return;
    const puzzles = raw as GgPuzzle[];
    if (puzzles.length === 0) return;

    const strip = root.querySelector<HTMLElement>('[data-gg-strip]');
    const status = root.querySelector<HTMLElement>('[data-gg-status]');
    const teaseEl = root.querySelector<HTMLElement>('[data-gg-tease]');
    const wordEl = root.querySelector<HTMLElement>('[data-gg-word]');
    const lenEl = root.querySelector<HTMLElement>('[data-gg-len]');
    const foundEl = root.querySelector<HTMLElement>('[data-gg-found]');
    const totalEl = root.querySelector<HTMLElement>('[data-gg-total]');
    const head = root.querySelector<HTMLElement>('[data-gg-head]');
    const rowNeed = root.querySelector<HTMLElement>('[data-gg-rowneed]');
    const rowHave = root.querySelector<HTMLElement>('[data-gg-rowhave]');
    if (!strip || !status || !teaseEl || !wordEl || !lenEl || !foundEl || !totalEl || !head || !rowNeed || !rowHave) return;

    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ตัวแปรข้ามฟังก์ชันที่ถูก hoist
       วิธีนี้ได้ชนิดที่ไม่เป็น null โดยไม่ต้องใช้เครื่องหมายอัศเจรีย์กดทับ */
    const elRoot: HTMLElement = root;
    const elStrip: HTMLElement = strip;
    const elStatus: HTMLElement = status;
    const elFound: HTMLElement = foundEl;
    const elTotal: HTMLElement = totalEl;
    const elTease: HTMLElement = teaseEl;
    const elWord: HTMLElement = wordEl;
    const elLen: HTMLElement = lenEl;
    const elHead: HTMLElement = head;
    const elNeed: HTMLElement = rowNeed;
    const elHave: HTMLElement = rowHave;

    let pi = 0;
    let left = 0;
    let prevLeft = 0;
    let found = new Set<number>();

    const pz = (): GgPuzzle => puzzles[pi];
    const maxLeft = (): number => pz().S.length - pz().g;

    function countFound(): number {
      let n = 0;
      for (const h of pz().hits) if (found.has(h)) n++;
      return n;
    }

    function buildBoard(): void {
      const p = pz();
      elStrip.textContent = '';
      for (let k = 0; k < p.S.length; k++) {
        const cell = document.createElement('span');
        cell.className = 'gg-cell';
        cell.textContent = p.S[k];
        cell.dataset.k = String(k);
        elStrip.appendChild(cell);
      }
      elHead.textContent = '';
      elNeed.textContent = '';
      elHave.textContent = '';
      const h0 = document.createElement('th');
      h0.textContent = 'กลิฟ';
      elHead.appendChild(h0);
      const n0 = document.createElement('th');
      n0.textContent = 'ต้องการ';
      elNeed.appendChild(n0);
      const v0 = document.createElement('th');
      v0.textContent = 'ในหน้าต่าง';
      elHave.appendChild(v0);
      for (const c of p.chars) {
        const th = document.createElement('th');
        th.textContent = c;
        elHead.appendChild(th);
        const td1 = document.createElement('td');
        td1.textContent = String(p.need[c] ?? 0);
        elNeed.appendChild(td1);
        const td2 = document.createElement('td');
        td2.dataset.ch = c;
        td2.textContent = '0';
        elHave.appendChild(td2);
      }
      elWord.textContent = p.W;
      elLen.textContent = String(p.g);
      elTease.textContent = p.tease;
      elTotal.textContent = String(p.total);
      elStrip.setAttribute('aria-valuemin', '1');
      elStrip.setAttribute('aria-valuemax', String(maxLeft() + 1));
    }

    function windowCounts(): Record<string, number> {
      const p = pz();
      const m: Record<string, number> = {};
      for (let k = left; k < left + p.g; k++) m[p.S[k]] = (m[p.S[k]] ?? 0) + 1;
      return m;
    }

    function keepInView(): void {
      const scroll = elStrip.parentElement;
      const cell = elStrip.children[left];
      if (!scroll || !(cell instanceof HTMLElement)) return;
      const cl = cell.offsetLeft;
      const cr = cl + cell.offsetWidth * pz().g;
      if (cl < scroll.scrollLeft) scroll.scrollLeft = cl - 8;
      else if (cr > scroll.scrollLeft + scroll.clientWidth) scroll.scrollLeft = cr - scroll.clientWidth + 8;
    }

    function render(): void {
      const p = pz();
      const counts = windowCounts();
      for (let k = 0; k < p.S.length; k++) {
        const cell = elStrip.children[k];
        if (!(cell instanceof HTMLElement)) continue;
        const inside = k >= left && k < left + p.g;
        cell.classList.toggle('in', inside);
        cell.classList.toggle('edge', inside && (k === left || k === left + p.g - 1));
        cell.classList.toggle('got', found.has(k));
      }
      const movedChars = new Set<string>();
      if (prevLeft !== left) {
        const lo = Math.min(prevLeft, left);
        const hi = Math.max(prevLeft, left);
        for (let k = lo; k < lo + p.g; k++) if (k < hi || k >= hi + p.g) movedChars.add(p.S[k]);
        for (let k = hi; k < hi + p.g; k++) if (k < lo || k >= lo + p.g) movedChars.add(p.S[k]);
      }
      for (const td of Array.from(elHave.querySelectorAll<HTMLElement>('td'))) {
        const ch = td.dataset.ch ?? '';
        const have = counts[ch] ?? 0;
        const need = p.need[ch] ?? 0;
        td.textContent = String(have);
        td.classList.toggle('ok', need > 0 && have === need);
        td.classList.toggle('over', need === 0 ? have > 0 : have > need);
        td.classList.toggle('moved', movedChars.has(ch));
      }
      elStrip.setAttribute('aria-valuenow', String(left + 1));
      elStrip.setAttribute('aria-valuetext', 'หน้าต่างเริ่มที่กลิฟตัวที่ ' + (left + 1) + ' คือ ' + p.S.slice(left, left + p.g));
      elFound.textContent = String(countFound());
    }

    function move(d: number): void {
      prevLeft = left;
      left = Math.min(maxLeft(), Math.max(0, left + d));
      elStatus.textContent = 'เลื่อนหน้าต่างไปเรื่อย ๆ เจอหน้าต่างที่ใช้ได้เมื่อไรก็กดเก็บ';
      elStatus.className = 'gg-elStatus';
      render();
      keepInView();
    }

    function claim(): void {
      const p = pz();
      if (!p.hits.includes(left)) {
        elStatus.textContent = 'ยังไม่ตรงครับ ดูแถวตัวนับว่าช่องไหนยังไม่เท่ากับที่ต้องการ';
        elStatus.className = 'gg-elStatus bad';
        return;
      }
      if (found.has(left)) {
        elStatus.textContent = 'หน้าต่างนี้เก็บไปแล้ว ลองหาอันถัดไป';
        elStatus.className = 'gg-elStatus';
        return;
      }
      found.add(left);
      const n = countFound();
      elStatus.textContent = n === p.total
        ? 'ครบแล้ว ' + p.total + ' หน้าต่าง ลองสลับไปชุดอื่นดูครับ'
        : 'ใช่ครับ เก็บได้ ' + n + ' จาก ' + p.total;
      elStatus.className = 'gg-elStatus good';
      render();
    }

    function selectPuzzle(k: number): void {
      pi = k;
      left = 0;
      prevLeft = 0;
      found = new Set<number>();
      for (const t of Array.from(elRoot.querySelectorAll<HTMLElement>('[data-gg-tab]'))) {
        t.setAttribute('aria-selected', t.dataset.ggTab === String(k) ? 'true' : 'false');
      }
      buildBoard();
      elStatus.textContent = 'เลื่อนหน้าต่างไปเรื่อย ๆ เจอหน้าต่างที่ใช้ได้เมื่อไรก็กดเก็บ';
      elStatus.className = 'gg-elStatus';
      render();
    }

    elRoot.querySelector('[data-gg-prev]')?.addEventListener('click', () => move(-1));
    elRoot.querySelector('[data-gg-next]')?.addEventListener('click', () => move(1));
    elRoot.querySelector('[data-gg-claim]')?.addEventListener('click', claim);
    for (const t of Array.from(elRoot.querySelectorAll<HTMLElement>('[data-gg-tab]'))) {
      t.addEventListener('click', () => selectPuzzle(Number(t.dataset.ggTab ?? '0')));
    }
    elStrip.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); move(-1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); move(1); }
      else if (e.key === 'Home') { e.preventDefault(); move(-1000000); }
      else if (e.key === 'End') { e.preventDefault(); move(1000000); }
      else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); claim(); }
    });
    elStrip.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const k = e.target.dataset.k;
      if (k === undefined) return;
      prevLeft = left;
      left = Math.min(maxLeft(), Math.max(0, Number(k)));
      render();
      keepInView();
    });

    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initGlyphGame);
</script>

<script>
  import { initCpRowPlayers } from '../../lib/cpPlayer';

  document.addEventListener('astro:page-load', () => {
    initCpRowPlayers('[data-awsim]');
  });
</script>
