        {Q_PATH.map((i, k) => {
          const [l, r] = covers(i);
          return (
            <tr>
              <td class="num">t[{i}]</td>
              <td><code>a[{l}..{r}]</code></td>
              <td class="num">{TREE[i]}</td>
