---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { mc, texCode } from '../../lib/math';

const href = 'prefix-sums/';

/* ---------- โมเดลกลาง ตัวเลขทุกตัวในหน้านี้งอกจากตรงนี้ ไม่มีที่ไหนพิมพ์มือ ---------- */

const A = [3, 1, 4, 1, 5, 9, 2, 6];
const N = A.length;

/** ผลรวมสะสม pre[i] = a[1] + ... + a[i] โดย pre[0] = 0 */
const PRE = A.reduce<number[]>((acc, v) => [...acc, acc[acc.length - 1] + v], [0]);

const rangeSum = (l: number, r: number): number => PRE[r] - PRE[l - 1];

/** บิตต่ำสุดที่ยังเป็น 1 ของ i ตัวเลขนี้คือ "ความยาวช่วงที่ช่อง i ดูแล" */
const lowbit = (i: number): number => i & -i;

/** ช่วงที่ช่อง i ของต้นไม้ดูแล คือ (i - lowbit(i), i] */
const covers = (i: number): [number, number] => [i - lowbit(i) + 1, i];

/** สร้างต้นไม้จากอาเรย์ ตรงตามที่โค้ดทำจริง */
function buildTree(a: number[]): number[] {
  const n = a.length;
  const t = new Array<number>(n + 1).fill(0);
  for (let i = 1; i <= n; i++) for (let j = i; j <= n; j += lowbit(j)) t[j] += a[i - 1];
  return t;
}
const TREE = buildTree(A);

/** ช่องที่ต้องบวกกัน เวลาถามผลรวมตั้งแต่ต้นถึง i */
function queryPath(i: number): number[] {
  const out: number[] = [];
  for (let k = i; k > 0; k -= lowbit(k)) out.push(k);
  return out;
}
/** ช่องที่ต้องแก้ตาม เวลาแก้ค่าที่ตำแหน่ง i */
function updatePath(i: number, n: number): number[] {
  const out: number[] = [];
  for (let k = i; k <= n; k += lowbit(k)) out.push(k);
  return out;
}

const Q_AT = 7;
const Q_PATH = queryPath(Q_AT);
const U_AT = 3;
const U_PATH = updatePath(U_AT, N);

/** แถวของตาราง "ช่องไหนดูแลช่วงไหน" */
const coverRows = Array.from({ length: N }, (_, k) => {
  const i = k + 1;
  const [l, r] = covers(i);
  return {
    i,
    bin: i.toString(2).padStart(4, '0'),
    low: lowbit(i),
    l,
    r,
    len: r - l + 1,
    val: TREE[i],
    sum: rangeSum(l, r),
  };
});

/* ---------- ต้นทุนของสามท่า คิดหน่วยเดียวกันคือ "จำนวนครั้งที่แตะช่องข้อมูล" ---------- */

const BIG_N = 200000;
const BIG_Q = 200000;
const LOGN = Math.ceil(Math.log2(BIG_N));

/** สมมติว่าคำถามครึ่งหนึ่งเป็นการถามผลรวม อีกครึ่งเป็นการแก้ค่า */
const HALF = BIG_Q / 2;
const costRows = [
  {
    name: 'ไล่บวกทีละช่องตอนถูกถาม',
    build: '0',
    ask: 'ยาวช่วง สูงสุด n',
    edit: '1',
    total: HALF * BIG_N + HALF * 1,
  },
  {
    name: 'ผลรวมสะสม',
    build: 'n',
    ask: '2',
    edit: 'สร้างใหม่ทั้งแถว n',
    total: BIG_N + HALF * 2 + HALF * BIG_N,
  },
  {
    name: 'ต้นไม้เฟนวิก',
    build: `n log n`,
    ask: `2 log n`,
    edit: `log n`,
    total: BIG_N * LOGN + HALF * 2 * LOGN + HALF * LOGN,
  },
];

const fmt = (n: number): string => n.toLocaleString('en-US');
function human(n: number): string {
  if (n >= 1e9) return `${(n / 1e9).toFixed(1)} พันล้าน`;
  if (n >= 1e6) return `${(n / 1e6).toFixed(1)} ล้าน`;
  return fmt(n);
}

/* ---------- ตัวช่วยวาดบันได ---------- */

const CELL = 46;
const PAD_L = 62;
const ROW_H = 25;
const TOP_Y = 40;
const DGM_W = PAD_L + N * CELL + 24;
const DGM_H = TOP_Y + N * ROW_H + 44;

const cellX = (pos: number): number => PAD_L + (pos - 1) * CELL;

/* ---------- สูตร ---------- */

const texPre = texCode(
  `${mc.fn('sum')}(l, r) ${mc.op('=')} ${mc.fn('pre')}[r] ${mc.op('-')} ${mc.fn('pre')}[l ${mc.op('-')} ${mc.num('1')}]`,
);
const texCover = texCode(
  `${mc.fn('t')}[i] ${mc.op('=')} \\sum_{j \\,=\\, i \\,-\\, ${mc.fn('low')}(i) \\,+\\, ${mc.num('1')}}^{i} ${mc.fn('a')}[j] \\qquad ${mc.fn('low')}(i) ${mc.op('=')} i \\;\\&\\; {-i}`,
);
const texPre2d = texCode(
  `${mc.fn('sum')} ${mc.op('=')} ${mc.fn('s')}[r_2][c_2] ${mc.op('-')} ${mc.fn('s')}[r_1 ${mc.op('-')} ${mc.num('1')}][c_2] ${mc.op('-')} ${mc.fn('s')}[r_2][c_1 ${mc.op('-')} ${mc.num('1')}] ${mc.op('+')} ${mc.fn('s')}[r_1 ${mc.op('-')} ${mc.num('1')}][c_1 ${mc.op('-')} ${mc.num('1')}]`,
);

/* ---------- โค้ด ---------- */

const preCode = `// ผลรวมสะสม สร้างครั้งเดียวแล้วตอบทุกช่วงในเวลาคงที่
// pre[0] = 0 เสมอ เพื่อให้ช่วงที่เริ่มที่ 1 ไม่ต้องเขียนเงื่อนไขพิเศษ
vector<long long> pre(n + 1, 0);
for (int i = 1; i <= n; i++) pre[i] = pre[i - 1] + a[i];

long long sum = pre[r] - pre[l - 1];   // ผลรวมของ a[l..r]`;

const bitCode = `#include <bits/stdc++.h>
using namespace std;

// ต้นไม้เฟนวิก ดัชนีเริ่มที่ 1 เสมอ เพราะสูตร i & -i ใช้กับ 0 ไม่ได้ (วนไม่รู้จบ)
struct BIT {
    int n;
    vector<long long> t;
    BIT(int n_) : n(n_), t(n_ + 1, 0) {}

    // บวก v เข้าไปที่ตำแหน่ง i แล้วไล่ขึ้นไปแก้ทุกช่องที่ครอบ i อยู่
    void add(int i, long long v) {
        for (; i <= n; i += i & -i) t[i] += v;
    }

    // ผลรวมตั้งแต่ตำแหน่ง 1 ถึง i โดยไล่ตัดทีละก้อนจากขวาเข้าซ้าย
    long long pre(int i) {
        long long s = 0;
        for (; i > 0; i -= i & -i) s += t[i];
        return s;
    }

    long long range(int l, int r) { return pre(r) - pre(l - 1); }
};

int main() {
    int n, q;
    scanf("%d %d", &n, &q);
    BIT b(n);
    vector<long long> a(n + 1, 0);
    for (int i = 1; i <= n; i++) { scanf("%lld", &a[i]); b.add(i, a[i]); }

    while (q--) {
        int op;
        scanf("%d", &op);
        if (op == 1) {                     // แก้ค่าที่ตำแหน่ง i ให้เป็น v
            int i; long long v;
            scanf("%d %lld", &i, &v);
            b.add(i, v - a[i]);            // ส่ง "ส่วนต่าง" เข้าไป ไม่ใช่ค่าใหม่
            a[i] = v;
        } else {                           // ถามผลรวมของช่วง [l, r]
            int l, r;
            scanf("%d %d", &l, &r);
            printf("%lld\\n", b.range(l, r));
        }
    }
    return 0;
}`;

const q1Code = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int R, C, q;
    scanf("%d %d %d", &R, &C, &q);

    // s[i][j] = ผลรวมของสี่เหลี่ยมตั้งแต่มุมซ้ายบน (1,1) ถึง (i,j)
    vector<vector<long long>> s(R + 1, vector<long long>(C + 1, 0));
    for (int i = 1; i <= R; i++)
        for (int j = 1; j <= C; j++) {
            long long v;
            scanf("%lld", &v);
            // แถวบนกับคอลัมน์ซ้ายทับกันตรงมุมซ้ายบน จึงต้องบวกคืนหนึ่งครั้ง
            s[i][j] = v + s[i - 1][j] + s[i][j - 1] - s[i - 1][j - 1];
        }

    while (q--) {
        int r1, c1, r2, c2;
        scanf("%d %d %d %d", &r1, &c1, &r2, &c2);
        printf("%lld\\n", s[r2][c2] - s[r1 - 1][c2] - s[r2][c1 - 1] + s[r1 - 1][c1 - 1]);
    }
    return 0;
}`;

const q2Code = `#include <bits/stdc++.h>
using namespace std;

int n;
vector<int> t;
void add(int i) { for (; i <= n; i += i & -i) t[i]++; }
int pre(int i) { int s = 0; for (; i > 0; i -= i & -i) s += t[i]; return s; }

int main() {
    scanf("%d", &n);
    vector<int> a(n);
    for (auto& x : a) scanf("%d", &x);

    // ค่าอาจใหญ่หรือติดลบ ย่อให้เป็นอันดับ 1..n ก่อน ต้นไม้จะได้มีขนาดเท่า n
    vector<int> v = a;
    sort(v.begin(), v.end());
    v.erase(unique(v.begin(), v.end()), v.end());

    t.assign(n + 1, 0);
    long long ans = 0;
    for (int i = n - 1; i >= 0; i--) {          // เดินจากขวาไปซ้าย
        int r = lower_bound(v.begin(), v.end(), a[i]) - v.begin() + 1;
        ans += pre(r - 1);                      // ของที่อยู่ขวาแล้วเล็กกว่า a[i]
        add(r);
    }
    printf("%lld\\n", ans);
    return 0;
}`;

const q3Code = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int n; long long D;
    scanf("%d %lld", &n, &D);
    vector<long long> a(n);
    for (auto& x : a) scanf("%lld", &x);

    sort(a.begin(), a.end());
    long long ans = 0;
    int l = 0;
    for (int r = 0; r < n; r++) {
        while (a[r] - a[l] > D) l++;   // ตัวชี้ซ้ายเดินหน้าอย่างเดียว ไม่เคยถอย
        ans += r - l;                  // ทุกตัวใน [l, r-1] จับคู่กับ r ได้
    }
    printf("%lld\\n", ans);
    return 0;
}`;
---

<CpProblemLayout href={href}>
  <h2>อาการ · คำถามเดียวกันที่ถูกถามสองแสนครั้ง</h2>
  <p>
    โจทย์ชุดหนึ่งที่โผล่บ่อยมากหน้าตาเป็นแบบนี้ ให้อาเรย์ยาว <code>n</code> ตัว แล้วมีคำถามตามมาอีก <code>q</code> ข้อ
    แต่ละข้อถามว่า "ผลรวมของช่องที่ <code>l</code> ถึงช่องที่ <code>r</code> เป็นเท่าไร" ตอบให้ครบทุกข้อ
  </p>
  <p>
    ท่าแรกที่ทุกคนเขียนคือวนบวกไปตามช่วงที่เขาถาม ซึ่งถูกต้องร้อยเปอร์เซ็นต์และ<strong>ตกทุกครั้ง</strong>
    เมื่อ <code>n</code> กับ <code>q</code> โตขึ้นไปถึงระดับสองแสน เพราะคำถามข้อเดียวที่ถามช่วงยาวทั้งแถวก็กินสองแสนครั้งแล้ว
    ถามสองแสนข้อคือสี่หมื่นล้านครั้ง
  </p>
  <p>
    บทนี้ไล่จากท่าที่ง่ายที่สุดไปหาท่าที่ยืดหยุ่นที่สุด แล้วจบด้วยคำถามที่สำคัญกว่าทั้งสองท่า
    คือ<strong>เมื่อไรควรใช้อันไหน</strong> เพราะท่าที่แรงกว่าไม่ได้แปลว่าท่าที่ควรหยิบ
  </p>

  <h2>ท่าที่หนึ่ง · ผลรวมสะสม</h2>
  <p>
    แทนที่จะตอบคำถามตอนถูกถาม ให้ทำการบ้านไว้ก่อนหนึ่งรอบ สร้างอาเรย์ใหม่ชื่อ <code>pre</code> ที่
    <code>pre[i]</code> เก็บ<strong>ผลรวมตั้งแต่ช่องแรกจนถึงช่องที่ <code>i</code></strong> เรียกมันว่า
    ผลรวมสะสม (prefix sum) คำว่า <i>prefix</i> อ่านว่า "พรีฟิกซ์" แปลว่าส่วนที่นำหน้า เป็นคำเดียวกับคำนำหน้าคำในภาษาอังกฤษ
    ที่นี่หมายถึงท่อนที่เริ่มจากหัวแถวเสมอ
  </p>
  <p>
    พอมีตารางนี้แล้ว ผลรวมของช่วงใด ๆ ก็หักลบกันออกมาได้ในการคำนวณครั้งเดียว
  </p>
  <div set:html={texPre} />
  <p>
    เอาอาเรย์ตัวอย่าง <code>{A.join(' ')}</code> มาไล่ให้เห็นชัด ๆ
  </p>

  <figure class="tbl">
    <table class="rec">
      <caption>ผลรวมสะสมของ {A.join(' ')}</caption>
      <thead>
        <tr>
          <th>i</th>
          {Array.from({ length: N + 1 }, (_, i) => <th class="num">{i}</th>)}
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>a[i]</td>
          <td class="num">·</td>
          {A.map((v) => <td class="num">{v}</td>)}
        </tr>
        <tr>
          <td>pre[i]</td>
          {PRE.map((v) => <td class="num">{v}</td>)}
        </tr>
      </tbody>
    </table>
    <figcaption>
      ช่อง <code>pre[0]</code> ที่เป็น 0 ไม่ใช่ของประดับ มันคือสิ่งที่ทำให้ช่วงที่เริ่มต้นที่ช่อง 1 ไม่ต้องเขียนเงื่อนไขพิเศษ
      เช่นผลรวมช่วง 1 ถึง 4 คือ <code>{PRE[4]} − {PRE[0]} = {rangeSum(1, 4)}</code> ใช้สูตรเดียวกับทุกช่วง
    </figcaption>
  </figure>

  <p>
    ท่านี้จบเร็วและเขียนสั้นมาก ปัญหาเดียวของมันโผล่ตอนโจทย์เติมประโยคเดียวเข้ามาว่า
    "<strong>ระหว่างทางมีการแก้ค่าในช่องด้วย</strong>" เพราะการแก้ค่าช่องที่ 3 ทำให้ <code>pre[3]</code> จนถึง
    <code>pre[n]</code> ผิดหมดทุกช่อง ต้องสร้างใหม่ทั้งแถว
  </p>
  <CodeBlock code={preCode} lang="cpp" title="ผลรวมสะสม" />

  <figure class="tbl">
    <table class="rec">
      <caption>ต้นทุนของแต่ละท่า · นับเป็นจำนวนครั้งที่แตะช่องข้อมูล</caption>
      <thead>
        <tr>
          <th>ท่า</th>
          <th class="num">สร้างตอนต้น</th>
          <th class="num">ถามหนึ่งครั้ง</th>
          <th class="num">แก้ค่าหนึ่งครั้ง</th>
          <th class="num">รวม</th>
        </tr>
      </thead>
      <tbody>
        {costRows.map((r) => (
          <tr>
            <td>{r.name}</td>
            <td class="num">{r.build}</td>
            <td class="num">{r.ask}</td>
            <td class="num">{r.edit}</td>
            <td class="num">{human(r.total)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <figcaption>
      คิดที่ <code>n = {fmt(BIG_N)}</code> และ <code>q = {fmt(BIG_Q)}</code> โดยสมมติว่าครึ่งหนึ่งของคำถามเป็นการถามผลรวม
      อีกครึ่งเป็นการแก้ค่า ทั้งสามแถวนับหน่วยเดียวกัน ถ้าโจทย์<strong>ไม่มี</strong>การแก้ค่าเลย แถวกลางคือ {human(BIG_N + BIG_Q * 2)} ครั้ง
      ซึ่งชนะแถวล่างขาดลอย
    </figcaption>
  </figure>

  <div class="callout callout-tip">
    <p class="callout-label">คิดก่อนอ่านต่อ</p>
    <p>
      ผลรวมสะสมเร็วเพราะมันเก็บ<strong>ก้อนเดียวที่ใหญ่ที่สุด</strong> คือตั้งแต่หัวแถวถึงตำแหน่งนั้น
      ซึ่งทำให้แก้ค่าทีเดียวพังยาว ส่วนอาเรย์ดิบเก็บทีละช่อง แก้ง่ายแต่ถามช้า
      ถ้าอยากได้ทั้งสองอย่าง เราน่าจะต้องเก็บก้อนที่<strong>ใหญ่กำลังดี</strong> คำถามคือใหญ่แค่ไหนถึงเรียกว่ากำลังดี
      และแต่ละช่องควรดูแลช่วงไหน?
    </p>
  </div>

  <h2>ท่าที่สอง · ต้นไม้เฟนวิก</h2>
  <p>
    โครงสร้างที่ตอบคำถามข้างบนชื่อ <strong>ต้นไม้เฟนวิก</strong> (Fenwick tree) อ่านว่า "เฟนวิก" ตั้งตามชื่อ
    Peter Fenwick นักวิทยาศาสตร์คอมพิวเตอร์ชาวนิวซีแลนด์ที่เขียนถึงมันในปี 1994 อีกชื่อที่เจอบ่อยพอกันคือ
    Binary Indexed Tree (ย่อว่า BIT) แปลตรงตัวว่าต้นไม้ที่ใช้เลขฐานสองเป็นดัชนี ซึ่งเป็นชื่อที่บอกกลไกได้ตรงกว่า
  </p>
  <p>
    กติกามีข้อเดียว <strong>ช่องที่ <code>i</code> ของต้นไม้ดูแลช่วงที่ยาวเท่ากับบิตต่ำสุดที่ยังเป็น 1 ของ <code>i</code></strong>
    และช่วงนั้นจบลงที่ <code>i</code> พอดี เขียนบิตต่ำสุดนั้นเป็นสูตรได้ว่า <code>i & -i</code>
  </p>
  <div set:html={texCover} />
  <p>
    เหตุผลที่ <code>i & -i</code> ให้บิตต่ำสุดออกมา อยู่ที่วิธีที่คอมพิวเตอร์เก็บเลขติดลบ ค่า <code>-i</code>
    คือการกลับบิตทุกตัวของ <code>i</code> แล้วบวกหนึ่ง ผลคือบิตทางซ้ายของบิตต่ำสุดกลับด้านกันหมด และบิตต่ำสุดเองยังตรงกัน
    การ <code>and</code> กันจึงเหลือรอดแค่บิตเดียวนั้น
