---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import { mc, texCode } from '../../lib/math';

const href = 'prefix-sums/';

/* ---------- โมเดลกลาง ตัวเลขทุกตัวในหน้านี้งอกจากตรงนี้ ไม่มีที่ไหนพิมพ์มือ ---------- */

const A = [3, 1, 4, 1, 5, 9, 2, 6];
const N = A.length;

/** ผลรวมสะสม pre[i] = a[1] + ... + a[i] โดย pre[0] = 0 */
const PRE = A.reduce<number[]>((acc, v) => [...acc, acc[acc.length - 1] + v], [0]);

const rangeSum = (l: number, r: number): number => PRE[r] - PRE[l - 1];

/** บิตต่ำสุดที่ยังเป็น 1 ของ i ตัวเลขนี้คือ "ความยาวช่วงที่ช่อง i ดูแล" */
const lowbit = (i: number): number => i & -i;

/** ช่วงที่ช่อง i ของต้นไม้ดูแล คือ (i - lowbit(i), i] */
const covers = (i: number): [number, number] => [i - lowbit(i) + 1, i];

/** สร้างต้นไม้จากอาเรย์ ตรงตามที่โค้ดทำจริง */
function buildTree(a: number[]): number[] {
  const n = a.length;
  const t = new Array<number>(n + 1).fill(0);
  for (let i = 1; i <= n; i++) for (let j = i; j <= n; j += lowbit(j)) t[j] += a[i - 1];
  return t;
}
const TREE = buildTree(A);

/** ช่องที่ต้องบวกกัน เวลาถามผลรวมตั้งแต่ต้นถึง i */
function queryPath(i: number): number[] {
  const out: number[] = [];
  for (let k = i; k > 0; k -= lowbit(k)) out.push(k);
  return out;
}
/** ช่องที่ต้องแก้ตาม เวลาแก้ค่าที่ตำแหน่ง i */
function updatePath(i: number, n: number): number[] {
  const out: number[] = [];
  for (let k = i; k <= n; k += lowbit(k)) out.push(k);
  return out;
}

const Q_AT = 7;
const Q_PATH = queryPath(Q_AT);
const U_AT = 3;
const U_PATH = updatePath(U_AT, N);

/** แถวของตาราง "ช่องไหนดูแลช่วงไหน" */
const coverRows = Array.from({ length: N }, (_, k) => {
  const i = k + 1;
  const [l, r] = covers(i);
  return {
    i,
    bin: i.toString(2).padStart(4, '0'),
    low: lowbit(i),
    l,
    r,
    len: r - l + 1,
    val: TREE[i],
    sum: rangeSum(l, r),
  };
});

/* ---------- ก้าวของเครื่องเดินทีละขั้น สองตัว คือถามผลรวมและแก้ค่า ----------
   คำอธิบายทุกบรรทัดงอกจาก queryPath/updatePath ตัวเดียวกับที่ตารางใช้
   จึงไม่มีทางที่เรื่องเล่าจะไม่ตรงกับแถวที่เห็น */

const askSteps = Q_PATH.map((i, k) => {
  const [l, r] = covers(i);
  const got = Q_PATH.slice(0, k + 1).reduce((sum, j) => sum + TREE[j], 0);
  const nxt = i - lowbit(i);
  const tail =
    nxt === 0
      ? `แล้ว <b>${i} − ${lowbit(i)} = 0</b> คือสัญญาณว่าไล่ถึงหัวแถวแล้ว จบลูป ผลรวมสุดท้ายคือ <em>${got}</em>`
      : `ช่องนี้ดูแลย้อนไปถึงตำแหน่ง ${l} เท่านั้น ที่เหลือคือช่วง <b>1..${nxt}</b> ซึ่งยังไม่มีใครนับ กระโดดด้วย <b>${i} − ${lowbit(i)} = ${nxt}</b>`;
  return {
    note: `แวะช่อง <b>t[${i}]</b> ซึ่งดูแล <b>a[${l}..${r}]</b> ยาว ${r - l + 1} ช่อง เก็บค่า <b>${TREE[i]}</b> เข้ากระเป๋า รวมได้ <em>${got}</em> ${tail}`,
  };
});

const editSteps = U_PATH.map((i, k) => {
  const [l, r] = covers(i);
  const nxt = i + lowbit(i);
  const tail =
    nxt > N
      ? `แล้ว <b>${i} + ${lowbit(i)} = ${nxt}</b> ซึ่งเลยขอบอาเรย์ (n = ${N}) จบลูป แก้ไปทั้งหมด ${k + 1} ช่อง`
      : `ช่องถัดไปที่ต้องแก้คือช่องที่คลุมเราอยู่และใหญ่ขึ้นหนึ่งชั้น หาได้ด้วย <b>${i} + ${lowbit(i)} = ${nxt}</b>`;
  return {
    note: `แก้ช่อง <b>t[${i}]</b> ซึ่งดูแล <b>a[${l}..${r}]</b> ตำแหน่ง ${U_AT} อยู่ในช่วงนี้ ค่าของช่องนี้จึงต้องขยับตามส่วนต่างที่เข้ามา ${tail}`,
  };
});

/* ---------- ต้นทุนของสามท่า คิดหน่วยเดียวกันคือ "จำนวนครั้งที่แตะช่องข้อมูล" ---------- */

const BIG_N = 200000;
const BIG_Q = 200000;
const LOGN = Math.ceil(Math.log2(BIG_N));

/** สมมติว่าคำถามครึ่งหนึ่งเป็นการถามผลรวม อีกครึ่งเป็นการแก้ค่า */
const HALF = BIG_Q / 2;
const costRows = [
  {
    name: 'ไล่บวกทีละช่องตอนถูกถาม',
    build: '0',
    ask: 'ยาวช่วง สูงสุด n',
    edit: '1',
    total: HALF * BIG_N + HALF * 1,
  },
  {
    name: 'ผลรวมสะสม',
    build: 'n',
    ask: '2',
    edit: 'สร้างใหม่ทั้งแถว n',
    total: BIG_N + HALF * 2 + HALF * BIG_N,
  },
  {
    name: 'ต้นไม้เฟนวิก',
    build: `n log n`,
    ask: `2 log n`,
    edit: `log n`,
    total: BIG_N * LOGN + HALF * 2 * LOGN + HALF * LOGN,
  },
];

const fmt = (n: number): string => n.toLocaleString('en-US');
function human(n: number): string {
  if (n >= 1e9) return `${(n / 1e9).toFixed(1)} พันล้าน`;
  if (n >= 1e6) return `${(n / 1e6).toFixed(1)} ล้าน`;
  return fmt(n);
}

/* ---------- อนิเมชันของ i & -i ----------
   ไล่ให้เห็นว่าทำไมการ and เลขกับค่าลบของตัวเองเหลือบิตต่ำสุดบิตเดียว
   ทุกแถวคำนวณจากเลขจริงด้วยเลขคณิตสองส่วนเติมเต็มบนความกว้าง BITS บิต */

const BIT_I = 12;
const BITS = 5;
const MASK = (1 << BITS) - 1;
const bin = (v: number): string => (v & MASK).toString(2).padStart(BITS, '0');

const bitRows = [
  {
    name: 'i',
    val: BIT_I,
    note: `เริ่มจาก <b>i = ${BIT_I}</b> ซึ่งเขียนฐานสองได้ <b>${bin(BIT_I)}</b> บิตต่ำสุดที่ยังเป็นหนึ่งอยู่ตรงหลักค่า <em>${BIT_I & -BIT_I}</em> ตาแรกเราจะยังไม่ใช้สูตร แต่จะดูให้เห็นก่อนว่าสูตรต้องคายเลขอะไรออกมา`,
  },
  {
    name: 'กลับบิตทุกตัว',
    val: ~BIT_I,
    note: `ขั้นแรกของการทำเลขติดลบคือกลับบิตทุกตัว หลักที่เป็นหนึ่งกลายเป็นศูนย์และกลับกัน ตอนนี้ทุกหลัก<strong>ต่างจากแถวบนหมดทุกหลัก</strong> ซึ่งถ้า and กันตรงนี้จะได้ศูนย์เปล่า ๆ`,
  },
  {
    name: 'บวกหนึ่ง คือ −i',
    val: -BIT_I,
    note: `บวกหนึ่งเข้าไป ตัวทดจะไหลขึ้นจากหลักขวาสุดแล้ว<strong>หยุดตายตัวที่หลักของบิตต่ำสุดเดิม</strong> ผลคือหลักตั้งแต่บิตต่ำสุดลงไปทางขวากลับมาเหมือนแถวแรกอีกครั้ง ส่วนหลักทางซ้ายของมันยังต่างกันอยู่ทุกหลัก`,
  },
  {
    name: 'i & −i',
    val: BIT_I & -BIT_I,
    note: `and สองแถวนี้เข้าด้วยกัน หลักทางซ้ายต่างกันจึงตายทั้งหมด หลักทางขวาของบิตต่ำสุดเป็นศูนย์ทั้งสองฝั่งอยู่แล้ว เหลือรอดหลักเดียวคือบิตต่ำสุดเอง ได้ <b>${BIT_I & -BIT_I}</b> ตรงกับที่ตาแรกเล็งไว้`,
  },
].map((r) => ({ ...r, bits: bin(r.val).split(''), note: r.note }));

const bitSteps = bitRows.map((r) => ({ note: r.note }));

/* ---------- มินิเกม ต่อก้อนให้เต็มช่วง ----------
   คำตอบของทุกชุดหามาด้วยการไล่ทุกสับเซตของช่อง 2^LG_N ชุด
   ซึ่งเป็นวิธีที่บทนี้ไม่ได้สอน จึงใช้ตรวจสิ่งที่บทนี้สอนได้จริง
   ถ้าชุดไหนไม่ตรงกับที่หน้านี้อ้าง บิลด์จะพังทันที ไม่ใช่ปล่อยให้เกมผิดขึ้นเว็บ */

const LG_N = 16;

type LgTask =
  | { id: string; label: string; tease: string; kind: 'cover'; l: number; r: number }
  | { id: string; label: string; tease: string; kind: 'update'; p: number };

const LG_TASKS: LgTask[] = [
  { id: 'c7', label: 'ชุดที่ 1 · เต็มช่วง 1..7', tease: 'เลือกช่องของต้นไม้ให้แถบข้างล่างเป็นสีเขียวพอดีทั้งช่วง 1 ถึง 7 ห้ามมีช่องไหนถูกคลุมสองครั้ง และห้ามล้นออกนอกช่วง', kind: 'cover', l: 1, r: 7 },
  { id: 'c13', label: 'ชุดที่ 2 · เต็มช่วง 1..13', tease: 'ชุดเดิมแต่ปลายทางไกลขึ้น ลองเขียน 13 เป็นเลขฐานสองในใจก่อนแตะช่องแรก', kind: 'cover', l: 1, r: 13 },
  { id: 'u5', label: 'ชุดที่ 3 · แก้ค่าที่ตำแหน่ง 5', tease: 'คราวนี้ค่าที่ตำแหน่ง 5 เปลี่ยนไป เลือกช่องของต้นไม้ทุกช่องที่ค่าของมันต้องขยับตาม ขาดไปช่องเดียวก็ผิด เกินมาช่องเดียวก็ผิด', kind: 'update', p: 5 },
  { id: 'c38', label: 'ชุดที่ 4 · เต็มช่วง 3..8', tease: 'ชุดนี้ขอช่วงที่ไม่ได้เริ่มจากหัวแถว ลองดูว่าต่อได้ไหม ถ้าคิดว่าไม่มีทางต่อได้ ก็มีปุ่มให้ตอบแบบนั้น', kind: 'cover', l: 3, r: 8 },
];

/** ไล่ทุกสับเซตของช่อง 1..LG_N หาชุดที่คลุมช่วง [l,r] พอดีทุกตำแหน่งและไม่ล้นออกนอกช่วง */
function exactCovers(l: number, r: number): number[][] {
  const out: number[][] = [];
  for (let mask = 0; mask < 1 << LG_N; mask++) {
    const cnt = new Array<number>(LG_N + 2).fill(0);
    let bad = false;
    for (let k = 0; k < LG_N && !bad; k++) {
      if ((mask & (1 << k)) === 0) continue;
      const i = k + 1;
      const [cl, cr] = covers(i);
      if (cl < l || cr > r) bad = true;
      else for (let pos = cl; pos <= cr; pos++) if (++cnt[pos] > 1) bad = true;
    }
    if (bad) continue;
    let full = true;
    for (let pos = l; pos <= r; pos++) if (cnt[pos] !== 1) full = false;
    if (!full) continue;
    const pick: number[] = [];
    for (let k = 0; k < LG_N; k++) if (mask & (1 << k)) pick.push(k + 1);
    out.push(pick);
  }
  return out;
}

type LgPuzzle = {
  id: string;
  label: string;
  tease: string;
  kind: 'cover' | 'update';
  n: number;
  l: number;
  r: number;
  answer: number[];
  possible: boolean;
};

const lgPuzzles: LgPuzzle[] = LG_TASKS.map((t) => {
  if (t.kind === 'update') {
    return {
      id: t.id,
      label: t.label,
      tease: t.tease,
      kind: 'update' as const,
      n: LG_N,
      l: t.p,
      r: t.p,
      answer: updatePath(t.p, LG_N),
      possible: true,
    };
  }
  const sols = exactCovers(t.l, t.r);
  return {
    id: t.id,
    label: t.label,
    tease: t.tease,
    kind: 'cover' as const,
    n: LG_N,
    l: t.l,
    r: t.r,
    answer: sols.length > 0 ? sols[0] : [],
    possible: sols.length > 0,
  };
});

/* ยันสิ่งที่หน้านี้อ้างด้วยผลจากการไล่ทุกสับเซต ไม่ใช่ด้วยความเชื่อ */
for (const z of lgPuzzles) {
  if (z.kind !== 'cover') continue;
  const sols = exactCovers(z.l, z.r);
  if (z.l === 1) {
    if (sols.length !== 1) throw new Error(`เกม ${z.id}: ช่วงหัวแถวควรมีทางต่อได้ทางเดียว แต่เจอ ${sols.length} ทาง`);
    const want = queryPath(z.r).slice().sort((x, y) => x - y);
    if (sols[0].join(',') !== want.join(',')) throw new Error(`เกม ${z.id}: ทางเดียวที่ไล่เจอไม่ตรงกับเส้นทางของสูตร i -= i & -i`);
  } else if (sols.length !== 0) {
    throw new Error(`เกม ${z.id}: หน้านี้อ้างว่าต่อไม่ได้ แต่ไล่เจอ ${sols.length} ทาง`);
  }
}
const lgJson = JSON.stringify(lgPuzzles);

/* ---------- ตัวช่วยวาดบันได ---------- */

const CELL = 46;
const PAD_L = 62;
const ROW_H = 25;
const TOP_Y = 40;
const DGM_W = PAD_L + N * CELL + 24;
const DGM_H = TOP_Y + N * ROW_H + 44;

const cellX = (pos: number): number => PAD_L + (pos - 1) * CELL;

/* ---------- สูตร ---------- */

const texPre = texCode(
  `${mc.fn('sum')}(l, r) ${mc.op('=')} ${mc.fn('pre')}[r] ${mc.op('-')} ${mc.fn('pre')}[l ${mc.op('-')} ${mc.num('1')}]`,
);
const texCover = texCode(
  `${mc.fn('t')}[i] ${mc.op('=')} \\sum_{j \\,=\\, i \\,-\\, ${mc.fn('low')}(i) \\,+\\, ${mc.num('1')}}^{i} ${mc.fn('a')}[j] \\qquad ${mc.fn('low')}(i) ${mc.op('=')} i \\;\\&\\; {-i}`,
);
const texRR = texCode(
  `${mc.fn('pre')}(i) ${mc.op('=')} ${mc.fn('b_1')}.${mc.fn('pre')}(i) ${mc.op('\times')} i ${mc.op('-')} ${mc.fn('b_2')}.${mc.fn('pre')}(i)`,
);
const texPre2d = texCode(
  `${mc.fn('sum')} ${mc.op('=')} ${mc.fn('s')}[r_2][c_2] ${mc.op('-')} ${mc.fn('s')}[r_1 ${mc.op('-')} ${mc.num('1')}][c_2] ${mc.op('-')} ${mc.fn('s')}[r_2][c_1 ${mc.op('-')} ${mc.num('1')}] ${mc.op('+')} ${mc.fn('s')}[r_1 ${mc.op('-')} ${mc.num('1')}][c_1 ${mc.op('-')} ${mc.num('1')}]`,
);

/* ---------- โค้ด ---------- */

const preCode = `// ผลรวมสะสม สร้างครั้งเดียวแล้วตอบทุกช่วงในเวลาคงที่
// pre[0] = 0 เสมอ เพื่อให้ช่วงที่เริ่มที่ 1 ไม่ต้องเขียนเงื่อนไขพิเศษ
vector<long long> pre(n + 1, 0);
for (int i = 1; i <= n; i++) pre[i] = pre[i - 1] + a[i];

long long sum = pre[r] - pre[l - 1];   // ผลรวมของ a[l..r]`;

const bitCode = `#include <bits/stdc++.h>
using namespace std;

// ต้นไม้เฟนวิก ดัชนีเริ่มที่ 1 เสมอ เพราะสูตร i & -i ใช้กับ 0 ไม่ได้ (วนไม่รู้จบ)
struct BIT {
    int n;
    vector<long long> t;
    BIT(int n_) : n(n_), t(n_ + 1, 0) {}

    // บวก v เข้าไปที่ตำแหน่ง i แล้วไล่ขึ้นไปแก้ทุกช่องที่ครอบ i อยู่
    void add(int i, long long v) {
        for (; i <= n; i += i & -i) t[i] += v;
    }

    // ผลรวมตั้งแต่ตำแหน่ง 1 ถึง i โดยไล่ตัดทีละก้อนจากขวาเข้าซ้าย
    long long pre(int i) {
        long long s = 0;
        for (; i > 0; i -= i & -i) s += t[i];
        return s;
    }

    long long range(int l, int r) { return pre(r) - pre(l - 1); }
};

int main() {
    int n, q;
    scanf("%d %d", &n, &q);
    BIT b(n);
    vector<long long> a(n + 1, 0);
    for (int i = 1; i <= n; i++) { scanf("%lld", &a[i]); b.add(i, a[i]); }

    while (q--) {
        int op;
        scanf("%d", &op);
        if (op == 1) {                     // แก้ค่าที่ตำแหน่ง i ให้เป็น v
            int i; long long v;
            scanf("%d %lld", &i, &v);
            b.add(i, v - a[i]);            // ส่ง "ส่วนต่าง" เข้าไป ไม่ใช่ค่าใหม่
            a[i] = v;
        } else {                           // ถามผลรวมของช่วง [l, r]
            int l, r;
            scanf("%d %d", &l, &r);
            printf("%lld\\n", b.range(l, r));
        }
    }
    return 0;
}`;

/* ---------- เทคนิคอื่นในกล่องเดียวกัน ----------
   สี่ชิ้นนี้คอมไพล์ด้วย g++ 11.4 แล้วสุ่มเทียบกับตัวไล่ตรง ๆ 3 000 รอบ
   รอบละสุ่มทั้งขนาดอาเรย์ คำสั่ง และค่าติดลบ ตรงกันทุกรอบ */

const buildCode = `// สร้างต้นไม้ในเวลา O(n) แทนที่จะเรียก add ทีละช่อง n log n ครั้ง
// เวอร์ชันนี้เขียนแบบฐานศูนย์ เพราะสูตรที่ใช้คือ i | (i+1) ไม่ใช่ i & -i
// (ทั้งสองแบบคือของอย่างเดียวกัน แค่เลื่อนดัชนีไปหนึ่ง)
vector<long long> b = a;                  // ยืมอาเรย์ต้นฉบับมาเป็นต้นไม้เลย
for (int i = 0; i < n; i++) {
    int r = i | (i + 1);                  // ช่องถัดไปที่ครอบ i อยู่
    if (r < n) b[r] += b[i];              // ยกยอดของช่องนี้ขึ้นไปให้ช่องที่ครอบ
}

// ถามผลรวม 0..i ของเวอร์ชันฐานศูนย์ ตัดก้อนด้วย (i & (i+1)) - 1
long long pre(int i) {
    long long s = 0;
    for (; i >= 0; i = (i & (i + 1)) - 1) s += b[i];
    return s;
}`;

const rangePointCode = `// แก้ค่าเป็นช่วง ถามค่าเป็นจุด ใช้ต้นไม้ใบเดียว
// กลไกคือเก็บ "ส่วนต่างระหว่างช่องกับช่องก่อนหน้า" แทนที่จะเก็บตัวค่า
// พอถามจุด i ก็คือบวกส่วนต่างทั้งหมดตั้งแต่หัวแถว ซึ่งเป็นงานที่ต้นไม้ทำอยู่แล้ว
void addRange(int l, int r, long long v) {
    add(l, v);                 // ตั้งแต่ช่อง l เป็นต้นไป สูงขึ้น v
    if (r + 1 <= n) add(r + 1, -v);   // พ้นช่อง r แล้ว หักคืน v ให้กลับเป็นเดิม
}

long long at(int i) { return pre(i); }   // ค่าที่ตำแหน่ง i คือผลรวมของส่วนต่าง`;

const rangeRangeCode = `// แก้เป็นช่วง ถามเป็นช่วง ใช้ต้นไม้สองใบ
// b1 เก็บส่วนต่างเหมือนหัวข้อก่อน ส่วน b2 เก็บ "ส่วนเกินที่ b1 นับล่วงหน้าไป"
// เพราะ b1.pre(i) * i คิดเหมือนว่าของที่เพิ่มเริ่มตั้งแต่ช่องแรก ซึ่งเกินจริงไปเท่ากับ v*(l-1)
BIT b1(n), b2(n);

void addRange(int l, int r, long long v) {
    b1.add(l, v);
    if (r + 1 <= n) b1.add(r + 1, -v);
    b2.add(l, v * (l - 1));
    if (r + 1 <= n) b2.add(r + 1, -v * r);
}

long long pre(int i) { return b1.pre(i) * i - b2.pre(i); }
long long range(int l, int r) { return pre(r) - pre(l - 1); }`;

const kthCode = `// หาตำแหน่งแรกที่ผลรวมสะสมถึง k โดยไม่ต้องไล่ทีละช่อง
// ใช้ได้เมื่อค่าในต้นไม้ไม่ติดลบ เพราะตอนนั้นผลรวมสะสมเพิ่มขึ้นทางเดียว
// วิธีคือไล่บิตจากใหญ่ลงเล็ก แล้วก้าวเมื่อก้าวได้ ซึ่งอ่านตารางของต้นไม้ตรง ๆ
int kth(long long k) {
    int pos = 0;
    for (int pw = 1 << (31 - __builtin_clz(n)); pw > 0; pw >>= 1) {
        if (pos + pw <= n && t[pos + pw] < k) {
            pos += pw;
            k -= t[pos];        // ก้อนนี้กินไปแล้ว เหลือให้หาอีก k
        }
    }
    return pos + 1;             // ช่องถัดจากที่ก้าวมาไม่ถึง คือช่องที่ทำให้ถึง k
}`;

const q1Code = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int R, C, q;
    scanf("%d %d %d", &R, &C, &q);

    // s[i][j] = ผลรวมของสี่เหลี่ยมตั้งแต่มุมซ้ายบน (1,1) ถึง (i,j)
    vector<vector<long long>> s(R + 1, vector<long long>(C + 1, 0));
    for (int i = 1; i <= R; i++)
        for (int j = 1; j <= C; j++) {
            long long v;
            scanf("%lld", &v);
            // แถวบนกับคอลัมน์ซ้ายทับกันตรงมุมซ้ายบน จึงต้องบวกคืนหนึ่งครั้ง
            s[i][j] = v + s[i - 1][j] + s[i][j - 1] - s[i - 1][j - 1];
        }

    while (q--) {
        int r1, c1, r2, c2;
        scanf("%d %d %d %d", &r1, &c1, &r2, &c2);
        printf("%lld\\n", s[r2][c2] - s[r1 - 1][c2] - s[r2][c1 - 1] + s[r1 - 1][c1 - 1]);
    }
    return 0;
}`;

const q2Code = `#include <bits/stdc++.h>
using namespace std;

int n;
vector<int> t;
void add(int i) { for (; i <= n; i += i & -i) t[i]++; }
int pre(int i) { int s = 0; for (; i > 0; i -= i & -i) s += t[i]; return s; }

int main() {
    scanf("%d", &n);
    vector<int> a(n);
    for (auto& x : a) scanf("%d", &x);

    // ค่าอาจใหญ่หรือติดลบ ย่อให้เป็นอันดับ 1..n ก่อน ต้นไม้จะได้มีขนาดเท่า n
    vector<int> v = a;
    sort(v.begin(), v.end());
    v.erase(unique(v.begin(), v.end()), v.end());

    t.assign(n + 1, 0);
    long long ans = 0;
    for (int i = n - 1; i >= 0; i--) {          // เดินจากขวาไปซ้าย
        int r = lower_bound(v.begin(), v.end(), a[i]) - v.begin() + 1;
        ans += pre(r - 1);                      // ของที่อยู่ขวาแล้วเล็กกว่า a[i]
        add(r);
    }
    printf("%lld\\n", ans);
    return 0;
}`;

const q3Code = `#include <bits/stdc++.h>
using namespace std;

int main() {
    int n; long long D;
    scanf("%d %lld", &n, &D);
    vector<long long> a(n);
    for (auto& x : a) scanf("%lld", &x);

    sort(a.begin(), a.end());
    long long ans = 0;
    int l = 0;
    for (int r = 0; r < n; r++) {
        while (a[r] - a[l] > D) l++;   // ตัวชี้ซ้ายเดินหน้าอย่างเดียว ไม่เคยถอย
        ans += r - l;                  // ทุกตัวใน [l, r-1] จับคู่กับ r ได้
    }
    printf("%lld\\n", ans);
    return 0;
}`;
/* ---------- มินิเกม ตอบผลรวมของช่วง โดยมีการแก้ค่าคั่นกลาง ----------
   คำตอบของทุกคำถามคิดจากอาเรย์จริงตอนบิลด์ ด้วยการวนบวกตรง ๆ
   ไม่ได้ใช้ผลรวมสะสมหรือต้นไม้เฟนวิกที่บทนี้กำลังจะสอน */
type PsOp =
  | { kind: 'ask'; l: number; r: number }
  | { kind: 'set'; i: number; v: number };

type PsPuzzle = { id: string; label: string; tease: string; arr: number[]; ops: PsOp[] };

const PS_PUZZLES: PsPuzzle[] = [
  {
    id: 'p1',
    label: 'ชุดที่ 1 · ไม่มีการแก้ค่า',
    tease: 'ชุดนี้ถามอย่างเดียว ไม่มีการแก้ค่าเลย',
    arr: [3, 1, 4, 1, 5, 9, 2, 6],
    ops: [
      { kind: 'ask', l: 2, r: 5 },
      { kind: 'ask', l: 1, r: 8 },
      { kind: 'ask', l: 6, r: 6 },
    ],
  },
  {
    id: 'p2',
    label: 'ชุดที่ 2 · มีการแก้ค่า',
    tease: 'ชุดนี้มีการแก้ค่าคั่นกลาง ลองสังเกตว่าของที่เตรียมไว้ยังใช้ได้ไหม',
    arr: [2, 7, 1, 8, 2, 8],
    ops: [
      { kind: 'ask', l: 1, r: 3 },
      { kind: 'set', i: 2, v: 0 },
      { kind: 'ask', l: 1, r: 3 },
      { kind: 'ask', l: 2, r: 6 },
      { kind: 'set', i: 6, v: 10 },
      { kind: 'ask', l: 4, r: 6 },
    ],
  },
];

type PsStep = { kind: string; text: string; answer: number; arr: number[] };
type PsPuzzleData = { id: string; label: string; tease: string; arr: number[]; steps: PsStep[] };

const psPuzzles: PsPuzzleData[] = PS_PUZZLES.map((p) => {
  const cur = [...p.arr];
  const steps: PsStep[] = [];
  for (const op of p.ops) {
    if (op.kind === 'set') {
      cur[op.i - 1] = op.v;
      steps.push({
        kind: 'set',
        text: `แก้ช่องที่ ${op.i} ให้เป็น ${op.v}`,
        answer: -1,
        arr: [...cur],
      });
    } else {
      let s = 0;
      for (let k = op.l - 1; k <= op.r - 1; k++) s += cur[k];
      steps.push({
        kind: 'ask',
        text: `ผลรวมช่องที่ ${op.l} ถึง ${op.r}`,
        answer: s,
        arr: [...cur],
      });
    }
  }
  return { id: p.id, label: p.label, tease: p.tease, arr: p.arr, steps };
});
const psJson = JSON.stringify(psPuzzles);

/* ---------- ท่าที่สาม แบ่งราก ----------
   โค้ดสองชิ้นนี้คอมไพล์แล้วสุ่มเทียบกัน 700 รอบ ตรงกันหมด
   และวัดเวลาที่ขอบเขตจริงได้ 0.08 วินาที */
const SQ_N = 200000;
const SQ_Q = 200000;
const sqBlock = Math.round(Math.sqrt(SQ_N));
const sqRows = [
  { name: 'ไม่ทำอะไรเลย ถามก็บวกทีละช่อง', per: 'ถาม n · แก้ 1', total: SQ_Q * SQ_N },
  { name: 'แบ่งราก', per: 'ถาม 2√n · แก้ 1', total: SQ_Q * 2 * sqBlock },
  { name: 'ต้นไม้เฟนวิก', per: 'ถาม log n · แก้ log n', total: SQ_Q * 2 * 18 },
];
const sqrtCode = `// แบ่งราก (sqrt decomposition): ผลรวมของช่วง กับแก้ทีละช่อง
// อินพุต: n q, อาเรย์ n ตัว, แล้ว q บรรทัด
//   1 i v  -> ตั้ง a[i] = v (i เริ่มจาก 0)
//   2 l r  -> ถามผลรวมช่อง l..r
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, q;
    if (scanf("%d %d", &n, &q) != 2) return 0;
    vector<long long> a(n);
    for (int i = 0; i < n; i++) scanf("%lld", &a[i]);

    int B = max(1, (int)sqrt((double)n));       // ขนาดของก้อน
    int nb = (n + B - 1) / B;
    vector<long long> blk(nb, 0);
    for (int i = 0; i < n; i++) blk[i / B] += a[i];

    for (int t = 0; t < q; t++) {
        int op; scanf("%d", &op);
        if (op == 1) {
            int i; long long v; scanf("%d %lld", &i, &v);
            blk[i / B] += v - a[i];              // ก้อนที่ i อยู่ ขยับตามส่วนต่าง
            a[i] = v;
        } else {
            int l, r; scanf("%d %d", &l, &r);
            long long sum = 0;
            int bl = l / B, br = r / B;
            if (bl == br) {                      // อยู่ก้อนเดียวกัน เดินทีละช่อง
                for (int i = l; i <= r; i++) sum += a[i];
            } else {
                for (int i = l; i < (bl + 1) * B; i++) sum += a[i];        // เศษหัว
                for (int b = bl + 1; b < br; b++) sum += blk[b];           // ก้อนเต็มกลาง
                for (int i = br * B; i <= r; i++) sum += a[i];             // เศษท้าย
            }
            printf("%lld\\n", sum);
        }
    }
    return 0;
}`;
const sqrtBrute = `// ตัวตรวจอิสระของแบ่งราก: เก็บอาเรย์เปล่า ถามก็บวกทีละช่อง
// ไม่มีก้อน ไม่มีรากที่สอง จึงไม่ได้ทดสอบแค่การพิมพ์
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, q;
    if (scanf("%d %d", &n, &q) != 2) return 0;
    vector<long long> a(n);
    for (int i = 0; i < n; i++) scanf("%lld", &a[i]);
    for (int t = 0; t < q; t++) {
        int op; scanf("%d", &op);
        if (op == 1) {
            int i; long long v; scanf("%d %lld", &i, &v);
            a[i] = v;
        } else {
            int l, r; scanf("%d %d", &l, &r);
            long long sum = 0;
            for (int i = l; i <= r; i++) sum += a[i];
            printf("%lld\\n", sum);
        }
    }
    return 0;
}`;

