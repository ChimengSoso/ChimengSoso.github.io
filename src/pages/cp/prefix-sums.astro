</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import { initCpRowPlayers } from '../../lib/cpPlayer';
  import type { CpGameUi } from '../../lib/cpGame';

  type PsStep = { kind: string; text: string; answer: number; arr: number[] };
  type PsPuzzle = { id: string; label: string; tease: string; arr: number[]; steps: PsStep[] };

  function initPrefixGame(): void {
    const maybeUi = cpGameUi('[data-psgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as PsPuzzle[];
    if (puzzles.length === 0) return;

    const stripEl = ui.root.querySelector<HTMLElement>('[data-ps-strip]');
    const taskEl = ui.root.querySelector<HTMLElement>('[data-ps-task]');
    const padEl = ui.root.querySelector<HTMLElement>('[data-ps-pad]');
    const typedEl = ui.root.querySelector<HTMLElement>('[data-ps-typed]');
    const scoreEl = ui.root.querySelector<HTMLElement>('[data-ps-right]');
    const totalEl = ui.root.querySelector<HTMLElement>('[data-ps-total]');
    if (!stripEl || !taskEl || !padEl || !typedEl || !scoreEl || !totalEl) return;
    const strip: HTMLElement = stripEl;
    const taskOut: HTMLElement = taskEl;
    const pad: HTMLElement = padEl;
    const typedOut: HTMLElement = typedEl;
    const rightOut: HTMLElement = scoreEl;
    const totalOut: HTMLElement = totalEl;

    let pi = 0;
    let si = 0;
    let typed = '';
    let right = 0;

    const pz = (): PsPuzzle => puzzles[pi];
    const step = (): PsStep | undefined => pz().steps[si];

    function buildPad(): void {
      pad.textContent = '';
      for (const d of ['1', '2', '3', '4', '5', '6', '7', '8', '9', '0']) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cpg-btn ps-key';
        b.dataset.digit = d;
        b.textContent = d;
        pad.appendChild(b);
      }
    }

    function render(): void {
      const p = pz();
      const st = step();
      const arr = st ? st.arr : p.arr;
      strip.textContent = '';
      arr.forEach((v, i) => {
        const cell = document.createElement('span');
        cell.className = 'ps-cell';
        const idx = document.createElement('small');
        idx.textContent = String(i + 1);
        const val = document.createElement('b');
        val.textContent = String(v);
        cell.append(idx, val);
        if (st && st.kind === 'ask') {
          const m = st.text.match(/(\d+) ถึง (\d+)/);
          if (m && i + 1 >= Number(m[1]) && i + 1 <= Number(m[2])) cell.classList.add('in');
        }
        strip.appendChild(cell);
      });
      taskOut.textContent = st ? st.text : 'จบชุดนี้แล้ว';
      typedOut.textContent = typed === '' ? '-' : typed;
      rightOut.textContent = String(right);
      totalOut.textContent = String(p.steps.filter((x) => x.kind === 'ask').length);
    }

    function advanceThroughSets(): void {
      // ข้ามขั้นที่เป็นการแก้ค่าไปเอง เพราะไม่ต้องให้ผู้เล่นตอบ
      while (step() !== undefined && (step() as PsStep).kind === 'set') {
        ui.setStatus(`${(step() as PsStep).text} แล้ว ของที่เตรียมไว้ก่อนหน้านี้อาจใช้ไม่ได้อีก`, 'plain');
        si++;
      }
    }

    function submit(): void {
      const st = step();
      if (st === undefined) {
        ui.setStatus('จบชุดนี้แล้วครับ', 'plain');
        return;
      }
      if (typed === '') {
        ui.setStatus('พิมพ์คำตอบก่อนครับ', 'bad');
        return;
      }
      if (Number(typed) === st.answer) {
        right++;
        ui.setStatus(`ถูกต้อง ${st.text} เท่ากับ ${st.answer}`, 'good');
      } else {
        ui.setStatus(`ยังไม่ใช่ ${st.text} เท่ากับ ${st.answer}`, 'bad');
      }
      typed = '';
      si++;
      advanceThroughSets();
      render();
      if (step() === undefined) {
        const p = pz();
        const asks = p.steps.filter((x) => x.kind === 'ask').length;
        ui.setStatus(`จบชุดนี้ ตอบถูก ${right} จาก ${asks} ข้อ`, right === asks ? 'good' : 'bad');
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      si = 0;
      typed = '';
      right = 0;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildPad();
      advanceThroughSets();
      ui.setStatus('อ่านคำถามแล้วพิมพ์ผลรวมของช่วงที่ถูกไฮไลต์');
      render();
    }

    pad.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('[data-digit]');
      if (!(b instanceof HTMLElement)) return;
      typed += b.dataset.digit ?? '';
      render();
    });

    ui.onClick('data-ps-clear', () => {
      typed = '';
      render();
    });
    ui.onClick('data-ps-submit', submit);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  /* ---------- เกมต่อก้อนให้เต็มช่วง ----------
     กระดานสร้างจาก n ของชุดโจทย์ ส่วนคำตอบมาจาก data attribute ที่คิดไว้ตอนบิลด์
     หน้าเว็บจึงไม่มีตัวแก้โจทย์อยู่ในตัว และตัวเลขที่ตรวจก็ตัวเดียวกับที่บิลด์ยืนยันแล้ว */

  type LgPuzzle = {
    id: string;
    label: string;
    tease: string;
    kind: 'cover' | 'update';
    n: number;
    l: number;
    r: number;
    answer: number[];
    possible: boolean;
  };

  function initLowGame(): void {
    const maybeUi = cpGameUi('[data-lowgame]');
    if (!maybeUi) return;
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as LgPuzzle[];
    if (puzzles.length === 0) return;

    const stripHost = ui.root.querySelector<HTMLElement>('[data-lg-strip]');
    const cellsHost = ui.root.querySelector<HTMLElement>('[data-lg-cells]');
    const infoHost = ui.root.querySelector<HTMLElement>('[data-lg-info]');
    const doneHost = ui.root.querySelector<HTMLElement>('[data-lg-done]');
    if (!stripHost || !cellsHost || !infoHost || !doneHost) return;

    const strip: HTMLElement = stripHost;
    const cells: HTMLElement = cellsHost;
    const info: HTMLElement = infoHost;
    const done: HTMLElement = doneHost;

    const lowbit = (i: number): number => i & -i;
    const N = puzzles[0].n;

    /* กระดานสร้างครั้งเดียว ทุกชุดใช้ขนาดเดียวกัน สลับชุดแล้วแค่ล้างที่เลือก */
    const posEls: HTMLElement[] = [];
    const chipEls: HTMLButtonElement[] = [];
    for (let i = 1; i <= N; i++) {
      const cell = document.createElement('span');
      cell.className = 'lg-pos';
      cell.textContent = String(i);
      strip.appendChild(cell);
      posEls.push(cell);

      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'lg-chip';
      chip.dataset.i = String(i);
      chip.innerHTML = `<b>t[${i}]</b><i>${i.toString(2).padStart(5, '0')}</i>`;
      chip.setAttribute('aria-pressed', 'false');
      chip.setAttribute('aria-label', `ช่องที่ ${i} ของต้นไม้`);
      cells.appendChild(chip);
      chipEls.push(chip);
    }

    let at = 0;
    let picked = new Set<number>();
    const solved = new Set<string>();

    const counts = (): number[] => {
      const cnt = new Array<number>(N + 2).fill(0);
      for (const i of picked) {
        const from = i - lowbit(i) + 1;
        for (let pos = from; pos <= i; pos++) cnt[pos]++;
      }
      return cnt;
    };

    const render = (): void => {
      const z = puzzles[at];
      const cnt = counts();
      let exact = 0;
      let over = 0;
      let outside = 0;
      for (let pos = 1; pos <= N; pos++) {
        const el = posEls[pos - 1];
        const inTarget = z.kind === 'cover' ? pos >= z.l && pos <= z.r : pos === z.l;
        el.className = 'lg-pos';
        if (inTarget) el.classList.add('is-target');
        if (cnt[pos] >= 2) {
          el.classList.add('is-over');
          over++;
        } else if (cnt[pos] === 1) {
          el.classList.add(inTarget ? 'is-exact' : 'is-outside');
          if (inTarget) exact++;
          else outside++;
        }
      }
      for (const chip of chipEls) chip.setAttribute('aria-pressed', picked.has(Number(chip.dataset.i)) ? 'true' : 'false');
      for (const chip of chipEls) chip.classList.toggle('is-on', picked.has(Number(chip.dataset.i)));

      if (z.kind === 'cover') {
        const want = z.r - z.l + 1;
        info.textContent = `เลือกไว้ ${picked.size} ช่อง · คลุมพอดี ${exact} จาก ${want} ตำแหน่ง · ทับกัน ${over} ตำแหน่ง · ล้นออกนอกช่วง ${outside} ตำแหน่ง`;
      } else {
        let hit = 0;
        for (const i of picked) if (i - lowbit(i) + 1 <= z.l && z.l <= i) hit++;
        info.textContent = `เลือกไว้ ${picked.size} ช่อง · ในนั้นคลุมตำแหน่ง ${z.l} อยู่ ${hit} ช่อง`;
      }
      done.textContent = String(solved.size);
    };

    const win = (msg: string): void => {
      solved.add(puzzles[at].id);
      ui.setStatus(msg, 'good');
      render();
    };

    const check = (): void => {
      const z = puzzles[at];
      if (picked.size === 0) {
        ui.setStatus('ยังไม่ได้เลือกช่องไหนเลยครับ', 'bad');
        return;
      }
      if (z.kind === 'update') {
        const want = new Set(z.answer);
        const missing = z.answer.filter((i) => !picked.has(i)).length;
        const extra = [...picked].filter((i) => !want.has(i)).length;
        if (missing === 0 && extra === 0) {
          win(`ถูกครับ ทั้ง ${z.answer.length} ช่องนี้คือทุกช่องที่ช่วงของมันคลุมตำแหน่ง ${z.l} อยู่ และมันคือเส้นทางของ i += i & -i พอดี`);
          return;
        }
        ui.setStatus(`ยังไม่ครบ ขาดไป ${missing} ช่อง และเกินมา ${extra} ช่อง`, 'bad');
        return;
      }
      const cnt = counts();
      let bad = 0;
      for (let pos = 1; pos <= N; pos++) {
        const inTarget = pos >= z.l && pos <= z.r;
        if (inTarget && cnt[pos] !== 1) bad++;
        if (!inTarget && cnt[pos] !== 0) bad++;
      }
      if (bad === 0) {
        const min = z.answer.length;
        const extra = picked.size > min ? ` (มีทางที่ใช้แค่ ${min} ช่องด้วย)` : '';
        win(`เต็มพอดีครับ ใช้ ${picked.size} ช่อง${extra} จำนวนช่องที่น้อยที่สุดเท่ากับจำนวนเลขหนึ่งในเลขฐานสองของ ${z.r} เสมอ`);
        return;
      }
      ui.setStatus(`ยังไม่พอดี มี ${bad} ตำแหน่งที่ยังไม่ถูกคลุมครั้งเดียวเป๊ะ ดูสีในแถบข้างบนได้ครับ`, 'bad');
    };

    const sayImpossible = (): void => {
      const z = puzzles[at];
      if (!z.possible) {
        win('ถูกครับ ชุดนี้ต่อไม่ได้จริง ช่องเดียวที่คลุมตำแหน่งซ้ายสุดของช่วงได้แบบไม่ล้น คือช่องที่คลุมแค่ตัวมันเอง แล้วตำแหน่งถัดไปก็ไม่มีช่องไหนคลุมได้อีกโดยไม่ลากย้อนไปถึงหัวแถว');
        return;
      }
      ui.setStatus('ชุดนี้ต่อได้ครับ ลองอีกที', 'bad');
    };

    const select = (k: number): void => {
      at = k;
      picked = new Set<number>();
      ui.selectTab(k);
      ui.setTease(puzzles[k].tease);
      ui.setStatus('แตะปุ่มช่องของต้นไม้ แล้วดูแถบข้างบนเปลี่ยนสี');
      render();
    };

    for (const chip of chipEls) {
      chip.addEventListener('click', () => {
        const i = Number(chip.dataset.i);
        if (picked.has(i)) picked.delete(i);
        else picked.add(i);
        render();
      });
    }

    ui.onClick('data-lg-clear', () => {
      picked = new Set<number>();
      ui.setStatus('ล้างแล้ว เริ่มใหม่ได้เลย');
      render();
    });
    ui.onClick('data-lg-check', check);
    ui.onClick('data-lg-imp', sayImpossible);
    ui.onTab(select);
    select(0);
  }

  document.addEventListener('astro:page-load', initPrefixGame);
  document.addEventListener('astro:page-load', initLowGame);
  document.addEventListener('astro:page-load', () => {
    initCpRowPlayers('[data-bitsim]');
    initCpRowPlayers('[data-asksim]');
    initCpRowPlayers('[data-editsim]');
  });
</script>
