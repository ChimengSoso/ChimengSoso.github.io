    <div class="cpg-scroll">
      <svg class="dst-chsvg" viewBox={`${CH_VB_X} 0 ${CH_W} ${CH_H}`} width={CH_W} height={CH_H} xmlns="http://www.w3.org/2000/svg" role="img" aria-label="โซ่หกจุดเรียงจากรากลงไปหา v มีเส้นโค้งสามเส้นแทนข้อบังคับที่ยังค้าง จาก v ขึ้นไปหา u ที่ความลึก 2, 3 และ 4">
        {Array.from({ length: CH_N - 1 }, (_, i) => i + 1).map((k) => (
          <line data-ch-edge={String(k)} x1={CH_X} y1={chY(k)} x2={CH_X} y2={chY(k + 1)} stroke="#39425e" stroke-width="3" />
        ))}
        {Array.from({ length: CH_N }, (_, i) => i + 1).map((d) => (
          <circle cx={CH_X} cy={chY(d)} r="13" fill="#121a2b" stroke="#2f9e5c" stroke-width="1.5" />
        ))}
        {Array.from({ length: CH_N }, (_, i) => i + 1).map((d) => (
          <text x={CH_X - 24} y={chY(d) + 4} text-anchor="end" fill="#7b8397" font-size="12">ลึก {d}</text>
        ))}
        <text x={CH_X} y={chY(CH_N) + 4} text-anchor="middle" fill="#eaf2ff" font-size="11">v</text>
        {CH_ARCS.map((c) => (
          <path data-ch-arc={String(c.a)} d={`M ${CH_X + 14} ${chY(c.a)} C ${c.x} ${chY(c.a)}, ${c.x} ${chY(CH_N)}, ${CH_X + 14} ${chY(CH_N)}`} fill="none" stroke="#e07a7a" stroke-width="2" stroke-dasharray="5 4" />
        ))}
        {CH_ARCS.map((c) => (
          <text x={c.x - 4} y={chY(c.a) - 6} fill="#cdd6ea" font-size="11">u ลึก {c.a}</text>
