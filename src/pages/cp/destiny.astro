    'คราวนี้สามคู่ และคู่ (1, 7) มีวิถียาวแค่สองเส้น ลองดูว่าถ้าไม่เปิดเส้น 1-2 คุณเหลือทางเลือกกี่ทาง',
    'ถ้าปิดเส้น 1-2 คู่ (1, 7) เหลือทางรอดทางเดียว',
    PZ_THREE,
    41,
  ),
];
const puzzlesJson = JSON.stringify(puzzles);

/* ---------- เวลาที่วัดได้จริง ----------
   วัดบน WSL Ubuntu 22.04, g++ 11.4.0, คอมไพล์ด้วย -O2, /usr/bin/time, เอาค่าที่แย่ที่สุดจากสามรอบ
   ชุดทดสอบสร้างด้วย destiny_genbig.cpp ทุกชุด N = M = 500,000 ยกเว้นแถวสองแถวล่าง */
