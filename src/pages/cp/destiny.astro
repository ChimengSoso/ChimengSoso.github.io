<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';
  import { initCpPlayers } from '../../lib/cpPlayer';

  type DstNode = { id: number; x: number; y: number };
  type DstEdge = { id: number; name: string; x1: number; y1: number; x2: number; y2: number; lx: number; ly: number };
  type DstPair = { u: number; v: number; edges: number[] };
  type DstPuzzle = {
    id: string;
    label: string;
    tease: string;
    hint: string;
    w: number;
    h: number;
    nodes: DstNode[];
    edges: DstEdge[];
    pairs: DstPair[];
    total: number;
    answer: number;
  };

  const SVG_NS = 'http://www.w3.org/2000/svg';

  function svgEl(name: string, attrs: Record<string, string>): SVGElement {
    const el = document.createElementNS(SVG_NS, name);
    for (const k of Object.keys(attrs)) el.setAttribute(k, attrs[k]);
    return el;
  }

  function initDestinyGame(): void {
    const maybeUi = cpGameUi('[data-dstgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as DstPuzzle[];
    const maybeBoard = ui.root.querySelector<HTMLElement>('[data-dst-board]');
    const maybePairs = ui.root.querySelector<HTMLElement>('[data-dst-pairs]');
    if (puzzles.length === 0 || !maybeBoard || !maybePairs) return;
    const board: HTMLElement = maybeBoard;
    const pairsEl: HTMLElement = maybePairs;

    let pi = 0;
    let mask = 0;
    const found: Set<number>[] = puzzles.map(() => new Set<number>());
    const pz = (): DstPuzzle => puzzles[pi];

    function uncoveredPairs(): DstPair[] {
      return pz().pairs.filter((q) => !q.edges.some((e) => (mask >> e) & 1));
    }

    function drawBoard(): void {
      const p = pz();
      const bad = uncoveredPairs();
      board.textContent = '';
      const svg = svgEl('svg', {
        viewBox: `0 0 ${p.w} ${p.h}`,
        width: String(p.w),
        height: String(p.h),
        role: 'group',
        'aria-label': 'ต้นไม้ของปริศนา แตะป้ายบนเส้นเพื่อสลับ 0 กับ 1',
      });
      /* วิถีของคู่แรกที่ยังไม่ผ่าน เน้นไว้ข้างหลังเส้นจริง เน้นทีละคู่ จะได้ไม่ทับกันจนอ่านไม่ออก */
      if (bad.length > 0) {
        for (const e of bad[0].edges) {
          const ed = p.edges[e];
          svg.append(
            svgEl('line', {
              x1: String(ed.x1),
              y1: String(ed.y1),
              x2: String(ed.x2),
              y2: String(ed.y2),
              stroke: '#b23b3b',
              'stroke-width': '14',
              'stroke-linecap': 'round',
              'stroke-opacity': '0.38',
            }),
          );
        }
      }
      for (const ed of p.edges) {
        const on = ((mask >> ed.id) & 1) === 1;
        const g = svgEl('g', {
          class: 'dst-edge',
          tabindex: '0',
          role: 'button',
          'aria-label': `เส้น ${ed.name} ตอนนี้เป็น ${on ? '1' : '0'}`,
        });
        g.setAttribute('data-dst-edge', String(ed.id));
        g.append(
          svgEl('line', { class: 'dst-hit', x1: String(ed.x1), y1: String(ed.y1), x2: String(ed.x2), y2: String(ed.y2) }),
          svgEl('line', {
            x1: String(ed.x1),
            y1: String(ed.y1),
            x2: String(ed.x2),
            y2: String(ed.y2),
            stroke: on ? '#4ade80' : '#39425e',
            'stroke-width': on ? '5' : '2.5',
            'stroke-dasharray': on ? 'none' : '6 5',
          }),
          svgEl('rect', {
            x: String(ed.lx - 13),
            y: String(ed.ly - 12),
            width: '26',
            height: '24',
            rx: '7',
            fill: on ? '#10291d' : '#121a2b',
            stroke: on ? '#2f9e5c' : '#39425e',
            'stroke-width': '1.2',
          }),
        );
        const t = svgEl('text', {
          x: String(ed.lx),
          y: String(ed.ly + 5),
          fill: on ? '#a7f3c4' : '#9aa7bd',
          'font-size': '13',
          'text-anchor': 'middle',
          'font-family': 'monospace',
        });
        t.textContent = on ? '1' : '0';
        g.append(t);
        svg.append(g);
      }
      for (const nd of p.nodes) {
        svg.append(
          svgEl('circle', { cx: String(nd.x), cy: String(nd.y), r: '17', fill: '#121a2b', stroke: '#2f9e5c', 'stroke-width': '1.5' }),
        );
        const t = svgEl('text', {
          x: String(nd.x),
          y: String(nd.y + 5),
          fill: '#eaf2ff',
          'font-size': '13',
          'text-anchor': 'middle',
        });
        t.textContent = String(nd.id);
        svg.append(t);
      }
      board.append(svg);

      pairsEl.textContent = '';
      for (const q of pz().pairs) {
        const ok = q.edges.some((e) => (mask >> e) & 1);
        const chip = document.createElement('span');
        chip.className = ok ? 'dst-chip ok' : 'dst-chip no';
        chip.textContent = `${q.u} > ${q.v} ${ok ? 'ผ่าน' : 'ยังไม่ผ่าน'}`;
        pairsEl.append(chip);
      }
    }

    function scoreLine(): void {
      const p = pz();
      const n = found[pi].size;
      if (n === 0) {
        ui.setScore('ยังไม่เจอแบบที่ผ่าน');
        return;
      }
      ui.setScore(`คุณเจอแบบที่ผ่านแล้ว ${n} แบบ · ต้นนี้มีทั้งหมด ${p.answer} แบบ จาก ${p.total} แบบที่ระบายได้`);
    }

    function report(): void {
      const p = pz();
      const bad = uncoveredPairs();
      if (bad.length > 0) {
        ui.setStatus(`คู่ (${bad[0].u}, ${bad[0].v}) ยังไม่มีเส้นสำคัญคั่น วิถีของมันคือเส้นที่เน้นสีแดง`, 'bad');
        scoreLine();
        return;
      }
      const fresh = !found[pi].has(mask);
      found[pi].add(mask);
      const ones = p.edges.filter((ed) => (mask >> ed.id) & 1).length;
      if (mask === (1 << p.edges.length) - 1) {
        ui.setStatus(
          `ผ่านครับ แต่การเปิดทุกเส้นเป็นแบบที่ง่ายที่สุด และมันเป็นแค่ 1 ใน ${p.answer} แบบ ลองหาแบบที่ใช้เส้นสำคัญน้อยกว่านี้`,
          'good',
        );
      } else if (fresh) {
        ui.setStatus(`ผ่านครับ ใช้เส้นสำคัญ ${ones} เส้น นี่เป็นแบบใหม่ที่คุณยังไม่เคยเจอ`, 'good');
      } else {
        ui.setStatus(`ผ่านครับ ใช้เส้นสำคัญ ${ones} เส้น แต่แบบนี้คุณเคยเจอไปแล้ว`, 'good');
      }
      scoreLine();
    }

    function toggle(id: number): void {
      mask ^= 1 << id;
      drawBoard();
      report();
    }

    function selectPuzzle(k: number): void {
      pi = k;
      mask = 0;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      drawBoard();
      ui.setStatus(`แตะป้ายบนเส้นเพื่อสลับ 0 กับ 1 คำใบ้: ${pz().hint}`);
      scoreLine();
    }

    board.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const g = e.target.closest('[data-dst-edge]');
      if (!(g instanceof SVGElement)) return;
      const id = g.getAttribute('data-dst-edge');
      if (id !== null) toggle(Number(id));
    });
    board.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      if (!(e.target instanceof Element)) return;
      const g = e.target.closest('[data-dst-edge]');
      if (!(g instanceof SVGElement)) return;
      const id = g.getAttribute('data-dst-edge');
      if (id === null) return;
      e.preventDefault();
      toggle(Number(id));
    });
    ui.onClick('data-dst-all', () => {
      mask = (1 << pz().edges.length) - 1;
      drawBoard();
      report();
    });
    ui.onClick('data-dst-clear', () => {
      mask = 0;
      drawBoard();
      report();
    });
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initDestinyGame);

  /* เกมข้อค้างหลายข้อ: เลือกขอบที่ระบายเป็น 1 ได้ทีละเส้น แล้วดูว่าปิดข้อบังคับข้อไหนได้
     ขอบระหว่างลึก k กับ k + 1 ปิดข้อที่ u ลึก a ได้ก็ต่อเมื่อ k >= a (ขอบอยู่บนวิถีจาก u ลงไปหา v) */
  function initChainGame(): void {
    const maybeUi = cpGameUi('[data-dstchain]');
    if (!maybeUi) return;
    const ui: CpGameUi = maybeUi;
    const arcs = Array.from(ui.root.querySelectorAll<SVGPathElement>('[data-ch-arc]'));
    const edges = Array.from(ui.root.querySelectorAll<SVGLineElement>('[data-ch-edge]'));
    const btns = Array.from(ui.root.querySelectorAll<HTMLButtonElement>('[data-ch-pick]'));
    const hintEl = ui.root.querySelector<HTMLElement>('[data-cpg-hint]');
    const us = arcs.map((a) => Number(a.dataset.chArc));
    const deepest = Math.max(...us);
    const tried = new Set<number>();

    function pick(k: number): void {
      tried.add(k);
      const closed = us.filter((a) => k >= a);
      edges.forEach((e) => {
        const on = Number(e.dataset.chEdge) === k;
        e.setAttribute('stroke', on ? '#d4af37' : '#39425e');
        e.setAttribute('stroke-width', on ? '6' : '3');
      });
      arcs.forEach((a) => {
        const ok = k >= Number(a.dataset.chArc);
        a.setAttribute('stroke', ok ? '#6ee7a8' : '#e07a7a');
        a.setAttribute('stroke-dasharray', ok ? '' : '5 4');
      });
      btns.forEach((b) => b.classList.toggle('main', Number(b.dataset.chPick) === k));
      ui.setStatus(
        closed.length === us.length
          ? `ขอบลึก ${k} ถึง ${k + 1} ปิดได้ครบทั้ง ${us.length} ข้อ`
          : `ขอบลึก ${k} ถึง ${k + 1} ปิดได้ ${closed.length} จาก ${us.length} ข้อ ข้อที่ u ลึก ${us.filter((a) => k < a).join(', ')} ยังค้าง`,
        closed.length === us.length ? 'good' : 'bad',
      );
      ui.setScore(`ลองแล้ว ${tried.size} จาก ${btns.length} ขอบ`);
      if (hintEl) hintEl.textContent = tried.size === btns.length
        ? `ขอบที่ปิดได้ครบคือทุกขอบที่อยู่ใต้ u ที่ลึกที่สุด (ลึก ${deepest}) ลงไปถึง v ข้อที่ตื้นกว่าปิดตามไปเองเสมอ จึงจำแค่ความลึกของข้อที่ลึกที่สุดก็พอ`
        : '';
    }
    btns.forEach((b) => b.addEventListener('click', () => pick(Number(b.dataset.chPick))));
  }
  document.addEventListener('astro:page-load', initChainGame);

  /* เครื่องเดินตาราง dp: หนึ่งขั้นคือหนึ่งจุด แถวของตารางทยอยเผย และจุดบนต้นไม้เปลี่ยนสีตาม
     ตั้งสีผ่าน attribute ตรง ๆ เพราะสไตล์ scoped ของหน้าไม่ได้คุมสีของจุดอยู่แล้ว */
  type DpStep = { note: string; v: number };
  function isDpStep(x: unknown): x is DpStep {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return typeof o.note === 'string' && typeof o.v === 'number';
  }
  document.addEventListener('astro:page-load', () => {
    initCpPlayers<DpStep>('[data-dstdp]', {
      narrow: (raw) => {
        const ok = raw.filter(isDpStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      draw: (st, ctx) => {
        const root = ctx.parts.root;
        const rows = Array.from(root.querySelectorAll<HTMLTableRowElement>('tbody tr'));
        rows.forEach((tr, i) => {
          tr.classList.toggle('is-later', i > ctx.at);
          tr.classList.toggle('is-now', i === ctx.at);
        });
        const doneIds = new Set(rows.slice(0, ctx.at).map((tr) => tr.cells[0]?.textContent ?? ''));
        root.querySelectorAll<SVGCircleElement>('[data-dpt-node]').forEach((c) => {
          const id = c.dataset.dptNode ?? '';
          const now = Number(id) === st.v;
          const done = doneIds.has(id);
          c.setAttribute('fill', now ? '#3a2f0b' : done ? '#10291d' : '#121a2b');
          c.setAttribute('stroke', now ? '#d4af37' : done ? '#2f9e5c' : '#39425e');
          c.setAttribute('stroke-width', now ? '3' : '1.5');
        });
      },
    });
  });
</script>
