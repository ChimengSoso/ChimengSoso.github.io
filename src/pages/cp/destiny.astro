const href = 'destiny/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Edge = [number, number];
type ReqPair = [number, number];
type Tree = { n: number; edges: Edge[]; pairs: ReqPair[] };
type Rooted = { par: number[]; dep: number[]; pedge: number[]; order: number[]; kids: number[][] };

/** ปักรากที่จุด 1 คืนพ่อ ความลึก (รากลึก 1) เลขเส้นที่ต่อกับพ่อ และลำดับ BFS */
function rootTree(t: Tree): Rooted {
  const adj: { to: number; id: number }[][] = Array.from({ length: t.n + 1 }, () => []);
  t.edges.forEach(([a, b], i) => {
    adj[a].push({ to: b, id: i });
    adj[b].push({ to: a, id: i });
  });
  const par = new Array<number>(t.n + 1).fill(0);
  const dep = new Array<number>(t.n + 1).fill(0);
  const pedge = new Array<number>(t.n + 1).fill(-1);
  const kids: number[][] = Array.from({ length: t.n + 1 }, () => []);
  const order: number[] = [1];
  dep[1] = 1;
  for (let i = 0; i < order.length; i++) {
    const x = order[i];
    for (const e of adj[x]) {
      if (dep[e.to] !== 0) continue;
      dep[e.to] = dep[x] + 1;
      par[e.to] = x;
      pedge[e.to] = e.id;
      kids[x].push(e.to);
      order.push(e.to);
    }
  }
  if (order.length !== t.n) throw new Error('destiny: อินพุตไม่ใช่ต้นไม้ที่เชื่อมถึงกันหมด');
  return { par, dep, pedge, order, kids };
}

/** เส้นทุกเส้นบนวิถีจาก v ไต่ขึ้นไปหา u (u ต้องเป็นบรรพบุรุษแท้ของ v) */
function pathEdges(r: Rooted, u: number, v: number): number[] {
  const out: number[] = [];
  let w = v;
  while (w !== u) {
    if (w === 0) throw new Error('destiny: u ไม่ใช่บรรพบุรุษของ v');
    out.push(r.pedge[w]);
    w = r.par[w];
  }
  return out;
}

/** ตัวตรวจของทั้งหน้า ไล่ทุกการกำหนดค่า 2^(n-1) ตรง ๆ ตามนิยามในโจทย์
 *  ไม่มีความลึก ไม่มีสถานะ ไม่มีอะไรที่หน้านี้สอนเลย คืนเลขมาสก์ของแบบที่ผ่าน */
function enumerateValid(t: Tree): number[] {
  const r = rootTree(t);
  const need = t.pairs.map(([u, v]) => pathEdges(r, u, v));
  const good: number[] = [];
  for (let mask = 0; mask < 1 << (t.n - 1); mask++) {
    if (need.every((es) => es.some((e) => (mask >> e) & 1))) good.push(mask);
  }
  return good;
}

type DpRun = { dp: number[][]; att: number[]; order: number[]; dep: number[]; answer: number };

/** ท่าที่หน้านี้สอน ฉบับตารางเต็ม ตรงกับ destiny_slow.cpp ทีละบรรทัด
 *  ต้นไม้ในหน้านี้เล็กมาก ตัวเลขจึงไม่ล้น ไม่ต้องมอด (โค้ดจริงมอดด้วย 998244353) */
function dpTables(t: Tree): DpRun {
  const r = rootTree(t);
  const att = new Array<number>(t.n + 1).fill(0);
  for (const [u, v] of t.pairs) att[v] = Math.max(att[v], r.dep[u]);
  const dp: number[][] = Array.from({ length: t.n + 1 }, () => []);
  for (let i = r.order.length - 1; i >= 0; i--) {
    const v = r.order[i];
    const D = r.dep[v];
    let cur = new Array<number>(D).fill(0);
    cur[0] = 1;
    for (const c of r.kids[v]) {
      const d = dp[c];
      const S = d.reduce((a, b) => a + b, 0);
      const g = new Array<number>(D).fill(0);
      g[0] = d[0] + S;
      for (let j = 1; j < D; j++) g[j] = d[j];
      const C = new Array<number>(D).fill(0);
      let pa = 0;
      let pb = 0;
      for (let j = 0; j < D; j++) {
        const pbj = pb + g[j];
        C[j] = cur[j] * pbj + pa * g[j];
        pa += cur[j];
        pb = pbj;
      }
      cur = C;
    }
    const b = att[v];
    if (b >= 1) {
      let acc = 0;
      for (let j = 0; j < b; j++) {
        acc += cur[j];
        cur[j] = 0;
      }
      cur[b] += acc;
    }
    dp[v] = cur;
  }
  return { dp, att: att, order: r.order, dep: r.dep, answer: dp[1].reduce((a, b) => a + b, 0) };
}

/** ด่านตรวจตอนบิลด์ ถ้าตัวไล่ทุกแบบกับท่า dp ไม่ตรงกัน หรือไม่ตรงกับค่าที่หน้านี้อ้าง หน้านี้ไม่ขึ้น */
function checkTree(t: Tree, name: string, expected: number): number {
  const byEnum = enumerateValid(t).length;
  const byDp = dpTables(t).answer;
  if (byEnum !== expected) throw new Error(`destiny: ${name} ไล่ทุกแบบได้ ${byEnum} ไม่ใช่ ${expected}`);
  if (byDp !== expected) throw new Error(`destiny: ${name} ท่า dp ได้ ${byDp} ไม่ตรงกับตัวไล่ทุกแบบ`);
  return byEnum;
}

/* ---------- ตัวอย่างสองชุดในโจทย์ ---------- */
const SAMPLE: Tree = {
  n: 5,
  edges: [
    [1, 2],
    [2, 3],
    [3, 4],
    [3, 5],
  ],
  pairs: [
    [1, 3],
    [2, 5],
  ],
};
const SAMPLE2: Tree = {
  n: 15,
  edges: [
    [2, 1],
    [3, 1],
    [4, 3],
    [5, 2],
    [6, 3],
    [7, 6],
    [8, 4],
    [9, 5],
    [10, 7],
    [11, 5],
    [12, 10],
    [13, 3],
    [14, 9],
    [15, 8],
  ],
  pairs: [
    [3, 12],
    [5, 11],
    [2, 5],
    [3, 13],
    [8, 15],
    [1, 13],
  ],
};
const SAMPLE_ANS = checkTree(SAMPLE, 'ตัวอย่างที่หนึ่ง', 10);
const SAMPLE2_ANS = checkTree(SAMPLE2, 'ตัวอย่างที่สอง', 960);
const SAMPLE_TOTAL = 1 << (SAMPLE.n - 1);

const MODULUS = 998244353;
const N_MAX = 500000;
const M_MAX = 500000;
const fmt = (v: number): string => v.toLocaleString('en-US');
const edgeName = (e: Edge): string => `${e[0]}-${e[1]}`;

/* แกะตัวอย่างที่หนึ่ง: เส้น 2-3 อยู่บนวิถีของทั้งสองคู่ มันจึงเป็นตัวแบ่งคำตอบ */
const SAMPLE_R = rootTree(SAMPLE);
const E_KEY = SAMPLE.edges.findIndex((e) => (e[0] === 2 && e[1] === 3) || (e[0] === 3 && e[1] === 2));
const E_UP = SAMPLE.edges.findIndex((e) => (e[0] === 1 && e[1] === 2) || (e[0] === 2 && e[1] === 1));
const E_DOWN = SAMPLE.edges.findIndex((e) => (e[0] === 3 && e[1] === 5) || (e[0] === 5 && e[1] === 3));
const E_FREE = SAMPLE.edges.findIndex((e) => (e[0] === 3 && e[1] === 4) || (e[0] === 4 && e[1] === 3));
if (E_KEY < 0 || E_UP < 0 || E_DOWN < 0 || E_FREE < 0) throw new Error('destiny: หาเส้นในตัวอย่างที่หนึ่งไม่เจอ');
const SAMPLE_GOOD = new Set(enumerateValid(SAMPLE));
const SAMPLE_ALL = Array.from({ length: SAMPLE_TOTAL }, (_, m) => m);
const SAMPLE_BAD = SAMPLE_ALL.filter((m) => !SAMPLE_GOOD.has(m));
const KEY_ON = SAMPLE_ALL.filter((m) => (m >> E_KEY) & 1);
const KEY_OFF = SAMPLE_ALL.filter((m) => !((m >> E_KEY) & 1));
const KEY_OFF_GOOD = KEY_OFF.filter((m) => SAMPLE_GOOD.has(m));
if (!KEY_ON.every((m) => SAMPLE_GOOD.has(m))) throw new Error('destiny: เส้น 2-3 เป็น 1 แล้วควรผ่านทุกแบบ');
if (!SAMPLE_BAD.every((m) => !((m >> E_KEY) & 1))) throw new Error('destiny: แบบที่ตกต้องมีเส้น 2-3 เป็น 0 ทุกอัน');
if (!KEY_OFF_GOOD.every((m) => (m >> E_UP) & 1 && (m >> E_DOWN) & 1))
  throw new Error('destiny: แบบที่รอดทั้งที่เส้น 2-3 เป็น 0 ต้องเปิดทั้ง 1-2 และ 3-5');
if (KEY_ON.length + KEY_OFF_GOOD.length !== SAMPLE_ANS) throw new Error('destiny: แยกกรณีแล้วบวกไม่ตรงกับคำตอบ');

/* ---------- ตารางเดินท่า dp บนตัวอย่างที่หนึ่ง ---------- */
const SAMPLE_DP = dpTables(SAMPLE);
const DP_MAXJ = SAMPLE.n - 2;
const dpRows = SAMPLE_DP.order
  .slice()
  .reverse()
  .map((v) => ({
    v,
    dep: SAMPLE_DP.dep[v],
    att: SAMPLE_DP.att[v],
    cells: Array.from({ length: DP_MAXJ + 1 }, (_, j) => (j < SAMPLE_DP.dp[v].length ? String(SAMPLE_DP.dp[v][j]) : '·')),
  }));
if (dpRows[dpRows.length - 1].cells[0] !== String(SAMPLE_ANS)) throw new Error('destiny: แถวสุดท้ายของตาราง dp ต้องเป็นคำตอบ');
/* ตัวเลขที่ย่อหน้าหลังตารางพูดถึง ดึงจากตารางเดียวกัน ไม่พิมพ์มือ */
const DP3 = SAMPLE_DP.dp[3];
const DP2 = SAMPLE_DP.dp[2];
const DIE_AT_3 = DP3[SAMPLE_DP.dep[3] - 1];
const DIE_AT_2 = DP2[SAMPLE_DP.dep[2] - 1];
const SUM_DP2 = DP2.reduce((a, b) => a + b, 0);
if (DP2[0] + SUM_DP2 !== SAMPLE_ANS) throw new Error('destiny: สองทางเลือกที่ขอบ 1-2 บวกกันไม่เท่าคำตอบ');

/* ---------- รูปที่หนึ่ง ต้นไม้ของตัวอย่าง กับตาราง 16 แบบ ---------- */
const D1_DX = 84;
const D1_DY = 70;
const D1_TOP = 56;
const D1_R = 17;
const D1_X0 = 40;
type Pt = { x: number; y: number };
const d1Slot: Record<number, number> = { 4: 0, 5: 1, 3: 0.5, 2: 0.5, 1: 0.5 };
const d1Pos: Record<number, Pt> = {};
for (let v = 1; v <= SAMPLE.n; v++) d1Pos[v] = { x: D1_X0 + d1Slot[v] * D1_DX, y: D1_TOP + (SAMPLE_R.dep[v] - 1) * D1_DY };
/** จุดวางป้ายชื่อเส้น เลื่อนออกตามแนวตั้งฉากของเส้นนั้น ไม่ใช่เลื่อนตามแกน x ค่าคงที่
 *  (เลื่อนตามแกน x จะทับเส้นทแยงทุกครั้ง) */
function labelAt(a: Pt, b: Pt, off: number): Pt {
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const len = Math.hypot(dx, dy) || 1;
  let nx = dy / len;
  let ny = -dx / len;
  if (nx < 0) {
    nx = -nx;
    ny = -ny;
  }
  return { x: (a.x + b.x) / 2 + nx * off, y: (a.y + b.y) / 2 + ny * off };
}
/* ขนาดกระดานต้นไม้ในเครื่องเดิน dp ใช้พิกัดชุดเดียวกับรูปที่หนึ่ง */
const DPT_W = Math.max(...Object.values(d1Pos).map((p) => p.x)) + D1_R + D1_X0 - D1_R;
const DPT_H = Math.max(...Object.values(d1Pos).map((p) => p.y)) + D1_R + 16;
const EDGE_TAG = ['ก', 'ข', 'ค', 'ง'];
const d1Edges = SAMPLE.edges.map((e, i) => {
  const a = d1Pos[e[0]];
  const b = d1Pos[e[1]];
  const l = labelAt(a, b, 20);
  return { i, tag: EDGE_TAG[i], name: edgeName(e), x1: a.x, y1: a.y, x2: b.x, y2: b.y, lx: l.x, ly: l.y };
});
const GRID_X0 = 236;
const GRID_Y0 = 56;
const GRID_CW = 104;
const GRID_CH = 48;
const GRID_GX = 112;
const GRID_GY = 56;
const gridCells = SAMPLE_ALL.map((m) => ({
  m,
  x: GRID_X0 + (m % 4) * GRID_GX,
  y: GRID_Y0 + Math.floor(m / 4) * GRID_GY,
  bits: SAMPLE.edges.map((_, i) => ((m >> i) & 1 ? '1' : '0')).join(' '),
  ok: SAMPLE_GOOD.has(m),
}));
const D1_RIGHT = GRID_X0 + 3 * GRID_GX + GRID_CW;
const D1_BOTTOM = Math.max(d1Pos[4].y + D1_R + 4, GRID_Y0 + 3 * GRID_GY + GRID_CH);
const D1_W = D1_RIGHT + 12;
const D1_H = D1_BOTTOM + 34;

/* ---------- เครื่องเดินตาราง dp บนตัวอย่างที่หนึ่ง (เฉลยตอนที่ 3) ----------
   หนึ่งขั้นคือหนึ่งจุด ตามลำดับที่โปรแกรมคำนวณจริง คือจากใบขึ้นไปหาราก
   ข้อความแต่ละขั้นสร้างจากโมเดล ไม่พิมพ์มือ */
const fmtRow = (row: number[]): string => '[' + row.join(', ') + ']';
/* ร่องรอยของตารางระหว่างทาง: ทุกลูกที่ส่งผ่านขอบ ผลหลังรวมทีละลูก และก่อนกับหลังแขวน
   คำนวณด้วยสูตรเดียวกับ dpTables แล้วตรวจว่าแถวสุดท้ายตรงกัน */
type DpTrace = { start: number[]; kids: { c: number; g: number[]; after: number[] }[]; beforeAtt: number[]; final: number[] };
function dpTrace(t: Tree): Record<number, DpTrace> {
  const r = rootTree(t);
  const att = new Array<number>(t.n + 1).fill(0);
  for (const [u, v] of t.pairs) att[v] = Math.max(att[v], r.dep[u]);
  const fin: number[][] = Array.from({ length: t.n + 1 }, () => []);
  const out: Record<number, DpTrace> = {};
  for (let i = r.order.length - 1; i >= 0; i--) {
    const v = r.order[i];
    const D = r.dep[v];
    let cur = new Array<number>(D).fill(0);
    cur[0] = 1;
    const start = [...cur];
    const kids: DpTrace['kids'] = [];
    for (const c of r.kids[v]) {
      const d = fin[c];
      const S = d.reduce((a, b) => a + b, 0);
      const g = new Array<number>(D).fill(0);
      g[0] = d[0] + S;
      for (let j = 1; j < D; j++) g[j] = d[j];
      const C = new Array<number>(D).fill(0);
      let pa = 0;
      let pb = 0;
      for (let j = 0; j < D; j++) {
        const pbj = pb + g[j];
        C[j] = cur[j] * pbj + pa * g[j];
        pa += cur[j];
        pb = pbj;
      }
      cur = C;
      kids.push({ c, g, after: [...cur] });
    }
    const beforeAtt = [...cur];
    const b = att[v];
    if (b >= 1) {
      let acc = 0;
      for (let j = 0; j < b; j++) {
        acc += cur[j];
        cur[j] = 0;
      }
      cur[b] += acc;
    }
    fin[v] = cur;
    out[v] = { start, kids, beforeAtt, final: [...cur] };
  }
  return out;
}
const SAMPLE_TRACE = dpTrace(SAMPLE);
for (const v of SAMPLE_DP.order)
  if (fmtRow(SAMPLE_TRACE[v].final) !== fmtRow(SAMPLE_DP.dp[v])) throw new Error(`destiny: ร่องรอยของจุด ${v} ไม่ตรงกับตาราง dp`);
const dpSteps = dpRows.map((r, k) => {
  const kids = SAMPLE_R.kids[r.v];
  const row = SAMPLE_DP.dp[r.v];
  const tr = SAMPLE_TRACE[r.v];
  const parts: string[] = [`<b>จุด ${r.v}</b> (ลึก ${r.dep})`];
  if (kids.length === 0) parts.push(`เป็นใบ ไม่มีลูกให้รวม ตารางเริ่มที่ ${fmtRow(tr.start)} (ยังไม่มีเส้นให้ระบาย)`);
  else {
    parts.push(`เริ่มที่ ${fmtRow(tr.start)} (รวมกับตารางไหนก็ได้ตารางนั้นเหมือนเดิม)`);
    for (const kd of tr.kids) parts.push(`ลูก ${kd.c} ส่งผ่านขอบขึ้นมาเป็น g = ${fmtRow(kd.g)} รวมแล้วได้ ${fmtRow(kd.after)}`);
  }
  if (r.att > 0) {
    const ps = SAMPLE.pairs.filter((p) => p[1] === r.v).map((p) => `(${p[0]}, ${p[1]})`).join(', ');
    parts.push(`คู่ ${ps} จบที่นี่ u ลึก ${r.att} กวาดทุกช่องที่ j น้อยกว่า ${r.att} ไปเทลงช่อง ${r.att}: ${fmtRow(tr.beforeAtt)} กลายเป็น ${fmtRow(row)}`);
  } else parts.push(`ได้แถว ${fmtRow(row)}`);
  if (k === dpRows.length - 1) parts.push(`ราก ผลรวมทั้งแถวคือคำตอบ <b>${SAMPLE_ANS}</b>`);
  return { note: parts.join(' · '), v: r.v };
});

/* ---------- เกมข้อค้างหลายข้อ (ลองเอง เกมที่ 2) ----------
   โซ่ 6 จุด v อยู่ลึกสุด มีข้อบังคับค้างสามข้อ u ลึก 2, 3, 4 ผู้เล่นเลือกขอบได้ทีละเส้น
   ขอบระหว่างลึก k กับ k + 1 ปิดข้อบังคับที่ u ลึก a ได้ก็ต่อเมื่อ k >= a */
const CH_N = 6;
const CH_US = [2, 3, 4];
const CH_TOP = 28;
const CH_DY = 52;
const CH_X = 120;
const chY = (d: number): number => CH_TOP + (d - 1) * CH_DY;
const CH_ARCS = CH_US.map((a, i) => ({ a, x: CH_X + 46 + i * 46 }));
/* ขอบซ้ายขวาวัดในเบราว์เซอร์ให้เหลือราว 12 หน่วยทั้งสองฝั่ง: ตัดที่ว่างซ้ายด้วยจุดเริ่ม viewBox */
const CH_VB_X = 60;
const CH_W = CH_X + CH_US.length * 46 + 38 - CH_VB_X;
const CH_H = chY(CH_N) + 22 + 34;
const chainCloses = (k: number): number[] => CH_US.filter((a) => k >= a);
if (chainCloses(Math.max(...CH_US)).length !== CH_US.length) throw new Error('destiny: ขอบใต้ u ที่ลึกที่สุดต้องปิดได้ทุกข้อ');
if (Array.from({ length: CH_N - 1 }, (_, i) => i + 1).filter((k) => chainCloses(k).length === CH_US.length).length !== CH_N - Math.max(...CH_US))
  throw new Error('destiny: เกมข้อค้างต้องมีขอบที่ปิดได้ครบเฉพาะใต้ u ที่ลึกที่สุด');

/* ---------- กราฟงบเวลา (เฉลยตอนที่ 1) ต้นไม้เส้นตรงที่ขอบเขตเต็ม สเกล log10 ----------
   ความเร็วเครื่องเป็นค่าสมมติแบบหยาบ 10^8 ก้าวต่อวินาที เขียนบอกไว้ในหน้า */
const OPS_PER_SEC = 1e8;
const BUDGET_OPS = 2 * OPS_PER_SEC;
const LOG2_N = Math.ceil(Math.log2(N_MAX));
const TABLE_OPS = (N_MAX * N_MAX) / 2;
const MERGE_OPS = N_MAX * LOG2_N + M_MAX;
const GC_LO = 6;
const GC_HI = 12;
const GC_X0 = 196;
const GC_W = 360;
const GC_Y0 = 46;
const GC_ROW = 46;
const gcX = (v: number): number => GC_X0 + ((Math.log10(v) - GC_LO) / (GC_HI - GC_LO)) * GC_W;
const sciOf = (v: number): { m: string; e: number } => {
  const e = Math.floor(Math.log10(v));
  return { m: (v / 10 ** e).toFixed(1).replace(/\.0$/, ''), e };
};
