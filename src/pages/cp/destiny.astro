const BD_W = 217;
const BD_DX = 92;
const BD_DY = 76;
const BD_TOP = 34;
const BD_R = 17;
type GameNode = { id: number; x: number; y: number };
type GameEdge = { id: number; name: string; x1: number; y1: number; x2: number; y2: number; lx: number; ly: number };
type GamePair = { u: number; v: number; edges: number[] };
type GamePuzzle = {
  id: string;
  label: string;
  tease: string;
  hint: string;
  w: number;
  h: number;
  nodes: GameNode[];
  edges: GameEdge[];
  pairs: GamePair[];
  total: number;
  answer: number;
};

function boardOf(t: Tree): { nodes: GameNode[]; edges: GameEdge[]; w: number; h: number } {
  const r = rootTree(t);
  const slot = new Array<number>(t.n + 1).fill(0);
  let next = 0;
  const assign = (v: number): number => {
    if (r.kids[v].length === 0) {
      slot[v] = next++;
      return slot[v];
    }
    const xs = r.kids[v].map(assign);
    slot[v] = xs.reduce((a, b) => a + b, 0) / xs.length;
    return slot[v];
  };
  assign(1);
  const span = (next - 1) * BD_DX;
  const x0 = (BD_W - span) / 2;
  const maxDep = Math.max(...r.dep.slice(1));
  const pos: Pt[] = new Array(t.n + 1).fill(null).map(() => ({ x: 0, y: 0 }));
  for (let v = 1; v <= t.n; v++) pos[v] = { x: x0 + slot[v] * BD_DX, y: BD_TOP + (r.dep[v] - 1) * BD_DY };
  const nodes: GameNode[] = Array.from({ length: t.n }, (_, i) => ({ id: i + 1, x: pos[i + 1].x, y: pos[i + 1].y }));
  const edges: GameEdge[] = t.edges.map((e, i) => {
    const a = pos[e[0]];
    const b = pos[e[1]];
    const l = labelAt(a, b, 21);
    return { id: i, name: edgeName(e), x1: a.x, y1: a.y, x2: b.x, y2: b.y, lx: l.x, ly: l.y };
  });
  return { nodes, edges, w: BD_W, h: BD_TOP + (maxDep - 1) * BD_DY + BD_R + 18 };
}

function makePuzzle(id: string, label: string, tease: string, hint: string, t: Tree, expected: number): GamePuzzle {
  const answer = checkTree(t, `ปริศนา ${label}`, expected);
  const r = rootTree(t);
  const board = boardOf(t);
  return {
    id,
    label,
    tease,
    hint,
    ...board,
    pairs: t.pairs.map(([u, v]) => ({ u, v, edges: pathEdges(r, u, v) })),
    total: 1 << (t.n - 1),
    answer,
  };
}

