</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type TgPuzzle = {
    id: string;
    label: string;
    tease: string;
    words: string[];
    target: string;
    best: number;
    alphabet: string[];
  };

  function initTrieGame(): void {
    const maybeUi = cpGameUi('[data-tgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as TgPuzzle[];
    if (puzzles.length === 0) return;

    const keysEl = ui.root.querySelector<HTMLElement>('[data-tg-keys]');
    const listEl = ui.root.querySelector<HTMLElement>('[data-tg-list]');
    const preEl = ui.root.querySelector<HTMLElement>('[data-tg-pre]');
    const cntEl = ui.root.querySelector<HTMLElement>('[data-tg-cnt]');
    const targetEl = ui.root.querySelector<HTMLElement>('[data-tg-target]');
    if (!keysEl || !listEl || !preEl || !cntEl || !targetEl) return;
    const keys: HTMLElement = keysEl;
    const list: HTMLElement = listEl;
    const preOut: HTMLElement = preEl;
    const cntOut: HTMLElement = cntEl;
    const targetOut: HTMLElement = targetEl;

    let pi = 0;
    let pre = '';

    const pz = (): TgPuzzle => puzzles[pi];
    const matches = (): string[] => pz().words.filter((w) => w.startsWith(pre));

    function build(): void {
      const p = pz();
      keys.textContent = '';
      for (const c of p.alphabet) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cpg-btn tr-key';
        b.dataset.letter = c;
        b.textContent = c;
        keys.appendChild(b);
      }
      list.textContent = '';
      for (const w of p.words) {
        const chip = document.createElement('span');
        chip.className = 'tg-word';
        chip.dataset.word = w;
        chip.textContent = w;
        list.appendChild(chip);
      }
      targetOut.textContent = p.target;
    }

    function render(): void {
      const ms = matches();
      for (const chip of Array.from(list.querySelectorAll<HTMLElement>('[data-word]'))) {
        const w = chip.dataset.word ?? '';
        chip.classList.toggle('live', ms.includes(w));
        chip.classList.toggle('target', w === pz().target);
      }
      preOut.textContent = pre === '' ? '(ยังไม่พิมพ์)' : pre;
      cntOut.textContent = String(ms.length);
    }

    function type(c: string): void {
      const p = pz();
      pre += c;
      if (!p.target.startsWith(pre)) {
        ui.setStatus(`"${pre}" ไม่ใช่ส่วนหัวของ ${p.target} แล้ว ลบกลับมาก่อน`, 'bad');
      } else {
        const n = matches().length;
        ui.setStatus(
          n === 1 ? `"${pre}" เหลือคำเดียวแล้ว ลองกดตรวจดู` : `"${pre}" ยังชี้ได้ ${n} คำ`,
        );
      }
      render();
    }

    function back(): void {
      if (pre === '') return;
      pre = pre.slice(0, -1);
      ui.setStatus('ลบแล้ว พิมพ์ใหม่ได้');
      render();
    }

    function check(): void {
      const p = pz();
      if (!p.target.startsWith(pre) || pre === '') {
        ui.setStatus(`ต้องเป็นส่วนหัวของ ${p.target} เท่านั้นครับ`, 'bad');
        return;
      }
      const n = matches().length;
      if (n > 1) {
        ui.setStatus(`"${pre}" ยังชี้ได้ ${n} คำ ยังแยกไม่ออกว่าเป็นคำไหน`, 'bad');
        return;
      }
      if (pre.length === p.best) {
        ui.setStatus(`ใช่ครับ "${pre}" ยาว ${pre.length} ตัว ซึ่งสั้นที่สุดที่ยังชี้คำเดียวได้`, 'good');
      } else {
        ui.setStatus(`"${pre}" ชี้คำเดียวจริง แต่ยังตัดให้สั้นได้อีก คำตอบคือ ${p.best} ตัว`, 'bad');
      }
    }

    function sayImpossible(): void {
      const p = pz();
      if (p.best === -1) {
        ui.setStatus(
          `ถูกต้องครับ "${p.target}" เป็นส่วนหัวของคำอื่นในคลังอยู่แล้ว จึงไม่มีส่วนหัวไหนชี้มันได้ตัวเดียว` +
            ' นี่คือเหตุผลที่ไทรต้องมีธงบอกว่าปมไหนเป็นจุดจบของคำ',
          'good',
        );
      } else {
        ui.setStatus(`แยกได้ครับ ส่วนหัวยาว ${p.best} ตัวก็พอแล้ว ลองใหม่อีกที`, 'bad');
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      pre = '';
      ui.selectTab(k);
      ui.setTease(pz().tease);
      build();
      ui.setStatus('พิมพ์ทีละตัวอักษร แล้วดูว่าคลังเหลือกี่คำที่ยังเข้าได้');
      render();
    }

    keys.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('[data-letter]');
      if (!(b instanceof HTMLElement)) return;
      type(b.dataset.letter ?? '');
    });

    ui.onClick('data-tg-back', back);
    ui.onClick('data-tg-none', sayImpossible);
    ui.onClick('data-tg-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initTrieGame);
</script>
