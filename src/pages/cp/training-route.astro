  <h2>เช็กความเข้าใจ</h2>
  <p>สามข้อนี้ตอบได้จากสิ่งที่อ่านมา ลองคิดก่อนแล้วค่อยเปิดคำตอบ</p>
  <p><strong>ข้อ 1.</strong> ถ้าโจทย์กลับด้าน ให้ปิดถนนจนไม่เหลือวงที่ยาว<em>คี่</em>แทน ต้องใช้ดีพีไหม</p>
  <details class="expander">
    <summary>ดูคำตอบข้อ 1</summary>
    <div class="expander-body">
      <p>
        ไม่ต้อง ถนนที่เส้นทางยาวคู่สร้างวงคี่ จึงต้องปิดทุกเส้น ส่วนเส้นที่เส้นทางยาวคี่สร้างวงคู่
        สองวงคู่ที่ทับกันต่อได้แค่วงคู่ (คู่บวกคู่หักคู่) เก็บไว้ได้หมด
      </p>
      <p>
        อีกมุมหนึ่ง กราฟที่ไม่มีวงคี่คือกราฟที่ระบายสองสี (bipartite coloring) ได้ ต้นไม้ระบายสลับสีตามความลึกได้แบบเดียว
        ถนนที่ปลายสองข้างคนละสีคือเส้นที่เส้นทางยาวคี่ ซึ่งตรงกับข้างบน
      </p>
    </div>
  </details>
  <p><strong>ข้อ 2.</strong> ทำไมถนนแต่ละเส้นถูกตัดสินที่ปมร่วมที่ต่ำที่สุด ไม่ใช่ที่ปลายทางของมัน</p>
  <details class="expander">
    <summary>ดูคำตอบข้อ 2</summary>
    <div class="expander-body">
      <p>
        ปมร่วมคือจุดสูงสุดของเส้นทาง ทุกเมืองบนเส้นทางอยู่ใต้มัน จึงคิด dp เสร็จแล้วเมื่อมาถึงปมร่วม
        และเมืองที่อยู่เหนือปมร่วมไม่โดนเส้นทางนี้เลย ถ้าตัดสินที่ปลายทาง จะยังไม่รู้ว่าอีกฝั่งของเส้นทางชนใคร
      </p>
    </div>
  </details>
  <p><strong>ข้อ 3.</strong> ทำไมในแต่ละเมืองต้องไล่ <code>mask</code> จากใหญ่ไปเล็ก</p>
  <details class="expander">
    <summary>ดูคำตอบข้อ 3</summary>
    <div class="expander-body">
      <p>
        การเก็บถนนที่จองลูกเซต <code>se</code> อ่านค่าของ <code>mask | se</code> ซึ่งเปิดบิตเพิ่มจาก <code>mask</code>
        เมื่อมองเป็นตัวเลข การเปิดบิตเพิ่มทำให้ค่ามากขึ้นเสมอ ไล่ mask จากตัวเลขมากลงมาหาน้อย ค่าที่ถูกอ่านจึงคิดเสร็จแล้วทุกครั้ง
      </p>
    </div>
  </details>

  <h2>ท่าที่ติดมือกลับไป</h2>
  <p>
    สองกฎในเฉลยเป็นข้อสรุปเรื่องคู่คี่ (parity) ทั้งคู่ เราไม่ได้สนใจว่าเส้นทางยาวเท่าไร สนใจแค่ว่ายาวคู่หรือคี่
    พอถามแค่นั้น ถนนทั้งกราฟก็แบ่งเป็นสองพวกทันที
  </p>
  <p>
    โจทย์ฝาแฝดที่ห้ามวงคี่แทน ตอบได้ด้วยการระบายสองสีตรง ๆ (ข้อ 1 ข้างบน) ส่วนข้อนี้ห้ามวงคู่ จึงต้องมีกฎที่ 2 กับดีพีเพิ่ม
    ถ้าอยากเห็นการใช้คู่คี่อีกแบบ ดูโจทย์<a href="/cp/teleporters/">เครื่องเคลื่อนย้ายมวลสาร</a>
  </p>
  <p>
    อีกท่าที่ข้อนี้ใช้คือ<strong>การบีบสถานะ</strong> (state compression) ตอนไล่ต้นไม้ เราไม่เก็บทุกอย่างของกิ่ง
    เก็บแค่ค่าที่พ่อต้องใช้ ฝั่งต้นไม้มีบทปูพื้นใน <a href="/cp/tree-dp/">DP บนต้นไม้</a>
    ฝั่งการเก็บเซตไว้ในบิตมีใน <a href="/cp/rolling-state-dp/">DP ที่สถานะคือความจำล่าสุด</a>
  </p>

  <h2>สรุปบรรทัดเดียว</h2>
  <p>
    ต้นไม้ทำให้ถนนนอกต้นไม้หนึ่งเส้นเท่ากับวงหนึ่งวง ความเป็นคู่เป็นคี่จึงตัดเส้นครึ่งหนึ่งทิ้งไปเลย
    และเงื่อนไขที่เหลือคือเส้นทางห้ามทับกัน ซึ่งพอดีกับดีพีบนต้นไม้ที่จำว่าลูกคนไหนถูกจองไปแล้ว
  </p>

  <h2>แหล่งที่มา</h2>
  <ol class="references">
    <li>
      โจทย์ <i>Training</i> บน programming.in.th ข้อ 2005
      <a href="https://programming.in.th/tasks/2005" target="_blank" rel="noopener noreferrer">
        programming.in.th/tasks/2005
      </a>
      (สืบค้น 6 กันยายน 2026)
    </li>
    <li>
      ต้นทางของโจทย์คือ <i>International Olympiad in Informatics 2007</i> ที่เมืองซาเกร็บ ประเทศโครเอเชีย วันแข่งที่ 2
    </li>
  </ol>
</CpProblemLayout>

<style>
  /* ---------- ตารางถนนของมินิเกมปิดถนน ---------- */
  .tr-list{border-collapse:collapse;font-size:0.85rem;}
  .tr-list :global(th), .tr-list :global(td){
    border:1px solid #2a3350;padding:0.26rem 0.7rem;text-align:center;color:#cdd6ea;
  }
  .tr-list :global(th){color:#9aa7bd;font-weight:600;white-space:nowrap;}
  .tr-list :global(tr.closed td){background:#241a1a;color:#f0a6a6;text-decoration:line-through;}

  /* ---------- เครื่องเดินดีพีบนต้นไม้ ----------
     แถวโผล่ทีละแถว และแถวของเมือง 1 (ราก) ยาวกว่าแถวอื่นมาก ถ้าตารางยังให้ความกว้างของตัวเองกับการ์ด
     การ์ดจะขยายจาก 688 เป็น 1063px ตอนขั้นสุดท้าย จึงให้ตารางเต็มการ์ดโดยไม่ดันการ์ด (width:0 + min-width:100%)
     แล้วให้คอลัมน์ค่าตัดบรรทัดแทน !important สู้กับ body .panel .dpsim table.rec{width:100%} ของ CpProblemLayout */
  table.rec.trdp-rows{width:0 !important;min-width:100%;table-layout:fixed;}
  table.rec.trdp-rows th:nth-child(1){width:4.2rem;}
  table.rec.trdp-rows th:nth-child(2){width:5.6rem;}
  table.rec.trdp-rows th:nth-child(3){width:8.6rem;}
  table.rec.trdp-rows td.trdp-val{white-space:normal;font-family:'JetBrains Mono', monospace;font-size:0.8rem;}
</style>

<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';
  import { initCpPlayers } from '../../lib/cpPlayer';

  type TrEdge = { a: number; b: number; c: number };
  type TrPuzzle = { id: string; label: string; tease: string; n: number; edges: TrEdge[]; best: number };

  function initTrainGame(): void {
    const maybeUi = cpGameUi('[data-trgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่หลังการ์ด TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root) as TrPuzzle[];
    if (puzzles.length === 0) return;

    const listEl = ui.root.querySelector<HTMLElement>('[data-tr-list]');
    const paidEl = ui.root.querySelector<HTMLElement>('[data-tr-paid]');
    const bestEl = ui.root.querySelector<HTMLElement>('[data-tr-best]');
    if (!listEl || !paidEl || !bestEl) return;
    const list: HTMLElement = listEl;
    const paidOut: HTMLElement = paidEl;
    const bestOut: HTMLElement = bestEl;

    let pi = 0;
    let closed = new Set<number>();
    /* ค่าที่ถูกที่สุดเป็นส่วนหนึ่งของเฉลย จึงซ่อนไว้จนกว่าจะกดตรวจครั้งแรกของชุดนั้น */
    let tried = false;

    const pz = (): TrPuzzle => puzzles[pi];

    /** ตัวตัดสินไม่ใช้กฎของเฉลย มันไล่หาวงจรอย่างง่ายทุกวงแล้วดูความยาว */
    function hasEvenCycle(es: TrEdge[]): boolean {
      const n = pz().n;
      let found = false;
      const seen = new Set<number>();
      const walk = (start: number, u: number, parentEdge: number, depth: number): void => {
        if (found) return;
        for (let i = 0; i < es.length; i++) {
          if (i === parentEdge) continue;
          const e = es[i];
          const v = e.a === u ? e.b : e.b === u ? e.a : 0;
          if (v === 0) continue;
          if (v === start && depth + 1 >= 3 && (depth + 1) % 2 === 0) {
            found = true;
            return;
          }
          if (v < start || seen.has(v)) continue;
          seen.add(v);
          walk(start, v, i, depth + 1);
          seen.delete(v);
          if (found) return;
        }
      };
      for (let s = 1; s <= n && !found; s++) {
        seen.clear();
        seen.add(s);
        walk(s, s, -1, 0);
      }
      return found;
    }

    const keptEdges = (): TrEdge[] => pz().edges.filter((_, i) => !closed.has(i));
    const paid = (): number =>
      pz().edges.reduce((t, e, i) => (closed.has(i) ? t + e.c : t), 0);

    function buildList(): void {
      const p = pz();
      list.textContent = '';
      const head = document.createElement('tr');
      for (const t of ['ถนน', 'เชื่อม', 'ค่าปิด', '']) {
        const th = document.createElement('th');
        th.textContent = t;
        head.appendChild(th);
      }
      list.appendChild(head);
      p.edges.forEach((e, i) => {
        const tr = document.createElement('tr');
        tr.dataset.edge = String(i);
        const kind = e.c === 0 ? 'ราดยาง' : 'ไม่ราดยาง';
        for (const t of [`เส้นที่ ${i + 1} (${kind})`, `${e.a} กับ ${e.b}`, e.c === 0 ? 'ปิดไม่ได้' : String(e.c)]) {
          const td = document.createElement('td');
          td.textContent = t;
          tr.appendChild(td);
        }
        const td = document.createElement('td');
        if (e.c > 0) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'cpg-btn';
          b.dataset.close = String(i);
          b.textContent = 'ปิดเส้นนี้';
          td.appendChild(b);
        }
        tr.appendChild(td);
        list.appendChild(tr);
      });
    }

    function render(): void {
      for (const tr of Array.from(list.querySelectorAll<HTMLElement>('[data-edge]'))) {
        tr.classList.toggle('closed', closed.has(Number(tr.dataset.edge)));
      }
      for (const b of Array.from(list.querySelectorAll<HTMLElement>('[data-close]'))) {
        b.textContent = closed.has(Number(b.dataset.close)) ? 'เปิดคืน' : 'ปิดเส้นนี้';
      }
      paidOut.textContent = String(paid());
      bestOut.textContent = tried ? String(pz().best) : '?';
    }

    function check(): void {
      const p = pz();
      tried = true;
      render();
      if (hasEvenCycle(keptEdges())) {
        ui.setStatus('ยังมีเส้นทางซ้อมที่ยุติธรรมเหลืออยู่ คือยังมีวงจรที่ยาวเป็นเลขคู่', 'bad');
        return;
      }
      const cost = paid();
      if (cost === p.best) {
        ui.setStatus(`ไม่เหลือวงคู่แล้ว และจ่ายไป ${cost} ซึ่งถูกที่สุดเท่าที่เป็นไปได้`, 'good');
      } else {
        ui.setStatus(`ไม่เหลือวงคู่แล้ว แต่จ่ายไป ${cost} ยังมีวิธีที่จ่ายแค่ ${p.best}`, 'bad');
      }
    }

    function selectPuzzle(k: number): void {
      pi = k;
      closed = new Set<number>();
      tried = false;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      buildList();
      ui.setStatus('กดปิดถนนที่ไม่ราดยางได้ตามใจ แล้วกดตรวจว่าเหลือเส้นทางซ้อมที่ยุติธรรมไหม');
      render();
    }

    list.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;
      const b = e.target.closest('[data-close]');
      if (!(b instanceof HTMLElement)) return;
      const i = Number(b.dataset.close);
      if (closed.has(i)) closed.delete(i);
      else closed.add(i);
      ui.setStatus('กดปิดถนนที่ไม่ราดยางได้ตามใจ แล้วกดตรวจว่าเหลือเส้นทางซ้อมที่ยุติธรรมไหม');
      render();
    });

    ui.onClick('data-tr-reset', () => {
      closed = new Set<number>();
      ui.setStatus('กดปิดถนนที่ไม่ราดยางได้ตามใจ แล้วกดตรวจว่าเหลือเส้นทางซ้อมที่ยุติธรรมไหม');
      render();
    });
    ui.onClick('data-tr-check', check);
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  /* ---------- เครื่องเดินดีพีบนต้นไม้ ---------- */
  type DpStep = { note: string; v: number; cands: number[]; done: number[]; kept: number[] };
  const isNumArr = (x: unknown): x is number[] => Array.isArray(x) && x.every((v) => typeof v === 'number');
  function isDpStep(x: unknown): x is DpStep {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return typeof o.note === 'string' && typeof o.v === 'number' && isNumArr(o.cands) && isNumArr(o.done) && isNumArr(o.kept);
  }
  /* สีของเส้นทางถนนที่ตัดสินในขั้นนั้น เส้นแรกหนา เส้นถัดไปบางลง จะได้เห็นทั้งคู่ตอนทับกัน */
  const CAND_INK = ['#d4af37', '#5fb3ff', '#e06c75'];
  const CAND_W = ['9', '4', '3'];

  function initTrainPlayer(): void {
    initCpPlayers<DpStep>('[data-trdp]', {
      narrow: (raw) => {
        const ok = raw.filter(isDpStep);
        return ok.length === raw.length ? ok : null;
      },
      sayFrom: (st) => st.note,
      draw: (st, ctx) => {
        const root = ctx.parts.root;
        const rows = Array.from(root.querySelectorAll<HTMLTableRowElement>('tbody tr'));
        rows.forEach((tr, i) => {
          tr.classList.toggle('is-later', i > ctx.at);
          tr.classList.toggle('is-now', i === ctx.at);
        });
        /* ตั้งสีผ่าน attribute ตรง ๆ เพื่อไม่ต้องพึ่ง CSS ที่ต้องข้ามสโคปของคอมโพเนนต์ */
        root.querySelectorAll<SVGCircleElement>('[data-dpn]').forEach((c) => {
          const v = Number(c.dataset.dpn);
          const now = v === st.v;
          const done = st.done.includes(v);
          c.setAttribute('fill', now ? '#d4af37' : done ? '#22304a' : '#141b2b');
          c.setAttribute('stroke', now ? '#d4af37' : done ? '#9aa7bd' : '#3a4459');
        });
        root.querySelectorAll<SVGTextElement>('[data-dpt]').forEach((t) => {
          const v = Number(t.dataset.dpt);
          const now = v === st.v;
          const done = st.done.includes(v);
          t.setAttribute('fill', now ? '#0b1220' : done ? '#e6ebf5' : '#7b8397');
        });
        root.querySelectorAll<SVGPathElement>('[data-dpr]').forEach((p) => {
          const r = Number(p.dataset.dpr);
          const ci = st.cands.indexOf(r);
          if (st.kept.includes(r)) {
            p.setAttribute('stroke', '#4ade80');
            p.setAttribute('stroke-width', '7');
            p.setAttribute('stroke-opacity', '0.85');
          } else if (ci !== -1) {
            p.setAttribute('stroke', CAND_INK[ci % CAND_INK.length]);
            p.setAttribute('stroke-width', CAND_W[ci % CAND_W.length]);
            p.setAttribute('stroke-opacity', '0.85');
          } else {
            p.setAttribute('stroke-opacity', '0');
          }
        });
        const now = rows[Math.min(ctx.at, rows.length - 1)];
        if (now) ctx.keepInView(now.cells[0] ?? now);
      },
    });
  }

  document.addEventListener('astro:page-load', () => {
    initTrainGame();
    initTrainPlayer();
  });
</script>
