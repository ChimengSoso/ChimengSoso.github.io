---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';

const href = 'training-route/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Edge = { a: number; b: number; c: number };
const N = 5;
const EDGES: Edge[] = [
  { a: 2, b: 1, c: 0 },
  { a: 3, b: 2, c: 0 },
  { a: 4, b: 3, c: 0 },
  { a: 5, b: 4, c: 0 },
  { a: 1, b: 3, c: 2 },
  { a: 3, b: 5, c: 2 },
  { a: 2, b: 4, c: 5 },
  { a: 2, b: 5, c: 1 },
];
const paved = EDGES.filter((e) => e.c === 0);
const extra = EDGES.filter((e) => e.c > 0);
const totalCost = extra.reduce((s, e) => s + e.c, 0);

/** หาเส้นทางบนต้นไม้ระหว่างสองเมือง คืนลำดับเมืองที่ผ่าน */
function treePath(a: number, b: number): number[] {
  const adj = new Map<number, number[]>();
  for (let i = 1; i <= N; i++) adj.set(i, []);
  for (const e of paved) {
    (adj.get(e.a) as number[]).push(e.b);
    (adj.get(e.b) as number[]).push(e.a);
  }
  const prev = new Map<number, number>();
  const seen = new Set<number>([a]);
  const q = [a];
  for (let h = 0; h < q.length; h++)
    for (const v of adj.get(q[h]) as number[])
      if (!seen.has(v)) {
        seen.add(v);
        prev.set(v, q[h]);
        q.push(v);
      }
  const path = [b];
  while (path[0] !== a) path.unshift(prev.get(path[0]) as number);
  return path;
}

/** ชื่อของเส้นถนนบนต้นไม้ ใช้เทียบว่าสองเส้นทางทับกันไหม */
const key = (u: number, v: number): string => `${Math.min(u, v)}-${Math.max(u, v)}`;
type ExInfo = { e: Edge; path: number[]; len: number; even: boolean; edges: string[] };
const info: ExInfo[] = extra.map((e) => {
  const path = treePath(e.a, e.b);
  const edges: string[] = [];
  for (let i = 0; i + 1 < path.length; i++) edges.push(key(path[i], path[i + 1]));
  return { e, path, len: path.length - 1, even: (path.length - 1) % 2 === 0, edges };
});

const keepable = info.filter((x) => x.even);
const forced = info.filter((x) => !x.even);
const forcedCost = forced.reduce((s, x) => s + x.e.c, 0);
const roadName = (e: Edge): string => `${e.a}-${e.b}`;

/** เลือกชุดที่เส้นทางไม่ทับกันเลย แล้วเอาน้ำหนักรวมมากสุด (ไล่ทุกเซตได้เพราะมีไม่กี่เส้น) */
function bestKeep(): { pick: ExInfo[]; weight: number } {
  let best: ExInfo[] = [];
  let bw = 0;
  for (let m = 0; m < 1 << keepable.length; m++) {
    const pick = keepable.filter((_, i) => (m >> i) & 1);
    const used = new Set<string>();
    let ok = true;
    for (const p of pick) {
      for (const k of p.edges) {
        if (used.has(k)) {
          ok = false;
          break;
        }
        used.add(k);
      }
      if (!ok) break;
    }
    if (!ok) continue;
    const w = pick.reduce((s, p) => s + p.e.c, 0);
    if (w > bw) {
      bw = w;
      best = pick;
    }
  }
  return { pick: best, weight: bw };
}
const kept = bestKeep();
const answer = totalCost - kept.weight;

/* ---------- ตัวตัดสินที่ไม่เชื่อกฎของเฉลย ----------
   ไล่หาวงจรอย่างง่ายทุกวงในกราฟ แล้วดูว่ามีวงยาวเป็นเลขคู่ไหม
   มินิเกม ตัวอย่างของกฎที่ 2 และตัวอย่างของดีพี เทียบกับตัวนี้ทั้งหมด */

/** มีวงจรอย่างง่ายที่ยาวเป็นเลขคู่ในกราฟนี้ไหม ไล่ทุกวงจริง ๆ */
function hasEvenCycle(n: number, es: Edge[]): boolean {
  const adj = new Map<number, number[]>();
  for (let i = 1; i <= n; i++) adj.set(i, []);
  for (const e of es) {
    (adj.get(e.a) as number[]).push(e.b);
    (adj.get(e.b) as number[]).push(e.a);
  }
  let found = false;
  const seen = new Set<number>();
  const walk = (start: number, u: number, parentEdge: number, depth: number): void => {
    if (found) return;
    for (let i = 0; i < es.length; i++) {
      if (i === parentEdge) continue;
      const e = es[i];
      const v = e.a === u ? e.b : e.b === u ? e.a : 0;
      if (v === 0) continue;
      if (v === start && depth + 1 >= 3 && (depth + 1) % 2 === 0) {
        found = true;
        return;
      }
      if (v < start || seen.has(v)) continue;
      seen.add(v);
      walk(start, v, i, depth + 1);
      seen.delete(v);
      if (found) return;
    }
  };
  for (let s = 1; s <= n && !found; s++) {
    seen.clear();
    seen.add(s);
    walk(s, s, -1, 0);
  }
  return found;
}

/** ค่าใช้จ่ายที่น้อยที่สุด โดยไล่ทุกวิธีว่าจะปิดถนนไม่ราดยางเส้นไหนบ้าง */
function cheapestClose(n: number, es: Edge[]): number {
  const pv = es.filter((e) => e.c === 0);
  const ex = es.filter((e) => e.c > 0);
  let best = Number.POSITIVE_INFINITY;
  for (let mask = 0; mask < 1 << ex.length; mask++) {
    const keptEs: Edge[] = [...pv];
    let cost = 0;
    for (let i = 0; i < ex.length; i++) {
      if (mask & (1 << i)) keptEs.push(ex[i]);
      else cost += ex[i].c;
    }
    if (cost >= best) continue;
    if (!hasEvenCycle(n, keptEs)) best = cost;
  }
  return best;
}

if (cheapestClose(N, EDGES) !== answer) {
  throw new Error(`training-route: ตัวตรวจแบบไล่ทุกวงได้ ${cheapestClose(N, EDGES)} แต่สองกฎได้ ${answer}`);
}

/* ---------- ตัวอย่างของกฎที่ 2 คู่ที่เส้นทางทับกัน ----------
   หาคู่จากตัวอย่างในโจทย์เอง แล้วประกอบวงใหม่จริง ๆ เพื่อนับความยาว เทียบกับสูตร */
type Pair = { p: ExInfo; q: ExInfo; ov: string[] };
function findPair(wantOverlap: boolean): Pair | null {
  for (let i = 0; i < keepable.length; i++)
    for (let j = i + 1; j < keepable.length; j++) {
      const p = keepable[i];
      const q = keepable[j];
      const ov = p.edges.filter((k) => q.edges.includes(k));
      const touch = p.path.some((v) => q.path.includes(v));
      if (wantOverlap ? ov.length > 0 : ov.length === 0 && touch) return { p, q, ov };
    }
  return null;
}
const ovPair = findPair(true);
if (!ovPair) throw new Error('training-route: ไม่พบคู่ที่เส้นทางทับกันในตัวอย่าง');
const r2 = ovPair;
const r2Cycle = [...r2.p.edges, ...r2.q.edges].filter((k) => !r2.ov.includes(k));
const r2Len = r2Cycle.length + 2;
const r2Formula = r2.p.len + 1 + (r2.q.len + 1) - 2 * r2.ov.length;
{
  if (r2Formula !== r2Len) throw new Error(`training-route: สูตรได้ ${r2Formula} แต่นับวงจริงได้ ${r2Len}`);
  if (r2Len % 2 !== 0) throw new Error('training-route: วงที่ประกอบได้ไม่เป็นเลขคู่');
  // วงที่ประกอบต้องเป็นวงจรอย่างง่ายจริง ทุกเมืองบนวงมีเส้นต่อพอดีสองเส้น
  const deg = new Map<number, number>();
  const bump = (v: number): void => {
    deg.set(v, (deg.get(v) ?? 0) + 1);
  };
  for (const k of r2Cycle) k.split('-').map(Number).forEach(bump);
  [r2.p.e.a, r2.p.e.b, r2.q.e.a, r2.q.e.b].forEach(bump);
  if ([...deg.values()].some((d) => d !== 2)) throw new Error('training-route: วงที่ประกอบไม่ใช่วงจรอย่างง่าย');
  if (deg.size !== r2Len) throw new Error('training-route: จำนวนเมืองบนวงไม่เท่าจำนวนถนน');
  if (hasEvenCycle(N, [...paved, r2.p.e]) || hasEvenCycle(N, [...paved, r2.q.e]))
    throw new Error('training-route: ถนนในคู่ตัวอย่างควรปลอดภัยเมื่ออยู่เส้นเดียว');
  if (!hasEvenCycle(N, [...paved, r2.p.e, r2.q.e])) throw new Error('training-route: คู่ที่ทับกันควรเกิดวงคู่');
}
/* คู่ที่แตะกันแค่เมืองเดียว ไม่ได้ใช้ถนนราดยางร่วมกัน ต้องอยู่ด้วยกันได้ */
const touchPair = findPair(false);
if (touchPair && hasEvenCycle(N, [...paved, touchPair.p.e, touchPair.q.e])) {
  throw new Error('training-route: คู่ที่แตะกันแค่เมืองเดียวไม่ควรเกิดวงคู่');
}
const touchCity = touchPair ? touchPair.p.path.find((v) => touchPair.q.path.includes(v)) : 0;
/* โจทย์บอกไว้เองว่าปิดสองเส้นนี้เสีย 6 ซึ่งแพงกว่าคำตอบ */
const stmtAltRoads = ['2-4', '2-5'];
const stmtAltCost = extra.filter((e) => stmtAltRoads.includes(roadName(e))).reduce((s, e) => s + e.c, 0);
if (stmtAltCost <= answer) throw new Error('training-route: ทางเลือกที่โจทย์ยกมาควรแพงกว่าคำตอบ');

/* ---------- พิกัดของภาพกราฟ ----------
   ต้นไม้ของตัวอย่างนี้เป็นเส้นตรง 1 ถึง 5 พอดี จึงวางเมืองเรียงกันได้ตรง ๆ
   สถานะของถนนไม่ราดยางแต่ละเส้น (ต้องปิด / เก็บได้แต่ไม่ได้เก็บ / เก็บไว้) มาจาก info กับ kept */
const CITY_R = 21;
const cityX = (v: number): number => 34 + (v - 1) * 118;
const CITY_Y = 196;
const VB_W = cityX(N) + CITY_R + 12;
type ArcState = 'kept' | 'passed' | 'forced';
const stateOf = (x: ExInfo): ArcState =>
  kept.pick.indexOf(x) !== -1 ? 'kept' : x.even ? 'passed' : 'forced';
const ARC_INK = { kept: '#4ade80', passed: '#8fa2c4', forced: '#e06c75' };
/* เรียงเส้นที่กว้างกว่าให้อยู่ชั้นสูงกว่า แต่ละเส้นได้ชั้นของตัวเอง จึงไม่มีสองเส้นซ้อนกันพอดี */
const arcOrder = [...info]
  .sort((p, q) => Math.abs(q.e.a - q.e.b) - Math.abs(p.e.a - p.e.b))
  .map((x) => x.e);
const laneTop = (lane: number): number => CITY_Y - CITY_R - 24 - lane * 32;
const laneD = (e: Edge, lane: number): string => {
  const x1 = cityX(e.a);
  const x2 = cityX(e.b);
  const top = laneTop(lane);
  return `M${x1} ${CITY_Y - CITY_R} C ${x1} ${top}, ${x2} ${top}, ${x2} ${CITY_Y - CITY_R}`;
};
/** ยอดจริงของเส้นโค้งลูกบาศก์ที่จุดควบคุมทั้งสองอยู่ระดับเดียวกัน คือที่ t = 0.5 */
const laneLabelY = (lane: number): number => ((CITY_Y - CITY_R) * 2 + 6 * laneTop(lane)) / 8 - 7;
const arcLane = (x: ExInfo): number => arcOrder.indexOf(x.e);
const arcMidX = (e: Edge): number => (cityX(e.a) + cityX(e.b)) / 2;
const treeEdges = paved.map((e) => ({ a: Math.min(e.a, e.b), b: Math.max(e.a, e.b) }));
/* ขอบบนของ viewBox ตัดที่ป้ายของชั้นสูงสุด ไม่ปล่อยที่ว่างไว้เหนือภาพ */
const vbTop = (maxLane: number): number => Math.floor(laneLabelY(maxLane) - 12 - 12);
const MAX_LANE = info.length - 1;
const hintVB = `0 ${vbTop(MAX_LANE)} ${VB_W} ${CITY_Y + CITY_R + 34 - vbTop(MAX_LANE)}`;
const fullVB = `0 ${vbTop(MAX_LANE)} ${VB_W} ${CITY_Y + 64 + 30 - vbTop(MAX_LANE)}`;
/* ภาพของกฎที่ 2: วาดแค่สองเส้นของคู่ เส้นที่กว้างกว่าอยู่ชั้นบน */
const r2Arcs = [r2.p, r2.q]
  .sort((p, q) => Math.abs(p.e.a - p.e.b) - Math.abs(q.e.a - q.e.b))
  .map((x, lane) => ({ x, lane }));
const r2VB = `0 ${vbTop(1)} ${VB_W} ${CITY_Y + 64 + 30 - vbTop(1)}`;
const r2EdgeInk = (k: string): string => (r2.ov.includes(k) ? '#e06c75' : r2Cycle.includes(k) ? '#4ade80' : '#3a4459');
const r2OvMid = r2.ov.map((k) => {
  const [u, v] = k.split('-').map(Number);
  return (cityX(u) + cityX(v)) / 2;
});

/* ---------- มินิเกม เลือกเองว่าจะปิดถนนเส้นไหน ----------
   ตัวตัดสินของเกมไม่ได้ใช้กฎสองข้อของเฉลยเลย มันไล่หาวงจรอย่างง่ายทุกวงในกราฟที่ได้
   ส่วนค่าใช้จ่ายที่ถูกที่สุดหาโดยไล่ทุกวิธีเลือกตอนบิลด์ */
type TrPuzzle = { id: string; label: string; tease: string; n: number; edges: Edge[] };

const TR_PUZZLES: TrPuzzle[] = [
  { id: 'r1', label: 'ชุดที่ 1 · ตัวอย่างในโจทย์', tease: 'ห้าเมืองเดียวกับที่บทความใช้', n: N, edges: EDGES },
  {
    id: 'r2',
    label: 'ชุดที่ 2 · เส้นแพงเส้นเดียว',
    tease: 'มีถนนไม่ราดยางสองเส้น เส้นหนึ่งแพงกว่าอีกเส้นมาก ลองดูว่าเลี่ยงการปิดเส้นแพงได้ไหม',
    n: 4,
    edges: [
      { a: 1, b: 2, c: 0 },
      { a: 2, b: 3, c: 0 },
      { a: 3, b: 4, c: 0 },
      { a: 1, b: 4, c: 7 },
      { a: 1, b: 3, c: 3 },
    ],
  },
  {
    id: 'r3',
    label: 'ชุดที่ 3 · ถนนเส้นเดียว',
    tease: 'ก่อนกดปิดอะไร ลองกดตรวจดูก่อนว่าตอนนี้เป็นยังไง',
    n: 4,
    edges: [
      { a: 1, b: 2, c: 0 },
      { a: 2, b: 3, c: 0 },
      { a: 3, b: 4, c: 0 },
      { a: 1, b: 3, c: 4 },
    ],
  },
  {
    id: 'r4',
    label: 'ชุดที่ 4 · สองเส้นที่ดูปลอดภัย',
    tease: 'ลองปิดทีละเส้นแล้วกดตรวจ จากนั้นเปิดคืนทั้งสองเส้นแล้วกดตรวจอีกที',
    n: 4,
    edges: [
      { a: 1, b: 2, c: 0 },
      { a: 2, b: 3, c: 0 },
      { a: 3, b: 4, c: 0 },
      { a: 1, b: 3, c: 4 },
      { a: 2, b: 4, c: 6 },
    ],
  },
];

type TrPuzzleData = TrPuzzle & { best: number };
const trPuzzles: TrPuzzleData[] = TR_PUZZLES.map((p) => ({ ...p, best: cheapestClose(p.n, p.edges) }));
{
  // ชุดแรกคือตัวอย่างของบทความ ค่าใช้จ่ายต้องตรงกับคำตอบที่บทความประกาศไว้
  if (trPuzzles[0].best !== answer) {
    throw new Error(`มินิเกมของ training-route: ไล่ทุกวิธีได้ ${trPuzzles[0].best} แต่บทความตอบ ${answer}`);
  }
  // ชุดที่ 2 ต้องบังคับให้ปิดเส้นแพง ชุดที่ 3 ต้องไม่ต้องปิดเลย
  // ชุดที่ 4 แต่ละเส้นอยู่คนเดียวได้ แต่อยู่ด้วยกันไม่ได้ ตรงนี้คือสิ่งที่เกมต้องสอน
  const [p2, p3, p4] = [trPuzzles[1], trPuzzles[2], trPuzzles[3]];
  if (p2.best !== 7) throw new Error(`ชุดที่ 2 ควรได้ 7 ได้ ${p2.best}`);
  if (p3.best !== 0) throw new Error(`ชุดที่ 3 ควรได้ 0 ได้ ${p3.best}`);
  const pv4 = p4.edges.filter((e) => e.c === 0);
  const ex4 = p4.edges.filter((e) => e.c > 0);
  if (ex4.some((e) => hasEvenCycle(p4.n, [...pv4, e]))) throw new Error('ชุดที่ 4: แต่ละเส้นควรปลอดภัยเมื่ออยู่คนเดียว');
  if (!hasEvenCycle(p4.n, p4.edges)) throw new Error('ชุดที่ 4: สองเส้นรวมกันควรเกิดวงคู่');
}
const trJson = JSON.stringify(trPuzzles);

const NMAX = 1000;
const MMAX = 5000;
const DEGMAX = 10;
const MASKMAX = Math.pow(2, DEGMAX);

/* ตัวเลขของหัวข้อ "ตรงไหนที่ทำให้ข้อนี้ไม่ง่าย" คิดจากค่าจริงของหน้านี้ ไม่ได้พิมพ์มือ */
const trFmt = (n: number): string => n.toLocaleString('en-US');
const CLOSABLE_MAX = MMAX - (NMAX - 1); // ถนนไม่ราดยางมีได้มากสุดเท่านี้
const sampleSubsets = Math.pow(2, extra.length);

/** นับวงจรอย่างง่ายทุกวงในกราฟ นับวงละครั้ง (ยึดปมเล็กสุดเป็นจุดเริ่ม แล้วหารสองทิศทางออก) */
function countSimpleCycles(n: number, es: Edge[]): number {
  let total = 0;
  const seen = new Set<number>();
  const walk = (start: number, u: number, parentEdge: number, depth: number): void => {
    for (let i = 0; i < es.length; i++) {
      if (i === parentEdge) continue;
      const e = es[i];
      const v = e.a === u ? e.b : e.b === u ? e.a : 0;
      if (v === 0) continue;
      if (v === start && depth + 1 >= 3) {
        total += 1;
        continue;
      }
      if (v < start || seen.has(v)) continue;
      seen.add(v);
      walk(start, v, i, depth + 1);
      seen.delete(v);
    }
  };
  for (let s = 1; s <= n; s++) {
    seen.clear();
    seen.add(s);
    walk(s, s, -1, 0);
  }
  return total / 2;
}
const sampleCycles = countSimpleCycles(N, EDGES);

/* ---------- ตัวอย่างเล็กของตอนที่ 5 (ดีพีบนต้นไม้) ----------
   ต้นไม้ 12 เมือง ปักรากที่ 1 ถนนไม่ราดยางทุกเส้นยาวคู่ (เส้นคี่ถูกกฎที่ 1 ตัดไปแล้ว)
   ดีพีข้างล่างเขียนตามโค้ด C++ บรรทัดต่อบรรทัด แล้วเทียบกับตัวตรวจแบบไล่ทุกวง */
const DP_N = 12;
const DP_PARENT: number[] = [0, 0, 1, 1, 2, 2, 3, 3, 5, 7, 1, 10, 11];
const DP_ROADS: Edge[] = [
  { a: 4, b: 5, c: 3 },
  { a: 2, b: 8, c: 2 },
  { a: 3, b: 9, c: 2 },
  { a: 6, b: 7, c: 3 },
  { a: 4, b: 6, c: 9 },
  { a: 2, b: 3, c: 4 },
  { a: 10, b: 12, c: 3 },
];
const dpCh: number[][] = Array.from({ length: DP_N + 1 }, () => [] as number[]);
