<script>
  import { cpGameUi, readPuzzles } from '../../lib/cpGame';
  import type { CpGameUi } from '../../lib/cpGame';

  type RzBlk = [number, number, number, number];
  type RzPuzzle = { id: string; label: string; tease: string; g: number[][]; best: number };

  function isPuzzle(x: unknown): x is RzPuzzle {
    if (typeof x !== 'object' || x === null) return false;
    const o = x as Record<string, unknown>;
    return typeof o.best === 'number' && typeof o.tease === 'string' && Array.isArray(o.g);
  }

  function initRaisinGame(): void {
    const maybeUi = cpGameUi('[data-rzgame]');
    if (!maybeUi) return;
    /* ผูกเป็น const ใหม่ เพราะ TypeScript ไม่ narrow ข้ามฟังก์ชันที่ถูก hoist */
    const ui: CpGameUi = maybeUi;
    const puzzles = readPuzzles(ui.root).filter(isPuzzle);
    if (puzzles.length === 0) return;
    const boards = Array.from(ui.root.querySelectorAll<HTMLElement>('[data-rz-board]'));

    let pi = 0;
    let blocks: RzBlk[] = [];
    let paid = 0;
    let history: { blocks: RzBlk[]; paid: number }[] = [];

    const pz = (): RzPuzzle => puzzles[pi];
    const cellsTotal = (): number => pz().g.length * pz().g[0].length;
    const sumOf = (b: RzBlk): number => {
      let s = 0;
      for (let r = b[0]; r <= b[2]; r++) for (let c = b[1]; c <= b[3]; c++) s += pz().g[r][c];
      return s;
    };
    const blockAt = (r: number, c: number): number => blocks.findIndex((b) => r >= b[0] && r <= b[2] && c >= b[1] && c <= b[3]);
    const single = (b: RzBlk): boolean => b[0] === b[2] && b[1] === b[3];

    function render(): void {
      boards.forEach((b, k) => {
        b.hidden = k !== pi;
      });
      const board = boards[pi];
      const g = pz().g;
      for (const el of Array.from(board.querySelectorAll<HTMLElement>('[data-rz-cell]'))) {
        const [r, c] = (el.dataset.rzCell ?? '0:0').split(':').map(Number);
        el.classList.toggle('is-done', single(blocks[blockAt(r, c)]));
      }
      const gapCut = (kind: string, r: number, c: number): boolean =>
        kind === 'v' ? c + 1 < g[0].length && blockAt(r, c) !== blockAt(r, c + 1) : r + 1 < g.length && blockAt(r, c) !== blockAt(r + 1, c);
      for (const el of Array.from(board.querySelectorAll<HTMLButtonElement>('[data-rz-gap]'))) {
        const [kind, rs, cs] = (el.dataset.rzGap ?? 'v:0:0').split(':');
        const cut = gapCut(kind, Number(rs), Number(cs));
        el.classList.toggle('is-cut', cut);
        el.disabled = cut;
      }
      for (const el of Array.from(board.querySelectorAll<HTMLElement>('[data-rz-dot]'))) {
        const [r, c] = (el.dataset.rzDot ?? '0:0').split(':').map(Number);
        el.classList.toggle('is-cut', gapCut('v', r, c) || gapCut('v', r + 1, c) || gapCut('h', r, c) || gapCut('h', r, c + 1));
      }
      const done = cellsTotal() - blocks.length;
      ui.setScore(`จ่ายไปแล้ว ${paid} เม็ด · หั่นแล้ว ${done} จาก ${cellsTotal() - 1} ครั้ง`);
    }

    function finishCheck(): void {
      if (!blocks.every(single)) return;
      const best = pz().best;
      if (paid === best) ui.setStatus(`หั่นครบแล้ว จ่าย ${paid} เม็ด เท่ากับค่าที่ดีที่สุดของกระดานนี้พอดีครับ`, 'good');
      else ui.setStatus(`หั่นครบแล้ว จ่าย ${paid} เม็ด ส่วนค่าที่ดีที่สุดคือ ${best} ยังเกินอยู่ ${paid - best} เม็ด ลองย้อนแล้วเปลี่ยนเส้นดู`, 'bad');
    }

    function cut(kind: string, r: number, c: number): void {
      const i = blockAt(r, c);
      const j = kind === 'v' ? blockAt(r, c + 1) : blockAt(r + 1, c);
      if (i < 0 || i !== j) return;
      const b = blocks[i];
      const cost = sumOf(b);
      history.push({ blocks: blocks.map((x) => [...x] as RzBlk), paid });
      const parts: RzBlk[] = kind === 'v'
        ? [[b[0], b[1], b[2], c], [b[0], c + 1, b[2], b[3]]]
        : [[b[0], b[1], r, b[3]], [r + 1, b[1], b[2], b[3]]];
      blocks = [...blocks.slice(0, i), ...parts, ...blocks.slice(i + 1)];
      paid += cost;
      const h = b[2] - b[0] + 1;
      const w = b[3] - b[1] + 1;
      ui.setStatus(`หั่นบล็อก ${h}×${w} ที่มีลูกเกด ${cost} เม็ด จ่าย ${cost}`, 'plain');
      render();
      finishCheck();
    }

    function reset(): void {
      const g = pz().g;
      blocks = [[0, 0, g.length - 1, g[0].length - 1]];
      paid = 0;
      history = [];
      render();
      if (blocks.every(single)) finishCheck();
    }

    function selectPuzzle(k: number): void {
      pi = k;
      ui.selectTab(k);
      ui.setTease(pz().tease);
      ui.setStatus('กดรอยต่อระหว่างสองชิ้น เพื่อหั่นบล็อกที่รอยนั้นอยู่ ตลอดแนวทั้งบล็อก');
      reset();
    }

    ui.root.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest('[data-rz-gap]');
      if (!(btn instanceof HTMLButtonElement) || btn.disabled) return;
      const [kind, rs, cs] = (btn.dataset.rzGap ?? 'v:0:0').split(':');
      cut(kind, Number(rs), Number(cs));
    });
    ui.onClick('data-rz-undo', () => {
      const last = history.pop();
      if (!last) {
        ui.setStatus('ยังไม่ได้หั่นเลย ไม่มีอะไรให้ย้อน', 'plain');
        return;
      }
      blocks = last.blocks;
      paid = last.paid;
      ui.setStatus('ย้อนกลับไปหนึ่งครั้งแล้ว', 'plain');
      render();
    });
    ui.onClick('data-rz-reset', () => selectPuzzle(pi));
    ui.onTab(selectPuzzle);
    selectPuzzle(0);
  }

  document.addEventListener('astro:page-load', initRaisinGame);
</script>

<script>
  import { initCpRowPlayers } from '../../lib/cpPlayer';

  document.addEventListener('astro:page-load', () => {
    initCpRowPlayers('[data-rzsim]');
  });
</script>
