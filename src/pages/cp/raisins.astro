---
import CpProblemLayout from '../../layouts/CpProblemLayout.astro';
import CpStepPlayer from '../../components/CpStepPlayer.astro';
import Spoiler from '../../components/Spoiler.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableDiagram from '../../components/ZoomableDiagram.astro';
import { mc, texCode } from '../../lib/math';

const href = 'raisins/';

/* ---------- โมเดลของโจทย์ ทุกตัวเลขในหน้านี้งอกจากตรงนี้ ---------- */

type Grid = number[][];
/** บล็อกหนึ่งก้อน บอกด้วยขอบสี่ด้าน แถวบน คอลัมน์ซ้าย แถวล่าง คอลัมน์ขวา (นับจากศูนย์) */
type Blk = [number, number, number, number];
type Cut = { dir: 'h' | 'v'; k: number; p: Blk; q: Blk };

const blkSum = (g: Grid, b: Blk): number => {
  let s = 0;
  for (let r = b[0]; r <= b[2]; r++) for (let c = b[1]; c <= b[3]; c++) s += g[r][c];
  return s;
};
const isSingle = (b: Blk): boolean => b[0] === b[2] && b[1] === b[3];
const blkH = (b: Blk): number => b[2] - b[0] + 1;
const blkW = (b: Blk): number => b[3] - b[1] + 1;
const sizeLabel = (b: Blk): string => `${blkH(b)}×${blkW(b)}`;

/** ทุกเส้นที่หั่นบล็อกนี้ได้ แนวนอนก่อน แล้วค่อยแนวตั้ง */
function cutsOf(b: Blk): Cut[] {
  const out: Cut[] = [];
  for (let k = b[0]; k < b[2]; k++) out.push({ dir: 'h', k, p: [b[0], b[1], k, b[3]], q: [k + 1, b[1], b[2], b[3]] });
  for (let k = b[1]; k < b[3]; k++) out.push({ dir: 'v', k, p: [b[0], b[1], b[2], k], q: [b[0], k + 1, b[2], b[3]] });
  return out;
}

/** ท่าที่หน้านี้สอน ค่าแรงน้อยสุดของบล็อก = ลูกเกดบนบล็อก + ผลรวมที่ดีที่สุดของสองชิ้นหลังหั่น */
function makeDp(g: Grid): (b: Blk) => number {
  const memo = new Map<string, number>();
  const f = (b: Blk): number => {
    if (isSingle(b)) return 0;
    const key = b.join(',');
    const hit = memo.get(key);
    if (hit !== undefined) return hit;
    let best = Infinity;
    for (const c of cutsOf(b)) best = Math.min(best, f(c.p) + f(c.q));
    const v = blkSum(g, b) + best;
    memo.set(key, v);
    return v;
  };
  return f;
}
const whole = (g: Grid): Blk => [0, 0, g.length - 1, g[0].length - 1];
const solve = (g: Grid): number => makeDp(g)(whole(g));

/**
 * ตัวตรวจ ไม่เชื่อว่าแต่ละบล็อกคิดแยกกันได้
 * สถานะคือถุงของบล็อกทั้งหมดที่ยังต้องหั่น แล้วลองทุกบล็อก ทุกเส้น ทุกลำดับ
 */
function bagBrute(g: Grid): number {
  const seen = new Map<string, number>();
  const go = (bag: Blk[]): number => {
    if (bag.length === 0) return 0;
    const sorted = [...bag].sort((x, y) => x[0] - y[0] || x[1] - y[1] || x[2] - y[2] || x[3] - y[3]);
    const key = sorted.map((b) => b.join(',')).join('|');
    const hit = seen.get(key);
    if (hit !== undefined) return hit;
    let res = Infinity;
    sorted.forEach((b, i) => {
      const rest = sorted.filter((_, j) => j !== i);
      for (const c of cutsOf(b)) {
        const next = [...rest, ...[c.p, c.q].filter((x) => !isSingle(x))];
        res = Math.min(res, blkSum(g, b) + go(next));
      }
    });
    seen.set(key, res);
    return res;
  };
  const start = whole(g);
  return isSingle(start) ? 0 : go([start]);
}

/** ท่าโลภที่ฟังดูเข้าท่า หั่นเส้นที่ทำให้สองซีกมีลูกเกดใกล้กันที่สุด ถ้าเสมอเลือกเส้นแรกที่เจอ */
function balancedCut(g: Grid, b: Blk): Cut {
  let pick = cutsOf(b)[0];
  let gap = Infinity;
  for (const c of cutsOf(b)) {
    const d = Math.abs(blkSum(g, c.p) - blkSum(g, c.q));
    if (d < gap) {
      gap = d;
      pick = c;
    }
  }
  return pick;
}
function greedy(g: Grid): number {
  const go = (b: Blk): number => {
    if (isSingle(b)) return 0;
    const c = balancedCut(g, b);
    return blkSum(g, b) + go(c.p) + go(c.q);
  };
  return go(whole(g));
}

/* ด่านตรวจตอนบิลด์ ท่าที่สอนต้องตรงกับตัวตรวจแบบถุง ไม่งั้นหน้านี้ไม่ขึ้น */
const SWEEP_CASES = 400;
{
  let seed = 20340911;
  const rnd = (m: number): number => {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    return seed % m;
  };
  for (let t = 0; t < SWEEP_CASES; t++) {
    const n = 1 + rnd(3);
    const m = 1 + rnd(n === 3 ? 3 : 4);
    const V = [1, 3, 9, 1000][rnd(4)];
    const g = Array.from({ length: n }, () => Array.from({ length: m }, () => 1 + rnd(V)));
    if (solve(g) !== bagBrute(g)) throw new Error(`raisins: ท่าตารางบล็อกไม่ตรงกับตัวตรวจแบบถุง ที่ ${JSON.stringify(g)}`);
  }
}

/* ---------- ตัวอย่างในโจทย์ ---------- */
const SAMPLE: Grid = [
  [2, 7, 5],
  [1, 9, 5],
];
const SN = SAMPLE.length;
const SM = SAMPLE[0].length;
const SAMPLE_ANS = solve(SAMPLE);
const SAMPLE_TOTAL = blkSum(SAMPLE, whole(SAMPLE));
const SAMPLE_CUTS = SN * SM - 1;
const SAMPLE_GREEDY = greedy(SAMPLE);

/* ต้นไม้การหั่นที่ดีที่สุดของตัวอย่าง (เลือกเส้นแรกที่ได้ค่าดีที่สุด) เก็บเป็นลำดับก่อนหลัง */
type TreeCut = { order: number; blk: Blk; cut: Cut; cost: number };
function optTree(g: Grid): { cuts: TreeCut[]; depth: number[][] } {
  const f = makeDp(g);
  const cuts: TreeCut[] = [];
  const depth = g.map((row) => row.map(() => 0));
  const walk = (b: Blk): void => {
    if (isSingle(b)) return;
    const target = f(b) - blkSum(g, b);
    const c = cutsOf(b).find((x) => f(x.p) + f(x.q) === target);
    if (!c) throw new Error('raisins: หาเส้นที่ให้ค่าดีที่สุดไม่เจอ');
    cuts.push({ order: cuts.length + 1, blk: b, cut: c, cost: blkSum(g, b) });
    for (let r = b[0]; r <= b[2]; r++) for (let cc = b[1]; cc <= b[3]; cc++) depth[r][cc] += 1;
    walk(c.p);
    walk(c.q);
  };
  walk(whole(g));
  return { cuts, depth };
}
const sampleTree = optTree(SAMPLE);
/* ข้ออ้างในเนื้อความ: ค่าแรงรวม = ลูกเกดของแต่ละช่อง คูณจำนวนครั้งที่ช่องนั้นอยู่ในบล็อกที่ถูกหั่น */
const depthTotal = SAMPLE.reduce((s, row, r) => s + row.reduce((t, v, c) => t + v * sampleTree.depth[r][c], 0), 0);
if (depthTotal !== SAMPLE_ANS || sampleTree.cuts.reduce((s, c) => s + c.cost, 0) !== SAMPLE_ANS)
  throw new Error('raisins: สูตรลูกเกดคูณความลึกไม่ตรงกับคำตอบของตัวอย่าง');
if (sampleTree.cuts.length !== SAMPLE_CUTS) throw new Error('raisins: จำนวนครั้งที่หั่นไม่เท่า N*M-1');
const sampleDp = makeDp(SAMPLE);
const sampleFirstTies = cutsOf(whole(SAMPLE)).filter((c) => SAMPLE_TOTAL + sampleDp(c.p) + sampleDp(c.q) === SAMPLE_ANS).length;
const sampleFirstCount = cutsOf(whole(SAMPLE)).length;
const depthTerms = SAMPLE.flatMap((row, r) => row.map((v, c) => `${v}×${sampleTree.depth[r][c]}`)).join(' + ');

/* แผนภาพต้นไม้การหั่นของตัวอย่าง */
const D_CELL = 84;
const D_GX = 24;
const D_GY = 24;
const dCells = SAMPLE.flatMap((row, r) =>
  row.map((v, c) => ({ x: D_GX + c * D_CELL, y: D_GY + r * D_CELL, v, d: sampleTree.depth[r][c] })),
);
const dLines = sampleTree.cuts.map((t) => {
  const b = t.blk;
  if (t.cut.dir === 'h') {
    const y = D_GY + (t.cut.k + 1) * D_CELL;
    const x1 = D_GX + b[1] * D_CELL;
    const x2 = D_GX + (b[3] + 1) * D_CELL;
    return { ...t, x1, y1: y, x2, y2: y, bx: (x1 + x2) / 2, by: y };
  }
  const x = D_GX + (t.cut.k + 1) * D_CELL;
  const y1 = D_GY + b[0] * D_CELL;
  const y2 = D_GY + (b[2] + 1) * D_CELL;
  return { ...t, x1: x, y1, x2: x, y2, bx: x, by: (y1 + y2) / 2 };
});
const D_LX = D_GX + SM * D_CELL + 34;
const D_LY = D_GY + 20;
const D_LSTEP = 28;
const dLegend = sampleTree.cuts.map((t, i) => ({
  y: D_LY + i * D_LSTEP,
  text: `ครั้งที่ ${t.order} · หั่นบล็อก ${sizeLabel(t.blk)} จ่าย ${t.cost}`,
}));
const D_TOTAL_Y = D_LY + sampleTree.cuts.length * D_LSTEP + 6;
/* ความกว้างของข้อความในคำอธิบายด้านขวา ประมาณจากจำนวนตัวอักษรที่ขนาด 14
   ไม่นับสระบนล่างกับวรรณยุกต์ของไทย เพราะมันซ้อนอยู่บนตัวอักษรอื่น ไม่กินที่ในแนวนอน */
const visibleLen = (s: string): number => s.replace(/[ัิ-ฺ็-๎]/g, '').length;
const D_LEGEND_W = Math.max(...dLegend.map((l) => visibleLen(l.text))) * 7.6;
// ความกว้างตัวอักษรข้างบนเป็นค่าประมาณที่เผื่อเกิน วัดจริงในเบราว์เซอร์แล้วเหลือที่ว่างขวา 34 จึงหักออก 22 ให้เหลือราว 12
const D_W = Math.round(D_LX + D_LEGEND_W - 10);
const D_H = Math.max(D_GY + SN * D_CELL, D_TOTAL_Y) + 34;

/* ---------- กระดานกับดัก ท่าหั่นให้สองซีกหนักเท่ากัน ---------- */
const TRAP: Grid = [
  [1, 1, 2, 9],
  [9, 8, 1, 2],
];
const TRAP_ANS = solve(TRAP);
const TRAP_GREEDY = greedy(TRAP);
const TRAP_TOTAL = blkSum(TRAP, whole(TRAP));
if (TRAP_GREEDY <= TRAP_ANS) throw new Error('raisins: ท่าโลภไม่แพ้บนกระดานกับดัก เนื้อความจะผิด');
if (SAMPLE_GREEDY !== SAMPLE_ANS) throw new Error('raisins: ท่าโลภไม่ผ่านตัวอย่างในโจทย์ เนื้อความจะผิด');

const cutName = (c: Cut): string => (c.dir === 'h' ? `แนวนอน ใต้แถว ${c.k + 1}` : `แนวตั้ง หลังคอลัมน์ ${c.k + 1}`);

/* ตัวเล่นทีละขั้น ไล่ทุกเส้นที่หั่นกระดานกับดักเป็นครั้งแรกได้ */
const trapDp = makeDp(TRAP);
const trapBalanced = balancedCut(TRAP, whole(TRAP));
type FirstRow = { name: string; pSize: string; pBest: number; qSize: string; qBest: number; total: number; balanced: boolean; pRaw: number; qRaw: number };
const trapRows: FirstRow[] = cutsOf(whole(TRAP)).map((c) => ({
  name: cutName(c),
  pSize: sizeLabel(c.p),
  pBest: trapDp(c.p),
  qSize: sizeLabel(c.q),
  qBest: trapDp(c.q),
  total: TRAP_TOTAL + trapDp(c.p) + trapDp(c.q),
  balanced: c.dir === trapBalanced.dir && c.k === trapBalanced.k,
  pRaw: blkSum(TRAP, c.p),
  qRaw: blkSum(TRAP, c.q),
}));
if (Math.min(...trapRows.map((r) => r.total)) !== TRAP_ANS) throw new Error('raisins: ตารางเส้นแรกไม่ได้คำตอบของกระดานกับดัก');
const trapBalancedRow = trapRows.find((r) => r.balanced);
if (!trapBalancedRow) throw new Error('raisins: หาเส้นของท่าโลภในตารางไม่เจอ');
const trapBestRow = trapRows.reduce((a, b) => (b.total < a.total ? b : a));
if (trapBestRow.balanced || Math.abs(trapBestRow.pRaw - trapBestRow.qRaw) <= Math.abs(trapBalancedRow.pRaw - trapBalancedRow.qRaw))
  throw new Error('raisins: เส้นที่ดีที่สุดไม่ได้แบ่งลูกเกดห่างกว่าเส้นของท่าโลภ เนื้อความจะผิด');
const trapSteps = trapRows.map((row, i) => {
  const bestSoFar = Math.min(...trapRows.slice(0, i + 1).map((r) => r.total));
  const lead = row.balanced
    ? `เส้นนี้แบ่งลูกเกดได้ใกล้กันที่สุด คือ <b>${row.pRaw}</b> กับ <b>${row.qRaw}</b> ท่าหั่นให้สองซีกหนักเท่ากันจึงเลือกมัน `
    : `เส้นนี้แบ่งลูกเกดเป็น <b>${row.pRaw}</b> กับ <b>${row.qRaw}</b> `;
  return {
    note:
      `ถ้าหั่น${row.name}เป็นครั้งแรก ${lead}` +
      `ชิ้นแรกขนาด ${row.pSize} หั่นต่อจนหมดได้ถูกสุด <b>${row.pBest}</b> ชิ้นที่สองขนาด ${row.qSize} ถูกสุด <b>${row.qBest}</b> ` +
      `บวกค่าแรงครั้งแรก ${TRAP_TOTAL} ซึ่งเท่ากันทุกเส้น รวมเป็น <b>${row.total}</b> ` +
      `ดีที่สุดที่เจอมาถึงแถวนี้คือ <b>${bestSoFar}</b>`,
  };
});

/* ---------- มินิเกม หั่นเองให้ถูกที่สุด ---------- */
type BoardItem = { kind: 'cell' | 'h' | 'v' | 'dot'; r: number; c: number; v: number };
type GamePuzzle = { id: string; label: string; tease: string; g: Grid; best: number };
function makePuzzle(id: string, label: string, tease: string, g: Grid): GamePuzzle {
  const best = bagBrute(g);
  if (solve(g) !== best) throw new Error(`raisins: เฉลยเกม ${id} สองท่าไม่ตรงกัน`);
  return { id, label, tease, g, best };
}
const SQUARE: Grid = [
  [4, 9, 4],
  [5, 6, 1],
  [9, 1, 9],
];
const SQUARE_GREEDY = greedy(SQUARE);
const puzzles: GamePuzzle[] = [
  makePuzzle('a', `ตัวอย่างในโจทย์ ${SN}×${SM}`, 'เริ่มจากกระดานในโจทย์ก่อน ลองดูว่าหั่นยังไงถึงจ่ายแค่เท่าที่โจทย์ตอบ', SAMPLE),
  makePuzzle('b', `กระดาน ${TRAP.length}×${TRAP[0].length}`, 'ลองหั่นให้สองซีกมีลูกเกดใกล้เคียงกันทุกครั้งดูก่อน แล้วค่อยลองท่าอื่น', TRAP),
  makePuzzle('c', `กระดาน ${SQUARE.length}×${SQUARE[0].length}`, 'สามคูณสามต้องหั่นแปดครั้ง เส้นแรกที่เลือกจะกำหนดว่าช่องไหนต้องจ่ายซ้ำกี่รอบ', SQUARE),
];
if (SQUARE_GREEDY <= puzzles[2].best) throw new Error('raisins: ท่าโลภไม่แพ้บนกระดานสามคูณสาม');
function boardItems(g: Grid): BoardItem[] {
  const out: BoardItem[] = [];
  const n = g.length;
  const m = g[0].length;
  for (let i = 0; i < 2 * n - 1; i++)
    for (let j = 0; j < 2 * m - 1; j++) {
      const r = Math.floor(i / 2);
      const c = Math.floor(j / 2);
      const kind = i % 2 === 0 ? (j % 2 === 0 ? 'cell' : 'v') : j % 2 === 0 ? 'h' : 'dot';
      out.push({ kind, r, c, v: kind === 'cell' ? g[r][c] : 0 });
    }
  return out;
}
const gridCols = (m: number): string => Array.from({ length: 2 * m - 1 }, (_, j) => (j % 2 === 0 ? '3.1rem' : '0.9rem')).join(' ');
const gridRows = (n: number): string => Array.from({ length: 2 * n - 1 }, (_, i) => (i % 2 === 0 ? '3.1rem' : '0.9rem')).join(' ');
const boards = puzzles.map((p) => ({
  items: boardItems(p.g),
  style: `grid-template-columns:${gridCols(p.g[0].length)};grid-template-rows:${gridRows(p.g.length)}`,
}));
const puzzlesJson = JSON.stringify(puzzles);

/* ---------- ขนาดงานที่ขอบเขตเต็ม ---------- */
const N_MAX = 50;
const fmt = (n: number): string => n.toLocaleString('en-US');
const BLOCKS_MAX = ((N_MAX * (N_MAX + 1)) / 2) ** 2;
/* นับงานของสองท่าด้วยหน่วยเดียวกัน คือจำนวนครั้งที่แตะช่องหรือแตะคู่ของชิ้น */
const workCount = (() => {
  let tr = 0;
  let area = 0;
  for (let h = 1; h <= N_MAX; h++)
    for (let w = 1; w <= N_MAX; w++) {
      const cnt = (N_MAX - h + 1) * (N_MAX - w + 1);
      tr += cnt * (h - 1 + (w - 1));
      area += cnt * h * w;
    }
  return { tr, area };
})();
const TIME_FULL = '0.07';
const TIME_NAIVE = '0.32';
const SPEEDUP = Math.round(Number(TIME_NAIVE) / Number(TIME_FULL));
const TIME_BRUTE_4 = '0.18';
const TIME_BRUTE_34 = '0.01';
const BRUTE_GROWTH = Math.round(Number(TIME_BRUTE_4) / Number(TIME_BRUTE_34));
const ALL_MAX_ANS = 28600000;
const bill = [
  { name: 'ถุงของบล็อก ลองทุกลำดับการหั่น (ตัวตรวจ)', limit: 'ทดสอบถึง 4×4', work: `4×4 ใช้ ${TIME_BRUTE_4} วินาที` },
  { name: 'จำบล็อกด้วยขอบสี่ด้าน นับลูกเกดทีละช่อง', limit: `ถึง ${N_MAX}×${N_MAX}`, work: `${N_MAX}×${N_MAX} ใช้ ${TIME_NAIVE} วินาที` },
  { name: 'จำบล็อกด้วยขอบสี่ด้าน นับลูกเกดด้วยผลรวมสะสม', limit: `ถึง ${N_MAX}×${N_MAX}`, work: `${N_MAX}×${N_MAX} ใช้ ${TIME_FULL} วินาที` },
];

/* ---------- สูตร ---------- */
const DP = mc.fn('\\mathrm{dp}');
const SUM = mc.fn('\\mathrm{sum}');
/* mc ยังไม่มี \min แบบวางเงื่อนไขไว้ใต้ตัว จึงเขียนตรง ๆ ตามแบบของ mc.max */
const MIN = '\\mathop{\\textcolor{#50FA7B}{\\min}}\\limits';
const recurrenceTex = texCode(
  DP + '[B] \\;' + mc.op('=') + '\\; ' + SUM + '[B] \\;' + mc.op('+') + '\\; ' +
    MIN + '_{\\text{หั่น } B \\text{ เป็น } P,\\,Q} \\big(' + DP + '[P] ' + mc.op('+') + ' ' + DP + '[Q]\\big)',
);

/* ---------- โค้ด ---------- */
const solution = `#include <bits/stdc++.h>
using namespace std;
int n, m;
int pre[51][51];           // pre[i][j] = ลูกเกดรวมของแถว 0..i-1 คอลัมน์ 0..j-1
int dp[50][50][50][50];    // dp[r1][c1][r2][c2] = ค่าแรงน้อยสุดของบล็อกแถว r1..r2 คอลัมน์ c1..c2

// ลูกเกดในบล็อก ได้ในจังหวะเดียวด้วยผลรวมสะสมสองมิติ
int raisins(int r1, int c1, int r2, int c2){
    return pre[r2+1][c2+1] - pre[r1][c2+1] - pre[r2+1][c1] + pre[r1][c1];
}

int main(){
    scanf("%d %d", &n, &m);
    for(int i = 0; i < n; i++)
        for(int j = 0; j < m; j++){
            int x; scanf("%d", &x);
            pre[i+1][j+1] = pre[i][j+1] + pre[i+1][j] - pre[i][j] + x;
        }
    // ไล่บล็อกจากเล็กไปใหญ่ บล็อกสูง h กว้าง w ใช้แค่บล็อกที่เล็กกว่ามันเสมอ
    for(int h = 1; h <= n; h++)
        for(int w = 1; w <= m; w++)
            for(int r1 = 0; r1 + h <= n; r1++)
                for(int c1 = 0; c1 + w <= m; c1++){
                    int r2 = r1 + h - 1, c2 = c1 + w - 1;
                    if(h == 1 && w == 1){ dp[r1][c1][r2][c2] = 0; continue; }   // ชิ้นเดี่ยว ไม่ต้องหั่นแล้ว
                    int best = INT_MAX;
                    for(int k = r1; k < r2; k++)   // หั่นแนวนอน ใต้แถว k
                        best = min(best, dp[r1][c1][k][c2] + dp[k+1][c1][r2][c2]);
                    for(int k = c1; k < c2; k++)   // หั่นแนวตั้ง ทางขวาของคอลัมน์ k
                        best = min(best, dp[r1][c1][r2][k] + dp[r1][k+1][r2][c2]);
                    dp[r1][c1][r2][c2] = best + raisins(r1, c1, r2, c2);
                }
    printf("%d\\n", dp[0][0][n-1][m-1]);
}`;

const subSolution = `#include <bits/stdc++.h>
using namespace std;
int n, m, g[7][7];
int memo[7][7][7][7];   // -1 แปลว่าบล็อกนี้ยังไม่เคยคิด

// ค่าแรงน้อยสุดของบล็อกแถว r1..r2 คอลัมน์ c1..c2
int solve(int r1, int c1, int r2, int c2){
    if(r1 == r2 && c1 == c2) return 0;                 // ชิ้นเดี่ยว ไม่ต้องหั่นแล้ว
    int &res = memo[r1][c1][r2][c2];
    if(res != -1) return res;                          // บล็อกนี้เคยคิดไว้แล้ว
    int s = 0;                                          // นับลูกเกดตรง ๆ ทีละช่อง
    for(int r = r1; r <= r2; r++)
        for(int c = c1; c <= c2; c++) s += g[r][c];
    int best = INT_MAX;
    for(int k = r1; k < r2; k++) best = min(best, solve(r1, c1, k, c2) + solve(k+1, c1, r2, c2));
    for(int k = c1; k < c2; k++) best = min(best, solve(r1, c1, r2, k) + solve(r1, k+1, r2, c2));
    return res = s + best;
}

int main(){
    scanf("%d %d", &n, &m);
    for(int i = 0; i < n; i++)
        for(int j = 0; j < m; j++) scanf("%d", &g[i][j]);
    memset(memo, -1, sizeof memo);
    printf("%d\\n", solve(0, 0, n-1, m-1));
}`;

const bruteCode = `// ตัวตรวจ ไม่เชื่อว่าแต่ละบล็อกคิดแยกกันได้
// สถานะคือถุงของบล็อกที่ยังต้องหั่นทั้งหมด แล้วลองทุกบล็อก ทุกเส้น ทุกลำดับ
#include <bits/stdc++.h>
using namespace std;
typedef array<int,4> Blk;   // r1, c1, r2, c2
int n, m, g[4][4];
map<vector<Blk>, int> seen;

int raisins(const Blk &b){
    int s = 0;
    for(int r = b[0]; r <= b[2]; r++)
        for(int c = b[1]; c <= b[3]; c++) s += g[r][c];
    return s;
}

int best(vector<Blk> bag){
    if(bag.empty()) return 0;
    sort(bag.begin(), bag.end());
    auto it = seen.find(bag);
    if(it != seen.end()) return it->second;
    int res = INT_MAX;
    for(size_t i = 0; i < bag.size(); i++){
        Blk b = bag[i];
        vector<Blk> rest = bag;
        rest.erase(rest.begin() + i);
        vector<pair<Blk,Blk>> cuts;
        for(int k = b[0]; k < b[2]; k++) cuts.push_back({{b[0], b[1], k, b[3]}, {k+1, b[1], b[2], b[3]}});
        for(int k = b[1]; k < b[3]; k++) cuts.push_back({{b[0], b[1], b[2], k}, {b[0], k+1, b[2], b[3]}});
        for(auto &pc : cuts){
            vector<Blk> nb = rest;
            for(Blk x : {pc.first, pc.second})
                if(!(x[0] == x[2] && x[1] == x[3])) nb.push_back(x);   // ชิ้นเดี่ยวหลุดออกจากถุง
            res = min(res, raisins(b) + best(nb));
        }
    }
    return seen[bag] = res;
}

int main(){
    scanf("%d %d", &n, &m);
    for(int i = 0; i < n; i++)
        for(int j = 0; j < m; j++) scanf("%d", &g[i][j]);
    vector<Blk> start;
    if(n > 1 || m > 1) start.push_back({0, 0, n-1, m-1});
    printf("%d\\n", best(start));
}`;
