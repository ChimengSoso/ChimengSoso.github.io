      <text x="145" y="102" font-size="11" fill="#5a6a85">ตั้งเกณฑ์ + สั่งงาน</text>

      <!-- (3) dev -> qa (forward, upper lane) -->
      <line x1="220" y1="168" x2="500" y2="168" stroke="#4d72a9" stroke-width="1.5" marker-end="url(#team-arrow)"/>
