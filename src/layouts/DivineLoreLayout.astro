---
import { ClientRouter } from 'astro:transitions';
import DonateButton from '../components/DonateButton.astro';
import { footerSocialLinks } from '../data/socialLinks';
import { divineLoreEntries } from '../data/divineLore';
import { publishedCpProblems } from '../data/cp';
import '../styles/fonts.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  /** เปิดสารบัญลอยกับแถบความคืบหน้า สำหรับหน้ายาวที่คนอ่านต้องรู้ว่าตัวเองอยู่ตรงไหน */
  toc?: boolean;
}
const { title, description = "บันทึกลับของ ChimengSoso", toc = false } = Astro.props;
const year = new Date().getFullYear();

// Share card: only for pages that are a real divine-lore entry (articles, not the
// gated listing). Slug is the last path segment; the OG PNG is rendered by
// src/pages/og/divine-lore/[slug].png.ts in the emerald theme.
// หน้าโจทย์ในหมวด /cp/ ใช้ตัวเรนเดอร์เดียวกัน แต่คนละ endpoint (/og/cp/<slug>.png)
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() ?? '';
const isCp = Astro.url.pathname.startsWith('/cp/');
const cpEntry = isCp ? publishedCpProblems.find((p) => p.href.replace(/\/$/, '') === slug) : undefined;
const loreEntry = isCp ? undefined : divineLoreEntries.find((e) => e.href.replace(/\/$/, '') === slug);
const ogEntry = cpEntry ?? loreEntry;
const ogImage = ogEntry
  ? new URL(`/og/${isCp ? 'cp' : 'divine-lore'}/${slug}.png`, Astro.site).href
  : undefined;
---
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0d1220" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <link rel="canonical" href={Astro.url.href} />
  {ogEntry && ogImage && (
    <>
      <meta property="og:type" content="article" />
      <meta property="og:site_name" content="ChimengSoso" />
      <meta property="og:title" content={ogEntry.title} />
      <meta property="og:description" content={ogEntry.desc} />
      <meta property="og:url" content={Astro.url.href} />
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={ogEntry.title} />
      <meta name="twitter:description" content={ogEntry.desc} />
      <meta name="twitter:image" content={ogImage} />
    </>
  )}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
  <link rel="icon" type="image/jpeg" href="/img.jpg" />
  <ClientRouter />

  <style is:global>
    /* DonateButton is a shared component styled against the main site's blue
       palette (Layout.astro's :root) -- defined here too so its popup dialog
       renders correctly on this otherwise dark/emerald "vault" theme. */
    :root{
      --blue: #4d72a9;
      --blue-deep: #294266;
      --blue-shadow: #163f78;
      --blue-soft: #bcd3f8;
      --blue-tint: #ecf3fc;
      --ink: #131e30;
      --muted: #5a6a85;

      --dl-bg: #0d1220;
      --dl-panel: #1c2536;
      --dl-border: #2a3350;
      --dl-ink: #e7ecf6;
      --dl-muted: #9aa7bd;
      --dl-emerald: #2f9e5c;
      --dl-emerald-bright: #4ade80;
      --dl-gold: #e0b400;
      --dl-red: #d64545;
      /* ZoomableDiagram: ธีมนี้ให้ svg โปร่งนั่งบนพาเนลมืด (ไม่มีพื้นขาว/ขอบ)
         ค่าเริ่มต้นของคอมโพเนนต์คือพื้นขาวแบบ /knowledge จึงทับที่นี่ */
      --dl-svg-bg: transparent;
      --dl-svg-border: none;
      --dl-svg-pad: 0;
    }
    *{margin:0;padding:0;box-sizing:border-box;}
    /* แถบเลื่อนของกล่องที่เลื่อนได้ในโซนนี้ ให้เป็นโทนน้ำเงินเข้มขอบมนเข้ากับธีม
       แทนแถบดีฟอลต์สีเทาของระบบปฏิบัติการ ซึ่งดูหลุดออกมาจากหน้าอย่างชัดเจน
       อยู่ในเลย์เอาต์เพราะกล่องบางอันมาจากคอมโพเนนต์ (.dgm-scroll ของ ZoomableDiagram)
       ซึ่งกฎที่เขียนในไฟล์หน้าจะเข้าไม่ถึงเพราะสโคปคนละตัว */
    .dgm-scroll,
    .jn-stage,
    .jn-scene,
    .rc-stage,
    .cl-blocks,
    .mk-tree,
    .lab-out,
    .dpsim-scroll,
    figure.tbl{
      scrollbar-width:thin;
      scrollbar-color:#3d4b73 #0d1220;
    }
    .xnum-pop,
    .dl-toc-list{
      scrollbar-width:thin;
      scrollbar-color:#3d4b73 transparent;
    }
    .dgm-scroll::-webkit-scrollbar,
    .jn-stage::-webkit-scrollbar,
    .jn-scene::-webkit-scrollbar,
    .rc-stage::-webkit-scrollbar,
    .cl-blocks::-webkit-scrollbar,
    .mk-tree::-webkit-scrollbar,
    .lab-out::-webkit-scrollbar,
    .dpsim-scroll::-webkit-scrollbar,
    .xnum-pop::-webkit-scrollbar,
    .dl-toc-list::-webkit-scrollbar,
    figure.tbl::-webkit-scrollbar{height:10px;width:10px;}
    .dgm-scroll::-webkit-scrollbar-track,
    .jn-stage::-webkit-scrollbar-track,
    .jn-scene::-webkit-scrollbar-track,
    .rc-stage::-webkit-scrollbar-track,
    .cl-blocks::-webkit-scrollbar-track,
    .mk-tree::-webkit-scrollbar-track,
    .lab-out::-webkit-scrollbar-track,
    .dpsim-scroll::-webkit-scrollbar-track,
    .xnum-pop::-webkit-scrollbar-track,
    .dl-toc-list::-webkit-scrollbar-track,
    figure.tbl::-webkit-scrollbar-track{background:#0d1220;border-radius:999px;}
    .dgm-scroll::-webkit-scrollbar-thumb,
    .jn-stage::-webkit-scrollbar-thumb,
    .jn-scene::-webkit-scrollbar-thumb,
    .rc-stage::-webkit-scrollbar-thumb,
    .cl-blocks::-webkit-scrollbar-thumb,
    .mk-tree::-webkit-scrollbar-thumb,
    .lab-out::-webkit-scrollbar-thumb,
    .dpsim-scroll::-webkit-scrollbar-thumb,
    .xnum-pop::-webkit-scrollbar-thumb,
    .dl-toc-list::-webkit-scrollbar-thumb,
    figure.tbl::-webkit-scrollbar-thumb{
      background:#3d4b73;
      border:2px solid #0d1220;
      border-radius:999px;
    }
    .dgm-scroll::-webkit-scrollbar-thumb:hover,
    .jn-stage::-webkit-scrollbar-thumb:hover,
    .jn-scene::-webkit-scrollbar-thumb:hover,
    .rc-stage::-webkit-scrollbar-thumb:hover,
    .cl-blocks::-webkit-scrollbar-thumb:hover,
    .mk-tree::-webkit-scrollbar-thumb:hover,
    .lab-out::-webkit-scrollbar-thumb:hover,
    .dpsim-scroll::-webkit-scrollbar-thumb:hover,
    .xnum-pop::-webkit-scrollbar-thumb:hover,
    .dl-toc-list::-webkit-scrollbar-thumb:hover,
    figure.tbl::-webkit-scrollbar-thumb:hover{background:#54659a;}
    /* สองอันนี้ลอยอยู่บนพื้นการ์ด ไม่ใช่พื้นหน้า ถ้าใช้รางกับขอบสีพื้นหน้า
       จะเห็นเป็นแถบเข้มพาดอยู่ในกล่อง จึงปล่อยรางโปร่งแล้วให้หัวแม่มือลอยแทน
       ต้องอยู่หลังกฎรวมข้างบน ไม่งั้นโดนทับ */
    .xnum-pop::-webkit-scrollbar-track,
    .dl-toc-list::-webkit-scrollbar-track{background:transparent;}
    .xnum-pop::-webkit-scrollbar-thumb,
    .dl-toc-list::-webkit-scrollbar-thumb{
      border-color:transparent;
      background-clip:padding-box;
    }
    html{font-size:clamp(16px, 1rem + 0.3vw, 22px);}
    html,body{
      font-family:"Sarabun", system-ui, sans-serif;
      background:var(--dl-bg);
      color:var(--dl-ink);
    }
    body{
      min-height:100vh;
      display:flex;
      flex-direction:column;
      align-items:center;
      padding:2.5rem 1rem 3rem;
    }
    a{color:inherit;}
    a:visited{color:inherit;}
    code, pre{font-family:"Fira Code","Fira Mono",monospace;font-variant-ligatures:none;}
    .panel{
      width:100%;
      max-width:42rem;
      background:var(--dl-panel);
      border:1px solid var(--dl-border);
      border-radius:22px;
      box-shadow:0 20px 60px -12px rgba(0,0,0,0.6);
      padding:2.25rem 2.25rem 2.75rem;
      line-height:1.8;
      animation:dl-fade-up .5s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes dl-fade-up{
      from{opacity:0;transform:translateY(10px);}
      to{opacity:1;transform:translateY(0);}
    }
    .dl-nav{
      display:flex;
      flex-wrap:wrap;
      gap:1.25rem;
      margin-bottom:1.25rem;
    }
    .dl-nav a{
      display:inline-flex;
      align-items:center;
      gap:4px;
      font-size:0.82rem;
      color:var(--dl-muted);
      text-decoration:none;
      transition:color .15s;
    }
    .dl-nav a:hover{color:var(--dl-emerald-bright);}
    .dl-nav-arrow{
      width:16px;
      height:16px;
      flex-shrink:0;
      transition:transform .15s ease;
    }
    .dl-nav a:hover .dl-nav-arrow{transform:translateX(-3px);}
    @media (prefers-reduced-motion: reduce){
      .dl-nav a:hover .dl-nav-arrow{transform:none;}
    }
    .tag{
      display:inline-block;
      font-family:"JetBrains Mono", monospace;
      font-size:0.66rem;
      background:var(--dl-emerald);
      color:#eafaf0;
      padding:0.25rem 0.75rem;
      border-radius:1.25rem;
      text-transform:uppercase;
      letter-spacing:.4px;
      margin-bottom:0.875rem;
    }
    h1{font-size:1.6rem;color:#fff;margin-bottom:0.5rem;letter-spacing:-.2px;}
    .subtitle{color:var(--dl-muted);font-size:0.91rem;margin-bottom:2rem;}
    h2{
      font-size:1rem;
      color:var(--dl-emerald-bright);
      margin-top:2.25rem;
      margin-bottom:0.875rem;
      border-left:3px solid var(--dl-emerald);
      padding-left:0.75rem;
      text-transform:uppercase;
      letter-spacing:.5px;
    }
    p{font-size:0.97rem;color:var(--dl-ink);margin:0.75rem 0;}
    ul{padding-left:1.375rem;font-size:0.97rem;color:var(--dl-ink);}
    li{margin:0.5rem 0;}
    strong{color:var(--dl-emerald-bright);font-weight:700;}
    .arw{
      color:var(--dl-emerald-bright);
      font-size:1.05em;
      margin:0 0.14em;
      vertical-align:-0.03em;
    }
    p a, li a, .callout a{
      color:var(--dl-emerald-bright);
      text-decoration:underline;
      text-decoration-color:rgba(74,222,128,0.4);
      text-underline-offset:2px;
    }
    p a:hover, li a:hover, .callout a:hover{color:#fff;}
    .references{
      list-style:none;
      padding-left:0;
      counter-reset:ref;
    }
    .references li{
      counter-increment:ref;
      position:relative;
      padding-left:2rem;
      overflow-wrap:anywhere;   /* URL ยาว ๆ ไม่มีจุดตัดบรรทัด ดันหน้าให้เลื่อนข้างบนมือถือ */
    }
    .references li::before{
      content:"[" counter(ref) "]";
      position:absolute;
      left:0;
      color:var(--dl-emerald-bright);
      font-weight:600;
    }
    .divider{
      border:none;
      border-top:1px dashed var(--dl-border);
      margin:2.25rem 0;
    }
    .divider-solid{
      border:none;
      border-top:2px solid var(--dl-border);
      margin:2.75rem 0;
    }
    .card{
      background:#141a29;
      border:1px solid var(--dl-border);
      border-radius:14px;
      padding:1.125rem 1.5rem;
      margin:1rem 0;
    }
    .card ul{padding-left:1.125rem;}
    .pull{
      font-size:1.05rem;
      font-weight:600;
      color:#fff;
      border-left:3px solid var(--dl-gold);
      padding-left:1rem;
      margin:1.5rem 0;
      line-height:1.6;
    }
    .callout{
      border-radius:12px;
      padding:1rem 1.25rem;
      margin:1.125rem 0;
      border-left:3px solid;
    }
    .callout p{margin:0;font-size:0.875rem;}
    .callout-label{
      font-family:"JetBrains Mono", monospace;
      font-size:0.69rem;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:.4px;
      margin-bottom:0.25rem;
    }
    .callout-tip{background:rgba(47,158,92,0.12);border-color:var(--dl-emerald);}
    .callout-tip .callout-label{color:var(--dl-emerald-bright);}
    .callout-warn{background:rgba(214,69,69,0.12);border-color:var(--dl-red);}
    .callout-warn .callout-label{color:#f08b8b;}
    .callout-note{background:rgba(224,180,0,0.08);border-color:var(--dl-gold);}
    .callout-note .callout-label{color:var(--dl-gold);}
    .expander{
      border:1px solid var(--dl-border);
      border-radius:14px;
      padding:1rem 1.25rem;
      margin:1.125rem 0;
      background:#141a29;
    }
    .expander summary{
      cursor:pointer;
      font-weight:700;
      color:var(--dl-emerald-bright);
      list-style:none;
      display:flex;
      align-items:center;
      gap:0.6rem;
      user-select:none;
    }
    .expander summary::-webkit-details-marker{display:none;}
    .expander summary::before{
      content:"▸";
      color:var(--dl-emerald);
      display:inline-block;
      transition:transform .15s ease;
      flex-shrink:0;
    }
    .expander[open] summary::before{transform:rotate(90deg);}
    .expander .expander-body{
      margin-top:0.9rem;
      padding-top:0.9rem;
      border-top:1px dashed var(--dl-border);
    }
    .expander .expander-body > :first-child{margin-top:0;}
    .expander .expander-body > :last-child{margin-bottom:0;}
    @media (prefers-reduced-motion: reduce){
      .expander summary::before{transition:none;}
    }
    code{
      background:#141a29;
      color:var(--dl-emerald-bright);
      padding:0.125rem 0.375rem;
      border-radius:6px;
      font-size:0.9em;
    }
    /* KaTeX: ธีมมืดของ vault + กันสูตรยาวดันหน้าให้เลื่อนแนวนอน */
    .katex{color:var(--dl-ink);font-size:1.04em;}
    /* KaTeX_Main ไม่มีสระ/วรรณยุกต์ไทย ข้อความใน \text จึงต้องกลับไปใช้ Sarabun */
    .katex .text{font-family:"Sarabun",sans-serif;}
    .mathblock{
      overflow-x:auto;
      overflow-y:hidden;
      padding:0.55rem 0.7rem;
      margin:1rem 0;
      background:#141a29;
      border:1px solid var(--dl-border);
      border-radius:10px;
    }
    .mathblock .katex-display{margin:0;}
    /* สูตรที่ย้อมสีแบบโค้ด (texCode) ให้เป็นหน้าต่างเดียวกับ CodeBlock ธีม dracula
       ตัวแปรเดี่ยว ๆ ไม่ได้ถูกย้อม จึงตกมาเป็นสีพื้นของธีมนี้เอง
       (กฎเดียวกันนี้ยังมีอยู่ใน CpProblemLayout ปล่อยไว้ให้หน้า /cp/ ใช้ของเดิม) */
    .mathblock.mathcode{
      background:#282a36;
      border-color:#3b3f57;
    }
    .mathblock.mathcode .katex{color:#f8f8f2;}
    figure.diagram{margin:1.125rem 0;}
    figure.diagram figcaption{
      margin-top:0.6rem;
      font-size:0.8rem;
      color:var(--dl-muted);
      text-align:center;
    }
    figure.photo{margin:1.125rem 0;}
    figure.photo img{
      display:block;
      width:100%;
      height:auto;
      background:#f4f1e9;
      padding:0.75rem;
      border-radius:12px;
      border:1px solid var(--dl-border);
    }
    figure.photo figcaption{
      margin-top:0.6rem;
      font-size:0.8rem;
      color:var(--dl-muted);
      text-align:center;
    }
    figure.photo figcaption .photo-credit{
      display:block;
      margin-top:0.2rem;
      font-size:0.72rem;
      color:#6b7690;
    }
    /* ---------- สารบัญลอย + แถบความคืบหน้า (เฉพาะหน้าที่ส่ง toc) ---------- */
    .dl-progress{
      position:fixed;
      top:0;
      left:0;
      height:3px;
      width:100%;
      transform:scaleX(0);
      transform-origin:0 50%;
      background:linear-gradient(90deg, var(--dl-emerald), var(--dl-emerald-bright));
      z-index:44;
      pointer-events:none;
    }
    .dl-toc-btn{
      position:fixed;
      left:1.25rem;
      bottom:1.25rem;
      z-index:45;
      display:inline-flex;
      align-items:center;
      gap:0.5rem;
      padding:0.6rem 0.95rem;
      border:1px solid var(--dl-border);
      border-radius:999px;
      background:var(--dl-panel);
      color:var(--dl-ink);
      font-family:inherit;
      font-size:0.8rem;
      cursor:pointer;
      box-shadow:0 10px 30px -10px rgba(0,0,0,0.8);
      transition:border-color .15s, transform .15s;
    }
    .dl-toc-btn:hover{border-color:var(--dl-emerald);transform:translateY(-1px);}
    .dl-toc-btn svg{width:15px;height:15px;flex-shrink:0;}
    .dl-toc-here{
      color:var(--dl-muted);
      max-width:8rem;
      overflow:hidden;
      text-overflow:ellipsis;
      white-space:nowrap;
    }
    /* ต้องประกาศคู่กับ display:flex ข้างล่าง เพราะกฎของผู้เขียนชนะ [hidden] ของเบราว์เซอร์เสมอ
       ถ้าไม่มีบรรทัดนี้ การตั้ง hidden จะไม่ปิดอะไรเลย กล่องค้างเปิดตลอด */
    .dl-toc-overlay[hidden]{display:none;}
    .dl-toc-overlay{
      position:fixed;
      inset:0;
      z-index:46;
      display:flex;
      align-items:flex-end;
      justify-content:flex-start;
      padding:1.25rem;
      background:rgba(6,10,18,0.7);
      backdrop-filter:blur(2px);
    }
    .dl-toc-sheet{
      width:100%;
      max-width:24rem;
      max-height:min(30rem, 78vh);
      display:flex;
      flex-direction:column;
      background:var(--dl-panel);
      border:1px solid var(--dl-border);
      border-radius:18px;
      box-shadow:0 24px 70px -16px rgba(0,0,0,0.85);
      animation:dl-toc-in .22s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes dl-toc-in{
      from{opacity:0;transform:translateY(12px);}
      to{opacity:1;transform:none;}
    }
    .dl-toc-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:1rem;
      padding:1rem 1.15rem 0.75rem;
      border-bottom:1px solid var(--dl-border);
    }
    .dl-toc-head p{
      font-size:0.72rem;
      letter-spacing:1.5px;
      text-transform:uppercase;
      color:var(--dl-emerald-bright);
    }
    .dl-toc-head span{font-size:0.72rem;color:var(--dl-muted);}
    .dl-toc-close{
      border:none;
      background:none;
      color:var(--dl-muted);
      font-size:1.1rem;
      line-height:1;
      cursor:pointer;
      padding:0.2rem 0.35rem;
    }
    .dl-toc-close:hover{color:var(--dl-ink);}
    .dl-toc-list{
      overflow-y:auto;
      padding:0.75rem 0.5rem 1rem;
      list-style:none;
    }
    .dl-toc-list li{list-style:none;margin:0;}
    .dl-toc-list a{
      display:block;
      padding:0.4rem 0.75rem;
      border-radius:8px;
      font-size:0.85rem;
      line-height:1.5;
      color:var(--dl-muted);
      text-decoration:none;
      border-left:2px solid transparent;
    }
    .dl-toc-list a:hover{color:var(--dl-ink);background:rgba(255,255,255,0.04);}
    .dl-toc-list .dl-toc-part a{
      margin-top:0.75rem;
      color:var(--dl-emerald-bright);
      font-size:0.75rem;
      letter-spacing:0.5px;
    }
    .dl-toc-list .dl-toc-part:first-child a{margin-top:0;}
    .dl-toc-list .dl-toc-sub a{padding-left:1.4rem;}
    .dl-toc-list a[aria-current="true"]{
      color:var(--dl-ink);
      border-left-color:var(--dl-emerald-bright);
      background:rgba(74,222,128,0.08);
    }
    /* ---------- แผ่นคั่นภาค ---------- */
    .panel h2.part-head{
      margin:3.5rem 0 1.25rem;
      padding:1.15rem 1.25rem;
      border:1px solid var(--dl-border);
      border-left:3px solid var(--dl-emerald);
      border-radius:14px;
      background:rgba(47,158,92,0.07);
      font-size:1.05rem;
      text-transform:none;
      letter-spacing:normal;
      color:var(--dl-ink);
    }
    .panel h2.part-head::before{content:none;}
    .panel h2.part-head .part-kicker{
      display:block;
      margin-bottom:0.3rem;
      font-size:0.7rem;
      letter-spacing:1.6px;
      text-transform:uppercase;
      color:var(--dl-emerald-bright);
    }
    .panel h2.part-head .part-say{
      display:block;
      margin-top:0.45rem;
      font-size:0.82rem;
      font-weight:400;
      line-height:1.7;
      color:var(--dl-muted);
    }
    @media (prefers-reduced-motion: reduce){
      .dl-toc-sheet{animation:none;}
      .dl-toc-btn:hover{transform:none;}
    }
    @media (max-width:520px){
      .dl-toc-here{display:none;}
      .dl-toc-sheet{max-width:none;}
    }
    .site-footer{
      width:100%;
      max-width:34rem;
      margin-top:2.5rem;
      padding-top:1.75rem;
      border-top:1px solid var(--dl-border);
      text-align:center;
    }
    .site-footer-social{
      display:flex;
      justify-content:center;
      gap:1.2rem;
      margin-bottom:0.875rem;
    }
    .site-footer-social a{
      color:var(--dl-muted);
      line-height:1;
      transition:color .15s, transform .15s;
      display:inline-block;
    }
    .site-footer-social svg{
      width:1.1rem;
      height:1.1rem;
      display:block;
    }
    .site-footer-social a:hover{color:var(--dl-emerald-bright);transform:translateY(-1px);}
    .site-footer-copyright{
      font-size:0.72rem;
      color:var(--dl-muted);
      letter-spacing:.2px;
    }
    .site-footer-copyright a{
      color:var(--dl-emerald-bright);
      text-decoration:underline;
      text-decoration-color:rgba(74,222,128,0.4);
      text-underline-offset:2px;
    }
    .site-footer-copyright a:hover{color:#fff;}
  </style>
</head>
<body>
  {toc && (
    <>
      <div class="dl-progress" data-dl-progress></div>
      <button type="button" class="dl-toc-btn" data-dl-toc-open aria-haspopup="dialog" aria-expanded="false">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 3.5h12v1.2H2zm0 4h12v1.2H2zm0 4h8v1.2H2z"/></svg>
        สารบัญ
        <span class="dl-toc-here" data-dl-toc-here></span>
      </button>
      <div class="dl-toc-overlay" data-dl-toc-overlay hidden>
        <div class="dl-toc-sheet" role="dialog" aria-modal="true" aria-label="สารบัญ">
          <div class="dl-toc-head">
            <p>สารบัญ</p>
            <span data-dl-toc-count></span>
            <button type="button" class="dl-toc-close" data-dl-toc-close aria-label="ปิดสารบัญ">&#215;</button>
          </div>
          <ul class="dl-toc-list" data-dl-toc-list></ul>
        </div>
      </div>
    </>
  )}
  <div class="panel">
    <slot />
  </div>
  <footer class="site-footer">
    <div class="site-footer-social">
      {footerSocialLinks.map((s) => (
        <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d={s.iconPath} /></svg>
        </a>
      ))}
    </div>
    <p class="site-footer-copyright">&copy; {year} <a href="/">ChimengSoso</a> — สร้างด้วย <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> · <a href="/privacy/">นโยบายความเป็นส่วนตัว</a></p>
  </footer>
  <DonateButton />
  {toc && (
    <script>
      /* สารบัญลอย + แถบความคืบหน้า สร้างจาก h2 ในพาเนลตอนโหลด
         h2.part-head คือหัวภาค ส่วน h2 อื่นคือหัวข้อย่อยใต้ภาคนั้น */
      document.addEventListener('astro:page-load', () => {
        const openBtn = document.querySelector('[data-dl-toc-open]');
        const overlay = document.querySelector('[data-dl-toc-overlay]');
        const listEl = document.querySelector('[data-dl-toc-list]');
        const bar = document.querySelector('[data-dl-progress]');
        const hereEl = document.querySelector('[data-dl-toc-here]');
        const countEl = document.querySelector('[data-dl-toc-count]');
        const closeBtn = document.querySelector('[data-dl-toc-close]');
        const panel = document.querySelector('.panel');
        if (!(openBtn instanceof HTMLButtonElement) || !(overlay instanceof HTMLElement)
          || !(listEl instanceof HTMLElement) || !(bar instanceof HTMLElement)
          || !(panel instanceof HTMLElement)) return;

        /* บางหน้าค่อย ๆ กางเนื้อหาตามการเลื่อน (ดูสคริปต์ท้ายหน้าบิตคอยน์)
           กล่องที่ห่อไว้ถูกตัดความสูงอยู่ ทำให้สองอย่างเพี้ยนถ้าไม่รู้จักมัน
           หนึ่งคือ scrollHeight ของหน้าคือความยาวที่เปิดแล้ว ไม่ใช่ความยาวทั้งบท
           แถบความคืบหน้าที่หารด้วยค่านั้นจะค้างอยู่แถวเก้าสิบเปอร์เซ็นต์ตลอดทาง
           สองคือหัวข้อที่ยังไม่ถูกเปิดยังไม่มีตำแหน่งจริงในผัง กระโดดไปแล้วไปไม่ถึง
           กล่องนี้ฟังเหตุการณ์ dl-reveal-open-all เพื่อกางตัวเองให้หมดก่อนกระโดด */
        const getFlow = () => panel.querySelector('.btc-flow');

        const heads = Array.from(panel.querySelectorAll('h2'));
        if (heads.length === 0) return;

        listEl.textContent = '';
        const links: HTMLAnchorElement[] = [];
        let sectionCount = 0;
        heads.forEach((h, i) => {
          if (!h.id) h.id = `sec-${i + 1}`;
          const isPart = h.classList.contains('part-head');
          if (!isPart) sectionCount += 1;
          const li = document.createElement('li');
          li.className = isPart ? 'dl-toc-part' : 'dl-toc-sub';
          const a = document.createElement('a');
          a.href = `#${h.id}`;
          const kicker = h.querySelector('.part-kicker');
          const name = h.querySelector('.part-name');
          const label = isPart
            ? `${kicker ? (kicker.textContent ?? '').trim() + ' ' : ''}${(name?.textContent ?? '').trim()}`
            : (h.textContent ?? '').trim();
          a.textContent = label.trim();
          li.appendChild(a);
          listEl.appendChild(li);
          links.push(a);
        });
        if (countEl instanceof HTMLElement) countEl.textContent = `${sectionCount} หัวข้อ`;

        let open = false;
        let lastFocus: HTMLElement | null = null;
        const setOpen = (v: boolean) => {
          open = v;
          overlay.hidden = !v;
          openBtn.setAttribute('aria-expanded', String(v));
          if (v) {
            lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
            const current = links.find((a) => a.getAttribute('aria-current') === 'true');
            (current ?? links[0]).focus();
          } else if (lastFocus) {
            lastFocus.focus();
          }
        };
        openBtn.addEventListener('click', () => setOpen(true));
        if (closeBtn instanceof HTMLElement) closeBtn.addEventListener('click', () => setOpen(false));
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) setOpen(false);
        });
        document.addEventListener('keydown', (e: KeyboardEvent) => {
          if (open && e.key === 'Escape') setOpen(false);
        });
        links.forEach((a, i) => a.addEventListener('click', (e: MouseEvent) => {
          setOpen(false);
          if (!getFlow()) return;
          /* ปลายทางอาจยังไม่ถูกกางออกมา ตำแหน่งที่จะกระโดดไปจึงยังไม่มีอยู่จริง
             กางให้หมดก่อนแล้วค่อยเลื่อนในเฟรมถัดไป ตอนที่ผังนิ่งแล้ว */
          e.preventDefault();
          panel.dispatchEvent(new CustomEvent('dl-reveal-open-all'));
          requestAnimationFrame(() => {
            /* ไม่ใช้ scrollIntoView เพราะกล่องที่ห่อเนื้อหาไว้เป็น overflow:hidden
               ซึ่งยังนับเป็นกล่องเลื่อนได้ แล้วเบราว์เซอร์อาจเลือกเลื่อนข้างในกล่องแทนหน้า */
            const f = getFlow();
            if (f instanceof HTMLElement) f.scrollTop = 0;
            window.scrollTo(0, heads[i].getBoundingClientRect().top + window.scrollY);
            // ส่ง state เดิมกลับไป ห้ามส่ง null ไม่งั้น ClientRouter หา index ของหน้านี้ไม่เจอ
            // แล้วการกดย้อนกลับมาหน้านี้จะค้างอยู่หน้าเดิม
            history.replaceState(history.state, '', `#${heads[i].id}`);
            update();
          });
        }));

        let ticking = false;
        const update = () => {
          ticking = false;
          const doc = document.documentElement;
          const flow = getFlow();
          const total = Math.max(
            doc.scrollHeight,
            flow instanceof HTMLElement ? flow.offsetTop + flow.scrollHeight : 0,
          );
          const span = total - window.innerHeight;
          bar.style.transform = `scaleX(${span > 0 ? Math.min(1, doc.scrollTop / span) : 0})`;
          let active = 0;
          for (let i = 0; i < heads.length; i += 1) {
            if (heads[i].getBoundingClientRect().top <= 120) active = i;
          }
          links.forEach((a, i) => {
            if (i === active) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          });
          if (hereEl instanceof HTMLElement) {
            const h = heads[active];
            const name = h.querySelector('.part-name');
            hereEl.textContent = h.classList.contains('part-head')
              ? (name?.textContent ?? '').trim()
              : (h.textContent ?? '').trim();
          }
        };
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update();
      });
    </script>
  )}
</body>
</html>
