---
import DivineLoreLayout from './DivineLoreLayout.astro';
import { getCpProblem, getCpSet, getAdjacentCpProblems } from '../data/cp';
import { formatThaiDate } from '../lib/dates';

// เชลล์ของหน้าโจทย์หนึ่งข้อในหมวด /cp/
// รับแค่ href แล้วดึงหัวเรื่อง/ชุด/วันที่/ลิงก์ก่อนหน้า-ถัดไป จาก src/data/cp.ts
// (แหล่งความจริงเดียว ไม่พิมพ์ชื่อเรื่องหรือวันที่ซ้ำในไฟล์โจทย์)
interface Props {
  href: string;
}
const { href } = Astro.props;
const problem = getCpProblem(href);
if (!problem) {
  throw new Error(`CpProblemLayout: ไม่พบโจทย์ href="${href}" ใน src/data/cp.ts`);
}
const set = getCpSet(problem.setId);
const { prev, next } = getAdjacentCpProblems(href);
const published = formatThaiDate(problem.dateISO);
const stars = '★'.repeat(problem.difficulty) + '☆'.repeat(5 - problem.difficulty);
const isLesson = problem.kind === 'lesson';
---
<DivineLoreLayout title={`${problem.title} | โจทย์แข่ง`} description={problem.desc}>
  <nav class="dl-nav">
    <a href="/cp/">
      <svg class="dl-nav-arrow" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
      กลับหมวดโจทย์
    </a>
    <a href="/divine-lore/">บันทึกศาสตร์แห่งเทพ</a>
  </nav>

  <p class="tag">{set ? set.title : 'โจทย์แข่ง'}{problem.label ? ` · ข้อ ${problem.label}` : ''}</p>
  <h1>{problem.title}</h1>
  <p class="subtitle">{problem.desc}</p>

  <div class="cp-meta">
    {isLesson && <span class="cp-kind">บทปูพื้นฐาน</span>}
    <span class="cp-diff" title={isLesson ? `ระดับเนื้อหา ${problem.difficulty} จาก 5` : `ความยาก ${problem.difficulty} จาก 5`}>{stars}</span>
    {problem.topics.map((t) => <span class="cp-topic">{t}</span>)}
    <span class="cp-dot">อ่าน {problem.readingMinutes} นาที</span>
    <span class="cp-dot">{published}</span>
  </div>

  <slot />

  {(prev || next) && (
    <nav class="cp-adj">
      {prev ? <a class="cp-adj-prev" href={`/cp/${prev.href}`}><span>ข้อก่อนหน้า</span>{prev.title}</a> : <span />}
      {next && <a class="cp-adj-next" href={`/cp/${next.href}`}><span>ข้อถัดไป</span>{next.title}</a>}
    </nav>
  )}

  {/* สารบัญลอย เปิดจากปุ่มมุมล่างขวา ไม่อยู่ในสายการไหลของหน้า จึงไม่กวนแกนกลาง
      หัวข้อที่เฉลยยังไม่ถูกเปิดจะถูกปิดบังไว้ ตามกฎ reveal-after-hint */}
  <button type="button" class="cptoc-fab" data-cptoc-open aria-expanded="false" aria-controls="cp-toc-panel" hidden>
    <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor" width="15" height="15">
      <path d="M2 3.5h12v1.4H2zM2 7.3h12v1.4H2zM2 11.1h8v1.4H2z" />
    </svg>
    <span data-cptoc-label>สารบัญ</span>
  </button>
  <div class="cptoc-panel" id="cp-toc-panel" data-cptoc-panel hidden>
    <div class="cptoc-head">
      <p class="cptoc-title">ในหน้านี้</p>
      <button type="button" class="cptoc-close" data-cptoc-close aria-label="ปิดสารบัญ">✕</button>
    </div>
    <p class="cptoc-note" data-cptoc-note></p>
    <nav data-cptoc-nav></nav>
  </div>
</DivineLoreLayout>

<script>
  // เฉลยเบลอ: กดปุ่มแล้วเปิดให้เห็น (คู่กับ src/components/Spoiler.astro)
  (function () {
    function wire(): void {
      document.querySelectorAll<HTMLElement>('[data-spoiler]').forEach((box) => {
        if (box.dataset.wired === '1') return;
        const btn = box.querySelector<HTMLButtonElement>('.spoiler-reveal');
        if (!btn) return;
        box.dataset.wired = '1';
        btn.addEventListener('click', () => {
          box.classList.remove('locked');
          btn.setAttribute('aria-expanded', 'true');
          // ปลดล็อกกล่องเบลอที่ไม่มีปุ่มในข้อเดียวกันด้วย (เช่น io-note ใต้ตารางที่แอบเฉลย)
          // ไล่ sibling ถัดไปจนกว่าจะเจอเส้นคั่น (hr) หรือหัวข้อถัดไป (h2)
          let el = box.nextElementSibling;
          while (el && el.tagName !== 'HR' && el.tagName !== 'H2') {
            if (el.classList.contains('spoiler')) el.classList.remove('locked');
            el = el.nextElementSibling;
          }
        });
      });
    }
    document.addEventListener('astro:page-load', wire);
  })();
</script>

<script>
  /* สารบัญของหน้าโจทย์
     หน้ายาวที่สุดในคลังมี 16 หัวข้อ อ่านรอบเดียวไม่จบ แต่สารบัญแบบตรงไปตรงมาจะสปอยล์
     เพราะชื่อหัวข้ออย่าง "เฉลย ตอนที่ 4 · สภาวะคงตัวมีรูปที่ตายตัวเสมอ" บอกคำตอบไปแล้วครึ่งหนึ่ง
     ทางออกคือปิดบังเฉพาะส่วนหลังตัวคั่น "·" ของหัวข้อที่เฉลยยังไม่ถูกเปิด
     แล้วเปิดคืนทันทีที่ผู้อ่านกดดูเฉลยของหัวข้อนั้น */
  (function () {
    const SEP = ' · ';
    const MIN_HEADINGS = 6;
    let cleanup: (() => void) | null = null;

    /** เฉลยของหัวข้อนี้ยังล็อกอยู่ไหม ดูจากกล่องเบลอที่อยู่ระหว่างหัวข้อนี้กับหัวข้อถัดไป */
    function lockedUnder(h: Element): boolean {
      let el = h.nextElementSibling;
      while (el && el.tagName !== 'H2') {
        if (el.classList.contains('spoiler')) return el.classList.contains('locked');
        const inner = el.querySelector?.('.spoiler');
        if (inner) return inner.classList.contains('locked');
        el = el.nextElementSibling;
      }
      return false;
    }

    function build(): void {
      if (cleanup) cleanup();
      cleanup = null;
      const fab = document.querySelector<HTMLButtonElement>('[data-cptoc-open]');
      const panel = document.querySelector<HTMLElement>('[data-cptoc-panel]');
      const nav = document.querySelector<HTMLElement>('[data-cptoc-nav]');
      const note = document.querySelector<HTMLElement>('[data-cptoc-note]');
      const closeBtn = document.querySelector<HTMLButtonElement>('[data-cptoc-close]');
      if (!fab || !panel || !nav || !note || !closeBtn) return;
      // TS ไม่พา narrowing ข้ามฟังก์ชันที่ถูก hoist (paint อยู่ข้างล่าง) จึงต้องผูกเป็นตัวใหม่
      const noteEl: HTMLElement = note;

      const headings = Array.from(document.querySelectorAll<HTMLElement>('.panel h2'));
      if (headings.length < MIN_HEADINGS) {
        fab.hidden = true;
        panel.hidden = true;
        return;
      }
      fab.hidden = false;

      headings.forEach((h, i) => {
        if (!h.id) h.id = `cp-sec-${i + 1}`;
      });

      const links: HTMLAnchorElement[] = [];
      nav.innerHTML = '';
      headings.forEach((h, i) => {
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.className = 'cptoc-link';
        a.dataset.idx = String(i);
        nav.appendChild(a);
        links.push(a);
      });

      /** เขียนชื่อหัวข้อลงลิงก์ ปิดบังส่วนที่สปอยล์ถ้าเฉลยยังล็อกอยู่ */
      function paint(): void {
        let hiddenCount = 0;
        headings.forEach((h, i) => {
          const a = links[i];
          const full = (h.textContent ?? '').trim();
          const cut = full.indexOf(SEP);
          /* ปิดบังได้เฉพาะหัวข้อที่มีตัวคั่น เพราะสิ่งที่สปอยล์คือคำบรรยายที่อยู่หลังตัวคั่น
             ส่วนหัวข้อที่ไม่มีตัวคั่นเป็นป้ายบอกส่วนล้วน ๆ (โค้ด C++, สรุปบรรทัดเดียว,
             เดินตารางให้ดูหนึ่งกอง) ปิดไปก็ไม่ได้กันอะไร แต่เหลือเป็นแถว "…" ที่กดได้
             ทั้งที่อ่านไม่ออกว่าคืออะไร ซึ่งแย่กว่าการไม่มีแถวนั้นเลย */
          if (lockedUnder(h) && cut > 0) {
            hiddenCount += 1;
            a.textContent = `${full.slice(0, cut)}${SEP}…`;
            a.classList.add('is-masked');
            a.title = 'เปิดเฉลยของหัวข้อนี้ก่อน ชื่อเต็มถึงจะขึ้น';
          } else {
            a.textContent = full;
            a.classList.remove('is-masked');
            a.removeAttribute('title');
          }
        });
        noteEl.textContent = hiddenCount > 0
          ? `${headings.length} หัวข้อ · ยังปิดชื่อไว้ ${hiddenCount} หัวข้อ เพราะเฉลยยังไม่ถูกเปิด`
          : `${headings.length} หัวข้อ`;
      }
      paint();

      // เฉลยถูกเปิดเมื่อไร ก็คืนชื่อเต็มทันที (คลาส locked ถูกถอดโดยสคริปต์เฉลยด้านบน)
      const mo = new MutationObserver(paint);
      document.querySelectorAll('.spoiler').forEach((s) => {
        mo.observe(s, { attributes: true, attributeFilter: ['class'] });
      });

      const setOpen = (open: boolean): void => {
        panel.hidden = !open;
        fab.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      const onFab = (): void => setOpen(panel.hidden);
      const onClose = (): void => setOpen(false);
      const onKey = (e: KeyboardEvent): void => {
        if (e.key === 'Escape' && !panel.hidden) setOpen(false);
      };
      const onNavClick = (e: MouseEvent): void => {
        if (e.target instanceof Element && e.target.closest('a')) setOpen(false);
      };
      // แตะที่อื่นนอกแผงก็ปิด แผงบังเนื้อความอยู่ จึงต้องปิดได้โดยไม่ต้องเล็งปุ่มกากบาท
      const onDocClick = (e: MouseEvent): void => {
        if (panel.hidden || !(e.target instanceof Element)) return;
        if (e.target.closest('[data-cptoc-panel]') || e.target.closest('[data-cptoc-open]')) return;
        setOpen(false);
      };
      fab.addEventListener('click', onFab);
      closeBtn.addEventListener('click', onClose);
      document.addEventListener('keydown', onKey);
      document.addEventListener('click', onDocClick);
      nav.addEventListener('click', onNavClick);

      /* ปุ่มลอยทับการ์ดข้อก่อนหน้า/ข้อถัดไปตอนอ่านถึงท้ายหน้า จนกดลิงก์นั้นไม่ได้
         พออ่านมาถึงตรงนั้นก็ไม่ต้องใช้สารบัญแล้ว จึงซ่อนปุ่มทิ้งไปเลยตอนการ์ดโผล่
         เช็กด้วยเรขาคณิตใน sync() ที่ทำงานอยู่แล้วตอนเลื่อน ไม่ใช้ IntersectionObserver
         เพราะบานหน้าต่างพรีวิวไม่เรียก callback ของมันเลย จึงทดสอบไม่ได้ */
      const adj = document.querySelector('.cp-adj');
      const tuckIfAtEnd = (): void => {
        if (!adj) return;
        const r = adj.getBoundingClientRect();
        const near = r.top < window.innerHeight - 40 && r.bottom > 0;
        fab.classList.toggle('is-tucked', near);
        if (near && !panel.hidden) setOpen(false);
      };

      const label = fab.querySelector<HTMLElement>('[data-cptoc-label]');
      const sync = (): void => {
        const bottom = window.scrollY + window.innerHeight;
        const atEnd = bottom >= document.documentElement.scrollHeight - 2;
        let cur = 0;
        if (atEnd) {
          cur = headings.length - 1;
        } else {
          for (let i = 0; i < headings.length; i++) {
            if (headings[i].getBoundingClientRect().top - 90 <= 1) cur = i;
            else break;
          }
        }
        links.forEach((l, i) => l.classList.toggle('is-here', i === cur));
        if (label) label.textContent = `${cur + 1}/${headings.length}`;
        tuckIfAtEnd();
      };
      window.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync, { passive: true });
      sync();

      cleanup = () => {
        mo.disconnect();
        window.removeEventListener('scroll', sync);
        window.removeEventListener('resize', sync);
        fab.removeEventListener('click', onFab);
        closeBtn.removeEventListener('click', onClose);
        document.removeEventListener('keydown', onKey);
        document.removeEventListener('click', onDocClick);
        nav.removeEventListener('click', onNavClick);
      };
    }
    document.addEventListener('astro:page-load', build);
  })();
</script>

<style is:global>
  /* สารบัญลอย ทั้งปุ่มและแผงเป็น position:fixed จึงอยู่นอกสายการไหล
     และไม่กระทบกฎแกนกลางเดียวของ /cp/ เลย */
  .cptoc-fab{
    position:fixed;right:1rem;bottom:1rem;z-index:40;
    display:inline-flex;align-items:center;gap:0.45rem;
    font:inherit;font-size:0.82rem;font-weight:600;cursor:pointer;
    padding:0.5rem 0.85rem;border-radius:999px;
    border:1px solid var(--dl-border);background:#111c2e;color:#cdd6ea;
    box-shadow:0 6px 20px rgba(0,0,0,0.45);
  }
  .cptoc-fab:hover{border-color:var(--dl-emerald);color:#fff;}
  .cptoc-fab[hidden]{display:none;}
  /* ซ่อนตอนอ่านถึงการ์ดข้อก่อนหน้า/ข้อถัดไป ไม่งั้นปุ่มไปทับลิงก์นั้นพอดี */
  .cptoc-fab.is-tucked{opacity:0;pointer-events:none;transform:translateY(0.5rem);}
  .cptoc-fab{transition:opacity 0.18s ease, transform 0.18s ease;}
  @media (prefers-reduced-motion: reduce){
    .cptoc-fab{transition:none;}
    .cptoc-fab.is-tucked{transform:none;}
  }
  .cptoc-panel{
    /* ผูกทั้งซ้ายและขวา แล้วดันไปทางขวาด้วย margin-left:auto
       แผงจึงหดตามจอเองและล้นขอบไม่ได้เลย ต่างจาก width:min(...) ที่พลาดได้ 1px */
    position:fixed;right:1rem;left:1rem;bottom:3.9rem;z-index:41;
    width:auto;max-width:22rem;margin-left:auto;
    max-height:min(60vh, 32rem);overflow-y:auto;
    padding:0.9rem 1rem 1rem;border-radius:12px;
    border:1px solid var(--dl-border);background:#0e1526;
    box-shadow:0 14px 40px rgba(0,0,0,0.55);
  }
  .cptoc-panel[hidden]{display:none;}
  .cptoc-head{display:flex;align-items:center;justify-content:space-between;gap:0.5rem;}
  .cptoc-title{
    margin:0;font-family:'JetBrains Mono',monospace;font-size:0.72rem;
    text-transform:uppercase;letter-spacing:0.08em;color:#8fa2c4;
  }
  .cptoc-close{
    font:inherit;font-size:0.85rem;line-height:1;cursor:pointer;
    background:none;border:0;color:#8fa2c4;padding:0.2rem 0.3rem;
  }
  .cptoc-close:hover{color:#fff;}
  .cptoc-note{margin:0.35rem 0 0.6rem;font-size:0.76rem;color:#8fa2c4;}
  .cptoc-panel nav{display:flex;flex-direction:column;gap:0.1rem;}
  .cptoc-link{
    display:block;padding:0.3rem 0.55rem;border-radius:6px;
    font-size:0.86rem;line-height:1.45;color:#cdd6ea;text-decoration:none;
    border-left:2px solid transparent;
  }
  .cptoc-link:hover{background:#152036;color:#fff;}
  .cptoc-link.is-here{border-left-color:var(--dl-emerald-bright);color:#fff;font-weight:600;}
  .cptoc-link.is-masked{color:#7b8397;font-style:italic;}
  @media (prefers-reduced-motion: reduce){
    .cptoc-fab,.cptoc-panel{transition:none;}
  }

  /* แถบข้อมูลย่อของโจทย์ ใต้หัวเรื่อง */
  .cp-kind{
      font-family:"JetBrains Mono", monospace;
      font-size:0.6rem;
      letter-spacing:.6px;
      text-transform:uppercase;
      color:#0b1220;
      background:var(--dl-emerald-bright);
      border-radius:999px;
      padding:0.12rem 0.5rem;
    }
  .cp-meta{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:0.5rem;
    margin:-1.25rem 0 2rem;
    font-size:0.76rem;
    color:var(--dl-muted);
  }
  .cp-diff{color:var(--dl-gold);letter-spacing:0.1em;}
  .cp-topic{
    font-family:"JetBrains Mono", monospace;
    font-size:0.66rem;
    border:1px solid var(--dl-border);
    border-radius:999px;
    padding:0.12rem 0.55rem;
    color:var(--dl-emerald-bright);
  }
  .cp-dot::before{content:"·";margin-right:0.5rem;color:var(--dl-border);}

  /* หน้าโจทย์อ่านกว้างกว่าบันทึกลับ เพราะมีตาราง/สูตร/ตัวเล่นเยอะกว่า
     (เจาะจงกว่า .panel ของ DivineLoreLayout เพื่อไม่ต้องพึ่งลำดับการรวม CSS) */
  body .panel{max-width:46rem;}

  /* บนจอใหญ่ ขยาย "การ์ด" ให้เกือบเต็มหน้า แล้วแยกความกว้างเป็นสองระบบ
       - ตัวหนังสือ: 46rem จัดกลางหน้า เว้นอากาศซ้ายขวาเท่ากัน
       - ตาราง/ตัวเล่น/สูตร/ไดอะแกรม: กว้างกว่า แล้วจัดกลางหน้าเหมือนกัน จึงยื่นออกจาก
         คอลัมน์อ่านข้างละเท่ากัน
     พอการ์ดเกือบเท่าหน้า การจัดกลางในการ์ดจึงเท่ากับจัดกลางหน้าจริง และบล็อกมีอากาศ
     สองข้างมากพอให้ตาอ่านว่ามันเป็นวัตถุที่ลอยกลางหน้า ไม่ใช่ของที่ถูกตรึงกับขอบซ้าย
     ของคอลัมน์ข้อความ (เคยทำแบบตรึงขอบซ้ายแล้วมันอ่านว่า "โดนซ้ายลิมิตไว้")
     ห้ามใช้ negative margin ให้ทะลุออกนอกการ์ด เคยลองแล้วมันดูเหมือนหลุดกรอบ */
  /* คำบรรยายใต้ภาพ/ใต้ตารางเป็นภาษาไทยซึ่งไม่มีเว้นวรรค max-content ของมันคือทั้งประโยค
     บรรทัดเดียว ยาวหลายพันพิกเซล พอกล่องแม่เป็น fit-content คำบรรยายจึงถ่างการ์ดจนกว้างกว่า
     ตารางข้างใน เกิดเป็นแถบว่างด้านขวาที่อ่านว่า "ตารางแหว่ง" (COST เคยห่าง 155px)
     width:0 + min-width:100% ทำให้มันไม่ส่งค่าเข้าการคำนวณความกว้าง แต่ยังกางเต็มกล่องตอนเรนเดอร์ */
  body .panel figure.tbl figcaption,
  body .panel figure.diagram figcaption,
  body .panel .bookgame figcaption,
  body .panel .minegame figcaption,
