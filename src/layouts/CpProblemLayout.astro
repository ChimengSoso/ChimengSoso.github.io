---
import DivineLoreLayout from './DivineLoreLayout.astro';
import { getCpProblem, getCpSet, getAdjacentCpProblems } from '../data/cp';
import { formatThaiDate } from '../lib/dates';

// เชลล์ของหน้าโจทย์หนึ่งข้อในหมวด /cp/
// รับแค่ href แล้วดึงหัวเรื่อง/ชุด/วันที่/ลิงก์ก่อนหน้า-ถัดไป จาก src/data/cp.ts
// (แหล่งความจริงเดียว ไม่พิมพ์ชื่อเรื่องหรือวันที่ซ้ำในไฟล์โจทย์)
interface Props {
  href: string;
}
const { href } = Astro.props;
const problem = getCpProblem(href);
if (!problem) {
  throw new Error(`CpProblemLayout: ไม่พบโจทย์ href="${href}" ใน src/data/cp.ts`);
}
const set = getCpSet(problem.setId);
const { prev, next } = getAdjacentCpProblems(href);
const published = formatThaiDate(problem.dateISO);
const stars = '★'.repeat(problem.difficulty) + '☆'.repeat(5 - problem.difficulty);
const isLesson = problem.kind === 'lesson';
---
<DivineLoreLayout title={`${problem.title} | โจทย์แข่ง`} description={problem.desc}>
  <nav class="dl-nav">
    <a href="/cp/">
      <svg class="dl-nav-arrow" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
      กลับหมวดโจทย์
    </a>
    <a href="/divine-lore/">บันทึกศาสตร์แห่งเทพ</a>
  </nav>

  <p class="tag">{set ? set.title : 'โจทย์แข่ง'}{problem.label ? ` · ข้อ ${problem.label}` : ''}</p>
  <h1>{problem.title}</h1>
  <p class="subtitle">{problem.desc}</p>

  <div class="cp-meta">
    {isLesson && <span class="cp-kind">บทปูพื้นฐาน</span>}
    <span class="cp-diff" title={isLesson ? `ระดับเนื้อหา ${problem.difficulty} จาก 5` : `ความยาก ${problem.difficulty} จาก 5`}>{stars}</span>
    {problem.topics.map((t) => <span class="cp-topic">{t}</span>)}
    <span class="cp-dot">อ่าน {problem.readingMinutes} นาที</span>
    <span class="cp-dot">{published}</span>
  </div>

  <slot />

  {(prev || next) && (
    <nav class="cp-adj">
      {prev ? <a class="cp-adj-prev" href={`/cp/${prev.href}`}><span>ข้อก่อนหน้า</span>{prev.title}</a> : <span />}
      {next && <a class="cp-adj-next" href={`/cp/${next.href}`}><span>ข้อถัดไป</span>{next.title}</a>}
    </nav>
  )}
</DivineLoreLayout>

<script>
  // เฉลยเบลอ: กดปุ่มแล้วเปิดให้เห็น (คู่กับ src/components/Spoiler.astro)
  (function () {
    function wire(): void {
      document.querySelectorAll<HTMLElement>('[data-spoiler]').forEach((box) => {
        if (box.dataset.wired === '1') return;
        const btn = box.querySelector<HTMLButtonElement>('.spoiler-reveal');
        if (!btn) return;
        box.dataset.wired = '1';
        btn.addEventListener('click', () => {
          box.classList.remove('locked');
          btn.setAttribute('aria-expanded', 'true');
          // ปลดล็อกกล่องเบลอที่ไม่มีปุ่มในข้อเดียวกันด้วย (เช่น io-note ใต้ตารางที่แอบเฉลย)
          // ไล่ sibling ถัดไปจนกว่าจะเจอเส้นคั่น (hr) หรือหัวข้อถัดไป (h2)
          let el = box.nextElementSibling;
          while (el && el.tagName !== 'HR' && el.tagName !== 'H2') {
            if (el.classList.contains('spoiler')) el.classList.remove('locked');
            el = el.nextElementSibling;
          }
        });
      });
    }
    document.addEventListener('astro:page-load', wire);
  })();
</script>

<style is:global>
  /* แถบข้อมูลย่อของโจทย์ ใต้หัวเรื่อง */
  .cp-kind{
      font-family:"JetBrains Mono", monospace;
      font-size:0.6rem;
      letter-spacing:.6px;
      text-transform:uppercase;
      color:#0b1220;
      background:var(--dl-emerald-bright);
      border-radius:999px;
      padding:0.12rem 0.5rem;
    }
  .cp-meta{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:0.5rem;
    margin:-1.25rem 0 2rem;
    font-size:0.76rem;
    color:var(--dl-muted);
  }
  .cp-diff{color:var(--dl-gold);letter-spacing:0.1em;}
  .cp-topic{
    font-family:"JetBrains Mono", monospace;
    font-size:0.66rem;
    border:1px solid var(--dl-border);
    border-radius:999px;
    padding:0.12rem 0.55rem;
    color:var(--dl-emerald-bright);
  }
  .cp-dot::before{content:"·";margin-right:0.5rem;color:var(--dl-border);}

  /* หน้าโจทย์อ่านกว้างกว่าบันทึกลับ เพราะมีตาราง/สูตร/ตัวเล่นเยอะกว่า
     (เจาะจงกว่า .panel ของ DivineLoreLayout เพื่อไม่ต้องพึ่งลำดับการรวม CSS) */
  body .panel{max-width:46rem;}

  /* บนจอใหญ่ ขยาย "การ์ด" ให้เกือบเต็มหน้า แล้วแยกความกว้างเป็นสองระบบ
       - ตัวหนังสือ: 46rem จัดกลางหน้า เว้นอากาศซ้ายขวาเท่ากัน
       - ตาราง/ตัวเล่น/สูตร/ไดอะแกรม: กว้างกว่า แล้วจัดกลางหน้าเหมือนกัน จึงยื่นออกจาก
         คอลัมน์อ่านข้างละเท่ากัน
     พอการ์ดเกือบเท่าหน้า การจัดกลางในการ์ดจึงเท่ากับจัดกลางหน้าจริง และบล็อกมีอากาศ
     สองข้างมากพอให้ตาอ่านว่ามันเป็นวัตถุที่ลอยกลางหน้า ไม่ใช่ของที่ถูกตรึงกับขอบซ้าย
     ของคอลัมน์ข้อความ (เคยทำแบบตรึงขอบซ้ายแล้วมันอ่านว่า "โดนซ้ายลิมิตไว้")
     ห้ามใช้ negative margin ให้ทะลุออกนอกการ์ด เคยลองแล้วมันดูเหมือนหลุดกรอบ */
  /* คำบรรยายใต้ภาพ/ใต้ตารางเป็นภาษาไทยซึ่งไม่มีเว้นวรรค max-content ของมันคือทั้งประโยค
     บรรทัดเดียว ยาวหลายพันพิกเซล พอกล่องแม่เป็น fit-content คำบรรยายจึงถ่างการ์ดจนกว้างกว่า
     ตารางข้างใน เกิดเป็นแถบว่างด้านขวาที่อ่านว่า "ตารางแหว่ง" (COST เคยห่าง 155px)
     width:0 + min-width:100% ทำให้มันไม่ส่งค่าเข้าการคำนวณความกว้าง แต่ยังกางเต็มกล่องตอนเรนเดอร์ */
  body .panel figure.tbl figcaption,
  body .panel figure.diagram figcaption,
  body .panel .bookgame figcaption,
  body .panel .plategame figcaption{
    width:0;
    min-width:100%;
  }

  @media (min-width:72rem){
    /* การ์ดหดพอดีเนื้อหาแล้วค่อยจัดกลาง ไม่ใช่กางไปจนสุดเพดานแล้วเหลือพื้นหลังว่างสองข้าง
       เพดาน 71rem ยังอยู่เพื่อกันหน้าจอกว้างมาก แต่ปกติการ์ดจะกว้างเท่าคอลัมน์อ่าน 46rem
       บวก padding ของการ์ดเอง ซึ่งคือ "กว้างเท่าของที่กว้างที่สุดแล้วเผื่ออีกนิด" */
    body .panel{width:fit-content;}
    body .panel{max-width:min(71rem, calc(100vw - 4rem));} /* 66rem ของบล็อกกว้างสุด + padding การ์ด */
    body .panel > p,
    body .panel > ul,
    body .panel > ol,
    body .panel > h2,
    body .panel > h3,
    body .panel > .callout,
    body .panel > details,
    body .panel .spoiler-body > p,
    body .panel .spoiler-body > ul,
    body .panel .spoiler-body > ol,
    body .panel .spoiler-body > h3,
    body .panel .spoiler-body > .callout,
    body .panel .spoiler-body > details{
      max-width:46rem;
      margin-left:auto;
      margin-right:auto;
    }
    /* สูตรที่ย้อมสีแบบโค้ด (texCode) ให้เป็นหน้าต่างเดียวกับ .code-window ธีม dracula
       ตัวแปรเดี่ยว ๆ ไม่ได้ถูกย้อม จึงตกมาเป็นสีพื้นของธีมนี้เอง */
    body .panel .mathblock.mathcode{
      background:#282a36;
      border-color:#3b3f57;
    }
    body .panel .mathblock.mathcode .katex{color:#f8f8f2;}
    /* วัตถุที่ไม่ใช่ข้อความ จัดกลางหน้า */
    body .panel figure.tbl,
    body .panel .dpsim,
    body .panel .mathblock,
    body .panel table.io,
    body .panel > p.io-note,
    body .panel .spoiler-body > p.io-note{
      max-width:66rem;
      margin-left:auto;
      margin-right:auto;
    }
    body .panel > p.io-note,
    body .panel .spoiler-body > p.io-note{
      max-width:40rem;
      text-align:center;
    }
    /* ตาราง/ตัวเล่น/สูตร/โค้ด ให้หดพอดีเนื้อหาแล้วค่อยจัดกลาง ไม่ใช่ยืดเต็ม 66rem
       ไม่งั้นคอลัมน์ในตารางถ่างจนอ่านเป็นข้อมูลชุดเดียวกันยาก และโค้ดสั้น ๆ
       ก็เหลือที่ว่างขวามือครึ่งจอ 66rem จึงเป็นเพดาน ไม่ใช่ความกว้างที่ต้องใช้ */
    body .panel figure.tbl,
    body .panel .dpsim,
    body .panel .mathblock,
    body .panel .code-window{
      width:fit-content;
      max-width:min(66rem, 100%);
    }
    body .panel .code-window{
      margin-left:auto;
      margin-right:auto;
    }
    /* ตารางข้างในต้องหดตามเนื้อหาด้วย ไม่ใช่ยืดเต็มการ์ดที่หดแล้ว */
    body .panel figure.tbl table.rec{width:auto;}
    /* ยกเว้นในตัวเล่น: ความกว้างการ์ดถูกกำหนดโดยแผงคำอธิบาย เพราะข้อความไทยไม่มีเว้นวรรค
       max-content ของมันคือทั้งประโยคบรรทัดเดียว ถ้าปล่อยตารางหดตามเนื้อหาจะเหลือที่ว่าง
       ข้าง ๆ ตารางในการ์ดตัวเอง (บั๊กที่เจอ: การ์ด 1277 แต่ตารางแค่ 787) */
    body .panel .dpsim table.rec{width:100%;}
    /* ตาราง EXAMPLE ไม่หดตามเนื้อหา เพราะเนื้อหาเป็นเลขสั้น ๆ ถ้าหดจะเหลือ ~213px
       มันเป็นข้อมูลที่โจทย์ให้ อ่านคู่กับย่อหน้า จึงล็อกความกว้างเท่าคอลัมน์อ่าน */
    body .panel table.io{
      width:100%;
      max-width:46rem;
      margin-left:auto;
      margin-right:auto;
    }

    /* ไดอะแกรมกับมินิเกมจัดกลางเหมือนกัน แต่คุมแคบกว่าตาราง
       SVG พวกนี้ viewBox กว้าง 720 ถ้าดึงถึง 66rem จะสเกลเกือบสองเท่าแล้วตัวอักษรโป่ง */
    body .panel figure.diagram,
    body .panel .bookgame,
    body .panel .plategame{
      max-width:52rem;
      margin-left:auto;
      margin-right:auto;
    }
    /* ส่วนหัวของหน้า (breadcrumb, h1, แถวเมตา) ต้องอยู่แกนเดียวกับคอลัมน์อ่าน
       ไม่งั้นชื่อเรื่องจะเริ่มที่ขอบการ์ดขณะที่เนื้อหาเริ่มกลางหน้า */
    body .panel > .dl-nav,
    body .panel > h1,
    body .panel > .cp-meta{
      max-width:46rem;
      margin-left:auto;
      margin-right:auto;
    }
    /* .tag เป็นพิลล์ที่กว้างเท่าเนื้อหา จัด max-width ไม่ได้ ต้องดันด้วย margin */
    body .panel > p.tag{
      margin-left:max(0px, calc((100% - 46rem) / 2));
    }

    /* เส้นคั่นบทอิงกับคอลัมน์อ่าน ไม่ใช่ความกว้างการ์ด ไม่งั้นมันยาวข้ามหน้า */
    body .panel > hr.divider,
    body .panel > hr.divider-solid,
    body .panel .spoiler-body > hr.divider,
    body .panel .spoiler-body > hr.divider-solid{
      max-width:46rem;
      margin-left:auto;
      margin-right:auto;
    }
  }
  /* คำบรรยายจัดกลาง แต่คุมความยาวบรรทัดไว้ ข้อความจัดกลางที่ยาวหลายบรรทัดอ่านยาก */
  figure.tbl figcaption{
    max-width:40rem;
    margin-left:auto;
    margin-right:auto;
    text-align:center;
  }

  /* บล็อกสรุป อินพุต/ขอบเขต/เอาต์พุต */
  .spec ul{margin:0.4rem 0 0;padding-left:1.2rem;}
  .spec li{font-size:0.86rem;color:var(--dl-ink);margin:0.35rem 0;line-height:1.5;}
  .spec li strong{color:var(--dl-gold);}

  /* ตารางตัวอย่าง INPUT / OUTPUT */
  table.io{
    width:100%;
    border-collapse:separate;
    border-spacing:0;
    margin:1rem 0 0.35rem;
    font-size:0.86rem;
    background:#0b1220;
    border:1px solid var(--dl-border);
    border-radius:10px;
    overflow:hidden;
    box-shadow:0 4px 16px rgba(0,0,0,0.3);
  }
  table.io caption{
    caption-side:top;
    text-align:left;
    font-family:"Fira Code","Fira Mono",monospace;
    font-weight:700;
    letter-spacing:0.2em;
    font-size:0.7rem;
    color:var(--dl-gold);
    background:#070c17;
    padding:0.5rem 0.85rem;
    border-bottom:1px solid var(--dl-border);
  }
  table.io th, table.io td{
    padding:0.55rem 0.85rem;
    text-align:left;
    vertical-align:top;
    border-bottom:1px solid var(--dl-border);
  }
  table.io th + th, table.io td + td{border-left:1px solid var(--dl-border);}
  table.io tbody tr:last-child td{border-bottom:none;}
  table.io th{
    background:#141b2b;
    color:var(--dl-muted);
    font-weight:600;
    font-size:0.7rem;
    letter-spacing:0.14em;
    text-transform:uppercase;
    width:50%;
  }
  table.io td{
    font-family:"Fira Code","Fira Mono",monospace;
    color:#e7ecf6;
    line-height:1.75;
    letter-spacing:0.12em;
  }
  /* ช่อง OUTPUT = คำตอบ ให้เด่นด้วยสีเขียว (payoff ของ example) */
  table.io td + td{
    color:var(--dl-emerald-bright);
    font-weight:700;
  }
  .io-note{font-size:0.78rem;color:var(--dl-muted);margin:0.15rem 0 0;}
  /* เลขยกกำลัง/ตัวห้อย ไม่ให้ดันระยะบรรทัด */
  sup, sub{line-height:0;font-size:0.72em;}

  /* ลิงก์ข้อก่อนหน้า/ถัดไป ท้ายหน้า */
  .cp-adj{
    display:flex;
    justify-content:space-between;
    gap:1rem;
    margin-top:3rem;
    padding-top:1.25rem;
    border-top:1px dashed var(--dl-border);
  }
  .cp-adj a{
    display:flex;
    flex-direction:column;
    gap:0.15rem;
    max-width:48%;
    font-size:0.9rem;
    color:var(--dl-ink);
    text-decoration:none;
  }
  .cp-adj a:hover{color:var(--dl-emerald-bright);}
  .cp-adj a span{
    font-family:"JetBrains Mono", monospace;
    font-size:0.62rem;
    text-transform:uppercase;
    letter-spacing:.5px;
    color:var(--dl-muted);
  }
  .cp-adj-next{text-align:right;margin-left:auto;}
</style>
