---
// เฉลยเบลอไว้ก่อน กดเปิดเอง (มาตรฐานของบทความโจทย์แข่ง)
// linked = กล่องเบลอที่ไม่มีปุ่มของตัวเอง จะถูกปลดพร้อมกันเมื่อกดปุ่มของกล่องหลักด้านบน
// (สคริปต์ไล่ sibling ถัดไปจนเจอ <hr> หรือ <h2>) — ใช้กับ io-note ใต้ตารางตัวอย่าง
interface Props {
  linked?: boolean;
  label?: string;
}
const { linked = false, label = 'แตะเพื่อดูเฉลย' } = Astro.props;
---
{linked ? (
  <div class="spoiler locked"><div class="spoiler-body"><slot /></div></div>
) : (
  <div class="spoiler locked" data-spoiler>
    <button type="button" class="spoiler-reveal" aria-expanded="false">{label}</button>
    <div class="spoiler-body"><slot /></div>
  </div>
)}

<style>
  .spoiler{position:relative;margin:1.1rem 0;}
  .spoiler-body{transition:filter 0.35s ease;}
  .spoiler.locked .spoiler-body{
    filter:blur(11px);
    pointer-events:none;
    user-select:none;
  }
  .spoiler-reveal{display:none;}
  .spoiler.locked .spoiler-reveal{
    display:inline-flex;
    align-items:center;
    gap:0.4rem;
    position:absolute;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    z-index:3;
    cursor:pointer;
    font:inherit;
    font-size:0.9rem;
    font-weight:700;
    color:#0b1220;
    background:var(--dl-emerald-bright);
    border:none;
    border-radius:999px;
    padding:0.6rem 1.3rem;
    box-shadow:0 6px 22px rgba(0,0,0,0.45);
  }
  .spoiler.locked .spoiler-reveal:hover{background:var(--dl-emerald);color:#fff;}
  @media (prefers-reduced-motion: reduce){
    .spoiler-body{transition:none;}
  }
</style>
