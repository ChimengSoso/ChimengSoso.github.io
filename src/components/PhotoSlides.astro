---
// ชุดภาพถ่าย/ภาพหน้าจอที่แตะแล้วขยายเต็มจอได้ และเลื่อนซ้ายขวาได้ถ้ามีหลายภาพ
// พี่น้องกับ ZoomableDiagram (ตัวนั้นสำหรับ inline SVG) ตัวนี้สำหรับไฟล์ภาพจริง
// ส่งภาพมาเป็น prop ไม่ใช่ slot เพราะ markup ที่เป็นบล็อกใน slot ทำให้คอมไพเลอร์
// ตัดหน้าขาดกลางคัน (ดูหัวข้อ slot children ใน CLAUDE.md)
export interface Slide {
  src: string;
  /** คำบรรยายภาพสำหรับคนที่มองไม่เห็น เขียนให้เล่าทั้งภาพ */
  alt: string;
  /** ข้อความใต้ภาพของสไลด์นี้ รองรับแท็กอินไลน์ */
  caption: string;
  width: number;
  height: number;
}
interface Props {
  slides: Slide[];
  /** บรรทัดเครดิต/ที่มา แสดงใต้ caption ทุกสไลด์ */
  credit?: string;
  openLabel?: string;
}
const { slides, credit = '', openLabel = 'ขยายภาพเต็มจอ' } = Astro.props;
const first = slides[0];
const many = slides.length > 1;
const a11y = first.caption.replace(/<[^>]+>/g, '');
---

<figure class="pslides" data-slides={JSON.stringify(slides)}>
  <div class="ps-frame">
    <button type="button" class="ps-hit" aria-label={openLabel}>
      <img
        class="ps-img"
        src={first.src}
        alt={first.alt}
        width={first.width}
        height={first.height}
        loading="lazy"
        decoding="async"
      />
    </button>
    <span class="ps-open" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="currentColor">
        <path d="M6 1H2.5A1.5 1.5 0 0 0 1 2.5V6h1V2.5a.5.5 0 0 1 .5-.5H6zm4 0h3.5A1.5 1.5 0 0 1 15 2.5V6h-1V2.5a.5.5 0 0 0-.5-.5H10zM6 15H2.5A1.5 1.5 0 0 1 1 13.5V10h1v3.5a.5.5 0 0 0 .5.5H6zm4 0h3.5a1.5 1.5 0 0 0 1.5-1.5V10h-1v3.5a.5.5 0 0 1-.5.5H10z"/>
      </svg>
      <span>ขยาย</span>
    </span>
  </div>

  {many && (
    <div class="ps-bar">
      <button type="button" class="ps-prev" aria-label="ภาพก่อนหน้า">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
      </button>
      <span class="ps-dots"></span>
      <span class="ps-count">1 / {slides.length}</span>
      <button type="button" class="ps-next" aria-label="ภาพถัดไป">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/></svg>
      </button>
    </div>
  )}

  <figcaption>
    <span class="ps-cap" set:html={first.caption}></span>
    {credit && <span class="ps-credit">{credit}</span>}
  </figcaption>

  <div class="ps-overlay" hidden>
    <div class="ps-stage" role="dialog" aria-modal="true" aria-label={a11y}>
      <div class="ps-viewport">
        <div class="ps-canvas"></div>
      </div>
      {many && (
        <button type="button" class="ps-nav ps-nav-prev" aria-label="ภาพก่อนหน้า">
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
        </button>
      )}
      {many && (
        <button type="button" class="ps-nav ps-nav-next" aria-label="ภาพถัดไป">
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/></svg>
        </button>
      )}
      <p class="ps-ovcap"></p>
      <p class="ps-hint">
        เลื่อนล้อเมาส์เพื่อซูม คลิกลากเพื่อเลื่อนภาพ (บนมือถือใช้สองนิ้วขยาย นิ้วเดียวลากเลื่อน)
        {many && ' กดลูกศรซ้ายขวาเพื่อเปลี่ยนภาพ'}
      </p>
      <button type="button" class="ps-close" aria-label="ปิดภาพขยาย">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
          <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
        </svg>
      </button>
    </div>
  </div>
</figure>

<style>
  .pslides,
  .ps-overlay{
    --p-border: var(--dl-border, var(--blue-soft, #bcd3f8));
    --p-muted: var(--dl-muted, #9aa7bd);
    --p-panel: var(--dl-panel, #111a27);
    --p-ink: var(--dl-ink, #e7ecf6);
    --p-accent: var(--dl-emerald, var(--blue-soft, #7aa2d8));
    --p-accent-bright: var(--dl-emerald-bright, #9ec5ff);
    --p-shell: var(--dl-svg-bg, #0b1220);
    --p-open-bg: var(--dl-open-bg, rgba(12,18,28,0.86));
  }

  .pslides{margin:1.5rem 0;}
  .ps-frame{position:relative;}

  .ps-hit{
    display:block;
    width:100%;
    padding:0;
    border:0;
    background:none;
    cursor:zoom-in;
    border-radius:12px;
  }
  .ps-hit:focus-visible{outline:2px solid var(--p-accent-bright);outline-offset:3px;}
  .ps-img{
    display:block;
    width:100%;
    height:auto;
    border-radius:12px;
    border:1px solid var(--p-border);
    background:var(--p-shell);
  }

  .ps-open{
    position:absolute;
    right:8px;
    bottom:8px;
    display:inline-flex;
    align-items:center;
    gap:5px;
    padding:5px 10px;
    border:1px solid var(--p-border);
    border-radius:999px;
    background:var(--p-open-bg);
    color:var(--p-muted);
    font-family:"Chakra Petch", sans-serif;
    font-size:0.72rem;
    pointer-events:none;
  }
  .ps-open svg{width:12px;height:12px;}
  .ps-hit:hover + .ps-open,
  .ps-hit:focus-visible + .ps-open{color:var(--p-accent-bright);border-color:var(--p-accent);}

  .ps-bar{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:0.6rem;
    margin-top:0.6rem;
  }
  .ps-prev,
  .ps-next{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:30px;
    height:30px;
    border:1px solid var(--p-border);
    border-radius:8px;
    background:transparent;
    color:var(--p-ink);
    cursor:pointer;
    transition:color .15s ease, border-color .15s ease;
  }
  .ps-prev svg,
  .ps-next svg{width:13px;height:13px;}
  .ps-prev:hover:not(:disabled),
  .ps-next:hover:not(:disabled),
  .ps-prev:focus-visible,
  .ps-next:focus-visible{border-color:var(--p-accent);color:var(--p-accent-bright);}
  .ps-prev:disabled,
  .ps-next:disabled{opacity:0.35;cursor:default;}

  .ps-dots{display:inline-flex;align-items:center;gap:6px;}
  .ps-dots :global(i){
    display:block;
    width:7px;
    height:7px;
    border-radius:999px;
    background:var(--p-border);
  }
  .ps-dots :global(i.on){background:var(--p-accent-bright);}

  .ps-count{
    font-family:"Chakra Petch", sans-serif;
    font-size:0.74rem;
    color:var(--p-muted);
    min-width:3.4rem;
    text-align:center;
  }

  .pslides > figcaption{
    margin-top:0.6rem;
    font-size:0.8rem;
    line-height:1.6;
    color:var(--p-muted);
    text-align:center;
  }
  .ps-credit{
    display:block;
    margin-top:0.2rem;
    font-size:0.72rem;
    color:#6b7690;
  }

  .ps-overlay{
    position:fixed;
    inset:0;
    z-index:120;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:1rem;
    background:rgba(4,8,14,0.92);
  }
  .ps-overlay[hidden]{display:none;}

  .ps-stage{
    position:relative;
    display:flex;
    flex-direction:column;
    width:100%;
    max-width:1100px;
    max-height:92vh;
    overflow:hidden;
    background:var(--p-panel);
    border:1px solid var(--p-border);
    border-radius:14px;
    padding:2.4rem 1rem 1rem;
  }
  .ps-viewport{
    position:relative;
    flex:1 1 auto;
    height:64vh;
    min-height:0;
    overflow:hidden;
    touch-action:none;
    cursor:grab;
    overscroll-behavior:contain;
    user-select:none;
    -webkit-user-select:none;
  }
  .ps-viewport.dragging{cursor:grabbing;}
  .ps-canvas{position:absolute;top:0;left:0;}
  .ps-canvas :global(img){display:block;width:100%;height:auto;}

  .ps-nav{
    position:absolute;
    top:calc(2.4rem + 32vh);
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:38px;
    height:38px;
    border:1px solid var(--p-border);
    border-radius:999px;
    background:var(--p-open-bg);
    color:var(--p-ink);
    cursor:pointer;
    transition:color .15s ease, border-color .15s ease;
  }
  .ps-nav svg{width:15px;height:15px;}
  .ps-nav-prev{left:14px;}
  .ps-nav-next{right:14px;}
  .ps-nav:hover:not(:disabled),
  .ps-nav:focus-visible{border-color:var(--p-accent);color:var(--p-accent-bright);}
  .ps-nav:disabled{opacity:0.3;cursor:default;}

  .ps-ovcap{
    margin:0.8rem 0 0;
    font-size:0.82rem;
    line-height:1.6;
    color:var(--p-muted);
    text-align:center;
  }
  .ps-hint{
    margin:0.4rem 0 0;
    font-size:0.72rem;
    line-height:1.5;
    color:var(--p-muted);
    opacity:0.75;
    text-align:center;
  }
  .ps-close{
    position:absolute;
    top:8px;
    right:8px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:30px;
    height:30px;
    border:1px solid var(--p-border);
    border-radius:8px;
    background:transparent;
    color:var(--p-ink);
    cursor:pointer;
  }
  .ps-close svg{width:16px;height:16px;}
  .ps-close:hover,
  .ps-close:focus-visible{border-color:var(--p-accent);color:var(--p-accent-bright);}

  @media (max-width: 640px){
    .ps-nav{width:32px;height:32px;}
    .ps-nav-prev{left:6px;}
    .ps-nav-next{right:6px;}
  }
  @media (prefers-reduced-motion: reduce){
    .ps-prev,.ps-next,.ps-nav{transition:none;}
  }
</style>

<script>
  interface Slide {
    src: string;
    alt: string;
    caption: string;
    width: number;
    height: number;
  }

  const isSlide = (v: unknown): v is Slide => {
    if (typeof v !== 'object' || v === null) return false;
    const o = v as Record<string, unknown>;
    return (
      typeof o.src === 'string' &&
      typeof o.alt === 'string' &&
      typeof o.caption === 'string' &&
      typeof o.width === 'number' &&
      typeof o.height === 'number'
    );
  };

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.pslides').forEach((fig) => {
      if (fig.dataset.wired === '1') return;

      const raw: unknown = JSON.parse(fig.dataset.slides ?? '[]');
      if (!Array.isArray(raw)) return;
      const slides = raw.filter(isSlide);
      if (slides.length === 0) return;
      fig.dataset.wired = '1';

      const img = fig.querySelector<HTMLImageElement>('.ps-img');
      const hit = fig.querySelector<HTMLButtonElement>('.ps-hit');
      const cap = fig.querySelector<HTMLElement>('.ps-cap');
      const count = fig.querySelector<HTMLElement>('.ps-count');
      const dots = fig.querySelector<HTMLElement>('.ps-dots');
      const prev = fig.querySelector<HTMLButtonElement>('.ps-prev');
      const next = fig.querySelector<HTMLButtonElement>('.ps-next');
      const overlay = fig.querySelector<HTMLElement>('.ps-overlay');
      const viewport = fig.querySelector<HTMLElement>('.ps-viewport');
      const canvas = fig.querySelector<HTMLElement>('.ps-canvas');
      const ovcap = fig.querySelector<HTMLElement>('.ps-ovcap');
      const closeBtn = fig.querySelector<HTMLButtonElement>('.ps-close');
      const navPrev = fig.querySelector<HTMLButtonElement>('.ps-nav-prev');
      const navNext = fig.querySelector<HTMLButtonElement>('.ps-nav-next');
      if (!img || !hit || !cap || !overlay || !viewport || !canvas || !ovcap || !closeBtn) return;

      let index = 0;

      // ---------- ซูม/แพน (วิธีเดียวกับ ZoomableDiagram) ----------
      const MAX_ZOOM = 8;
      let scale = 1;
      let minScale = 1;
      let tx = 0;
      let ty = 0;
      let baseW = 0;
      let baseH = 0;

      const apply = () => {
        const vw = viewport.clientWidth;
        const vh = viewport.clientHeight;
        const cw = baseW * scale;
        const ch = baseH * scale;
        tx = cw <= vw ? (vw - cw) / 2 : Math.min(0, Math.max(vw - cw, tx));
        ty = ch <= vh ? (vh - ch) / 2 : Math.min(0, Math.max(vh - ch, ty));
        canvas.style.width = `${cw}px`;
        canvas.style.transform = `translate(${tx}px, ${ty}px)`;
      };

      const fit = () => {
        const vw = viewport.clientWidth;
        const vh = viewport.clientHeight;
        const s = slides[index];
        // ไม่พึ่ง offsetHeight ของภาพ เพราะภาพอาจยังโหลดไม่เสร็จตอนวัด
        // อัตราส่วนจริงมาจาก width/height ที่ส่งมาเป็น prop อยู่แล้ว
        canvas.style.width = `${vw}px`;
        canvas.style.transform = 'none';
        baseW = vw;
        baseH = (vw * s.height) / s.width;
        minScale = baseH > vh ? Math.min(1, vh / baseH) : 1;
        scale = minScale;
        tx = 0;
        ty = 0;
        apply();
      };

      const zoomAt = (factor: number, px: number, py: number) => {
        const nextScale = Math.min(MAX_ZOOM, Math.max(minScale, scale * factor));
        if (nextScale === scale) return;
        const ratio = nextScale / scale;
        tx = px - (px - tx) * ratio;
        ty = py - (py - ty) * ratio;
        scale = nextScale;
        apply();
      };

      const localPoint = (clientX: number, clientY: number) => {
        const r = viewport.getBoundingClientRect();
        return { x: clientX - r.left, y: clientY - r.top };
      };

      viewport.addEventListener(
        'wheel',
        (e: WheelEvent) => {
          e.preventDefault();
          const p = localPoint(e.clientX, e.clientY);
          zoomAt(Math.exp(-e.deltaY * 0.0018), p.x, p.y);
        },
        { passive: false },
      );

      const pointers = new Map<number, { x: number; y: number }>();
      let pinchDist = 0;

      viewport.addEventListener('pointerdown', (e: PointerEvent) => {
        if (e.pointerType === 'mouse') e.preventDefault();
        viewport.setPointerCapture(e.pointerId);
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        viewport.classList.add('dragging');
        if (pointers.size === 2) {
          const [a, b] = [...pointers.values()];
          pinchDist = Math.hypot(a.x - b.x, a.y - b.y);
        }
      });

      viewport.addEventListener('pointermove', (e: PointerEvent) => {
        const before = pointers.get(e.pointerId);
        if (!before) return;
        const now = { x: e.clientX, y: e.clientY };
        pointers.set(e.pointerId, now);
        if (pointers.size >= 2) {
          const [a, b] = [...pointers.values()];
          const dist = Math.hypot(a.x - b.x, a.y - b.y);
          if (pinchDist > 0) {
            const mid = localPoint((a.x + b.x) / 2, (a.y + b.y) / 2);
            zoomAt(dist / pinchDist, mid.x, mid.y);
          }
          pinchDist = dist;
          return;
        }
        tx += now.x - before.x;
        ty += now.y - before.y;
        apply();
      });

      const endPointer = (e: PointerEvent) => {
        pointers.delete(e.pointerId);
        if (pointers.size < 2) pinchDist = 0;
        if (pointers.size === 0) viewport.classList.remove('dragging');
      };
      viewport.addEventListener('pointerup', endPointer);
      viewport.addEventListener('pointercancel', endPointer);

      viewport.addEventListener('dblclick', (e: MouseEvent) => {
        const p = localPoint(e.clientX, e.clientY);
        if (scale > minScale * 1.05) fit();
        else zoomAt(2.5, p.x, p.y);
      });

      // ---------- เรนเดอร์สไลด์ ----------
      const paintInline = () => {
        const s = slides[index];
        img.src = s.src;
        img.alt = s.alt;
        img.width = s.width;
        img.height = s.height;
        cap.innerHTML = s.caption;
        if (count) count.textContent = `${index + 1} / ${slides.length}`;
        if (dots) {
          dots.replaceChildren(
            ...slides.map((_, i) => {
              const d = document.createElement('i');
              if (i === index) d.className = 'on';
              return d;
            }),
          );
        }
        if (prev) prev.disabled = index === 0;
        if (next) next.disabled = index === slides.length - 1;
        if (navPrev) navPrev.disabled = index === 0;
        if (navNext) navNext.disabled = index === slides.length - 1;
      };

      const paintOverlay = () => {
        const s = slides[index];
        const el = document.createElement('img');
        el.src = s.src;
        el.alt = s.alt;
        canvas.replaceChildren(el);
        ovcap.innerHTML = s.caption;
        fit();
      };

      const go = (to: number, inOverlay: boolean) => {
        const clamped = Math.min(slides.length - 1, Math.max(0, to));
        if (clamped === index) return;
        index = clamped;
        paintInline();
        if (inOverlay) paintOverlay();
      };

      prev?.addEventListener('click', () => go(index - 1, false));
      next?.addEventListener('click', () => go(index + 1, false));
      navPrev?.addEventListener('click', () => go(index - 1, true));
      navNext?.addEventListener('click', () => go(index + 1, true));

      // ---------- เปิด/ปิดไลต์บ็อกซ์ ----------
      const close = () => {
        overlay.hidden = true;
        canvas.replaceChildren();
        fig.appendChild(overlay);
        document.body.style.overflow = '';
        hit.focus();
      };

      const open = () => {
        // .panel ของ DivineLoreLayout มี transform ซึ่งกลายเป็น containing block
        // ของ position:fixed จึงต้องย้าย overlay ไปแปะที่ body ก่อนโชว์
        document.body.appendChild(overlay);
        overlay.hidden = false;
        document.body.style.overflow = 'hidden';
        paintOverlay();
        closeBtn.focus();
      };

      hit.addEventListener('click', open);
      closeBtn.addEventListener('click', close);
      overlay.addEventListener('click', (e: MouseEvent) => {
        if (e.target === overlay) close();
      });
      window.addEventListener('resize', () => {
        if (!overlay.hidden) fit();
      });
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (overlay.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') go(index - 1, true);
        else if (e.key === 'ArrowRight') go(index + 1, true);
      });

      paintInline();
    });
  });
</script>
