---
import { getDivineLoreEntry } from '../data/divineLore';
import { formatThaiDate } from '../lib/dates';

// บรรทัดวันที่ใต้คำโปรยของบทความ /divine-lore/ ดึงจาก divineLore.ts เท่านั้น
// วางต่อจาก <p class="subtitle"> (ดึงขึ้นไปชิดคำโปรยด้วย margin ติดลบ แบบเดียวกับ .cp-meta)
interface Props {
  /** href ของรายการใน divineLore.ts เช่น 'forex-3d/' */
  href: string;
}
const { href } = Astro.props;
const entry = getDivineLoreEntry(href);
if (!entry) throw new Error(`LoreDates: ไม่พบ href="${href}" ใน src/data/divineLore.ts`);
const published = formatThaiDate(entry.dateISO);
const updated = entry.updatedISO ? formatThaiDate(entry.updatedISO) : undefined;
---
<p class="lore-dates">
  <span>เผยแพร่ {published}</span>
  {updated && <span class="upd">อัปเดตล่าสุด {updated}</span>}
</p>

<style>
  .lore-dates{
    display:flex;
    flex-wrap:wrap;
    gap:0.25rem 0.5rem;
    margin:-1.25rem 0 2rem;
    font-size:0.76rem;
    color:var(--dl-muted);
  }
  .upd{color:var(--dl-emerald-bright);font-weight:600;}
  .upd::before{content:"·";margin-right:0.5rem;color:var(--dl-border);font-weight:400;}
</style>
